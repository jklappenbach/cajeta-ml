package bench.ml;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import dev.cajeta.ml.cluster.KMeans;

/**
 * ml/kmeans: k = 10, seeded k-means++ then Lloyd to convergence. Inertia
 * within a relative Tol.KMEANS_* of scikit-learn's KMeans(10, n_init=1).
 */
public class KMeansBench extends MlBenchmark {

    Tensor<float64> x;
    Tensor<float64> zy;
    float64 refv;
    float64 inertia;
    int64 iters;

    // Explicit: a subclass with no constructor of its own comes out of
    // `heap` unusable on cajeta 0.46.3 (measured; bench/README.md).
    public KMeansBench() {
        this.refv = 0.0;
        this.inertia = 0.0;
        this.iters = 0;
    }

    public String unit() {
        return "rows/s";
    }

    public String name() {
        return "kmeans";
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("synthetic");
        v.add("digits");
        return v;
    }

    public String probe(String variant) {
        return "kmeans/" + variant + "/x.npy";
    }

    public void prepare(String v) {
        this.begin(v);
        this.x #= Data.f64("kmeans/" + v + "/x.npy");
        this.zy #= Data.zeros(this.x.shapeAt(0));
        this.refv = Data.scalar("ref/kmeans-" + v + ".npy");
        this.nIn = this.x.shapeAt(0);
        this.ds = "kmeans-" + v + " " + Data.shape64(this.x) + " seed " + Data.SEED;
    }

    public void runVariant(String variant, int32 iterations) {
        KMeans km = heap KMeans((int64) 10, Data.SEED);
        km.fit(this.x, this.zy);
        this.inertia = km.inertia();
        this.iters = km.iterations();
    }

    public boolean checkResult() {
        float64 tol = Tol.KMEANS_SYNTHETIC;
        if (this.cur.equals("digits")) {
            tol = Tol.KMEANS_DIGITS;
        }
        float64 rel = Data.abs(this.inertia / this.refv - 1.0);
        this.note = "k=10 to convergence (" + this.iters + " iterations); inertia " + this.inertia
            + " vs scikit-learn " + this.refv + ", relative |d| " + rel + " <= " + tol;
        return rel <= tol;
    }
}
