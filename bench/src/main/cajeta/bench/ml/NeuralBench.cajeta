package bench.ml;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import cajeta.xpu.KernelStream;
import dev.cajeta.ml.nn.Module;
import dev.cajeta.ml.optim.Adam;
import dev.cajeta.ml.zoo.EncoderBlock;
import dev.cajeta.ml.zoo.Mlp;
import dev.cajeta.ml.zoo.SmallCnn;

/**
 * The six neural rows: {mlp, cnn, transformer-block} x {train step, inference},
 * each with a `cpu` and a `device` variant; on `device` the model, the batch and the
 * optimizer state live on the active backend (dev.cajeta.ml 0.11.1).
 *
 * The model is built from <kind>/config.npy and its weights imported from the
 * torch checkpoint <kind>/model.pt that gen_data.py wrote, so this side and the
 * torch side start from identical weights and read the identical batch
 * <kind>/x.npy, <kind>/y.npy.
 *
 *   train  one Adam step (lr 1e-3) per iteration; the check runs on to
 *          config/train.npy[0] steps (100; 20 under smoke) and passes when
 *          the loss at the last step is below the loss at the first.
 *   infer  eval-mode forward of the batch, then a stream sync on `device` (a
 *          launch is asynchronous, and nothing else reads the output back); the
 *          check is the output within Tol.*_LOGITS / Tol.TRANSFORMER_OUT of
 *          torch's on the same weights.
 */
public class NeuralBench extends MlBenchmark {

    public static int32 MLP = 0;
    public static int32 CNN = 1;
    public static int32 TRANSFORMER = 2;

    int32 kind;
    boolean training;
    Module net;
    Adam opt;
    Tensor<float32> x;
    Tensor<float32> y;
    Tensor<float32> out;
    ArrayList<float64> losses;
    String mdl;
    int64 steps;
    KernelStream stream;
    boolean onDevice;

    public NeuralBench(int32 kind, boolean training) {
        this.kind = kind;
        this.training = training;
        this.mdl = "";
        this.steps = 0;
        this.onDevice = false;
    }

    public String name() {
        if (this.kind == NeuralBench.MLP) {
            return this.training ? "mlp-train-step" : "mlp-infer";
        }
        if (this.kind == NeuralBench.CNN) {
            return this.training ? "cnn-train-step" : "cnn-infer";
        }
        return this.training ? "transformer-block-train" : "transformer-block-infer";
    }

    public String dir() {
        if (this.kind == NeuralBench.MLP) {
            return "mlp";
        }
        if (this.kind == NeuralBench.CNN) {
            return "cnn";
        }
        return "transformer";
    }

    public String unit() {
        return "samples/s";
    }

    public String model() {
        return this.mdl;
    }

    public int32 warmupIters() {
        if (this.kind == NeuralBench.TRANSFORMER) {
            return 2;
        }
        if (this.kind == NeuralBench.CNN) {
            return 3;
        }
        return 5;
    }

    public int32 measuredIters() {
        if (this.kind == NeuralBench.TRANSFORMER) {
            return 5;
        }
        if (this.kind == NeuralBench.CNN) {
            return 20;
        }
        return 50;
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("cpu");
        v.add("device");
        return v;
    }

    public String probe(String variant) {
        return this.dir() + "/model.pt";
    }

    public void build() {
        String d = this.dir();
        String cfg = d + "/config.npy";
        int64 a = Data.intAt(cfg, (int64) 0);
        int64 b = Data.intAt(cfg, (int64) 1);
        int64 c = Data.intAt(cfg, (int64) 2);
        if (this.kind == NeuralBench.MLP) {
            int64[] hidden = heap int64[1];
            hidden[0] = b;
            this.net = heap Mlp(a, hidden, c, Data.SEED);
            this.mdl = "mlp " + a + "-" + b + "-" + c + " f32";
        } else if (this.kind == NeuralBench.CNN) {
            this.net = heap SmallCnn(a, b, c, Data.SEED);
            this.mdl = "small-cnn c" + a + " w" + b + " k" + c + " f32";
        } else {
            this.net = heap EncoderBlock(a, (int32) b, c, Data.SEED);
            this.mdl = "encoder-block d" + a + " h" + b + " ff" + c + " f32";
        }
        String pt #= Data.path(d + "/model.pt");
        Train.importPt(this.net, pt);
    }

    public void prepare(String v) {
        this.begin(v);
        this.build();
        String d = this.dir();
        this.x #= Data.f32(d + "/x.npy");
        this.y #= Data.f32(d + "/y.npy");
        this.nIn = this.x.shapeAt(0);
        this.steps = Data.intAt("config/train.npy", (int64) 0);
        this.ds = d + " batch " + Data.shape32(this.x) + " seed " + Data.SEED;
        this.onDevice = v.equals("device");
        if (this.onDevice) {
            this.net.toDevice();
            this.x.gpu();
            this.y.gpu();
            this.stream #= KernelStream.current();
        }
        if (this.training) {
            this.net.train();
            this.opt = heap Adam(#this.net.parameters(), 0.001f);
            this.losses = heap ArrayList<float64>();
        } else {
            this.net.eval();
        }
    }

    public void runVariant(String variant, int32 iterations) {
        if (this.training) {
            float64 l = Train.step(this.net, this.opt, this.x, this.y,
                                   this.kind == NeuralBench.TRANSFORMER);
            this.losses.add(l);
        } else {
            this.out #= this.net.predict(this.x);
            if (this.onDevice) {
                this.stream.sync();
            }
        }
    }

    public boolean checkResult() {
        if (this.training) {
            while ((int64) this.losses.count() < this.steps) {
                this.runVariant(this.cur, 1);
            }
            float64 first = this.losses.get(0);
            float64 last = this.losses.get((int32) this.steps - 1);
            this.note = "Adam lr 1e-3; loss " + first + " -> " + last + " over " + this.steps
                + " steps";
            return last < first;
        }
        String refName = "ref/mlp-logits.npy";
        float64 tol = Tol.MLP_LOGITS;
        if (this.kind == NeuralBench.CNN) {
            refName = "ref/cnn-logits.npy";
            tol = Tol.CNN_LOGITS;
        } else if (this.kind == NeuralBench.TRANSFORMER) {
            refName = "ref/transformer-out.npy";
            tol = Tol.TRANSFORMER_OUT;
        }
        Tensor<float32> ref #= Data.f32(refName);
        if (this.out.isOnGpu()) {
            this.out.cpu();
        }
        if (ref.size() != this.out.size()) {
            this.note = "output size " + this.out.size() + " != torch's " + ref.size();
            return false;
        }
        float64 worst = Data.maxDiff32(this.out, ref, ref.size());
        this.note = "eval; max |out - torch| " + worst + " <= " + tol;
        return worst <= tol;
    }
}
