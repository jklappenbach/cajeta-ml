package bench.ml;

import dev.cajeta.bench.Benchmark;
import dev.cajeta.ml.grad.Op;
import dev.cajeta.ml.grad.Ops;

/**
 * What every dev.cajeta.ml row shares: area `ml` (so the row id is
 * `ml/<name>`), the library and platform, the per-variant state a measured
 * variant leaves for the harness to read back (dataset, input size, the
 * check's detail for notes), and the device rule.
 *
 * A `device` variant is skipped, with the reason on the row, when
 * CAJETA_BENCH_NO_GPU=1 (the GPU belongs to another session), or when
 * dev.cajeta.ml has no device kernels to run it on: its Ops dispatch seam has
 * an empty GPU column in 0.10.6 (Ops.hasGpu answers false for every op).
 * The decision and its reason are functions of the variant (supportsVariant,
 * skipReasonFor, backendFor); nothing is stashed between harness calls.
 * Every subclass's prepare(v) starts with begin(v).
 */
public class MlBenchmark extends Benchmark {

    public String cur;
    public String note;
    public String ds;
    public int64 nIn;

    public MlBenchmark() {
        this.cur = "";
        this.note = "";
        this.ds = "";
        this.nIn = -1;
    }

    public String area() {
        return "ml";
    }

    public String library() {
        return "dev.cajeta.ml";
    }

    public String libraryVersion() {
        return "0.10.6";
    }

    public String platform() {
        return "dev.cajeta.ml 0.10.6";
    }

    public String competitorNote() {
        return this.note;
    }

    public String datasetInfo() {
        return this.ds;
    }

    public int64 inputSize() {
        return this.nIn;
    }

    public int32 warmupIters() {
        return 3;
    }

    public int32 measuredIters() {
        return 10;
    }

    public String backendFor(String v) {
        if (v.equals("device")) {
            return "gpu";
        }
        return "cpu";
    }

    // The data a variant needs; overridden per benchmark.
    public String probe(String variant) {
        return "";
    }

    // The start of a measured variant: the per-variant state back to empty.
    public void begin(String v) {
        this.cur = "" + v;
        this.note = "";
        this.ds = "";
        this.nIn = -1;
    }

    // Why `v` cannot run here, or "" when it can.
    public #String whyNot(String v) {
        if (v.equals("device")) {
            if (Data.noGpu()) {
                return "GPU held by another session (CAJETA_BENCH_NO_GPU=1)";
            }
            if (!Ops.hasGpu(Op.MATMUL)) {
                return "dev.cajeta.ml 0.10.6 has no device kernels (the Ops GPU column is empty)";
            }
        }
        String need = this.probe(v);
        if (!need.isEmpty()) {
            if (!Data.has(need)) {
                return "dataset " + need + " not generated (run bench.sh, which runs gen_data.py)";
            }
        }
        return "";
    }

    public boolean supportsVariant(String v) {
        String why #= this.whyNot(v);
        return why.isEmpty();
    }

    // The skipped row is made right after this call: it carries no state of
    // the variant measured before it.
    public String skipReasonFor(String v) {
        this.begin(v);
        String why #= this.whyNot(v);
        return "" + why;
    }
}
