package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.Isomap;
import dev.cajeta.ml.LLE;
import dev.cajeta.ml.SpectralEmbedding;

/**
 * ml-unsupervised plan 11.1 — the spectral manifold family (spec
 * §9.11–§9.16). Parity is through SIGN-FREE invariants (kernel /
 * Laplacian eigenvalues, reconstruction error — all matching sklearn
 * 1.9.0 on the deterministic swiss-roll fixture, oracle recorded
 * 2026-08-05); eigenvector sign is indeterminate and never compared
 * (§9.16). The numpy replication of sklearn's graph conventions was
 * validated against sklearn's own embeddings before porting (Isomap
 * kernel eigenvalues == sklearn embedding column norms², exactly).
 */
public class SpectralManifoldTest {

    public SpectralManifoldTest() { return; }

    /** Deterministic swiss roll, 60 points: u=i/59, t=1.5π(1+2u),
     *  (t·cos t, 3·((17i mod 60)/59), t·sin t). */
    static #Tensor<float64> roll() {
        float64[] d = heap float64[180];
        int64 i = 0;
        while (i < 60) {
            float64 u = (float64) i / 59.0;
            float64 t = 1.5 * 3.14159265358979 * (1.0 + 2.0 * u);
            int64 hm = i * (int64) 17
                - (i * (int64) 17 / (int64) 60) * (int64) 60;
            d[i * 3] = t * Math.cos(t);
            d[i * 3 + 1] = 3.0 * (float64) hm / 59.0;
            d[i * 3 + 2] = t * Math.sin(t);
            i = i + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = 60;
        sh[1] = 3;
        return Tensor.of<float64>(d, sh);
    }

    static #Tensor<float64> ignoredY(int64 n) {
        int64[] sh = heap int64[1];
        sh[0] = n;
        return Tensor.zeros<float64>(sh);
    }

    // 11.1.1 / §9.11 — Isomap: kernel eigenvalues match sklearn (the
    // rotation/sign-free parity: sklearn's embedding column norms² ARE
    // these eigenvalues); transform is EXACT on training rows; a
    // disconnected graph is loud and names nNeighbors.
    @Test
    public void isomapMatchesSklearnAndTransformsUnseen() {
        Tensor<float64> x = SpectralManifoldTest.roll();
        Tensor<float64> y = SpectralManifoldTest.ignoredY((int64) 60);
        Isomap iso = heap Isomap((int64) 6, (int64) 2);
        Tensor<float64> e = iso.fitTransform(x, y);
        Assert.equals((int64) 60, e.shapeAt(0));
        Assert.equals((int64) 2, e.shapeAt(1));
        float64[] lam = iso.kernelEigenvalues();
        Assert.isTrue(Fixtures.close(lam[0], 6913.353627318706, 0.5));
        Assert.isTrue(Fixtures.close(lam[1], 5212.739013918832, 0.5));
        // Column norm² equals the eigenvalue (classical-MDS identity).
        float64 n0 = 0.0;
        int64 i = 0;
        while (i < 60) {
            n0 = n0 + e.get2(i, 0) * e.get2(i, 0);
            i = i + 1;
        }
        Assert.isTrue(Fixtures.close(n0, lam[0], 0.5));
        // Nyström transform reproduces training rows exactly.
        Tensor<float64> t2 = iso.transform(x);
        i = 0;
        while (i < t2.size()) {
            Assert.isTrue(Fixtures.close(t2.flatGet(i), e.flatGet(i),
                0.000001));
            i = i + 1;
        }
        // Disconnected k-NN graph: loud, naming nNeighbors.
        Assert.assertThrows(() -> {
            float64[] d = heap float64[16];
            d[0] = 0.0;  d[1] = 0.0;
            d[2] = 0.1;  d[3] = 0.0;
            d[4] = 0.0;  d[5] = 0.1;
            d[6] = 0.1;  d[7] = 0.1;
            d[8] = 50.0; d[9] = 50.0;
            d[10] = 50.1; d[11] = 50.0;
            d[12] = 50.0; d[13] = 50.1;
            d[14] = 50.1; d[15] = 50.1;
            int64[] sh = heap int64[2];
            sh[0] = 8;
            sh[1] = 2;
            Tensor<float64> far = Tensor.of<float64>(d, sh);
            Isomap bad = heap Isomap((int64) 2, (int64) 2);
            bad.fit(far, SpectralManifoldTest.ignoredY((int64) 8));
        });
    }

    // 11.1.2 / §9.12 — LLE: reconstruction error in sklearn's
    // neighbourhood (1.447e-6 — the sum of the kept bottom eigenvalues,
    // so this pins them), unit-norm sign-indeterminate columns, and
    // transform mapping training rows next to their fitted embedding.
    @Test
    public void lleMatchesSklearnInvariants() {
        Tensor<float64> x = SpectralManifoldTest.roll();
        Tensor<float64> y = SpectralManifoldTest.ignoredY((int64) 60);
        LLE lle = heap LLE((int64) 6, (int64) 2);
        Tensor<float64> e = lle.fitTransform(x, y);
        Assert.equals((int64) 60, e.shapeAt(0));
        Assert.equals((int64) 2, e.shapeAt(1));
        // sklearn reconstruction_error_: 1.4469796213604682e-06. The
        // bottom eigenvalues sit near the eigensolver's precision floor,
        // so the pin carries magnitude tolerance, not digits.
        float64 err = lle.reconstructionError();
        Assert.isTrue(err > 0.0);
        Assert.isTrue(Fixtures.close(err, 0.0000014469796213604682,
            0.000002));
        // Unit-norm eigenvector columns (sklearn's scaling).
        int64 c = 0;
        while (c < 2) {
            float64 nn = 0.0;
            int64 i = 0;
            while (i < 60) {
                nn = nn + e.get2(i, c) * e.get2(i, c);
                i = i + 1;
            }
            Assert.isTrue(Fixtures.close(nn, 1.0, 0.0001));
            c = c + 1;
        }
        // Transform: per-column |correlation| with the fitted embedding
        // > 0.99 over the training rows (self is among the neighbours).
        Tensor<float64> t = lle.transform(x);
        c = 0;
        while (c < 2) {
            float64 ma = 0.0;
            float64 mb = 0.0;
            int64 i = 0;
            while (i < 60) {
                ma = ma + e.get2(i, c);
                mb = mb + t.get2(i, c);
                i = i + 1;
            }
            ma = ma / 60.0;
            mb = mb / 60.0;
            float64 sab = 0.0;
            float64 saa = 0.0;
            float64 sbb = 0.0;
            i = 0;
            while (i < 60) {
                float64 da = e.get2(i, c) - ma;
                float64 db = t.get2(i, c) - mb;
                sab = sab + da * db;
                saa = saa + da * da;
                sbb = sbb + db * db;
                i = i + 1;
            }
            float64 corr = sab / Math.sqrt(saa * sbb);
            if (corr < 0.0) {
                corr = 0.0 - corr;
            }
            Assert.isTrue(corr > 0.99);
            c = c + 1;
        }
    }

    // 11.1.3 / §9.13 — Laplacian eigenmaps: the kept non-trivial
    // eigenvalues match sklearn's normalized Laplacian over BOTH
    // affinities; the dropped trivial eigenvector is documented; the
    // API is fitTransform-only.
    @Test
    public void spectralEmbeddingMatchesSklearnEigenvalues() {
        Tensor<float64> x = SpectralManifoldTest.roll();
        SpectralEmbedding sk = heap SpectralEmbedding((int64) 2,
            (int64) 6);
        Tensor<float64> ek = sk.fitTransform(x);
        Assert.equals((int64) 60, ek.shapeAt(0));
        float64[] wk = sk.eigenvalues();
        Assert.isTrue(Fixtures.close(wk[0], 0.027141530810627867,
            0.00001));
        Assert.isTrue(Fixtures.close(wk[1], 0.054450250389715134,
            0.00001));
        // The trivial λ≈0 eigenvector was dropped: every kept value is
        // clearly non-zero.
        Assert.isTrue(wk[0] > 0.001);
        // RBF affinity, gamma = 1/p = 1/3.
        SpectralEmbedding sr = heap SpectralEmbedding((int64) 2,
            0.3333333333333333);
        sr.fitTransform(x);
        float64[] wr = sr.eigenvalues();
        Assert.isTrue(Fixtures.close(wr[0], 0.0004727473308772296,
            0.00001));
        Assert.isTrue(Fixtures.close(wr[1], 0.0020300132590427497,
            0.00001));
        // fitTransform-only shape: eigenvalues before a fit throws
        // (no transform for unseen points exists on the class).
        Assert.assertThrows(() -> {
            SpectralEmbedding un = heap SpectralEmbedding((int64) 2,
                (int64) 6);
            un.eigenvalues();
        });
    }

    // 11.1.4 / §9.15 / §9.16 — determinism: repeated fits are identical
    // (the family is deterministic up to eigenvector sign, and one
    // process's eigh resolves signs consistently); the O(n²)–O(n³)
    // limits live in each class's docs.
    @Test
    public void deterministicUpToSignAndReproducible() {
        Tensor<float64> x = SpectralManifoldTest.roll();
        Tensor<float64> y = SpectralManifoldTest.ignoredY((int64) 60);
        Isomap a = heap Isomap((int64) 6, (int64) 2);
        Tensor<float64> ea = a.fitTransform(x, y);
        Isomap b = heap Isomap((int64) 6, (int64) 2);
        Tensor<float64> eb = b.fitTransform(x, y);
        int64 i = 0;
        while (i < ea.size()) {
            Assert.isTrue(ea.flatGet(i) == eb.flatGet(i));
            i = i + 1;
        }
        SpectralEmbedding s1 = heap SpectralEmbedding((int64) 2,
            (int64) 6);
        Tensor<float64> e1 = s1.fitTransform(x);
        SpectralEmbedding s2 = heap SpectralEmbedding((int64) 2,
            (int64) 6);
        Tensor<float64> e2 = s2.fitTransform(x);
        i = 0;
        while (i < e1.size()) {
            Assert.isTrue(e1.flatGet(i) == e2.flatGet(i));
            i = i + 1;
        }
    }
}
