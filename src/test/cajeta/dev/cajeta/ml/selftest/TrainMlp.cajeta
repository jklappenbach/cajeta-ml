package dev.cajeta.ml.selftest;

import cajeta.math.Tensor;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.nn.Linear;
import dev.cajeta.ml.nn.Module;

/**
 * The training-trajectory fixture: the reference MLP with weights set from
 * the generator's formulas, so twenty SGD steps here and twenty in torch
 * are comparable step for step.
 */
public class TrainMlp extends Module {
    Linear fc1;
    Linear fc2;

    public TrainMlp() {
        this.fc1 = heap Linear(3, 4, 1L);
        this.fc2 = heap Linear(4, 2, 2L);
        Tensor<float32> w1 = this.fc1.weightParam().get();
        int64 f = 0;
        while (f < 12) {
            w1.flatSet(f, (float32) (f % 5) * 0.5f - 1.0f);
            f = f + 1;
        }
        Tensor<float32> b1 = this.fc1.biasParam().get();
        b1.flatSet(0, 0.1f);
        b1.flatSet(1, -0.2f);
        b1.flatSet(2, 0.3f);
        b1.flatSet(3, -0.4f);
        Tensor<float32> w2 = this.fc2.weightParam().get();
        f = 0;
        while (f < 8) {
            w2.flatSet(f, (float32) (f % 5) * 0.5f - 1.0f);
            f = f + 1;
        }
        Tensor<float32> b2 = this.fc2.biasParam().get();
        b2.flatSet(0, 0.05f);
        b2.flatSet(1, -0.05f);
        return;
    }

    /** `x (4, 3)`, the generator's `x_` grid. */
    public static #Tensor<float32> inputs() {
        int64[] s = heap int64[2];
        s[0] = 4;
        s[1] = 3;
        Tensor<float32> t = Tensor.zeros<float32>(s);
        int64 f = 0;
        while (f < 12) {
            t.flatSet(f, (float32) (f % 7) * 0.25f - 0.75f);
            f = f + 1;
        }
        return #t;
    }

    /** `target (4, 2)`: `(f % 3) * 0.5 - 0.5`. */
    public static #Tensor<float32> targets() {
        int64[] s = heap int64[2];
        s[0] = 4;
        s[1] = 2;
        Tensor<float32> t = Tensor.zeros<float32>(s);
        int64 f = 0;
        while (f < 8) {
            t.flatSet(f, (float32) (f % 3) * 0.5f - 0.5f);
            f = f + 1;
        }
        return #t;
    }

    public Tensor<float32> w1() {
        return this.fc1.weightParam().get();
    }

    public Tensor<float32> b2() {
        return this.fc2.biasParam().get();
    }

    public GradTensor forward(GradTape<float32> tape, GradTensor x) {
        return this.fc2.forward(tape, tape.relu(this.fc1.forward(tape, x)));
    }
}
