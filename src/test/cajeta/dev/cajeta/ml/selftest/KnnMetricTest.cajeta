package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import cajeta.math.distance.Chebyshev;
import cajeta.math.distance.Euclidean;
import cajeta.math.distance.Manhattan;
import cajeta.math.distance.Metric;
import cajeta.math.distance.Minkowski;
import dev.cajeta.ml.KNeighborsClassifier;
import dev.cajeta.ml.KNeighborsRegressor;
import dev.cajeta.ml.Pipeline;
import dev.cajeta.ml.Predictor;
import dev.cajeta.ml.StandardScaler;
import dev.cajeta.ml.Transformer;

/**
 * ml-classification-gaps plan Unit 3 — k-NN metric parity + classifier
 * distance weighting (spec §5), pinned against sklearn 1.9.0
 * (gen_knn_metrics.py) on gen_knn.py's tie-free 12x2 fixture. The metric
 * is `cajeta.math.distance.Metric` — the one stdlib seam — and the
 * neighbour search / voting / tie-breaking are metric-agnostic (§5.6),
 * proven by a custom metric defined here in the test.
 */
public class KnnMetricTest {

    public KnnMetricTest() { return; }

    static boolean near(float64 a, float64 b, float64 tol) {
        float64 d = a - b;
        if (d < 0.0) {
            d = -d;
        }
        return d < tol;
    }

    static #Tensor<float64> trainX() {
        float64[] d = heap float64[24];
        int64 i = 0;
        while (i < 12) {
            d[i * 2] = (float64) i * 0.7;
            d[i * 2 + 1] = (float64) ((i * 5) % 7) * 0.31;
            i = i + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = 12;
        sh[1] = 2;
        return Tensor.of<float64>(d, sh);
    }

    static #Tensor<float64> classY() {
        float64[] d = heap float64[12];
        int64 i = 0;
        while (i < 12) {
            if (i >= 6) {
                d[i] = 1.0;
            }
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = 12;
        return Tensor.of<float64>(d, sh);
    }

    static #Tensor<float64> regY() {
        float64[] d = heap float64[12];
        int64 i = 0;
        while (i < 12) {
            float64 x0 = (float64) i * 0.7;
            float64 x1 = (float64) ((i * 5) % 7) * 0.31;
            d[i] = 2.0 * x0 - x1 + 0.25;
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = 12;
        return Tensor.of<float64>(d, sh);
    }

    /** Boundary queries (classifier + weighting pins). */
    static #Tensor<float64> queryQ() {
        float64[] d = heap float64[6];
        d[0] = 3.9; d[1] = 0.8;
        d[2] = 4.3; d[3] = 1.4;
        d[4] = 3.6; d[5] = 0.2;
        int64[] sh = heap int64[2];
        sh[0] = 3;
        sh[1] = 2;
        return Tensor.of<float64>(d, sh);
    }

    /** Interior queries (regressor metric pins). */
    static #Tensor<float64> queryQ2() {
        float64[] d = heap float64[6];
        d[0] = 1.0; d[1] = 0.5;
        d[2] = 5.3; d[3] = 1.2;
        d[4] = 7.7; d[5] = 0.1;
        int64[] sh = heap int64[2];
        sh[0] = 3;
        sh[1] = 2;
        return Tensor.of<float64>(d, sh);
    }

    // 3.1.1 — each stdlib metric matches sklearn on both estimators.
    @Test
    public void metricsMatchSklearn() {
        Tensor<float64> x = trainX();
        Tensor<float64> yc = classY();
        Tensor<float64> yr = regY();
        Tensor<float64> q = queryQ();
        Tensor<float64> q2 = queryQ2();

        Metric man = heap Manhattan();
        KNeighborsClassifier cm = heap KNeighborsClassifier((int64) 3, #man);
        cm.fit(x, yc);
        Tensor<float64> pm = cm.predictProba(q);
        Assert.isTrue(near(pm.get2(0, 0), 0.3333333333333333, 0.000001));
        Assert.isTrue(near(pm.get2(0, 1), 0.6666666666666666, 0.000001));
        Assert.isTrue(near(cm.predict(q).flatGet(0), 1.0, 0.0000001));

        Metric man2 = heap Manhattan();
        KNeighborsRegressor rm = heap KNeighborsRegressor((int64) 3, false,
            #man2);
        rm.fit(x, yr);
        Tensor<float64> vr = rm.predict(q2);
        Assert.isTrue(near(vr.flatGet(0), 2.1199999999999997, 0.000001));
        Assert.isTrue(near(vr.flatGet(1), 10.623333333333333, 0.000001));
        Assert.isTrue(near(vr.flatGet(2), 13.216666666666667, 0.000001));

        Metric che = heap Chebyshev();
        KNeighborsRegressor rc = heap KNeighborsRegressor((int64) 3, false,
            #che);
        rc.fit(x, yr);
        Tensor<float64> vc = rc.predict(q2);
        Assert.isTrue(near(vc.flatGet(0), 0.8233333333333333, 0.000001));
        Assert.isTrue(near(vc.flatGet(1), 9.95, 0.000001));

        Metric mink = heap Minkowski(3.0);
        KNeighborsRegressor rk = heap KNeighborsRegressor((int64) 3, false,
            #mink);
        rk.fit(x, yr);
        Tensor<float64> vk = rk.predict(q2);
        Assert.isTrue(near(vk.flatGet(0), 0.8233333333333333, 0.000001));
        Assert.isTrue(near(vk.flatGet(2), 13.216666666666667, 0.000001));

        // Euclidean stays the default: the metric ctor with Euclidean
        // reproduces the metricless ctor exactly.
        Metric euc = heap Euclidean();
        KNeighborsClassifier ce = heap KNeighborsClassifier((int64) 3, #euc);
        ce.fit(x, yc);
        KNeighborsClassifier cd = heap KNeighborsClassifier((int64) 3);
        cd.fit(x, yc);
        Tensor<float64> pe = ce.predictProba(q);
        Tensor<float64> pd = cd.predictProba(q);
        int64 f = 0;
        while (f < 6) {
            Assert.isTrue(near(pe.flatGet(f), pd.flatGet(f),
                0.000000000001));
            f = f + 1;
        }
    }

    // 3.1.2 — classifier distance weighting matches sklearn's
    // `weights='distance'`, euclidean and manhattan.
    @Test
    public void classifierDistanceWeights() {
        Tensor<float64> x = trainX();
        Tensor<float64> yc = classY();
        Tensor<float64> q = queryQ();

        KNeighborsClassifier ce = heap KNeighborsClassifier((int64) 3, true);
        ce.fit(x, yc);
        Tensor<float64> pe = ce.predictProba(q);
        Assert.isTrue(near(pe.get2(0, 0), 0.3160545122723284, 0.000001));
        Assert.isTrue(near(pe.get2(0, 1), 0.6839454877276716, 0.000001));
        Assert.isTrue(near(pe.get2(1, 0), 0.37581317608598475, 0.000001));
        Assert.isTrue(near(pe.get2(2, 1), 0.6895273302535835, 0.000001));
        Assert.isTrue(near(ce.predict(q).flatGet(0), 1.0, 0.0000001));

        Metric man = heap Manhattan();
        KNeighborsClassifier cm = heap KNeighborsClassifier((int64) 3, #man,
            true);
        cm.fit(x, yc);
        Tensor<float64> pm = cm.predictProba(q);
        Assert.isTrue(near(pm.get2(0, 0), 0.31088082901554387, 0.000001));
        Assert.isTrue(near(pm.get2(1, 0), 0.3632429970393989, 0.000001));
        Assert.isTrue(near(pm.get2(2, 1), 0.6524938675388391, 0.000001));
    }

    // 3.1.4 + §5.4 — an exact match takes all the weight; no division by
    // zero.
    @Test
    public void exactMatchTakesAllWeight() {
        Tensor<float64> x = trainX();
        Tensor<float64> yc = classY();
        KNeighborsClassifier c = heap KNeighborsClassifier((int64) 3, true);
        c.fit(x, yc);
        float64[] qd = heap float64[4];
        qd[0] = 4.9;                       // = row 7 exactly (7*0.7, (35%7)*0.31)
        qd[1] = 0.0;
        qd[2] = 1.0;
        qd[3] = 0.5;
        int64[] qs = heap int64[2];
        qs[0] = 2;
        qs[1] = 2;
        Tensor<float64> pr = c.predictProba(Tensor.of<float64>(qd, qs));
        Assert.isTrue(near(pr.get2(0, 0), 0.0, 0.000000001));
        Assert.isTrue(near(pr.get2(0, 1), 1.0, 0.000000001));
        Assert.isTrue(near(pr.get2(1, 0), 1.0, 0.000000001));
    }

    // 3.1.3 + §5.5 — a constructed vote tie breaks to the lowest label.
    @Test
    public void voteTieBreaksToLowestLabel() {
        float64[] xd = heap float64[8];
        xd[0] = -1.0; xd[1] = 0.0;
        xd[2] = 1.0;  xd[3] = 0.0;
        xd[4] = -3.0; xd[5] = 0.0;
        xd[6] = 3.0;  xd[7] = 0.0;
        int64[] xs = heap int64[2];
        xs[0] = 4;
        xs[1] = 2;
        float64[] yd = heap float64[4];
        yd[0] = 1.0;                       // nearer pair: labels 1 and 0
        yd[1] = 0.0;
        yd[2] = 1.0;
        yd[3] = 0.0;
        int64[] ys = heap int64[1];
        ys[0] = 4;
        KNeighborsClassifier c = heap KNeighborsClassifier((int64) 2);
        c.fit(Tensor.of<float64>(xd, xs), Tensor.of<float64>(yd, ys));
        float64[] qd = heap float64[2];
        qd[0] = 0.0;
        qd[1] = 0.0;
        int64[] qs = heap int64[2];
        qs[0] = 1;
        qs[1] = 2;
        Tensor<float64> lab = c.predict(Tensor.of<float64>(qd, qs));
        Assert.isTrue(near(lab.flatGet(0), 0.0, 0.0000001));
    }

    // 3.1.5 + §5.6 — a metric defined OUTSIDE the library drops into the
    // seam with no change to the classifier: axis-0-only distance makes
    // x1 irrelevant, which flips a neighbourhood.
    @Test
    public void customMetricThroughTheSeam() {
        Tensor<float64> x = trainX();
        Tensor<float64> yc = classY();
        Metric ax = heap Axis0Metric();
        KNeighborsClassifier c = heap KNeighborsClassifier((int64) 3, #ax);
        c.fit(x, yc);
        float64[] qd = heap float64[2];
        qd[0] = 3.9;
        qd[1] = 100.0;                     // x1 ignored by the metric
        int64[] qs = heap int64[2];
        qs[0] = 1;
        qs[1] = 2;
        Tensor<float64> pr = c.predictProba(Tensor.of<float64>(qd, qs));
        // Neighbours by x0 alone around 3.9: rows 6 (4.2), 5 (3.5),
        // 7 (4.9) -> votes 2/3 class 1, x1's magnitude never enters.
        Assert.isTrue(near(pr.get2(0, 0), 0.3333333333333333, 0.000001));
        Assert.isTrue(near(c.predict(Tensor.of<float64>(qd, qs)).flatGet(0),
            1.0, 0.0000001));
    }

    // 3.1.6 + §5.7 — StandardScaler + k-NN composes with any metric.
    @Test
    public void scaledPipelineComposes() {
        Tensor<float64> x = trainX();
        Tensor<float64> yc = classY();
        Transformer sc = heap StandardScaler();
        Metric man = heap Manhattan();
        Predictor kn = heap KNeighborsClassifier((int64) 3, #man);
        Pipeline pl = Pipeline.of(#sc, #kn);
        pl.fit(x, yc);
        Assert.isTrue(pl.score(x, yc) > 0.9);
    }
}
