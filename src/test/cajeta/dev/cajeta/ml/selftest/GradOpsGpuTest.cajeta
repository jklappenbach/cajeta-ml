package dev.cajeta.ml.selftest;

import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.grad.Op;
import dev.cajeta.ml.grad.Ops;

/**
 * cajeta-ml-gpu 27.1.1 and 27.1.2 (spec §6.6, §6.7): the device column of the op seam. Each
 * op's forward (elementwise, row, binary, reduction and shape groups so far) on device-resident inputs matches the CPU column within float32's tolerance,
 * `Ops.hasGpu` answers true for it, and mixed residency fails by name.
 */
public class GradOpsGpuTest {
    public GradOpsGpuTest() { return; }

    /** rows x cols of (f*7919 % 251 - 125) * 0.012 (+ 1.6 when positive), the same sequence the CPU column sees. */
    static #Tensor<float32> fill(int64 rows, int64 cols, int64 seed, boolean positive) {
        int64[] sh = [rows, cols];
        Tensor<float32> t #= Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < rows * cols) {
            float32 v = (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f;
            if (positive) { v = v + 1.6f; }
            t.flatSet(f, v);
            f = f + 1;
        }
        return #t;
    }

    /** A device-resident copy. */
    static #Tensor<float32> onDevice(Tensor<float32> t) {
        Tensor<float32> d #= t.copy();
        d.gpu();
        return #d;
    }

    static void same(String what, Tensor<float32> want, Tensor<float32> got) {
        GradOpsGpuTest.sameWithin(what, want, got, 0.0);
    }

    /** `extra` is an absolute allowance on top of float32's relative tolerance: a sum over
     *  n terms differs between the CPU column's sequential order and the device's by up to
     *  n x 3e-7 at this data's magnitude. */
    static void sameWithin(String what, Tensor<float32> want, Tensor<float32> got, float64 extra) {
        Assert.isTrue(got.isOnGpu());
        got.cpu();
        Assert.equals((int64) want.ndim(), (int64) got.ndim());
        int64 n = want.size();
        Assert.equals(n, got.size());
        int64 i = 0;
        while (i < n) {
            float64 w = (float64) want.flatGet(i);
            float64 g = (float64) got.flatGet(i);
            float64 d = g - w;
            if (d < 0.0) { d = 0.0 - d; }
            float64 aw = w;
            if (aw < 0.0) { aw = 0.0 - aw; }
            if (!(d <= 1.0e-5 * (aw + 1.0) + extra)) {
                System.stdout.println("  " + what + " [" + i + "] device " + g + " cpu " + w);
                Assert.isTrue(false);
            }
            i = i + 1;
        }
    }

    static void unary(int32 op, boolean positive, float32 c) {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, (int64) op, positive);
        Tensor<float32> want #= Ops.run1<float32>(op, a, -1, c);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        Tensor<float32> got #= Ops.run1<float32>(op, ad, -1, c);
        GradOpsGpuTest.same(Ops.name(op), want, got);
        Assert.isTrue(Ops.hasGpu(op));
    }

    @Test
    public void elementwiseAndRowOpsRunOnTheDevice() {
        GradOpsGpuTest.unary(Op.RELU, false, 0.0f);
        GradOpsGpuTest.unary(Op.NEG, false, 0.0f);
        GradOpsGpuTest.unary(Op.EXP, false, 0.0f);
        GradOpsGpuTest.unary(Op.LOG, true, 0.0f);
        GradOpsGpuTest.unary(Op.SQRT, true, 0.0f);
        GradOpsGpuTest.unary(Op.TANH, false, 0.0f);
        GradOpsGpuTest.unary(Op.SIGMOID, false, 0.0f);
        GradOpsGpuTest.unary(Op.GELU, false, 0.0f);
        GradOpsGpuTest.unary(Op.SOFTMAX, false, 0.0f);
        GradOpsGpuTest.unary(Op.LOGSOFTMAX, false, 0.0f);
        GradOpsGpuTest.unary(Op.POWS, true, 2.0f);
        GradOpsGpuTest.unary(Op.ROWNORM, false, 0.0f);
    }

    /** rows x cols x depth of the same sequence, for the axis reductions. */
    static #Tensor<float32> fill3(int64 rows, int64 cols, int64 depth, int64 seed) {
        int64[] sh = [rows, cols, depth];
        Tensor<float32> t #= Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < rows * cols * depth) {
            t.flatSet(f, (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f);
            f = f + 1;
        }
        return #t;
    }

    static void reduce(int32 op, Tensor<float32> a, int32 axis) {
        Tensor<float32> want #= Ops.run1<float32>(op, a, axis, 0.0f);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        Tensor<float32> got #= Ops.run1<float32>(op, ad, axis, 0.0f);
        int64 terms = a.size();
        if (op == Op.SUMAXIS || op == Op.MEANAXIS || op == Op.MAXAXIS) {
            int32 ax = axis;
            if (ax < 0) { ax = ax + a.ndim(); }
            terms = a.shapeAt(ax);
        }
        GradOpsGpuTest.sameWithin(Ops.name(op) + " axis " + axis, want, got, (float64) terms * 3.0e-7);
        int32 d = 0;
        while (d < want.ndim()) { Assert.equals(want.shapeAt(d), got.shapeAt(d)); d = d + 1; }
        Assert.isTrue(Ops.hasGpu(op));
    }

    @Test
    public void reductionsRunOnTheDevice() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 5L, false);
        GradOpsGpuTest.reduce(Op.SUM, a, -1);
        GradOpsGpuTest.reduce(Op.MEAN, a, -1);
        Tensor<float32> big #= GradOpsGpuTest.fill(300L, 70L, 9L, false);
        GradOpsGpuTest.reduce(Op.SUM, big, -1);
        GradOpsGpuTest.reduce(Op.MEAN, big, -1);
        Tensor<float32> t #= GradOpsGpuTest.fill3(3L, 7L, 5L, 11L);
        int32 axis = -1;
        while (axis < 3) {
            GradOpsGpuTest.reduce(Op.SUMAXIS, t, axis);
            GradOpsGpuTest.reduce(Op.MEANAXIS, t, axis);
            GradOpsGpuTest.reduce(Op.MAXAXIS, t, axis);
            axis = axis + 1;
        }
        GradOpsGpuTest.reduce(Op.SUMAXIS, big, 0);
        GradOpsGpuTest.reduce(Op.MAXAXIS, big, 1);
    }

    @Test
    public void shapeOpsRunOnTheDevice() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 13L, false);
        GradOpsGpuTest.unary(Op.TRANSPOSE, false, 0.0f);
        Tensor<float32> t #= GradOpsGpuTest.fill3(3L, 7L, 5L, 17L);
        Tensor<float32> td #= GradOpsGpuTest.onDevice(t);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        // transposeBatch
        Tensor<float32> w1 #= Ops.run1<float32>(Op.TRANSPOSEB, t, 0, 0.0f);
        Tensor<float32> g1 #= Ops.run1<float32>(Op.TRANSPOSEB, td, 0, 0.0f);
        GradOpsGpuTest.same("transposeBatch", w1, g1);
        Assert.isTrue(Ops.hasGpu(Op.TRANSPOSEB));
        // permute
        int32[] perm = [2, 0, 1];
        Tensor<float32> w2 #= Ops.permute<float32>(t, perm);
        Tensor<float32> g2 #= Ops.permute<float32>(td, perm);
        GradOpsGpuTest.same("permute", w2, g2);
        Assert.equals(5L, g2.shapeAt(0));
        Assert.isTrue(Ops.hasGpu(Op.PERMUTE));
        // reshape
        int64[] ns = [7L, 3L];
        Tensor<float32> w3 #= Ops.reshape<float32>(a, ns);
        Tensor<float32> g3 #= Ops.reshape<float32>(ad, ns);
        GradOpsGpuTest.same("reshape", w3, g3);
        Assert.equals(7L, g3.shapeAt(0));
        Assert.isTrue(Ops.hasGpu(Op.RESHAPE));
        // slice, each axis
        Tensor<float32> w4 #= Ops.slice<float32>(t, 1, 2L, 5L);
        Tensor<float32> g4 #= Ops.slice<float32>(td, 1, 2L, 5L);
        GradOpsGpuTest.same("slice axis 1", w4, g4);
        Tensor<float32> w5 #= Ops.slice<float32>(t, 2, 1L, 4L);
        Tensor<float32> g5 #= Ops.slice<float32>(td, 2, 1L, 4L);
        GradOpsGpuTest.same("slice axis 2", w5, g5);
        Tensor<float32> w6 #= Ops.slice<float32>(t, 0, 1L, 3L);
        Tensor<float32> g6 #= Ops.slice<float32>(td, 0, 1L, 3L);
        GradOpsGpuTest.same("slice axis 0", w6, g6);
        Assert.isTrue(Ops.hasGpu(Op.SLICE));
        // concat, each axis
        Tensor<float32> u #= GradOpsGpuTest.fill3(3L, 7L, 5L, 29L);
        Tensor<float32> ud #= GradOpsGpuTest.onDevice(u);
        int32 ax = 0;
        while (ax < 3) {
            Tensor<float32> w7 #= Ops.concat<float32>(t, u, ax);
            Tensor<float32> g7 #= Ops.concat<float32>(td, ud, ax);
            GradOpsGpuTest.same("concat axis " + ax, w7, g7);
            ax = ax + 1;
        }
        Assert.isTrue(Ops.hasGpu(Op.CONCAT));
    }

    static void binary(int32 op, Tensor<float32> a, Tensor<float32> b) {
        Tensor<float32> want #= Ops.run2<float32>(op, a, b);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        Tensor<float32> bd #= GradOpsGpuTest.onDevice(b);
        Tensor<float32> got #= Ops.run2<float32>(op, ad, bd);
        GradOpsGpuTest.same(Ops.name(op), want, got);
        Assert.isTrue(Ops.hasGpu(op));
    }

    @Test
    public void binaryOpsRunOnTheDevice() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 1L, false);
        Tensor<float32> b #= GradOpsGpuTest.fill(3L, 7L, 2L, true);
        GradOpsGpuTest.binary(Op.ADD, a, b);
        GradOpsGpuTest.binary(Op.SUB, a, b);
        GradOpsGpuTest.binary(Op.MUL, a, b);
        GradOpsGpuTest.binary(Op.DIV, a, b);
        Tensor<float32> w #= GradOpsGpuTest.fill(7L, 5L, 3L, false);
        GradOpsGpuTest.binary(Op.MATMUL, a, w);
    }

    @Test
    public void mixedResidencyFailsByName() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 1L, false);
        Tensor<float32> b #= GradOpsGpuTest.fill(3L, 7L, 2L, true);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        boolean threw = false;
        try {
            Tensor<float32> r #= Ops.run2<float32>(Op.ADD, ad, b);
        } catch (MlException e) {
            threw = true;
            Assert.isTrue(e.getMessage().contains("add"));
            Assert.isTrue(e.getMessage().contains("different devices"));
        }
        Assert.isTrue(threw);
    }
}
