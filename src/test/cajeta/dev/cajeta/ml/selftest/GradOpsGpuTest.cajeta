package dev.cajeta.ml.selftest;

import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.grad.Op;
import dev.cajeta.ml.grad.Ops;

/**
 * cajeta-ml-gpu 27.1.1 and 27.1.2 (spec §6.6, §6.7): the device column of the op seam. Each
 * op's forward (every group) on device-resident inputs matches the CPU column within float32's tolerance,
 * `Ops.hasGpu` answers true for it, and mixed residency fails by name.
 */
public class GradOpsGpuTest {
    public GradOpsGpuTest() { return; }

    /** rows x cols of (f*7919 % 251 - 125) * 0.012 (+ 1.6 when positive), the same sequence the CPU column sees. */
    static #Tensor<float32> fill(int64 rows, int64 cols, int64 seed, boolean positive) {
        int64[] sh = [rows, cols];
        Tensor<float32> t #= Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < rows * cols) {
            float32 v = (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f;
            if (positive) { v = v + 1.6f; }
            t.flatSet(f, v);
            f = f + 1;
        }
        return #t;
    }

    /** A device-resident copy. */
    static #Tensor<float32> onDevice(Tensor<float32> t) {
        Tensor<float32> d #= t.copy();
        d.gpu();
        return #d;
    }

    static void same(String what, Tensor<float32> want, Tensor<float32> got) {
        GradOpsGpuTest.sameWithin(what, want, got, 0.0);
    }

    /** `extra` is an absolute allowance on top of float32's relative tolerance: a sum over
     *  n terms differs between the CPU column's sequential order and the device's by up to
     *  n x 3e-7 at this data's magnitude. */
    static void sameWithin(String what, Tensor<float32> want, Tensor<float32> got, float64 extra) {
        Assert.isTrue(got.isOnGpu());
        got.cpu();
        Assert.equals((int64) want.ndim(), (int64) got.ndim());
        int64 n = want.size();
        Assert.equals(n, got.size());
        int64 i = 0;
        while (i < n) {
            float64 w = (float64) want.flatGet(i);
            float64 g = (float64) got.flatGet(i);
            float64 d = g - w;
            if (d < 0.0) { d = 0.0 - d; }
            float64 aw = w;
            if (aw < 0.0) { aw = 0.0 - aw; }
            if (!(d <= 1.0e-5 * (aw + 1.0) + extra)) {
                System.stdout.println("  " + what + " [" + i + "] device " + g + " cpu " + w);
                Assert.isTrue(false);
            }
            i = i + 1;
        }
    }

    static void unary(int32 op, boolean positive, float32 c) {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, (int64) op, positive);
        Tensor<float32> want #= Ops.run1<float32>(op, a, -1, c);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        Tensor<float32> got #= Ops.run1<float32>(op, ad, -1, c);
        GradOpsGpuTest.same(Ops.name(op), want, got);
        Assert.isTrue(Ops.hasGpu(op));
    }

    @Test
    public void elementwiseAndRowOpsRunOnTheDevice() {
        GradOpsGpuTest.unary(Op.RELU, false, 0.0f);
        GradOpsGpuTest.unary(Op.NEG, false, 0.0f);
        GradOpsGpuTest.unary(Op.EXP, false, 0.0f);
        GradOpsGpuTest.unary(Op.LOG, true, 0.0f);
        GradOpsGpuTest.unary(Op.SQRT, true, 0.0f);
        GradOpsGpuTest.unary(Op.TANH, false, 0.0f);
        GradOpsGpuTest.unary(Op.SIGMOID, false, 0.0f);
        GradOpsGpuTest.unary(Op.GELU, false, 0.0f);
        GradOpsGpuTest.unary(Op.SOFTMAX, false, 0.0f);
        GradOpsGpuTest.unary(Op.LOGSOFTMAX, false, 0.0f);
        GradOpsGpuTest.unary(Op.POWS, true, 2.0f);
        GradOpsGpuTest.unary(Op.ROWNORM, false, 0.0f);
    }

    /** rows x cols x depth of the same sequence, for the axis reductions. */
    static #Tensor<float32> fill3(int64 rows, int64 cols, int64 depth, int64 seed) {
        int64[] sh = [rows, cols, depth];
        Tensor<float32> t #= Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < rows * cols * depth) {
            t.flatSet(f, (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f);
            f = f + 1;
        }
        return #t;
    }

    static void reduce(int32 op, Tensor<float32> a, int32 axis) {
        Tensor<float32> want #= Ops.run1<float32>(op, a, axis, 0.0f);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        Tensor<float32> got #= Ops.run1<float32>(op, ad, axis, 0.0f);
        int64 terms = a.size();
        if (op == Op.SUMAXIS || op == Op.MEANAXIS || op == Op.MAXAXIS) {
            int32 ax = axis;
            if (ax < 0) { ax = ax + a.ndim(); }
            terms = a.shapeAt(ax);
        }
        GradOpsGpuTest.sameWithin(Ops.name(op) + " axis " + axis, want, got, (float64) terms * 3.0e-7);
        int32 d = 0;
        while (d < want.ndim()) { Assert.equals(want.shapeAt(d), got.shapeAt(d)); d = d + 1; }
        Assert.isTrue(Ops.hasGpu(op));
    }

    @Test
    public void reductionsRunOnTheDevice() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 5L, false);
        GradOpsGpuTest.reduce(Op.SUM, a, -1);
        GradOpsGpuTest.reduce(Op.MEAN, a, -1);
        Tensor<float32> big #= GradOpsGpuTest.fill(300L, 70L, 9L, false);
        GradOpsGpuTest.reduce(Op.SUM, big, -1);
        GradOpsGpuTest.reduce(Op.MEAN, big, -1);
        Tensor<float32> t #= GradOpsGpuTest.fill3(3L, 7L, 5L, 11L);
        int32 axis = -1;
        while (axis < 3) {
            GradOpsGpuTest.reduce(Op.SUMAXIS, t, axis);
            GradOpsGpuTest.reduce(Op.MEANAXIS, t, axis);
            GradOpsGpuTest.reduce(Op.MAXAXIS, t, axis);
            axis = axis + 1;
        }
        GradOpsGpuTest.reduce(Op.SUMAXIS, big, 0);
        GradOpsGpuTest.reduce(Op.MAXAXIS, big, 1);
    }

    @Test
    public void shapeOpsRunOnTheDevice() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 13L, false);
        GradOpsGpuTest.unary(Op.TRANSPOSE, false, 0.0f);
        Tensor<float32> t #= GradOpsGpuTest.fill3(3L, 7L, 5L, 17L);
        Tensor<float32> td #= GradOpsGpuTest.onDevice(t);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        // transposeBatch
        Tensor<float32> w1 #= Ops.run1<float32>(Op.TRANSPOSEB, t, 0, 0.0f);
        Tensor<float32> g1 #= Ops.run1<float32>(Op.TRANSPOSEB, td, 0, 0.0f);
        GradOpsGpuTest.same("transposeBatch", w1, g1);
        Assert.isTrue(Ops.hasGpu(Op.TRANSPOSEB));
        // permute
        int32[] perm = [2, 0, 1];
        Tensor<float32> w2 #= Ops.permute<float32>(t, perm);
        Tensor<float32> g2 #= Ops.permute<float32>(td, perm);
        GradOpsGpuTest.same("permute", w2, g2);
        Assert.equals(5L, g2.shapeAt(0));
        Assert.isTrue(Ops.hasGpu(Op.PERMUTE));
        // reshape
        int64[] ns = [7L, 3L];
        Tensor<float32> w3 #= Ops.reshape<float32>(a, ns);
        Tensor<float32> g3 #= Ops.reshape<float32>(ad, ns);
        GradOpsGpuTest.same("reshape", w3, g3);
        Assert.equals(7L, g3.shapeAt(0));
        Assert.isTrue(Ops.hasGpu(Op.RESHAPE));
        // slice, each axis
        Tensor<float32> w4 #= Ops.slice<float32>(t, 1, 2L, 5L);
        Tensor<float32> g4 #= Ops.slice<float32>(td, 1, 2L, 5L);
        GradOpsGpuTest.same("slice axis 1", w4, g4);
        Tensor<float32> w5 #= Ops.slice<float32>(t, 2, 1L, 4L);
        Tensor<float32> g5 #= Ops.slice<float32>(td, 2, 1L, 4L);
        GradOpsGpuTest.same("slice axis 2", w5, g5);
        Tensor<float32> w6 #= Ops.slice<float32>(t, 0, 1L, 3L);
        Tensor<float32> g6 #= Ops.slice<float32>(td, 0, 1L, 3L);
        GradOpsGpuTest.same("slice axis 0", w6, g6);
        Assert.isTrue(Ops.hasGpu(Op.SLICE));
        // concat, each axis
        Tensor<float32> u #= GradOpsGpuTest.fill3(3L, 7L, 5L, 29L);
        Tensor<float32> ud #= GradOpsGpuTest.onDevice(u);
        int32 ax = 0;
        while (ax < 3) {
            Tensor<float32> w7 #= Ops.concat<float32>(t, u, ax);
            Tensor<float32> g7 #= Ops.concat<float32>(td, ud, ax);
            GradOpsGpuTest.same("concat axis " + ax, w7, g7);
            ax = ax + 1;
        }
        Assert.isTrue(Ops.hasGpu(Op.CONCAT));
    }

    /** NCHW 2x3x4x4 of the test sequence. */
    static #Tensor<float32> fill4(int64 n, int64 c, int64 h, int64 w, int64 seed) {
        int64[] sh = [n, c, h, w];
        Tensor<float32> t #= Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < n * c * h * w) {
            t.flatSet(f, (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f);
            f = f + 1;
        }
        return #t;
    }

    @Test
    public void convAndPoolsRunOnTheDevice() {
        Tensor<float32> x #= GradOpsGpuTest.fill4(2L, 3L, 4L, 4L, 31L);
        Tensor<float32> w #= GradOpsGpuTest.fill4(4L, 3L, 3L, 3L, 37L);
        int64[] bs = [4L];
        Tensor<float32> b #= Tensor.full<float32>(bs, 0.25f);
        Tensor<float32> xd #= GradOpsGpuTest.onDevice(x);
        Tensor<float32> wd #= GradOpsGpuTest.onDevice(w);
        Tensor<float32> bd #= GradOpsGpuTest.onDevice(b);
        Tensor<float32> c1 #= Ops.conv2d<float32>(x, w, b, 1, 1);
        Tensor<float32> d1 #= Ops.conv2d<float32>(xd, wd, bd, 1, 1);
        GradOpsGpuTest.sameWithin("conv2d s1 p1", c1, d1, 27.0 * 3.0e-7);
        Tensor<float32> c2 #= Ops.conv2d<float32>(x, w, b, 2, 0);
        Tensor<float32> d2 #= Ops.conv2d<float32>(xd, wd, bd, 2, 0);
        GradOpsGpuTest.sameWithin("conv2d s2 p0", c2, d2, 27.0 * 3.0e-7);
        Assert.isTrue(Ops.hasGpu(Op.CONV2D));
        // max pool with its argmax, 2/2/0 and 3/1/1
        int64[] osh = [2L, 3L, 2L, 2L];
        Tensor<float32> am #= Tensor.zeros<float32>(osh);
        Tensor<float32> amd #= Ops.zerosOn<float32>(osh, xd);
        Tensor<float32> m1 #= Ops.maxPool2d<float32>(x, 2, 2, 0, am);
        Tensor<float32> n1 #= Ops.maxPool2d<float32>(xd, 2, 2, 0, amd);
        GradOpsGpuTest.same("maxPool2d", m1, n1);
        GradOpsGpuTest.same("maxPool2d argmax", am, amd);
        int64[] osh2 = [2L, 3L, 4L, 4L];
        Tensor<float32> am2 #= Tensor.zeros<float32>(osh2);
        Tensor<float32> amd2 #= Ops.zerosOn<float32>(osh2, xd);
        Tensor<float32> m2 #= Ops.maxPool2d<float32>(x, 3, 1, 1, am2);
        Tensor<float32> n2 #= Ops.maxPool2d<float32>(xd, 3, 1, 1, amd2);
        GradOpsGpuTest.same("maxPool2d 3/1/1", m2, n2);
        GradOpsGpuTest.same("maxPool2d 3/1/1 argmax", am2, amd2);
        Assert.isTrue(Ops.hasGpu(Op.MAXPOOL2D));
        Tensor<float32> a1 #= Ops.avgPool2d<float32>(x, 2, 2, 0);
        Tensor<float32> e1 #= Ops.avgPool2d<float32>(xd, 2, 2, 0);
        GradOpsGpuTest.same("avgPool2d", a1, e1);
        Tensor<float32> a2 #= Ops.avgPool2d<float32>(x, 3, 1, 1);
        Tensor<float32> e2 #= Ops.avgPool2d<float32>(xd, 3, 1, 1);
        GradOpsGpuTest.same("avgPool2d 3/1/1", a2, e2);
        Assert.isTrue(Ops.hasGpu(Op.AVGPOOL2D));
        Tensor<float32> p1 #= Ops.adaptiveAvgPool2d<float32>(x, 1, 1);
        Tensor<float32> q1 #= Ops.adaptiveAvgPool2d<float32>(xd, 1, 1);
        GradOpsGpuTest.same("adaptiveAvgPool2d 1x1", p1, q1);
        Tensor<float32> p3 #= Ops.adaptiveAvgPool2d<float32>(x, 3, 3);
        Tensor<float32> q3 #= Ops.adaptiveAvgPool2d<float32>(xd, 3, 3);
        GradOpsGpuTest.same("adaptiveAvgPool2d 3x3", p3, q3);
        Assert.isTrue(Ops.hasGpu(Op.ADAPTAVGPOOL2D));
    }

    @Test
    public void normsRunOnTheDevice() {
        Tensor<float32> x #= GradOpsGpuTest.fill4(2L, 3L, 4L, 4L, 41L);
        Tensor<float32> xd #= GradOpsGpuTest.onDevice(x);
        int64[] cs = [3L];
        Tensor<float32> gamma #= GradOpsGpuTest.fill(3L, 1L, 43L, true);
        Tensor<float32> beta #= GradOpsGpuTest.fill(3L, 1L, 47L, false);
        Tensor<float32> g1 #= Ops.reshape<float32>(gamma, cs);
        Tensor<float32> b1 #= Ops.reshape<float32>(beta, cs);
        Tensor<float32> gd #= GradOpsGpuTest.onDevice(g1);
        Tensor<float32> bd #= GradOpsGpuTest.onDevice(b1);
        // `same` brings its device operand home, so every device result is made before any compare
        Tensor<float32> mean #= Ops.channelMean<float32>(x);
        Tensor<float32> meanD #= Ops.channelMean<float32>(xd);
        Tensor<float32> var #= Ops.channelVar<float32>(x, mean);
        Tensor<float32> varD #= Ops.channelVar<float32>(xd, meanD);
        Tensor<float32> xhat #= Tensor.zerosLike<float32>(x);
        Tensor<float32> invstd #= Tensor.zeros<float32>(cs);
        Tensor<float32> xhatD #= Ops.zerosLike<float32>(xd);
        Tensor<float32> invstdD #= Ops.zerosOn<float32>(cs, xd);
        Tensor<float32> y #= Ops.batchNorm2d<float32>(x, g1, b1, mean, var, 0.00001, xhat, invstd);
        Tensor<float32> yD #= Ops.batchNorm2d<float32>(xd, gd, bd, meanD, varD, 0.00001, xhatD, invstdD);
        GradOpsGpuTest.same("channelMean", mean, meanD);
        GradOpsGpuTest.same("channelVar", var, varD);
        GradOpsGpuTest.same("batchNorm2d", y, yD);
        GradOpsGpuTest.same("batchNorm2d xhat", xhat, xhatD);
        GradOpsGpuTest.same("batchNorm2d invstd", invstd, invstdD);
        Assert.isTrue(Ops.hasGpu(Op.BATCHNORM2D));
        // layerNorm over the last axis of a 6x7
        Tensor<float32> l #= GradOpsGpuTest.fill(6L, 7L, 53L, false);
        Tensor<float32> ld #= GradOpsGpuTest.onDevice(l);
        int64[] ds = [7L];
        Tensor<float32> lg #= Ops.reshape<float32>(GradOpsGpuTest.fill(7L, 1L, 59L, true), ds);
        Tensor<float32> lb #= Ops.reshape<float32>(GradOpsGpuTest.fill(7L, 1L, 61L, false), ds);
        Tensor<float32> lgd #= GradOpsGpuTest.onDevice(lg);
        Tensor<float32> lbd #= GradOpsGpuTest.onDevice(lb);
        int64[] rs = [6L];
        Tensor<float32> lm #= Tensor.zeros<float32>(rs);
        Tensor<float32> li #= Tensor.zeros<float32>(rs);
        Tensor<float32> lmD #= Ops.zerosOn<float32>(rs, ld);
        Tensor<float32> liD #= Ops.zerosOn<float32>(rs, ld);
        Tensor<float32> ly #= Ops.layerNorm<float32>(l, lg, lb, 0.00001, lm, li);
        Tensor<float32> lyD #= Ops.layerNorm<float32>(ld, lgd, lbd, 0.00001, lmD, liD);
        GradOpsGpuTest.same("layerNorm", ly, lyD);
        GradOpsGpuTest.same("layerNorm mean", lm, lmD);
        GradOpsGpuTest.same("layerNorm invstd", li, liD);
        Assert.isTrue(Ops.hasGpu(Op.LAYERNORM));
    }

    @Test
    public void lossesEmbeddingAndDropoutRunOnTheDevice() {
        // embedding: 5x3 table, ids [0 2 4 1 2]
        Tensor<float32> w #= GradOpsGpuTest.fill(5L, 3L, 67L, false);
        int64[] is = [5L];
        Tensor<float32> idx #= Tensor.zeros<float32>(is);
        idx.flatSet(1, 2.0f);
        idx.flatSet(2, 4.0f);
        idx.flatSet(3, 1.0f);
        idx.flatSet(4, 2.0f);
        Tensor<float32> wd #= GradOpsGpuTest.onDevice(w);
        Tensor<float32> idxD #= GradOpsGpuTest.onDevice(idx);
        Tensor<float32> e #= Ops.embedding<float32>(w, idx);
        Tensor<float32> eD #= Ops.embedding<float32>(wd, idxD);
        GradOpsGpuTest.same("embedding", e, eD);
        Assert.isTrue(Ops.hasGpu(Op.EMBEDDING));
        // cross-entropy: 4 rows of 6 classes, targets [1 5 0 3]
        Tensor<float32> logits #= GradOpsGpuTest.fill(4L, 6L, 71L, false);
        int64[] ts = [4L];
        Tensor<float32> tg #= Tensor.zeros<float32>(ts);
        tg.flatSet(0, 1.0f);
        tg.flatSet(1, 5.0f);
        tg.flatSet(3, 3.0f);
        Tensor<float32> logitsD #= GradOpsGpuTest.onDevice(logits);
        Tensor<float32> tgD #= GradOpsGpuTest.onDevice(tg);
        Tensor<float32> probs #= Tensor.zerosLike<float32>(logits);
        Tensor<float32> probsD #= Ops.zerosLike<float32>(logitsD);
        Tensor<float32> ce #= Ops.crossEntropy<float32>(logits, tg, probs);
        Tensor<float32> ceD #= Ops.crossEntropy<float32>(logitsD, tgD, probsD);
        GradOpsGpuTest.same("crossEntropy", ce, ceD);
        GradOpsGpuTest.same("crossEntropy probs", probs, probsD);
        Assert.isTrue(Ops.hasGpu(Op.CROSSENTROPY));
        // mse over 3x7 against 3x7 and against a 21-vector
        Tensor<float32> pr #= GradOpsGpuTest.fill(3L, 7L, 73L, false);
        Tensor<float32> tt #= GradOpsGpuTest.fill(3L, 7L, 79L, false);
        Tensor<float32> prD #= GradOpsGpuTest.onDevice(pr);
        Tensor<float32> ttD #= GradOpsGpuTest.onDevice(tt);
        Tensor<float32> ms #= Ops.mseLoss<float32>(pr, tt);
        Tensor<float32> msD #= Ops.mseLoss<float32>(prD, ttD);
        GradOpsGpuTest.same("mseLoss", ms, msD);
        int64[] flat = [21L];
        Tensor<float32> tf #= Ops.reshape<float32>(tt, flat);
        Tensor<float32> tfD #= GradOpsGpuTest.onDevice(tf);
        Tensor<float32> ms2 #= Ops.mseLoss<float32>(pr, tf);
        Tensor<float32> ms2D #= Ops.mseLoss<float32>(prD, tfD);
        GradOpsGpuTest.same("mseLoss flat target", ms2, ms2D);
        Assert.isTrue(Ops.hasGpu(Op.MSELOSS));
        // cosine over 3x7 rows
        int64[] c3 = [9L];
        Tensor<float32> cache #= Tensor.zeros<float32>(c3);
        Tensor<float32> cacheD #= Ops.zerosOn<float32>(c3, prD);
        Tensor<float32> cs #= Ops.cosineSim<float32>(pr, tt, 0.00000001, cache);
        Tensor<float32> csD #= Ops.cosineSim<float32>(prD, ttD, 0.00000001, cacheD);
        GradOpsGpuTest.same("cosineSim", cs, csD);
        GradOpsGpuTest.same("cosineSim cache", cache, cacheD);
        Assert.isTrue(Ops.hasGpu(Op.COSINESIM));
        // batched matmul (2,3,7)x(2,7,5)
        Tensor<float32> ba #= GradOpsGpuTest.fill3(2L, 3L, 7L, 83L);
        Tensor<float32> bb #= GradOpsGpuTest.fill3(2L, 7L, 5L, 89L);
        GradOpsGpuTest.binary(Op.MATMULB, ba, bb);
        // dropout: eval is identity with a unit mask; training scales survivors by 2 and keeps about half
        Tensor<float32> dx #= GradOpsGpuTest.fill(40L, 50L, 97L, true);
        Tensor<float32> dxD #= GradOpsGpuTest.onDevice(dx);
        Tensor<float32> mk #= Ops.zerosLike<float32>(dxD);
        Tensor<float32> ev #= Ops.dropout<float32>(dxD, 0.5, false, (uint64) 7, mk);
        GradOpsGpuTest.same("dropout eval", dx, ev);
        Tensor<float32> ones #= Tensor.full<float32>(GradOpsGpuTest.shapeOf(dx), 1.0f);
        GradOpsGpuTest.same("dropout eval mask", ones, mk);
        Tensor<float32> mk2 #= Ops.zerosLike<float32>(dxD);
        Tensor<float32> tr #= Ops.dropout<float32>(dxD, 0.5, true, (uint64) 12345, mk2);
        Assert.isTrue(tr.isOnGpu());
        tr.cpu();
        mk2.cpu();
        int64 kept = 0;
        int64 i = 0;
        while (i < 2000L) {
            float32 m = mk2.flatGet(i);
            Assert.isTrue(m == 0.0f || m == 2.0f);
            Assert.isTrue(tr.flatGet(i) == dx.flatGet(i) * m);
            if (m == 2.0f) { kept = kept + 1; }
            i = i + 1;
        }
        Assert.isTrue(kept > 850L && kept < 1150L);
        Tensor<float32> mk3 #= Ops.zerosLike<float32>(dxD);
        Tensor<float32> tr2 #= Ops.dropout<float32>(dxD, 0.5, true, (uint64) 12345, mk3);
        tr2.cpu();
        i = 0;
        while (i < 2000L) { Assert.isTrue(tr2.flatGet(i) == tr.flatGet(i)); i = i + 1; }
        Assert.isTrue(Ops.hasGpu(Op.DROPOUT));
    }

    static #int64[] shapeOf(Tensor<float32> t) {
        int64[] sh = heap int64[t.ndim()];
        int32 d = 0;
        while (d < t.ndim()) { sh[d] = t.shapeAt(d); d = d + 1; }
        return #sh;
    }

    static void binary(int32 op, Tensor<float32> a, Tensor<float32> b) {
        Tensor<float32> want #= Ops.run2<float32>(op, a, b);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        Tensor<float32> bd #= GradOpsGpuTest.onDevice(b);
        Tensor<float32> got #= Ops.run2<float32>(op, ad, bd);
        GradOpsGpuTest.same(Ops.name(op), want, got);
        Assert.isTrue(Ops.hasGpu(op));
    }

    @Test
    public void binaryOpsRunOnTheDevice() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 1L, false);
        Tensor<float32> b #= GradOpsGpuTest.fill(3L, 7L, 2L, true);
        GradOpsGpuTest.binary(Op.ADD, a, b);
        GradOpsGpuTest.binary(Op.SUB, a, b);
        GradOpsGpuTest.binary(Op.MUL, a, b);
        GradOpsGpuTest.binary(Op.DIV, a, b);
        Tensor<float32> w #= GradOpsGpuTest.fill(7L, 5L, 3L, false);
        GradOpsGpuTest.binary(Op.MATMUL, a, w);
    }

    @Test
    public void mixedResidencyFailsByName() {
        Tensor<float32> a #= GradOpsGpuTest.fill(3L, 7L, 1L, false);
        Tensor<float32> b #= GradOpsGpuTest.fill(3L, 7L, 2L, true);
        Tensor<float32> ad #= GradOpsGpuTest.onDevice(a);
        boolean threw = false;
        try {
            Tensor<float32> r #= Ops.run2<float32>(Op.ADD, ad, b);
        } catch (MlException e) {
            threw = true;
            Assert.isTrue(e.getMessage().contains("add"));
            Assert.isTrue(e.getMessage().contains("different devices"));
        }
        Assert.isTrue(threw);
    }
}
