package dev.cajeta.ml.selftest;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.data.Batches;
import dev.cajeta.ml.data.Digits;
import dev.cajeta.ml.io.Checkpoints;
import dev.cajeta.ml.io.PtReader;
import dev.cajeta.ml.io.Safetensors;
import dev.cajeta.ml.io.StateDict;
import dev.cajeta.ml.nn.Linear;
import dev.cajeta.ml.nn.Module;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.nn.ReLU;
import dev.cajeta.ml.nn.Sequential;
import dev.cajeta.ml.optim.Optimizer;
import dev.cajeta.ml.optim.SGD;
import dev.cajeta.ml.train.BackpropTrainer;
import dev.cajeta.ml.train.Loss;

/**
 * cajeta-ml-v3 plan 9.1.1–9.3.1 — checkpoints. Fixtures are written by
 * PINNED torch 2.13.0+cpu (`tools/fixtures/gen_checkpoints.py`) into
 * `src/test/resources/checkpoints/`.
 *
 * The values are the same integer formulas the rest of the suite uses, so
 * a reader is checked against RECONSTRUCTED expectations rather than
 * numbers copied out of the file it is supposed to be reading.
 */
public class CheckpointTest {

    public CheckpointTest() { return; }

    static #String fixture(String name) {
        return "src/test/resources/checkpoints/" + name;
    }

    /** The generator's `w_`: `(f % 5) * 0.5 - 1.0`. */
    static float32 wAt(int64 f) {
        return (float32) (f % 5) * 0.5f - 1.0f;
    }

    /** The generator's `b_`: `f * 0.25 - 0.25`. */
    static float32 bAt(int64 f) {
        return (float32) f * 0.25f - 0.25f;
    }

    static boolean near(float32 a, float32 b, float32 tol) {
        float32 d = a - b;
        if (d < 0.0f) { d = 0.0f - d; }
        return d < tol;
    }

    // ── 9.1.1 safetensors ───────────────────────────────────────────────

    @Test
    public void readsTorchWrittenF32() {
        StateDict sd = Safetensors.read(CheckpointTest.fixture("mlp_f32.safetensors"));
        Assert.equals(4, (int64) sd.count());
        Assert.isTrue(sd.has("layers.0.weight"));
        Assert.isTrue(sd.has("layers.2.bias"));

        Tensor<float32> w = sd.get("layers.0.weight");
        Assert.isTrue(w.ndim() == 2);
        Assert.isTrue(w.shapeAt(0) == 3);
        Assert.isTrue(w.shapeAt(1) == 4);
        int64 f = 0;
        while (f < 12) {
            Assert.isTrue(w.flatGet(f) == CheckpointTest.wAt(f));
            f = f + 1;
        }
        Tensor<float32> b = sd.get("layers.0.bias");
        Assert.isTrue(b.shapeAt(0) == 4);
        f = 0;
        while (f < 4) {
            Assert.isTrue(b.flatGet(f) == CheckpointTest.bAt(f));
            f = f + 1;
        }
    }

    /** F16 widens to f32 — and must reproduce the ROUNDED values torch
     *  stored, not the originals they were rounded from. */
    @Test
    public void readsF16AndWidens() {
        StateDict sd = Safetensors.read(CheckpointTest.fixture("mlp_f16.safetensors"));
        Tensor<float32> b = sd.get("layers.0.bias");
        // f16 represents these exactly: -0.25, 0, 0.25, 0.5
        float32[] want = [-0.25f, 0.0f, 0.25f, 0.5f];
        int64 f = 0;
        while (f < 4) {
            Assert.isTrue(b.flatGet(f) == want[f]);
            f = f + 1;
        }
        // the weight grid is halves — also exact in f16
        Tensor<float32> w = sd.get("layers.0.weight");
        f = 0;
        while (f < 12) {
            Assert.isTrue(w.flatGet(f) == CheckpointTest.wAt(f));
            f = f + 1;
        }
    }

    @Test
    public void readsBf16AndWidens() {
        StateDict sd = Safetensors.read(CheckpointTest.fixture("mlp_bf16.safetensors"));
        Tensor<float32> w = sd.get("layers.0.weight");
        // torch's bf16 rounding of the grid, from the generator
        float32[] want = [-1.0f, -0.5f, 0.0f, 0.5f, 1.0f, -1.0f,
                          -0.5f, 0.0f, 0.5f, 1.0f, -1.0f, -0.5f];
        int64 f = 0;
        while (f < 12) {
            Assert.isTrue(w.flatGet(f) == want[f]);
            f = f + 1;
        }
    }

    /** Write → read is bit-stable for f32, and the bytes we emit match
     *  the ones torch emitted for the same content. */
    @Test
    public void f32RoundTripIsBitStable() {
        StateDict sd = Safetensors.read(CheckpointTest.fixture("mlp_f32.safetensors"));
        int8[] mine = Safetensors.encode(sd);
        StateDict again = Safetensors.decode(mine, (int64) mine.count());
        Assert.equals((int64) sd.count(), (int64) again.count());
        int32 i = 0;
        while (i < sd.count()) {
            Tensor<float32> a = sd.valueAt(i);
            Tensor<float32> b = again.get(sd.nameAt(i));
            int64 n = a.shapeAt(0);
            if (a.ndim() == 2) { n = n * a.shapeAt(1); }
            int64 e = 0;
            while (e < n) {
                Assert.isTrue(a.flatGet(e) == b.flatGet(e));
                e = e + 1;
            }
            i = i + 1;
        }
    }

    @Test
    public void truncatedFileIsRejected() {
        StateDict sd = Safetensors.read(CheckpointTest.fixture("mlp_f32.safetensors"));
        int8[] full = Safetensors.encode(sd);
        int8[] cut = heap int8[20];
        int64 i = 0;
        while (i < 20) {
            cut[i] = full[i];
            i = i + 1;
        }
        boolean threw = false;
        try {
            StateDict bad = Safetensors.decode(cut, 20);
        } catch (Exception e) {
            threw = true;
        }
        Assert.isTrue(threw);
    }

    // ── 9.1.2 the .pt reader ────────────────────────────────────────────

    @Test
    public void readsTorchSavedStateDict() {
        StateDict sd = PtReader.read(CheckpointTest.fixture("mlp_state.pt"));
        Assert.equals(4, (int64) sd.count());
        Tensor<float32> w = sd.get("layers.0.weight");
        Assert.isTrue(w.ndim() == 2);
        Assert.isTrue(w.shapeAt(0) == 3);
        Assert.isTrue(w.shapeAt(1) == 4);
        int64 f = 0;
        while (f < 12) {
            Assert.isTrue(w.flatGet(f) == CheckpointTest.wAt(f));
            f = f + 1;
        }
        Tensor<float32> b2 = sd.get("layers.2.bias");
        Assert.isTrue(b2.shapeAt(0) == 2);
        Assert.isTrue(b2.flatGet(0) == CheckpointTest.bAt(0));
        Assert.isTrue(b2.flatGet(1) == CheckpointTest.bAt(1));
    }

    /** The two formats must agree tensor for tensor — the same weights
     *  written two ways. */
    @Test
    public void ptAndSafetensorsAgree() {
        StateDict a = PtReader.read(CheckpointTest.fixture("mlp_state.pt"));
        StateDict b = Safetensors.read(CheckpointTest.fixture("mlp_f32.safetensors"));
        Assert.equals((int64) a.count(), (int64) b.count());
        int32 i = 0;
        while (i < a.count()) {
            String name = a.nameAt(i);
            Assert.isTrue(b.has(name));
            Tensor<float32> ta = a.valueAt(i);
            Tensor<float32> tb = b.get(name);
            int64 n = ta.shapeAt(0);
            if (ta.ndim() == 2) { n = n * ta.shapeAt(1); }
            int64 e = 0;
            while (e < n) {
                Assert.isTrue(ta.flatGet(e) == tb.flatGet(e));
                e = e + 1;
            }
            i = i + 1;
        }
    }

    /**
     * THE security requirement: a pickle whose payload would execute on
     * load must be REFUSED. `evil.pt` reduces to `os.system('echo pwned')`
     * under a real unpickler; this reader must never resolve that global.
     */
    @Test
    public void maliciousPickleIsRefused() {
        boolean threw = false;
        try {
            StateDict bad = PtReader.read(CheckpointTest.fixture("evil.pt"));
        } catch (Exception e) {
            threw = true;
        }
        Assert.isTrue(threw);
    }

    // ── 9.1.3 loadStateDict, strict and not ─────────────────────────────

    static #Sequential mlp() {
        Sequential net = heap Sequential();
        net.add(heap Linear(3, 4, 1L));
        net.add(heap ReLU());
        net.add(heap Linear(4, 2, 2L));
        return net;
    }

    @Test
    public void loadStateDictAppliesByName() {
        Sequential net = CheckpointTest.mlp();
        // A bare Sequential IS the root, so its children are named by
        // index with no field prefix — the fixture's `layers.` level comes
        // from the torch model having held it in a `layers` attribute.
        ArrayList<String> names = net.parameterNames();
        Assert.equals("0.weight", names.get(0));
        Assert.equals("2.bias", names.get(3));

        StateDict sd = Safetensors.read(CheckpointTest.fixture("mlp_f32.safetensors"));
        // the module tree is the Sequential itself, so its own names have
        // no `layers.` prefix — remap by building the dict from the tree
        StateDict remapped = heap StateDict();
        int32 i = 0;
        while (i < sd.count()) {
            String n = sd.nameAt(i);
            // strip the leading "layers." the fixture carries
            String stripped = CheckpointTest.afterPrefix(n, "layers.");
            Tensor<float32> copy = sd.valueAt(i).copy();
            remapped.put(stripped, #copy);
            i = i + 1;
        }
        ArrayList<String> missing = Checkpoints.loadStateDict(net, remapped, true);
        Assert.equals(0, (int64) missing.count());

        Parameter[] ps = net.parameters();
        int64 f = 0;
        while (f < 12) {
            Assert.isTrue(ps[0].get().flatGet(f) == CheckpointTest.wAt(f));
            f = f + 1;
        }
    }

    static #String afterPrefix(String s, String prefix) {
        int32 n = s.byteLength();
        int32 m = prefix.byteLength();
        boolean match = m <= n;
        int32 i = 0;
        while (match && i < m) {
            if (s.byteAt(i) != prefix.byteAt(i)) { match = false; }
            i = i + 1;
        }
        if (!match) { return "" + s; }
        int8[] buf = heap int8[n - m];
        int32 k = 0;
        while (k < n - m) {
            buf[k] = s.byteAt(m + k);
            k = k + 1;
        }
        return heap String(#buf, n - m);
    }

    @Test
    public void strictLoadRejectsAMissingEntry() {
        Sequential net = CheckpointTest.mlp();
        StateDict partial = heap StateDict();
        Parameter[] ps = net.parameters();
        Tensor<float32> only = ps[0].get().copy();
        partial.put("0.weight", #only);
        boolean threw = false;
        try {
            ArrayList<String> m = Checkpoints.loadStateDict(net, partial, true);
        } catch (Exception e) {
            threw = true;
        }
        Assert.isTrue(threw);
        // non-strict loads what it can and REPORTS the rest
        ArrayList<String> missing = Checkpoints.loadStateDict(net, partial, false);
        Assert.equals(3, (int64) missing.count());
        Assert.equals("0.bias", missing.get(0));
    }

    /** A shape mismatch is an error even non-strict: skipping a
     *  parameter is permitted, reinterpreting one is not. */
    @Test
    public void shapeMismatchIsAlwaysAnError() {
        Sequential net = CheckpointTest.mlp();
        StateDict bad = heap StateDict();
        int64[] wrong = heap int64[2];
        wrong[0] = 9;
        wrong[1] = 9;
        Tensor<float32> t = Tensor.zeros<float32>(wrong);
        bad.put("0.weight", #t);
        boolean threw = false;
        try {
            ArrayList<String> m = Checkpoints.loadStateDict(net, bad, false);
        } catch (Exception e) {
            threw = true;
        }
        Assert.isTrue(threw);
    }

    @Test
    public void saveThenLoadRestoresTheModel() {
        Sequential net = CheckpointTest.mlp();
        Parameter[] ps = net.parameters();
        StateDict saved = Checkpoints.saveStateDict(net);

        // move the weights, then restore
        Tensor<float32> w = ps[0].get();
        float32 original = w.flatGet(0);
        w.flatSet(0, 12.5f);
        Assert.isTrue(ps[0].get().flatGet(0) == 12.5f);
        ArrayList<String> missing = Checkpoints.loadStateDict(net, saved, true);
        Assert.equals(0, (int64) missing.count());
        Assert.isTrue(ps[0].get().flatGet(0) == original);
    }

    // ── 9.3.1 a torch checkpoint loads and fine-tunes ───────────────────

    /**
     * The acceptance: weights that came out of torch load into a live
     * module and TRAIN — the checkpoint is not just readable, it is
     * usable as a starting point.
     */
    @Test
    public void torchCheckpointLoadsAndFineTunes() {
        Sequential net = heap Sequential();
        net.add(heap Linear(3, 4, 1L));
        net.add(heap ReLU());
        net.add(heap Linear(4, 2, 2L));

        StateDict sd = PtReader.read(CheckpointTest.fixture("mlp_state.pt"));
        StateDict remapped = heap StateDict();
        int32 i = 0;
        while (i < sd.count()) {
            String stripped = CheckpointTest.afterPrefix(sd.nameAt(i), "layers.");
            Tensor<float32> copy = sd.valueAt(i).copy();
            remapped.put(stripped, #copy);
            i = i + 1;
        }
        Checkpoints.loadStateDict(net, remapped, true);

        Parameter[] ps = net.parameters();
        Assert.isTrue(ps[0].get().flatGet(0) == CheckpointTest.wAt(0));
        Tensor<float32> before = ps[0].get().copy();

        // fine-tune from the loaded weights
        Optimizer opt = heap SGD(net.parameters(), 0.05f, 0.0f);
        BackpropTrainer tr = heap BackpropTrainer(net, #opt, Loss.MSE, 0.0f);
        int64[] xs = heap int64[2];
        xs[0] = 4;
        xs[1] = 3;
        Tensor<float32> x = Tensor.zeros<float32>(xs);
        int64 f = 0;
        while (f < 12) {
            x.flatSet(f, (float32) (f % 7) * 0.25f - 0.75f);
            f = f + 1;
        }
        int64[] ys = heap int64[2];
        ys[0] = 4;
        ys[1] = 2;
        Tensor<float32> y = Tensor.zeros<float32>(ys);
        f = 0;
        while (f < 8) {
            y.flatSet(f, (float32) (f % 3) * 0.5f - 0.5f);
            f = f + 1;
        }
        float64 first = tr.stepOn(x, y, ps);
        int32 s = 0;
        float64 last = first;
        while (s < 20) {
            last = tr.stepOn(x, y, ps);
            s = s + 1;
        }
        // it trained: the loss fell and the weights moved off the
        // checkpoint's values
        Assert.isTrue(last < first);
        Assert.isTrue(ps[0].get().flatGet(0) != before.flatGet(0));

        // and the result round-trips back out through safetensors
        StateDict after = Checkpoints.saveStateDict(net);
        int8[] image = Safetensors.encode(after);
        StateDict reread = Safetensors.decode(image, (int64) image.count());
        Assert.isTrue(reread.get("0.weight").flatGet(0)
                      == ps[0].get().flatGet(0));
    }
}
