package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.Metrics;

/**
 * ml-unsupervised plan 7.1 — cluster evaluation (spec §8). Internal
 * metrics (silhouette + per-sample, Davies-Bouldin, Calinski-Harabasz)
 * and external metrics (adjusted Rand, NMI) pinned against sklearn 1.9.0
 * (oracle recorded 2026-08-05); degenerate silhouette THROWS; the three
 * internal metrics demonstrably disagree on one fixture — the reason to
 * offer three.
 */
public class MetricsUnsupervisedTest {

    public MetricsUnsupervisedTest() { return; }

    /** The 12-point 3-cluster fixture (shared with U3/U5 parity). */
    static #Tensor<float64> fixtureB() {
        float64[] d = heap float64[24];
        d[0] = 0.0;  d[1] = 0.0;
        d[2] = 0.3;  d[3] = 0.1;
        d[4] = 0.1;  d[5] = 0.4;
        d[6] = 0.2;  d[7] = 0.2;
        d[8] = 5.0;  d[9] = 5.0;
        d[10] = 5.2; d[11] = 5.1;
        d[12] = 4.9; d[13] = 5.3;
        d[14] = 5.1; d[15] = 4.8;
        d[16] = 10.0; d[17] = 0.0;
        d[18] = 10.2; d[19] = 0.2;
        d[20] = 9.8;  d[21] = 0.1;
        d[22] = 10.1; d[23] = 0.3;
        int64[] sh = heap int64[2];
        sh[0] = 12;
        sh[1] = 2;
        return Tensor.of<float64>(d, sh);
    }

    static #Tensor<float64> labelTensor(int64[] v) {
        int64 n = (int64) v.count();
        float64[] d = heap float64[n];
        int64 i = 0;
        while (i < n) {
            d[i] = (float64) v[i];
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = n;
        return Tensor.of<float64>(d, sh);
    }

    /** 4+4+4 block labels. */
    static #Tensor<float64> truthB() {
        int64[] v = heap int64[12];
        int64 i = 0;
        while (i < 12) {
            v[i] = i / (int64) 4;
            i = i + 1;
        }
        return MetricsUnsupervisedTest.labelTensor(v);
    }

    /** Three tight 4-point squares with the first two centres 0.9 apart
     *  and the third far — the internal-metric disagreement fixture. */
    static #Tensor<float64> gapFixture() {
        float64[] d = heap float64[24];
        int64 c = 0;
        while (c < 3) {
            float64 cx = 0.0;
            if (c == (int64) 1) {
                cx = 0.9;
            }
            if (c == (int64) 2) {
                cx = 10.0;
            }
            d[c * 8] = cx;           d[c * 8 + 1] = 0.0;
            d[c * 8 + 2] = cx + 0.3; d[c * 8 + 3] = 0.0;
            d[c * 8 + 4] = cx;       d[c * 8 + 5] = 0.3;
            d[c * 8 + 6] = cx + 0.3; d[c * 8 + 7] = 0.3;
            c = c + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = 12;
        sh[1] = 2;
        return Tensor.of<float64>(d, sh);
    }

    // 7.1.1 / §8.1 — silhouette matches sklearn, aggregate AND per-sample.
    @Test
    public void silhouetteMatchesSklearnWithSamples() {
        Tensor<float64> x = MetricsUnsupervisedTest.fixtureB();
        Tensor<float64> y = MetricsUnsupervisedTest.truthB();
        Assert.isTrue(Fixtures.close(Metrics.silhouetteScore(x, y),
            0.9562630610952242, 0.000000001));
        Tensor<float64> s = Metrics.silhouetteSamples(x, y);
        Assert.equals((int64) 12, s.shapeAt(0));
        Assert.isTrue(Fixtures.close(s.get1(0),
            0.9528101225719978, 0.000000001));
        Assert.isTrue(Fixtures.close(s.get1(4),
            0.9628086501941848, 0.000000001));
        Assert.isTrue(Fixtures.close(s.get1(11),
            0.9606661942346629, 0.000000001));
    }

    // 7.1.2 / §8.2 / 7.3.1 — one cluster, or as many clusters as points:
    // UNDEFINED, and the library says so instead of returning a number.
    @Test
    public void degenerateSilhouetteThrows() {
        Assert.assertThrows(() -> {
            Tensor<float64> x = MetricsUnsupervisedTest.fixtureB();
            int64[] one = heap int64[12];
            Metrics.silhouetteScore(x,
                MetricsUnsupervisedTest.labelTensor(one));
        });
        Assert.assertThrows(() -> {
            Tensor<float64> x = MetricsUnsupervisedTest.fixtureB();
            int64[] all = heap int64[12];
            int64 i = 0;
            while (i < 12) {
                all[i] = i;
                i = i + 1;
            }
            Metrics.silhouetteScore(x,
                MetricsUnsupervisedTest.labelTensor(all));
        });
    }

    // 7.1.3 / §8.3 — Davies-Bouldin and Calinski-Harabasz match sklearn.
    @Test
    public void daviesBouldinAndCalinskiHarabaszMatchSklearn() {
        Tensor<float64> x = MetricsUnsupervisedTest.fixtureB();
        Tensor<float64> y = MetricsUnsupervisedTest.truthB();
        Assert.isTrue(Fixtures.close(Metrics.daviesBouldin(x, y),
            0.0535841077462453, 0.000000001));
        Assert.isTrue(Fixtures.close(Metrics.calinskiHarabasz(x, y),
            2558.93406593407, 0.0001));
    }

    // 7.1.4 / §8.4 — ARI and NMI against ground truth match sklearn;
    // perfect and permuted labelings behave.
    @Test
    public void adjustedRandAndNmiMatchSklearn() {
        Tensor<float64> yt = MetricsUnsupervisedTest.truthB();
        int64[] pv = heap int64[12];
        pv[0] = 0; pv[1] = 0; pv[2] = 0; pv[3] = 1;
        pv[4] = 1; pv[5] = 1; pv[6] = 1; pv[7] = 1;
        pv[8] = 2; pv[9] = 2; pv[10] = 0; pv[11] = 2;
        Tensor<float64> yp = MetricsUnsupervisedTest.labelTensor(pv);
        Assert.isTrue(Fixtures.close(Metrics.adjustedRand(yt, yp),
            0.5119453924914675, 0.000000001));
        Assert.isTrue(Fixtures.close(Metrics.nmi(yt, yp),
            0.6457828916138152, 0.000000001));
        // Perfect agreement = 1 for both, and label-permutation invariant.
        int64[] perm = heap int64[12];
        int64 i = 0;
        while (i < 12) {
            perm[i] = (int64) 2 - i / (int64) 4;
            i = i + 1;
        }
        Tensor<float64> ypm = MetricsUnsupervisedTest.labelTensor(perm);
        Assert.isTrue(Fixtures.close(Metrics.adjustedRand(yt, ypm),
            1.0, 0.000000000001));
        Assert.isTrue(Fixtures.close(Metrics.nmi(yt, ypm),
            1.0, 0.000000000001));
    }

    // 7.1.5 / §8.5 — inertia across a k sweep: the elbow curve is
    // constructible, monotone, and bends at the true k.
    @Test
    public void elbowCurveIsConstructible() {
        Tensor<float64> x = Shapes.blobs((uint64) 7);
        float64[] e = Metrics.kmeansElbow(x, (int64) 5, (uint64) 1);
        Assert.equals((int64) 5, (int64) e.count());
        int64 i = 1;
        while (i < 5) {
            Assert.isTrue(e[i] <= e[i - 1]);
            i = i + 1;
        }
        // The bend: huge drop into k=3 (the true count), flat after.
        Assert.isTrue(e[2] < 0.1 * e[1]);
        Assert.isTrue(e[3] > 0.5 * e[2]);
    }

    // 7.1.6 — the three internal metrics DISAGREE on the gap fixture:
    // silhouette and Davies-Bouldin prefer merging the two close squares,
    // Calinski-Harabasz prefers the true 3-way split. Offering three is
    // the point; this is the documented example.
    @Test
    public void internalMetricsDisagreeOnTheGapFixture() {
        Tensor<float64> x = MetricsUnsupervisedTest.gapFixture();
        int64[] v3 = heap int64[12];
        int64 i = 0;
        while (i < 12) {
            v3[i] = i / (int64) 4;
            i = i + 1;
        }
        Tensor<float64> l3 = MetricsUnsupervisedTest.labelTensor(v3);
        int64[] v2 = heap int64[12];
        i = 8;
        while (i < 12) {
            v2[i] = 1;
            i = i + 1;
        }
        Tensor<float64> l2 = MetricsUnsupervisedTest.labelTensor(v2);
        // silhouette: higher is better — prefers the MERGE.
        Assert.isTrue(Metrics.silhouetteScore(x, l2)
            > Metrics.silhouetteScore(x, l3));
        // Davies-Bouldin: lower is better — also prefers the MERGE.
        Assert.isTrue(Metrics.daviesBouldin(x, l2)
            < Metrics.daviesBouldin(x, l3));
        // Calinski-Harabasz: higher is better — prefers the TRUE SPLIT.
        Assert.isTrue(Metrics.calinskiHarabasz(x, l3)
            > Metrics.calinskiHarabasz(x, l2));
    }
}
