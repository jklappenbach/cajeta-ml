package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.io.Checkpoints;
import dev.cajeta.ml.io.ImportReport;
import dev.cajeta.ml.io.PtReader;
import dev.cajeta.ml.io.StateDict;
import dev.cajeta.ml.nn.Linear;
import dev.cajeta.ml.nn.Masks;
import dev.cajeta.ml.nn.Module;
import dev.cajeta.ml.nn.ReLU;
import dev.cajeta.ml.nn.Sequential;
import dev.cajeta.ml.nn.TransformerDecoderLayer;

/**
 * cajeta-ml-v3 §13 plan 5.1 — pretrained-weight import (spec §13.6). A
 * RAW-TORCH-LAYOUT `state_dict` (fused `in_proj`, `[out, in]` Linear
 * weights) maps through `Checkpoints.torchToCajeta` onto the module
 * tree, and the imported decoder's forward REPRODUCES U2's torch pins —
 * the only test that proves import correctness rather than
 * completeness. Reconciliation reports BOTH directions; strict is the
 * default; shape mismatches always throw; the `.pt` path rides the
 * constrained unpickler.
 */
public class WeightImportTest {

    public WeightImportTest() { return; }

    /** Torch-layout grid tensor: value (((f+off)%5)·0.5−1)·0.2. */
    static #Tensor<float32> torchGrid(int64 r, int64 c, int64 off) {
        int64[] sh = heap int64[2];
        sh[0] = r;
        sh[1] = c;
        Tensor<float32> t = Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < r * c) {
            t.flatSet(i, DecoderTest.gv(i, off));
            i = i + 1;
        }
        return #t;
    }

    static #Tensor<float32> torchVec(int64 n, int64 off) {
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<float32> t = Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < n) {
            t.flatSet(i, DecoderTest.gv(i, off));
            i = i + 1;
        }
        return #t;
    }

    /** The gen_decoder.py fixture as a RAW torch-layout state_dict. */
    static #StateDict torchDecoderSd() {
        StateDict sd = heap StateDict();
        Tensor<float32> a = WeightImportTest.torchGrid((int64) 12,
            (int64) 4, (int64) 1);
        sd.put("self_attn.in_proj_weight", #a);
        Tensor<float32> b = WeightImportTest.torchVec((int64) 12,
            (int64) 4);
        sd.put("self_attn.in_proj_bias", #b);
        Tensor<float32> c = WeightImportTest.torchGrid((int64) 4,
            (int64) 4, (int64) 7);
        sd.put("self_attn.out_proj.weight", #c);
        Tensor<float32> d = WeightImportTest.torchVec((int64) 4,
            (int64) 10);
        sd.put("self_attn.out_proj.bias", #d);
        Tensor<float32> e = WeightImportTest.torchGrid((int64) 12,
            (int64) 4, (int64) 13);
        sd.put("multihead_attn.in_proj_weight", #e);
        Tensor<float32> f = WeightImportTest.torchVec((int64) 12,
            (int64) 16);
        sd.put("multihead_attn.in_proj_bias", #f);
        Tensor<float32> g = WeightImportTest.torchGrid((int64) 4,
            (int64) 4, (int64) 19);
        sd.put("multihead_attn.out_proj.weight", #g);
        Tensor<float32> h = WeightImportTest.torchVec((int64) 4,
            (int64) 22);
        sd.put("multihead_attn.out_proj.bias", #h);
        Tensor<float32> l1w = WeightImportTest.torchGrid((int64) 8,
            (int64) 4, (int64) 25);
        sd.put("linear1.weight", #l1w);
        Tensor<float32> l1b = WeightImportTest.torchVec((int64) 8,
            (int64) 28);
        sd.put("linear1.bias", #l1b);
        Tensor<float32> l2w = WeightImportTest.torchGrid((int64) 4,
            (int64) 8, (int64) 31);
        sd.put("linear2.weight", #l2w);
        Tensor<float32> l2b = WeightImportTest.torchVec((int64) 4,
            (int64) 34);
        sd.put("linear2.bias", #l2b);
        Tensor<float32> n1w = WeightImportTest.torchVec((int64) 4,
            (int64) 37);
        sd.put("norm1.weight", #n1w);
        Tensor<float32> n1b = WeightImportTest.torchVec((int64) 4,
            (int64) 40);
        sd.put("norm1.bias", #n1b);
        Tensor<float32> n2w = WeightImportTest.torchVec((int64) 4,
            (int64) 43);
        sd.put("norm2.weight", #n2w);
        Tensor<float32> n2b = WeightImportTest.torchVec((int64) 4,
            (int64) 46);
        sd.put("norm2.bias", #n2b);
        Tensor<float32> n3w = WeightImportTest.torchVec((int64) 4,
            (int64) 49);
        sd.put("norm3.weight", #n3w);
        Tensor<float32> n3b = WeightImportTest.torchVec((int64) 4,
            (int64) 52);
        sd.put("norm3.bias", #n3b);
        return #sd;
    }

    // 5.1.1 / 5.3.1 — a raw torch state_dict imports (fused in_proj
    // split + transposed) and the imported decoder REPRODUCES the torch
    // forward pins from U2 — import correctness, not mere completeness.
    @Test
    public void importedDecoderMatchesTorchForward() {
        StateDict raw = WeightImportTest.torchDecoderSd();
        StateDict mapped = Checkpoints.torchToCajeta(raw);
        TransformerDecoderLayer layer = heap TransformerDecoderLayer(
            (int64) 4, (int32) 2, (int64) 8, (uint64) 77);
        ImportReport rep = Checkpoints.importTorch(layer, mapped);
        Assert.isTrue(rep.clean());
        Assert.equals((int64) 26, (int64) rep.applied());

        GradTape<float32> tape = heap GradTape<float32>();
        layer.bindParameters(tape);
        int64[] ts = heap int64[3];
        ts[0] = 2;
        ts[1] = 3;
        ts[2] = 4;
        Tensor<float32> tgt = Tensor.zeros<float32>(ts);
        DecoderTest.fill(tgt, (int64) 0);
        int64[] ms = heap int64[3];
        ms[0] = 2;
        ms[1] = 4;
        ms[2] = 4;
        Tensor<float32> mem = Tensor.zeros<float32>(ms);
        DecoderTest.fill(mem, (int64) 2);
        int64[] lens = heap int64[2];
        lens[0] = 4;
        lens[1] = 3;
        GradTensor y = layer.decode(tape, tape.leaf(tgt, false),
            tape.leaf(mem, false), true,
            Masks.causal((int64) 2, (int64) 3), true,
            Masks.keyPadding(lens, (int64) 3, (int64) 4));
        Tensor<float32> yv = tape.valueOf(y);
        // Spot-check against the recorded torch pins (full set in U2).
        Assert.isTrue(DecoderTest.near(yv.flatGet(0),
            0.08016250282526016, 0.00002));
        Assert.isTrue(DecoderTest.near(yv.flatGet(8),
            0.0 - 0.3138783276081085, 0.00002));
        Assert.isTrue(DecoderTest.near(yv.flatGet(23),
            0.0 - 0.20000000298023224, 0.00002));
        layer.unbindParameters();
    }

    // 5.1.2 / 5.3.2 — reconciliation reports BOTH directions; nothing is
    // silently dropped.
    @Test
    public void reconciliationReportsBothDirections() {
        Sequential net = heap Sequential();
        Module l1 = heap Linear((int64) 3, (int64) 4, (uint64) 1);
        net.add(#l1);
        Module r = heap ReLU();
        net.add(#r);
        Module l2 = heap Linear((int64) 4, (int64) 2, (uint64) 2);
        net.add(#l2);
        // Provide 0.weight/0.bias only, plus a bogus key.
        StateDict sd = heap StateDict();
        Tensor<float32> w = WeightImportTest.torchGrid((int64) 3,
            (int64) 4, (int64) 1);
        sd.put("0.weight", #w);
        Tensor<float32> b = WeightImportTest.torchVec((int64) 4,
            (int64) 4);
        sd.put("0.bias", #b);
        Tensor<float32> bogus = WeightImportTest.torchVec((int64) 7,
            (int64) 9);
        sd.put("no.such.param", #bogus);
        ImportReport rep = Checkpoints.importStateDict(net, sd, false);
        Assert.equals((int64) 2, (int64) rep.applied());
        Assert.equals((int64) 2, (int64) rep.missing().count());
        Assert.equals((int64) 1, (int64) rep.unexpected().count());
        Assert.isTrue(rep.unexpected().get(0).equals("no.such.param"));
        Assert.isFalse(rep.clean());
    }

    // 5.1.3 / 5.1.4 — strict is the DEFAULT and throws on unexpected
    // keys; a shape disagreement throws in EVERY mode.
    @Test
    public void strictDefaultAndShapeMismatchesThrow() {
        Assert.assertThrows(() -> {
            Sequential net = heap Sequential();
            Module l1 = heap Linear((int64) 3, (int64) 4, (uint64) 1);
            net.add(#l1);
            StateDict sd = heap StateDict();
            Tensor<float32> w = WeightImportTest.torchGrid((int64) 3,
                (int64) 4, (int64) 1);
            sd.put("0.weight", #w);
            Tensor<float32> b = WeightImportTest.torchVec((int64) 4,
                (int64) 4);
            sd.put("0.bias", #b);
            Tensor<float32> extra = WeightImportTest.torchVec((int64) 3,
                (int64) 5);
            sd.put("ghost.bias", #extra);
            Checkpoints.importTorch(net, sd);      // strict: ghost key
        });
        Assert.assertThrows(() -> {
            Sequential net = heap Sequential();
            Module l1 = heap Linear((int64) 3, (int64) 4, (uint64) 1);
            net.add(#l1);
            StateDict sd = heap StateDict();
            Tensor<float32> w = WeightImportTest.torchGrid((int64) 5,
                (int64) 5, (int64) 1);          // wrong shape
            sd.put("0.weight", #w);
            Tensor<float32> b = WeightImportTest.torchVec((int64) 4,
                (int64) 4);
            sd.put("0.bias", #b);
            Checkpoints.importStateDict(net, sd, false);   // permissive
        });
    }

    // 5.1.5 — import composes with U4: import a torch-layout backbone,
    // replace the head, fine-tune — the loss moves and the run is sane.
    @Test
    public void importComposesWithFineTune() {
        Sequential net = heap Sequential();
        Module l1 = heap Linear((int64) 3, (int64) 4, (uint64) 30);
        net.add(#l1);
        Module r = heap ReLU();
        net.add(#r);
        Module l2 = heap Linear((int64) 4, (int64) 2, (uint64) 31);
        net.add(#l2);
        // Torch-layout weights for the whole net; import them.
        StateDict sd = heap StateDict();
        Tensor<float32> w0 = WeightImportTest.torchGrid((int64) 4,
            (int64) 3, (int64) 1);
        sd.put("0.weight", #w0);
        Tensor<float32> b0 = WeightImportTest.torchVec((int64) 4,
            (int64) 4);
        sd.put("0.bias", #b0);
        Tensor<float32> w2 = WeightImportTest.torchGrid((int64) 2,
            (int64) 4, (int64) 7);
        sd.put("2.weight", #w2);
        Tensor<float32> b2 = WeightImportTest.torchVec((int64) 2,
            (int64) 10);
        sd.put("2.bias", #b2);
        StateDict mapped = Checkpoints.torchToCajeta(sd);
        ImportReport rep = Checkpoints.importTorch(net, mapped);
        Assert.isTrue(rep.clean());
        // Freeze the imported backbone, replace the head, train.
        net.at((int32) 0).setTrainable(false);
        Module newHead = heap Linear((int64) 4, (int64) 2, (uint64) 32);
        net.replace((int32) 2, #newHead);
        Tensor<float32> x = TransferLearningTest.gridTensor((int64) 8,
            (int64) 3, (int64) 0, 0.25);
        Tensor<float32> y = TransferLearningTest.gridTensor((int64) 8,
            (int64) 2, (int64) 3, 0.3);
        float64 before = TransferLearningTest.phase(net, x, y, (int64) 0);
        float64 after = TransferLearningTest.phase(net, x, y, (int64) 5);
        Assert.isTrue(after == after && after < before);
    }

    // 5.1.6 — the .pt path rides the CONSTRAINED unpickler into the same
    // reconciliation: the existing torch-written fixture imports strict
    // after a prefix rename, and the malicious pickle still dies in the
    // reader, never reaching the importer.
    @Test
    public void ptRouteUsesConstrainedReader() {
        StateDict sd = PtReader.read(CheckpointTest.fixture("mlp_state.pt"));
        StateDict renamed = Checkpoints.renamePrefix(sd, "layers.", "");
        Sequential net = heap Sequential();
        Module l1 = heap Linear((int64) 3, (int64) 4, (uint64) 40);
        net.add(#l1);
        Module r = heap ReLU();
        net.add(#r);
        Module l2 = heap Linear((int64) 4, (int64) 2, (uint64) 41);
        net.add(#l2);
        // The fixture was written in cajeta layout (base-plan U9), so no
        // torchToCajeta here — mapping steps stay explicit and composable.
        // Names are 0./2. under a bare Sequential root; the fixture's
        // "layers." prefix maps away.
        ArrayList<String> names = net.parameterNames();
        Assert.isTrue(names.get(0).equals("0.weight"));
        ImportReport rep = Checkpoints.importTorch(net, renamed);
        Assert.isTrue(rep.clean());
        Assert.equals((int64) 4, (int64) rep.applied());
        // The malicious pickle dies in the reader.
        Assert.assertThrows(() -> {
            StateDict bad = PtReader.read(CheckpointTest.fixture("evil.pt"));
            bad.count();
        });
    }
}
