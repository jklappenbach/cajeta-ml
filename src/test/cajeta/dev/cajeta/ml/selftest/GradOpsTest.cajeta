        GradTensor y = t.log(a);
        float32[] po = [-1.38629436f, -0.28768206f, -1.38629436f,
                        -0.69314718f, 0.0f, -0.69314718f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
