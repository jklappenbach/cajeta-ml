    @Test
    public void pinLogSoftmax() {
        GradTape<float32> t = heap GradTape<float32>();
        Tensor<float32> av = GradOpsTest.a23();
        GradTensor a = t.leaf(av, true);
        GradTensor y = t.logSoftmax(a);
        float32[] po = [-1.68026972f, -1.18026972f, -0.68026966f,
                        -1.68026972f, -1.18026972f, -0.68026966f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
        // torch: g - softmax·Σg with K rows summing to 3.0
        float32[] pa = [-0.05897115f, 0.07841238f, -0.01944119f,
                        -0.05897115f, 0.07841238f, -0.01944119f];
        GradOpsTest.checkFlat(t.gradOf(a), pa, GradOpsTest.TOL);
    }

