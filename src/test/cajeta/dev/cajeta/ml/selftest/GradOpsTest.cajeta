package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.grad.Op;
import dev.cajeta.ml.grad.Ops;

/**
 * cajeta-ml-v3 plan 2.1.2 / 2.1.3 / 2.3.1 — per-op forward + gradient pins
 * against PINNED torch 2.13.0+cpu (tools/fixtures/gen_grad_ops.py), the
 * device-seam registry pin, and the composite 2-layer-MLP end-to-end pin.
 *
 * Every op test builds the fixture inputs from the generator's integer
 * formulas, runs the op through a GradTape, and backprops the weighted
 * scalar L = sum(out ⊙ K), K[f] = ((f % 3) + 1) · 0.5 — non-uniform
 * cotangents so wrong VJPs can't hide behind symmetric seeds.
 *
 * Seam note (2.1.3): only the registry-introspection half is pinned here —
 * this host has no GPU tensor constructor, so the mixed-residency throw in
 * Ops.requireSame is exercised when the xpu phase lands real GPU residency.
 */
public class GradOpsTest {

    public GradOpsTest() { return; }

    // ── fixture inputs (mirror gen_grad_ops.py exactly) ─────────────────

    /** (2,3): (f+1)*0.5 - 1.75 — mixed signs. */
    static #Tensor<float32> a23() {
        int64[] sh = [2, 3];
        Tensor<float32> t = Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < 6) {
            t.flatSet(f, (float32) (f + 1) * 0.5f - 1.75f);
            f = f + 1;
        }
        return #t;
    }

    /** (2,3): ((i+2j) % 4)*0.25 + 0.25 — strictly positive. */
    static #Tensor<float32> b23() {
        int64[] sh = [2, 3];
        Tensor<float32> t = Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < 6) {
            int64 i = f / 3;
            int64 j = f - i * 3;
            t.flatSet(f, (float32) ((i + 2 * j) % 4) * 0.25f + 0.25f);
            f = f + 1;
        }
        return #t;
    }

    /** (3,2): (i-j)*0.5 + 0.25. */
    static #Tensor<float32> w32() {
        int64[] sh = [3, 2];
        Tensor<float32> t = Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < 6) {
            int64 i = f / 2;
            int64 j = f - i * 2;
            t.flatSet(f, (float32) (i - j) * 0.5f + 0.25f);
            f = f + 1;
        }
        return #t;
    }

    /** (1,3) broadcast row: j*0.5 + 0.5. */
    static #Tensor<float32> r13() {
        int64[] sh = [1, 3];
        Tensor<float32> t = Tensor.full<float32>(sh, 0.0f);
        int64 f = 0;
        while (f < 3) {
            t.flatSet(f, (float32) f * 0.5f + 0.5f);
            f = f + 1;
        }
        return #t;
    }

    // ── harness ──────────────────────────────────────────────────────────

    static int64 countOf(Tensor<float32> t) {
        int64 n = 1;
        int32 d = 0;
        while (d < t.ndim()) {
            n = n * t.shapeAt(d);
            d = d + 1;
        }
        return n;
    }

    /** The generator's cotangent weights: K[f] = ((f % 3) + 1) * 0.5. */
    static #Tensor<float32> kLike(Tensor<float32> src) {
        Tensor<float32> out = src.copy();
        int64 n = GradOpsTest.countOf(out);
        int64 f = 0;
        while (f < n) {
            out.flatSet(f, (float32) (f % 3 + 1) * 0.5f);
            f = f + 1;
        }
        return #out;
    }

    /** Backprop L = sum(y ⊙ K) through the tape. */
    static void wback(GradTape<float32> t, GradTensor y) {
        Tensor<float32> kv = GradOpsTest.kLike(t.valueOf(y));
        GradTensor k = t.leaf(kv, false);
        GradTensor loss = t.sum(t.mul(y, k));
        t.backward(loss);
    }

    static void checkFlat(Tensor<float32> t, float32[] exp, float32 tol) {
        int64 n = (int64) exp.count();
        Assert.isTrue(GradOpsTest.countOf(t) == n);
        int64 f = 0;
        while (f < n) {
            float32 e = exp[f];
            float32 v = t.flatGet(f);
            float32 d = v - e;
            if (d < 0.0f) { d = 0.0f - d; }
            if (d >= tol) {
                Assert.fail("flat[" + f + "] = " + v + ", torch pin " + e);
            }
            f = f + 1;
        }
    }

    static float32 TOL = 0.0002f;

    // ── float64 fixture/harness (the generic-E tape's second column) ────

    static #Tensor<float64> a23d() {
        int64[] sh = [2, 3];
        Tensor<float64> t = Tensor.full<float64>(sh, 0.0);
        int64 f = 0;
        while (f < 6) {
            t.flatSet(f, (float64) (f + 1) * 0.5 - 1.75);
            f = f + 1;
        }
        return #t;
    }

    static #Tensor<float64> w32d() {
        int64[] sh = [3, 2];
        Tensor<float64> t = Tensor.full<float64>(sh, 0.0);
        int64 f = 0;
        while (f < 6) {
            int64 i = f / 2;
            int64 j = f - i * 2;
            t.flatSet(f, (float64) (i - j) * 0.5 + 0.25);
            f = f + 1;
        }
        return #t;
    }

    static #Tensor<float64> kLikeD(Tensor<float64> src) {
        Tensor<float64> out = src.copy();
        int64 n = 1;
        int32 d = 0;
        while (d < out.ndim()) {
            n = n * out.shapeAt(d);
            d = d + 1;
        }
        int64 f = 0;
        while (f < n) {
            out.flatSet(f, (float64) (f % 3 + 1) * 0.5);
            f = f + 1;
        }
        return #out;
    }

    static void checkFlatD(Tensor<float64> t, float64[] exp, float64 tol) {
        int64 n = (int64) exp.count();
        int64 f = 0;
        while (f < n) {
            float64 e = exp[f];
            float64 v = t.flatGet(f);
            float64 d = v - e;
            if (d < 0.0) { d = 0.0 - d; }
            if (d >= tol) {
                Assert.fail("f64 flat[" + f + "] = " + v + ", torch pin " + e);
            }
            f = f + 1;
        }
    }

    // ── 2.1.3 the seam registry pin ──────────────────────────────────────

    @Test
    public void seamCpuColumnCompleteGpuColumnEmpty() {
        Assert.isFalse(Ops.hasCpu(Op.LEAF));
        int32 op = Op.ADD;
        while (op < Op.COUNT) {
            Assert.isTrue(Ops.hasCpu(op));
            Assert.isFalse(Ops.hasGpu(op));
            op = op + 1;
        }
        Assert.equals("matmul", Ops.name(Op.MATMUL));
        Assert.equals("logSoftmax", Ops.name(Op.LOGSOFTMAX));
    }

    // ── 2.1.2 per-op torch pins ──────────────────────────────────────────

    @Test
    public void pinAddBroadcast() {
        GradTape<float32> t = heap GradTape<float32>();
        Tensor<float32> av = GradOpsTest.a23();
        Tensor<float32> bv = GradOpsTest.r13();
        GradTensor a = t.leaf(av, true);
        GradTensor b = t.leaf(bv, true);
        GradTensor y = t.add(a, b);
        float32[] po = [-0.75f, 0.25f, 1.25f, 0.75f, 1.75f, 2.75f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
        float32[] pa = [0.5f, 1.0f, 1.5f, 0.5f, 1.0f, 1.5f];
        float32[] pb = [1.0f, 2.0f, 3.0f];
        GradOpsTest.checkFlat(t.gradOf(a), pa, GradOpsTest.TOL);
        GradOpsTest.checkFlat(t.gradOf(b), pb, GradOpsTest.TOL);
    }

    @Test
    public void pinSubBroadcast() {
        GradTape<float32> t = heap GradTape<float32>();
        Tensor<float32> av = GradOpsTest.a23();
        Tensor<float32> bv = GradOpsTest.r13();
        GradTensor a = t.leaf(av, true);
        GradTensor b = t.leaf(bv, true);
        GradTensor y = t.sub(a, b);
        float32[] po = [-1.75f, -1.75f, -1.75f, -0.25f, -0.25f, -0.25f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
        float32[] pa = [0.5f, 1.0f, 1.5f, 0.5f, 1.0f, 1.5f];
        float32[] pb = [-1.0f, -2.0f, -3.0f];
        GradOpsTest.checkFlat(t.gradOf(a), pa, GradOpsTest.TOL);
        GradOpsTest.checkFlat(t.gradOf(b), pb, GradOpsTest.TOL);
    }

    @Test
    public void pinMulBroadcast() {
        GradTape<float32> t = heap GradTape<float32>();
        Tensor<float32> av = GradOpsTest.a23();
        Tensor<float32> bv = GradOpsTest.r13();
        GradTensor a = t.leaf(av, true);
        GradTensor b = t.leaf(bv, true);
        GradTensor y = t.mul(a, b);
        float32[] po = [-0.625f, -0.75f, -0.375f, 0.125f, 0.75f, 1.875f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
        float32[] pa = [0.25f, 1.0f, 2.25f, 0.25f, 1.0f, 2.25f];
        float32[] pb = [-0.5f, 0.0f, 1.5f];
        GradOpsTest.checkFlat(t.gradOf(a), pa, GradOpsTest.TOL);
        GradOpsTest.checkFlat(t.gradOf(b), pb, GradOpsTest.TOL);
    }

    @Test
    public void pinDivBroadcast() {
        GradTape<float32> t = heap GradTape<float32>();
        Tensor<float32> av = GradOpsTest.a23();
        Tensor<float32> bv = GradOpsTest.r13();
        GradTensor a = t.leaf(av, true);
        GradTensor b = t.leaf(bv, true);
        GradTensor y = t.div(a, b);
        float32[] po = [-2.5f, -0.75f, -0.16666667f, 0.5f, 0.75f, 0.83333331f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
        float32[] pa = [1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f];
        float32[] pb = [2.0f, 0.0f, -0.66666657f];
        GradOpsTest.checkFlat(t.gradOf(a), pa, GradOpsTest.TOL);
        GradOpsTest.checkFlat(t.gradOf(b), pb, GradOpsTest.TOL);
    }

    @Test
    public void pinMatmul() {
        GradTape<float32> t = heap GradTape<float32>();
        Tensor<float32> av = GradOpsTest.a23();
        Tensor<float32> bv = GradOpsTest.w32();
        GradTensor a = t.leaf(av, true);
        GradTensor b = t.leaf(bv, true);
        GradTensor y = t.matmul(a, b);
        float32[] po = [-1.1875f, -0.0625f, 2.1875f, 1.0625f];
        GradOpsTest.checkFlat(t.valueOf(y), po, GradOpsTest.TOL);
        GradOpsTest.wback(t, y);
        float32[] pa = [-0.125f, 0.625f, 1.375f, 0.25f, 1.25f, 2.25f];
        float32[] pb = [-0.25f, -1.125f, 0.75f, -0.375f, 1.75f, 0.375f];
        GradOpsTest.checkFlat(t.gradOf(a), pa, GradOpsTest.TOL);
        GradOpsTest.checkFlat(t.gradOf(b), pb, GradOpsTest.TOL);
    }

