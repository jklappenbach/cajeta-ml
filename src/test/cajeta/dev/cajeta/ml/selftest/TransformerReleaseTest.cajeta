package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.nn.Linear;
import dev.cajeta.ml.nn.Masks;
import dev.cajeta.ml.nn.Module;
import dev.cajeta.ml.nn.Nets;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.nn.ReLU;
import dev.cajeta.ml.nn.Sequential;
import dev.cajeta.ml.nn.SinusoidalPositionalEncoding;
import dev.cajeta.ml.nn.TransformerDecoderLayer;
import dev.cajeta.ml.optim.Adam;
import dev.cajeta.ml.data.AugmentPipeline;
import dev.cajeta.ml.data.Normalize;
import dev.cajeta.ml.data.Transform;

/**
 * cajeta-ml-v3 §13 plan 6.1 — the release gates: a transformer TRAINED
 * end to end (positional encodings + cross-attention + causal and
 * padding masks) matches torch 2.13.0+cpu on final loss
 * (gen_transformer_train.py); a transfer run with the preprocessing
 * pipeline (import-shaped weights, freeze, replace head, train,
 * unfreeze) matches torch phase losses (gen_transfer_aug.py) — the
 * pipeline's deterministic member pins across stacks; random augments
 * cannot pin across RNGs and are covered by U3's own suite.
 */
public class TransformerReleaseTest {

    public TransformerReleaseTest() { return; }

    // 6.1.2 — encodings + cross-attention + masking, TRAINED, matching
    // torch's final loss after 10 Adam steps.
    @Test
    public void trainedTransformerMatchesTorchLoss() {
        TransformerDecoderLayer layer = heap TransformerDecoderLayer(
            (int64) 4, (int32) 2, (int64) 8, (uint64) 1);
        Parameter[] ps = layer.parameters();
        DecoderTest.setAttention(ps, (int32) 0, (int64) 1, (int64) 4,
            (int64) 7, (int64) 10);
        DecoderTest.setAttention(ps, (int32) 8, (int64) 13, (int64) 16,
            (int64) 19, (int64) 22);
        Tensor<float32> l1w = ps[16].get();
        int64 i = 0;
        while (i < 4) {
            int64 o = 0;
            while (o < 8) {
                l1w.flatSet(i * 8 + o, DecoderTest.gv(o * 4 + i,
                    (int64) 25));
                o = o + 1;
            }
            i = i + 1;
        }
        DecoderTest.fill(ps[17].get(), (int64) 28);
        Tensor<float32> l2w = ps[18].get();
        i = 0;
        while (i < 8) {
            int64 o = 0;
            while (o < 4) {
                l2w.flatSet(i * 4 + o, DecoderTest.gv(o * 8 + i,
                    (int64) 31));
                o = o + 1;
            }
            i = i + 1;
        }
        DecoderTest.fill(ps[19].get(), (int64) 34);
        DecoderTest.fill(ps[20].get(), (int64) 37);
        DecoderTest.fill(ps[21].get(), (int64) 40);
        DecoderTest.fill(ps[22].get(), (int64) 43);
        DecoderTest.fill(ps[23].get(), (int64) 46);
        DecoderTest.fill(ps[24].get(), (int64) 49);
        DecoderTest.fill(ps[25].get(), (int64) 52);

        SinusoidalPositionalEncoding pe =
            heap SinusoidalPositionalEncoding((int64) 3, (int64) 4);
        int64[] ts = heap int64[3];
        ts[0] = 2;
        ts[1] = 3;
        ts[2] = 4;
        Tensor<float32> tgt = Tensor.zeros<float32>(ts);
        DecoderTest.fill(tgt, (int64) 0);
        Tensor<float32> target = Tensor.zeros<float32>(ts);
        int64 z = 0;
        while (z < target.size()) {
            target.flatSet(z, (float32) ((float64) DecoderTest.gv(z,
                (int64) 5) * 1.5));      // scale 0.2 -> 0.3
            z = z + 1;
        }
        int64[] ms = heap int64[3];
        ms[0] = 2;
        ms[1] = 4;
        ms[2] = 4;
        Tensor<float32> mem = Tensor.zeros<float32>(ms);
        DecoderTest.fill(mem, (int64) 2);
        Tensor<float32> selfMask = Masks.causal((int64) 2, (int64) 3);
        int64[] lens = heap int64[2];
        lens[0] = 4;
        lens[1] = 3;
        Tensor<float32> memMask = Masks.keyPadding(lens, (int64) 3,
            (int64) 4);

        Adam opt = heap Adam(#layer.parameters(), 0.05f);
        int64 s = 0;
        float64 lastLoss = 0.0;
        while (s < 11) {
            GradTape<float32> tape = heap GradTape<float32>();
            layer.bindParameters(tape);
            GradTensor x = tape.leaf(tgt, false);
            GradTensor xpe = pe.forward(tape, x);
            GradTensor m = tape.leaf(mem, false);
            GradTensor y = layer.decode(tape, xpe, m, true, selfMask,
                true, memMask);
            GradTensor tl = tape.leaf(target, false);
            GradTensor loss = tape.mseLoss(y, tl);
            lastLoss = (float64) tape.valueOf(loss).flatGet(0);
            if (s < 10) {
                tape.backward(loss);
                Parameter[] cur = layer.parameters();
                Tensor<float32>[] gs = Nets.gradsOf(tape, cur);
                opt.step(gs);
            }
            layer.unbindParameters();
            s = s + 1;
        }
        Assert.isTrue(lastLoss > 0.042835742235183716 - 0.00001
            && lastLoss < 0.042835742235183716 + 0.00001);
    }

    // 6.1.3 — the transfer run THROUGH the preprocessing pipeline:
    // normalize (explicit stats), pretrain, freeze + replace head,
    // train, unfreeze, train — torch phase losses at 1e-5.
    @Test
    public void transferRunWithPreprocessingMatchesTorch() {
        // (8, 1, 4, 4) images through Normalize(0.1, 0.8), then flat.
        int64[] sh = heap int64[4];
        sh[0] = 8;
        sh[1] = 1;
        sh[2] = 4;
        sh[3] = 4;
        Tensor<float32> imgs = Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < imgs.size()) {
            imgs.flatSet(i, TransferLearningTest.gv(i, (int64) 0, 0.25));
            i = i + 1;
        }
        AugmentPipeline pl = heap AugmentPipeline((uint64) 3);
        float32[] mean = heap float32[1];
        mean[0] = 0.1f;
        float32[] std = heap float32[1];
        std[0] = 0.8f;
        Transform nm = heap Normalize(#mean, #std);
        pl.add(#nm);
        pl.eval();                       // deterministic path
        Tensor<float32> pre = pl.apply(imgs);
        int64[] fs = heap int64[2];
        fs[0] = 8;
        fs[1] = 16;
        Tensor<float32> x = Tensor.zeros<float32>(fs);
        i = 0;
        while (i < 128) {
            x.flatSet(i, pre.flatGet(i));
            i = i + 1;
        }
        Tensor<float32> y = TransferLearningTest.gridTensor((int64) 8,
            (int64) 2, (int64) 3, 0.3);

        Sequential net = heap Sequential();
        Module l1 = heap Linear((int64) 16, (int64) 4, (uint64) 60);
        TransferLearningTest.setLinear((Linear) l1, (int64) 16, (int64) 4,
            (int64) 1, (int64) 4);
        net.add(#l1);
        Module r = heap ReLU();
        net.add(#r);
        Module l2 = heap Linear((int64) 4, (int64) 2, (uint64) 61);
        TransferLearningTest.setLinear((Linear) l2, (int64) 4, (int64) 2,
            (int64) 7, (int64) 10);
        net.add(#l2);

        float64 la = TransferLearningTest.phase(net, x, y, (int64) 5);
        Assert.isTrue(la > 0.028230447322130203 - 0.00001
            && la < 0.028230447322130203 + 0.00001);
        net.at((int32) 0).setTrainable(false);
        Module newHead = heap Linear((int64) 4, (int64) 2, (uint64) 62);
        TransferLearningTest.setLinear((Linear) newHead, (int64) 4,
            (int64) 2, (int64) 50, (int64) 53);
        net.replace((int32) 2, #newHead);
        float64 lb = TransferLearningTest.phase(net, x, y, (int64) 5);
        Assert.isTrue(lb > 0.021749576553702354 - 0.00001
            && lb < 0.021749576553702354 + 0.00001);
        net.setTrainable(true);
        float64 lc = TransferLearningTest.phase(net, x, y, (int64) 5);
        Assert.isTrue(lc > 0.0035513024777173996 - 0.00001
            && lc < 0.0035513024777173996 + 0.00001);
    }
}
