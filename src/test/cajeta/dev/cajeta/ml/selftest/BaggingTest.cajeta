package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.BaggingClassifier;
import dev.cajeta.ml.BaggingRegressor;
import dev.cajeta.ml.EstimatorFactory;
import dev.cajeta.ml.LogisticRegression;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.Predictor;
import dev.cajeta.ml.TreeClassifierFactory;
import dev.cajeta.ml.TreeRegressorFactory;

/**
 * ml-trees-ensembles U5 — bootstrap + bagging. Sampling is seeded and
 * reproducible with the documented per-member derivation (member i draws
 * from seed + i), aggregation is majority vote / mean, OOB scores use only
 * the members that never saw the sample, and bagging is generic over
 * `Predictor` (verified with LogisticRegression, §11.5). Everything is
 * sequential and deterministic, so thread counts cannot exist to change
 * results (§12.4) — refits are asserted bit-identical.
 */
public class BaggingTest {

    public BaggingTest() { return; }

    // A separable two-blob binary fixture (n = 40, 2 features).
    static #Tensor<float64> bagX() {
        float64[] a = heap float64[80];
        int64 i = 0;
        while (i < 40) {
            float64 base = i < 20 ? 0.0 : 10.0;
            a[i * 2] = base + (float64) (i % 5);
            a[i * 2 + 1] = base + (float64) ((i * 3) % 7);
            i = i + 1;
        }
        int64[] sh = heap int64[2]; sh[0] = 40; sh[1] = 2;
        return Tensor.of<float64>(a, sh);
    }

    static #Tensor<float64> bagY() {
        float64[] a = heap float64[40];
        int64 i = 20;
        while (i < 40) { a[i] = 1.0; i = i + 1; }
        int64[] sh = heap int64[1]; sh[0] = 40;
        return Tensor.of<float64>(a, sh);
    }

    // 5.1.1 + 5.1.2 — a bootstrap sample is size n, with replacement,
    // seeded; OOB is the exact complement and its fraction approaches 1/e.
    @Test
    public void bootstrapSampleAndOobComplement() {
        Tensor<int64> s1 = BaggingClassifier.bootstrapIndices((uint64) 42, (int64) 10000);
        Tensor<int64> s2 = BaggingClassifier.bootstrapIndices((uint64) 42, (int64) 10000);
        Assert.equals(s1.shapeAt(0), (int64) 10000);
        boolean[] seen = heap boolean[10000];
        int64 i = 0;
        boolean repeat = false;
        while (i < 10000) {
            int64 v = s1.flatGet(i);
            Assert.isTrue(v >= 0 && v < (int64) 10000);
            Assert.equals(s2.flatGet(i), v);          // seeded ✓
            if (seen[v]) { repeat = true; }
            seen[v] = true;
            i = i + 1;
        }
        Assert.isTrue(repeat);                         // with replacement ✓
        int64 inBag = 0;
        i = 0;
        while (i < 10000) { if (seen[i]) { inBag = inBag + 1; } i = i + 1; }
        float64 oobFrac = (float64) (10000 - inBag) / 10000.0;
        // 1/e ~ 0.3679; a healthy sampler lands within ±0.02 at n = 10k.
        Assert.isTrue(oobFrac > 0.34 && oobFrac < 0.40);
        return;
    }

    // 5.1.5 + 5.1.3 — trees bagged on the separable fixture vote their way
    // to a perfect training score, and the OOB score (only never-seen
    // members vote) is high but computed from held-out members.
    @Test
    public void treeBaggingVotesAndOob() {
        Tensor<float64> x = BaggingTest.bagX();
        Tensor<float64> y = BaggingTest.bagY();
        float64[] pa = heap float64[1];
        pa[0] = 0.0;                                   // maxDepth 0 = unbounded
        int64[] ps = heap int64[1]; ps[0] = 1;
        Tensor<float64> params = Tensor.of<float64>(pa, ps);

        BaggingClassifier b = heap BaggingClassifier(
            heap TreeClassifierFactory(), params, (int64) 9, (uint64) 3);
        b.setOobScore(true);
        b.fit(x, y);
        Assert.isTrue(b.score(x, y) == 1.0);
        float64 oob = b.oobScore();
        Assert.isTrue(oob > 0.8 && oob <= 1.0);
        return;
    }

    // 5.1.4 / 5.3.1 — bagging is generic over Predictor: a LogisticRegression
    // factory bags identically well; nothing in the ensemble is tree-aware.
    @Test
    public void baggingIsGenericOverPredictor() {
        Tensor<float64> x = BaggingTest.bagX();
        Tensor<float64> y = BaggingTest.bagY();
        float64[] pa = heap float64[1];
        int64[] ps = heap int64[1]; ps[0] = 1;
        Tensor<float64> params = Tensor.of<float64>(pa, ps);

        BaggingClassifier b = heap BaggingClassifier(
            heap LogisticFactory(), params, (int64) 5, (uint64) 11);
        b.fit(x, y);
        Assert.isTrue(b.score(x, y) == 1.0);
        return;
    }

    // 5.1.6 / 5.3.2 — a seeded ensemble refit is bit-identical (sequential
    // + documented per-member seeds; there is no thread count to vary).
    @Test
    public void seededEnsembleRefitBitIdentical() {
        Tensor<float64> x = BaggingTest.bagX();
        Tensor<float64> y = BaggingTest.bagY();
        float64[] pa = heap float64[1];
        int64[] ps = heap int64[1]; ps[0] = 1;
        Tensor<float64> params = Tensor.of<float64>(pa, ps);

        BaggingRegressor r1 = heap BaggingRegressor(
            heap TreeRegressorFactory(), params, (int64) 7, (uint64) 5);
        BaggingRegressor r2 = heap BaggingRegressor(
            heap TreeRegressorFactory(), params, (int64) 7, (uint64) 5);
        r1.fit(x, y);
        r2.fit(x, y);
        Tensor<float64> p1 = r1.predict(x);
        Tensor<float64> p2 = r2.predict(x);
        int64 i = 0;
        while (i < 40) {
            Assert.equals(Cajeta.f64ToBits(p2.flatGet(i)), Cajeta.f64ToBits(p1.flatGet(i)));
            i = i + 1;
        }
        // The regressor aggregates by MEAN: on the separable fixture every
        // member is exact, so the mean is exactly the label.
        Assert.isTrue(p1.flatGet((int64) 0) == 0.0);
        Assert.isTrue(p1.flatGet((int64) 39) == 1.0);
        return;
    }

    // 6.6 — OOB with a configuration that cannot cover any sample (a single
    // member sees everything in-bag ~ n small enough that no sample is OOB
    // for all members is impossible to force reliably; instead: asking for
    // oobScore() without enabling it, or before fit, is a loud error).
    @Test
    public void oobMisuseIsLoud() {
        float64[] pa = heap float64[1];
        int64[] ps = heap int64[1]; ps[0] = 1;
        Tensor<float64> params = Tensor.of<float64>(pa, ps);
        BaggingClassifier b = heap BaggingClassifier(
            heap TreeClassifierFactory(), params, (int64) 3, (uint64) 1);
        boolean threw = false;
        try {
            float64 s = b.oobScore();
        } catch (MlException ex) { threw = true; }
        Assert.isTrue(threw);
        return;
    }
}
