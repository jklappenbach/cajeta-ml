package dev.cajeta.ml.selftest;

import cajeta.math.Tensor;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.data.Batches;
import dev.cajeta.ml.data.Digits;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.nn.Linear;
import dev.cajeta.ml.nn.Module;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.nn.ReLU;
import dev.cajeta.ml.nn.Sequential;
import dev.cajeta.ml.optim.Adam;
import dev.cajeta.ml.optim.AdamW;
import dev.cajeta.ml.optim.Optimizer;
import dev.cajeta.ml.optim.SGD;
import dev.cajeta.ml.optim.Schedules;
import dev.cajeta.ml.train.BackpropTrainer;
import dev.cajeta.ml.train.Loss;
import dev.cajeta.ml.train.TrainHistory;

/**
 * cajeta-ml-v3 plan 5.1.1–5.3.1 — optimizer TRAJECTORIES (not single
 * steps), LR schedule curves, seeded batching, gradient clipping, and an
 * end-to-end training run, every one pinned against PINNED torch
 * 2.13.0+cpu (tools/fixtures/gen_optim_train.py).
 *
 * The optimizer pins drive a bare parameter with a deterministic gradient
 * SEQUENCE rather than a model, so a mismatch localizes to the optimizer
 * instead of anything upstream of it.
 */
public class TrainerTest {

    public TrainerTest() { return; }

    static float32 TOL = 0.0002f;

    static void checkFlat(Tensor<float32> t, float32[] exp, float32 tol) {
        int64 n = (int64) exp.count();
        int64 f = 0;
        while (f < n) {
            float32 v = t.flatGet(f);
            float32 d = v - exp[f];
            if (d < 0.0f) { d = 0.0f - d; }
            if (d >= tol) {
                Assert.fail("flat[" + f + "] = " + v + ", torch pin " + exp[f]);
            }
            f = f + 1;
        }
    }

    static boolean near(float64 a, float64 b, float64 tol) {
        float64 d = a - b;
        if (d < 0.0) { d = 0.0 - d; }
        return d < tol;
    }

    /** The pinned starting parameter, `[0.5, -0.25, 1.0, -0.75]`. */
    static #Parameter[] startParam() {
        int64[] s = heap int64[1];
        s[0] = 4;
        Tensor<float32> v = Tensor.zeros<float32>(s);
        v.flatSet(0, 0.5f);
        v.flatSet(1, -0.25f);
        v.flatSet(2, 1.0f);
        v.flatSet(3, -0.75f);
        Parameter[] ps = heap Parameter[1];
        ps[0] = heap Parameter(#v);
        return ps;
    }

    /** The generator's gradient at step `s`: `((s+i) % 5) * 0.25 - 0.5`. */
    static #Tensor<float32>[] gradAt(int64 s) {
        int64[] sh = heap int64[1];
        sh[0] = 4;
        Tensor<float32> g = Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < 4) {
            g.flatSet(i, (float32) ((s + i) % 5) * 0.25f - 0.5f);
            i = i + 1;
        }
        Tensor<float32>[] gs = heap Tensor<float32>[1];
        gs[0] = #g;
        return gs;
    }

    // ── 5.1.1 optimizer trajectories ────────────────────────────────────

    @Test
    public void sgdPlainTrajectoryMatchesTorch() {
        Parameter[] ps = TrainerTest.startParam();
        Parameter p = ps[0];
        Optimizer opt = heap SGD(#ps, 0.1f, 0.0f);
        int64 s = 0;
        while (s < 5) {
            opt.step(TrainerTest.gradAt(s));
            s = s + 1;
        }
        float32[] want = [0.5f, -0.25f, 1.0f, -0.75f];
        TrainerTest.checkFlat(p.get(), want, TrainerTest.TOL);
    }

    @Test
    public void sgdMomentumTrajectoryMatchesTorch() {
        Parameter[] ps = TrainerTest.startParam();
        Parameter p = ps[0];
        Optimizer opt = heap SGD(#ps, 0.1f, 0.9f);
        // step 1 pins the first momentum accumulation, step 4 the compounding
        opt.step(TrainerTest.gradAt(0));
        float32[] afterFirst = [0.55000001f, -0.22499999f, 1.0f, -0.77499998f];
        TrainerTest.checkFlat(p.get(), afterFirst, TrainerTest.TOL);
        int64 s = 1;
        while (s < 5) {
            opt.step(TrainerTest.gradAt(s));
            s = s + 1;
        }
        float32[] want = [0.69323003f, -0.26037249f, 0.898525f, -0.84132749f];
        TrainerTest.checkFlat(p.get(), want, TrainerTest.TOL);
    }

    @Test
    public void adamTrajectoryMatchesTorch() {
        Parameter[] ps = TrainerTest.startParam();
        Parameter p = ps[0];
        Optimizer opt = heap Adam(#ps, 0.1f);
        opt.step(TrainerTest.gradAt(0));
        // the first step is ±lr regardless of gradient magnitude — Adam's
        // signature behaviour, and the clearest single check of bias
        // correction being applied at all
        float32[] afterFirst = [0.59999996f, -0.15000001f, 1.0f, -0.84999996f];
        TrainerTest.checkFlat(p.get(), afterFirst, TrainerTest.TOL);
        int64 s = 1;
        while (s < 5) {
            opt.step(TrainerTest.gradAt(s));
            s = s + 1;
        }
        float32[] want = [0.78056443f, -0.14230831f, 0.83869445f, -0.94420695f];
        TrainerTest.checkFlat(p.get(), want, TrainerTest.TOL);
    }

    /** AdamW's weight decay is DECOUPLED — applied to the parameter, not
     *  folded into the gradient — so its trajectory separates from Adam's
     *  from the very first step. */
    @Test
    public void adamWDecoupledDecayMatchesTorch() {
        Parameter[] ps = TrainerTest.startParam();
        Parameter p = ps[0];
        Optimizer opt = heap AdamW(#ps, 0.1f, 0.01f);
        opt.step(TrainerTest.gradAt(0));
        float32[] afterFirst = [0.5995f, -0.14975002f, 0.99900001f, -0.84924996f];
        TrainerTest.checkFlat(p.get(), afterFirst, TrainerTest.TOL);
        int64 s = 1;
        while (s < 5) {
            opt.step(TrainerTest.gradAt(s));
            s = s + 1;
        }
        float32[] want = [0.77721655f, -0.14159237f, 0.83410501f, -0.93975818f];
        TrainerTest.checkFlat(p.get(), want, TrainerTest.TOL);

        // ...and it is NOT the same as Adam's trajectory: decoupled decay
        // is a different update, not a reparameterization of the same one.
        Parameter[] ps2 = TrainerTest.startParam();
        Parameter p2 = ps2[0];
        Optimizer plain = heap Adam(#ps2, 0.1f);
        s = 0;
        while (s < 5) {
            plain.step(TrainerTest.gradAt(s));
            s = s + 1;
        }
        Assert.isTrue(p2.get().flatGet(0) != p.get().flatGet(0));
    }

    // ── 5.1.2 schedules ─────────────────────────────────────────────────

    @Test
    public void cosineScheduleMatchesTorchCurve() {
        float32[] want = [0.1f, 0.09755283f, 0.09045085f, 0.07938926f,
                          0.06545085f, 0.05f, 0.03454915f, 0.02061074f,
                          0.00954915f, 0.00244717f, 0.0f];
        int64 s = 0;
        while (s < 11) {
            float32 got = Schedules.cosineLr(0.1f, 10, s);
            float32 d = got - want[s];
            if (d < 0.0f) { d = 0.0f - d; }
            if (d >= 0.00001f) {
                Assert.fail("cosine step " + s + ": " + got + " vs " + want[s]);
            }
            s = s + 1;
        }
    }

    @Test
    public void warmupCosineScheduleMatchesTorchCurve() {
        float32[] want = [0.03333333f, 0.06666667f, 0.1f, 0.1f, 0.09504844f,
                          0.08117449f, 0.06112605f, 0.03887395f, 0.01882551f,
                          0.00495156f, 0.0f];
        int64 s = 0;
        while (s < 11) {
            float32 got = Schedules.warmupCosineLr(0.1f, 3, 10, s);
            float32 d = got - want[s];
            if (d < 0.0f) { d = 0.0f - d; }
            if (d >= 0.00001f) {
                Assert.fail("warmupCosine step " + s + ": " + got
                    + " vs " + want[s]);
            }
            s = s + 1;
        }
    }

    // ── 5.1.3 seeded batching ───────────────────────────────────────────

    @Test
    public void batchingIsDeterministicPerSeedAndEpoch() {
        Tensor<float32> x = Digits.images(5, 4, 0.1f, 3L);
        Tensor<float32> y = Digits.labels(5, 4);
        Batches a = heap Batches(x, y, 6, 99L);
        Batches b = heap Batches(x, y, 6, 99L);
        a.reorder(2);
        b.reorder(2);
        int64[] ra = a.batchRows(0);
        int64[] rb = b.batchRows(0);
        int32 i = 0;
        while (i < (int32) ra.count()) {
            Assert.isTrue(ra[i] == rb[i]);
            i = i + 1;
        }
        // a DIFFERENT epoch reorders — and epoch 2 is reproducible from the
        // seed alone, without replaying epochs 0 and 1
        b.reorder(3);
        int64[] rc = b.batchRows(0);
        boolean differs = false;
        i = 0;
        while (i < (int32) ra.count()) {
            if (ra[i] != rc[i]) { differs = true; }
            i = i + 1;
        }
        Assert.isTrue(differs);
        Batches fresh = heap Batches(x, y, 6, 99L);
        fresh.reorder(2);
        int64[] rd = fresh.batchRows(0);
        i = 0;
        while (i < (int32) ra.count()) {
            Assert.isTrue(ra[i] == rd[i]);
            i = i + 1;
        }
    }

    @Test
    public void batchingCoversEveryRowExactlyOnce() {
        Tensor<float32> x = Digits.images(5, 4, 0.1f, 3L);
        Tensor<float32> y = Digits.labels(5, 4);
        Batches d = heap Batches(x, y, 6, 7L);     // 20 rows / 6 = 4 batches
        Assert.isTrue(d.rowCount() == 20);
        Assert.isTrue(d.batchCount() == 4);
        int64[] seen = heap int64[20];
        int64 b = 0;
        int64 total = 0;
        while (b < d.batchCount()) {
            int64[] rows = d.batchRows(b);
            int64 i = 0;
            while (i < (int64) rows.count()) {
                seen[rows[i]] = seen[rows[i]] + 1;
                total = total + 1;
                i = i + 1;
            }
            b = b + 1;
        }
        // the short final batch is KEPT, not dropped
        Assert.isTrue(total == 20);
        int64 k = 0;
        while (k < 20) {
            Assert.isTrue(seen[k] == 1);
            k = k + 1;
        }
    }

    @Test
    public void batchTensorsCarryTheRightRows() {
        Tensor<float32> x = Digits.images(2, 2, 0.0f, 5L);   // noiseless
        Tensor<float32> y = Digits.labels(2, 2);
        Batches d = heap Batches(x, y, 3, 11L);
        int64[] rows = d.batchRows(0);
        Tensor<float32> bx = d.batchX(0);
        Tensor<float32> by = d.batchY(0);
        Assert.isTrue(bx.shapeAt(0) == (int64) rows.count());
        Assert.isTrue(bx.shapeAt(1) == 64);
        int64 i = 0;
        while (i < (int64) rows.count()) {
            Assert.isTrue(by.flatGet(i) == y.flatGet(rows[i]));
            // pixel 0 of the gathered row equals pixel 0 of the source row
            Assert.isTrue(bx.get2(i, 0) == x.get2(rows[i], 0));
            i = i + 1;
        }
    }

    // ── 5.1.4 gradient clipping ─────────────────────────────────────────

    @Test
    public void clipByGlobalNormMatchesTorch() {
        int64[] s2 = heap int64[1];
        s2[0] = 2;
        Tensor<float32> g1 = Tensor.zeros<float32>(s2);
        g1.flatSet(0, 3.0f);
        g1.flatSet(1, 4.0f);
        int64[] s1 = heap int64[1];
        s1[0] = 1;
        Tensor<float32> g2 = Tensor.zeros<float32>(s1);
        g2.flatSet(0, 12.0f);
        Tensor<float32>[] gs = heap Tensor<float32>[2];
        gs[0] = #g1;
        gs[1] = #g2;
        float64 total = BackpropTrainer.clipByGlobalNorm(gs, 5.0f);
        // torch returns the norm BEFORE clipping: sqrt(9+16+144) = 13
        Assert.isTrue(TrainerTest.near(total, 13.0, 0.0001));
        float32[] w1 = [1.15384603f, 1.53846145f];
        float32[] w2 = [4.6153841f];
        TrainerTest.checkFlat(gs[0], w1, TrainerTest.TOL);
        TrainerTest.checkFlat(gs[1], w2, TrainerTest.TOL);
    }

    @Test
    public void clipLeavesSmallGradientsAlone() {
        int64[] s = heap int64[1];
        s[0] = 2;
        Tensor<float32> g = Tensor.zeros<float32>(s);
        g.flatSet(0, 0.3f);
        g.flatSet(1, 0.4f);
        Tensor<float32>[] gs = heap Tensor<float32>[1];
        gs[0] = #g;
        float64 total = BackpropTrainer.clipByGlobalNorm(gs, 5.0f);
        Assert.isTrue(TrainerTest.near(total, 0.5, 0.0001));
        Assert.isTrue(gs[0].flatGet(0) == 0.3f);
        Assert.isTrue(gs[0].flatGet(1) == 0.4f);
    }

    // ── 5.3.1 end-to-end training trajectory vs torch ───────────────────

    @Test
    public void mlpFullBatchSgdTrajectoryMatchesTorch() {
        TrainMlp net = heap TrainMlp();
        Parameter[] ps = net.parameters();
        Optimizer opt = heap SGD(net.parameters(), 0.1f, 0.0f);
        BackpropTrainer tr = heap BackpropTrainer(net, #opt, Loss.MSE, 0.0f);

        Tensor<float32> x = TrainMlp.inputs();
        Tensor<float32> y = TrainMlp.targets();
        float64[] want = [0.90658194, 0.58905649, 0.44029745, 0.35471386,
                          0.30051339, 0.2635259, 0.23669648, 0.21622784,
                          0.19995217, 0.1865713, 0.17527525, 0.16571882,
                          0.15784436, 0.1509247, 0.1447638, 0.13922168,
                          0.13419567, 0.12960845, 0.12540039, 0.12152415];
        int32 s = 0;
        while (s < 20) {
            float64 got = tr.stepOn(x, y, ps);
            if (!TrainerTest.near(got, want[s], 0.0005)) {
                Assert.fail("step " + s + " loss " + got + ", torch " + want[s]);
            }
            s = s + 1;
        }
        // and the weights themselves, not just the loss curve
        float32[] w1 = [-1.16353774f, -0.51691586f, -0.12779483f, 0.55129546f,
                        0.82052994f, -1.02461839f, -0.09845661f, -0.0512955f,
                        0.30459774f, 0.96767896f, -0.75274169f, -0.53419691f];
        float32[] b2 = [0.11312696f, 0.13595718f];
        TrainerTest.checkFlat(net.w1(), w1, 0.001f);
        TrainerTest.checkFlat(net.b2(), b2, 0.001f);
    }

    // ── the trainer drives a real classification run ────────────────────

    @Test
    public void trainerLearnsTheDigitsFixture() {
        Sequential net = heap Sequential();
        net.add(heap Linear(64, 16, 5L));
        net.add(heap ReLU());
        net.add(heap Linear(16, 4, 6L));
        Optimizer opt = heap Adam(net.parameters(), 0.01f);
        BackpropTrainer tr = heap BackpropTrainer(net, #opt,
                                                  Loss.CROSS_ENTROPY, 1.0f);
        Tensor<float32> x = Digits.images(12, 4, 0.25f, 17L);
        Tensor<float32> y = Digits.labels(12, 4);
        Batches data = heap Batches(x, y, 8, 23L);
        TrainHistory hist = tr.fit(data, 12);

        Assert.isTrue(hist.epochs() == 12);
        // the loss actually came down, and substantially
        Assert.isTrue(hist.finalLoss() < hist.lossAt(0) * 0.5);
        Assert.isTrue(hist.finalLoss() < 0.3);

        // and the trained net classifies the fixture it was shown
        net.eval();
        Tensor<float32> logits = net.predict(x);
        int64 hits = 0;
        int64 r = 0;
        while (r < 48) {
            int64 best = 0;
            float32 bv = logits.get2(r, 0);
            int64 j = 1;
            while (j < 4) {
                if (logits.get2(r, j) > bv) {
                    bv = logits.get2(r, j);
                    best = j;
                }
                j = j + 1;
            }
            if ((float32) best == y.flatGet(r)) { hits = hits + 1; }
            r = r + 1;
        }
        Assert.isTrue(hits >= 45);
    }

    /** Clipping caps the step a huge gradient can take, so a loss that
     *  would otherwise blow up stays finite. */
    @Test
    public void clippingKeepsALargeStepBounded() {
        Sequential net = heap Sequential();
        net.add(heap Linear(64, 1, 9L));
        Optimizer opt = heap SGD(net.parameters(), 5.0f, 0.0f);   // absurd lr
        BackpropTrainer tr = heap BackpropTrainer(net, #opt, Loss.MSE, 0.5f);
        Tensor<float32> x = Digits.images(4, 2, 0.1f, 31L);
        int64[] ys = heap int64[1];
        ys[0] = 8;
        Tensor<float32> y = Tensor.full<float32>(ys, 100.0f);   // wild target
        Parameter[] ps = net.parameters();
        int32 s = 0;
        while (s < 5) {
            float64 l = tr.stepOn(x, y, ps);
            Assert.isTrue(l == l);          // not NaN
            Assert.isTrue(l < 1000000.0);   // and not diverging
            s = s + 1;
        }
    }
}
