package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import cajeta.math.distance.Distance;
import cajeta.math.distance.Metric;
import cajeta.math.distance.Euclidean;
import cajeta.math.distance.Manhattan;
import cajeta.math.distance.Chebyshev;
import cajeta.math.distance.Minkowski;
import cajeta.math.distance.Cosine;
import dev.cajeta.ml.cluster.KMeans;
import dev.cajeta.ml.preprocess.StandardScaler;
import dev.cajeta.ml.preprocess.MinMaxScaler;

/**
 * ml-unsupervised plan 2.1 — the §2 distance seam and §3 scaling, consumed
 * from the ml side. The metric seam IS `cajeta.math.distance.Metric`
 * (stdlib, v0.17.0): estimators take a `Metric`, and NO distance
 * implementation exists in this library (§12.8 — grep-verified at
 * acceptance).
 */
public class DistanceScalingTest {

    public DistanceScalingTest() { return; }

    static #Tensor<float64> fivePoints() {
        float64[] d = heap float64[10];
        d[0] = 0.0; d[1] = 0.0;
        d[2] = 3.0; d[3] = 4.0;
        d[4] = -1.0; d[5] = 2.0;
        d[6] = 5.0; d[7] = -2.0;
        d[8] = 0.5; d[9] = 0.5;
        int64[] sh = heap int64[2];
        sh[0] = 5;
        sh[1] = 2;
        return Tensor.of<float64>(d, sh);
    }

    static void symmetricZeroDiag(Tensor<float64> m, int64 n) {
        int64 i = 0;
        while (i < n) {
            Assert.isTrue(m.get2(i, i) == 0.0);
            int64 j = 0;
            while (j < n) {
                Assert.isTrue(m.get2(i, j) == m.get2(j, i));
                j = j + 1;
            }
            i = i + 1;
        }
    }

    // 2.1.1 — every §2.1 metric flows through the ONE seam (`Metric`), and
    // the pairwise matrix keeps §2.2's guarantees from this consumer side.
    @Test
    public void everyMetricWorksThroughTheOneSeam() {
        Tensor<float64> x = DistanceScalingTest.fivePoints();
        Metric e = heap Euclidean();
        Metric ma = heap Manhattan();
        Metric ch = heap Chebyshev();
        Metric mk = heap Minkowski(3.0);
        Metric co = heap Cosine();
        Tensor<float64> de = Distance.pdist(x, e);
        DistanceScalingTest.symmetricZeroDiag(de, (int64) 5);
        Tensor<float64> dm = Distance.pdist(x, ma);
        DistanceScalingTest.symmetricZeroDiag(dm, (int64) 5);
        Tensor<float64> dc = Distance.pdist(x, ch);
        DistanceScalingTest.symmetricZeroDiag(dc, (int64) 5);
        Tensor<float64> dk = Distance.pdist(x, mk);
        DistanceScalingTest.symmetricZeroDiag(dk, (int64) 5);
        Tensor<float64> dco = Distance.pdist(x, co);
        DistanceScalingTest.symmetricZeroDiag(dco, (int64) 5);
        // Spot values: (0,0)->(3,4) — euclidean 5, manhattan 7, chebyshev 4.
        Assert.isTrue(Fixtures.close(de.get2(0, 1), 5.0, 0.0000000001));
        Assert.isTrue(Fixtures.close(dm.get2(0, 1), 7.0, 0.0000000001));
        Assert.isTrue(Fixtures.close(dc.get2(0, 1), 4.0, 0.0000000001));
    }

    // §2.3 — cross-distances between two different sets.
    @Test
    public void crossDistancesAreAvailable() {
        Tensor<float64> x = DistanceScalingTest.fivePoints();
        float64[] d = heap float64[4];
        d[0] = 1.0; d[1] = 1.0;
        d[2] = -2.0; d[3] = 0.0;
        int64[] sh = heap int64[2];
        sh[0] = 2;
        sh[1] = 2;
        Tensor<float64> y = Tensor.of<float64>(d, sh);
        Metric e = heap Euclidean();
        Tensor<float64> c = Distance.cdist(x, y, e);
        Assert.equals((int64) 5, c.shapeAt(0));
        Assert.equals((int64) 2, c.shapeAt(1));
        Assert.isTrue(Fixtures.close(c.get2(0, 0),
            Math.sqrt(2.0), 0.0000000001));
    }

    // §2.4 — zero-norm cosine is defined, not a division by zero.
    @Test
    public void zeroNormCosineIsDefined() {
        float64[] d = heap float64[4];
        d[0] = 0.0; d[1] = 0.0;
        d[2] = 1.0; d[3] = 0.0;
        int64[] sh = heap int64[2];
        sh[0] = 2;
        sh[1] = 2;
        Tensor<float64> x = Tensor.of<float64>(d, sh);
        Metric co = heap Cosine();
        Tensor<float64> m = Distance.pdist(x, co);
        float64 v = m.get2(0, 1);
        Assert.isTrue(v == v);          // not NaN — defined
    }

    // 2.1.3 / 2.1.4 — the scaler formulas (§3.1, §3.2), expected as-is.
    @Test
    public void scalerFormulasHold() {
        Tensor<float64> x = DistanceScalingTest.fivePoints();
        MinMaxScaler mm = heap MinMaxScaler();
        mm.fit(x, x);
        Tensor<float64> xm = mm.transform(x);
        int64 i = 0;
        while (i < 5) {
            Assert.isTrue(xm.get2(i, 0) >= 0.0 && xm.get2(i, 0) <= 1.0);
            Assert.isTrue(xm.get2(i, 1) >= 0.0 && xm.get2(i, 1) <= 1.0);
            i = i + 1;
        }
        StandardScaler st = heap StandardScaler();
        st.fit(x, x);
        Tensor<float64> xs = st.transform(x);
        float64 mean = 0.0;
        i = 0;
        while (i < 5) {
            mean = mean + xs.get2(i, 0);
            i = i + 1;
        }
        Assert.isTrue(Fixtures.close(mean / 5.0, 0.0, 0.0000000001));
    }

    // 2.1.5 — a constant feature does not divide by zero (§3.3).
    @Test
    public void constantFeatureDoesNotDivideByZero() {
        float64[] d = heap float64[6];
        d[0] = 2.0; d[1] = 7.0;
        d[2] = 2.0; d[3] = 8.0;
        d[4] = 2.0; d[5] = 9.0;
        int64[] sh = heap int64[2];
        sh[0] = 3;
        sh[1] = 2;
        Tensor<float64> x = Tensor.of<float64>(d, sh);
        MinMaxScaler mm = heap MinMaxScaler();
        mm.fit(x, x);
        Tensor<float64> xm = mm.transform(x);
        StandardScaler st = heap StandardScaler();
        st.fit(x, x);
        Tensor<float64> xs = st.transform(x);
        int64 i = 0;
        while (i < 3) {
            float64 a = xm.get2(i, 0);
            float64 b = xs.get2(i, 0);
            Assert.isTrue(a == a);
            Assert.isTrue(b == b);
            i = i + 1;
        }
    }

    // 2.1.6 — on the mixed-unit fixture, unscaled clustering differs from
    // scaled (§3.4): the gram axis swamps the kilometre axis until
    // standardization equalizes them. Scale sensitivity is thereby a
    // demonstrated fact in this suite, not only a docs sentence.
    @Test
    public void unscaledMixedUnitsClusterDifferently() {
        Tensor<float64> x = Shapes.mixedUnits((uint64) 23);
        int64[] esh = heap int64[1];
        esh[0] = 40;
        Tensor<float64> yIgnored = Tensor.zeros<float64>(esh);
        KMeans raw = heap KMeans((int64) 2, (uint64) 6);
        raw.fit(x, yIgnored);
        StandardScaler st = heap StandardScaler();
        st.fit(x, x);
        Tensor<float64> xs = st.transform(x);
        KMeans scaled = heap KMeans((int64) 2, (uint64) 6);
        scaled.fit(xs, yIgnored);
        Tensor<float64> lr = raw.labels();
        Tensor<float64> ls = scaled.labels();
        int64[] a = heap int64[40];
        int64[] b = heap int64[40];
        int64 i = 0;
        while (i < 40) {
            a[i] = (int64) lr.get1(i);
            b[i] = (int64) ls.get1(i);
            i = i + 1;
        }
        int64[] truth = Shapes.mixedUnitLabels();
        float64 rawScore = Harness.randIndex(a, truth);
        float64 scaledScore = Harness.randIndex(b, truth);
        // Same algorithm, same seed — only scaling changed. Scaled recovers
        // the kilometre grouping exactly; unscaled follows the gram noise.
        // (Seed 6 chosen from a recorded sweep: single-init k-means can
        // stick in the split-the-noise-axis local optimum sklearn escapes
        // via n_init; seeds 6/7/11/12 all converge to the true grouping.)
        Assert.isTrue(scaledScore == 1.0);
        Assert.isTrue(rawScore < 0.9);
        Assert.isTrue(Harness.randIndex(a, b) < 1.0);
    }
}
