package dev.cajeta.ml.selftest;

import cajeta.lang.System;
import cajeta.math.Tensor;
import cajeta.xpu.Device;
import dev.cajeta.ml.kernels.Gemm;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.grad.Op;
import dev.cajeta.ml.grad.Ops;
import dev.cajeta.ml.nn.MultiheadAttention;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.zoo.SmallCnn;

/**
 * cajeta-ml-gpu 29.1.1 (spec §6.6): the backward column. For each op, `tape.backward` on
 * device leaves yields the CPU column's gradients within 1e-4 relative.
 */
public class GradBackGpuTest {
    public GradBackGpuTest() { return; }

    static #Tensor<float32> fill(int64[] shape, int64 seed, boolean positive) {
        Tensor<float32> t #= Tensor.full<float32>(shape, 0.0f);
        int64 n = t.size();
        int64 f = 0;
        while (f < n) {
            float32 v = (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f;
            if (positive) { v = v + 1.6f; }
            t.flatSet(f, v);
            f = f + 1;
        }
        return #t;
    }

    static #Tensor<float32> onDevice(Tensor<float32> t) {
        Tensor<float32> d #= t.copy();
        d.gpu();
        return #d;
    }

    static void sameGrad(String what, Tensor<float32> want, Tensor<float32> got) {
        Assert.isTrue(got.isOnGpu());
        got.cpu();
        Assert.equals(want.size(), got.size());
        int64 i = 0;
        while (i < want.size()) {
            float64 w = (float64) want.flatGet(i);
            float64 g = (float64) got.flatGet(i);
            float64 d = g - w;
            if (d < 0.0) { d = 0.0 - d; }
            float64 aw = w;
            if (aw < 0.0) { aw = 0.0 - aw; }
            if (!(d <= 1.0e-4 * (aw + 1.0))) {
                System.stdout.println("  " + what + " grad [" + i + "] device " + g + " cpu " + w);
                Assert.isTrue(false);
            }
            i = i + 1;
        }
    }

    static GradTensor apply1(GradTape<float32> t, int32 op, GradTensor a, int32 axis, float32 c) {
        if (op == Op.RELU) { return t.relu(a); }
        if (op == Op.NEG) { return t.neg(a); }
        if (op == Op.EXP) { return t.exp(a); }
        if (op == Op.LOG) { return t.log(a); }
        if (op == Op.SQRT) { return t.sqrt(a); }
        if (op == Op.TANH) { return t.tanh(a); }
        if (op == Op.SIGMOID) { return t.sigmoid(a); }
        if (op == Op.GELU) { return t.gelu(a); }
        if (op == Op.SOFTMAX) { return t.softmax(a); }
        if (op == Op.LOGSOFTMAX) { return t.logSoftmax(a); }
        if (op == Op.POWS) { return t.powScalar(a, c); }
        if (op == Op.ROWNORM) { return t.rowNorm(a); }
        if (op == Op.SUM) { return t.sum(a); }
        if (op == Op.MEAN) { return t.mean(a); }
        if (op == Op.SUMAXIS) { return t.sumAxis(a, axis); }
        if (op == Op.MEANAXIS) { return t.meanAxis(a, axis); }
        if (op == Op.MAXAXIS) { return t.maxAxis(a, axis); }
        if (op == Op.TRANSPOSE) { return t.transpose2d(a); }
        if (op == Op.TRANSPOSEB) { return t.transposeBatch(a); }
        if (op == Op.PERMUTE) { int32[] perm = [2, 0, 1]; return t.permute(a, perm); }
        if (op == Op.RESHAPE) { int64[] sh = [7L, 3L]; return t.reshape(a, sh); }
        if (op == Op.SLICE) { return t.slice(a, axis, 1L, 3L); }
        return a;
    }

    static void unary(String what, int32 op, Tensor<float32> a, int32 axis, float32 c) {
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor y = GradBackGpuTest.apply1(t, op, la, axis, c);
        t.backward(y);
        Tensor<float32> want = t.gradOf(la);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor ld = d.leaf(ad, true);
        GradTensor yd = GradBackGpuTest.apply1(d, op, ld, axis, c);
        d.backward(yd);
        GradBackGpuTest.sameGrad(what, want, d.gradOf(ld));
    }

    /**
     * A cotangent exists only once something reaches it: backward zero-filled one for every
     * node up front and added each first contribution to it, 30 fills and as many adds of
     * 16 MB a step in cuda's transformer-block-train (cajeta-ml-gpu 28.2.8). Eight tanh
     * nodes now cost the seed's one fill, the gradients still match the cpu, and a leaf
     * nothing reaches reads as zeros.
     */
    @Test
    public void backwardFillsOnlyTheSeedAndALeafNothingReachesReadsZero() {
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 3L, false);
        Tensor<float32> u #= GradBackGpuTest.fill(s, 9L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor y = la;
        int32 i = 0;
        while (i < 8) { y = t.tanh(y); i = i + 1; }
        t.backward(y);
        Tensor<float32> want = t.gradOf(la);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        Tensor<float32> ud #= GradBackGpuTest.onDevice(u);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor ld = d.leaf(ad, true);
        GradTensor lu = d.leaf(ud, true);
        GradTensor yd = ld;
        i = 0;
        while (i < 8) { yd = d.tanh(yd); i = i + 1; }
        int64 before = Device.kernelLaunchCount("fill_float32");
        d.backward(yd);
        int64 fills = Device.kernelLaunchCount("fill_float32") - before;
        System.stdout.println("  backward fills: " + fills);
        Assert.isTrue(fills <= 1L);
        GradBackGpuTest.sameGrad("tanh x8", want, d.gradOf(ld));
        Tensor<float32> zu = d.gradOf(lu);
        Assert.isTrue(zu.isOnGpu());
        zu.cpu();
        Assert.equals(u.size(), zu.size());
        int64 k = 0;
        while (k < zu.size()) { Assert.isTrue(zu.flatGet(k) == 0.0f); k = k + 1; }
    }

    @Test
    public void elementwiseAndRowBackwardsMatchTheCpu() {
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 3L, false);
        Tensor<float32> p #= GradBackGpuTest.fill(s, 5L, true);
        GradBackGpuTest.unary("relu", Op.RELU, a, 0, 0.0f);
        GradBackGpuTest.unary("neg", Op.NEG, a, 0, 0.0f);
        GradBackGpuTest.unary("exp", Op.EXP, a, 0, 0.0f);
        GradBackGpuTest.unary("log", Op.LOG, p, 0, 0.0f);
        GradBackGpuTest.unary("sqrt", Op.SQRT, p, 0, 0.0f);
        GradBackGpuTest.unary("tanh", Op.TANH, a, 0, 0.0f);
        GradBackGpuTest.unary("sigmoid", Op.SIGMOID, a, 0, 0.0f);
        GradBackGpuTest.unary("gelu", Op.GELU, a, 0, 0.0f);
        GradBackGpuTest.unary("softmax", Op.SOFTMAX, a, 0, 0.0f);
        GradBackGpuTest.unary("logSoftmax", Op.LOGSOFTMAX, a, 0, 0.0f);
        GradBackGpuTest.unary("powScalar 3", Op.POWS, a, 0, 3.0f);
        GradBackGpuTest.unary("powScalar 2.5", Op.POWS, p, 0, 2.5f);
        GradBackGpuTest.unary("rowNorm", Op.ROWNORM, a, 0, 0.0f);
    }

    @Test
    public void reductionAndShapeBackwardsMatchTheCpu() {
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 7L, false);
        GradBackGpuTest.unary("sum", Op.SUM, a, 0, 0.0f);
        GradBackGpuTest.unary("mean", Op.MEAN, a, 0, 0.0f);
        GradBackGpuTest.unary("sumAxis 0", Op.SUMAXIS, a, 0, 0.0f);
        GradBackGpuTest.unary("sumAxis 1", Op.SUMAXIS, a, 1, 0.0f);
        GradBackGpuTest.unary("meanAxis 0", Op.MEANAXIS, a, 0, 0.0f);
        GradBackGpuTest.unary("meanAxis 1", Op.MEANAXIS, a, 1, 0.0f);
        GradBackGpuTest.unary("maxAxis 0", Op.MAXAXIS, a, 0, 0.0f);
        GradBackGpuTest.unary("maxAxis 1", Op.MAXAXIS, a, 1, 0.0f);
        GradBackGpuTest.unary("transpose", Op.TRANSPOSE, a, 0, 0.0f);
        GradBackGpuTest.unary("reshape", Op.RESHAPE, a, 0, 0.0f);
        GradBackGpuTest.unary("slice axis 0", Op.SLICE, a, 0, 0.0f);
        GradBackGpuTest.unary("slice axis 1", Op.SLICE, a, 1, 0.0f);
        int64[] s3 = [3L, 7L, 5L];
        Tensor<float32> t3 #= GradBackGpuTest.fill(s3, 11L, false);
        GradBackGpuTest.unary("transposeBatch", Op.TRANSPOSEB, t3, 0, 0.0f);
        GradBackGpuTest.unary("permute", Op.PERMUTE, t3, 0, 0.0f);
        GradBackGpuTest.unary("sumAxis -1 rank 3", Op.SUMAXIS, t3, -1, 0.0f);
        GradBackGpuTest.unary("meanAxis 1 rank 3", Op.MEANAXIS, t3, 1, 0.0f);
    }

    static GradTensor apply2(GradTape<float32> t, int32 op, GradTensor a, GradTensor b, int32 axis) {
        if (op == Op.ADD) { return t.add(a, b); }
        if (op == Op.SUB) { return t.sub(a, b); }
        if (op == Op.MUL) { return t.mul(a, b); }
        if (op == Op.DIV) { return t.div(a, b); }
        if (op == Op.MATMUL) { return t.matmul(a, b); }
        if (op == Op.MATMULB) { return t.matmulBatched(a, b); }
        if (op == Op.CONCAT) { return t.concat(a, b, axis); }
        return a;
    }

    static void binary(String what, int32 op, Tensor<float32> a, Tensor<float32> b, int32 axis) {
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor lb = t.leaf(b, true);
        GradTensor y = GradBackGpuTest.apply2(t, op, la, lb, axis);
        t.backward(y);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor lda = d.leaf(ad, true);
        GradTensor ldb = d.leaf(bd, true);
        GradTensor yd = GradBackGpuTest.apply2(d, op, lda, ldb, axis);
        d.backward(yd);
        GradBackGpuTest.sameGrad(what + " dA", t.gradOf(la), d.gradOf(lda));
        GradBackGpuTest.sameGrad(what + " dB", t.gradOf(lb), d.gradOf(ldb));
    }

    static void linear(String what, int32 act, Tensor<float32> x, Tensor<float32> w, Tensor<float32> b) {
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lx = t.leaf(x, true);
        GradTensor lw = t.leaf(w, true);
        GradTensor lb = t.leaf(b, true);
        GradTensor y = t.linear(lx, lw, lb, act);
        t.backward(y);
        Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
        Tensor<float32> wd #= GradBackGpuTest.onDevice(w);
        Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor ldx = d.leaf(xd, true);
        GradTensor ldw = d.leaf(wd, true);
        GradTensor ldb = d.leaf(bd, true);
        GradTensor yd = d.linear(ldx, ldw, ldb, act);
        d.backward(yd);
        GradBackGpuTest.sameGrad(what + " value", t.valueOf(y), Ops.copyOf<float32>(d.valueOf(yd)));
        GradBackGpuTest.sameGrad(what + " dX", t.gradOf(lx), d.gradOf(ldx));
        GradBackGpuTest.sameGrad(what + " dW", t.gradOf(lw), d.gradOf(ldw));
        GradBackGpuTest.sameGrad(what + " dB", t.gradOf(lb), d.gradOf(ldb));
    }

    /** cajeta-ml-gpu 28.2.5: the fused linear node's one-launch forward and its VJP on the device. */
    @Test
    public void linearBackwardMatchesTheCpu() {
        int64[] xs = [3L, 70L];
        int64[] ws = [70L, 5L];
        int64[] bs = [1L, 5L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 23L, false);
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 29L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(bs, 31L, false);
        GradBackGpuTest.linear("linear", 0, x, w, b);
        GradBackGpuTest.linear("linear relu", 1, x, w, b);
    }

    /**
     * A weight gradient X^T . G at a shape that splits K reads X in place through the
     * transposed-A split member, where it runs, instead of materializing X^T (16 to 64 MB a
     * call in transformer-block-train, cajeta-ml-gpu 28.2.8); linear and matmul alike, the
     * gradients matching the cpu tape.
     */
    @Test
    public void aWeightGradientReadsItsActivationsInPlace() {
        int64[] xs = [2048L, 128L];
        int64[] ws = [128L, 128L];
        int64[] bs = [1L, 128L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 23L, false);
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 29L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(bs, 31L, false);
        String tn #= Gemm.splitTNMember();
        int64 tn0 = Device.kernelLaunchCount(tn);
        GradBackGpuTest.linear("linear, split K", 0, x, w, b);
        GradBackGpuTest.binary("matmul, split K", Op.MATMUL, x, w, 0);
        if (Gemm.splitTNRuns()) {
            Assert.isTrue(Device.kernelLaunchCount(tn) >= tn0 + 2L);
        }
    }

    /**
     * The tape's reshape node is a view on the device, forward and backward: its input's
     * value and its own cotangent both live as long as the tape, so the view cannot
     * outlive what it borrows. Each one copied the whole tensor, 18 of the 28 copies of
     * 16 MB a step in transformer-block-train (cajeta-ml-gpu 28.2.8). No copy launches
     * across the forward and the backward, and the gradient still matches the cpu tape.
     */
    @Test
    public void aTapeReshapeIsAViewForwardAndBackward() {
        int64[] s = [6L, 8L];
        int64[] r = [3L, 16L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 37L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor y = t.tanh(t.reshape(t.tanh(la), r));
        t.backward(y);
        Tensor<float32> want = t.gradOf(la);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor ld = d.leaf(ad, true);
        int64 before = Device.kernelLaunchCount("copy_float32");
        GradTensor yd = d.tanh(d.reshape(d.tanh(ld), r));
        d.backward(yd);
        int64 copies = Device.kernelLaunchCount("copy_float32") - before;
        System.stdout.println("  tape reshape copies: " + copies);
        Assert.equals(0L, copies);
        GradBackGpuTest.sameGrad("tape reshape view", want, d.gradOf(ld));
    }

    /**
     * Attention's batched products read their operands in place on the device: q . k^T takes
     * the keys as stored, and a batched product's backward takes its operands as stored, so
     * neither direction transposes. Each transpose copied a whole score or head tensor, six a
     * step in transformer-block-train (cajeta-ml-gpu 28.2.8). No strided copy launches across
     * the forward and the backward, and both gradients still match the cpu tape.
     */
    @Test
    public void attentionProductsReadTheirOperandsInPlace() {
        int64[] qs = [4L, 9L, 6L];
        int64[] ks = [4L, 11L, 6L];
        Tensor<float32> q #= GradBackGpuTest.fill(qs, 41L, false);
        Tensor<float32> k #= GradBackGpuTest.fill(ks, 43L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lq = t.leaf(q, true);
        GradTensor lk = t.leaf(k, true);
        GradTensor s = t.tanh(t.matmulBatched(lq, t.transposeBatch(lk)));
        GradTensor y = t.tanh(t.matmulBatched(s, lk));
        t.backward(y);
        Tensor<float32> wantQ = t.gradOf(lq);
        Tensor<float32> wantK = t.gradOf(lk);
        Tensor<float32> qd #= GradBackGpuTest.onDevice(q);
        Tensor<float32> kd #= GradBackGpuTest.onDevice(k);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dq = d.leaf(qd, true);
        GradTensor dk = d.leaf(kd, true);
        int64 before = Device.kernelLaunchCount("strided_float32") + Device.kernelLaunchCount("stridedTile_float32");
        GradTensor sd = d.tanh(d.matmulBatchedNT(dq, dk, 1.0f));
        GradTensor yd = d.tanh(d.matmulBatched(sd, dk));
        d.backward(yd);
        int64 copies = Device.kernelLaunchCount("strided_float32") + Device.kernelLaunchCount("stridedTile_float32") - before;
        System.stdout.println("  attention transposes: " + copies);
        Assert.equals(0L, copies);
        GradBackGpuTest.sameGrad("q . k^T, q", wantQ, d.gradOf(dq));
        GradBackGpuTest.sameGrad("q . k^T, k", wantK, d.gradOf(dk));
    }

    /**
     * The head products read q, k and v where their heads sit in the (B·T, E) projections
     * and write the context straight into merged rows, forward and backward, so on the device
     * they copy nothing. The split and merge they replace were eight strided copies of a whole
     * activation a step in transformer-block-train (cajeta-ml-gpu 28.2.8). 2 sequences of 5
     * queries and 7 keys, 3 heads of width 4, alpha 0.5: no strided launches, and every
     * gradient matches the cpu tape's split, batched-product and merge form.
     */
    @Test
    public void headProductsCopyNothing() {
        int64[] qs = [10L, 12L];
        int64[] ks = [14L, 12L];
        Tensor<float32> q #= GradBackGpuTest.fill(qs, 67L, false);
        Tensor<float32> k #= GradBackGpuTest.fill(ks, 71L, false);
        Tensor<float32> v #= GradBackGpuTest.fill(ks, 73L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lq = t.leaf(q, true);
        GradTensor lk = t.leaf(k, true);
        GradTensor lv = t.leaf(v, true);
        int64[] sq = [2L, 5L, 3L, 4L];
        int64[] sk = [2L, 7L, 3L, 4L];
        int32[] perm = [0, 2, 1, 3];
        int64[] hq = [6L, 5L, 4L];
        int64[] hk = [6L, 7L, 4L];
        GradTensor qh = t.reshape(t.permute(t.reshape(lq, sq), perm), hq);
        GradTensor kh = t.reshape(t.permute(t.reshape(lk, sk), perm), hk);
        GradTensor vh = t.reshape(t.permute(t.reshape(lv, sk), perm), hk);
        GradTensor ph = t.softmax(t.matmulBatchedNT(qh, kh, 0.5f));
        int64[] m4 = [2L, 3L, 5L, 4L];
        int64[] m2 = [10L, 12L];
        GradTensor o = t.reshape(t.permute(t.reshape(t.matmulBatched(ph, vh), m4), perm), m2);
        t.backward(t.tanh(o));
        Tensor<float32> wantQ = t.gradOf(lq);
        Tensor<float32> wantK = t.gradOf(lk);
        Tensor<float32> wantV = t.gradOf(lv);
        Tensor<float32> qd #= GradBackGpuTest.onDevice(q);
        Tensor<float32> kd #= GradBackGpuTest.onDevice(k);
        Tensor<float32> vd #= GradBackGpuTest.onDevice(v);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dq = d.leaf(qd, true);
        GradTensor dk = d.leaf(kd, true);
        GradTensor dv = d.leaf(vd, true);
        int64 before = Device.kernelLaunchCount("strided_float32") + Device.kernelLaunchCount("stridedTile_float32");
        GradTensor pd = d.softmax(d.headScores(dq, dk, 2L, 3, 0.5f));
        d.backward(d.tanh(d.headContext(pd, dv, 3)));
        int64 copies = Device.kernelLaunchCount("strided_float32") + Device.kernelLaunchCount("stridedTile_float32") - before;
        System.stdout.println("  head product copies: " + copies);
        Assert.equals(0L, copies);
        GradBackGpuTest.sameGrad("head products, q", wantQ, d.gradOf(dq));
        GradBackGpuTest.sameGrad("head products, k", wantK, d.gradOf(dk));
        GradBackGpuTest.sameGrad("head products, v", wantV, d.gradOf(dv));
    }

    /**
     * MultiheadAttention takes its heads through the head products, so the split and merge
     * copy nothing. Cross-attention under a mask, 2 sequences of 5 queries and 7 keys, 3 heads
     * of width 4: the strided launches across the forward and backward fall from 16 to the
     * projections' own 8 (each Linear's backward transposes its weight, and at these few rows
     * its input too, since tiledTN takes only split shapes), and both inputs' gradients match
     * the cpu tape (cajeta-ml-gpu 28.2.8).
     */
    @Test
    public void attentionSplitsAndMergesHeadsInPlace() {
        int64[] xs = [2L, 5L, 12L];
        int64[] ms = [2L, 7L, 12L];
        int64[] ks = [2L, 5L, 7L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 59L, false);
        Tensor<float32> mem #= GradBackGpuTest.fill(ms, 61L, false);
        Tensor<float32> mask #= Tensor.zeros<float32>(ks);
        MultiheadAttention host = heap MultiheadAttention(12L, 3, 17L);
        GradTape<float32> t = heap GradTape<float32>();
        host.bindParameters(t);
        GradTensor lx = t.leaf(x, true);
        GradTensor lm = t.leaf(mem, true);
        GradTensor y = t.tanh(host.forwardCross(t, lx, lm, mask));
        t.backward(y);
        Tensor<float32> wantX = t.gradOf(lx);
        Tensor<float32> wantM = t.gradOf(lm);
        MultiheadAttention dev = heap MultiheadAttention(12L, 3, 17L);
        dev.toDevice();
        Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
        Tensor<float32> md #= GradBackGpuTest.onDevice(mem);
        GradTape<float32> d = heap GradTape<float32>();
        dev.bindParameters(d);
        GradTensor dx = d.leaf(xd, true);
        GradTensor dm = d.leaf(md, true);
        int64 before = Device.kernelLaunchCount("strided_float32") + Device.kernelLaunchCount("stridedTile_float32");
        GradTensor yd = d.tanh(dev.forwardCross(d, dx, dm, mask));
        d.backward(yd);
        int64 copies = Device.kernelLaunchCount("strided_float32") + Device.kernelLaunchCount("stridedTile_float32") - before;
        System.stdout.println("  attention strided copies: " + copies);
        Assert.equals(8L, copies);
        GradBackGpuTest.sameGrad("attention, queries", wantX, d.gradOf(dx));
        GradBackGpuTest.sameGrad("attention, memory", wantM, d.gradOf(dm));
    }

    /**
     * A same-shape add hands its cotangent to an intermediate input as a view on the device:
     * the cotangent lives as long as the tape and a later contribution adds into a new
     * tensor. A residual add copied the whole activation twice, four of the ten 16 MB copies
     * a step in transformer-block-train (cajeta-ml-gpu 28.2.8). A leaf still gets its own
     * copy, since the caller may move its gradient to the host (binaryBackwardsMatchTheCpu's
     * plain add does). One copy across the backward, the leaf `b`'s, and the gradients still
     * match the cpu tape, including an input that a second path reaches.
     */
    @Test
    public void aSameShapeAddPassesItsCotangentThrough() {
        int64[] s = [6L, 8L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 47L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(s, 53L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor lb = t.leaf(b, true);
        GradTensor ta = t.tanh(la);
        GradTensor y = t.tanh(t.add(t.add(ta, lb), ta));
        t.backward(y);
        Tensor<float32> wantA = t.gradOf(la);
        Tensor<float32> wantB = t.gradOf(lb);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor da = d.leaf(ad, true);
        GradTensor db = d.leaf(bd, true);
        GradTensor tad = d.tanh(da);
        GradTensor yd = d.tanh(d.add(d.add(tad, db), tad));
        int64 before = Device.kernelLaunchCount("copy_float32");
        d.backward(yd);
        int64 copies = Device.kernelLaunchCount("copy_float32") - before;
        System.stdout.println("  same-shape add copies: " + copies);
        Assert.equals(1L, copies);
        GradBackGpuTest.sameGrad("residual add, a", wantA, d.gradOf(da));
        GradBackGpuTest.sameGrad("residual add, b", wantB, d.gradOf(db));
    }

    /**
     * A same-shape product, quotient or difference moves the contribution it just computed
     * into its input's cotangent: the tensor is the backward's own, so taking it costs
     * nothing, where sumTo copied it once more before keeping it (cajeta-ml-gpu 28.2.8).
     * No copy launches across the backward of mul, div and sub over two leaves, and the
     * gradients still match the cpu tape.
     */
    @Test
    public void aSameShapeProductKeepsTheContributionItComputed() {
        int64[] s = [6L, 8L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 59L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(s, 61L, true);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor lb = t.leaf(b, true);
        GradTensor y = t.tanh(t.sub(t.mul(la, lb), t.div(la, lb)));
        t.backward(y);
        Tensor<float32> wantA = t.gradOf(la);
        Tensor<float32> wantB = t.gradOf(lb);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor da = d.leaf(ad, true);
        GradTensor db = d.leaf(bd, true);
        GradTensor yd = d.tanh(d.sub(d.mul(da, db), d.div(da, db)));
        int64 before = Device.kernelLaunchCount("copy_float32");
        d.backward(yd);
        int64 copies = Device.kernelLaunchCount("copy_float32") - before;
        System.stdout.println("  same-shape product copies: " + copies);
        Assert.equals(0L, copies);
        GradBackGpuTest.sameGrad("mul, div, sub, a", wantA, d.gradOf(da));
        GradBackGpuTest.sameGrad("mul, div, sub, b", wantB, d.gradOf(db));
    }

    /**
     * A broadcast VJP reduces its cotangent in place: sumTo copied the whole cotangent before
     * its first reduction, one 16 MB copy for every Linear's bias gradient in
     * transformer-block-train and a 64 MB one for the feed-forward's (cajeta-ml-gpu 28.2.8).
     * No copy launch summing a 6 x 8 cotangent down to a row, and the sums match the host,
     * also for a leading axis the target does not have.
     */
    @Test
    public void aBroadcastSumReadsItsCotangentInPlace() {
        int64[] gs = [6L, 8L];
        int64[] row = [1L, 8L];
        int64[] flat = [8L];
        Tensor<float32> g #= GradBackGpuTest.fill(gs, 67L, false);
        Tensor<float32> likeRow #= Tensor.zeros<float32>(row);
        Tensor<float32> likeFlat #= Tensor.zeros<float32>(flat);
        Tensor<float32> wantRow #= Tensor.sumTo<float32>(g, likeRow);
        Tensor<float32> wantFlat #= Tensor.sumTo<float32>(g, likeFlat);
        Tensor<float32> gd #= GradBackGpuTest.onDevice(g);
        Tensor<float32> rowD #= GradBackGpuTest.onDevice(likeRow);
        Tensor<float32> flatD #= GradBackGpuTest.onDevice(likeFlat);
        int64 before = Device.kernelLaunchCount("copy_float32");
        Tensor<float32> gotRow #= Ops.sumTo<float32>(gd, rowD);
        int64 copies = Device.kernelLaunchCount("copy_float32") - before;
        System.stdout.println("  broadcast sum copies: " + copies);
        Assert.equals(0L, copies);
        GradBackGpuTest.sameGrad("sumTo row", wantRow, gotRow);
        Tensor<float32> gotFlat #= Ops.sumTo<float32>(gd, flatD);
        GradBackGpuTest.sameGrad("sumTo leading axis", wantFlat, gotFlat);
    }

    /**
     * Attention's scaled scores are one node: q . k^T times a constant, the scale taken in the
     * batched tile forward and backward instead of two passes over the score tensor
     * (cajeta-ml-gpu 28.2.8). Against the cpu tape's product, transpose and constant multiply,
     * with no elementwise multiply launched on the device.
     */
    @Test
    public void scaledAttentionScoresAreOneNode() {
        int64[] qs = [3L, 9L, 6L];
        int64[] ks = [3L, 11L, 6L];
        int64[] one = [1L];
        Tensor<float32> q #= GradBackGpuTest.fill(qs, 71L, false);
        Tensor<float32> k #= GradBackGpuTest.fill(ks, 73L, false);
        Tensor<float32> sc #= Tensor.full<float32>(one, 0.25f);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lq = t.leaf(q, true);
        GradTensor lk = t.leaf(k, true);
        GradTensor ls = t.leaf(sc, false);
        GradTensor y = t.tanh(t.mul(t.matmulBatched(lq, t.transposeBatch(lk)), ls));
        t.backward(y);
        Tensor<float32> wantQ = t.gradOf(lq);
        Tensor<float32> wantK = t.gradOf(lk);
        Tensor<float32> qd #= GradBackGpuTest.onDevice(q);
        Tensor<float32> kd #= GradBackGpuTest.onDevice(k);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dq = d.leaf(qd, true);
        GradTensor dk = d.leaf(kd, true);
        int64 before = Device.kernelLaunchCount("arithBroadcast_float32") + Device.kernelLaunchCount("arith_float32");
        GradTensor yd = d.tanh(d.matmulBatchedNT(dq, dk, 0.25f));
        d.backward(yd);
        int64 muls = Device.kernelLaunchCount("arithBroadcast_float32") + Device.kernelLaunchCount("arith_float32") - before;
        System.stdout.println("  score scale passes: " + muls);
        Assert.equals(0L, muls);
        GradBackGpuTest.sameGrad("scaled scores, q", wantQ, d.gradOf(dq));
        GradBackGpuTest.sameGrad("scaled scores, k", wantK, d.gradOf(dk));
    }

    @Test
    public void binaryBackwardsMatchTheCpu() {
        int64[] s = [3L, 7L];
        int64[] row = [1L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 13L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(s, 17L, true);
        Tensor<float32> r #= GradBackGpuTest.fill(row, 19L, true);
        GradBackGpuTest.binary("add", Op.ADD, a, b, 0);
        GradBackGpuTest.binary("sub", Op.SUB, a, b, 0);
        GradBackGpuTest.binary("mul", Op.MUL, a, b, 0);
        GradBackGpuTest.binary("div", Op.DIV, a, b, 0);
        GradBackGpuTest.binary("add broadcast", Op.ADD, a, r, 0);
        GradBackGpuTest.binary("mul broadcast", Op.MUL, a, r, 0);
        GradBackGpuTest.binary("div broadcast", Op.DIV, a, r, 0);
        GradBackGpuTest.binary("concat axis 0", Op.CONCAT, a, b, 0);
        GradBackGpuTest.binary("concat axis 1", Op.CONCAT, a, b, 1);
        int64[] ws = [7L, 5L];
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 23L, false);
        GradBackGpuTest.binary("matmul", Op.MATMUL, a, w, 0);
        int64[] ba = [2L, 3L, 7L];
        int64[] bb = [2L, 7L, 5L];
        Tensor<float32> xa #= GradBackGpuTest.fill(ba, 29L, false);
        Tensor<float32> xb #= GradBackGpuTest.fill(bb, 31L, false);
        GradBackGpuTest.binary("matmulBatched", Op.MATMULB, xa, xb, 0);
    }

    static #Tensor<float32> ids(int64 n, int64 vocab, int64 step) {
        int64[] sh = [n];
        Tensor<float32> t #= Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < n) { t.flatSet(i, (float32) ((i * step) % vocab)); i = i + 1; }
        return #t;
    }

    @Test
    public void convAndPoolBackwardsMatchTheCpu() {
        int64[] xs = [2L, 3L, 6L, 6L];
        int64[] ws = [4L, 3L, 3L, 3L];
        int64[] bs = [4L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 41L, false);
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 43L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(bs, 47L, false);
        int32 cs = 0;
        while (cs < 2) {
            int32 stride = 1 + cs;
            int32 pad = 1 - cs;
            GradTape<float32> t = heap GradTape<float32>();
            GradTensor lx = t.leaf(x, true);
            GradTensor lw = t.leaf(w, true);
            GradTensor lb = t.leaf(b, true);
            t.backward(t.conv2d(lx, lw, lb, stride, pad));
            Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
            Tensor<float32> wd #= GradBackGpuTest.onDevice(w);
            Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
            GradTape<float32> d = heap GradTape<float32>();
            GradTensor dx = d.leaf(xd, true);
            GradTensor dw = d.leaf(wd, true);
            GradTensor db = d.leaf(bd, true);
            d.backward(d.conv2d(dx, dw, db, stride, pad));
            GradBackGpuTest.sameGrad("conv2d dx s" + stride, t.gradOf(lx), d.gradOf(dx));
            GradBackGpuTest.sameGrad("conv2d dw s" + stride, t.gradOf(lw), d.gradOf(dw));
            GradBackGpuTest.sameGrad("conv2d db s" + stride, t.gradOf(lb), d.gradOf(db));
            cs = cs + 1;
        }
        // pools, each through a sum so the cotangent is uniform ones
        int32 pk = 0;
        while (pk < 3) {
            GradTape<float32> t = heap GradTape<float32>();
            GradTensor lx = t.leaf(x, true);
            GradTensor y = lx;
            if (pk == 0) { y = t.maxPool2d(lx, 2, 2, 0); }
            if (pk == 1) { y = t.avgPool2d(lx, 3, 1, 1); }
            if (pk == 2) { y = t.adaptiveAvgPool2d(lx, 4, 4); }
            t.backward(y);
            Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
            GradTape<float32> d = heap GradTape<float32>();
            GradTensor dx = d.leaf(xd, true);
            GradTensor yd = dx;
            if (pk == 0) { yd = d.maxPool2d(dx, 2, 2, 0); }
            if (pk == 1) { yd = d.avgPool2d(dx, 3, 1, 1); }
            if (pk == 2) { yd = d.adaptiveAvgPool2d(dx, 4, 4); }
            d.backward(yd);
            GradBackGpuTest.sameGrad("pool " + pk, t.gradOf(lx), d.gradOf(dx));
            pk = pk + 1;
        }
    }

    @Test
    public void normBackwardsMatchTheCpu() {
        int64[] xs = [2L, 3L, 4L, 4L];
        int64[] cs = [3L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 53L, false);
        Tensor<float32> gamma #= GradBackGpuTest.fill(cs, 59L, true);
        Tensor<float32> beta #= GradBackGpuTest.fill(cs, 61L, false);
        Tensor<float32> mean #= GradBackGpuTest.fill(cs, 67L, false);
        Tensor<float32> var #= GradBackGpuTest.fill(cs, 71L, true);
        int32 mode = 0;
        while (mode < 2) {
            GradTape<float32> t = heap GradTape<float32>();
            GradTensor lx = t.leaf(x, true);
            GradTensor lg = t.leaf(gamma, true);
            GradTensor lb = t.leaf(beta, true);
            GradTensor y = lx;
            if (mode == 0) { y = t.batchNorm2dTrain(lx, lg, lb, 0.00001); } else { y = t.batchNorm2dEval(lx, lg, lb, mean, var, 0.00001); }
            t.backward(y);
            Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
            Tensor<float32> gd #= GradBackGpuTest.onDevice(gamma);
            Tensor<float32> bd #= GradBackGpuTest.onDevice(beta);
            Tensor<float32> md #= GradBackGpuTest.onDevice(mean);
            Tensor<float32> vd #= GradBackGpuTest.onDevice(var);
            GradTape<float32> d = heap GradTape<float32>();
            GradTensor dx = d.leaf(xd, true);
            GradTensor dg = d.leaf(gd, true);
            GradTensor db = d.leaf(bd, true);
            GradTensor yd = dx;
            if (mode == 0) { yd = d.batchNorm2dTrain(dx, dg, db, 0.00001); } else { yd = d.batchNorm2dEval(dx, dg, db, md, vd, 0.00001); }
            d.backward(yd);
            GradBackGpuTest.sameGrad("batchNorm2d dx mode " + mode, t.gradOf(lx), d.gradOf(dx));
            GradBackGpuTest.sameGrad("batchNorm2d dgamma mode " + mode, t.gradOf(lg), d.gradOf(dg));
            GradBackGpuTest.sameGrad("batchNorm2d dbeta mode " + mode, t.gradOf(lb), d.gradOf(db));
            mode = mode + 1;
        }
        // layerNorm over the last axis of 6x7
        int64[] ls = [6L, 7L];
        int64[] ds = [7L];
        Tensor<float32> l #= GradBackGpuTest.fill(ls, 73L, false);
        Tensor<float32> lgam #= GradBackGpuTest.fill(ds, 79L, true);
        Tensor<float32> lbet #= GradBackGpuTest.fill(ds, 83L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lx = t.leaf(l, true);
        GradTensor lg = t.leaf(lgam, true);
        GradTensor lb = t.leaf(lbet, true);
        t.backward(t.layerNorm(lx, lg, lb, 0.00001));
        Tensor<float32> ld #= GradBackGpuTest.onDevice(l);
        Tensor<float32> lgd #= GradBackGpuTest.onDevice(lgam);
        Tensor<float32> lbd #= GradBackGpuTest.onDevice(lbet);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dx = d.leaf(ld, true);
        GradTensor dg = d.leaf(lgd, true);
        GradTensor db = d.leaf(lbd, true);
        d.backward(d.layerNorm(dx, dg, db, 0.00001));
        GradBackGpuTest.sameGrad("layerNorm dx", t.gradOf(lx), d.gradOf(dx));
        GradBackGpuTest.sameGrad("layerNorm dgamma", t.gradOf(lg), d.gradOf(dg));
        GradBackGpuTest.sameGrad("layerNorm dbeta", t.gradOf(lb), d.gradOf(db));
    }

    @Test
    public void lossEmbeddingAndDropoutBackwardsMatchTheCpu() {
        // embedding: repeated ids accumulate
        int64[] ws = [5L, 3L];
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 89L, false);
        Tensor<float32> idx #= GradBackGpuTest.ids(7L, 5L, 2L);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lw = t.leaf(w, true);
        t.backward(t.embedding(lw, idx));
        Tensor<float32> wd #= GradBackGpuTest.onDevice(w);
        Tensor<float32> idxD #= GradBackGpuTest.onDevice(idx);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dw = d.leaf(wd, true);
        d.backward(d.embedding(dw, idxD));
        GradBackGpuTest.sameGrad("embedding dw", t.gradOf(lw), d.gradOf(dw));
        // cross-entropy: 4 rows of 6 classes
        int64[] ls = [4L, 6L];
        Tensor<float32> logits #= GradBackGpuTest.fill(ls, 97L, false);
        Tensor<float32> tg #= GradBackGpuTest.ids(4L, 6L, 3L);
        GradTape<float32> t2 = heap GradTape<float32>();
        GradTensor ll = t2.leaf(logits, true);
        t2.backward(t2.crossEntropy(ll, tg));
        Tensor<float32> logitsD #= GradBackGpuTest.onDevice(logits);
        Tensor<float32> tgD #= GradBackGpuTest.onDevice(tg);
        GradTape<float32> d2 = heap GradTape<float32>();
        GradTensor dl = d2.leaf(logitsD, true);
        d2.backward(d2.crossEntropy(dl, tgD));
        GradBackGpuTest.sameGrad("crossEntropy dlogits", t2.gradOf(ll), d2.gradOf(dl));
        // mse and cosine over 3x7 pairs
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 101L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(s, 103L, false);
        int32 which = 0;
        while (which < 2) {
            GradTape<float32> t3 = heap GradTape<float32>();
            GradTensor la = t3.leaf(a, true);
            GradTensor lb = t3.leaf(b, true);
            GradTensor y = la;
            if (which == 0) { y = t3.mseLoss(la, lb); } else { y = t3.cosineSim(la, lb); }
            t3.backward(y);
            Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
            Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
            GradTape<float32> d3 = heap GradTape<float32>();
            GradTensor da = d3.leaf(ad, true);
            GradTensor db = d3.leaf(bd, true);
            GradTensor yd = da;
            if (which == 0) { yd = d3.mseLoss(da, db); } else { yd = d3.cosineSim(da, db); }
            d3.backward(yd);
            GradBackGpuTest.sameGrad("loss " + which + " dA", t3.gradOf(la), d3.gradOf(da));
            GradBackGpuTest.sameGrad("loss " + which + " dB", t3.gradOf(lb), d3.gradOf(db));
            which = which + 1;
        }
        // dropout: the gradient is the mask, so grad * x reproduces the output
        int64[] dsh = [20L, 50L];
        Tensor<float32> x #= GradBackGpuTest.fill(dsh, 107L, true);
        Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
        GradTape<float32> d4 = heap GradTape<float32>();
        GradTensor dx = d4.leaf(xd, true);
        GradTensor yd = d4.dropout(dx, 0.5, true, (uint64) 99);
        Tensor<float32> out = d4.valueOf(yd);
        d4.backward(yd);
        Tensor<float32> g = d4.gradOf(dx);
        Assert.isTrue(g.isOnGpu());
        g.cpu();
        out.cpu();
        int64 i = 0;
        int64 kept = 0;
        while (i < 1000L) {
            float32 m = g.flatGet(i);
            Assert.isTrue(m == 0.0f || m == 2.0f);
            Assert.isTrue(out.flatGet(i) == x.flatGet(i) * m);
            if (m == 2.0f) { kept = kept + 1; }
            i = i + 1;
        }
        Assert.isTrue(kept > 400L && kept < 600L);
    }

    @Test
    public void smallCnnTrainingStepGradientsMatchTheCpu() {
        SmallCnn net = heap SmallCnn(1L, 4L, 4L, 7L);
        int64[] xs = [2L, 1L, 8L, 8L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 5L, false);
        Tensor<float32> y #= GradBackGpuTest.ids(2L, 4L, 3L);
        GradTape<float32> t = heap GradTape<float32>();
        net.train();
        net.bindParameters(t);
        GradTensor loss = t.crossEntropy(net.forward(t, t.leaf(x, false)), y);
        t.backward(loss);
        Parameter[] ps #= net.parameters();
        Tensor<float32>[] want = heap Tensor<float32>[ps.count()];
        int32 k = 0;
        while (k < (int32) ps.count()) { want[k] #= t.gradOf(ps[k].node()).copy(); k = k + 1; }
        net.unbindParameters();
        SmallCnn dev = heap SmallCnn(1L, 4L, 4L, 7L);
        dev.toDevice();
        dev.train();
        Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
        Tensor<float32> yd #= GradBackGpuTest.onDevice(y);
        GradTape<float32> d = heap GradTape<float32>();
        dev.bindParameters(d);
        GradTensor lossD = d.crossEntropy(dev.forward(d, d.leaf(xd, false)), yd);
        d.backward(lossD);
        Parameter[] pd #= dev.parameters();
        k = 0;
        while (k < (int32) pd.count()) {
            GradBackGpuTest.sameGrad("smallCnn parameter " + k, want[k], d.gradOf(pd[k].node()));
            k = k + 1;
        }
        dev.unbindParameters();
    }
}
