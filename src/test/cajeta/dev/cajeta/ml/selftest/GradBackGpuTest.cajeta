package dev.cajeta.ml.selftest;

import cajeta.lang.System;
import cajeta.math.Tensor;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.grad.Op;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.zoo.SmallCnn;

/**
 * cajeta-ml-gpu 29.1.1 (spec §6.6): the backward column. For each op, `tape.backward` on
 * device leaves yields the CPU column's gradients within 1e-4 relative.
 */
public class GradBackGpuTest {
    public GradBackGpuTest() { return; }

    static #Tensor<float32> fill(int64[] shape, int64 seed, boolean positive) {
        Tensor<float32> t #= Tensor.full<float32>(shape, 0.0f);
        int64 n = t.size();
        int64 f = 0;
        while (f < n) {
            float32 v = (float32) ((((f + seed) * 7919L) % 251L) - 125L) * 0.012f;
            if (positive) { v = v + 1.6f; }
            t.flatSet(f, v);
            f = f + 1;
        }
        return #t;
    }

    static #Tensor<float32> onDevice(Tensor<float32> t) {
        Tensor<float32> d #= t.copy();
        d.gpu();
        return #d;
    }

    static void sameGrad(String what, Tensor<float32> want, Tensor<float32> got) {
        Assert.isTrue(got.isOnGpu());
        got.cpu();
        Assert.equals(want.size(), got.size());
        int64 i = 0;
        while (i < want.size()) {
            float64 w = (float64) want.flatGet(i);
            float64 g = (float64) got.flatGet(i);
            float64 d = g - w;
            if (d < 0.0) { d = 0.0 - d; }
            float64 aw = w;
            if (aw < 0.0) { aw = 0.0 - aw; }
            if (!(d <= 1.0e-4 * (aw + 1.0))) {
                System.stdout.println("  " + what + " grad [" + i + "] device " + g + " cpu " + w);
                Assert.isTrue(false);
            }
            i = i + 1;
        }
    }

    static GradTensor apply1(GradTape<float32> t, int32 op, GradTensor a, int32 axis, float32 c) {
        if (op == Op.RELU) { return t.relu(a); }
        if (op == Op.NEG) { return t.neg(a); }
        if (op == Op.EXP) { return t.exp(a); }
        if (op == Op.LOG) { return t.log(a); }
        if (op == Op.SQRT) { return t.sqrt(a); }
        if (op == Op.TANH) { return t.tanh(a); }
        if (op == Op.SIGMOID) { return t.sigmoid(a); }
        if (op == Op.GELU) { return t.gelu(a); }
        if (op == Op.SOFTMAX) { return t.softmax(a); }
        if (op == Op.LOGSOFTMAX) { return t.logSoftmax(a); }
        if (op == Op.POWS) { return t.powScalar(a, c); }
        if (op == Op.ROWNORM) { return t.rowNorm(a); }
        if (op == Op.SUM) { return t.sum(a); }
        if (op == Op.MEAN) { return t.mean(a); }
        if (op == Op.SUMAXIS) { return t.sumAxis(a, axis); }
        if (op == Op.MEANAXIS) { return t.meanAxis(a, axis); }
        if (op == Op.MAXAXIS) { return t.maxAxis(a, axis); }
        if (op == Op.TRANSPOSE) { return t.transpose2d(a); }
        if (op == Op.TRANSPOSEB) { return t.transposeBatch(a); }
        if (op == Op.PERMUTE) { int32[] perm = [2, 0, 1]; return t.permute(a, perm); }
        if (op == Op.RESHAPE) { int64[] sh = [7L, 3L]; return t.reshape(a, sh); }
        if (op == Op.SLICE) { return t.slice(a, axis, 1L, 3L); }
        return a;
    }

    static void unary(String what, int32 op, Tensor<float32> a, int32 axis, float32 c) {
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor y = GradBackGpuTest.apply1(t, op, la, axis, c);
        t.backward(y);
        Tensor<float32> want = t.gradOf(la);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor ld = d.leaf(ad, true);
        GradTensor yd = GradBackGpuTest.apply1(d, op, ld, axis, c);
        d.backward(yd);
        GradBackGpuTest.sameGrad(what, want, d.gradOf(ld));
    }

    @Test
    public void elementwiseAndRowBackwardsMatchTheCpu() {
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 3L, false);
        Tensor<float32> p #= GradBackGpuTest.fill(s, 5L, true);
        GradBackGpuTest.unary("relu", Op.RELU, a, 0, 0.0f);
        GradBackGpuTest.unary("neg", Op.NEG, a, 0, 0.0f);
        GradBackGpuTest.unary("exp", Op.EXP, a, 0, 0.0f);
        GradBackGpuTest.unary("log", Op.LOG, p, 0, 0.0f);
        GradBackGpuTest.unary("sqrt", Op.SQRT, p, 0, 0.0f);
        GradBackGpuTest.unary("tanh", Op.TANH, a, 0, 0.0f);
        GradBackGpuTest.unary("sigmoid", Op.SIGMOID, a, 0, 0.0f);
        GradBackGpuTest.unary("gelu", Op.GELU, a, 0, 0.0f);
        GradBackGpuTest.unary("softmax", Op.SOFTMAX, a, 0, 0.0f);
        GradBackGpuTest.unary("logSoftmax", Op.LOGSOFTMAX, a, 0, 0.0f);
        GradBackGpuTest.unary("powScalar 3", Op.POWS, a, 0, 3.0f);
        GradBackGpuTest.unary("powScalar 2.5", Op.POWS, p, 0, 2.5f);
        GradBackGpuTest.unary("rowNorm", Op.ROWNORM, a, 0, 0.0f);
    }

    @Test
    public void reductionAndShapeBackwardsMatchTheCpu() {
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 7L, false);
        GradBackGpuTest.unary("sum", Op.SUM, a, 0, 0.0f);
        GradBackGpuTest.unary("mean", Op.MEAN, a, 0, 0.0f);
        GradBackGpuTest.unary("sumAxis 0", Op.SUMAXIS, a, 0, 0.0f);
        GradBackGpuTest.unary("sumAxis 1", Op.SUMAXIS, a, 1, 0.0f);
        GradBackGpuTest.unary("meanAxis 0", Op.MEANAXIS, a, 0, 0.0f);
        GradBackGpuTest.unary("meanAxis 1", Op.MEANAXIS, a, 1, 0.0f);
        GradBackGpuTest.unary("maxAxis 0", Op.MAXAXIS, a, 0, 0.0f);
        GradBackGpuTest.unary("maxAxis 1", Op.MAXAXIS, a, 1, 0.0f);
        GradBackGpuTest.unary("transpose", Op.TRANSPOSE, a, 0, 0.0f);
        GradBackGpuTest.unary("reshape", Op.RESHAPE, a, 0, 0.0f);
        GradBackGpuTest.unary("slice axis 0", Op.SLICE, a, 0, 0.0f);
        GradBackGpuTest.unary("slice axis 1", Op.SLICE, a, 1, 0.0f);
        int64[] s3 = [3L, 7L, 5L];
        Tensor<float32> t3 #= GradBackGpuTest.fill(s3, 11L, false);
        GradBackGpuTest.unary("transposeBatch", Op.TRANSPOSEB, t3, 0, 0.0f);
        GradBackGpuTest.unary("permute", Op.PERMUTE, t3, 0, 0.0f);
        GradBackGpuTest.unary("sumAxis -1 rank 3", Op.SUMAXIS, t3, -1, 0.0f);
        GradBackGpuTest.unary("meanAxis 1 rank 3", Op.MEANAXIS, t3, 1, 0.0f);
    }

    static GradTensor apply2(GradTape<float32> t, int32 op, GradTensor a, GradTensor b, int32 axis) {
        if (op == Op.ADD) { return t.add(a, b); }
        if (op == Op.SUB) { return t.sub(a, b); }
        if (op == Op.MUL) { return t.mul(a, b); }
        if (op == Op.DIV) { return t.div(a, b); }
        if (op == Op.MATMUL) { return t.matmul(a, b); }
        if (op == Op.MATMULB) { return t.matmulBatched(a, b); }
        if (op == Op.CONCAT) { return t.concat(a, b, axis); }
        return a;
    }

    static void binary(String what, int32 op, Tensor<float32> a, Tensor<float32> b, int32 axis) {
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor la = t.leaf(a, true);
        GradTensor lb = t.leaf(b, true);
        GradTensor y = GradBackGpuTest.apply2(t, op, la, lb, axis);
        t.backward(y);
        Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
        Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor lda = d.leaf(ad, true);
        GradTensor ldb = d.leaf(bd, true);
        GradTensor yd = GradBackGpuTest.apply2(d, op, lda, ldb, axis);
        d.backward(yd);
        GradBackGpuTest.sameGrad(what + " dA", t.gradOf(la), d.gradOf(lda));
        GradBackGpuTest.sameGrad(what + " dB", t.gradOf(lb), d.gradOf(ldb));
    }

    @Test
    public void binaryBackwardsMatchTheCpu() {
        int64[] s = [3L, 7L];
        int64[] row = [1L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 13L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(s, 17L, true);
        Tensor<float32> r #= GradBackGpuTest.fill(row, 19L, true);
        GradBackGpuTest.binary("add", Op.ADD, a, b, 0);
        GradBackGpuTest.binary("sub", Op.SUB, a, b, 0);
        GradBackGpuTest.binary("mul", Op.MUL, a, b, 0);
        GradBackGpuTest.binary("div", Op.DIV, a, b, 0);
        GradBackGpuTest.binary("add broadcast", Op.ADD, a, r, 0);
        GradBackGpuTest.binary("mul broadcast", Op.MUL, a, r, 0);
        GradBackGpuTest.binary("div broadcast", Op.DIV, a, r, 0);
        GradBackGpuTest.binary("concat axis 0", Op.CONCAT, a, b, 0);
        GradBackGpuTest.binary("concat axis 1", Op.CONCAT, a, b, 1);
        int64[] ws = [7L, 5L];
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 23L, false);
        GradBackGpuTest.binary("matmul", Op.MATMUL, a, w, 0);
        int64[] ba = [2L, 3L, 7L];
        int64[] bb = [2L, 7L, 5L];
        Tensor<float32> xa #= GradBackGpuTest.fill(ba, 29L, false);
        Tensor<float32> xb #= GradBackGpuTest.fill(bb, 31L, false);
        GradBackGpuTest.binary("matmulBatched", Op.MATMULB, xa, xb, 0);
    }

    static #Tensor<float32> ids(int64 n, int64 vocab, int64 step) {
        int64[] sh = [n];
        Tensor<float32> t #= Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < n) { t.flatSet(i, (float32) ((i * step) % vocab)); i = i + 1; }
        return #t;
    }

    @Test
    public void convAndPoolBackwardsMatchTheCpu() {
        int64[] xs = [2L, 3L, 6L, 6L];
        int64[] ws = [4L, 3L, 3L, 3L];
        int64[] bs = [4L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 41L, false);
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 43L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(bs, 47L, false);
        int32 cs = 0;
        while (cs < 2) {
            int32 stride = 1 + cs;
            int32 pad = 1 - cs;
            GradTape<float32> t = heap GradTape<float32>();
            GradTensor lx = t.leaf(x, true);
            GradTensor lw = t.leaf(w, true);
            GradTensor lb = t.leaf(b, true);
            t.backward(t.conv2d(lx, lw, lb, stride, pad));
            Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
            Tensor<float32> wd #= GradBackGpuTest.onDevice(w);
            Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
            GradTape<float32> d = heap GradTape<float32>();
            GradTensor dx = d.leaf(xd, true);
            GradTensor dw = d.leaf(wd, true);
            GradTensor db = d.leaf(bd, true);
            d.backward(d.conv2d(dx, dw, db, stride, pad));
            GradBackGpuTest.sameGrad("conv2d dx s" + stride, t.gradOf(lx), d.gradOf(dx));
            GradBackGpuTest.sameGrad("conv2d dw s" + stride, t.gradOf(lw), d.gradOf(dw));
            GradBackGpuTest.sameGrad("conv2d db s" + stride, t.gradOf(lb), d.gradOf(db));
            cs = cs + 1;
        }
        // pools, each through a sum so the cotangent is uniform ones
        int32 pk = 0;
        while (pk < 3) {
            GradTape<float32> t = heap GradTape<float32>();
            GradTensor lx = t.leaf(x, true);
            GradTensor y = lx;
            if (pk == 0) { y = t.maxPool2d(lx, 2, 2, 0); }
            if (pk == 1) { y = t.avgPool2d(lx, 3, 1, 1); }
            if (pk == 2) { y = t.adaptiveAvgPool2d(lx, 4, 4); }
            t.backward(y);
            Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
            GradTape<float32> d = heap GradTape<float32>();
            GradTensor dx = d.leaf(xd, true);
            GradTensor yd = dx;
            if (pk == 0) { yd = d.maxPool2d(dx, 2, 2, 0); }
            if (pk == 1) { yd = d.avgPool2d(dx, 3, 1, 1); }
            if (pk == 2) { yd = d.adaptiveAvgPool2d(dx, 4, 4); }
            d.backward(yd);
            GradBackGpuTest.sameGrad("pool " + pk, t.gradOf(lx), d.gradOf(dx));
            pk = pk + 1;
        }
    }

    @Test
    public void normBackwardsMatchTheCpu() {
        int64[] xs = [2L, 3L, 4L, 4L];
        int64[] cs = [3L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 53L, false);
        Tensor<float32> gamma #= GradBackGpuTest.fill(cs, 59L, true);
        Tensor<float32> beta #= GradBackGpuTest.fill(cs, 61L, false);
        Tensor<float32> mean #= GradBackGpuTest.fill(cs, 67L, false);
        Tensor<float32> var #= GradBackGpuTest.fill(cs, 71L, true);
        int32 mode = 0;
        while (mode < 2) {
            GradTape<float32> t = heap GradTape<float32>();
            GradTensor lx = t.leaf(x, true);
            GradTensor lg = t.leaf(gamma, true);
            GradTensor lb = t.leaf(beta, true);
            GradTensor y = lx;
            if (mode == 0) { y = t.batchNorm2dTrain(lx, lg, lb, 0.00001); } else { y = t.batchNorm2dEval(lx, lg, lb, mean, var, 0.00001); }
            t.backward(y);
            Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
            Tensor<float32> gd #= GradBackGpuTest.onDevice(gamma);
            Tensor<float32> bd #= GradBackGpuTest.onDevice(beta);
            Tensor<float32> md #= GradBackGpuTest.onDevice(mean);
            Tensor<float32> vd #= GradBackGpuTest.onDevice(var);
            GradTape<float32> d = heap GradTape<float32>();
            GradTensor dx = d.leaf(xd, true);
            GradTensor dg = d.leaf(gd, true);
            GradTensor db = d.leaf(bd, true);
            GradTensor yd = dx;
            if (mode == 0) { yd = d.batchNorm2dTrain(dx, dg, db, 0.00001); } else { yd = d.batchNorm2dEval(dx, dg, db, md, vd, 0.00001); }
            d.backward(yd);
            GradBackGpuTest.sameGrad("batchNorm2d dx mode " + mode, t.gradOf(lx), d.gradOf(dx));
            GradBackGpuTest.sameGrad("batchNorm2d dgamma mode " + mode, t.gradOf(lg), d.gradOf(dg));
            GradBackGpuTest.sameGrad("batchNorm2d dbeta mode " + mode, t.gradOf(lb), d.gradOf(db));
            mode = mode + 1;
        }
        // layerNorm over the last axis of 6x7
        int64[] ls = [6L, 7L];
        int64[] ds = [7L];
        Tensor<float32> l #= GradBackGpuTest.fill(ls, 73L, false);
        Tensor<float32> lgam #= GradBackGpuTest.fill(ds, 79L, true);
        Tensor<float32> lbet #= GradBackGpuTest.fill(ds, 83L, false);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lx = t.leaf(l, true);
        GradTensor lg = t.leaf(lgam, true);
        GradTensor lb = t.leaf(lbet, true);
        t.backward(t.layerNorm(lx, lg, lb, 0.00001));
        Tensor<float32> ld #= GradBackGpuTest.onDevice(l);
        Tensor<float32> lgd #= GradBackGpuTest.onDevice(lgam);
        Tensor<float32> lbd #= GradBackGpuTest.onDevice(lbet);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dx = d.leaf(ld, true);
        GradTensor dg = d.leaf(lgd, true);
        GradTensor db = d.leaf(lbd, true);
        d.backward(d.layerNorm(dx, dg, db, 0.00001));
        GradBackGpuTest.sameGrad("layerNorm dx", t.gradOf(lx), d.gradOf(dx));
        GradBackGpuTest.sameGrad("layerNorm dgamma", t.gradOf(lg), d.gradOf(dg));
        GradBackGpuTest.sameGrad("layerNorm dbeta", t.gradOf(lb), d.gradOf(db));
    }

    @Test
    public void lossEmbeddingAndDropoutBackwardsMatchTheCpu() {
        // embedding: repeated ids accumulate
        int64[] ws = [5L, 3L];
        Tensor<float32> w #= GradBackGpuTest.fill(ws, 89L, false);
        Tensor<float32> idx #= GradBackGpuTest.ids(7L, 5L, 2L);
        GradTape<float32> t = heap GradTape<float32>();
        GradTensor lw = t.leaf(w, true);
        t.backward(t.embedding(lw, idx));
        Tensor<float32> wd #= GradBackGpuTest.onDevice(w);
        Tensor<float32> idxD #= GradBackGpuTest.onDevice(idx);
        GradTape<float32> d = heap GradTape<float32>();
        GradTensor dw = d.leaf(wd, true);
        d.backward(d.embedding(dw, idxD));
        GradBackGpuTest.sameGrad("embedding dw", t.gradOf(lw), d.gradOf(dw));
        // cross-entropy: 4 rows of 6 classes
        int64[] ls = [4L, 6L];
        Tensor<float32> logits #= GradBackGpuTest.fill(ls, 97L, false);
        Tensor<float32> tg #= GradBackGpuTest.ids(4L, 6L, 3L);
        GradTape<float32> t2 = heap GradTape<float32>();
        GradTensor ll = t2.leaf(logits, true);
        t2.backward(t2.crossEntropy(ll, tg));
        Tensor<float32> logitsD #= GradBackGpuTest.onDevice(logits);
        Tensor<float32> tgD #= GradBackGpuTest.onDevice(tg);
        GradTape<float32> d2 = heap GradTape<float32>();
        GradTensor dl = d2.leaf(logitsD, true);
        d2.backward(d2.crossEntropy(dl, tgD));
        GradBackGpuTest.sameGrad("crossEntropy dlogits", t2.gradOf(ll), d2.gradOf(dl));
        // mse and cosine over 3x7 pairs
        int64[] s = [3L, 7L];
        Tensor<float32> a #= GradBackGpuTest.fill(s, 101L, false);
        Tensor<float32> b #= GradBackGpuTest.fill(s, 103L, false);
        int32 which = 0;
        while (which < 2) {
            GradTape<float32> t3 = heap GradTape<float32>();
            GradTensor la = t3.leaf(a, true);
            GradTensor lb = t3.leaf(b, true);
            GradTensor y = la;
            if (which == 0) { y = t3.mseLoss(la, lb); } else { y = t3.cosineSim(la, lb); }
            t3.backward(y);
            Tensor<float32> ad #= GradBackGpuTest.onDevice(a);
            Tensor<float32> bd #= GradBackGpuTest.onDevice(b);
            GradTape<float32> d3 = heap GradTape<float32>();
            GradTensor da = d3.leaf(ad, true);
            GradTensor db = d3.leaf(bd, true);
            GradTensor yd = da;
            if (which == 0) { yd = d3.mseLoss(da, db); } else { yd = d3.cosineSim(da, db); }
            d3.backward(yd);
            GradBackGpuTest.sameGrad("loss " + which + " dA", t3.gradOf(la), d3.gradOf(da));
            GradBackGpuTest.sameGrad("loss " + which + " dB", t3.gradOf(lb), d3.gradOf(db));
            which = which + 1;
        }
        // dropout: the gradient is the mask, so grad * x reproduces the output
        int64[] dsh = [20L, 50L];
        Tensor<float32> x #= GradBackGpuTest.fill(dsh, 107L, true);
        Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
        GradTape<float32> d4 = heap GradTape<float32>();
        GradTensor dx = d4.leaf(xd, true);
        GradTensor yd = d4.dropout(dx, 0.5, true, (uint64) 99);
        Tensor<float32> out = d4.valueOf(yd);
        d4.backward(yd);
        Tensor<float32> g = d4.gradOf(dx);
        Assert.isTrue(g.isOnGpu());
        g.cpu();
        out.cpu();
        int64 i = 0;
        int64 kept = 0;
        while (i < 1000L) {
            float32 m = g.flatGet(i);
            Assert.isTrue(m == 0.0f || m == 2.0f);
            Assert.isTrue(out.flatGet(i) == x.flatGet(i) * m);
            if (m == 2.0f) { kept = kept + 1; }
            i = i + 1;
        }
        Assert.isTrue(kept > 400L && kept < 600L);
    }

    @Test
    public void smallCnnTrainingStepGradientsMatchTheCpu() {
        SmallCnn net = heap SmallCnn(1L, 4L, 4L, 7L);
        int64[] xs = [2L, 1L, 8L, 8L];
        Tensor<float32> x #= GradBackGpuTest.fill(xs, 5L, false);
        Tensor<float32> y #= GradBackGpuTest.ids(2L, 4L, 3L);
        GradTape<float32> t = heap GradTape<float32>();
        net.train();
        net.bindParameters(t);
        GradTensor loss = t.crossEntropy(net.forward(t, t.leaf(x, false)), y);
        t.backward(loss);
        Parameter[] ps #= net.parameters();
        Tensor<float32>[] want = heap Tensor<float32>[ps.count()];
        int32 k = 0;
        while (k < (int32) ps.count()) { want[k] #= t.gradOf(ps[k].node()).copy(); k = k + 1; }
        net.unbindParameters();
        SmallCnn dev = heap SmallCnn(1L, 4L, 4L, 7L);
        dev.toDevice();
        dev.train();
        Tensor<float32> xd #= GradBackGpuTest.onDevice(x);
        Tensor<float32> yd #= GradBackGpuTest.onDevice(y);
        GradTape<float32> d = heap GradTape<float32>();
        dev.bindParameters(d);
        GradTensor lossD = d.crossEntropy(dev.forward(d, d.leaf(xd, false)), yd);
        d.backward(lossD);
        Parameter[] pd #= dev.parameters();
        k = 0;
        while (k < (int32) pd.count()) {
            GradBackGpuTest.sameGrad("smallCnn parameter " + k, want[k], d.gradOf(pd[k].node()));
            k = k + 1;
        }
        dev.unbindParameters();
    }
}
