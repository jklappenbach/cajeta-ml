package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.DecisionTreeClassifier;
import dev.cajeta.ml.DecisionTreeRegressor;

/**
 * ml-trees-ensembles U4 — impurity-based feature importances vs PINNED
 * sklearn 1.9.0 (gen_tree.py u4-imp): normalized total weighted impurity
 * decrease per feature, summing to 1; an unused (constant) feature is
 * exactly 0. (The ensemble average lands with U6's forests.)
 */
public class ImportanceTest {

    public ImportanceTest() { return; }

    static boolean near(float64 a, float64 b) {
        float64 d = a - b;
        if (d < 0.0) { d = -d; }
        return d <= 0.000000000001;
    }

    @Test
    public void importancesMatchSklearnAndSumToOne() {
        float64[] xa = heap float64[36];
        float64[] ya = heap float64[12];
        int64 i = 0;
        while (i < 12) {
            int64 blk = i / 4;
            int64 pos = i % 4;
            xa[i * 3] = (float64) blk;
            xa[i * 3 + 1] = (float64) pos;
            xa[i * 3 + 2] = 0.5;
            ya[i] = (float64) blk;
            if (blk == 1) { ya[i] = pos < 2 ? 1.0 : 0.0; }
            i = i + 1;
        }
        int64[] xs = heap int64[2]; xs[0] = 12; xs[1] = 3;
        int64[] ys = heap int64[1]; ys[0] = 12;
        Tensor<float64> x = Tensor.of<float64>(xa, xs);
        Tensor<float64> y = Tensor.of<float64>(ya, ys);

        DecisionTreeClassifier c = heap DecisionTreeClassifier("gini");
        c.fit(x, y);
        Tensor<float64> imp = c.featureImportances();
        Assert.equals(imp.shapeAt(0), (int64) 3);
        Assert.isTrue(ImportanceTest.near(imp.flatGet((int64) 0), 8.0 / 11.0));
        Assert.isTrue(ImportanceTest.near(imp.flatGet((int64) 1), 3.0 / 11.0));
        Assert.isTrue(imp.flatGet((int64) 2) == 0.0);
        float64 sum = imp.flatGet((int64) 0) + imp.flatGet((int64) 1) + imp.flatGet((int64) 2);
        Assert.isTrue(ImportanceTest.near(sum, 1.0));

        // The regressor exposes the same surface (single-feature tree: all
        // importance on f0 exactly).
        float64[] ra = heap float64[8];
        float64[] rya = heap float64[8];
        i = 0;
        while (i < 8) { ra[i] = (float64) i; rya[i] = (float64) (i * 2); i = i + 1; }
        int64[] rs = heap int64[2]; rs[0] = 8; rs[1] = 1;
        int64[] rys = heap int64[1]; rys[0] = 8;
        DecisionTreeRegressor r = heap DecisionTreeRegressor((int64) 2);
        r.fit(Tensor.of<float64>(ra, rs), Tensor.of<float64>(rya, rys));
        Tensor<float64> rimp = r.featureImportances();
        Assert.isTrue(rimp.flatGet((int64) 0) == 1.0);
        return;
    }
}
