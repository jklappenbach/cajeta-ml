package dev.cajeta.ml.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.ml.EstimatorFactory;
import dev.cajeta.ml.GridSearch;
import dev.cajeta.ml.KernelRegressor;
import dev.cajeta.ml.KFold;
import dev.cajeta.ml.Pipeline;
import dev.cajeta.ml.Predictor;
import dev.cajeta.ml.SearchResult;
import dev.cajeta.ml.Split;
import dev.cajeta.ml.StandardScaler;
import dev.cajeta.ml.Transformer;

/**
 * ml-classification-gaps plan Unit 7 — Nadaraya-Watson kernel regression
 * (spec §9). No sklearn estimator exists for this
 * (DifferencesFromSklearn); the pins are the closed-form formula computed
 * by hand: x = [0,1,2,4], y = [1,3,2,8].
 */
public class KernelRegressionTest {

    public KernelRegressionTest() { return; }

    static boolean near(float64 a, float64 b, float64 tol) {
        float64 d = a - b;
        if (d < 0.0) {
            d = -d;
        }
        return d < tol;
    }

    static #Tensor<float64> lineX() {
        float64[] d = heap float64[4];
        d[0] = 0.0;
        d[1] = 1.0;
        d[2] = 2.0;
        d[3] = 4.0;
        int64[] sh = heap int64[2];
        sh[0] = 4;
        sh[1] = 1;
        return Tensor.of<float64>(d, sh);
    }

    static #Tensor<float64> lineY() {
        float64[] d = heap float64[4];
        d[0] = 1.0;
        d[1] = 3.0;
        d[2] = 2.0;
        d[3] = 8.0;
        int64[] sh = heap int64[1];
        sh[0] = 4;
        return Tensor.of<float64>(d, sh);
    }

    static #Tensor<float64> q1(float64 v) {
        float64[] d = heap float64[1];
        d[0] = v;
        int64[] sh = heap int64[2];
        sh[0] = 1;
        sh[1] = 1;
        return Tensor.of<float64>(d, sh);
    }

    // §9.1 + §9.2 — the kernel-weighted mean, each kernel at its
    // hand-computed value.
    @Test
    public void kernelsMatchHandComputed() {
        KernelRegressor g = heap KernelRegressor("gaussian", 1.0);
        g.fit(lineX(), lineY());
        Assert.isTrue(near(g.predict(q1(1.5)).flatGet(0),
            2.3850171085891896, 0.000000001));
        KernelRegressor g2 = heap KernelRegressor("gaussian", 1.5);
        g2.fit(lineX(), lineY());
        Assert.isTrue(near(g2.predict(q1(3.0)).flatGet(0),
            4.365169930289057, 0.000000001));

        KernelRegressor e = heap KernelRegressor("epanechnikov", 1.0);
        e.fit(lineX(), lineY());
        Assert.isTrue(near(e.predict(q1(1.2)).flatGet(0),
            2.727272727272728, 0.000000001));
        Assert.isTrue(near(e.predict(q1(1.5)).flatGet(0), 2.5,
            0.000000001));

        KernelRegressor t = heap KernelRegressor("tricube", 1.0);
        t.fit(lineX(), lineY());
        Assert.isTrue(near(t.predict(q1(1.2)).flatGet(0),
            2.893616203561578, 0.000000001));

        KernelRegressor u = heap KernelRegressor("uniform", 1.0);
        u.fit(lineX(), lineY());
        Assert.isTrue(near(u.predict(q1(1.2)).flatGet(0), 2.5,
            0.000000001));
    }

    // §9.3 — bandwidth controls the neighbourhood; non-positive rejects.
    @Test
    public void bandwidthValidatedAndMonotone() {
        Assert.assertThrows(() -> {
            KernelRegressor b = heap KernelRegressor("gaussian", 0.0);
        });
        Assert.assertThrows(() -> {
            KernelRegressor b = heap KernelRegressor("boxcar", 1.0);
        });

        // Wide bandwidth pulls the estimate toward the global mean.
        float64 mean = (1.0 + 3.0 + 2.0 + 8.0) / 4.0;
        KernelRegressor narrow = heap KernelRegressor("gaussian", 0.1);
        narrow.fit(lineX(), lineY());
        KernelRegressor wide = heap KernelRegressor("gaussian", 50.0);
        wide.fit(lineX(), lineY());
        float64 dn = narrow.predict(q1(1.02)).flatGet(0) - mean;
        if (dn < 0.0) {
            dn = -dn;
        }
        float64 dw = wide.predict(q1(1.02)).flatGet(0) - mean;
        if (dw < 0.0) {
            dw = -dw;
        }
        Assert.isTrue(dw < dn);
    }

    // §9.5 — a query with no in-support neighbour falls back to the
    // nearest training target (the documented rule), never NaN.
    @Test
    public void degenerateQueryFallsBackToNearest() {
        KernelRegressor e = heap KernelRegressor("epanechnikov", 1.0);
        e.fit(lineX(), lineY());
        float64 far = e.predict(q1(100.0)).flatGet(0);
        Assert.isTrue(near(far, 8.0, 0.000000001));   // nearest is x=4
        Assert.isTrue(far == far);                    // not NaN
    }

    // §9.4 — bandwidth selection through the §7 search machinery.
    @Test
    public void bandwidthByCrossValidation() {
        // A denser 1-D fixture: y = x^2 * 0.5 with deterministic wiggle.
        float64[] xd = heap float64[20];
        float64[] yd = heap float64[20];
        int64 i = 0;
        while (i < 20) {
            xd[i] = (float64) i * 0.4;
            yd[i] = xd[i] * xd[i] * 0.5
                + (float64) ((i * 3) % 5 - 2) * 0.15;
            i = i + 1;
        }
        int64[] xs = heap int64[2];
        xs[0] = 20;
        xs[1] = 1;
        int64[] ys = heap int64[1];
        ys[0] = 20;
        Tensor<float64> x = Tensor.of<float64>(xd, xs);
        Tensor<float64> y = Tensor.of<float64>(yd, ys);

        KFold kf = heap KFold((int64) 4, true, (uint64) 13);
        Tensor<int64> fid = kf.assignments((int64) 20);
        EstimatorFactory f = heap KernelFactory();
        Tensor<float64>[] dims = heap Tensor<float64>[1];
        float64[] hs = heap float64[4];
        hs[0] = 0.2;
        hs[1] = 0.6;
        hs[2] = 1.5;
        hs[3] = 8.0;
        int64[] ds = heap int64[1];
        ds[0] = 4;
        dims[0] = Tensor.of<float64>(hs, ds);
        SearchResult res = GridSearch.run(f, dims, x, y, fid, "r2");
        Assert.equals(res.count(), (int64) 4);
        Assert.equals(res.failures(), (int64) 0);
        Tensor<float64> best = res.bestParams();
        // The over-smoothed h=8 flattens to the mean and cannot win.
        Assert.isTrue(best.flatGet(0) < 8.0);
        Assert.isTrue(res.bestScore() > 0.5);
    }

    // 7.1.5 — composes in Pipeline and cross-validation.
    @Test
    public void composesInPipelineAndCv() {
        float64[] xd = heap float64[20];
        float64[] yd = heap float64[20];
        int64 i = 0;
        while (i < 20) {
            xd[i] = (float64) i * 0.4;
            yd[i] = 2.0 * xd[i] + 1.0;
            i = i + 1;
        }
        int64[] xs = heap int64[2];
        xs[0] = 20;
        xs[1] = 1;
        int64[] ys = heap int64[1];
        ys[0] = 20;
        Tensor<float64> x = Tensor.of<float64>(xd, xs);
        Tensor<float64> y = Tensor.of<float64>(yd, ys);

        Transformer sc = heap StandardScaler();
        Predictor kr = heap KernelRegressor("gaussian", 0.3);
        Pipeline pl = Pipeline.of(#sc, #kr);
        pl.fit(x, y);
        Assert.isTrue(pl.score(x, y) > 0.9);          // R² on the line

        Predictor kr2 = heap KernelRegressor("gaussian", 0.5);
        KFold kf = heap KFold((int64) 4, true, (uint64) 3);
        Tensor<float64> scores = Split.crossValScore(kr2, x, y, kf);
        int64 f = 0;
        while (f < 4) {
            Assert.isTrue(scores.flatGet(f) > 0.0);
            f = f + 1;
        }
    }
}
