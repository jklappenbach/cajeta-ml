package dev.cajeta.ml.selftest;

import cajeta.collection.ArrayList;
import cajeta.lang.System;
import cajeta.math.Tensor;
import cajeta.xpu.Device;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.data.Digits;
import dev.cajeta.ml.grad.Ops;
import dev.cajeta.ml.nn.Conv2d;
import dev.cajeta.ml.nn.Linear;
import dev.cajeta.ml.nn.MaxPool2d;
import dev.cajeta.ml.nn.Module;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.nn.ReLU;
import dev.cajeta.ml.nn.Sequential;
import dev.cajeta.ml.train.SpelaConfig;
import dev.cajeta.ml.train.SpelaTrainer;

/**
 * cajeta-ml-gpu 28.2.9: SpelaTrainer's per-layer step on the device follows the host's loss
 * curve, layer by layer, for a two-layer Linear net and a conv stack.
 */
public class SpelaDeviceTest {
    public SpelaDeviceTest() { return; }

    static #ArrayList<Module> mlp(uint64 seed) {
        ArrayList<Module> ls #= heap ArrayList<Module>();
        Module a = heap Linear(64, 24, seed);
        ls.add(#a);
        Module b = heap Linear(24, 12, seed + 1);
        ls.add(#b);
        return ls;
    }

    static #ArrayList<Module> cnn(uint64 seed) {
        ArrayList<Module> ls #= heap ArrayList<Module>();
        Sequential s = heap Sequential();
        Module c = heap Conv2d(1, 4, 3, 1, 1, seed);
        s.add(#c);
        Module r = heap ReLU();
        s.add(#r);
        Module p = heap MaxPool2d(2, 2, 0);
        s.add(#p);
        ls.add(#s);
        Module l = heap Linear(64, 12, seed + 1);
        ls.add(#l);
        return ls;
    }

    /** The (n, 64) digit images as (n, 1, 8, 8). */
    static #Tensor<float32> asImages(Tensor<float32> x) {
        int64[] sh = [x.shapeAt(0), 1L, 8L, 8L];
        Tensor<float32> vw #= x.reshape(sh);
        Tensor<float32> out #= vw.copy();
        return #out;
    }

    /** `steps` batches through `tr`; the per-layer losses, step-major. */
    static #float64[] curve(SpelaTrainer tr, Tensor<float32> x, Tensor<float32> y, int32 steps) {
        int32 lc = tr.layerCount();
        float64[] out = heap float64[steps * lc];
        int32 s = 0;
        while (s < steps) {
            tr.trainBatch(x, y);
            int32 l = 0;
            while (l < lc) {
                out[s * lc + l] = tr.lastLossAt(l);
                l = l + 1;
            }
            s = s + 1;
        }
        return out;
    }

    static void toDevice(SpelaTrainer tr) {
        int32 i = 0;
        while (i < tr.layerCount()) {
            tr.layerAt(i).toDevice();
            i = i + 1;
        }
        return;
    }

    static void sameCurve(String what, float64[] host, float64[] dev, float64 tol) {
        Assert.equals(host.count(), dev.count());
        int32 i = 0;
        while (i < (int32) host.count()) {
            float64 d = dev[i] - host[i];
            if (d < 0.0) { d = 0.0 - d; }
            float64 a = host[i];
            if (a < 0.0) { a = 0.0 - a; }
            if (!(d <= tol * (a + 1.0))) {
                System.stdout.println("  " + what + " [" + i + "] device " + dev[i] + " host " + host[i]);
                Assert.isTrue(false);
            }
            i = i + 1;
        }
        return;
    }

    static void allOnDevice(SpelaTrainer tr) {
        int32 i = 0;
        while (i < tr.layerCount()) {
            Parameter[] ps #= tr.layerAt(i).parameters();
            int32 k = 0;
            while (k < (int32) ps.count()) { Assert.isTrue(ps[k].get().isOnGpu()); k = k + 1; }
            i = i + 1;
        }
        return;
    }

    @Test
    public void cosfaceStepOnTheDeviceFollowsTheHostCurve() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 3L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig hc = heap SpelaConfig(4);
        hc.lr = 0.01f;
        hc.cosineMargin = 0.35;
        hc.seed = 29L;
        SpelaTrainer host = heap SpelaTrainer(#SpelaDeviceTest.mlp(41L), #hc);
        host.planSteps(6L);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.cosineMargin = 0.35;
        dc.seed = 29L;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(41L), #dc);
        dev.planSteps(6L);
        SpelaDeviceTest.toDevice(dev);
        float64[] want #= SpelaDeviceTest.curve(host, x, y, 6);
        float64[] got #= SpelaDeviceTest.curve(dev, x, y, 6);
        SpelaDeviceTest.sameCurve("cosface", want, got, 2.0e-3);
        Assert.isTrue(want[10] < want[0]);
        SpelaDeviceTest.allOnDevice(dev);
        float64 ah = host.accuracyFromLayer(x, y, -1);
        float64 ad = dev.accuracyFromLayer(x, y, -1);
        float64 gap = ah - ad;
        if (gap < 0.0) { gap = 0.0 - gap; }
        Assert.isTrue(gap <= 0.07);
    }

    /**
     * spela-kernels 2.1.1, 2.1.2: a device batch with the global-norm clip on makes, from the
     * second batch on, exactly the syncs and transfers of one read of its loss row: the clip's
     * norm, the loss slots and the handoff stay on the device. Its curve follows the host's
     * with the clip on.
     */
    @Test
    public void aDeviceBatchSyncsOnlyAtTheLossRead() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 9L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig hc = heap SpelaConfig(4);
        hc.lr = 0.01f;
        hc.seed = 23L;
        hc.gradClipNorm = 0.05f;
        SpelaTrainer host = heap SpelaTrainer(#SpelaDeviceTest.mlp(43L), #hc);
        host.planSteps(8L);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 23L;
        dc.gradClipNorm = 0.05f;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(43L), #dc);
        dev.planSteps(8L);
        SpelaDeviceTest.toDevice(dev);
        float64[] want #= SpelaDeviceTest.curve(host, x, y, 6);
        float64[] got #= SpelaDeviceTest.curve(dev, x, y, 6);
        SpelaDeviceTest.sameCurve("clipped", want, got, 2.0e-3);
        if (!SpelaDeviceTest.onGpu(dev)) { return; }
        // What one read of a loss row costs here, so the bracket asks for exactly that.
        Tensor<float32> xd #= x.copy();
        xd.gpu();
        Tensor<float32> yd #= y.copy();
        yd.gpu();
        dev.trainBatch(xd, yd);
        int64[] two = [2L];
        Tensor<float32> row #= Tensor.zeros<float32>(two);
        row.gpu();
        int64 rs = Device.streamSyncCount();
        int64 rt = Device.transferCount();
        Tensor<float32> back #= Ops.copyOf<float32>(row);
        back.cpu();
        int64 readSyncs = Device.streamSyncCount() - rs;
        int64 readTransfers = Device.transferCount() - rt;
        dev.trainBatch(xd, yd);
        int64 s0 = Device.streamSyncCount();
        int64 t0 = Device.transferCount();
        dev.trainBatch(xd, yd);
        int64 syncs = Device.streamSyncCount() - s0;
        int64 transfers = Device.transferCount() - t0;
        System.stdout.println("  clipped device batch: syncs " + syncs + " transfers " + transfers
            + " (one loss read: " + readSyncs + ", " + readTransfers + ")");
        Assert.equals(readSyncs, syncs);
        Assert.equals(readTransfers, transfers);
    }

    /**
     * spela-kernels 2.1.3: on CUDA a device step replays as a graph from its third batch on. The
     * learning rate follows the cosine schedule, so every batch patches its scalars, and the
     * curve still follows the host's. Deferral is a no-op on the other backends, where only the
     * curve is checked.
     */
    @Test
    public void aDeviceStepReplaysAsAGraphOnCuda() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 11L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig hc = heap SpelaConfig(4);
        hc.lr = 0.01f;
        hc.seed = 37L;
        hc.gradClipNorm = 0.05f;
        SpelaTrainer host = heap SpelaTrainer(#SpelaDeviceTest.mlp(47L), #hc);
        host.planSteps(8L);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 37L;
        dc.gradClipNorm = 0.05f;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(47L), #dc);
        dev.planSteps(8L);
        SpelaDeviceTest.toDevice(dev);
        float64[] want #= SpelaDeviceTest.curve(host, x, y, 8);
        if (!SpelaDeviceTest.onGpu(dev)) { return; }
        Tensor<float32> xd #= x.copy();
        xd.gpu();
        Tensor<float32> yd #= y.copy();
        yd.gpu();
        int32 lc = dev.layerCount();
        float64[] got = heap float64[8 * lc];
        int64 g0 = 0L;
        int32 st = 0;
        while (st < 8) {
            if (st == 2) { g0 = KernelStream.deferStat(KernelStream.DEFER_GRAPH_LAUNCHES); }
            dev.trainBatch(xd, yd);
            int32 l = 0;
            while (l < lc) { got[st * lc + l] = dev.lastLossAt(l); l = l + 1; }
            st = st + 1;
        }
        int64 graphs = KernelStream.deferStat(KernelStream.DEFER_GRAPH_LAUNCHES) - g0;
        System.stdout.println("  graph launches over batches 3-8: " + graphs);
        SpelaDeviceTest.sameCurve("deferred", want, got, 2.0e-3);
        SpelaDeviceTest.sameWeights(host, dev, 2.0e-3);
        if (Device.activeBackend().equals("cuda")) {
            Assert.isTrue(graphs >= 6L);
        }
    }

    /**
     * spela-kernels 3.1.3: a clipped device batch updates each layer in one optimizer launch, the
     * clip's scale applied as the gradients are read, with no scaling launch of its own, and its
     * curve follows the host's.
     */
    @Test
    public void aLayerUpdatesInOneLaunchOnTheDevice() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 15L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig hc = heap SpelaConfig(4);
        hc.lr = 0.01f;
        hc.seed = 41L;
        hc.gradClipNorm = 0.05f;
        SpelaTrainer host = heap SpelaTrainer(#SpelaDeviceTest.mlp(53L), #hc);
        host.planSteps(6L);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 41L;
        dc.gradClipNorm = 0.05f;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(53L), #dc);
        dev.planSteps(6L);
        SpelaDeviceTest.toDevice(dev);
        float64[] want #= SpelaDeviceTest.curve(host, x, y, 6);
        if (!SpelaDeviceTest.onGpu(dev)) { return; }
        Tensor<float32> xd #= x.copy();
        xd.gpu();
        Tensor<float32> yd #= y.copy();
        yd.gpu();
        int32 lc = dev.layerCount();
        float64[] got = heap float64[6 * lc];
        int64 adams = 0L;
        int64 scales = 0L;
        int32 st = 0;
        while (st < 6) {
            int64 a0 = Device.kernelLaunchCount("adamSlots_float32");
            int64 s0 = Device.kernelLaunchCount("scaleBy_float32");
            dev.trainBatch(xd, yd);
            adams = Device.kernelLaunchCount("adamSlots_float32") - a0;
            scales = Device.kernelLaunchCount("scaleBy_float32") - s0;
            int32 l = 0;
            while (l < lc) { got[st * lc + l] = dev.lastLossAt(l); l = l + 1; }
            st = st + 1;
        }
        System.stdout.println("  clipped device batch: optimizer launches " + adams + ", scaling launches " + scales);
        SpelaDeviceTest.sameCurve("one launch a layer", want, got, 2.0e-3);
        Assert.equals((int64) lc, adams);
        Assert.equals(0L, scales);
    }

    /**
     * spela-kernels 3.1.4: a frozen layer launches no optimizer work, and unfrozen it updates in
     * one launch again.
     */
    @Test
    public void aFrozenLayerLaunchesNoUpdate() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 19L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 43L;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(59L), #dc);
        dev.planSteps(6L);
        SpelaDeviceTest.toDevice(dev);
        if (!SpelaDeviceTest.onGpu(dev)) { return; }
        Tensor<float32> xd #= x.copy();
        xd.gpu();
        Tensor<float32> yd #= y.copy();
        yd.gpu();
        dev.trainBatch(xd, yd);
        dev.setLayerTrainable(0, false);
        int64 a0 = Device.kernelLaunchCount("adamSlots_float32");
        dev.trainBatch(xd, yd);
        Assert.equals(1L, Device.kernelLaunchCount("adamSlots_float32") - a0);
        dev.setLayerTrainable(0, true);
        int64 a1 = Device.kernelLaunchCount("adamSlots_float32");
        dev.trainBatch(xd, yd);
        Assert.equals(2L, Device.kernelLaunchCount("adamSlots_float32") - a1);
    }

    /**
     * spela-kernels 4.1.1: a device batch computes each layer's loss and the output's gradient in
     * the fused head, once a layer, and none of the composed head's kernels (the cross-entropy
     * row and the backward of it and of the row norm) runs (the layer inputs' own row norm still does); the cosface and paper-exact curves above follow
     * the host through it.
     */
    @Test
    public void theFusedHeadReplacesTheComposedLoss() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 21L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 47L;
        dc.cosineMargin = 0.35;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(61L), #dc);
        dev.planSteps(4L);
        SpelaDeviceTest.toDevice(dev);
        if (!SpelaDeviceTest.onGpu(dev)) { return; }
        Tensor<float32> xd #= x.copy();
        xd.gpu();
        Tensor<float32> yd #= y.copy();
        yd.gpu();
        dev.trainBatch(xd, yd);
        int64 h0 = Device.kernelLaunchCount("headRows_float32");
        int64 c0 = Device.kernelLaunchCount("crossEntropyRow_float32")
            + Device.kernelLaunchCount("l2normBack_float32") + Device.kernelLaunchCount("nllBack_float32");
        dev.trainBatch(xd, yd);
        int64 heads = Device.kernelLaunchCount("headRows_float32") - h0;
        int64 composed = Device.kernelLaunchCount("crossEntropyRow_float32")
            + Device.kernelLaunchCount("l2normBack_float32") + Device.kernelLaunchCount("nllBack_float32") - c0;
        System.stdout.println("  device batch: fused heads " + heads + ", composed-head launches " + composed);
        Assert.equals((int64) dev.layerCount(), heads);
        Assert.equals(0L, composed);
    }

    /**
     * spela-kernels 4.3.1: a two-Linear device batch makes at most 25 launches, half of the 51
     * before Units 2 to 4: the optimizer reads the tape's gradients in place, inputs already on
     * the device are not copied, and the head sums its loss in its second kernel. Counted on
     * CUDA, where the deferred queue sees every launch.
     */
    @Test
    public void aDeviceBatchMakesAtMostTwentyFiveLaunches() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 23L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 53L;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(67L), #dc);
        dev.planSteps(4L);
        SpelaDeviceTest.toDevice(dev);
        if (!SpelaDeviceTest.onGpu(dev) || !Device.activeBackend().equals("cuda")) { return; }
        Tensor<float32> xd #= x.copy();
        xd.gpu();
        Tensor<float32> yd #= y.copy();
        yd.gpu();
        dev.trainBatch(xd, yd);
        int64 q0 = KernelStream.deferStat(KernelStream.DEFER_QUEUED);
        dev.trainBatch(xd, yd);
        int64 launches = KernelStream.deferStat(KernelStream.DEFER_QUEUED) - q0;
        System.stdout.println("  two-Linear device batch: " + launches + " launches");
        Assert.isTrue(launches <= 25L);
    }

    /** Every parameter of `dev`, read back, within `tol` of the same parameter of `host`. */
    static void sameWeights(SpelaTrainer host, SpelaTrainer dev, float64 tol) {
        int32 i = 0;
        while (i < host.layerCount()) {
            Parameter[] hp #= host.layerAt(i).parameters();
            Parameter[] dp #= dev.layerAt(i).parameters();
            Assert.equals(hp.count(), dp.count());
            int32 k = 0;
            while (k < (int32) hp.count()) {
                Tensor<float32> hv = hp[k].get();
                Tensor<float32> dv #= Ops.copyOf<float32>(dp[k].get());
                if (dv.isOnGpu()) { dv.cpu(); }
                int64 e = 0L;
                while (e < hv.size()) {
                    float64 a = (float64) hv.flatGet(e);
                    float64 d = (float64) dv.flatGet(e) - a;
                    if (d < 0.0) { d = 0.0 - d; }
                    if (a < 0.0) { a = 0.0 - a; }
                    if (!(d <= tol * (a + 1.0))) {
                        System.stdout.println("  weights layer " + i + " param " + k + " [" + e + "] device "
                            + dv.flatGet(e) + " host " + hv.flatGet(e));
                        Assert.isTrue(false);
                    }
                    e = e + 1L;
                }
                k = k + 1;
            }
            i = i + 1;
        }
    }

    static boolean onGpu(SpelaTrainer tr) {
        Parameter[] ps #= tr.layerAt(0).parameters();
        return ps[0].get().isOnGpu();
    }

    @Test
    public void paperExactStepOnTheDeviceFollowsTheHostCurve() {
        Tensor<float32> x #= Digits.images(8, 4, 0.1f, 5L);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig hc = heap SpelaConfig(4);
        hc.paperExact();
        hc.lr = 0.05f;
        hc.seed = 17L;
        SpelaTrainer host = heap SpelaTrainer(#SpelaDeviceTest.mlp(31L), #hc);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.paperExact();
        dc.lr = 0.05f;
        dc.seed = 17L;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.mlp(31L), #dc);
        SpelaDeviceTest.toDevice(dev);
        float64[] want #= SpelaDeviceTest.curve(host, x, y, 6);
        float64[] got #= SpelaDeviceTest.curve(dev, x, y, 6);
        SpelaDeviceTest.sameCurve("paper-exact", want, got, 2.0e-3);
        Assert.isTrue(want[10] < want[0]);
    }

    @Test
    public void convStackStepOnTheDeviceFollowsTheHostCurve() {
        Tensor<float32> flat #= Digits.images(8, 4, 0.1f, 7L);
        Tensor<float32> x #= SpelaDeviceTest.asImages(flat);
        Tensor<float32> y #= Digits.labels(8, 4);
        SpelaConfig hc = heap SpelaConfig(4);
        hc.lr = 0.01f;
        hc.seed = 13L;
        SpelaTrainer host = heap SpelaTrainer(#SpelaDeviceTest.cnn(51L), #hc);
        host.planSteps(6L);
        SpelaConfig dc = heap SpelaConfig(4);
        dc.lr = 0.01f;
        dc.seed = 13L;
        SpelaTrainer dev = heap SpelaTrainer(#SpelaDeviceTest.cnn(51L), #dc);
        dev.planSteps(6L);
        SpelaDeviceTest.toDevice(dev);
        float64[] want #= SpelaDeviceTest.curve(host, x, y, 6);
        float64[] got #= SpelaDeviceTest.curve(dev, x, y, 6);
        SpelaDeviceTest.sameCurve("conv stack", want, got, 2.0e-3);
        Assert.isTrue(dev.classVectorsAt(0).shapeAt(1) == 64);
        SpelaDeviceTest.allOnDevice(dev);
    }
}
