package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.stats.Information;

/**
 * The teachable face of the split criteria (ml-trees-ensembles U2, spec
 * §3.1–§3.5): base-2 entropy and gini over integer class labels, and
 * information gain for a threshold split — the quantities of the
 * hand-computed boolean example (`H(Y) = 0.954`, `IG(X₁) = 0.5485`,
 * `IG(X₂) = 0.0485`). Entropy comes from `cajeta.math.stats.Information`
 * (base 2 — bits), not a reimplementation.
 */
public final class Criteria {

    /** Base-2 entropy of a class-count vector (the stdlib entropy over the
     *  count fractions; zero counts contribute zero). */
    static float64 entropyOfCounts(int64[] cnt, int64 k, int64 m) {
        float64[] p = heap float64[k];
        int64 c = 0;
        while (c < k) {
            p[c] = (float64) cnt[c] / (float64) m;
            c = c + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = k;
        Tensor<float64> pt = Tensor.of<float64>(p, sh);
        return Information.entropy(pt, 2.0);
    }

    /** Base-2 entropy of a WEIGHTED class-count vector. */
    static float64 entropyOfWeights(float64[] wc, int64 k, float64 wn) {
        float64[] p = heap float64[k];
        int64 c = 0;
        while (c < k) {
            p[c] = wc[c] / wn;
            c = c + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = k;
        Tensor<float64> pt = Tensor.of<float64>(p, sh);
        return Information.entropy(pt, 2.0);
    }

    static #int64[] countsOf(Tensor<float64> y, int64 n, int64 k) {
        int64[] cnt = heap int64[k];
        int64 i = 0;
        while (i < n) {
            cnt[(int64) y.get1(i)] = cnt[(int64) y.get1(i)] + 1;
            i = i + 1;
        }
        return #cnt;
    }

    static int64 classCount(Tensor<float64> y, int64 n) {
        int64 kmax = 0;
        int64 i = 0;
        while (i < n) {
            int64 li = (int64) y.get1(i);
            if (li > kmax) { kmax = li; }
            i = i + 1;
        }
        return kmax + 1;
    }

    /** `H(Y) = −Σ pᵢ log₂ pᵢ` in bits over integer class labels. */
    public static float64 entropy(Tensor<float64> y) {
        int64 n = y.shapeAt(0);
        int64 k = Criteria.classCount(y, n);
        int64[] cnt = Criteria.countsOf(y, n, k);
        return Criteria.entropyOfCounts(cnt, k, n);
    }

    /** Gini `1 − Σ pᵢ²` over integer class labels. */
    public static float64 gini(Tensor<float64> y) {
        int64 n = y.shapeAt(0);
        int64 k = Criteria.classCount(y, n);
        int64[] cnt = Criteria.countsOf(y, n, k);
        float64 s = 0.0;
        int64 c = 0;
        while (c < k) {
            float64 p = (float64) cnt[c] / (float64) n;
            s = s + p * p;
            c = c + 1;
        }
        return 1.0 - s;
    }

    /**
     * Information gain of splitting `(x, y)` on `x[:, feature] <= threshold`:
     * `H(Y) − [P(S₁)H(S₁) + P(S₂)H(S₂)]` (spec §3.1) — the split score of
     * the `entropy` criterion.
     */
    public static float64 informationGain(Tensor<float64> x, Tensor<float64> y,
                                          int64 feature, float64 threshold) {
        int64 n = x.shapeAt(0);
        int64 nf = x.shapeAt(1);
        int64 k = Criteria.classCount(y, n);
        int64[] cl = heap int64[k];
        int64[] cr = heap int64[k];
        int64 nl = 0;
        int64 i = 0;
        while (i < n) {
            int64 c = (int64) y.get1(i);
            if (x.flatGet(i * nf + feature) <= threshold) {
                cl[c] = cl[c] + 1;
                nl = nl + 1;
            } else {
                cr[c] = cr[c] + 1;
            }
            i = i + 1;
        }
        int64 nr = n - nl;
        float64 h = Criteria.entropy(y);
        float64 hl = nl > 0 ? Criteria.entropyOfCounts(cl, k, nl) : 0.0;
        float64 hr = nr > 0 ? Criteria.entropyOfCounts(cr, k, nr) : 0.0;
        return h - ((float64) nl / (float64) n * hl + (float64) nr / (float64) n * hr);
    }
}
