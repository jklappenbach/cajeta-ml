package dev.cajeta.ml.preprocess;

import cajeta.math.Tensor;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.Transformer;

/**
 * Standardize features to zero mean and unit variance (sklearn
 * `StandardScaler`): per-column `(x − μ) / σ`, σ the population (ddof=0)
 * standard deviation, exactly sklearn's. A zero-variance column scales by 1
 * (sklearn's `scale_` convention), so constant features transform to 0.
 */
public final class StandardScaler implements Transformer {

    private Tensor<float64> mean;
    private Tensor<float64> scale;
    private boolean fitted;

    public StandardScaler() {
        this.fitted = false;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("StandardScaler.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64[] sh = heap int64[1];
        sh[0] = p;
        Tensor<float64> mu = Tensor.zeros<float64>(sh);
        Tensor<float64> sc = Tensor.zeros<float64>(sh);
        int64 j = 0;
        while (j < p) {
            float64 acc = 0.0;
            int64 i = 0;
            while (i < n) {
                acc = acc + x.get2(i, j);
                i = i + 1;
            }
            float64 m = acc / (float64) n;
            mu.set1(j, m);
            float64 ss = 0.0;
            i = 0;
            while (i < n) {
                float64 d = x.get2(i, j) - m;
                ss = ss + d * d;
                i = i + 1;
            }
            float64 sd = Math.sqrt(ss / (float64) n);
            if (sd == 0.0) { sd = 1.0; }
            sc.set1(j, sd);
            j = j + 1;
        }
        this.mean #= mu;
        this.scale #= sc;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    public #Tensor<float64> transform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("StandardScaler.transform: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        Tensor<float64> out = x.copy();
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                float64 v = (x.get2(i, j) - this.mean.get1(j)) / this.scale.get1(j);
                out.flatSet(i * p + j, v);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    /** Undo the standardization: `x·σ + μ`. */
    public #Tensor<float64> inverseTransform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("StandardScaler.inverseTransform: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        Tensor<float64> out = x.copy();
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                float64 v = x.get2(i, j) * this.scale.get1(j) + this.mean.get1(j);
                out.flatSet(i * p + j, v);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    public #Tensor<float64> fitTransform(Tensor<float64> x, Tensor<float64> y) {
        this.fit(x, y);
        Tensor<float64> out = this.transform(x);
        return #out;
    }
}
