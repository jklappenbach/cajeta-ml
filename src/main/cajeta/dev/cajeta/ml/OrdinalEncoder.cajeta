package dev.cajeta.ml;

import cajeta.math.Tensor;

/**
 * Ordinal encoding over categorical codes (spec §8.4): each category maps
 * to its integer position under the SORTED order by default, or under an
 * explicit per-column ordering. sklearn's `OrdinalEncoder` refuses
 * unsorted numeric category lists; accepting an explicit order here is a
 * deliberate extension (DifferencesFromSklearn). Unseen categories at
 * transform are always loud. A {@link Transformer} (§8.5).
 */
public final class OrdinalEncoder implements Transformer {

    private boolean hasOrder;
    private Tensor<float64> catsV;      // flattened per-column categories
    private Tensor<int64> offsetsV;     // (p+1,)
    private int64 nIn;
    private boolean fitted;

    public OrdinalEncoder() {
        this.hasOrder = false;
        this.fitted = false;
        return;
    }

    /** Explicit per-column category orderings (position = code). */
    public OrdinalEncoder(#Tensor<float64>[] orderings) {
        this.hasOrder = false;
        int64 p = (int64) orderings.count();
        if (p < 1) {
            throw heap MlException(
                "OrdinalEncoder: at least one column ordering");
        }
        int64 total = 0;
        int64 j = 0;
        while (j < p) {
            total = total + orderings[j].size();
            j = j + 1;
        }
        int64[] os = heap int64[1];
        os[0] = p + 1;
        Tensor<int64> offs = Tensor.zeros<int64>(os);
        int64[] cs = heap int64[1];
        cs[0] = total;
        Tensor<float64> cats = Tensor.zeros<float64>(cs);
        int64 w = 0;
        j = 0;
        while (j < p) {
            int64 m = orderings[j].size();
            int64 c = 0;
            while (c < m) {
                cats.set1(w, orderings[j].flatGet(c));
                w = w + 1;
                c = c + 1;
            }
            offs.set1(j + 1, w);
            j = j + 1;
        }
        this.catsV #= cats;
        this.offsetsV #= offs;
        this.nIn = p;
        this.hasOrder = true;
        this.fitted = false;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException(
                "OrdinalEncoder.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        if (this.hasOrder) {
            if (p != this.nIn) {
                throw heap MlException("OrdinalEncoder.fit: x columns must "
                    + "match the explicit orderings");
            }
            this.fitted = true;
            return;
        }
        this.nIn = p;
        int64[] os = heap int64[1];
        os[0] = p + 1;
        Tensor<int64> offs = Tensor.zeros<int64>(os);
        float64[] all = heap float64[n * p];
        int64 total = 0;
        int64 j = 0;
        while (j < p) {
            float64[] u = heap float64[n];
            int64 cnt = 0;
            int64 i = 0;
            while (i < n) {
                float64 v = x.get2(i, j);
                int64 lo = 0;
                boolean seen = false;
                while (lo < cnt && !seen) {
                    if (u[lo] == v) {
                        seen = true;
                    } else if (u[lo] > v) {
                        break;
                    } else {
                        lo = lo + 1;
                    }
                }
                if (!seen) {
                    int64 m = cnt;
                    while (m > lo) {
                        u[m] = u[m - 1];
                        m = m - 1;
                    }
                    u[lo] = v;
                    cnt = cnt + 1;
                }
                i = i + 1;
            }
            int64 c = 0;
            while (c < cnt) {
                all[total + c] = u[c];
                c = c + 1;
            }
            total = total + cnt;
            offs.set1(j + 1, total);
            j = j + 1;
        }
        int64[] cs = heap int64[1];
        cs[0] = total;
        Tensor<float64> cats = Tensor.zeros<float64>(cs);
        int64 t = 0;
        while (t < total) {
            cats.set1(t, all[t]);
            t = t + 1;
        }
        this.catsV #= cats;
        this.offsetsV #= offs;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    public #Tensor<float64> transform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("OrdinalEncoder.transform: fit first");
        }
        if (x.ndim() != 2 || x.shapeAt(1) != this.nIn) {
            throw heap MlException("OrdinalEncoder.transform: x must be "
                + "(n, p) with p matching the fit");
        }
        int64 n = x.shapeAt(0);
        int64 p = this.nIn;
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = p;
        Tensor<float64> out = Tensor.zeros<float64>(sh);
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                int64 lo = this.offsetsV.get1(j);
                int64 hi = this.offsetsV.get1(j + 1);
                float64 v = x.get2(i, j);
                int64 hit = -1;
                int64 c = lo;
                while (c < hi) {
                    if (this.catsV.get1(c) == v) {
                        hit = c - lo;
                        c = hi;
                    } else {
                        c = c + 1;
                    }
                }
                if (hit < 0) {
                    throw heap MlException("OrdinalEncoder.transform: "
                        + "category unseen at fit time in column "
                        + Int64.of(j).toString());
                }
                out.flatSet(i * p + j, (float64) hit);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    public #Tensor<float64> fitTransform(Tensor<float64> x,
                                         Tensor<float64> y) {
        this.fit(x, y);
        Tensor<float64> out = this.transform(x);
        return #out;
    }
}
