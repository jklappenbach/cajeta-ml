package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.nucleo.sparse.CsrMatrix;

/**
 * L1-regularized least squares (sklearn `Lasso`): exactly
 * {@link ElasticNet} at `l1Ratio = 1` — one objective, one solver, one set
 * of pinned numerics — packaged under the name every sklearn user reaches
 * for. Soft-threshold zeros are exact; `sparsityCount()` reports them.
 */
public final class Lasso implements Predictor {

    private ElasticNet inner;

    public Lasso(float64 alpha, boolean fitIntercept, float64 tol,
                 int64 maxIter) {
        this.inner #= heap ElasticNet(alpha, 1.0, fitIntercept, tol, maxIter);
        return;
    }

    /** sklearn defaults: fitIntercept, tol 1e-4, maxIter 1000. */
    public Lasso(float64 alpha) {
        this.inner #= heap ElasticNet(alpha, 1.0);
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        this.inner.fit(x, y);
        return;
    }

    /** Sparse fit — see {@link ElasticNet#fitSparse} (fitIntercept=false only). */
    public void fitSparse(CsrMatrix x, Tensor<float64> y) {
        this.inner.fitSparse(x, y);
        return;
    }

    public boolean isFitted() {
        return this.inner.isFitted();
    }

    public #Tensor<float64> predict(Tensor<float64> x) {
        return this.inner.predict(x);
    }

    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        return this.inner.score(x, y);
    }

    public Tensor<float64> coef() { return this.inner.coef(); }

    public float64 intercept() { return this.inner.intercept(); }

    public int64 sparsityCount() { return this.inner.sparsityCount(); }

    public int64 iterations() { return this.inner.iterations(); }

    public boolean converged() { return this.inner.converged(); }
}
