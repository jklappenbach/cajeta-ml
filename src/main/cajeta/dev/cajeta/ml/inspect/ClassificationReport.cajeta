package dev.cajeta.ml.inspect;

import cajeta.math.Tensor;

/**
 * Per-class precision, recall, F1, and support, plus macro and weighted
 * averages — sklearn's `classification_report` shape (spec §10.3), and
 * therefore the shape parity fixtures compare in. Macro averages weight
 * every class equally; weighted averages weight by support. Built by
 * {@link Metrics#classificationReport}.
 */
public final class ClassificationReport {

    private Tensor<float64> precV;   // (k,)
    private Tensor<float64> recV;    // (k,)
    private Tensor<float64> f1V;     // (k,)
    private Tensor<int64> supV;      // (k,)
    private int64 k;
    private int64 n;

    ClassificationReport(#Tensor<float64> precision, #Tensor<float64> recall,
                         #Tensor<float64> f1, #Tensor<int64> support,
                         int64 nClasses, int64 total) {
        this.precV #= precision;
        this.recV #= recall;
        this.f1V #= f1;
        this.supV #= support;
        this.k = nClasses;
        this.n = total;
        return;
    }

    public int64 classes() {
        return this.k;
    }

    public float64 precision(int64 c) {
        return this.precV.get1(c);
    }

    public float64 recall(int64 c) {
        return this.recV.get1(c);
    }

    public float64 f1(int64 c) {
        return this.f1V.get1(c);
    }

    /** True-label count of class `c`. */
    public int64 support(int64 c) {
        return this.supV.get1(c);
    }

    public int64 totalSupport() {
        return this.n;
    }

    public float64 macroPrecision() {
        return this.macroOf(this.precV);
    }

    public float64 macroRecall() {
        return this.macroOf(this.recV);
    }

    public float64 macroF1() {
        return this.macroOf(this.f1V);
    }

    public float64 weightedPrecision() {
        return this.weightedOf(this.precV);
    }

    public float64 weightedRecall() {
        return this.weightedOf(this.recV);
    }

    public float64 weightedF1() {
        return this.weightedOf(this.f1V);
    }

    float64 macroOf(Tensor<float64> v) {
        float64 acc = 0.0;
        int64 c = 0;
        while (c < this.k) {
            acc = acc + v.get1(c);
            c = c + 1;
        }
        return acc / (float64) this.k;
    }

    float64 weightedOf(Tensor<float64> v) {
        float64 acc = 0.0;
        int64 c = 0;
        while (c < this.k) {
            acc = acc + v.get1(c) * (float64) this.supV.get1(c);
            c = c + 1;
        }
        return acc / (float64) this.n;
    }
}
