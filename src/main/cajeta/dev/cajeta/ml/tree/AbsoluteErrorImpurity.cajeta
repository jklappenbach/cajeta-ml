package dev.cajeta.ml.tree;

/**
 * Absolute-error impurity; leaves predict the MEDIAN (even count: the
 * middle-pair average) — sklearn's MAE criterion (ml-trees-ensembles U2).
 * `weighted` = `Σ|y - median(slice)|`, the outlier-robust criterion: on the
 * pinned fixture the AE leaf says 43 where the mean is dragged to 53.8.
 */
final class AbsoluteErrorImpurity implements Impurity {

    AbsoluteErrorImpurity() { return; }

    /** Weighted median: sort by value, walk to half the total weight; a
     *  boundary landing exactly on half averages the two middle values —
     *  which reduces to the classic even-count median under unit weights. */
    static float64 medianOf(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        int64 m = hi - lo;
        float64[] v = heap float64[m];
        int64[] idx = heap int64[m];
        int64 i = 0;
        while (i < m) { v[i] = ys[lo + i]; idx[i] = lo + i; i = i + 1; }
        Trees.sortPairs(v, idx, m);
        float64 total = 0.0;
        i = 0;
        while (i < m) { total = total + ws[idx[i]]; i = i + 1; }
        float64 half = total / 2.0;
        float64 run = 0.0;
        i = 0;
        while (i < m) {
            run = run + ws[idx[i]];
            if (run > half) { return v[i]; }
            if (run == half) {
                if (i + 1 < m) { return v[i] / 2.0 + v[i + 1] / 2.0; }
                return v[i];
            }
            i = i + 1;
        }
        return v[m - 1];
    }

    public float64 weighted(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64 med = AbsoluteErrorImpurity.medianOf(ys, ws, lo, hi);
        float64 acc = 0.0;
        int64 i = lo;
        while (i < hi) {
            float64 d = ys[i] - med;
            if (d < 0.0) { d = -d; }
            acc = acc + ws[i] * d;
            i = i + 1;
        }
        return acc;
    }

    public boolean validSplit(float64[] ys, float64[] ws, int64 lo, int64 mid, int64 hi) {
        return true;
    }

    public float64 weightedN(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64 wsum = 0.0;
        int64 i = lo;
        while (i < hi) { wsum = wsum + ws[i]; i = i + 1; }
        return wsum;
    }

    public int64 width() {
        return 1;
    }

    public void leafInto(float64[] ys, float64[] ws, int64 lo, int64 hi, float64[] value, int64 off) {
        value[off] = AbsoluteErrorImpurity.medianOf(ys, ws, lo, hi);
        return;
    }
}
