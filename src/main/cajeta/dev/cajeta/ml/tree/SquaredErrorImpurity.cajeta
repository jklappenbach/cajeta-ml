package dev.cajeta.ml.tree;

/**
 * Squared-error (variance) impurity; leaves predict the mean
 * (ml-trees-ensembles U2). `weighted` = `Σ(y - mean)²` — sklearn's MSE
 * criterion up to its proxy transform, same ordering.
 */
final class SquaredErrorImpurity implements Impurity {

    SquaredErrorImpurity() { return; }

    public float64 weighted(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64 wsum = 0.0;
        float64 sum = 0.0;
        int64 i = lo;
        while (i < hi) { wsum = wsum + ws[i]; sum = sum + ws[i] * ys[i]; i = i + 1; }
        float64 mean = sum / wsum;
        float64 acc = 0.0;
        i = lo;
        while (i < hi) {
            float64 d = ys[i] - mean;
            acc = acc + ws[i] * d * d;
            i = i + 1;
        }
        return acc;
    }

    public boolean validSplit(float64[] ys, float64[] ws, int64 lo, int64 mid, int64 hi) {
        return true;
    }

    public float64 weightedN(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64 wsum = 0.0;
        int64 i = lo;
        while (i < hi) { wsum = wsum + ws[i]; i = i + 1; }
        return wsum;
    }

    public int64 width() {
        return 1;
    }

    public void leafInto(float64[] ys, float64[] ws, int64 lo, int64 hi, float64[] value, int64 off) {
        float64 wsum = 0.0;
        float64 sum = 0.0;
        int64 i = lo;
        while (i < hi) { wsum = wsum + ws[i]; sum = sum + ws[i] * ys[i]; i = i + 1; }
        value[off] = sum / wsum;
        return;
    }
}
