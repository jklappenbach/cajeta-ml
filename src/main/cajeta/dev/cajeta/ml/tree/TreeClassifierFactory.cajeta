package dev.cajeta.ml.tree;

import cajeta.math.Tensor;
import dev.cajeta.ml.EstimatorFactory;
import dev.cajeta.ml.Predictor;

/**
 * {@link EstimatorFactory} for {@link DecisionTreeClassifier} (gini):
 * `params[0]` = maxDepth (0 = unbounded). The bagging/forest base-estimator
 * builder (ml-trees-ensembles U5), also usable by GridSearch.
 */
public final class TreeClassifierFactory implements EstimatorFactory {

    public TreeClassifierFactory() { return; }

    public #Predictor create(Tensor<float64> params) {
        int64 maxDepth = params.shapeAt(0) > 0 ? (int64) params.flatGet(0) : (int64) 0;
        return heap DecisionTreeClassifier("gini", maxDepth);
    }
}
