package dev.cajeta.ml.train;

/**
 * Configuration for {@link SpelaTrainer} — a port of the reference
 * implementation's `SpelaConfig` (`code/ml/spela-training`), field for
 * field, so a recipe transfers between the two without translation.
 *
 * Two recipes matter:
 *
 * - **Paper-exact** (Algorithm 1): `optimizer = SGD`, `lossType = COSINE`,
 *   `normalizeLayerInputs = true`, `lrSchedule = CONSTANT`, typically
 *   `lr = 1e-2`. Pure `−cos(h, e[y])`, which only pulls activations
 *   TOWARD the target class vector.
 * - **Modernized** (the reference's defaults, and these): AdamW with
 *   weight decay, warmup→cosine schedule, and the CosFace loss —
 *   cross-entropy over cosines to ALL class vectors, so non-target
 *   classes are actively pushed away. That difference is most of the gap
 *   to backprop.
 */
public final class SpelaConfig {

    /** `optimizer` values. */
    public static int32 ADAMW = 0;
    public static int32 SGD = 1;

    /** `lossType` values. */
    public static int32 COSINE = 0;
    public static int32 COSFACE = 1;

    /** `lrSchedule` values. */
    public static int32 CONSTANT = 0;
    public static int32 COSINE_DECAY = 1;

    /** `embeddingsMethod` values. */
    public static int32 FARTHEST = 0;
    public static int32 RANDOM = 1;

    public int64 numClasses;
    public int32 optimizer;
    public float32 lr;
    public float32 weightDecay;
    public float32 momentum;
    public int32 lrSchedule;
    public float64 warmupFrac;
    public float64 minLrRatio;
    public int32 lossType;
    public float64 cosineMargin;
    public float64 cosineScale;
    public int32 embeddingsMethod;
    public int64 embeddingsCandidates;
    public boolean normalizeLayerInputs;
    public boolean autoFlatten;
    public float32 gradClipNorm;
    public uint64 seed;

    // ── the production surface (spec §5.3) ──────────────────────────────

    /** Examples buffered per gradient step in `observe()` mode. */
    public int32 onlineBufferSize;
    /** Force a step after this many observations even if the buffer is
     *  not full (0 = never) — the straggler guard for a stream that goes
     *  quiet before filling a batch. */
    public int32 onlineFlushEvery;

    /** When true, an UNLABELLED observation is pseudo-labelled with the
     *  model's own prediction — but only above `confidenceThreshold`. */
    public boolean selfDistill;
    /** Minimum top-1 cosine for a pseudo-label to be trusted. Below it
     *  the observation is skipped and counted, not trained on with a
     *  guess. */
    public float64 confidenceThreshold;

    /** Snapshot the weights at construction and pull back toward them —
     *  L2-SP, the cheap catastrophic-forgetting guard. */
    public boolean anchorToInit;
    /** Strength of that pull; 1e-3 … 1e-2 is the useful range. */
    public float64 anchorLambda;

    /** Per-layer learning-rate scale (empty = all 1.0) — a slow backbone
     *  under a fast head. */
    public float32[] lrMultipliers;
    /** Train layer i only every `updateCadences[i]` observations (empty
     *  or 1 = every step) — a stronger form of the same idea. */
    public int32[] updateCadences;

    /** The reference's defaults — the MODERNIZED recipe. */
    public SpelaConfig(int64 numClasses) {
        this.numClasses = numClasses;
        this.optimizer = SpelaConfig.ADAMW;
        this.lr = 0.001f;
        this.weightDecay = 0.0001f;
        this.momentum = 0.0f;
        this.lrSchedule = SpelaConfig.COSINE_DECAY;
        this.warmupFrac = 0.05;
        this.minLrRatio = 0.0;
        this.lossType = SpelaConfig.COSFACE;
        this.cosineMargin = 0.0;
        this.cosineScale = 30.0;
        this.embeddingsMethod = SpelaConfig.FARTHEST;
        this.embeddingsCandidates = 2048;
        this.normalizeLayerInputs = true;
        this.autoFlatten = true;
        this.gradClipNorm = 0.0f;
        this.seed = 0;
        this.onlineBufferSize = 8;
        this.onlineFlushEvery = 0;
        this.selfDistill = false;
        this.confidenceThreshold = 0.7;
        this.anchorToInit = false;
        this.anchorLambda = 0.0;
        this.lrMultipliers = heap float32[0];
        this.updateCadences = heap int32[0];
        return;
    }

    /** Switch this config to the PAPER-EXACT recipe (Algorithm 1). */
    public SpelaConfig paperExact() {
        this.optimizer = SpelaConfig.SGD;
        this.lr = 0.01f;
        this.weightDecay = 0.0f;
        this.momentum = 0.0f;
        this.lrSchedule = SpelaConfig.CONSTANT;
        this.lossType = SpelaConfig.COSINE;
        this.normalizeLayerInputs = true;
        return this;
    }
}
