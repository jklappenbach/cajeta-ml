package dev.cajeta.ml.nn;

import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;

/**
 * Inverted dropout: in training each unit is zeroed with probability `p`
 * and the survivors are scaled by 1/(1−p), so the layer is the identity in
 * expectation and evaluation needs no rescaling. In evaluation it IS the
 * identity.
 *
 * The mask is drawn from an explicit seeded Philox stream (no global RNG),
 * and the seed advances once per forward — so a run is reproducible end to
 * end, but successive batches do not all see the same mask, which would
 * quietly destroy the regularization. {@link #resetStream} rewinds it,
 * which is what lets a test pin two runs against each other.
 *
 * Dropout owns no parameters; it is mode-sensitive compute only. Mode comes
 * from the module tree (`train()`/`eval()` on the root), not a global.
 */
public class Dropout extends Module {
    float64 p;
    uint64 seed;
    uint64 step;

    /** @EntryPoint */
    public Dropout(float64 p, uint64 seed) {
        this.p = p;
        this.seed = seed;
        this.step = 0;
        return;
    }

    /** Rewind the mask stream to its seed. */
    public void resetStream() {
        this.step = 0;
        return;
    }

    public float64 rate() {
        return this.p;
    }

    public GradTensor forward(GradTape<float32> tape, GradTensor x) {
        if (!this.training) {
            return tape.dropout(x, this.p, false, this.seed);
        }
        uint64 s = this.seed + this.step;
        this.step = this.step + 1;
        return tape.dropout(x, this.p, true, s);
    }
}
