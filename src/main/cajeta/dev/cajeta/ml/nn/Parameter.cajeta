package dev.cajeta.ml.nn;

import cajeta.math.Tensor;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;

/**
 * Parameter — an **optimizable** `float32` tensor owned by a {@link Module}.
 * The newtype is the whole point: "this tensor trains" is type-visible, so
 * parameter collection is a typed field walk (`instanceof Parameter`), and a
 * plain `Tensor<float32>` field on the same module is a **buffer**
 * (enumerated by `Module.buffers()`, never updated by an optimizer).
 *
 * The parameter OWNS its tensor; an optimizer borrows the parameter and
 * updates the tensor's values in place through {@link #get}.
 *
 * **Tape binding (v3).** A module's forward runs over a {@link GradTape},
 * which addresses values by node handle. {@link #bind} records this
 * parameter's tensor as a tape leaf and remembers the handle, so every
 * reference to the parameter inside one forward pass resolves to the SAME
 * node — which is what makes a parameter used twice accumulate one summed
 * gradient. The handle is per-pass state: rebinding to a new tape replaces
 * it, and {@link #node} before any bind is an error rather than a silently
 * wrong node 0.
 *
 * {@link #requiresGrad} is per-parameter and consulted at bind time —
 * a frozen parameter binds as a constant leaf, so it takes part in the
 * forward but receives no gradient (LoRA and SPELA per-layer freezing both
 * ride this).
 *
 * ```cajeta
 * Parameter w = heap Parameter(Tensor.zeros<float32>(shape));
 * w.get().set1(0, 0.5f);            // in-place update through the borrow
 * ```
 *
 * v1 is float32-only (the nn core is non-generic): `instanceof`/casts with an
 * IDENTIFIER template argument mis-parse inside templates, and a concrete
 * class extending an instantiated template base does not resolve inherited
 * members — both recorded compiler gaps.
 */
public class Parameter {
    Tensor<float32> value;
    int32 boundNode;
    boolean requiresGrad;

    /** Wrap an owned tensor as an optimizable parameter (takes ownership). */
    public Parameter(#Tensor<float32> value) {
        this.value #= value;
        this.boundNode = -1;
        this.requiresGrad = true;
    }

    /** The underlying tensor, as a borrow — read it, or update it in place. */
    public Tensor<float32> get() {
        return this.value;
    }

    /** False freezes the parameter: it still participates in the forward,
     *  but binds as a constant and collects no gradient. */
    public boolean isTrainable() {
        return this.requiresGrad;
    }

    public void setTrainable(boolean trainable) {
        this.requiresGrad = trainable;
        return;
    }

    /** Record this parameter as a leaf of `tape` and remember the handle. */
    public GradTensor bind(GradTape<float32> tape) {
        GradTensor t = tape.leaf(this.value, this.requiresGrad);
        this.boundNode = t.index();
        return t;
    }

    /** This parameter's node on the tape it was last bound to. */
    public GradTensor node() {
        if (this.boundNode < 0) {
            throw heap MlException("Parameter.node: not bound to a tape — "
                + "call Module.bindParameters(tape) before forward");
        }
        return stack GradTensor(this.boundNode);
    }

    /** Forget the tape binding (the tape it referred to is gone). */
    public void unbind() {
        this.boundNode = -1;
        return;
    }
}
