package dev.cajeta.ml.nn;

import cajeta.math.Tensor;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;
import dev.cajeta.ml.grad.Ops;

/**
 * Scaled dot-product self-attention with multiple heads, over
 * `(batch, seq, embed)` input.
 *
 * ```
 * q,k,v = xWq, xWk, xWv            split into H heads of width D = E/H
 * attn  = softmax(qkᵀ / √D)        per head, over the key axis
 * out   = (attn·v) merged · Wo
 * ```
 *
 * The heads are never split out of the projections. The scores read each
 * head of the `(B·T, E)` query and key projections where it sits and come
 * out `(B·H, Tq, Tk)`, and the context reads the value heads the same way
 * and is written straight into merged `(B·Tq, E)` rows, so on the device
 * neither direction copies an activation to move the head axis.
 *
 * Projections are `Linear` sub-modules, so parameter names come out as
 * `wq.weight`, `wq.bias`, … — one dotted level per projection, the same
 * shape torch produces for an attention block written with `nn.Linear`
 * projections (torch's own `nn.MultiheadAttention` fuses qkv into one
 * `in_proj_weight` instead; a checkpoint from that layout needs the
 * split, which is `ml.io`'s business).
 *
 * Self-attention by default; §13.3 adds MASKS and CROSS-ATTENTION as
 * entry points on the same core ({@link #forwardMasked},
 * {@link #forwardCross}) — one attention implementation, never a fork.
 * Masks are ADDITIVE `(B, Tq, Tk)` float32 tensors (0 = attend,
 * `Masks.NEG` = blocked; `exp(NEG)` underflows to exactly 0 in float32,
 * so a blocked weight is exactly 0 and its gradient path is exactly 0).
 * The most recent forward's attention weights are readable via
 * {@link #lastAttentionNode} — §13.3.2's structural verification hook.
 */
public class MultiheadAttention extends Module {
    // Module, not Linear: a LoRA-adapted projection COMPOSES a Linear
    // rather than extending it (the module walk does not see inherited
    // fields), so the field type has to be the common base.
    Module wq;
    Module wk;
    Module wv;
    Module wo;
    int32 heads;
    int64 embed;
    // The softmaxed (B·H, Tq, Tk) weights of the most recent forward — a
    // tape-node INDEX (GradTensor is a value record; storing the raw
    // index keeps this invisible to the parameter/buffer walks). -1
    // until a forward has run.
    int32 lastAttnIdx;

    public MultiheadAttention(int64 embed, int32 heads, uint64 seed) {
        if (embed % (int64) heads != 0) {
            throw heap MlException("MultiheadAttention: embed " + embed
                + " is not divisible by heads " + heads);
        }
        this.lastAttnIdx = -1;
        this.wq = heap Linear(embed, embed, seed);
        this.wk = heap Linear(embed, embed, seed + 1);
        this.wv = heap Linear(embed, embed, seed + 2);
        this.wo = heap Linear(embed, embed, seed + 3);
        this.heads = heads;
        this.embed = embed;
        return;
    }

    /**
     * The LoRA-adapted form: every projection is a {@link LoraLinear}.
     * It is a `Module` like any other layer, so nothing else about the block
     * changes except the names, which gain the wrapper's level:
     * `wq.base.weight` and `wq.base.bias` for the frozen projection,
     * `wq.loraA` / `wq.loraB` for the adapter.
     *
     * Adapting the projections is where LoRA earns its keep in a
     * transformer: they are the bulk of a block's parameters.
     */
    public MultiheadAttention(int64 embed, int32 heads, int64 rank,
                              float32 alpha, uint64 seed) {
        if (embed % (int64) heads != 0) {
            throw heap MlException("MultiheadAttention: embed " + embed
                + " is not divisible by heads " + heads);
        }
        this.lastAttnIdx = -1;
        this.wq = heap LoraLinear(embed, embed, rank, alpha, seed);
        this.wk = heap LoraLinear(embed, embed, rank, alpha, seed + 1);
        this.wv = heap LoraLinear(embed, embed, rank, alpha, seed + 2);
        this.wo = heap LoraLinear(embed, embed, rank, alpha, seed + 3);
        this.heads = heads;
        this.embed = embed;
        return;
    }

    /** Freeze every projection's base weights, leaving only the LoRA
     *  adapters trainable. No-op on a block built without adapters. */
    public void freezeBaseProjections() {
        MultiheadAttention.freezeIfLora(this.wq);
        MultiheadAttention.freezeIfLora(this.wk);
        MultiheadAttention.freezeIfLora(this.wv);
        MultiheadAttention.freezeIfLora(this.wo);
        return;
    }

    static void freezeIfLora(Module l) {
        if (l instanceof LoraLinear ll) {
            ll.freezeBase();
        }
        return;
    }

    static #int64[] shape2(int64 a, int64 b) {
        int64[] s = heap int64[2];
        s[0] = a; s[1] = b;
        return #s;
    }

    static #int64[] shape3(int64 a, int64 b, int64 c) {
        int64[] s = heap int64[3];
        s[0] = a; s[1] = b; s[2] = c;
        return #s;
    }

    public GradTensor forward(GradTape<float32> tape, GradTensor x) {
        int64[] none = heap int64[1];
        none[0] = 1;
        Tensor<float32> noMask #= Tensor.zeros<float32>(none);
        return this.attend(tape, x, x, false, noMask);
    }

    /** Self-attention under an additive `(B, T, T)` mask (§13.3.2). */
    public GradTensor forwardMasked(GradTape<float32> tape, GradTensor x,
                                    Tensor<float32> mask) {
        return this.attend(tape, x, x, true, mask);
    }

    /** Cross-attention (§13.3.1): queries from `x (B, Tq, E)`, keys and
     *  values from `memory (B, Tk, E)` — the encoder outputs — under an
     *  optional-by-shape additive `(B, Tq, Tk)` mask. */
    public GradTensor forwardCross(GradTape<float32> tape, GradTensor x,
                                   GradTensor memory,
                                   Tensor<float32> mask) {
        return this.attend(tape, x, memory, true, mask);
    }

    /** The softmaxed `(B·H, Tq, Tk)` attention weights of the most recent
     *  forward on this block — read with `tape.valueOf` while the tape is
     *  live. The §13.3.2 hook: assert structure, don't assume it. */
    public GradTensor lastAttentionNode() {
        if (this.lastAttnIdx < 0) {
            throw heap MlException("MultiheadAttention.lastAttentionNode: "
                + "no forward has run");
        }
        return stack GradTensor(this.lastAttnIdx);
    }

    /** The one attention core every entry point shares. */
    GradTensor attend(GradTape<float32> tape, GradTensor qIn,
                      GradTensor kvIn, boolean hasMask,
                      Tensor<float32> mask) {
        Tensor<float32> qv = tape.valueOf(qIn);
        Tensor<float32> kv = tape.valueOf(kvIn);
        if (qv.ndim() != 3 || kv.ndim() != 3) {
            throw heap MlException("MultiheadAttention: expected "
                + "(batch, seq, embed) inputs");
        }
        int64 b = qv.shapeAt(0);
        int64 tq = qv.shapeAt(1);
        int64 tk = kv.shapeAt(1);
        if (qv.shapeAt(2) != this.embed || kv.shapeAt(2) != this.embed
            || kv.shapeAt(0) != b) {
            throw heap MlException("MultiheadAttention: shape mismatch — "
                + "layer embed " + this.embed);
        }
        if (hasMask && (mask.ndim() != 3 || mask.shapeAt(0) != b
            || mask.shapeAt(1) != tq || mask.shapeAt(2) != tk)) {
            throw heap MlException("MultiheadAttention: mask must be "
                + "(batch, Tq, Tk)");
        }
        int64 d = this.embed / (int64) this.heads;

        // Project on the flattened token axis: the projections are ordinary
        // rank-2 matmuls over (B·T, E).
        int64[] qFlatS #= MultiheadAttention.shape2(b * tq, this.embed);
        GradTensor qFlat = tape.reshape(qIn, qFlatS);
        int64[] kFlatS #= MultiheadAttention.shape2(b * tk, this.embed);
        GradTensor kFlat = tape.reshape(kvIn, kFlatS);
        GradTensor q = this.wq.forward(tape, qFlat);
        GradTensor k = this.wk.forward(tape, kFlat);
        GradTensor v = this.wv.forward(tape, kFlat);

        // scores = q · kᵀ / √D (+ mask), softmaxed over the key axis.
        float32 inv = 1.0f / Math.sqrt((float32) d);
        GradTensor scaled = tape.headScores(q, k, b, this.heads, inv);
        if (hasMask) {
            // Tile (B, Tq, Tk) per head: (B·H, Tq, Tk), a constant leaf.
            int64[] ms #= MultiheadAttention.shape3(
                b * (int64) this.heads, tq, tk);
            Tensor<float32> tiled #= Tensor.zeros<float32>(ms);
            Tensor<float32> src = mask;
            Tensor<float32> hostMask;
            if (mask.isOnGpu()) {
                hostMask #= Ops.copyOf<float32>(mask);
                hostMask.cpu();
                src = hostMask;
            }
            int64 bi = 0;
            while (bi < b) {
                int64 h = 0;
                while (h < (int64) this.heads) {
                    int64 e = 0;
                    while (e < tq * tk) {
                        tiled.flatSet(((bi * (int64) this.heads + h)
                            * tq * tk) + e, src.flatGet(bi * tq * tk + e));
                        e = e + 1;
                    }
                    h = h + 1;
                }
                bi = bi + 1;
            }
            if (tape.valueOf(scaled).isOnGpu()) {
                tiled.gpu();
            }
            GradTensor maskLeaf = tape.leaf(tiled, false);
            scaled = tape.add(scaled, maskLeaf);
        }
        GradTensor attn = tape.softmax(scaled);
        this.lastAttnIdx = attn.index();

        GradTensor merged = tape.headContext(attn, v, this.heads);
        GradTensor out = this.wo.forward(tape, merged);
        int64[] s3 #= MultiheadAttention.shape3(b, tq, this.embed);
        return tape.reshape(out, s3);
    }
}
