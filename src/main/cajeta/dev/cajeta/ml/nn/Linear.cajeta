package dev.cajeta.ml.nn;

import cajeta.math.Tensor;
import dev.cajeta.ml.grad.GradTape;
import dev.cajeta.ml.grad.GradTensor;

/**
 * The affine map `x · W + b`, `x : [batch, in]`.
 *
 * WEIGHT LAYOUT is `[in, out]` — the natural orientation for `x · W`, and
 * the TRANSPOSE of torch's `nn.Linear.weight` (`[out, in]`, which exists
 * because torch computes `x · Wᵀ`). Parameter NAMES match torch
 * (`weight`, `bias`) so a `state_dict` key list transfers unchanged; the
 * checkpoint reader (`ml.io`) transposes on load. Recorded here because it
 * is the one place a torch user's intuition will mismatch.
 *
 * Initialization is torch's `nn.Linear` default: uniform over
 * ±1/√in_features for the weight, zeros for the bias, drawn from an
 * EXPLICIT seeded Philox generator (see {@link Init}) — reproducible by
 * construction, no global RNG. Same seed, same weights.
 */
public class Linear extends Module {
    Parameter weight;
    Parameter bias;

    /** @EntryPoint */
    public Linear(int64 inFeatures, int64 outFeatures, uint64 seed) {
        int64[] ws = heap int64[2];
        ws[0] = inFeatures;
        ws[1] = outFeatures;
        this.weight = heap Parameter(Init.uniformBound(ws, inFeatures, seed));
        int64[] bs = heap int64[1];
        bs[0] = outFeatures;
        this.bias = heap Parameter(Tensor.zeros<float32>(bs));
        return;
    }

    public Parameter weightParam() {
        return this.weight;
    }

    public Parameter biasParam() {
        return this.bias;
    }

    public GradTensor forward(GradTape<float32> tape, GradTensor x) {
        return tape.add(tape.matmul(x, this.weight.node()), this.bias.node());
    }

    /** Inference convenience — the same forward on a throwaway tape. */
    public #Tensor<float32> forward(Tensor<float32> x) {
        return this.predict(x);
    }
}
