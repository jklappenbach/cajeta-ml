package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.distance.Metric;

/**
 * k-nearest-neighbors classification (sklearn `KNeighborsClassifier`):
 * brute-force with any {@link cajeta.math.distance.Metric} (euclidean
 * default, spec §5.1), `uniform` or `distance` vote weights (§5.3 —
 * sklearn's zero-distance rule: exact matches take all the weight, §5.4).
 * `predictProba` = (weighted) vote fractions, argmax ties to the LOWEST
 * label (§5.5, sklearn's argmax does the same). Integer labels `0..K-1`.
 */
public final class KNeighborsClassifier implements ProbClassifier {

    private int64 kNeighbors;
    private boolean distanceWeights;
    private Metric metricM;             // hasMetric gates every use
    private boolean hasMetric;
    private Tensor<float64> trainX;     // (n, p)
    private Tensor<float64> trainY;     // (n,)
    private int64 nClasses;
    private boolean fitted;

    public KNeighborsClassifier(int64 k) {
        if (k < 1) {
            throw heap MlException("KNeighborsClassifier: k must be >= 1");
        }
        this.kNeighbors = k;
        this.distanceWeights = false;
        this.hasMetric = false;
        this.fitted = false;
        return;
    }

    /** Distance-weighted votes under the default euclidean (§5.3). */
    public KNeighborsClassifier(int64 k, boolean distanceWeights) {
        if (k < 1) {
            throw heap MlException("KNeighborsClassifier: k must be >= 1");
        }
        this.kNeighbors = k;
        this.distanceWeights = distanceWeights;
        this.hasMetric = false;
        this.fitted = false;
        return;
    }

    /** Any stdlib or caller-defined metric through the §5.6 seam. */
    public KNeighborsClassifier(int64 k, #Metric metric) {
        if (k < 1) {
            throw heap MlException("KNeighborsClassifier: k must be >= 1");
        }
        this.kNeighbors = k;
        this.distanceWeights = false;
        this.metricM #= metric;
        this.hasMetric = true;
        this.fitted = false;
        return;
    }

    /** Metric + distance weighting together. */
    public KNeighborsClassifier(int64 k, #Metric metric,
                                boolean distanceWeights) {
        if (k < 1) {
            throw heap MlException("KNeighborsClassifier: k must be >= 1");
        }
        this.kNeighbors = k;
        this.distanceWeights = distanceWeights;
        this.metricM #= metric;
        this.hasMetric = true;
        this.fitted = false;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException(
                "KNeighborsClassifier.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        if (y.ndim() != 1 || y.shapeAt(0) != n) {
            throw heap MlException(
                "KNeighborsClassifier.fit: y must be (n,) matching x rows");
        }
        if (n < this.kNeighbors) {
            throw heap MlException("KNeighborsClassifier.fit: n < k");
        }
        int64 kmax = 0;
        int64 i = 0;
        while (i < n) {
            float64 v = y.get1(i);
            int64 li = (int64) v;
            if (v != (float64) li || li < 0) {
                throw heap MlException("KNeighborsClassifier.fit: labels "
                    + "must be integers 0..K-1");
            }
            if (li > kmax) { kmax = li; }
            i = i + 1;
        }
        this.nClasses = kmax + 1;
        if (this.nClasses < 2) { this.nClasses = 2; }
        Tensor<float64> cx = x.copy();
        Tensor<float64> cy = y.copy();
        this.trainX #= cx;
        this.trainY #= cy;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** `(n, K)` vote fractions. */
    public #Tensor<float64> predictProba(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException(
                "KNeighborsClassifier.predictProba: fit first");
        }
        int64 p = this.trainX.shapeAt(1);
        if (x.ndim() != 2 || x.shapeAt(1) != p) {
            throw heap MlException("KNeighborsClassifier.predictProba: x "
                + "must be (n, p) with p matching the fit");
        }
        int64 n = x.shapeAt(0);
        int64 k = this.kNeighbors;
        int64 kc = this.nClasses;
        int64[] idx = heap int64[k];
        float64[] d2 = heap float64[k];
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = kc;
        Tensor<float64> out = Tensor.zeros<float64>(sh);
        int64 i = 0;
        while (i < n) {
            if (this.hasMetric) {
                KNeighborsRegressor.nearestWith(this.trainX, x, i, k,
                    this.metricM, idx, d2);
                int64 s0 = 0;
                while (s0 < k) {
                    d2[s0] = d2[s0] * d2[s0];
                    s0 = s0 + 1;
                }
            } else {
                KNeighborsRegressor.nearest(this.trainX, x, i, k, idx, d2);
            }
            if (!this.distanceWeights) {
                int64 s = 0;
                while (s < k) {
                    int64 ix = idx[s];
                    int64 lab = (int64) this.trainY.get1(ix);
                    out.flatSet(i * kc + lab,
                        out.get2(i, lab) + 1.0 / (float64) k);
                    s = s + 1;
                }
            } else {
                // §5.4: exact matches take all the weight, uniformly
                // among themselves (the regressor's rule).
                int64 zeros = 0;
                int64 s = 0;
                while (s < k) {
                    if (d2[s] == 0.0) {
                        zeros = zeros + 1;
                    }
                    s = s + 1;
                }
                float64 wsum = 0.0;
                float64[] w = heap float64[k];
                s = 0;
                while (s < k) {
                    if (zeros > 0) {
                        if (d2[s] == 0.0) {
                            w[s] = 1.0;
                        } else {
                            w[s] = 0.0;
                        }
                    } else {
                        w[s] = 1.0 / Math.sqrt(d2[s]);
                    }
                    wsum = wsum + w[s];
                    s = s + 1;
                }
                s = 0;
                while (s < k) {
                    int64 ix = idx[s];
                    int64 lab = (int64) this.trainY.get1(ix);
                    out.flatSet(i * kc + lab,
                        out.get2(i, lab) + w[s] / wsum);
                    s = s + 1;
                }
            }
            i = i + 1;
        }
        return #out;
    }

    /** Vote argmax per row (lowest label on ties). */
    public #Tensor<float64> predict(Tensor<float64> x) {
        Tensor<float64> pr = this.predictProba(x);
        int64 n = pr.shapeAt(0);
        int64 kc = pr.shapeAt(1);
        float64[] out = heap float64[n];
        int64 i = 0;
        while (i < n) {
            int64 best = 0;
            float64 bv = pr.get2(i, 0);
            int64 c = 1;
            while (c < kc) {
                if (pr.get2(i, c) > bv) { bv = pr.get2(i, c); best = c; }
                c = c + 1;
            }
            out[i] = (float64) best;
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = n;
        return Tensor.of<float64>(out, sh);
    }

    /** Accuracy — the classifier `score` convention. */
    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        Tensor<float64> pred = this.predict(x);
        return Metrics.accuracy(y, pred);
    }
}
