package dev.cajeta.ml;

import cajeta.math.Tensor;

/**
 * One-hot encoding over categorical codes in a numeric tensor (spec §8.1,
 * resolved §11.1 — tensors, the `Table` route deferred): one indicator
 * column per observed category, categories in SORTED order per input
 * column, output columns concatenated column-major — sklearn
 * `OneHotEncoder`'s layout. `dropFirst` drops each column's first
 * category (§8.2, intercept-friendly). An unseen category at transform
 * raises by default; the explicit ignore policy encodes all-zero (§8.3,
 * sklearn `handle_unknown='ignore'`). A {@link Transformer}, so it
 * composes in {@link Pipeline} with per-fold refits (§8.5).
 */
public final class OneHotEncoder implements Transformer {

    private boolean dropFirst;
    private boolean ignoreUnknown;
    private Tensor<float64> catsV;      // flattened per-column categories
    private Tensor<int64> offsetsV;     // (p+1,) category offsets
    private int64 nIn;
    private boolean fitted;

    public OneHotEncoder() {
        this.dropFirst = false;
        this.ignoreUnknown = false;
        this.fitted = false;
        return;
    }

    public OneHotEncoder(boolean dropFirst) {
        this.dropFirst = dropFirst;
        this.ignoreUnknown = false;
        this.fitted = false;
        return;
    }

    public OneHotEncoder(boolean dropFirst, boolean ignoreUnknown) {
        this.dropFirst = dropFirst;
        this.ignoreUnknown = ignoreUnknown;
        this.fitted = false;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("OneHotEncoder.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        this.nIn = p;
        // Per column: sorted unique values.
        int64[] os = heap int64[1];
        os[0] = p + 1;
        Tensor<int64> offs = Tensor.zeros<int64>(os);
        float64[] all = heap float64[n * p];
        int64 total = 0;
        int64 j = 0;
        while (j < p) {
            // Collect sorted-unique for column j (insertion into a local
            // sorted buffer).
            float64[] u = heap float64[n];
            int64 cnt = 0;
            int64 i = 0;
            while (i < n) {
                float64 v = x.get2(i, j);
                // find insert position / existing
                int64 lo = 0;
                boolean seen = false;
                while (lo < cnt && !seen) {
                    if (u[lo] == v) {
                        seen = true;
                    } else if (u[lo] > v) {
                        break;
                    } else {
                        lo = lo + 1;
                    }
                }
                if (!seen) {
                    int64 m = cnt;
                    while (m > lo) {
                        u[m] = u[m - 1];
                        m = m - 1;
                    }
                    u[lo] = v;
                    cnt = cnt + 1;
                }
                i = i + 1;
            }
            int64 c = 0;
            while (c < cnt) {
                all[total + c] = u[c];
                c = c + 1;
            }
            total = total + cnt;
            offs.set1(j + 1, total);
            j = j + 1;
        }
        int64[] cs = heap int64[1];
        cs[0] = total;
        Tensor<float64> cats = Tensor.zeros<float64>(cs);
        int64 t = 0;
        while (t < total) {
            cats.set1(t, all[t]);
            t = t + 1;
        }
        this.catsV #= cats;
        this.offsetsV #= offs;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** Output width: categories minus one per column under dropFirst. */
    int64 outWidth() {
        int64 total = this.offsetsV.get1(this.nIn);
        if (this.dropFirst) {
            return total - this.nIn;
        }
        return total;
    }

    public #Tensor<float64> transform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("OneHotEncoder.transform: fit first");
        }
        if (x.ndim() != 2 || x.shapeAt(1) != this.nIn) {
            throw heap MlException("OneHotEncoder.transform: x must be "
                + "(n, p) with p matching the fit");
        }
        int64 n = x.shapeAt(0);
        int64 w = this.outWidth();
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = w;
        Tensor<float64> out = Tensor.zeros<float64>(sh);
        int64 i = 0;
        while (i < n) {
            int64 base = 0;
            int64 j = 0;
            while (j < this.nIn) {
                int64 lo = this.offsetsV.get1(j);
                int64 hi = this.offsetsV.get1(j + 1);
                float64 v = x.get2(i, j);
                int64 hit = -1;
                int64 c = lo;
                while (c < hi) {
                    if (this.catsV.get1(c) == v) {
                        hit = c - lo;
                        c = hi;
                    } else {
                        c = c + 1;
                    }
                }
                if (hit < 0 && !this.ignoreUnknown) {
                    throw heap MlException("OneHotEncoder.transform: "
                        + "category unseen at fit time in column "
                        + Int64.of(j).toString()
                        + " — refit, or construct with the ignore policy");
                }
                int64 span = hi - lo;
                if (this.dropFirst) {
                    if (hit > 0) {
                        out.flatSet(i * w + base + hit - 1, 1.0);
                    }
                    base = base + span - 1;
                } else {
                    if (hit >= 0) {
                        out.flatSet(i * w + base + hit, 1.0);
                    }
                    base = base + span;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    public #Tensor<float64> fitTransform(Tensor<float64> x,
                                         Tensor<float64> y) {
        this.fit(x, y);
        Tensor<float64> out = this.transform(x);
        return #out;
    }
}
