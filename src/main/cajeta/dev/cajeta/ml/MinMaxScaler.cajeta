package dev.cajeta.ml;

import cajeta.math.Tensor;

/**
 * Scale features to `[0, 1]` (sklearn `MinMaxScaler`): per-column
 * `(x − min) / (max − min)`. A zero-range column scales by 1 (sklearn's
 * `data_range_` guard), so constant features transform to 0.
 */
public final class MinMaxScaler implements Transformer {

    private Tensor<float64> lo;
    private Tensor<float64> range;
    private boolean fitted;

    public MinMaxScaler() {
        this.fitted = false;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("MinMaxScaler.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64[] sh = heap int64[1];
        sh[0] = p;
        Tensor<float64> mn = Tensor.zeros<float64>(sh);
        Tensor<float64> rg = Tensor.zeros<float64>(sh);
        int64 j = 0;
        while (j < p) {
            float64 vmin = x.get2(0, j);
            float64 vmax = vmin;
            int64 i = 1;
            while (i < n) {
                float64 v = x.get2(i, j);
                if (v < vmin) { vmin = v; }
                if (v > vmax) { vmax = v; }
                i = i + 1;
            }
            float64 r = vmax - vmin;
            if (r == 0.0) { r = 1.0; }
            mn.set1(j, vmin);
            rg.set1(j, r);
            j = j + 1;
        }
        this.lo #= mn;
        this.range #= rg;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    public #Tensor<float64> transform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("MinMaxScaler.transform: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        Tensor<float64> out = x.copy();
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                float64 v = (x.get2(i, j) - this.lo.get1(j)) / this.range.get1(j);
                out.flatSet(i * p + j, v);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    /** Undo the scaling: `x·range + min`. */
    public #Tensor<float64> inverseTransform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("MinMaxScaler.inverseTransform: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        Tensor<float64> out = x.copy();
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                float64 v = x.get2(i, j) * this.range.get1(j) + this.lo.get1(j);
                out.flatSet(i * p + j, v);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    public #Tensor<float64> fitTransform(Tensor<float64> x, Tensor<float64> y) {
        this.fit(x, y);
        Tensor<float64> out = this.transform(x);
        return #out;
    }
}
