package dev.cajeta.ml.optim;

import cajeta.math.Tensor;
import dev.cajeta.ml.nn.Parameter;

/**
 * SGD — stochastic gradient descent with optional momentum (spec §5.1):
 * `v = momentum·v + g; p -= lr·v` (plain `p -= lr·g` when momentum is 0).
 * Velocity state is optimizer-owned, positional, lazily initialized on the
 * first `step` (§5.4). The optimizer BORROWS the parameters (owns only the
 * collection spine); the module's lifetime governs the tensors (N3).
 *
 * ```cajeta
 * Optimizer opt = heap SGD(model.parameters(), 0.1f, 0.9f);
 * opt.step(result.grads);
 * ```
 */
public final class SGD implements Optimizer {
    Parameter[] params;
    float32 lr;
    float32 momentum;
    Tensor<float32>[] velocity;
    boolean[] active;          // trainable at the LAST momentum step
    boolean hasState;

    /** @EntryPoint */
    public SGD(#Parameter[] params, float32 lr, float32 momentum) {
        this.params #= params;
        this.lr = lr;
        this.momentum = momentum;
        this.hasState = false;
    }

    public float32 getLr() { return this.lr; }
    public void setLr(float32 v) { this.lr = v; }

    public void step(Tensor<float32>[] grads) {
        Updates.validate(this.params, grads);
        int32 n = (int32) this.params.count();
        if (this.momentum == 0.0f) {
            int32 i = 0;
            while (i < n) {
                // A frozen parameter is skipped outright. Applying a zero
                // gradient would still let weight decay move it, which is
                // not what "frozen" means.
                if (this.params[i].isTrainable()) {
                    Updates.axpyInto(this.params[i].get(), grads[i], -this.lr);
                }
                i = i + 1;
            }
            return;
        }
        if (!this.hasState) {
            Tensor<float32>[] vel = heap Tensor<float32>[n];
            int32 j = 0;
            while (j < n) {
                vel[j] = Tensor.zerosLike<float32>(this.params[j].get());
                j = j + 1;
            }
            boolean[] ac = heap boolean[n];
            int32 j2 = 0;
            while (j2 < n) {
                ac[j2] = true;
                j2 = j2 + 1;
            }
            this.velocity #= vel;
            this.active #= ac;
            this.hasState = true;
        }
        int32 i = 0;
        while (i < n) {
            // v = momentum*v + g (in place on the state), then p -= lr*v.
            if (this.params[i].isTrainable()) {
                // Frozen->trainable: stale velocity is the bug — reset.
                if (!this.active[i]) {
                    Updates.zero(this.velocity[i]);
                    this.active[i] = true;
                }
                Tensor<float32> v = this.velocity[i];
                Updates.axpyInto(v, v, this.momentum - 1.0f);   // v *= momentum
                Updates.axpyInto(v, grads[i], 1.0f);            // v += g
                Updates.axpyInto(this.params[i].get(), v, -this.lr);
            } else {
                this.active[i] = false;
            }
            i = i + 1;
        }
    }
}
