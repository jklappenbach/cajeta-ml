package dev.cajeta.ml.optim;

import cajeta.math.Tensor;
import dev.cajeta.ml.nn.Parameter;

/**
 * AdamW (Loshchilov & Hutter) — Adam with DECOUPLED weight decay:
 * `p -= lr · ( m̂/(√v̂+ε) + weightDecay·p )`. The decay applies directly to
 * the parameter, NOT through the gradient/moment path — which is exactly how
 * it differs from Adam-plus-L2 (the moments never see the decay term).
 * Same β/ε and state discipline as {@link Adam}.
 */
public final class AdamW implements Optimizer {
    Parameter[] params;
    float32 lr;
    float32 weightDecay;
    Tensor<float32>[] m;
    Tensor<float32>[] v;
    float32[] beta1Power;      // per-param: advances only on active steps
    float32[] beta2Power;
    boolean[] active;          // trainable at the LAST step
    boolean hasState;

    /** @EntryPoint */
    public AdamW(#Parameter[] params, float32 lr, float32 weightDecay) {
        this.params #= params;
        this.lr = lr;
        this.weightDecay = weightDecay;
        this.hasState = false;
    }

    public float32 getLr() { return this.lr; }
    public void setLr(float32 v) { this.lr = v; }

    public void step(Tensor<float32>[] grads) {
        Updates.validate(this.params, grads);
        int32 n = (int32) this.params.count();
        if (!this.hasState) {
            Tensor<float32>[] ms = heap Tensor<float32>[n];
            Tensor<float32>[] vs = heap Tensor<float32>[n];
            int32 j = 0;
            while (j < n) {
                ms[j] = Tensor.zerosLike<float32>(this.params[j].get());
                vs[j] = Tensor.zerosLike<float32>(this.params[j].get());
                j = j + 1;
            }
            float32[] b1 = heap float32[n];
            float32[] b2 = heap float32[n];
            boolean[] ac = heap boolean[n];
            int32 j2 = 0;
            while (j2 < n) {
                b1[j2] = 1.0f;
                b2[j2] = 1.0f;
                ac[j2] = true;
                j2 = j2 + 1;
            }
            this.m #= ms;
            this.v #= vs;
            this.beta1Power #= b1;
            this.beta2Power #= b2;
            this.active #= ac;
            this.hasState = true;
        }
        int32 i = 0;
        while (i < n) {
            if (this.params[i].isTrainable()) {
                // Frozen->trainable gets FRESH state (spec 13.5.2).
                if (!this.active[i]) {
                    Updates.zero(this.m[i]);
                    Updates.zero(this.v[i]);
                    this.beta1Power[i] = 1.0f;
                    this.beta2Power[i] = 1.0f;
                    this.active[i] = true;
                }
                this.beta1Power[i] = this.beta1Power[i] * 0.9f;
                this.beta2Power[i] = this.beta2Power[i] * 0.999f;
                AdamW.updateOne(this.params[i].get(), grads[i], this.m[i],
                                this.v[i], this.lr, this.weightDecay,
                                1.0f - this.beta1Power[i],
                                1.0f - this.beta2Power[i]);
            } else {
                this.active[i] = false;
            }
            i = i + 1;
        }
    }

    static void updateOne(Tensor<float32> p, Tensor<float32> g,
                          Tensor<float32> m, Tensor<float32> v,
                          float32 lr, float32 wd, float32 c1, float32 c2) {
        int64[] shape = Tensor.shapeOf<float32>(p);
        int32 nd = (int32) shape.count();
        int64 total = Tensor.productOf(shape);
        int64[] idx = heap int64[nd];
        int32 k = 0;
        while (k < nd) {
            idx[k] = 0;
            k = k + 1;
        }
        int64 lin = 0;
        while (lin < total) {
            float32 gv = g.getAt(idx);
            float32 mv = 0.9f * m.getAt(idx) + 0.1f * gv;
            float32 vv = 0.999f * v.getAt(idx) + 0.001f * gv * gv;
            m.setAt(idx, mv);
            v.setAt(idx, vv);
            float32 mhat = mv / c1;
            float32 vhat = vv / c2;
            float32 pv = p.getAt(idx);
            p.setAt(idx, pv - lr * (mhat / (Math.sqrt(vhat) + 1e-8f) + wd * pv));
            lin = lin + 1;
            int32 ax = nd - 1;
            boolean carry = true;
            while (ax >= 0 && carry) {
                idx[ax] = idx[ax] + 1;
                if (idx[ax] >= shape[ax]) {
                    idx[ax] = 0;
                    ax = ax - 1;
                } else {
                    carry = false;
                }
            }
        }
    }
}
