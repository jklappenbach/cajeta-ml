package dev.cajeta.ml.optim;

import cajeta.concurrent.Carriers;
import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.ml.nn.Parameter;
import dev.cajeta.ml.grad.Ops;
import dev.cajeta.ml.kernels.Optim;

/**
 * AdamW (Loshchilov & Hutter) — Adam with DECOUPLED weight decay:
 * `p -= lr · ( m̂/(√v̂+ε) + weightDecay·p )`. The decay applies directly to
 * the parameter, NOT through the gradient/moment path — which is exactly how
 * it differs from Adam-plus-L2 (the moments never see the decay term).
 * Same β/ε and state discipline as {@link Adam}.
 */
public final class AdamW implements Optimizer {
    Parameter[] params;
    float32 lr;
    float32 weightDecay;
    Tensor<float32>[] m;
    Tensor<float32>[] v;
    float32[] beta1Power;      // per-param: advances only on active steps
    float32[] beta2Power;
    boolean[] active;          // trainable at the LAST step
    boolean hasState;

    static int64 flat = 0L;
    static int32 parts = 0;
    /** Elements a part of the flat pass takes at least, so a fiber pays for itself. */
    static final int64 PART_ELEMS = 65536L;

    /** The parts the last flat pass was split into across the carriers: 1 on the caller. */
    public static int32 lastParts() { return AdamW.parts; }

    /** Host updates that ran as one flat pass over the arrays, for the tests that pin the route. */
    public static int64 flatUpdates() { return AdamW.flat; }

    /** @EntryPoint */
    public AdamW(#Parameter[] params, float32 lr, float32 weightDecay) {
        this.params #= params;
        this.lr = lr;
        this.weightDecay = weightDecay;
        this.hasState = false;
    }

    public float32 getLr() { return this.lr; }
    public void setLr(float32 v) { this.lr = v; }

    public void step(Tensor<float32>[] grads) {
        this.stepScaled(grads, null);
    }

    /**
     * step with each gradient read times the device scalar `scale` (the global-norm clip's,
     * spela-kernels 3), or as read when `scale` is null. On the device, with at most
     * Optim.SLOTS parameters, every trainable parameter updates in one launch; otherwise one
     * launch a parameter, the scale applied first.
     */
    public void stepScaled(Tensor<float32>[] grads, KernelBuffer<float32> scale) {
        Updates.validate(this.params, grads);
        int32 n = (int32) this.params.count();
        this.ensureState(n);
        if (n <= Optim.SLOTS && n > 0 && this.params[0].get().isOnGpu()) {
            KernelBuffer<float32>[] ps = heap KernelBuffer<float32>[n];
            KernelBuffer<float32>[] ms = heap KernelBuffer<float32>[n];
            KernelBuffer<float32>[] vs = heap KernelBuffer<float32>[n];
            KernelBuffer<float32>[] gs = heap KernelBuffer<float32>[n];
            int64[] ns = heap int64[n];
            float32[] c1 = heap float32[n];
            float32[] c2 = heap float32[n];
            int32 count = 0;
            int32 i = 0;
            while (i < n) {
                if (this.advance(i)) {
                    ps[count] = this.params[i].get().deviceView("adamw");
                    ms[count] = this.m[i].deviceView("adamw");
                    vs[count] = this.v[i].deviceView("adamw");
                    gs[count] = grads[i].deviceView("adamw");
                    ns[count] = this.params[i].get().size();
                    c1[count] = 1.0f - this.beta1Power[i];
                    c2[count] = 1.0f - this.beta2Power[i];
                    count = count + 1;
                }
                i = i + 1;
            }
            if (count > 0) { Optim.adamStepSlots<float32>(ps, ms, vs, gs, ns, count, c1, c2, this.lr, this.weightDecay, scale); }
            return;
        }
        int32 i = 0;
        while (i < n) {
            if (this.advance(i)) {
                if (scale != null) { Optim.scaleByDevice<float32>(grads[i].deviceView("adamw"), scale, grads[i].size()); }
                AdamW.updateOne(this.params[i].get(), grads[i], this.m[i],
                                this.v[i], this.lr, this.weightDecay,
                                1.0f - this.beta1Power[i],
                                1.0f - this.beta2Power[i]);
            }
            i = i + 1;
        }
    }

    /**
     * The host half of this optimizer's step state: each parameter's bias-correction powers and
     * whether it was active, so a step the device declined (a zero scale, spela-kernels 8) can
     * be taken back with restoreStepState. Empty before the first step.
     */
    public #float32[] stepState() {
        if (!this.hasState) { return heap float32[0]; }
        int32 n = (int32) this.params.count();
        float32[] s = heap float32[3 * n];
        int32 i = 0;
        while (i < n) {
            s[i] = this.beta1Power[i];
            s[n + i] = this.beta2Power[i];
            s[2 * n + i] = 0.0f;
            if (this.active[i]) { s[2 * n + i] = 1.0f; }
            i = i + 1;
        }
        return #s;
    }

    /** Put back what stepState read; from an empty state, the state of a first step. */
    public void restoreStepState(float32[] s) {
        if (!this.hasState) { return; }
        int32 n = (int32) this.params.count();
        int32 i = 0;
        while (i < n) {
            if (s.count() == 0) {
                this.beta1Power[i] = 1.0f;
                this.beta2Power[i] = 1.0f;
                this.active[i] = true;
            } else {
                this.beta1Power[i] = s[i];
                this.beta2Power[i] = s[n + i];
                this.active[i] = s[2 * n + i] != 0.0f;
            }
            i = i + 1;
        }
    }

    /** Parameter i's bookkeeping for this step: false when frozen; true after advancing its powers. */
    boolean advance(int32 i) {
        if (!this.params[i].isTrainable()) {
            this.active[i] = false;
            return false;
        }
        // Frozen->trainable gets FRESH state (spec 13.5.2).
        if (!this.active[i]) {
            Updates.zero(this.m[i]);
            Updates.zero(this.v[i]);
            this.beta1Power[i] = 1.0f;
            this.beta2Power[i] = 1.0f;
            this.active[i] = true;
        }
        this.beta1Power[i] = this.beta1Power[i] * 0.9f;
        this.beta2Power[i] = this.beta2Power[i] * 0.999f;
        return true;
    }

    void ensureState(int32 n) {
        if (this.hasState) { return; }
        Tensor<float32>[] ms = heap Tensor<float32>[n];
        Tensor<float32>[] vs = heap Tensor<float32>[n];
        int32 j = 0;
        while (j < n) {
            ms[j] #= Ops.zerosLike<float32>(this.params[j].get());
            vs[j] #= Ops.zerosLike<float32>(this.params[j].get());
            j = j + 1;
        }
        float32[] b1 = heap float32[n];
        float32[] b2 = heap float32[n];
        boolean[] ac = heap boolean[n];
        int32 j2 = 0;
        while (j2 < n) {
            b1[j2] = 1.0f;
            b2[j2] = 1.0f;
            ac[j2] = true;
            j2 = j2 + 1;
        }
        this.m #= ms;
        this.v #= vs;
        this.beta1Power #= b1;
        this.beta2Power #= b2;
        this.active #= ac;
        this.hasState = true;
    }

    /** Elements [e0, e1) of one flat AdamW update, the arithmetic the indexed walk below uses. */
    static void range(float32[] pa, int64 po, float32[] ga, int64 go, float32[] ma, int64 mo,
                      float32[] va, int64 vo, int64 e0, int64 e1, float32 lr, float32 wd, float32 c1, float32 c2) {
        int64 e = e0;
        while (e < e1) {
            float32 gv = ga[go + e];
            float32 mv = 0.9f * ma[mo + e] + 0.1f * gv;
            float32 vv = 0.999f * va[vo + e] + 0.001f * gv * gv;
            ma[mo + e] = mv;
            va[vo + e] = vv;
            float32 mhat = mv / c1;
            float32 vhat = vv / c2;
            float32 pv = pa[po + e];
            pa[po + e] = pv - lr * (mhat / (Math.sqrt(vhat) + 1e-8f) + wd * pv);
            e = e + 1L;
        }
    }

    static void updateOne(Tensor<float32> p, Tensor<float32> g,
                          Tensor<float32> m, Tensor<float32> v,
                          float32 lr, float32 wd, float32 c1, float32 c2) {
        if (p.isOnGpu()) {
            Optim.adamStep<float32>(p.deviceView("adamw"), m.deviceView("adamw"), v.deviceView("adamw"), g.deviceView("adamw"), p.size(), lr, c1, c2, wd);
            return;
        }
        if (p.isContiguous() && g.isContiguous() && m.isContiguous() && v.isContiguous()) {
            // one pass over the host arrays, the same arithmetic per element as the walk below,
            // which read and wrote every element through an N-d index (spela-kernels 10.2.2)
            AdamW.flat = AdamW.flat + 1L;
            float32[] pa = p.hostBuffer();
            float32[] ga = g.hostBuffer();
            float32[] ma = m.hostBuffer();
            float32[] va = v.hostBuffer();
            int64 po = p.hostBase();
            int64 go = g.hostBase();
            int64 mo = m.hostBase();
            int64 vo = v.hostBase();
            int64 count = p.size();
            // ranges of the pass split across the carriers, which sat spinning beside it
            // (Proton's read on proton, 2026-11-15: 0.18 ms at 1 carrier, 0.30 at 16)
            int64 want = (int64) Carriers.count();
            if (want > 16L) { want = 16L; }
            if (want > count / AdamW.PART_ELEMS) { want = count / AdamW.PART_ELEMS; }
            if (want < 2L) {
                AdamW.parts = 1;
                AdamW.range(pa, po, ga, go, ma, mo, va, vo, 0L, count, lr, wd, c1, c2);
                return;
            }
            AdamW.parts = (int32) want;
            int64 per = (count + want - 1L) / want;
            scope {
                int64 e0 = 0L;
                while (e0 < count) {
                    int64 e1 = e0 + per;
                    if (e1 > count) { e1 = count; }
                    spawn range(pa, po, ga, go, ma, mo, va, vo, e0, e1, lr, wd, c1, c2);
                    e0 = e1;
                }
            }
            return;
        }
        int64[] shape #= Tensor.shapeOf<float32>(p);
        int32 nd = (int32) shape.count();
        int64 total = Tensor.productOf(shape);
        int64[] idx = heap int64[nd];
        int32 k = 0;
        while (k < nd) {
            idx[k] = 0;
            k = k + 1;
        }
        int64 lin = 0;
        while (lin < total) {
            float32 gv = g.getAt(idx);
            float32 mv = 0.9f * m.getAt(idx) + 0.1f * gv;
            float32 vv = 0.999f * v.getAt(idx) + 0.001f * gv * gv;
            m.setAt(idx, mv);
            v.setAt(idx, vv);
            float32 mhat = mv / c1;
            float32 vhat = vv / c2;
            float32 pv = p.getAt(idx);
            p.setAt(idx, pv - lr * (mhat / (Math.sqrt(vhat) + 1e-8f) + wd * pv));
            lin = lin + 1;
            int32 ax = nd - 1;
            boolean carry = true;
            while (ax >= 0 && carry) {
                idx[ax] = idx[ax] + 1;
                if (idx[ax] >= shape[ax]) {
                    idx[ax] = 0;
                    ax = ax - 1;
                } else {
                    carry = false;
                }
            }
        }
    }
}
