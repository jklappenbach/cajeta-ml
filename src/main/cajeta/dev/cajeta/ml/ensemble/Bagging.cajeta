package dev.cajeta.ml.ensemble;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import cajeta.math.random.Generator;
import dev.cajeta.ml.EstimatorFactory;
import dev.cajeta.ml.Metrics;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.Predictor;

/**
 * The shared bagging core behind {@link BaggingClassifier} and
 * {@link BaggingRegressor} (ml-trees-ensembles U5, spec §6): bootstrap
 * sampling through `cajeta.math.random.Generator`, generic base estimators
 * through {@link EstimatorFactory} (§6.7 — nothing here is tree-aware),
 * row/feature subsampling (§6.3–§6.4), and out-of-bag bookkeeping (§6.5).
 *
 * Determinism: member `i` derives its OWN generator from `seed + i` and
 * draws rows first, then features, from that stream. The derivation is the
 * documented contract (§12.4): fitting is sequential, and were members ever
 * fitted in parallel the per-member streams would keep the result identical
 * at any thread count.
 */
final class Bagging {

    EstimatorFactory factory;
    Tensor<float64> baseParams;
    int64 nEstimators;
    uint64 seed;
    float64 maxSamples;      // fraction of rows per member (0, 1]
    float64 maxFeatures;     // fraction of features per member (0, 1]
    boolean bootstrapFeatures;
    boolean oobEnabled;

    ArrayList<BagMember> members;
    int64[] memberFeat;      // flat [nEstimators * kf] feature indices
    int64 kf;
    boolean[] inBag;         // [nEstimators * n]
    int64 nTrain;
    int64 nfTrain;
    float64 oobValue;
    boolean oobComputed;

    Bagging(#EstimatorFactory factory, Tensor<float64> baseParams,
            int64 nEstimators, uint64 seed) {
        this.factory #= factory;
        Tensor<float64> bp = baseParams.copy();
        this.baseParams #= bp;
        this.nEstimators = nEstimators;
        this.seed = seed;
        this.maxSamples = 1.0;
        this.maxFeatures = 1.0;
        this.bootstrapFeatures = false;
        this.oobEnabled = false;
        this.oobComputed = false;
        return;
    }

    /** Bootstrap indices: n draws with replacement from [0, n). */
    static #Tensor<int64> bootstrap(uint64 seed, int64 n, int64 k) {
        Generator g = heap Generator(seed);
        return g.integers(0, n, k);
    }

    void fit(Tensor<float64> x, Tensor<float64> y, boolean classify) {
        int64 n = x.shapeAt(0);
        int64 nf = x.shapeAt(1);
        this.nTrain = n;
        this.nfTrain = nf;
        int64 nSamp = (int64) (this.maxSamples * (float64) n);
        if (nSamp < 1) { nSamp = 1; }
        this.kf = (int64) (this.maxFeatures * (float64) nf);
        if (this.kf < 1) { this.kf = 1; }

        ArrayList<BagMember> ms = heap ArrayList<BagMember>();
        this.memberFeat #= heap int64[this.nEstimators * this.kf];
        this.inBag #= heap boolean[this.nEstimators * n];

        int64 e = 0;
        while (e < this.nEstimators) {
            Generator g = heap Generator(this.seed + (uint64) e);
            Tensor<int64> rows = g.integers(0, n, nSamp);
            Tensor<int64> feats;
            if (this.kf == nf && !this.bootstrapFeatures) {
                int64[] ida = heap int64[nf];
                int64 fi = 0;
                while (fi < nf) { ida[fi] = fi; fi = fi + 1; }
                int64[] idsh = heap int64[1]; idsh[0] = nf;
                feats = Tensor.of<int64>(ida, idsh);
            } else {
                feats = g.choice(nf, this.kf, this.bootstrapFeatures);
            }
            int64 fi2 = 0;
            while (fi2 < this.kf) {
                this.memberFeat[e * this.kf + fi2] = feats.flatGet(fi2);
                fi2 = fi2 + 1;
            }

            float64[] xa = heap float64[nSamp * this.kf];
            float64[] ya = heap float64[nSamp];
            int64 r = 0;
            while (r < nSamp) {
                int64 src = rows.flatGet(r);
                this.inBag[e * n + src] = true;
                int64 c = 0;
                while (c < this.kf) {
                    xa[r * this.kf + c] = x.flatGet(src * nf + this.memberFeat[e * this.kf + c]);
                    c = c + 1;
                }
                ya[r] = y.get1(src);
                r = r + 1;
            }
            int64[] xsh = heap int64[2]; xsh[0] = nSamp; xsh[1] = this.kf;
            int64[] ysh = heap int64[1]; ysh[0] = nSamp;
            Tensor<float64> xm = Tensor.of<float64>(xa, xsh);
            Tensor<float64> ym = Tensor.of<float64>(ya, ysh);

            Predictor p = this.factory.create(this.baseParams);
            p.fit(xm, ym);
            ms.add(heap BagMember(#p));
            e = e + 1;
        }
        this.members #= ms;

        if (this.oobEnabled) {
            this.oobValue = this.computeOob(x, y, classify);
            this.oobComputed = true;
        }
        return;
    }

    /** One member's predictions on `x` projected to its feature subset. */
    #Tensor<float64> memberPredict(int64 e, Tensor<float64> x) {
        int64 n = x.shapeAt(0);
        int64 nf = x.shapeAt(1);
        float64[] xa = heap float64[n * this.kf];
        int64 r = 0;
        while (r < n) {
            int64 c = 0;
            while (c < this.kf) {
                xa[r * this.kf + c] = x.flatGet(r * nf + this.memberFeat[e * this.kf + c]);
                c = c + 1;
            }
            r = r + 1;
        }
        int64[] sh = heap int64[2]; sh[0] = n; sh[1] = this.kf;
        Tensor<float64> xm = Tensor.of<float64>(xa, sh);
        BagMember mb = this.members.get((int32) e);
        return mb.est.predict(xm);
    }

    /**
     * Aggregate prediction: majority vote (ties → lowest label) when
     * `classify`, else the mean (§6.2).
     */
    #Tensor<float64> aggregate(Tensor<float64> x, boolean classify) {
        int64 n = x.shapeAt(0);
        float64[] acc = heap float64[n];
        if (classify) {
            // Two passes: find K, then vote. Predictions flat [e*n + r].
            float64[] preds = heap float64[this.nEstimators * n];
            int64 kmax = 0;
            int64 e = 0;
            while (e < this.nEstimators) {
                Tensor<float64> pe = this.memberPredict(e, x);
                int64 r = 0;
                while (r < n) {
                    preds[e * n + r] = pe.flatGet(r);
                    if ((int64) preds[e * n + r] > kmax) { kmax = (int64) preds[e * n + r]; }
                    r = r + 1;
                }
                e = e + 1;
            }
            int64 k = kmax + 1;
            int64 r2 = 0;
            while (r2 < n) {
                int64[] votes = heap int64[k];
                int64 e2 = 0;
                while (e2 < this.nEstimators) {
                    int64 lb = (int64) preds[e2 * n + r2];
                    votes[lb] = votes[lb] + 1;
                    e2 = e2 + 1;
                }
                int64 best = 0;
                int64 c = 1;
                while (c < k) {
                    if (votes[c] > votes[best]) { best = c; }
                    c = c + 1;
                }
                acc[r2] = (float64) best;
                r2 = r2 + 1;
            }
        } else {
            int64 e = 0;
            while (e < this.nEstimators) {
                Tensor<float64> pe = this.memberPredict(e, x);
                int64 r = 0;
                while (r < n) { acc[r] = acc[r] + pe.flatGet(r); r = r + 1; }
                e = e + 1;
            }
            int64 r3 = 0;
            while (r3 < n) { acc[r3] = acc[r3] / (float64) this.nEstimators; r3 = r3 + 1; }
        }
        int64[] sh = heap int64[1]; sh[0] = n;
        return Tensor.of<float64>(acc, sh);
    }

    /**
     * OOB estimate (§6.5): each training sample is scored only by the
     * members whose bootstrap never drew it. Accuracy of the OOB vote for
     * classification, R² of the OOB mean for regression, over the covered
     * samples. Loud when NOTHING is covered (§6.6).
     */
    float64 computeOob(Tensor<float64> x, Tensor<float64> y, boolean classify) {
        int64 n = this.nTrain;
        float64[] preds = heap float64[this.nEstimators * n];
        int64 kmax = 1;
        int64 e = 0;
        while (e < this.nEstimators) {
            Tensor<float64> pe = this.memberPredict(e, x);
            int64 r = 0;
            while (r < n) {
                preds[e * n + r] = pe.flatGet(r);
                if ((int64) preds[e * n + r] > kmax) { kmax = (int64) preds[e * n + r]; }
                r = r + 1;
            }
            e = e + 1;
        }
        int64 covered = 0;
        int64 hits = 0;
        float64[] oobPred = heap float64[n];
        boolean[] has = heap boolean[n];
        int64 r = 0;
        while (r < n) {
            int64[] votes = heap int64[kmax + 1];
            float64 sum = 0.0;
            int64 cnt = 0;
            int64 e2 = 0;
            while (e2 < this.nEstimators) {
                if (!this.inBag[e2 * n + r]) {
                    int64 lb = (int64) preds[e2 * n + r];
                    votes[lb] = votes[lb] + 1;
                    sum = sum + preds[e2 * n + r];
                    cnt = cnt + 1;
                }
                e2 = e2 + 1;
            }
            if (cnt > 0) {
                has[r] = true;
                covered = covered + 1;
                if (classify) {
                    int64 best = 0;
                    int64 c = 1;
                    while (c <= kmax) {
                        if (votes[c] > votes[best]) { best = c; }
                        c = c + 1;
                    }
                    oobPred[r] = (float64) best;
                    if ((float64) best == y.get1(r)) { hits = hits + 1; }
                } else {
                    oobPred[r] = sum / (float64) cnt;
                }
            }
            r = r + 1;
        }
        if (covered == 0) {
            throw heap MlException("bagging oobScore: no sample was ever "
                + "out-of-bag (too few estimators or maxSamples too large) — "
                + "the OOB estimate does not exist for this configuration");
        }
        if (classify) {
            return (float64) hits / (float64) covered;
        }
        float64[] yt = heap float64[covered];
        float64[] pt = heap float64[covered];
        int64 j = 0;
        r = 0;
        while (r < n) {
            if (has[r]) {
                yt[j] = y.get1(r);
                pt[j] = oobPred[r];
                j = j + 1;
            }
            r = r + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = covered;
        return Metrics.r2(Tensor.of<float64>(yt, sh), Tensor.of<float64>(pt, sh));
    }

    float64 oob() {
        if (!this.oobComputed) {
            throw heap MlException("bagging oobScore: enable setOobScore(true) "
                + "before fit — the estimate is computed during fitting");
        }
        return this.oobValue;
    }
}
