package dev.cajeta.ml.ensemble;

import cajeta.math.Tensor;
import dev.cajeta.ml.EstimatorFactory;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.Predictor;

/**
 * Bagging over any `Predictor` (ml-trees-ensembles U5, spec §6): each base
 * model — built fresh per member through the {@link EstimatorFactory} seam,
 * so bagging is NOT tree-specific (§6.7) — trains on its own seeded
 * bootstrap sample and prediction aggregates by majority vote (ties → the
 * lowest label). Member `i` draws from `seed + i`: the documented,
 * thread-count-proof derivation (§12.4). `setOobScore(true)` computes the
 * out-of-bag accuracy during fit — each sample scored only by members that
 * never drew it (§6.5) — and a configuration with no OOB coverage is a loud
 * error, never a silent NaN (§6.6).
 */
public final class BaggingClassifier implements Predictor {

    Bagging core;
    boolean fitted;

    public BaggingClassifier(#EstimatorFactory factory, Tensor<float64> baseParams,
                             int64 nEstimators, uint64 seed) {
        if (nEstimators < 1) {
            throw heap MlException("BaggingClassifier: nEstimators must be >= 1");
        }
        Bagging b = heap Bagging(#factory, baseParams, nEstimators, seed);
        this.core #= b;
        this.fitted = false;
        return;
    }

    /** A seeded size-`n` bootstrap sample (with replacement) — the sampling
     *  primitive itself, exposed for inspection (spec §6.1). */
    public static #Tensor<int64> bootstrapIndices(uint64 seed, int64 n) {
        return Bagging.bootstrap(seed, n, n);
    }

    /** Row fraction per member (sklearn `max_samples`), (0, 1]. */
    public void setMaxSamples(float64 f) {
        if (f <= 0.0 || f > 1.0) {
            throw heap MlException("BaggingClassifier: maxSamples must be in (0, 1]");
        }
        this.core.maxSamples = f;
        return;
    }

    /** Feature fraction per member (sklearn `max_features`), (0, 1]. */
    public void setMaxFeatures(float64 f) {
        if (f <= 0.0 || f > 1.0) {
            throw heap MlException("BaggingClassifier: maxFeatures must be in (0, 1]");
        }
        this.core.maxFeatures = f;
        return;
    }

    /** Sample features WITH replacement too (sklearn `bootstrap_features`, §6.4). */
    public void setBootstrapFeatures(boolean b) {
        this.core.bootstrapFeatures = b;
        return;
    }

    /** Compute the out-of-bag accuracy during fit (§6.5). */
    public void setOobScore(boolean b) {
        this.core.oobEnabled = b;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("BaggingClassifier.fit: x must be 2-D (n, p)");
        }
        if (y.ndim() != 1 || y.shapeAt(0) != x.shapeAt(0)) {
            throw heap MlException("BaggingClassifier.fit: y must be (n,) matching x rows");
        }
        this.core.fit(x, y, true);
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** `(n,)` labels by majority vote (ties → lowest label). */
    public #Tensor<float64> predict(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("BaggingClassifier.predict: fit first");
        }
        return this.core.aggregate(x, true);
    }

    /** Accuracy. */
    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        Tensor<float64> p = this.predict(x);
        int64 n = p.shapeAt(0);
        int64 hits = 0;
        int64 i = 0;
        while (i < n) {
            if (p.get1(i) == y.get1(i)) { hits = hits + 1; }
            i = i + 1;
        }
        return (float64) hits / (float64) n;
    }

    /** The out-of-bag accuracy computed at fit (requires setOobScore(true)). */
    public float64 oobScore() {
        return this.core.oob();
    }
}
