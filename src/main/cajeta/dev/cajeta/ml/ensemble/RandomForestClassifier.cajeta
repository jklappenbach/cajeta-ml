package dev.cajeta.ml.ensemble;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import cajeta.math.random.Generator;
import dev.cajeta.ml.tree.DecisionTreeClassifier;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.Predictor;

/**
 * Random forest classification (ml-trees-ensembles U6, spec §7): bagging
 * over {@link DecisionTreeClassifier}s PLUS per-node feature subsampling —
 * at every node each tree considers a fresh random subset of
 * `maxFeatures` features (default `floor(sqrt(p))`, sklearn's), which is
 * what separates a forest from plain bagging. Member `i` bootstraps its
 * rows from `Generator(seed + i)` and grows its tree under the same seed —
 * the whole forest is reproducible under the seed (spec §7.4; sklearn's
 * internal RNG streams are deliberately NOT reproduced, per §3.6's
 * precedent). Prediction is majority vote (ties → lowest label); OOB
 * accuracy per §6.5 with the loud no-coverage error of §6.6.
 */
public final class RandomForestClassifier implements Predictor {

    int64 nEstimators;
    uint64 seed;
    int64 maxDepth;
    int64 maxFeaturesCount;   // 0 = sqrt(p) default
    boolean oobEnabled;

    ArrayList<DecisionTreeClassifier> members;
    boolean[] inBag;
    int64 nTrain;
    int64 nFeatures;
    float64 oobValue;
    boolean oobComputed;
    boolean fitted;

    public RandomForestClassifier(int64 nEstimators, uint64 seed) {
        if (nEstimators < 1) {
            throw heap MlException("RandomForestClassifier: nEstimators must be >= 1");
        }
        this.nEstimators = nEstimators;
        this.seed = seed;
        this.maxDepth = 0;
        this.maxFeaturesCount = 0;
        this.oobEnabled = false;
        this.oobComputed = false;
        this.fitted = false;
        return;
    }

    /** Per-tree depth cap (0 = unbounded). */
    public void setMaxDepth(int64 v) {
        if (v < 0) {
            throw heap MlException("RandomForestClassifier: maxDepth must be >= 0");
        }
        this.maxDepth = v;
        return;
    }

    /** Features considered per node (0 = the sklearn default, floor(sqrt(p))). */
    public void setMaxFeaturesCount(int64 v) {
        if (v < 0) {
            throw heap MlException("RandomForestClassifier: maxFeaturesCount must be >= 0");
        }
        this.maxFeaturesCount = v;
        return;
    }

    /** Compute the out-of-bag accuracy during fit (§7.6/§6.5). */
    public void setOobScore(boolean b) {
        this.oobEnabled = b;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("RandomForestClassifier.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        if (y.ndim() != 1 || y.shapeAt(0) != n) {
            throw heap MlException("RandomForestClassifier.fit: y must be (n,) matching x rows");
        }
        int64 nf = x.shapeAt(1);
        this.nTrain = n;
        this.nFeatures = nf;
        int64 mf = this.maxFeaturesCount;
        if (mf == 0) {
            mf = (int64) Math.sqrt((float64) nf);
            if (mf < 1) { mf = 1; }
        }
        if (mf > nf) { mf = nf; }

        ArrayList<DecisionTreeClassifier> ms = heap ArrayList<DecisionTreeClassifier>();
        this.inBag #= heap boolean[this.nEstimators * n];
        int64 e = 0;
        while (e < this.nEstimators) {
            uint64 se = this.seed + (uint64) e;
            Generator g = heap Generator(se);
            Tensor<int64> rows = g.integers(0, n, n);
            float64[] xa = heap float64[n * nf];
            float64[] ya = heap float64[n];
            int64 r = 0;
            while (r < n) {
                int64 src = rows.flatGet(r);
                this.inBag[e * n + src] = true;
                int64 c = 0;
                while (c < nf) { xa[r * nf + c] = x.flatGet(src * nf + c); c = c + 1; }
                ya[r] = y.get1(src);
                r = r + 1;
            }
            int64[] xsh = heap int64[2]; xsh[0] = n; xsh[1] = nf;
            int64[] ysh = heap int64[1]; ysh[0] = n;
            DecisionTreeClassifier t = heap DecisionTreeClassifier(
                "gini", this.maxDepth, "best", se);
            t.setMaxFeaturesNode(mf);
            t.fit(Tensor.of<float64>(xa, xsh), Tensor.of<float64>(ya, ysh));
            ms.add(#t);
            e = e + 1;
        }
        this.members #= ms;
        this.fitted = true;
        if (this.oobEnabled) {
            this.oobValue = this.computeOob(x, y);
            this.oobComputed = true;
        }
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** Flat [e*n + r] member label predictions. */
    #float64[] allPreds(Tensor<float64> x, int64 n) {
        float64[] preds = heap float64[this.nEstimators * n];
        int64 e = 0;
        while (e < this.nEstimators) {
            DecisionTreeClassifier t = this.members.get((int32) e);
            Tensor<float64> pe = t.predict(x);
            int64 r = 0;
            while (r < n) { preds[e * n + r] = pe.flatGet(r); r = r + 1; }
            e = e + 1;
        }
        return #preds;
    }

    /** `(n,)` labels by majority vote (ties → lowest label). */
    public #Tensor<float64> predict(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("RandomForestClassifier.predict: fit first");
        }
        int64 n = x.shapeAt(0);
        float64[] preds = this.allPreds(x, n);
        int64 kmax = 0;
        int64 i = 0;
        while (i < this.nEstimators * n) {
            if ((int64) preds[i] > kmax) { kmax = (int64) preds[i]; }
            i = i + 1;
        }
        float64[] out = heap float64[n];
        int64 r = 0;
        while (r < n) {
            int64[] votes = heap int64[kmax + 1];
            int64 e = 0;
            while (e < this.nEstimators) {
                int64 lb = (int64) preds[e * n + r];
                votes[lb] = votes[lb] + 1;
                e = e + 1;
            }
            int64 best = 0;
            int64 c = 1;
            while (c <= kmax) {
                if (votes[c] > votes[best]) { best = c; }
                c = c + 1;
            }
            out[r] = (float64) best;
            r = r + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = n;
        return Tensor.of<float64>(out, sh);
    }

    /** Accuracy. */
    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        Tensor<float64> p = this.predict(x);
        int64 n = p.shapeAt(0);
        int64 hits = 0;
        int64 i = 0;
        while (i < n) {
            if (p.get1(i) == y.get1(i)) { hits = hits + 1; }
            i = i + 1;
        }
        return (float64) hits / (float64) n;
    }

    float64 computeOob(Tensor<float64> x, Tensor<float64> y) {
        int64 n = this.nTrain;
        float64[] preds = this.allPreds(x, n);
        int64 kmax = 1;
        int64 i = 0;
        while (i < this.nEstimators * n) {
            if ((int64) preds[i] > kmax) { kmax = (int64) preds[i]; }
            i = i + 1;
        }
        int64 covered = 0;
        int64 hits = 0;
        int64 r = 0;
        while (r < n) {
            int64[] votes = heap int64[kmax + 1];
            int64 cnt = 0;
            int64 e = 0;
            while (e < this.nEstimators) {
                if (!this.inBag[e * n + r]) {
                    int64 lb = (int64) preds[e * n + r];
                    votes[lb] = votes[lb] + 1;
                    cnt = cnt + 1;
                }
                e = e + 1;
            }
            if (cnt > 0) {
                covered = covered + 1;
                int64 best = 0;
                int64 c = 1;
                while (c <= kmax) {
                    if (votes[c] > votes[best]) { best = c; }
                    c = c + 1;
                }
                if ((float64) best == y.get1(r)) { hits = hits + 1; }
            }
            r = r + 1;
        }
        if (covered == 0) {
            throw heap MlException("RandomForestClassifier oobScore: no sample "
                + "was ever out-of-bag (too few estimators) — the OOB estimate "
                + "does not exist for this configuration");
        }
        return (float64) hits / (float64) covered;
    }

    /** The out-of-bag accuracy computed at fit (requires setOobScore(true)). */
    public float64 oobScore() {
        if (!this.oobComputed) {
            throw heap MlException("RandomForestClassifier.oobScore: enable "
                + "setOobScore(true) before fit");
        }
        return this.oobValue;
    }

    /** Ensemble feature importances: the members' average (§5.1/4.1.4). */
    public #Tensor<float64> featureImportances() {
        if (!this.fitted) {
            throw heap MlException("RandomForestClassifier.featureImportances: fit first");
        }
        float64[] acc = heap float64[this.nFeatures];
        int64 e = 0;
        while (e < this.nEstimators) {
            DecisionTreeClassifier t = this.members.get((int32) e);
            Tensor<float64> imp = t.featureImportances();
            int64 f = 0;
            while (f < this.nFeatures) { acc[f] = acc[f] + imp.flatGet(f); f = f + 1; }
            e = e + 1;
        }
        int64 f2 = 0;
        while (f2 < this.nFeatures) { acc[f2] = acc[f2] / (float64) this.nEstimators; f2 = f2 + 1; }
        int64[] sh = heap int64[1]; sh[0] = this.nFeatures;
        return Tensor.of<float64>(acc, sh);
    }

    /** One member tree's rule dump — the per-node subsampling is visible
     *  structurally (a single tree mixes features even at maxFeatures 1). */
    public #String memberExport(int64 i) {
        if (!this.fitted) {
            throw heap MlException("RandomForestClassifier.memberExport: fit first");
        }
        DecisionTreeClassifier t = this.members.get((int32) i);
        return t.exportText();
    }
}
