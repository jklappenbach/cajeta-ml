package dev.cajeta.ml.cluster;

import cajeta.math.Tensor;
import cajeta.math.random.Generator;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.Predictor;

/**
 * K-means clustering (sklearn `KMeans`): seeded k-means++ initialization
 * over the stdlib `Generator` (deterministic per seed — NOT numpy's
 * stream; on separated data Lloyd's converged partition, centers, and
 * inertia are init-independent, and those are what the suite pins against
 * sklearn), then Lloyd iterations to a center-movement tolerance.
 *
 * `fit(x, y)` ignores `y` (the lifecycle-uniformity convention);
 * `predict` returns the nearest-center id per row; `score` is the sklearn
 * convention: NEGATIVE inertia of `x` under the fitted centers. Ties in
 * nearest-center go to the lowest index (documented determinism).
 */
public final class KMeans implements Predictor {

    private int64 kClusters;
    private uint64 seed;
    private int64 maxIter;
    private float64 tol;
    private Tensor<float64> centersM;   // (k, p)
    private Tensor<float64> labelsV;    // (n,) of the fit
    private float64 inertiaV;
    private int64 iters;
    private boolean fitted;

    public KMeans(int64 k, uint64 seed, int64 maxIter, float64 tol) {
        if (k < 1) {
            throw heap MlException("KMeans: k must be >= 1");
        }
        this.kClusters = k;
        this.seed = seed;
        this.maxIter = maxIter;
        this.tol = tol;
        this.fitted = false;
        return;
    }

    /** sklearn-ish defaults: maxIter 300, tol 1e-8 on center movement. */
    public KMeans(int64 k, uint64 seed) {
        if (k < 1) {
            throw heap MlException("KMeans: k must be >= 1");
        }
        this.kClusters = k;
        this.seed = seed;
        this.maxIter = 300;
        this.tol = 0.00000001;
        this.fitted = false;
        return;
    }

    static float64 dist2(Tensor<float64> x, int64 i,
                         float64[] cen, int64 c, int64 p) {
        float64 acc = 0.0;
        int64 j = 0;
        while (j < p) {
            float64 d = x.get2(i, j) - cen[c * p + j];
            acc = acc + d * d;
            j = j + 1;
        }
        return acc;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("KMeans.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64 k = this.kClusters;
        if (n < k) {
            throw heap MlException("KMeans.fit: n < k");
        }

        Generator gen = heap Generator(this.seed);
        float64[] cen = heap float64[k * p];

        // k-means++ (deterministic per seed): first center uniform, each
        // next sampled proportional to min squared distance.
        Tensor<float32> u0 = gen.uniform(1);
        int64 first = (int64) ((float64) u0.get1(0) * (float64) n);
        if (first >= n) { first = n - 1; }
        int64 j0 = 0;
        while (j0 < p) {
            cen[j0] = x.get2(first, j0);
            j0 = j0 + 1;
        }
        float64[] d2 = heap float64[n];
        int64 chosen = 1;
        while (chosen < k) {
            float64 total = 0.0;
            int64 i = 0;
            while (i < n) {
                float64 best = KMeans.dist2(x, i, cen, 0, p);
                int64 c = 1;
                while (c < chosen) {
                    float64 d = KMeans.dist2(x, i, cen, c, p);
                    if (d < best) { best = d; }
                    c = c + 1;
                }
                d2[i] = best;
                total = total + best;
                i = i + 1;
            }
            Tensor<float32> uu = gen.uniform(1);
            float64 target = (float64) uu.get1(0) * total;
            float64 cum = 0.0;
            int64 pick = n - 1;
            i = 0;
            while (i < n) {
                cum = cum + d2[i];
                if (cum >= target) { pick = i; i = n; }
                else { i = i + 1; }
            }
            int64 j = 0;
            while (j < p) {
                cen[chosen * p + j] = x.get2(pick, j);
                j = j + 1;
            }
            chosen = chosen + 1;
        }

        // Lloyd.
        int64[] label = heap int64[n];
        float64[] sums = heap float64[k * p];
        int64[] counts = heap int64[k];
        int64 it = 0;
        boolean moved = true;
        while (it < this.maxIter && moved) {
            int64 i = 0;
            while (i < n) {
                int64 best = 0;
                float64 bd = KMeans.dist2(x, i, cen, 0, p);
                int64 c = 1;
                while (c < k) {
                    float64 d = KMeans.dist2(x, i, cen, c, p);
                    if (d < bd) { bd = d; best = c; }
                    c = c + 1;
                }
                label[i] = best;
                i = i + 1;
            }
            int64 z = 0;
            while (z < k * p) { sums[z] = 0.0; z = z + 1; }
            z = 0;
            while (z < k) { counts[z] = 0; z = z + 1; }
            i = 0;
            while (i < n) {
                int64 c = label[i];
                counts[c] = counts[c] + 1;
                int64 j = 0;
                while (j < p) {
                    sums[c * p + j] = sums[c * p + j] + x.get2(i, j);
                    j = j + 1;
                }
                i = i + 1;
            }
            float64 shift = 0.0;
            int64 c2 = 0;
            while (c2 < k) {
                if (counts[c2] == 0) {
                    // Empty cluster: adopt the point farthest from its
                    // center (the standard rescue; deterministic).
                    int64 far = 0;
                    float64 fd = -1.0;
                    i = 0;
                    while (i < n) {
                        float64 d = KMeans.dist2(x, i, cen, label[i], p);
                        if (d > fd) { fd = d; far = i; }
                        i = i + 1;
                    }
                    int64 j = 0;
                    while (j < p) {
                        float64 nv = x.get2(far, j);
                        float64 dj = nv - cen[c2 * p + j];
                        shift = shift + dj * dj;
                        cen[c2 * p + j] = nv;
                        j = j + 1;
                    }
                } else {
                    int64 j = 0;
                    while (j < p) {
                        float64 nv = sums[c2 * p + j] / (float64) counts[c2];
                        float64 dj = nv - cen[c2 * p + j];
                        shift = shift + dj * dj;
                        cen[c2 * p + j] = nv;
                        j = j + 1;
                    }
                }
                c2 = c2 + 1;
            }
            moved = shift > this.tol;
            it = it + 1;
        }

        // Final assignment + inertia against the settled centers.
        float64 inert = 0.0;
        float64[] lab = heap float64[n];
        int64 i3 = 0;
        while (i3 < n) {
            int64 best = 0;
            float64 bd = KMeans.dist2(x, i3, cen, 0, p);
            int64 c = 1;
            while (c < k) {
                float64 d = KMeans.dist2(x, i3, cen, c, p);
                if (d < bd) { bd = d; best = c; }
                c = c + 1;
            }
            lab[i3] = (float64) best;
            inert = inert + bd;
            i3 = i3 + 1;
        }
        int64[] cs = heap int64[2];
        cs[0] = k;
        cs[1] = p;
        Tensor<float64> cm = Tensor.of<float64>(cen, cs);
        int64[] ls = heap int64[1];
        ls[0] = n;
        Tensor<float64> lm = Tensor.of<float64>(lab, ls);
        this.centersM #= cm;
        this.labelsV #= lm;
        this.inertiaV = inert;
        this.iters = it;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** `(k, p)` settled centers. */
    public Tensor<float64> centers() {
        if (!this.fitted) {
            throw heap MlException("KMeans.centers: fit first");
        }
        return this.centersM;
    }

    /** The fit's `(n,)` cluster ids. */
    public Tensor<float64> labels() {
        if (!this.fitted) {
            throw heap MlException("KMeans.labels: fit first");
        }
        return this.labelsV;
    }

    /** Within-cluster sum of squares of the fit. */
    public float64 inertia() {
        if (!this.fitted) {
            throw heap MlException("KMeans.inertia: fit first");
        }
        return this.inertiaV;
    }

    public int64 iterations() {
        return this.iters;
    }

    /** Nearest-center id per row (lowest index on ties). */
    public #Tensor<float64> predict(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("KMeans.predict: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = this.centersM.shapeAt(1);
        int64 k = this.centersM.shapeAt(0);
        if (x.ndim() != 2 || x.shapeAt(1) != p) {
            throw heap MlException(
                "KMeans.predict: x must be (n, p) with p matching the fit");
        }
        float64[] cen = heap float64[k * p];
        int64 c0 = 0;
        while (c0 < k) {
            int64 j = 0;
            while (j < p) {
                cen[c0 * p + j] = this.centersM.get2(c0, j);
                j = j + 1;
            }
            c0 = c0 + 1;
        }
        float64[] out = heap float64[n];
        int64 i = 0;
        while (i < n) {
            int64 best = 0;
            float64 bd = KMeans.dist2(x, i, cen, 0, p);
            int64 c = 1;
            while (c < k) {
                float64 d = KMeans.dist2(x, i, cen, c, p);
                if (d < bd) { bd = d; best = c; }
                c = c + 1;
            }
            out[i] = (float64) best;
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = n;
        return Tensor.of<float64>(out, sh);
    }

    /** sklearn's `score` convention for KMeans: NEGATIVE inertia of `x`. */
    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        if (!this.fitted) {
            throw heap MlException("KMeans.score: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = this.centersM.shapeAt(1);
        int64 k = this.centersM.shapeAt(0);
        float64[] cen = heap float64[k * p];
        int64 c0 = 0;
        while (c0 < k) {
            int64 j = 0;
            while (j < p) {
                cen[c0 * p + j] = this.centersM.get2(c0, j);
                j = j + 1;
            }
            c0 = c0 + 1;
        }
        float64 inert = 0.0;
        int64 i = 0;
        while (i < n) {
            float64 bd = KMeans.dist2(x, i, cen, 0, p);
            int64 c = 1;
            while (c < k) {
                float64 d = KMeans.dist2(x, i, cen, c, p);
                if (d < bd) { bd = d; }
                c = c + 1;
            }
            inert = inert + bd;
            i = i + 1;
        }
        return 0.0 - inert;
    }
}
