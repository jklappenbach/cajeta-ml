package dev.cajeta.ml.select;

import cajeta.math.Tensor;
import cajeta.math.random.Generator;
import dev.cajeta.ml.MlException;

/**
 * K-fold cross-validation splitter (sklearn `KFold`): rows are assigned to
 * `k` folds — the first `n mod k` folds get `⌊n/k⌋+1` rows (sklearn's size
 * rule) — contiguously in row order, or over a seeded permutation when
 * `shuffle` is set. Deterministic per seed.
 */
public final class KFold {

    private int64 k;
    private boolean shuffle;
    private uint64 seed;

    public KFold(int64 k, boolean shuffle, uint64 seed) {
        if (k < 2) {
            throw heap MlException("KFold: k must be >= 2");
        }
        this.k = k;
        this.shuffle = shuffle;
        this.seed = seed;
        return;
    }

    public int64 folds() {
        return this.k;
    }

    /**
     * The fold id (`0..k-1`) of each of `n` rows: a `(n,)` int64 tensor.
     * Train/test masks for fold `f` derive directly (`test = id == f`).
     */
    public #Tensor<int64> assignments(int64 n) {
        if (n < this.k) {
            throw heap MlException("KFold.assignments: n < k");
        }
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<int64> out = Tensor.zeros<int64>(sh);
        // row order: identity, or a seeded permutation when shuffling
        Generator gen = heap Generator(this.seed);
        Tensor<int64> perm = gen.permutation(n);
        int64 base = n / this.k;
        int64 extra = n % this.k;
        int64 pos = 0;
        int64 f = 0;
        while (f < this.k) {
            int64 size = base;
            if (f < extra) { size = size + 1; }
            int64 c = 0;
            while (c < size) {
                int64 row = pos + c;
                if (this.shuffle) { row = perm.get1(pos + c); }
                out.set1(row, f);
                c = c + 1;
            }
            pos = pos + size;
            f = f + 1;
        }
        return #out;
    }
}
