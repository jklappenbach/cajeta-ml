package dev.cajeta.ml;

import cajeta.math.Tensor;

/**
 * {@link EstimatorFactory} for {@link DecisionTreeRegressor}
 * (squared_error): `params[0]` = maxDepth (0 = unbounded).
 */
public final class TreeRegressorFactory implements EstimatorFactory {

    public TreeRegressorFactory() { return; }

    public #Predictor create(Tensor<float64> params) {
        int64 maxDepth = params.shapeAt(0) > 0 ? (int64) params.flatGet(0) : (int64) 0;
        return heap DecisionTreeRegressor(maxDepth);
    }
}
