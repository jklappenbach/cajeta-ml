package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.linalg.LinAlg;

/**
 * Non-negative matrix factorization (sklearn `NMF`, Frobenius objective,
 * coordinate descent): `X ≈ W·H` with `W, H >= 0`, initialized by NNDSVD
 * (deterministic — no seed) and refined by cyclic HALS updates, sklearn's
 * `solver='cd'` (§10.3, §11.8). Negative input is rejected NAMING the
 * offending entry (§10.4); `reconstructionError` exposes the final
 * Frobenius norm `‖X − WH‖`, sklearn's `reconstruction_err_`.
 *
 * Factor pairs are identifiable up to permutation and the W↔H scale split
 * (§12.9); the deterministic NNDSVD init makes runs reproducible without
 * a seed.
 */
public final class NMF implements Transformer {

    private int64 kComp;
    private int64 maxIter;
    private float64 tol;
    private int64 pFeat;
    private float64[] hA;        // (k*p)
    private Tensor<float64> wFit;    // (n, k) of the fit
    private float64 errV;
    private boolean fitted;

    /** maxIter 2000, tol 1e-10 on relative error change. */
    public NMF(int64 k) {
        if (k < 1) {
            throw heap MlException("NMF: k must be >= 1");
        }
        this.kComp = k;
        this.maxIter = 2000;
        this.tol = 0.0000000001;
        this.fitted = false;
        return;
    }

    public NMF(int64 k, int64 maxIter, float64 tol) {
        if (k < 1) {
            throw heap MlException("NMF: k must be >= 1");
        }
        this.kComp = k;
        this.maxIter = maxIter;
        this.tol = tol;
        this.fitted = false;
        return;
    }

    /** One full cyclic HALS pass over the columns of `w` (n×k), `h`
     *  (k×p) fixed — shared by fit (both factors) and transform. */
    static void halsW(float64[] w, float64[] h, Tensor<float64> x,
                      int64 n, int64 p, int64 k) {
        int64 c = 0;
        while (c < k) {
            float64 hh = 0.0;
            int64 j = 0;
            while (j < p) {
                hh = hh + h[c * p + j] * h[c * p + j];
                j = j + 1;
            }
            if (hh < 1.0E-300) {
                hh = 1.0E-300;
            }
            int64 i = 0;
            while (i < n) {
                // grad numerator: (X·Hᵀ − W·(H·Hᵀ))[i,c]
                float64 xh = 0.0;
                j = 0;
                while (j < p) {
                    xh = xh + x.get2(i, j) * h[c * p + j];
                    j = j + 1;
                }
                float64 whh = 0.0;
                int64 d = 0;
                while (d < k) {
                    float64 hd = 0.0;
                    j = 0;
                    while (j < p) {
                        hd = hd + h[d * p + j] * h[c * p + j];
                        j = j + 1;
                    }
                    whh = whh + w[i * k + d] * hd;
                    d = d + 1;
                }
                float64 nv = w[i * k + c] + (xh - whh) / hh;
                if (nv < 0.0) {
                    nv = 0.0;
                }
                w[i * k + c] = nv;
                i = i + 1;
            }
            c = c + 1;
        }
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("NMF.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64 k = this.kComp;
        this.pFeat = p;
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                if (x.get2(i, j) < 0.0) {
                    throw heap MlException(
                        "NMF.fit: negative input at X["
                        + Int64.of(i).toString() + ", "
                        + Int64.of(j).toString()
                        + "] — NMF requires non-negative data");
                }
                j = j + 1;
            }
            i = i + 1;
        }

        // NNDSVD init (Boutsidis & Gallopoulos) — deterministic.
        Tensor<float64>[] usv = LinAlg.svd<float64>(x);
        Tensor<float64> uM = usv[0];
        Tensor<float64> sV = usv[1];
        Tensor<float64> vt = usv[2];
        float64[] w = heap float64[n * k];
        float64[] h = heap float64[k * p];
        // Leading pair: non-negative by Perron-Frobenius; abs guards sign.
        float64 s0 = Math.sqrt(sV.get1(0));
        i = 0;
        while (i < n) {
            float64 v = uM.get2(i, 0);
            if (v < 0.0) {
                v = 0.0 - v;
            }
            w[i * k] = s0 * v;
            i = i + 1;
        }
        int64 j2 = 0;
        while (j2 < p) {
            float64 v = vt.get2(0, j2);
            if (v < 0.0) {
                v = 0.0 - v;
            }
            h[j2] = s0 * v;
            j2 = j2 + 1;
        }
        int64 c = 1;
        while (c < k) {
            float64 xp = 0.0;
            float64 xn = 0.0;
            i = 0;
            while (i < n) {
                float64 v = uM.get2(i, c);
                if (v > 0.0) {
                    xp = xp + v * v;
                } else {
                    xn = xn + v * v;
                }
                i = i + 1;
            }
            float64 yp = 0.0;
            float64 yn = 0.0;
            j2 = 0;
            while (j2 < p) {
                float64 v = vt.get2(c, j2);
                if (v > 0.0) {
                    yp = yp + v * v;
                } else {
                    yn = yn + v * v;
                }
                j2 = j2 + 1;
            }
            xp = Math.sqrt(xp);
            xn = Math.sqrt(xn);
            yp = Math.sqrt(yp);
            yn = Math.sqrt(yn);
            float64 mp = xp * yp;
            float64 mn = xn * yn;
            boolean usePos = mp >= mn;
            float64 sig = mn;
            if (usePos) {
                sig = mp;
            }
            float64 scale = Math.sqrt(sV.get1(c) * sig);
            i = 0;
            while (i < n) {
                float64 v = uM.get2(i, c);
                float64 keep = 0.0;
                if (usePos && v > 0.0) {
                    keep = v / xp;
                }
                if (!usePos && v < 0.0) {
                    keep = (0.0 - v) / xn;
                }
                w[i * k + c] = scale * keep;
                i = i + 1;
            }
            j2 = 0;
            while (j2 < p) {
                float64 v = vt.get2(c, j2);
                float64 keep = 0.0;
                if (usePos && v > 0.0) {
                    keep = v / yp;
                }
                if (!usePos && v < 0.0) {
                    keep = (0.0 - v) / yn;
                }
                h[c * p + j2] = scale * keep;
                j2 = j2 + 1;
            }
            c = c + 1;
        }

        // Cyclic HALS on W then H until the error change is tiny.
        float64 prevErr = 0.0 - 1.0;
        int64 it = 0;
        boolean go = true;
        while (it < this.maxIter && go) {
            NMF.halsW(w, h, x, n, p, k);
            // H update = W update on the transposed problem, done inline.
            c = 0;
            while (c < k) {
                float64 ww = 0.0;
                i = 0;
                while (i < n) {
                    ww = ww + w[i * k + c] * w[i * k + c];
                    i = i + 1;
                }
                if (ww < 1.0E-300) {
                    ww = 1.0E-300;
                }
                j2 = 0;
                while (j2 < p) {
                    float64 wx = 0.0;
                    i = 0;
                    while (i < n) {
                        wx = wx + w[i * k + c] * x.get2(i, j2);
                        i = i + 1;
                    }
                    float64 hww = 0.0;
                    int64 d = 0;
                    while (d < k) {
                        float64 wd = 0.0;
                        i = 0;
                        while (i < n) {
                            wd = wd + w[i * k + d] * w[i * k + c];
                            i = i + 1;
                        }
                        hww = hww + h[d * p + j2] * wd;
                        d = d + 1;
                    }
                    float64 nv = h[c * p + j2] + (wx - hww) / ww;
                    if (nv < 0.0) {
                        nv = 0.0;
                    }
                    h[c * p + j2] = nv;
                    j2 = j2 + 1;
                }
                c = c + 1;
            }
            // Frobenius error.
            float64 err2 = 0.0;
            i = 0;
            while (i < n) {
                j2 = 0;
                while (j2 < p) {
                    float64 rec = 0.0;
                    int64 d = 0;
                    while (d < k) {
                        rec = rec + w[i * k + d] * h[d * p + j2];
                        d = d + 1;
                    }
                    float64 df = x.get2(i, j2) - rec;
                    err2 = err2 + df * df;
                    j2 = j2 + 1;
                }
                i = i + 1;
            }
            float64 err = Math.sqrt(err2);
            if (prevErr >= 0.0) {
                float64 ch = prevErr - err;
                if (ch < 0.0) {
                    ch = 0.0 - ch;
                }
                if (ch < this.tol * (1.0 + prevErr)) {
                    go = false;
                }
            }
            prevErr = err;
            it = it + 1;
        }
        this.errV = prevErr;
        this.hA #= h;
        int64[] ws = heap int64[2];
        ws[0] = n;
        ws[1] = k;
        Tensor<float64> wt = Tensor.of<float64>(w, ws);
        this.wFit #= wt;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** The `(k, p)` non-negative components `H`. */
    public #Tensor<float64> components() {
        if (!this.fitted) {
            throw heap MlException("NMF.components: fit first");
        }
        int64 k = this.kComp;
        int64 p = this.pFeat;
        float64[] out = heap float64[k * p];
        int64 i = 0;
        while (i < k * p) {
            out[i] = this.hA[i];
            i = i + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = k;
        sh[1] = p;
        return Tensor.of<float64>(out, sh);
    }

    /** Final Frobenius norm `‖X − WH‖` (sklearn `reconstruction_err_`). */
    public float64 reconstructionError() {
        if (!this.fitted) {
            throw heap MlException("NMF.reconstructionError: fit first");
        }
        return this.errV;
    }

    /** Non-negative `(n, k)` weights for `x` under the FITTED `H`:
     *  HALS on `W` alone. */
    public #Tensor<float64> transform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("NMF.transform: fit first");
        }
        int64 n = x.shapeAt(0);
        int64 p = this.pFeat;
        int64 k = this.kComp;
        if (x.ndim() != 2 || x.shapeAt(1) != p) {
            throw heap MlException(
                "NMF.transform: x must be (n, p) matching the fit");
        }
        float64[] w = heap float64[n * k];
        int64 i = 0;
        while (i < n * k) {
            w[i] = 0.01;
            i = i + 1;
        }
        int64 it = 0;
        while (it < 500) {
            NMF.halsW(w, this.hA, x, n, p, k);
            it = it + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = k;
        return Tensor.of<float64>(w, sh);
    }

    public #Tensor<float64> fitTransform(Tensor<float64> x,
                                         Tensor<float64> y) {
        this.fit(x, y);
        return this.transform(x);
    }

    /** `w · H` — back to feature space (sklearn `inverse_transform`). */
    public #Tensor<float64> inverseTransform(Tensor<float64> w) {
        if (!this.fitted) {
            throw heap MlException("NMF.inverseTransform: fit first");
        }
        int64 n = w.shapeAt(0);
        int64 p = this.pFeat;
        int64 k = this.kComp;
        float64[] out = heap float64[n * p];
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                float64 s = 0.0;
                int64 c = 0;
                while (c < k) {
                    s = s + w.get2(i, c) * this.hA[c * p + j];
                    c = c + 1;
                }
                out[i * p + j] = s;
                j = j + 1;
            }
            i = i + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = p;
        return Tensor.of<float64>(out, sh);
    }
}
