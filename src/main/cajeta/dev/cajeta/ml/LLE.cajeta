package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.linalg.LinAlg;

/**
 * Locally linear embedding, standard variant (sklearn
 * `LocallyLinearEmbedding`): reconstruction weights are solved per point
 * from its k neighbours with the documented regularization
 * (`C += I·reg·trace(C)`, reg 1e-3), and the embedding is the bottom
 * NON-TRIVIAL eigenvectors of `M = (I−W)ᵀ(I−W)` via `LinAlg.eigh`
 * (§9.12). The trivial (constant) eigenvector is identified by its
 * near-zero variance — robust when the bottom eigenvalues crowd zero —
 * and dropped.
 *
 * `reconstructionError` is `trace(YᵀMY)`, sklearn's
 * `reconstruction_error_`. `transform` embeds unseen rows by
 * reconstructing them from training neighbours and mapping through the
 * fitted embedding (§9.14). Exact and dense (§9.15); deterministic up
 * to eigenvector sign (§9.16).
 */
public final class LLE implements Transformer {

    private int64 kNeighbors;
    private int64 kComp;
    private float64 regParam;
    private int64 nTrain;
    private int64 pFeat;
    private Tensor<float64> xTrain;
    private Tensor<float64> embV;    // (n, d)
    private float64 recErr;
    private boolean fitted;

    /** reg 1e-3, sklearn's default. */
    public LLE(int64 nNeighbors, int64 nComponents) {
        if (nNeighbors < 1 || nComponents < 1) {
            throw heap MlException(
                "LLE: nNeighbors and nComponents must be >= 1");
        }
        this.kNeighbors = nNeighbors;
        this.kComp = nComponents;
        this.regParam = 0.001;
        this.fitted = false;
        return;
    }

    public LLE(int64 nNeighbors, int64 nComponents, float64 reg) {
        if (nNeighbors < 1 || nComponents < 1) {
            throw heap MlException(
                "LLE: nNeighbors and nComponents must be >= 1");
        }
        this.kNeighbors = nNeighbors;
        this.kComp = nComponents;
        this.regParam = reg;
        this.fitted = false;
        return;
    }

    /** Regularized reconstruction weights of row `zi` of `z` against its
     *  `k` nearest training rows (self excluded when `excludeIdx` >= 0);
     *  fills `nbr` (k) and `wgt` (k). */
    private void weights(Tensor<float64> z, int64 zi, int64 excludeIdx,
                         int64[] nbr, float64[] wgt) {
        int64 n = this.nTrain;
        int64 p = this.pFeat;
        int64 k = this.kNeighbors;
        boolean[] used = heap boolean[n];
        if (excludeIdx >= (int64) 0) {
            used[excludeIdx] = true;
        }
        int64 t = 0;
        while (t < k) {
            int64 best = 0 - (int64) 1;
            float64 bd = 0.0;
            int64 i = 0;
            while (i < n) {
                if (!used[i]) {
                    float64 s = 0.0;
                    int64 j = 0;
                    while (j < p) {
                        float64 d = this.xTrain.get2(i, j) - z.get2(zi, j);
                        s = s + d * d;
                        j = j + 1;
                    }
                    if (best < (int64) 0 || s < bd) {
                        bd = s;
                        best = i;
                    }
                }
                i = i + 1;
            }
            used[best] = true;
            nbr[t] = best;
            t = t + 1;
        }
        // C = (z − N)(z − N)ᵀ over neighbours, regularized, solve C w = 1.
        int64[] cs = heap int64[2];
        cs[0] = k;
        cs[1] = k;
        Tensor<float64> cM = Tensor.zeros<float64>(cs);
        float64 trace = 0.0;
        int64 a = 0;
        while (a < k) {
            int64 b = 0;
            while (b < k) {
                float64 s = 0.0;
                int64 j = 0;
                while (j < p) {
                    s = s + (z.get2(zi, j) - this.xTrain.get2(nbr[a], j))
                          * (z.get2(zi, j) - this.xTrain.get2(nbr[b], j));
                    j = j + 1;
                }
                cM.flatSet(a * k + b, s);
                if (a == b) {
                    trace = trace + s;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        float64 r = this.regParam;
        if (trace > 0.0) {
            r = this.regParam * trace;
        }
        a = 0;
        while (a < k) {
            cM.flatSet(a * k + a, cM.flatGet(a * k + a) + r);
            a = a + 1;
        }
        int64[] os = heap int64[2];
        os[0] = k;
        os[1] = 1;
        Tensor<float64> ones = Tensor.zeros<float64>(os);
        a = 0;
        while (a < k) {
            ones.flatSet(a, 1.0);
            a = a + 1;
        }
        Tensor<float64> sol = LinAlg.solve<float64>(cM, ones);
        float64 sum = 0.0;
        a = 0;
        while (a < k) {
            sum = sum + sol.flatGet(a);
            a = a + 1;
        }
        a = 0;
        while (a < k) {
            wgt[a] = sol.flatGet(a) / sum;
            a = a + 1;
        }
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("LLE.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64 k = this.kNeighbors;
        int64 d = this.kComp;
        if (k >= n) {
            throw heap MlException("LLE.fit: nNeighbors must be < n");
        }
        this.nTrain = n;
        this.pFeat = p;
        Tensor<float64> xc = x.copy();
        this.xTrain #= xc;

        // W row per point.
        float64[] wM = heap float64[n * n];
        int64[] nbr = heap int64[k];
        float64[] wgt = heap float64[k];
        int64 i = 0;
        while (i < n) {
            this.weights(x, i, i, nbr, wgt);
            int64 t = 0;
            while (t < k) {
                wM[i * n + nbr[t]] = wgt[t];
                t = t + 1;
            }
            i = i + 1;
        }
        // M = (I−W)ᵀ(I−W).
        int64[] ms = heap int64[2];
        ms[0] = n;
        ms[1] = n;
        Tensor<float64> mM = Tensor.zeros<float64>(ms);
        int64 a = 0;
        while (a < n) {
            int64 b = 0;
            while (b < n) {
                float64 s = 0.0;
                int64 q = 0;
                while (q < n) {
                    float64 ia = 0.0 - wM[q * n + a];
                    if (q == a) {
                        ia = ia + 1.0;
                    }
                    float64 ib = 0.0 - wM[q * n + b];
                    if (q == b) {
                        ib = ib + 1.0;
                    }
                    s = s + ia * ib;
                    q = q + 1;
                }
                mM.flatSet(a * n + b, s);
                b = b + 1;
            }
            a = a + 1;
        }
        Tensor<float64>[] ev = LinAlg.eigh<float64>(mM);
        Tensor<float64> w = ev[0];
        Tensor<float64> v = ev[1];
        // Identify the trivial eigenvector among the bottom d+3 BY ITS
        // VARIANCE (the constant vector), then take the next d ascending.
        int64 scan = d + (int64) 3;
        if (scan > n) {
            scan = n;
        }
        int64 trivial = 0;
        float64 bestVar = 0.0 - 1.0;
        int64 c = 0;
        while (c < scan) {
            float64 mean = 0.0;
            i = 0;
            while (i < n) {
                mean = mean + v.get2(i, c);
                i = i + 1;
            }
            mean = mean / (float64) n;
            float64 var = 0.0;
            i = 0;
            while (i < n) {
                float64 dv = v.get2(i, c) - mean;
                var = var + dv * dv;
                i = i + 1;
            }
            if (bestVar < 0.0 || var < bestVar) {
                bestVar = var;
                trivial = c;
            }
            c = c + 1;
        }
        float64[] emb = heap float64[n * d];
        float64 err = 0.0;
        int64 outC = 0;
        c = 0;
        while (outC < d) {
            if (c != trivial) {
                i = 0;
                while (i < n) {
                    emb[i * d + outC] = v.get2(i, c);
                    i = i + 1;
                }
                err = err + w.get1(c);
                outC = outC + 1;
            }
            c = c + 1;
        }
        this.recErr = err;
        int64[] es = heap int64[2];
        es[0] = n;
        es[1] = d;
        Tensor<float64> et = Tensor.of<float64>(emb, es);
        this.embV #= et;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /** The fitted `(n, d)` embedding (unit-norm eigenvector columns,
     *  sign-indeterminate). */
    public Tensor<float64> embedding() {
        if (!this.fitted) {
            throw heap MlException("LLE.embedding: fit first");
        }
        return this.embV;
    }

    /** `trace(YᵀMY)` — sklearn's `reconstruction_error_`. */
    public float64 reconstructionError() {
        if (!this.fitted) {
            throw heap MlException("LLE.reconstructionError: fit first");
        }
        return this.recErr;
    }

    /** Embed unseen rows: reconstruction weights against training
     *  neighbours, mapped through the fitted embedding. */
    public #Tensor<float64> transform(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("LLE.transform: fit first");
        }
        int64 m = x.shapeAt(0);
        int64 d = this.kComp;
        int64 k = this.kNeighbors;
        if (x.ndim() != 2 || x.shapeAt(1) != this.pFeat) {
            throw heap MlException(
                "LLE.transform: x must be (m, p) matching the fit");
        }
        float64[] out = heap float64[m * d];
        int64[] nbr = heap int64[k];
        float64[] wgt = heap float64[k];
        int64 zi = 0;
        while (zi < m) {
            this.weights(x, zi, 0 - (int64) 1, nbr, wgt);
            int64 c = 0;
            while (c < d) {
                float64 s = 0.0;
                int64 t = 0;
                while (t < k) {
                    s = s + wgt[t] * this.embV.get2(nbr[t], c);
                    t = t + 1;
                }
                out[zi * d + c] = s;
                c = c + 1;
            }
            zi = zi + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = m;
        sh[1] = d;
        return Tensor.of<float64>(out, sh);
    }

    public #Tensor<float64> fitTransform(Tensor<float64> x,
                                         Tensor<float64> y) {
        this.fit(x, y);
        return this.embV.copy();
    }
}
