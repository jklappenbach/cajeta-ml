package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.Math;
import cajeta.math.linalg.LinAlg;

/**
 * Shared Gaussian-classifier machinery (spec §4): priors, class means, the
 * pooled and per-class covariance estimators, Ledoit-Wolf shrinkage, the
 * Cholesky log-density, and log-sum-exp. LDA and QDA both build on this
 * class, so they agree numerically (§4.3) and neither carries a private
 * covariance copy (§4.1).
 *
 * Covariance conventions are sklearn's: `pooledCovariance` is the
 * priors-weighted mean of per-class ML covariances (divisor `n_k` — LDA's
 * `covariance_`), while `classCovariance` uses divisor `n_k - 1` (QDA's
 * `covariance_`).
 */
public final class Gaussians {

    static float64 LOG_2PI = 1.8378770664093453;

    /** Empirical class priors: frequency of each label `0..k-1` in `y (n,)`. */
    public static #Tensor<float64> priors(Tensor<float64> y, int64 k) {
        int64 n = y.size();
        int64[] sh = heap int64[1];
        sh[0] = k;
        Tensor<float64> pr = Tensor.zeros<float64>(sh);
        int64 i = 0;
        while (i < n) {
            int64 c = (int64) y.flatGet(i);
            pr.flatSet(c, pr.flatGet(c) + 1.0);
            i = i + 1;
        }
        int64 j = 0;
        while (j < k) {
            pr.flatSet(j, pr.flatGet(j) / (float64) n);
            j = j + 1;
        }
        return #pr;
    }

    /** Reject priors that do not sum to 1 or carry a negative entry (§2.2). */
    public static void validatePriors(Tensor<float64> pr) {
        float64 sum = 0.0;
        int64 i = 0;
        while (i < pr.size()) {
            float64 v = pr.flatGet(i);
            if (v < 0.0) {
                throw heap MlException(
                    "Gaussians: priors must be non-negative");
            }
            sum = sum + v;
            i = i + 1;
        }
        float64 diff = sum - 1.0;
        if (diff < 0.0) {
            diff = -diff;
        }
        if (diff > 0.000001) {
            throw heap MlException("Gaussians: priors must sum to 1");
        }
        return;
    }

    /** Per-class means: `(k, p)` from `x (n, p)` and labels `y (n,)`. */
    public static #Tensor<float64> classMeans(Tensor<float64> x,
                                              Tensor<float64> y, int64 k) {
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64[] sh = heap int64[2];
        sh[0] = k;
        sh[1] = p;
        Tensor<float64> mu = Tensor.zeros<float64>(sh);
        int64[] cs = heap int64[1];
        cs[0] = k;
        Tensor<float64> counts = Tensor.zeros<float64>(cs);
        int64 i = 0;
        while (i < n) {
            int64 c = (int64) y.flatGet(i);
            counts.flatSet(c, counts.flatGet(c) + 1.0);
            int64 j = 0;
            while (j < p) {
                mu.flatSet(c * p + j, mu.flatGet(c * p + j) + x.get2(i, j));
                j = j + 1;
            }
            i = i + 1;
        }
        int64 c2 = 0;
        while (c2 < k) {
            float64 cnt = counts.flatGet(c2);
            if (cnt > 0.0) {
                int64 j = 0;
                while (j < p) {
                    mu.flatSet(c2 * p + j, mu.flatGet(c2 * p + j) / cnt);
                    j = j + 1;
                }
            }
            c2 = c2 + 1;
        }
        return #mu;
    }

    /**
     * Pooled within-class covariance `(p, p)`: the priors-weighted mean of
     * per-class ML covariances (sklearn LDA's `covariance_` — §4.1).
     */
    public static #Tensor<float64> pooledCovariance(Tensor<float64> x,
                                                    Tensor<float64> y,
                                                    int64 k) {
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        Tensor<float64> mu = classMeans(x, y, k);
        Tensor<float64> pr = priors(y, k);
        int64[] cs = heap int64[1];
        cs[0] = k;
        Tensor<float64> counts = Tensor.zeros<float64>(cs);
        int64 i = 0;
        while (i < n) {
            int64 c = (int64) y.flatGet(i);
            counts.flatSet(c, counts.flatGet(c) + 1.0);
            i = i + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = p;
        sh[1] = p;
        Tensor<float64> cov = Tensor.zeros<float64>(sh);
        int64 c3 = 0;
        while (c3 < k) {
            float64 cnt = counts.flatGet(c3);
            if (cnt > 0.0) {
                float64 w = pr.flatGet(c3) / cnt;      // prior_k / n_k (ML)
                int64 r = 0;
                while (r < n) {
                    if ((int64) y.flatGet(r) == c3) {
                        int64 a = 0;
                        while (a < p) {
                            float64 da = x.get2(r, a) - mu.get2(c3, a);
                            int64 b = 0;
                            while (b < p) {
                                float64 db = x.get2(r, b) - mu.get2(c3, b);
                                cov.flatSet(a * p + b,
                                    cov.flatGet(a * p + b) + w * da * db);
                                b = b + 1;
                            }
                            a = a + 1;
                        }
                    }
                    r = r + 1;
                }
            }
            c3 = c3 + 1;
        }
        return #cov;
    }

    /**
     * One class's covariance `(p, p)`, divisor `n_k - 1` (sklearn QDA's
     * `covariance_`). A class with fewer than two members is reported
     * loudly, naming the class (§3.3 groundwork).
     */
    public static #Tensor<float64> classCovariance(Tensor<float64> x,
                                                   Tensor<float64> y,
                                                   int64 label) {
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        int64 nk = 0;
        int64 i = 0;
        while (i < n) {
            if ((int64) y.flatGet(i) == label) {
                nk = nk + 1;
            }
            i = i + 1;
        }
        if (nk < 2) {
            throw heap MlException("Gaussians: class "
                + Int64.of(label).toString()
                + " has fewer than 2 members; its covariance cannot be "
                + "estimated — regularize, or use LDA");
        }
        int64[] ms = heap int64[1];
        ms[0] = p;
        Tensor<float64> mean = Tensor.zeros<float64>(ms);
        i = 0;
        while (i < n) {
            if ((int64) y.flatGet(i) == label) {
                int64 j = 0;
                while (j < p) {
                    mean.flatSet(j, mean.flatGet(j) + x.get2(i, j));
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        int64 j2 = 0;
        while (j2 < p) {
            mean.flatSet(j2, mean.flatGet(j2) / (float64) nk);
            j2 = j2 + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = p;
        sh[1] = p;
        Tensor<float64> cov = Tensor.zeros<float64>(sh);
        i = 0;
        while (i < n) {
            if ((int64) y.flatGet(i) == label) {
                int64 a = 0;
                while (a < p) {
                    float64 da = x.get2(i, a) - mean.flatGet(a);
                    int64 b = 0;
                    while (b < p) {
                        float64 db = x.get2(i, b) - mean.flatGet(b);
                        cov.flatSet(a * p + b,
                            cov.flatGet(a * p + b) + da * db);
                        b = b + 1;
                    }
                    a = a + 1;
                }
            }
            i = i + 1;
        }
        float64 div = (float64) (nk - 1);
        int64 f = 0;
        while (f < p * p) {
            cov.flatSet(f, cov.flatGet(f) / div);
            f = f + 1;
        }
        return #cov;
    }

    /**
     * Ledoit-Wolf 2004: `[shrunk (p,p), shrinkage (1,)]` on `x (n,p)`,
     * exactly sklearn's `ledoit_wolf` (centered, ML empirical covariance,
     * shrunk toward `(trace/p)·I`) — §4.2.
     */
    public static #Tensor<float64>[] ledoitWolf(Tensor<float64> x) {
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        // Center by column means.
        int64[] cs = heap int64[1];
        cs[0] = p;
        Tensor<float64> colMean = Tensor.zeros<float64>(cs);
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                colMean.flatSet(j, colMean.flatGet(j) + x.get2(i, j));
                j = j + 1;
            }
            i = i + 1;
        }
        int64 j3 = 0;
        while (j3 < p) {
            colMean.flatSet(j3, colMean.flatGet(j3) / (float64) n);
            j3 = j3 + 1;
        }
        int64[] xs = heap int64[2];
        xs[0] = n;
        xs[1] = p;
        Tensor<float64> xc = Tensor.zeros<float64>(xs);
        i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < p) {
                xc.flatSet(i * p + j, x.get2(i, j) - colMean.flatGet(j));
                j = j + 1;
            }
            i = i + 1;
        }
        // emp_cov = xc'xc / n; mu = trace/p.
        int64[] sh = heap int64[2];
        sh[0] = p;
        sh[1] = p;
        Tensor<float64> emp = Tensor.zeros<float64>(sh);
        int64 a = 0;
        while (a < p) {
            int64 b = 0;
            while (b < p) {
                float64 s = 0.0;
                int64 r = 0;
                while (r < n) {
                    s = s + xc.get2(r, a) * xc.get2(r, b);
                    r = r + 1;
                }
                emp.flatSet(a * p + b, s / (float64) n);
                b = b + 1;
            }
            a = a + 1;
        }
        float64 mu = 0.0;
        int64 t = 0;
        while (t < p) {
            mu = mu + emp.get2(t, t);
            t = t + 1;
        }
        mu = mu / (float64) p;
        // beta_ = sum(X2' X2); delta_ = sum((xc' xc)^2) / n^2.
        float64 betaRaw = 0.0;
        float64 deltaRaw = 0.0;
        a = 0;
        while (a < p) {
            int64 b = 0;
            while (b < p) {
                float64 s2 = 0.0;
                float64 s = 0.0;
                int64 r = 0;
                while (r < n) {
                    float64 va = xc.get2(r, a);
                    float64 vb = xc.get2(r, b);
                    s2 = s2 + va * va * vb * vb;
                    s = s + va * vb;
                    r = r + 1;
                }
                betaRaw = betaRaw + s2;
                deltaRaw = deltaRaw + s * s;
                b = b + 1;
            }
            a = a + 1;
        }
        deltaRaw = deltaRaw / ((float64) n * (float64) n);
        float64 beta = (betaRaw / (float64) n - deltaRaw)
            / ((float64) p * (float64) n);
        float64 trace = mu * (float64) p;
        float64 delta = (deltaRaw - 2.0 * mu * trace
            + (float64) p * mu * mu) / (float64) p;
        if (beta > delta) {
            beta = delta;
        }
        float64 shrinkage = 0.0;
        if (beta != 0.0) {
            shrinkage = beta / delta;
        }
        Tensor<float64>[] out = heap Tensor<float64>[2];
        out[0] = shrinkToward(emp, shrinkage);
        int64[] ss = heap int64[1];
        ss[0] = 1;
        out[1] = Tensor.zeros<float64>(ss);
        out[1].flatSet(0, shrinkage);
        return #out;
    }

    /** `(1-λ)·C + λ·(trace/p)·I` — shrink toward the scaled identity. */
    public static #Tensor<float64> shrinkToward(Tensor<float64> cov,
                                                float64 lam) {
        int64 p = cov.shapeAt(0);
        float64 mu = 0.0;
        int64 t = 0;
        while (t < p) {
            mu = mu + cov.get2(t, t);
            t = t + 1;
        }
        mu = mu / (float64) p;
        int64[] sh = heap int64[2];
        sh[0] = p;
        sh[1] = p;
        Tensor<float64> out = Tensor.zeros<float64>(sh);
        int64 a = 0;
        while (a < p) {
            int64 b = 0;
            while (b < p) {
                float64 v = (1.0 - lam) * cov.get2(a, b);
                if (a == b) {
                    v = v + lam * mu;
                }
                out.flatSet(a * p + b, v);
                b = b + 1;
            }
            a = a + 1;
        }
        return #out;
    }

    /** Row-wise max-shifted log-sum-exp on `t (n, k)` → `(n,)` (§4.3). */
    public static #Tensor<float64> logSumExp(Tensor<float64> t) {
        int64 n = t.shapeAt(0);
        int64 k = t.shapeAt(1);
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<float64> out = Tensor.zeros<float64>(sh);
        int64 i = 0;
        while (i < n) {
            float64 m = t.get2(i, 0);
            int64 j = 1;
            while (j < k) {
                float64 v = t.get2(i, j);
                if (v > m) {
                    m = v;
                }
                j = j + 1;
            }
            float64 s = 0.0;
            j = 0;
            while (j < k) {
                s = s + Math.exp(t.get2(i, j) - m);
                j = j + 1;
            }
            out.flatSet(i, Math.log(s) + m);
            i = i + 1;
        }
        return #out;
    }

    /**
     * The lower Cholesky factor of a covariance, with the singularity made
     * loud (§2.6): a non-positive or non-finite pivot names the remedy
     * instead of leaking NaN into a solve.
     */
    public static #Tensor<float64> choleskyFactor(Tensor<float64> cov) {
        int64 p = cov.shapeAt(0);
        Tensor<float64> l = LinAlg.cholesky<float64>(cov);
        int64 i = 0;
        while (i < p) {
            float64 d = l.get2(i, i);
            float64 aii = cov.get2(i, i);
            if (aii < 0.0) {
                aii = -aii;
            }
            boolean bad = false;
            if (d != d) {
                bad = true;                      // NaN pivot
            }
            if (d <= 0.0000000001 * (1.0 + aii)) {
                bad = true;                      // zero/negative pivot
            }
            if (bad) {
                throw heap MlException("Gaussians: covariance is singular "
                    + "or ill-conditioned (Cholesky pivot ~0 at "
                    + Int64.of(i).toString()
                    + ") — shrink it (shrinkToward / ledoitWolf) or use the "
                    + "svd solver");
            }
            i = i + 1;
        }
        return #l;
    }

    /**
     * Per-row Gaussian log-density `log N(x_i | mean, C)` from the lower
     * Cholesky factor of `C`: `-(p·log 2π + log|C| + maha)/2`, all in log
     * space (§2.4 groundwork).
     */
    public static #Tensor<float64> logDensity(Tensor<float64> x,
                                              Tensor<float64> mean,
                                              Tensor<float64> lower) {
        int64 n = x.shapeAt(0);
        int64 p = x.shapeAt(1);
        float64 logDet = 0.0;
        int64 t = 0;
        while (t < p) {
            logDet = logDet + 2.0 * Math.log(lower.get2(t, t));
            t = t + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<float64> out = Tensor.zeros<float64>(sh);
        float64[] z = heap float64[p];
        int64 i = 0;
        while (i < n) {
            // Forward-substitute L z = (x_i - mean).
            int64 a = 0;
            while (a < p) {
                float64 s = x.get2(i, a) - mean.flatGet(a);
                int64 b = 0;
                while (b < a) {
                    s = s - lower.get2(a, b) * z[b];
                    b = b + 1;
                }
                z[a] = s / lower.get2(a, a);
                a = a + 1;
            }
            float64 maha = 0.0;
            a = 0;
            while (a < p) {
                maha = maha + z[a] * z[a];
                a = a + 1;
            }
            out.flatSet(i, -0.5 * ((float64) p * LOG_2PI + logDet + maha));
            i = i + 1;
        }
        return #out;
    }
}
