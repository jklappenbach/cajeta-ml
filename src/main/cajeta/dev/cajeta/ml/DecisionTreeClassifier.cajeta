package dev.cajeta.ml;

import cajeta.math.Tensor;

/**
 * Exact-split decision tree classification (sklearn `DecisionTreeClassifier`,
 * ml-trees-ensembles U1): recursively choose the split maximizing impurity
 * decrease; leaves predict their majority class, `predictProba` the leaf's
 * class distribution as fractions. Criteria: `"gini"` or `"entropy"`
 * (base-2, spec §3.1). `maxDepth` 0 grows until purity.
 *
 * Deterministic by construction — no seed, sequential growth, and the
 * documented tie rule (ascending scan, strict `>`, first kept; see
 * {@link Trees}). A refit is bit-identical.
 */
public final class DecisionTreeClassifier implements ProbClassifier {

    String criterion;
    int64 maxDepth;
    int64 splitter;      // 0 = best, 1 = random
    uint64 seed;
    int64 minSamplesSplit;
    int64 minSamplesLeaf;
    int64 maxLeafNodes;
    float64 minImpurityDecrease;
    float64 ccpAlpha;
    Tensor<float64> classWeight;   // (K,) per-class weights; null = unweighted
    int64 nClasses;
    int64 nFeatures;
    Trees tree;
    boolean fitted;

    public DecisionTreeClassifier(String criterion) {
        this.init(criterion, 0, "best", (uint64) 0);
        return;
    }

    /** `maxDepth` 0 = unbounded; negative is rejected (§12.6). */
    public DecisionTreeClassifier(String criterion, int64 maxDepth) {
        this.init(criterion, maxDepth, "best", (uint64) 0);
        return;
    }

    /** `splitter` "best" | "random" (the Extra-Trees seam, §3.6); `seed`
     *  drives the random splitter's threshold draws. */
    public DecisionTreeClassifier(String criterion, int64 maxDepth,
                                  String splitter, uint64 seed) {
        this.init(criterion, maxDepth, splitter, seed);
        return;
    }

    void init(String criterion, int64 maxDepth, String splitter, uint64 seed) {
        if (!criterion.equals("gini") && !criterion.equals("entropy")) {
            throw heap MlException("DecisionTreeClassifier: unsupported "
                + "criterion '" + criterion + "' (gini | entropy)");
        }
        if (maxDepth < 0) {
            throw heap MlException("DecisionTreeClassifier: maxDepth must "
                + "be >= 0 (0 = unbounded)");
        }
        if (!splitter.equals("best") && !splitter.equals("random")) {
            throw heap MlException("DecisionTreeClassifier: unsupported "
                + "splitter '" + splitter + "' (best | random)");
        }
        this.criterion = criterion;
        this.maxDepth = maxDepth;
        this.splitter = splitter.equals("best") ? (int64) 0 : (int64) 1;
        this.seed = seed;
        this.minSamplesSplit = 2;
        this.minSamplesLeaf = 1;
        this.maxLeafNodes = 0;
        this.minImpurityDecrease = 0.0;
        this.ccpAlpha = 0.0;
        this.fitted = false;
        return;
    }

    /** Minimum samples a node needs to be split (sklearn `min_samples_split`). */
    public void setMinSamplesSplit(int64 v) {
        if (v < 2) {
            throw heap MlException("DecisionTreeClassifier: minSamplesSplit must be >= 2");
        }
        this.minSamplesSplit = v;
        return;
    }

    /** Minimum samples each child must keep (sklearn `min_samples_leaf`). */
    public void setMinSamplesLeaf(int64 v) {
        if (v < 1) {
            throw heap MlException("DecisionTreeClassifier: minSamplesLeaf must be >= 1");
        }
        this.minSamplesLeaf = v;
        return;
    }

    /** Leaf budget; > 0 switches growth to BEST-FIRST (sklearn `max_leaf_nodes`). */
    public void setMaxLeafNodes(int64 v) {
        if (v != 0 && v < 2) {
            throw heap MlException("DecisionTreeClassifier: maxLeafNodes must be 0 (unbounded) or >= 2");
        }
        this.maxLeafNodes = v;
        return;
    }

    /** Weighted-decrease floor for a split (sklearn `min_impurity_decrease`). */
    public void setMinImpurityDecrease(float64 v) {
        if (v < 0.0) {
            throw heap MlException("DecisionTreeClassifier: minImpurityDecrease must be >= 0");
        }
        this.minImpurityDecrease = v;
        return;
    }

    /** Minimal cost-complexity pruning strength (sklearn `ccp_alpha`). */
    public void setCcpAlpha(float64 v) {
        if (v < 0.0) {
            throw heap MlException("DecisionTreeClassifier: ccpAlpha must be >= 0");
        }
        this.ccpAlpha = v;
        return;
    }

    /** `(K,)` per-class impurity weights (sklearn `class_weight`, §4.8). */
    public void setClassWeight(Tensor<float64> w) {
        if (w.ndim() != 1) {
            throw heap MlException("DecisionTreeClassifier: classWeight must be (K,)");
        }
        Tensor<float64> cw = w.copy();
        this.classWeight #= cw;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException("DecisionTreeClassifier.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        if (y.ndim() != 1 || y.shapeAt(0) != n) {
            throw heap MlException("DecisionTreeClassifier.fit: y must be (n,) matching x rows");
        }
        int64 kmax = 0;
        int64 i = 0;
        while (i < n) {
            float64 v = y.get1(i);
            int64 li = (int64) v;
            if (v != (float64) li || li < 0) {
                throw heap MlException("DecisionTreeClassifier.fit: labels must be integers 0..K-1");
            }
            if (li > kmax) { kmax = li; }
            i = i + 1;
        }
        int64 k = kmax + 1;
        if (k < 2) { k = 2; }
        this.nClasses = k;
        this.nFeatures = x.shapeAt(1);
        // Class weights resolve to an explicit per-class vector; absent, unit
        // weights (behaviorally identical to the unweighted ctor).
        boolean hasCw = this.classWeight != null;
        if (hasCw && this.classWeight.shapeAt(0) < k) {
            throw heap MlException("DecisionTreeClassifier.fit: classWeight "
                + "must cover all K classes");
        }
        float64[] cwA = heap float64[k];
        int64 ci = 0;
        while (ci < k) {
            cwA[ci] = hasCw ? this.classWeight.get1(ci) : 1.0;
            ci = ci + 1;
        }
        Trees t;
        if (this.criterion.equals("gini")) {
            t = heap Trees(heap GiniImpurity(k, #cwA), this.maxDepth, this.splitter, this.seed);
        } else {
            t = heap Trees(heap EntropyImpurity(k, #cwA), this.maxDepth, this.splitter, this.seed);
        }
        t.minSamplesSplit = this.minSamplesSplit;
        t.minSamplesLeaf = this.minSamplesLeaf;
        t.maxLeafNodes = this.maxLeafNodes;
        t.minImpurityDecrease = this.minImpurityDecrease;
        t.ccpAlpha = this.ccpAlpha;
        t.fit(x, y, n, this.nFeatures);
        this.tree #= t;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    void requireFitted(String who) {
        if (!this.fitted) {
            throw heap MlException(who + ": fit first");
        }
        return;
    }

    void requireShape(Tensor<float64> x, String who) {
        if (x.ndim() != 2 || x.shapeAt(1) != this.nFeatures) {
            throw heap MlException(who + ": x must be (n, p) with p matching the fit");
        }
        return;
    }

    /** `(n, K)` leaf class fractions. */
    public #Tensor<float64> predictProba(Tensor<float64> x) {
        this.requireFitted("DecisionTreeClassifier.predictProba");
        this.requireShape(x, "DecisionTreeClassifier.predictProba");
        int64 n = x.shapeAt(0);
        int64 kc = this.nClasses;
        float64[] out = heap float64[n * kc];
        int64 r = 0;
        while (r < n) {
            int64 leaf = this.tree.leafOf(x, r, this.nFeatures);
            int64 k = 0;
            while (k < kc) {
                out[r * kc + k] = this.tree.value[leaf * kc + k];
                k = k + 1;
            }
            r = r + 1;
        }
        int64[] sh = heap int64[2]; sh[0] = n; sh[1] = kc;
        return Tensor.of<float64>(out, sh);
    }

    /** `(n,)` labels — the leaf's majority class, first max on ties. */
    public #Tensor<float64> predict(Tensor<float64> x) {
        this.requireFitted("DecisionTreeClassifier.predict");
        this.requireShape(x, "DecisionTreeClassifier.predict");
        int64 n = x.shapeAt(0);
        int64 kc = this.nClasses;
        float64[] out = heap float64[n];
        int64 r = 0;
        while (r < n) {
            int64 leaf = this.tree.leafOf(x, r, this.nFeatures);
            int64 best = 0;
            int64 k = 1;
            while (k < kc) {
                if (this.tree.value[leaf * kc + k] > this.tree.value[leaf * kc + best]) {
                    best = k;
                }
                k = k + 1;
            }
            out[r] = (float64) best;
            r = r + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = n;
        return Tensor.of<float64>(out, sh);
    }

    /** Accuracy — the classifier `score` convention. */
    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        Tensor<float64> p = this.predict(x);
        int64 n = p.shapeAt(0);
        int64 hits = 0;
        int64 i = 0;
        while (i < n) {
            if (p.get1(i) == y.get1(i)) { hits = hits + 1; }
            i = i + 1;
        }
        return (float64) hits / (float64) n;
    }

    /** The realized tree depth (root = 0 for a stump-free tree of one leaf). */
    public int64 depth() {
        this.requireFitted("DecisionTreeClassifier.depth");
        return this.tree.realizedDepth;
    }

    /** The realized leaf count. */
    public int64 leafCount() {
        this.requireFitted("DecisionTreeClassifier.leafCount");
        return this.tree.leaves;
    }


    /**
     * Normalized impurity-based feature importances (`(nf,)`, summing to 1;
     * sklearn `feature_importances_`). CAVEAT (spec §4.1.5): impurity
     * importance is biased TOWARD high-cardinality/continuous features —
     * they offer more candidate splits, so comparing a continuous feature's
     * importance against a binary one overstates the continuous one. Prefer
     * permutation importance for cross-cardinality comparisons.
     */
    public #Tensor<float64> featureImportances() {
        this.requireFitted("DecisionTreeClassifier.featureImportances");
        float64[] imp = this.tree.importances();
        int64[] sh = heap int64[1]; sh[0] = this.nFeatures;
        return Tensor.of<float64>(imp, sh);
    }

    /** Readable root-to-leaf rule dump (§2.8). */
    public #String exportText() {
        this.requireFitted("DecisionTreeClassifier.exportText");
        return this.tree.exportText();
    }

    /**
     * The minimal cost-complexity pruning path of the fully grown tree on
     * `(x, y)` (sklearn `cost_complexity_pruning_path`, §4.7): distinct
     * effective alphas ascending and the total leaf impurity after each.
     * Fits a throwaway tree with this estimator's growth settings (ccpAlpha
     * itself excluded); the estimator's own fitted state is untouched.
     */
    public #PruningPath costComplexityPruningPath(Tensor<float64> x, Tensor<float64> y) {
        DecisionTreeClassifier probe = heap DecisionTreeClassifier(
            this.criterion, this.maxDepth, this.splitter == 0 ? "best" : "random", this.seed);
        probe.minSamplesSplit = this.minSamplesSplit;
        probe.minSamplesLeaf = this.minSamplesLeaf;
        probe.maxLeafNodes = this.maxLeafNodes;
        probe.minImpurityDecrease = this.minImpurityDecrease;
        if (this.classWeight != null) { probe.setClassWeight(this.classWeight); }
        probe.fit(x, y);
        int64 cap = probe.tree.nodeCount + 1;
        float64[] alphas = heap float64[cap];
        float64[] imps = heap float64[cap];
        int64 kk = probe.tree.ccpPath(alphas, imps);
        float64[] aOut = heap float64[kk];
        float64[] iOut = heap float64[kk];
        int64 j = 0;
        while (j < kk) { aOut[j] = alphas[j]; iOut[j] = imps[j]; j = j + 1; }
        int64[] sh = heap int64[1]; sh[0] = kk;
        int64[] sh2 = heap int64[1]; sh2[0] = kk;
        return heap PruningPath(Tensor.of<float64>(aOut, sh), Tensor.of<float64>(iOut, sh2));
    }
}
