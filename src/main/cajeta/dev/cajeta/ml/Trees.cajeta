package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.random.Generator;

/**
 * The shared tree grower behind {@link DecisionTreeClassifier} and
 * {@link DecisionTreeRegressor} (ml-trees-ensembles U1/U2). Impurity is
 * pluggable through the {@link Impurity} seam — nothing here hardcodes a
 * criterion.
 *
 * The `best` splitter reproduces sklearn 1.9.0's `node_split_best` over raw
 * values (`_splitter.pyx`):
 *
 * - Candidate positions scan each feature's node samples in ascending sorted
 *   order; a position is a candidate only when `v[p] > v[p-1] + 1e-7`
 *   (FEATURE_THRESHOLD), and a feature whose node range is within 1e-7 is
 *   constant and skipped.
 * - The best split wins by strict `>` on impurity improvement. WITHIN a
 *   feature that keeps the FIRST (lowest-threshold) of equal candidates —
 *   sklearn's own deterministic rule, pinned by the tie fixture. ACROSS
 *   features we visit in ascending index; sklearn visits in RNG order
 *   (Fisher-Yates from random_state), so cross-feature ties are the one
 *   place the two can differ — parity fixtures are constructed tie-free
 *   across features.
 * - Threshold is `v[p-1]/2 + v[p]/2` (sum of halves), routing `<=` left.
 * - A pure node (or one at maxDepth, or with < 2 samples) becomes a leaf.
 *
 * The `random` splitter (the Extra-Trees seam, spec §3.6) draws ONE
 * threshold per non-constant feature, uniform in (min, max) from the seeded
 * `cajeta.math.random.Generator` — features in ascending order, one draw
 * each, so a same-seed refit is bit-identical. The best drawn candidate
 * still wins by strict `>`.
 *
 * Growth is depth-first, left child first, nodes numbered in visit order —
 * sklearn's DepthFirstTreeBuilder numbering. Everything is sequential, so a
 * refit is bit-identical by construction.
 */
final class Trees {

    // --- flat SoA tree (capacity 2n, the binary-tree worst case) ---------
    int64[] feature;      // split feature; -1 on leaves
    float64[] threshold;  // split threshold (route <= left)
    int64[] left;         // -1 on leaves
    int64[] right;
    float64[] value;      // [cap*width] leaf payload (fractions / mean / median)
    int64[] size;         // node sample count
    int64 nodeCount;
    int64 kOut;
    Impurity crit;
    int64 splitter;       // 0 = best, 1 = random
    Generator rng;
    int64 maxDepth;       // 0 = unbounded
    int64 realizedDepth;
    int64 leaves;

    // fit-time state
    float64[] xs;         // row-major [n*nf] copy
    float64[] ys;
    int64[] smp;          // sample index permutation, partitioned in place
    int64 nf;

    Trees(#Impurity crit, int64 maxDepth, int64 splitter, uint64 seed) {
        this.crit #= crit;
        this.maxDepth = maxDepth;
        this.splitter = splitter;
        this.kOut = this.crit.width();
        if (splitter == 1) {
            Generator g = heap Generator(seed);
            this.rng #= g;
        }
        this.nodeCount = 0;
        this.realizedDepth = 0;
        this.leaves = 0;
        return;
    }

    void fit(Tensor<float64> x, Tensor<float64> y, int64 n, int64 nf) {
        int64 cap = 2 * n;
        this.feature #= heap int64[cap];
        this.threshold #= heap float64[cap];
        this.left #= heap int64[cap];
        this.right #= heap int64[cap];
        this.value #= heap float64[cap * this.kOut];
        this.size #= heap int64[cap];
        float64[] xsA = heap float64[n * nf];
        float64[] ysA = heap float64[n];
        int64[] smpA = heap int64[n];
        int64 i = 0;
        while (i < n * nf) { xsA[i] = x.flatGet(i); i = i + 1; }
        i = 0;
        while (i < n) { ysA[i] = y.get1(i); smpA[i] = i; i = i + 1; }
        this.xs #= xsA;
        this.ys #= ysA;
        this.smp #= smpA;
        this.nf = nf;
        int64 root = this.build(0, n, 0);
        return;
    }

    /** In-place heapsort of parallel (v, idx) by v ascending. */
    static void sortPairs(float64[] v, int64[] idx, int64 m) {
        int64 start = m / 2;
        while (start > 0) {
            start = start - 1;
            Trees.siftDown(v, idx, start, m);
        }
        int64 end = m;
        while (end > 1) {
            end = end - 1;
            float64 tv = v[0]; v[0] = v[end]; v[end] = tv;
            int64 ti = idx[0]; idx[0] = idx[end]; idx[end] = ti;
            Trees.siftDown(v, idx, 0, end);
        }
        return;
    }

    static void siftDown(float64[] v, int64[] idx, int64 root, int64 end) {
        int64 r = root;
        while (r * 2 + 1 < end) {
            int64 child = r * 2 + 1;
            if (child + 1 < end && v[child + 1] > v[child]) { child = child + 1; }
            if (v[r] >= v[child]) { return; }
            float64 tv = v[r]; v[r] = v[child]; v[child] = tv;
            int64 ti = idx[r]; idx[r] = idx[child]; idx[child] = ti;
            r = child;
        }
        return;
    }

    /** In-place heapsort of a bare value array (median computation). */
    static void sortVals(float64[] v, int64 m) {
        int64[] dummy = heap int64[m];
        Trees.sortPairs(v, dummy, m);
        return;
    }

    /** Grow the subtree over smp[start,end) at `depth`; returns the node id. */
    int64 build(int64 start, int64 end, int64 depth) {
        int64 nid = this.nodeCount;
        this.nodeCount = this.nodeCount + 1;
        int64 m = end - start;
        this.size[nid] = m;
        if (depth > this.realizedDepth) { this.realizedDepth = depth; }

        // Node targets in smp order (a stable, deterministic order).
        float64[] nodeY = heap float64[m];
        int64 i = 0;
        boolean pure = true;
        while (i < m) {
            nodeY[i] = this.ys[this.smp[start + i]];
            if (nodeY[i] != nodeY[0]) { pure = false; }
            i = i + 1;
        }

        boolean depthStop = this.maxDepth > 0 && depth >= this.maxDepth;
        int64 bestF = -1;
        float64 bestProxy = 0.0;
        float64 bestThr = 0.0;
        if (!pure && !depthStop && m >= 2) {
            if (this.splitter == 0) {
                float64[] fv = heap float64[m];
                int64[] fi = heap int64[m];
                float64[] fy = heap float64[m];
                int64 f = 0;
                while (f < this.nf) {
                    int64 j = 0;
                    while (j < m) {
                        fi[j] = this.smp[start + j];
                        fv[j] = this.xs[fi[j] * this.nf + f];
                        j = j + 1;
                    }
                    Trees.sortPairs(fv, fi, m);
                    if (fv[m - 1] > fv[0] + 0.0000001) {           // non-constant
                        j = 0;
                        while (j < m) { fy[j] = this.ys[fi[j]]; j = j + 1; }
                        int64 p = 1;
                        while (p < m) {
                            if (fv[p] > fv[p - 1] + 0.0000001      // candidate
                                && this.crit.validSplit(fy, 0, p, m)) {
                                float64 proxy = -(this.crit.weighted(fy, 0, p)
                                                + this.crit.weighted(fy, p, m));
                                if (bestF < 0 || proxy > bestProxy) {
                                    bestF = f;
                                    bestProxy = proxy;
                                    bestThr = fv[p - 1] / 2.0 + fv[p] / 2.0;
                                }
                            }
                            p = p + 1;
                        }
                    }
                    f = f + 1;
                }
            } else {
                // random: one uniform draw per non-constant feature.
                float64[] py = heap float64[m];
                int64 f = 0;
                while (f < this.nf) {
                    float64 mn = this.xs[this.smp[start] * this.nf + f];
                    float64 mx = mn;
                    i = start + 1;
                    while (i < end) {
                        float64 v = this.xs[this.smp[i] * this.nf + f];
                        if (v < mn) { mn = v; }
                        if (v > mx) { mx = v; }
                        i = i + 1;
                    }
                    if (mx > mn + 0.0000001) {
                        Tensor<float32> u = this.rng.uniform(1);
                        float64 thr = mn + (float64) u.flatGet(0) * (mx - mn);
                        // Partition targets: [left..., right...), mid = nl.
                        int64 nl = 0;
                        i = start;
                        while (i < end) {
                            if (this.xs[this.smp[i] * this.nf + f] <= thr) {
                                py[nl] = this.ys[this.smp[i]];
                                nl = nl + 1;
                            }
                            i = i + 1;
                        }
                        int64 nr = nl;
                        i = start;
                        while (i < end) {
                            if (!(this.xs[this.smp[i] * this.nf + f] <= thr)) {
                                py[nr] = this.ys[this.smp[i]];
                                nr = nr + 1;
                            }
                            i = i + 1;
                        }
                        if (nl > 0 && nl < m && this.crit.validSplit(py, 0, nl, m)) {
                            float64 proxy = -(this.crit.weighted(py, 0, nl)
                                            + this.crit.weighted(py, nl, m));
                            if (bestF < 0 || proxy > bestProxy) {
                                bestF = f;
                                bestProxy = proxy;
                                bestThr = thr;
                            }
                        }
                    }
                    f = f + 1;
                }
            }
        }

        if (bestF < 0) {
            this.feature[nid] = -1;
            this.left[nid] = -1;
            this.right[nid] = -1;
            this.crit.leafInto(nodeY, 0, m, this.value, nid * this.kOut);
            this.leaves = this.leaves + 1;
            return nid;
        }

        // Stable two-pass partition of smp[start,end) by x[bestF] <= thr.
        int64[] tmp = heap int64[m];
        int64 nl2 = 0;
        i = start;
        while (i < end) {
            if (this.xs[this.smp[i] * this.nf + bestF] <= bestThr) {
                tmp[nl2] = this.smp[i];
                nl2 = nl2 + 1;
            }
            i = i + 1;
        }
        int64 nr2 = nl2;
        i = start;
        while (i < end) {
            if (!(this.xs[this.smp[i] * this.nf + bestF] <= bestThr)) {
                tmp[nr2] = this.smp[i];
                nr2 = nr2 + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < m) { this.smp[start + i] = tmp[i]; i = i + 1; }

        this.feature[nid] = bestF;
        this.threshold[nid] = bestThr;
        int64 li = this.build(start, start + nl2, depth + 1);
        int64 ri = this.build(start + nl2, end, depth + 1);
        this.left[nid] = li;
        this.right[nid] = ri;
        return nid;
    }

    /** Route one row to its leaf id. */
    int64 leafOf(Tensor<float64> x, int64 row, int64 nf) {
        int64 nid = 0;
        while (this.feature[nid] >= 0) {
            float64 v = x.flatGet(row * nf + this.feature[nid]);
            if (v <= this.threshold[nid]) { nid = this.left[nid]; }
            else { nid = this.right[nid]; }
        }
        return nid;
    }

    /** sklearn-style indented rule dump (leaf: "class: k" / "value: v"). */
    #String exportText() {
        String s = "";
        s = this.dumpNode(0, "", s);
        return #s;
    }

    #String dumpNode(int64 nid, String indent, String acc) {
        if (this.feature[nid] < 0) {
            String lab;
            if (this.kOut > 1) {
                int64 best = 0;
                int64 k = 1;
                while (k < this.kOut) {
                    if (this.value[nid * this.kOut + k] > this.value[nid * this.kOut + best]) {
                        best = k;
                    }
                    k = k + 1;
                }
                lab = "class: " + Int64.of(best).toString();
            } else {
                lab = "value: " + Float64.of(this.value[nid]).toString();
            }
            String r = acc + indent + "|--- " + lab + "\n";
            return #r;
        }
        String cond = "f" + Int64.of(this.feature[nid]).toString();
        String thr = Float64.of(this.threshold[nid]).toString();
        String a1 = acc + indent + "|--- " + cond + " <= " + thr + "\n";
        String a2 = this.dumpNode(this.left[nid], indent + "|   ", a1);
        String a3 = a2 + indent + "|--- " + cond + " >  " + thr + "\n";
        String a4 = this.dumpNode(this.right[nid], indent + "|   ", a3);
        return #a4;
    }
}
