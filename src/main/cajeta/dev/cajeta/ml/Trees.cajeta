package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.random.Generator;

/**
 * The shared tree grower behind {@link DecisionTreeClassifier} and
 * {@link DecisionTreeRegressor} (ml-trees-ensembles U1–U3). Impurity is
 * pluggable through the {@link Impurity} seam — nothing here hardcodes a
 * criterion, and class weights live inside the criterion (spec §4.8).
 *
 * The `best` splitter reproduces sklearn 1.9.0's `node_split_best` over raw
 * values (`_splitter.pyx`): ascending candidate scan per feature with the
 * 1e-7 FEATURE_THRESHOLD, strict `>` keeping the first (lowest threshold) of
 * within-feature ties, sum-of-halves thresholds, `<=` routing left. Across
 * features we visit in ascending index; sklearn visits in RNG order, so
 * cross-feature ties are the one divergence — parity fixtures are tie-free
 * across features. The `random` splitter (spec §3.6) draws one threshold per
 * non-constant feature from the seeded generator.
 *
 * Regularization (U3, sklearn semantics):
 * - `minSamplesSplit` / `minSamplesLeaf` gate candidates during growth.
 * - `minImpurityDecrease` rejects the CHOSEN split when its weighted
 *   decrease `(w(t)·imp(t) − w(l)·imp(l) − w(r)·imp(r)) / N` falls below.
 * - `maxLeafNodes > 0` switches to BEST-FIRST growth: the frontier node
 *   with the largest weighted decrease splits next, until the leaf budget.
 * - `ccpAlpha` runs minimal cost-complexity pruning after growth: collapse
 *   the weakest link (min `g(t) = (r(t) − R(subtree)) / (leaves − 1)`,
 *   ties → lowest node id) while `g ≤ alpha`. {@link #ccpPath} walks the
 *   same collapses to the root, recording each distinct effective alpha and
 *   the total leaf impurity after it — sklearn's
 *   `cost_complexity_pruning_path`.
 *
 * Every node (not only leaves) stores its payload, impurity, and weighted
 * count, so a collapsed subtree's new leaf predicts the majority of all the
 * samples it held (§4.6). Growth is sequential and deterministic; a
 * same-seed refit is bit-identical.
 */
final class Trees {

    // --- flat SoA tree (capacity 2n, the binary-tree worst case) ---------
    int64[] feature;      // split feature; -1 on leaves
    float64[] threshold;  // split threshold (route <= left)
    int64[] left;         // -1 on leaves
    int64[] right;
    float64[] value;      // [cap*width] payload for EVERY node
    int64[] size;         // node sample count
    float64[] nodeImp;    // node impurity
    float64[] nodeW;      // node weighted count
    int64 nodeCount;
    int64 kOut;
    Impurity crit;
    int64 splitter;       // 0 = best, 1 = random
    Generator rng;
    int64 maxDepth;       // 0 = unbounded
    int64 minSamplesSplit;
    int64 minSamplesLeaf;
    int64 maxLeafNodes;   // 0 = unbounded; > 0 switches to best-first
    int64 maxFeaturesNode; // features CONSIDERED PER NODE (0 = all) — the
                           // random-forest lever (spec §7.1): drawn fresh at
                           // every node from the tree's generator
    float64 minImpurityDecrease;
    float64 ccpAlpha;
    int64 realizedDepth;
    int64 leaves;
    float64 nTotalW;      // root weighted count (the decrease normalizer)

    // findSplit out-params (set per call, consumed immediately).
    int64 fsF;
    float64 fsThr;
    float64 fsChildrenW;  // w(l)·imp(l) + w(r)·imp(r) at the best split

    // fit-time state
    float64[] xs;         // row-major [n*nf] copy
    float64[] ys;
    float64[] sws;        // per-sample weights (1s unless fitWeighted)
    int64[] smp;          // sample index permutation, partitioned in place
    int64 nf;

    Trees(#Impurity crit, int64 maxDepth, int64 splitter, uint64 seed) {
        this.crit #= crit;
        this.maxDepth = maxDepth;
        this.splitter = splitter;
        this.kOut = this.crit.width();
        Generator g = heap Generator(seed);
        this.rng #= g;
        this.minSamplesSplit = 2;
        this.minSamplesLeaf = 1;
        this.maxLeafNodes = 0;
        this.maxFeaturesNode = 0;
        this.minImpurityDecrease = 0.0;
        this.ccpAlpha = 0.0;
        this.nodeCount = 0;
        this.realizedDepth = 0;
        this.leaves = 0;
        return;
    }

    void fit(Tensor<float64> x, Tensor<float64> y, int64 n, int64 nf) {
        float64[] ones = heap float64[n];
        int64 oi = 0;
        while (oi < n) { ones[oi] = 1.0; oi = oi + 1; }
        this.fitW(x, y, #ones, n, nf);
        return;
    }

    void fitW(Tensor<float64> x, Tensor<float64> y, #float64[] w, int64 n, int64 nf) {
        this.sws #= w;
        int64 cap = 2 * n;
        this.feature #= heap int64[cap];
        this.threshold #= heap float64[cap];
        this.left #= heap int64[cap];
        this.right #= heap int64[cap];
        this.value #= heap float64[cap * this.kOut];
        this.size #= heap int64[cap];
        this.nodeImp #= heap float64[cap];
        this.nodeW #= heap float64[cap];
        float64[] xsA = heap float64[n * nf];
        float64[] ysA = heap float64[n];
        int64[] smpA = heap int64[n];
        int64 i = 0;
        while (i < n * nf) { xsA[i] = x.flatGet(i); i = i + 1; }
        i = 0;
        while (i < n) { ysA[i] = y.get1(i); smpA[i] = i; i = i + 1; }
        this.xs #= xsA;
        this.ys #= ysA;
        this.smp #= smpA;
        this.nf = nf;
        float64[] allY = heap float64[n];
        i = 0;
        while (i < n) { allY[i] = ysA[i]; i = i + 1; }
        this.nTotalW = this.crit.weightedN(allY, this.sws, 0, n);
        if (this.maxLeafNodes > 0) {
            this.buildBestFirst(n);
        } else {
            int64 root = this.build(0, n, 0);
        }
        if (this.ccpAlpha > 0.0) {
            float64[] da = heap float64[1];
            float64[] di = heap float64[1];
            int64 unused = this.pruneWhile(this.ccpAlpha, da, di, -1);
            this.recount();
        }
        return;
    }

    /** In-place heapsort of parallel (v, idx) by v ascending. */
    static void sortPairs(float64[] v, int64[] idx, int64 m) {
        int64 start = m / 2;
        while (start > 0) {
            start = start - 1;
            Trees.siftDown(v, idx, start, m);
        }
        int64 end = m;
        while (end > 1) {
            end = end - 1;
            float64 tv = v[0]; v[0] = v[end]; v[end] = tv;
            int64 ti = idx[0]; idx[0] = idx[end]; idx[end] = ti;
            Trees.siftDown(v, idx, 0, end);
        }
        return;
    }

    static void siftDown(float64[] v, int64[] idx, int64 root, int64 end) {
        int64 r = root;
        while (r * 2 + 1 < end) {
            int64 child = r * 2 + 1;
            if (child + 1 < end && v[child + 1] > v[child]) { child = child + 1; }
            if (v[r] >= v[child]) { return; }
            float64 tv = v[r]; v[r] = v[child]; v[child] = tv;
            int64 ti = idx[r]; idx[r] = idx[child]; idx[child] = ti;
            r = child;
        }
        return;
    }

    /** In-place heapsort of a bare value array (median computation). */
    static void sortVals(float64[] v, int64 m) {
        int64[] dummy = heap int64[m];
        Trees.sortPairs(v, dummy, m);
        return;
    }

    /** Node targets over smp[start,end), in smp order; fills `nw` with the
     *  parallel sample weights. */
    #float64[] nodeTargets(int64 start, int64 end, float64[] nw) {
        int64 m = end - start;
        float64[] ny = heap float64[m];
        int64 i = 0;
        while (i < m) {
            ny[i] = this.ys[this.smp[start + i]];
            nw[i] = this.sws[this.smp[start + i]];
            i = i + 1;
        }
        return #ny;
    }

    /**
     * Find the best admissible split of smp[start,end) into fsF/fsThr/
     * fsChildrenW. Returns false when no candidate passes the gates
     * (constant features, minSamplesLeaf, poisson validity).
     */
    boolean findSplit(int64 start, int64 end) {
        int64 m = end - start;
        this.fsF = -1;
        float64 bestProxy = 0.0;
        // Per-node feature visit order: ascending when unrestricted, or a
        // fresh seeded PERMUTATION when maxFeaturesNode is set (spec §7.1 —
        // per NODE, not per tree). The budget counts only NON-CONSTANT
        // features, sklearn's rule: a node whose drawn feature is constant
        // keeps drawing rather than becoming a spurious leaf.
        int64 nFeat = this.nf;
        int64 budget = this.nf;
        int64[] featOrder = heap int64[this.nf];
        if (this.maxFeaturesNode > 0 && this.maxFeaturesNode < this.nf) {
            budget = this.maxFeaturesNode;
            Tensor<int64> perm = this.rng.choice(this.nf, this.nf, false);
            int64 q = 0;
            while (q < this.nf) { featOrder[q] = perm.flatGet(q); q = q + 1; }
        } else {
            int64 q = 0;
            while (q < this.nf) { featOrder[q] = q; q = q + 1; }
        }
        if (this.splitter == 0) {
            float64[] fv = heap float64[m];
            int64[] fi = heap int64[m];
            float64[] fy = heap float64[m];
            float64[] fw = heap float64[m];
            int64 fo = 0;
            while (fo < nFeat && budget > 0) {
                int64 f = featOrder[fo];
                int64 j = 0;
                while (j < m) {
                    fi[j] = this.smp[start + j];
                    fv[j] = this.xs[fi[j] * this.nf + f];
                    j = j + 1;
                }
                Trees.sortPairs(fv, fi, m);
                if (fv[m - 1] > fv[0] + 0.0000001) {           // non-constant
                    budget = budget - 1;
                    j = 0;
                    while (j < m) {
                        fy[j] = this.ys[fi[j]];
                        fw[j] = this.sws[fi[j]];
                        j = j + 1;
                    }
                    int64 p = 1;
                    while (p < m) {
                        if (fv[p] > fv[p - 1] + 0.0000001      // candidate
                            && p >= this.minSamplesLeaf
                            && m - p >= this.minSamplesLeaf
                            && this.crit.validSplit(fy, fw, 0, p, m)) {
                            float64 cw = this.crit.weighted(fy, fw, 0, p)
                                       + this.crit.weighted(fy, fw, p, m);
                            float64 proxy = -cw;
                            if (this.fsF < 0 || proxy > bestProxy) {
                                this.fsF = f;
                                bestProxy = proxy;
                                this.fsThr = fv[p - 1] / 2.0 + fv[p] / 2.0;
                                this.fsChildrenW = cw;
                            }
                        }
                        p = p + 1;
                    }
                }
                fo = fo + 1;
            }
        } else {
            float64[] py = heap float64[m];
            float64[] pw = heap float64[m];
            int64 fo2 = 0;
            while (fo2 < nFeat && budget > 0) {
                int64 f = featOrder[fo2];
                float64 mn = this.xs[this.smp[start] * this.nf + f];
                float64 mx = mn;
                int64 i = start + 1;
                while (i < end) {
                    float64 v = this.xs[this.smp[i] * this.nf + f];
                    if (v < mn) { mn = v; }
                    if (v > mx) { mx = v; }
                    i = i + 1;
                }
                if (mx > mn + 0.0000001) {
                    budget = budget - 1;
                    Tensor<float32> u = this.rng.uniform(1);
                    float64 thr = mn + (float64) u.flatGet(0) * (mx - mn);
                    int64 nl = 0;
                    i = start;
                    while (i < end) {
                        if (this.xs[this.smp[i] * this.nf + f] <= thr) {
                            py[nl] = this.ys[this.smp[i]];
                            pw[nl] = this.sws[this.smp[i]];
                            nl = nl + 1;
                        }
                        i = i + 1;
                    }
                    int64 nr = nl;
                    i = start;
                    while (i < end) {
                        if (!(this.xs[this.smp[i] * this.nf + f] <= thr)) {
                            py[nr] = this.ys[this.smp[i]];
                            pw[nr] = this.sws[this.smp[i]];
                            nr = nr + 1;
                        }
                        i = i + 1;
                    }
                    if (nl >= this.minSamplesLeaf && m - nl >= this.minSamplesLeaf
                        && nl > 0 && nl < m
                        && this.crit.validSplit(py, pw, 0, nl, m)) {
                        float64 cw = this.crit.weighted(py, pw, 0, nl)
                                   + this.crit.weighted(py, pw, nl, m);
                        float64 proxy = -cw;
                        if (this.fsF < 0 || proxy > bestProxy) {
                            this.fsF = f;
                            bestProxy = proxy;
                            this.fsThr = thr;
                            this.fsChildrenW = cw;
                        }
                    }
                }
                fo2 = fo2 + 1;
            }
        }
        return this.fsF >= 0;
    }

    /** Allocate node `nid` stats/payload over smp[start,end). */
    int64 openNode(int64 start, int64 end, int64 depth) {
        int64 nid = this.nodeCount;
        this.nodeCount = this.nodeCount + 1;
        int64 m = end - start;
        this.size[nid] = m;
        if (depth > this.realizedDepth) { this.realizedDepth = depth; }
        float64[] nw = heap float64[m];
        float64[] ny = this.nodeTargets(start, end, nw);
        float64 w = this.crit.weightedN(ny, nw, 0, m);
        this.nodeW[nid] = w;
        this.nodeImp[nid] = this.crit.weighted(ny, nw, 0, m) / w;
        this.crit.leafInto(ny, nw, 0, m, this.value, nid * this.kOut);
        this.feature[nid] = -1;
        this.left[nid] = -1;
        this.right[nid] = -1;
        return nid;
    }

    /** Is smp[start,end) pure (all targets equal)? */
    boolean isPure(int64 start, int64 end) {
        float64 first = this.ys[this.smp[start]];
        int64 i = start + 1;
        while (i < end) {
            if (this.ys[this.smp[i]] != first) { return false; }
            i = i + 1;
        }
        return true;
    }

    /** May this node try to split at all (pure/size/depth gates)? */
    boolean splittable(int64 start, int64 end, int64 depth) {
        int64 m = end - start;
        if (m < 2 || m < this.minSamplesSplit) { return false; }
        if (this.maxDepth > 0 && depth >= this.maxDepth) { return false; }
        return !this.isPure(start, end);
    }

    /** The chosen split's weighted impurity decrease (sklearn's formula). */
    float64 decreaseOf(int64 nid) {
        return (this.nodeW[nid] * this.nodeImp[nid] - this.fsChildrenW) / this.nTotalW;
    }

    /** Partition smp[start,end) by x[f] <= thr (stable); returns nl. */
    int64 partition(int64 start, int64 end, int64 f, float64 thr) {
        int64 m = end - start;
        int64[] tmp = heap int64[m];
        int64 nl = 0;
        int64 i = start;
        while (i < end) {
            if (this.xs[this.smp[i] * this.nf + f] <= thr) {
                tmp[nl] = this.smp[i];
                nl = nl + 1;
            }
            i = i + 1;
        }
        int64 nr = nl;
        i = start;
        while (i < end) {
            if (!(this.xs[this.smp[i] * this.nf + f] <= thr)) {
                tmp[nr] = this.smp[i];
                nr = nr + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < m) { this.smp[start + i] = tmp[i]; i = i + 1; }
        return nl;
    }

    /** Depth-first growth over smp[start,end); returns the node id. */
    int64 build(int64 start, int64 end, int64 depth) {
        int64 nid = this.openNode(start, end, depth);
        boolean split = false;
        if (this.splittable(start, end, depth) && this.findSplit(start, end)) {
            if (this.decreaseOf(nid) >= this.minImpurityDecrease) {
                split = true;
            }
        }
        if (!split) {
            this.leaves = this.leaves + 1;
            return nid;
        }
        int64 f = this.fsF;
        float64 thr = this.fsThr;
        int64 nl = this.partition(start, end, f, thr);
        this.feature[nid] = f;
        this.threshold[nid] = thr;
        int64 li = this.build(start, start + nl, depth + 1);
        int64 ri = this.build(start + nl, end, depth + 1);
        this.left[nid] = li;
        this.right[nid] = ri;
        return nid;
    }

    /**
     * Best-first growth (maxLeafNodes): the frontier node with the largest
     * weighted impurity decrease splits next (ties → earliest opened),
     * until the leaf budget is met or nothing is splittable — sklearn's
     * BestFirstTreeBuilder.
     */
    void buildBestFirst(int64 n) {
        int64 budget = this.maxLeafNodes;
        // Frontier arrays, indexed by frontier slot.
        int64 cap = 2 * n;
        int64[] fNid = heap int64[cap];
        int64[] fStart = heap int64[cap];
        int64[] fEnd = heap int64[cap];
        int64[] fDepth = heap int64[cap];
        boolean[] fCan = heap boolean[cap];      // has an admissible split
        int64[] fF = heap int64[cap];
        float64[] fThr = heap float64[cap];
        float64[] fDec = heap float64[cap];
        int64 fCount = 0;

        int64 root = this.openNode(0, n, 0);
        fNid[0] = root; fStart[0] = 0; fEnd[0] = n; fDepth[0] = 0;
        fCan[0] = false;
        if (this.splittable(0, n, 0) && this.findSplit(0, n)) {
            float64 d = this.decreaseOf(root);
            if (d >= this.minImpurityDecrease) {
                fCan[0] = true; fF[0] = this.fsF; fThr[0] = this.fsThr; fDec[0] = d;
            }
        }
        fCount = 1;

        while (fCount < budget) {
            int64 pick = -1;
            int64 s = 0;
            while (s < fCount) {
                if (fCan[s] && (pick < 0 || fDec[s] > fDec[pick])) { pick = s; }
                s = s + 1;
            }
            if (pick < 0) { break; }

            int64 nid = fNid[pick];
            int64 st = fStart[pick];
            int64 en = fEnd[pick];
            int64 dep = fDepth[pick];
            int64 f = fF[pick];
            float64 thr = fThr[pick];
            int64 nl = this.partition(st, en, f, thr);
            this.feature[nid] = f;
            this.threshold[nid] = thr;
            int64 li = this.openNode(st, st + nl, dep + 1);
            int64 ri = this.openNode(st + nl, en, dep + 1);
            this.left[nid] = li;
            this.right[nid] = ri;

            // The picked slot becomes the left child; append the right.
            fNid[pick] = li; fStart[pick] = st; fEnd[pick] = st + nl; fDepth[pick] = dep + 1;
            fCan[pick] = false;
            if (this.splittable(st, st + nl, dep + 1) && this.findSplit(st, st + nl)) {
                float64 dl = this.decreaseOf(li);
                if (dl >= this.minImpurityDecrease) {
                    fCan[pick] = true; fF[pick] = this.fsF; fThr[pick] = this.fsThr; fDec[pick] = dl;
                }
            }
            fNid[fCount] = ri; fStart[fCount] = st + nl; fEnd[fCount] = en; fDepth[fCount] = dep + 1;
            fCan[fCount] = false;
            if (this.splittable(st + nl, en, dep + 1) && this.findSplit(st + nl, en)) {
                float64 dr = this.decreaseOf(ri);
                if (dr >= this.minImpurityDecrease) {
                    fCan[fCount] = true; fF[fCount] = this.fsF; fThr[fCount] = this.fsThr; fDec[fCount] = dr;
                }
            }
            fCount = fCount + 1;
        }
        this.leaves = fCount;
        return;
    }

    // ---- minimal cost-complexity pruning (U3) ---------------------------

    // Subtree stats for g(t): out via scratch fields.
    float64 ccR;      // Σ leaf r over the subtree
    int64 ccLeaves;

    void subtreeStats(int64 nid) {
        if (this.feature[nid] < 0) {
            this.ccR = this.nodeW[nid] * this.nodeImp[nid] / this.nTotalW;
            this.ccLeaves = 1;
            return;
        }
        this.subtreeStats(this.left[nid]);
        float64 rl = this.ccR;
        int64 ll = this.ccLeaves;
        this.subtreeStats(this.right[nid]);
        this.ccR = rl + this.ccR;
        this.ccLeaves = ll + this.ccLeaves;
        return;
    }

    // Weakest link: min g over internal nodes (ties → lowest node id);
    // out via ccWeak/ccWeakG. -1 when the root is a leaf.
    int64 ccWeak;
    float64 ccWeakG;

    void findWeakest(int64 nid) {
        if (this.feature[nid] < 0) { return; }
        this.subtreeStats(nid);
        float64 rt = this.nodeW[nid] * this.nodeImp[nid] / this.nTotalW;
        float64 g = (rt - this.ccR) / (float64) (this.ccLeaves - 1);
        if (this.ccWeak < 0 || g < this.ccWeakG) {
            this.ccWeak = nid;
            this.ccWeakG = g;
        }
        this.findWeakest(this.left[nid]);
        this.findWeakest(this.right[nid]);
        return;
    }

    /**
     * Collapse weakest links. With `k0 >= 0`, record the path: every
     * collapse to the root, one entry per DISTINCT alpha (equal-alpha
     * collapses merge, keeping the final impurity), starting at entry `k0`
     * — the caller seeds `[0, R(full)]`; returns the entry count. With
     * `k0 < 0`, prune while `g <= alpha` and record nothing (the arrays
     * are unused scratch).
     */
    int64 pruneWhile(float64 alpha, float64[] alphas, float64[] imps, int64 k0) {
        boolean rec = k0 >= 0;
        int64 k = rec ? k0 : 0;
        while (this.feature[0] >= 0) {
            this.ccWeak = -1;
            this.ccWeakG = 0.0;
            this.findWeakest(0);
            if (this.ccWeak < 0) { break; }
            if (!rec && this.ccWeakG > alpha) { break; }
            int64 t = this.ccWeak;
            float64 g = this.ccWeakG;
            this.feature[t] = -1;
            this.left[t] = -1;
            this.right[t] = -1;
            if (rec) {
                this.subtreeStats(0);
                if (k > k0 && g <= alphas[k - 1] + 0.000000000000001) {
                    imps[k - 1] = this.ccR;
                } else {
                    alphas[k] = g;
                    imps[k] = this.ccR;
                    k = k + 1;
                }
            }
        }
        return k;
    }

    /** Recompute realizedDepth and leaves after pruning. */
    void recount() {
        this.realizedDepth = 0;
        this.leaves = 0;
        this.walkCount(0, 0);
        return;
    }

    void walkCount(int64 nid, int64 depth) {
        if (depth > this.realizedDepth) { this.realizedDepth = depth; }
        if (this.feature[nid] < 0) {
            this.leaves = this.leaves + 1;
            return;
        }
        this.walkCount(this.left[nid], depth + 1);
        this.walkCount(this.right[nid], depth + 1);
        return;
    }

    /**
     * The cost-complexity path of THIS (fully grown) tree: distinct
     * effective alphas ascending, with the total leaf impurity after each —
     * sklearn's `cost_complexity_pruning_path`. Mutates the tree (callers
     * fit a throwaway).
     */
    int64 ccpPath(float64[] alphas, float64[] imps) {
        this.subtreeStats(0);
        alphas[0] = 0.0;
        imps[0] = this.ccR;
        return this.pruneWhile(0.0, alphas, imps, 1);
    }

    /**
     * Normalized impurity-based feature importances: each split contributes
     * its weighted decrease `w(t)·imp(t) − w(l)·imp(l) − w(r)·imp(r)` to its
     * feature, then the vector is scaled to sum to 1 (all-leaf tree: zeros).
     * Computed by a post-growth walk over stored node stats, so pruning is
     * reflected. sklearn's `feature_importances_`.
     */
    #float64[] importances() {
        float64[] acc = heap float64[this.nf];
        this.accImportance(0, acc);
        float64 sum = 0.0;
        int64 f = 0;
        while (f < this.nf) { sum = sum + acc[f]; f = f + 1; }
        if (sum > 0.0) {
            f = 0;
            while (f < this.nf) { acc[f] = acc[f] / sum; f = f + 1; }
        }
        return #acc;
    }

    void accImportance(int64 nid, float64[] acc) {
        if (this.feature[nid] < 0) { return; }
        int64 li = this.left[nid];
        int64 ri = this.right[nid];
        float64 dec = this.nodeW[nid] * this.nodeImp[nid]
                    - this.nodeW[li] * this.nodeImp[li]
                    - this.nodeW[ri] * this.nodeImp[ri];
        acc[this.feature[nid]] = acc[this.feature[nid]] + dec;
        this.accImportance(li, acc);
        this.accImportance(ri, acc);
        return;
    }

    /** Route one row to its leaf id. */
    int64 leafOf(Tensor<float64> x, int64 row, int64 nf) {
        int64 nid = 0;
        while (this.feature[nid] >= 0) {
            float64 v = x.flatGet(row * nf + this.feature[nid]);
            if (v <= this.threshold[nid]) { nid = this.left[nid]; }
            else { nid = this.right[nid]; }
        }
        return nid;
    }

    /** sklearn-style indented rule dump (leaf: "class: k" / "value: v"). */
    #String exportText() {
        String s = "";
        s = this.dumpNode(0, "", s);
        return #s;
    }

    #String dumpNode(int64 nid, String indent, String acc) {
        if (this.feature[nid] < 0) {
            String lab;
            if (this.kOut > 1) {
                int64 best = 0;
                int64 k = 1;
                while (k < this.kOut) {
                    if (this.value[nid * this.kOut + k] > this.value[nid * this.kOut + best]) {
                        best = k;
                    }
                    k = k + 1;
                }
                lab = "class: " + Int64.of(best).toString();
            } else {
                lab = "value: " + Float64.of(this.value[nid]).toString();
            }
            String r = acc + indent + "|--- " + lab + "\n";
            return #r;
        }
        String cond = "f" + Int64.of(this.feature[nid]).toString();
        String thr = Float64.of(this.threshold[nid]).toString();
        String a1 = acc + indent + "|--- " + cond + " <= " + thr + "\n";
        String a2 = this.dumpNode(this.left[nid], indent + "|   ", a1);
        String a3 = a2 + indent + "|--- " + cond + " >  " + thr + "\n";
        String a4 = this.dumpNode(this.right[nid], indent + "|   ", a3);
        return #a4;
    }
}
