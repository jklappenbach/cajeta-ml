package dev.cajeta.ml;

/**
 * Base-2 Shannon entropy over integer class labels (ml-trees-ensembles U2,
 * spec §3.1–§3.2). The entropy itself comes from `cajeta.math.stats`
 * (via {@link Criteria#entropyOfCounts}), not a reimplementation.
 */
final class EntropyImpurity implements Impurity {
    int64 k;
    float64[] cw;   // per-class weights (spec §4.8); null = unweighted

    EntropyImpurity(int64 k) {
        this.k = k;
        return;
    }

    EntropyImpurity(int64 k, #float64[] cw) {
        this.k = k;
        this.cw #= cw;
        return;
    }

    #float64[] wcounts(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64[] wc = heap float64[this.k];
        int64 i = lo;
        while (i < hi) {
            int64 c = (int64) ys[i];
            float64 w = this.cw != null ? this.cw[c] : 1.0;
            wc[c] = wc[c] + w * ws[i];
            i = i + 1;
        }
        return #wc;
    }

    public float64 weightedN(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64[] wc = this.wcounts(ys, ws, lo, hi);
        float64 s = 0.0;
        int64 c = 0;
        while (c < this.k) { s = s + wc[c]; c = c + 1; }
        return s;
    }

    public float64 weighted(float64[] ys, float64[] ws, int64 lo, int64 hi) {
        float64[] wc = this.wcounts(ys, ws, lo, hi);
        float64 wn = 0.0;
        int64 c = 0;
        while (c < this.k) { wn = wn + wc[c]; c = c + 1; }
        return wn * Criteria.entropyOfWeights(wc, this.k, wn);
    }

    public boolean validSplit(float64[] ys, float64[] ws, int64 lo, int64 mid, int64 hi) {
        return true;
    }

    public int64 width() {
        return this.k;
    }

    public void leafInto(float64[] ys, float64[] ws, int64 lo, int64 hi, float64[] value, int64 off) {
        float64[] wc = this.wcounts(ys, ws, lo, hi);
        float64 wn = 0.0;
        int64 c = 0;
        while (c < this.k) { wn = wn + wc[c]; c = c + 1; }
        c = 0;
        while (c < this.k) {
            value[off + c] = wc[c] / wn;
            c = c + 1;
        }
        return;
    }
}
