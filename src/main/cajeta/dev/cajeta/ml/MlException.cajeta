package dev.cajeta.ml;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/**
 * Thrown on estimator misuse (predict/transform before fit, shape mismatches
 * between X and y) and on fit-time failures a caller can act on. Recoverable,
 * mirroring the stdlib's `LinAlgException`/`BroadcastException` discipline.
 */
public class MlException extends RecoverableException {
    public MlException(String message) {
        this.message = message;
        this.cause = 0;
    }
}
