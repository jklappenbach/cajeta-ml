package dev.cajeta.ml;

import cajeta.math.Tensor;
import cajeta.math.distance.Metric;

/**
 * k-nearest-neighbors regression (sklearn `KNeighborsRegressor`):
 * brute-force with any {@link cajeta.math.distance.Metric} (euclidean
 * default, spec §5.1), `uniform` or `distance` weights (sklearn's
 * zero-distance rule: exact matches take all the weight). Neighbor ties at
 * equal distance break to the LOWEST training index — documented where
 * sklearn's order is an implementation detail; the pinned fixtures are
 * tie-free.
 */
public final class KNeighborsRegressor implements Predictor {

    private int64 kNeighbors;
    private boolean distanceWeights;
    private Metric metricM;             // null-free: hasMetric gates
    private boolean hasMetric;
    private Tensor<float64> trainX;     // (n, p)
    private Tensor<float64> trainY;     // (n,)
    private boolean fitted;

    public KNeighborsRegressor(int64 k, boolean distanceWeights) {
        if (k < 1) {
            throw heap MlException("KNeighborsRegressor: k must be >= 1");
        }
        this.kNeighbors = k;
        this.distanceWeights = distanceWeights;
        this.hasMetric = false;
        this.fitted = false;
        return;
    }

    /** Any stdlib or caller-defined metric through the §5.6 seam. */
    public KNeighborsRegressor(int64 k, boolean distanceWeights,
                               #Metric metric) {
        if (k < 1) {
            throw heap MlException("KNeighborsRegressor: k must be >= 1");
        }
        this.kNeighbors = k;
        this.distanceWeights = distanceWeights;
        this.metricM #= metric;
        this.hasMetric = true;
        this.fitted = false;
        return;
    }

    public void fit(Tensor<float64> x, Tensor<float64> y) {
        if (x.ndim() != 2) {
            throw heap MlException(
                "KNeighborsRegressor.fit: x must be 2-D (n, p)");
        }
        int64 n = x.shapeAt(0);
        if (y.ndim() != 1 || y.shapeAt(0) != n) {
            throw heap MlException(
                "KNeighborsRegressor.fit: y must be (n,) matching x rows");
        }
        if (n < this.kNeighbors) {
            throw heap MlException("KNeighborsRegressor.fit: n < k");
        }
        Tensor<float64> cx = x.copy();
        Tensor<float64> cy = y.copy();
        this.trainX #= cx;
        this.trainY #= cy;
        this.fitted = true;
        return;
    }

    public boolean isFitted() {
        return this.fitted;
    }

    /**
     * The metric-agnostic seam (§5.6): k nearest training indices of query
     * row `qi` under `m`, nearest first, TRUE distances in `outDist`.
     * Equal distances break to the lowest training index (strict `<`).
     */
    static void nearestWith(Tensor<float64> tx, Tensor<float64> q, int64 qi,
                            int64 k, Metric m, int64[] outIdx,
                            float64[] outDist) {
        int64 n = tx.shapeAt(0);
        int64 p = tx.shapeAt(1);
        int64[] vs = heap int64[1];
        vs[0] = p;
        Tensor<float64> qv = Tensor.zeros<float64>(vs);
        Tensor<float64> tv = Tensor.zeros<float64>(vs);
        int64 j = 0;
        while (j < p) {
            qv.flatSet(j, q.get2(qi, j));
            j = j + 1;
        }
        float64[] dist = heap float64[n];
        int64 i = 0;
        while (i < n) {
            j = 0;
            while (j < p) {
                tv.flatSet(j, tx.get2(i, j));
                j = j + 1;
            }
            dist[i] = m.distance(tv, qv);
            i = i + 1;
        }
        boolean[] used = heap boolean[n];
        int64 s = 0;
        while (s < k) {
            int64 best = -1;
            float64 bd = 0.0;
            i = 0;
            while (i < n) {
                if (!used[i]) {
                    float64 dv = dist[i];
                    if (best < 0 || dv < bd) {
                        bd = dv;
                        best = i;
                    }
                }
                i = i + 1;
            }
            used[best] = true;
            outIdx[s] = best;
            outDist[s] = bd;
            s = s + 1;
        }
        return;
    }

    /** The k nearest training indices of query row `qi`, nearest first. */
    static void nearest(Tensor<float64> tx, Tensor<float64> q, int64 qi,
                        int64 k, int64[] outIdx, float64[] outD2) {
        int64 n = tx.shapeAt(0);
        int64 p = tx.shapeAt(1);
        boolean[] used = heap boolean[n];
        int64 s = 0;
        while (s < k) {
            int64 best = -1;
            float64 bd = 0.0;
            int64 i = 0;
            while (i < n) {
                if (!used[i]) {
                    float64 acc = 0.0;
                    int64 j = 0;
                    while (j < p) {
                        float64 d = tx.get2(i, j) - q.get2(qi, j);
                        acc = acc + d * d;
                        j = j + 1;
                    }
                    if (best < 0 || acc < bd) { bd = acc; best = i; }
                }
                i = i + 1;
            }
            used[best] = true;
            outIdx[s] = best;
            outD2[s] = bd;
            s = s + 1;
        }
        return;
    }

    public #Tensor<float64> predict(Tensor<float64> x) {
        if (!this.fitted) {
            throw heap MlException("KNeighborsRegressor.predict: fit first");
        }
        int64 p = this.trainX.shapeAt(1);
        if (x.ndim() != 2 || x.shapeAt(1) != p) {
            throw heap MlException("KNeighborsRegressor.predict: x must be "
                + "(n, p) with p matching the fit");
        }
        int64 n = x.shapeAt(0);
        int64 k = this.kNeighbors;
        int64[] idx = heap int64[k];
        float64[] d2 = heap float64[k];
        float64[] out = heap float64[n];
        int64 i = 0;
        while (i < n) {
            if (this.hasMetric) {
                // The seam returns TRUE distances; square them so the
                // d2-based weighting below stays one code path.
                KNeighborsRegressor.nearestWith(this.trainX, x, i, k,
                    this.metricM, idx, d2);
                int64 s0 = 0;
                while (s0 < k) {
                    d2[s0] = d2[s0] * d2[s0];
                    s0 = s0 + 1;
                }
            } else {
                KNeighborsRegressor.nearest(this.trainX, x, i, k, idx, d2);
            }
            if (!this.distanceWeights) {
                float64 acc = 0.0;
                int64 s = 0;
                while (s < k) {
                    // local-copy: array element as call arg trips the
                    // matrix-element-callarg codegen defect
                    int64 ix = idx[s];
                    acc = acc + this.trainY.get1(ix);
                    s = s + 1;
                }
                out[i] = acc / (float64) k;
            } else {
                // sklearn's zero-distance rule: exact matches take all
                // the weight (uniformly among themselves).
                int64 zeros = 0;
                int64 s = 0;
                while (s < k) {
                    if (d2[s] == 0.0) { zeros = zeros + 1; }
                    s = s + 1;
                }
                if (zeros > 0) {
                    float64 acc = 0.0;
                    s = 0;
                    while (s < k) {
                        if (d2[s] == 0.0) {
                            int64 ix = idx[s];
                            acc = acc + this.trainY.get1(ix);
                        }
                        s = s + 1;
                    }
                    out[i] = acc / (float64) zeros;
                } else {
                    float64 wsum = 0.0;
                    float64 acc = 0.0;
                    s = 0;
                    while (s < k) {
                        float64 dv = d2[s];
                        float64 w = 1.0 / Math.sqrt(dv);
                        int64 ix = idx[s];
                        acc = acc + w * this.trainY.get1(ix);
                        wsum = wsum + w;
                        s = s + 1;
                    }
                    out[i] = acc / wsum;
                }
            }
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = n;
        return Tensor.of<float64>(out, sh);
    }

    /** R² (the sklearn regressor `score` convention). */
    public float64 score(Tensor<float64> x, Tensor<float64> y) {
        Tensor<float64> pr = this.predict(x);
        return Metrics.r2(y, pr);
    }
}
