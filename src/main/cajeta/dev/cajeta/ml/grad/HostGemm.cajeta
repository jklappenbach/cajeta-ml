package dev.cajeta.ml.grad;

import cajeta.concurrent.Carriers;
import cajeta.math.Tensor;

/**
 * The host matrix product (spela-kernels 10.2.1). The stdlib's Tensor.matmul reads every
 * element through its strides, one at a time, and on the cpu SPELA step it was 84% of the
 * time (2026-11-15). This one walks the host arrays directly, holding four rows by sixteen
 * columns of the result in vector registers across all of K: one vector load of `b` serves
 * four rows, and a bounds check covers sixteen lanes, where a checked scalar loop would not
 * vectorize at all. The row blocks are split
 * across the carriers when the product is large enough to pay for a fiber.
 *
 * `a` is read through two strides, so a^T . b reads `a` in place: a weight gradient X^T . G
 * makes no transposed copy of X.
 *
 * The sums are fused multiply-adds (Math.fma, host-simd), one rounding a step where a
 * separate multiply and add cost two instructions and capped the tile at half the core's
 * rate. Where the build's vector registers are 512 bits (Cajeta.hostVectorBits()), sixteen
 * lanes are one register, and the tile widens to 4 rows by 32 columns, eight accumulators,
 * enough to cover the multiply-add's latency on two pipes.
 */
public final class HostGemm {
    /** Multiply-adds below which the product stays on the calling fiber. */
    static final int64 SPLIT_WORK = 1048576L;
    /** Lanes in the vector each row's sums are held in. */
    static final int64 LANES = 16L;
    static final int32 MAX_PARTS = 16;

    static int64 count = 0L;
    static int32 parts = 0;
    static boolean transposedA = false;

    /** How many products ran here, for the tests that pin the route. */
    public static int64 products() { return HostGemm.count; }

    /** The parts the last product was split into: 1 when it ran on the caller. */
    public static int32 lastParts() { return HostGemm.parts; }

    static boolean narrow = false;
    static int32 wideMode = 0;
    static boolean wide = false;

    /**
     * The wide tile, eight accumulators of 4 rows by 32 columns: 0 leaves it to the build
     * (on where Cajeta.hostVectorBits() is 512 or more, so sixteen lanes are one register and
     * four accumulators would not cover the fused multiply-add's latency on two pipes), 1 forces
     * it on and 2 off. For the tests, which check it on any machine.
     */
    public static void setWideTile(int32 mode) { HostGemm.wideMode = mode; }

    /** Whether the last product ran the wide tile. */
    public static boolean lastWideTile() { return HostGemm.wide; }

    /** Whether the last product was narrow (n under the vector width) and ran as its transpose. */
    public static boolean lastNarrow() { return HostGemm.narrow; }

    /** Whether the last product read its left operand transposed, in place. */
    public static boolean lastReadATransposed() { return HostGemm.transposedA; }

    /** Whether `a` and `b` are host-resident, 2-D and contiguous, the tensors this product reads. */
    public static boolean runs<E>(Tensor<E> a, Tensor<E> b) {
        if (a.isOnGpu() || b.isOnGpu()) { return false; }
        if (a.ndim() != 2 || b.ndim() != 2) { return false; }
        return a.isContiguous() && b.isContiguous();
    }

    /** `a` (m x k) . `b` (k x n). */
    public static #Tensor<E> nn<E extends Floating>(Tensor<E> a, Tensor<E> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        return HostGemm.product<E>(a, k, 1L, b, m, n, k, false);
    }

    /** `a`^T . `b` for `a` (k x m) and `b` (k x n), reading `a` as stored. */
    public static #Tensor<E> tn<E extends Floating>(Tensor<E> a, Tensor<E> b) {
        int64 k = a.shapeAt(0);
        int64 m = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        return HostGemm.product<E>(a, 1L, m, b, m, n, k, true);
    }

    /** C = A . B with A(i,p) at a[i * sai + p * sap] and B row-major (k x n). */
    static #Tensor<E> product<E extends Floating>(Tensor<E> a, int64 sai, int64 sap, Tensor<E> b,
                                                  int64 m, int64 n, int64 k, boolean ta) {
        int64[] shp = [m, n];
        Tensor<E> out #= Tensor.zeros<E>(shp);
        E[] c = out.hostBuffer();
        int64 c0 = out.hostBase();
        E[] av = a.hostBuffer();
        int64 a0 = a.hostBase();
        E[] bv = b.hostBuffer();
        int64 b0 = b.hostBase();
        int64 blocks = (m + 3L) / 4L;
        int64 want = (int64) Carriers.count();
        if (want > (int64) HostGemm.MAX_PARTS) { want = (int64) HostGemm.MAX_PARTS; }
        if (want > blocks) { want = blocks; }
        if (m * n * k < HostGemm.SPLIT_WORK || want < 2L) { want = 1L; }
        HostGemm.count = HostGemm.count + 1L;
        HostGemm.parts = (int32) want;
        HostGemm.transposedA = ta;
        HostGemm.wide = HostGemm.wideMode == 1 || (HostGemm.wideMode == 0 && Cajeta.hostVectorBits() >= 512);
        HostGemm.narrow = n < HostGemm.LANES && m >= HostGemm.LANES;
        if (HostGemm.narrow) {
            HostGemm.parts = 1;
            HostGemm.narrowInto<E>(c, c0, av, a0, sai, sap, bv, b0, m, n, k, ta);
            return #out;
        }
        if (want == 1L) {
            HostGemm.rows<E>(c, c0, av, a0, sai, sap, bv, b0, 0L, m, n, k);
            return #out;
        }
        int64 per = (blocks + want - 1L) / want;
        scope {
            int64 r0 = 0L;
            while (r0 < m) {
                int64 r1 = r0 + per * 4L;
                if (r1 > m) { r1 = m; }
                spawn rows<E>(c, c0, av, a0, sai, sap, bv, b0, r0, r1, n, k);
                r0 = r1;
            }
        }
        return #out;
    }

    /**
     * A narrow product (n under the vector width, m at or past it) as its transpose,
     * C^T = B^T . A^T: the wide tile then runs along m, where C's own n columns would leave
     * every element to the scalar tail. A^T is `a` as stored when it is read transposed (a
     * weight gradient), else one copy of `a`.
     */
    static void narrowInto<E extends Floating>(E[] c, int64 c0, E[] a, int64 a0, int64 sai, int64 sap,
                                               E[] b, int64 b0, int64 m, int64 n, int64 k, boolean ta) {
        // B'(p, i) = A(i, p), row-major k x m: `a` itself when read transposed, else a copy
        if (!ta) {
            E[] copy = heap E[k * m];
            int64 i = 0L;
            while (i < m) {
                int64 p = 0L;
                while (p < k) {
                    copy[p * m + i] = a[a0 + i * sai + p * sap];
                    p = p + 1L;
                }
                i = i + 1L;
            }
            E[] ct = heap E[n * m];
            HostGemm.rows<E>(ct, 0L, b, b0, 1L, n, copy, 0L, 0L, n, m, k);
            HostGemm.untranspose<E>(c, c0, ct, m, n);
            return;
        }
        E[] ct2 = heap E[n * m];
        HostGemm.rows<E>(ct2, 0L, b, b0, 1L, n, a, a0, 0L, n, m, k);
        HostGemm.untranspose<E>(c, c0, ct2, m, n);
    }

    /** C (m x n) from its transpose `ct` (n x m). */
    static void untranspose<E extends Floating>(E[] c, int64 c0, E[] ct, int64 m, int64 n) {
        int64 i = 0L;
        while (i < m) {
            int64 j = 0L;
            while (j < n) {
                c[c0 + i * n + j] = ct[j * m + i];
                j = j + 1L;
            }
            i = i + 1L;
        }
    }

    /**
     * Rows [i0, i1) of C, which starts zeroed. Four rows by sixteen columns are summed in
     * registers over all of K, one vector load of `b` and four reads of `a` a step, and stored
     * once; columns past the last sixteen and rows past the last four are summed one by one.
     */
    static void rows<E extends Floating>(E[] c, int64 c0, E[] a, int64 a0, int64 sai, int64 sap,
                                         E[] b, int64 b0, int64 i0, int64 i1, int64 n, int64 k) {
        int64 nv = n - n % HostGemm.LANES;
        int64 i = i0;
        while (i + 4L <= i1) {
            int64 ai = a0 + i * sai;
            int64 o0 = c0 + i * n;
            int64 j = 0L;
            if (HostGemm.wide) {
                while (j + 2L * HostGemm.LANES <= n) {
                    HostGemm.wideBlock<E>(c, o0, a, ai, sai, sap, b, b0 + j, j, n, k);
                    j = j + 2L * HostGemm.LANES;
                }
            }
            while (j < nv) {
                // C starts zeroed, so its own lanes seed the sums
                Vector<E,16> s0 = c.vload<16>(o0 + j);
                Vector<E,16> s1 = s0;
                Vector<E,16> s2 = s0;
                Vector<E,16> s3 = s0;
                int64 ap = ai;
                int64 bp = b0 + j;
                int64 p = 0L;
                while (p < k) {
                    Vector<E,16> y = b.vload<16>(bp);
                    E e0 = a[ap];
                    E e1 = a[ap + sai];
                    E e2 = a[ap + 2L * sai];
                    E e3 = a[ap + 3L * sai];
                    Vector<E,16> x0 = heap Vector<E,16>(e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0);
                    Vector<E,16> x1 = heap Vector<E,16>(e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1);
                    Vector<E,16> x2 = heap Vector<E,16>(e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2);
                    Vector<E,16> x3 = heap Vector<E,16>(e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3);
                    s0 = Math.fma(y, x0, s0);
                    s1 = Math.fma(y, x1, s1);
                    s2 = Math.fma(y, x2, s2);
                    s3 = Math.fma(y, x3, s3);
                    ap = ap + sap;
                    bp = bp + n;
                    p = p + 1L;
                }
                c.vstore(o0 + j, s0);
                c.vstore(o0 + n + j, s1);
                c.vstore(o0 + 2L * n + j, s2);
                c.vstore(o0 + 3L * n + j, s3);
                j = j + HostGemm.LANES;
            }
            int64 r = 0L;
            while (r < 4L) {
                HostGemm.tail<E>(c, o0 + r * n, a, ai + r * sai, sap, b, b0, nv, n, k);
                r = r + 1L;
            }
            i = i + 4L;
        }
        while (i < i1) {
            int64 ai = a0 + i * sai;
            int64 o0 = c0 + i * n;
            int64 j = 0L;
            while (j < nv) {
                Vector<E,16> s0 = c.vload<16>(o0 + j);
                int64 ap = ai;
                int64 bp = b0 + j;
                int64 p = 0L;
                while (p < k) {
                    E e0 = a[ap];
                    Vector<E,16> x0 = heap Vector<E,16>(e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0);
                    s0 = Math.fma(b.vload<16>(bp), x0, s0);
                    ap = ap + sap;
                    bp = bp + n;
                    p = p + 1L;
                }
                c.vstore(o0 + j, s0);
                j = j + HostGemm.LANES;
            }
            HostGemm.tail<E>(c, o0, a, ai, sap, b, b0, nv, n, k);
            i = i + 1L;
        }
    }

    /**
     * Four rows by 32 columns of C at column `j`, from `b` at `bp`: eight accumulators summed
     * over all of K with fused multiply-adds, two vector loads of `b` and four broadcasts of
     * `a` a step, stored once. A broadcast is a Vector built from one value in every lane,
     * which LLVM folds to one instruction; it is written in place, because a template method
     * returning Vector<E,16> does not compile (cajeta v0.53.9).
     */
    static void wideBlock<E extends Floating>(E[] c, int64 o0, E[] a, int64 ai, int64 sai, int64 sap,
                                              E[] b, int64 bp0, int64 j, int64 n, int64 k) {
        Vector<E,16> s00 = c.vload<16>(o0 + j);
        Vector<E,16> s01 = s00;
        Vector<E,16> s10 = s00;
        Vector<E,16> s11 = s00;
        Vector<E,16> s20 = s00;
        Vector<E,16> s21 = s00;
        Vector<E,16> s30 = s00;
        Vector<E,16> s31 = s00;
        int64 ap = ai;
        int64 bp = bp0;
        int64 p = 0L;
        while (p < k) {
            Vector<E,16> y0 = b.vload<16>(bp);
            Vector<E,16> y1 = b.vload<16>(bp + HostGemm.LANES);
            E e0 = a[ap];
            E e1 = a[ap + sai];
            E e2 = a[ap + 2L * sai];
            E e3 = a[ap + 3L * sai];
            Vector<E,16> x0 = heap Vector<E,16>(e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0, e0);
            Vector<E,16> x1 = heap Vector<E,16>(e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1, e1);
            Vector<E,16> x2 = heap Vector<E,16>(e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2, e2);
            Vector<E,16> x3 = heap Vector<E,16>(e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3, e3);
            s00 = Math.fma(y0, x0, s00);
            s01 = Math.fma(y1, x0, s01);
            s10 = Math.fma(y0, x1, s10);
            s11 = Math.fma(y1, x1, s11);
            s20 = Math.fma(y0, x2, s20);
            s21 = Math.fma(y1, x2, s21);
            s30 = Math.fma(y0, x3, s30);
            s31 = Math.fma(y1, x3, s31);
            ap = ap + sap;
            bp = bp + n;
            p = p + 1L;
        }
        int64 h = HostGemm.LANES;
        c.vstore(o0 + j, s00);
        c.vstore(o0 + j + h, s01);
        c.vstore(o0 + n + j, s10);
        c.vstore(o0 + n + j + h, s11);
        c.vstore(o0 + 2L * n + j, s20);
        c.vstore(o0 + 2L * n + j + h, s21);
        c.vstore(o0 + 3L * n + j, s30);
        c.vstore(o0 + 3L * n + j + h, s31);
    }

    /** Columns [j0, n) of one row of C: row `o` of C, the row of A from `ai` by `sap`. */
    static void tail<E extends Floating>(E[] c, int64 o, E[] a, int64 ai, int64 sap,
                                         E[] b, int64 b0, int64 j0, int64 n, int64 k) {
        int64 j = j0;
        while (j < n) {
            E acc = (E) 0;
            int64 ap = ai;
            int64 bp = b0 + j;
            int64 p = 0L;
            while (p < k) {
                acc = Math.fma(a[ap], b[bp], acc);
                ap = ap + sap;
                bp = bp + n;
                p = p + 1L;
            }
            c[o + j] = acc;
            j = j + 1L;
        }
    }
}
