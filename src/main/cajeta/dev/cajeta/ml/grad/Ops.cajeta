package dev.cajeta.ml.grad;

import cajeta.math.DType;
import cajeta.math.Ewise;
import cajeta.math.Tensor;
import cajeta.math.stats.Stats;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.ml.MlException;
import dev.cajeta.ml.kernels.Convert;
import dev.cajeta.ml.kernels.Copy;
import dev.cajeta.ml.kernels.Elementwise;
import dev.cajeta.ml.kernels.Fill;
import dev.cajeta.ml.kernels.Gemm;
import dev.cajeta.ml.kernels.Reduce;
import dev.cajeta.ml.kernels.gemm.Linear;
import dev.cajeta.ml.kernels.nn.Act;
import dev.cajeta.ml.kernels.nn.BatchNorm;
import dev.cajeta.ml.kernels.nn.Conv;
import dev.cajeta.ml.kernels.nn.Dropout;
import dev.cajeta.ml.kernels.nn.Embed;
import dev.cajeta.ml.kernels.nn.Loss;
import dev.cajeta.ml.kernels.nn.Norm;
import dev.cajeta.ml.kernels.nn.Pool;

/**
 * The op dispatch layer — THE device seam (spec §3.3, designed in from
 * day one). Every forward kernel the tape runs enters through
 * {@link #run1} / {@link #run2}: residency is checked here (mixed
 * CPU/GPU inputs are a loud error, never a silent transfer), and the
 * kernel is chosen from the registry column matching the inputs' device.
 * The CPU column is complete; the GPU column (cajeta-ml-gpu 27.1.1) is
 * filled in group by group through the `dev.cajeta.ml.kernels` package,
 * at float32, and {@link #hasGpu} answers per op. NO CALLER CHANGES: the
 * seam is the contract.
 *
 * Generic over `E extends Floating` (f32 + f64, spec §3.1); scalar
 * intermediates compute in float64 and narrow on store.
 *
 * Kernels compose `cajeta.math.Tensor` primitives (which carry their own
 * broadcast semantics); nothing outside this class may implement an op —
 * the kernel methods are package-private on purpose.
 */
public final class Ops {

    /** True when a CPU kernel exists for `op` (v3: all ops). */
    public static boolean hasCpu(int32 op) {
        return op > Op.LEAF && op < Op.COUNT;
    }

    /** True when a GPU kernel exists for `op`: every op of the table, at
     *  float32 (cajeta-ml-gpu 27.1.1). */
    public static boolean hasGpu(int32 op) {
        return op > Op.LEAF && op < Op.COUNT;
    }

    static void requireCpu<E extends Floating>(String opName, Tensor<E> t) {
        if (t.isOnGpu()) {
            throw heap MlException("ml.grad: '" + opName + "' input is "
                + "GPU-resident but the op has no GPU kernel yet (the "
                + "backward column, cajeta-ml-gpu 29) — move it with .cpu()");
        }
    }

    /** The GPU column runs at float32; a float64 tensor on the device is refused by name. */
    static void requireF32<E extends Floating>(String opName) {
        DType d #= DType.of<E>();
        if (d.bits() != 32) {
            throw heap MlException("ml.grad: '" + opName + "' on the device "
                + "runs at float32 only; keep float64 tensors on the host");
        }
    }

    static void requireSame<E extends Floating>(String opName, Tensor<E> a, Tensor<E> b) {
        if (a.isOnGpu() != b.isOnGpu()) {
            throw heap MlException("ml.grad: '" + opName + "' inputs live on "
                + "different devices — no silent transfers; move one "
                + "explicitly");
        }
    }

    /** Unary dispatch. `axis` and `c` are op-specific payloads. */
    public static #Tensor<E> run1<E extends Floating>(int32 op, Tensor<E> a,
                                                      int32 axis, E c) {
        if (a.isOnGpu()) {
            if (!Ops.hasGpu(op)) { Ops.requireCpu<E>(Ops.name(op), a); }
            return Ops.run1Gpu<E>(op, a, axis, c);
        }
        if (op == Op.RELU)       { return Tensor.relu<E>(a); }
        if (op == Op.NEG)        { return Tensor.neg<E>(a); }
        if (op == Op.EXP)        { return Tensor.exp<E>(a); }
        if (op == Op.LOG)        { return Tensor.log<E>(a); }
        if (op == Op.SQRT)       { return Tensor.sqrt<E>(a); }
        if (op == Op.TANH)       { return Ops.tanhK<E>(a); }
        if (op == Op.SIGMOID)    { return Ops.sigmoidK<E>(a); }
        if (op == Op.GELU)       { return Ops.geluK<E>(a); }
        if (op == Op.SOFTMAX)    { return Ops.softmaxK<E>(a); }
        if (op == Op.LOGSOFTMAX) { return Ops.logSoftmaxK<E>(a); }
        if (op == Op.POWS)       { return Ops.powScalarK<E>(a, c); }
        if (op == Op.SUM)        { return Ops.sumK<E>(a); }
        if (op == Op.MEAN)       { return Ops.meanK<E>(a); }
        if (op == Op.SUMAXIS)    { return Tensor.sumAxis<E, E>(a, axis, true); }
        if (op == Op.MEANAXIS)   { return Tensor.meanAxis<E, E>(a, axis, true); }
        if (op == Op.MAXAXIS)    { return Tensor.maxAxis<E>(a, axis, true); }
        if (op == Op.TRANSPOSE)  { Tensor<E> tr #= a.transpose(); Tensor<E> cp #= tr.copy(); return #cp; }
        if (op == Op.TRANSPOSEB) { return Ops.transposeLast2<E>(a); }
        if (op == Op.ROWNORM)    { return Ops.rowNormK<E>(a); }
        throw heap MlException("ml.grad: unknown unary op " + op);
    }

    /** The unary GPU column: `out` is allocated on the device, with no host mirror. */
    static #Tensor<E> run1Gpu<E extends Floating>(int32 op, Tensor<E> a, int32 axis, E c) {
        String name #= Ops.name(op);
        Ops.requireF32<E>(name);
        if (op == Op.SUM || op == Op.MEAN) { return Ops.reduceAllGpu<E>(name, a, op == Op.MEAN); }
        if (op == Op.TRANSPOSE) { int32[] p2 = [1, 0]; return Ops.permuteGpu<E>(name, a, p2); }
        if (op == Op.TRANSPOSEB) { int32[] p3 = [0, 2, 1]; return Ops.permuteGpu<E>(name, a, p3); }
        if (op == Op.SUMAXIS || op == Op.MEANAXIS || op == Op.MAXAXIS) {
            int32 rop = Reduce.SUM;
            if (op == Op.MEANAXIS) { rop = Reduce.MEAN; }
            if (op == Op.MAXAXIS) { rop = Reduce.MAX; }
            return Ops.reduceAxisGpu<E>(name, a, axis, rop);
        }
        Tensor<E> out #= Ewise.deviceLike<E>(a);
        KernelBuffer<E> xo = out.deviceView(name);
        KernelBuffer<E> xi = a.deviceView(name);
        int64 n = a.size();
        int64 cols = a.shapeAt(a.ndim() - 1);
        if (op == Op.RELU)       { Act.apply<E>(xo, xi, n, Act.RELU); return #out; }
        if (op == Op.TANH)       { Act.apply<E>(xo, xi, n, Act.TANH); return #out; }
        if (op == Op.SIGMOID)    { Act.apply<E>(xo, xi, n, Act.SIGMOID); return #out; }
        if (op == Op.GELU)       { Act.apply<E>(xo, xi, n, Act.GELU_ERF); return #out; }
        if (op == Op.NEG)        { Elementwise.map<E>(xo, xi, n, Elementwise.NEG, 0.0f); return #out; }
        if (op == Op.EXP)        { Elementwise.map<E>(xo, xi, n, Elementwise.EXP, 0.0f); return #out; }
        if (op == Op.LOG)        { Elementwise.map<E>(xo, xi, n, Elementwise.LOG, 0.0f); return #out; }
        if (op == Op.SQRT)       { Elementwise.map<E>(xo, xi, n, Elementwise.SQRT, 0.0f); return #out; }
        if (op == Op.POWS)       { Elementwise.map<E>(xo, xi, n, Elementwise.POW, (float32) c); return #out; }
        if (op == Op.SOFTMAX)    { Act.softmaxRows<E>(xo, xi, n / cols, cols); return #out; }
        if (op == Op.LOGSOFTMAX) { Act.logSoftmaxRows<E>(xo, xi, n / cols, cols); return #out; }
        if (op == Op.ROWNORM)    { Norm.l2rows<E>(xo, xi, n / cols, cols, 0.00000001f); return #out; }
        throw heap MlException("ml.grad: '" + name + "' has no GPU kernel");
    }

    /** Whole-tensor sum or mean on the device: the float32 tree, converted to E into a [1] tensor. */
    static #Tensor<E> reduceAllGpu<E extends Floating>(String name, Tensor<E> a, boolean mean) {
        int64 n = a.size();
        int64[] sh = [1];
        Tensor<E> out #= Ewise.deviceOf<E>(sh);
        KernelBuffer<float32> f = heap KernelBuffer<float32>(1);
        Reduce.segments<E>(f, a.deviceView(name), n, 1L, Reduce.SUM);
        Convert.into<float32, E>(out.deviceView(name), f, 1L);
        if (mean) { Elementwise.map<E>(out.deviceView(name), out.deviceView(name), 1L, Elementwise.SCALE, 1.0f / (float32) n); }
        return #out;
    }

    /** Reduction along `axis` with keepdims, as (outer, axisLen, inner) through `Reduce.axis`. */
    static #Tensor<E> reduceAxisGpu<E extends Floating>(String name, Tensor<E> a, int32 axis, int32 rop) {
        int32 nd = a.ndim();
        int32 ax = axis;
        if (ax < 0) { ax = ax + nd; }
        int64[] sh = heap int64[nd];
        int64 outer = 1;
        int64 inner = 1;
        int32 d = 0;
        while (d < nd) {
            sh[d] = a.shapeAt(d);
            if (d < ax) { outer = outer * sh[d]; }
            if (d > ax) { inner = inner * sh[d]; }
            d = d + 1;
        }
        int64 axisLen = sh[ax];
        sh[ax] = 1;
        Tensor<E> out #= Ewise.deviceOf<E>(sh);
        Reduce.alongAxis<E>(out.deviceView(name), a.deviceView(name), outer, axisLen, inner, rop);
        return #out;
    }

    /** A zero tensor of `shape` on `like`'s device: the tape's saved state follows its input. */
    public static #Tensor<E> zerosOn<E extends Floating>(int64[] shape, Tensor<E> like) {
        if (like.isOnGpu()) {
            Tensor<E> dv #= Ewise.deviceOf<E>(shape);
            Fill.with<E>(dv.deviceView("zeros"), dv.size(), (E) 0);
            return #dv;
        }
        return Tensor.zeros<E>(shape);
    }

    /** A zero tensor shaped like `like`, on its device. */
    public static #Tensor<E> zerosLike<E extends Floating>(Tensor<E> like) {
        int64[] sh #= Ops.shapeOf<E>(like);
        return Ops.zerosOn<E>(sh, like);
    }

    /** y = act(x . w + b): `x` (m x k) against `w` (k x n) with the bias `b` (n), act 0 none or 1 relu; one launch on the device below Gemm.large, else the composition. */
    public static #Tensor<E> linear<E extends Floating>(Tensor<E> x, Tensor<E> w, Tensor<E> b, int32 act) {
        if (x.isOnGpu()) {
            Ops.requireSame<E>("linear", x, w);
            Ops.requireSame<E>("linear", x, b);
            Ops.requireF32<E>("linear");
            int64 m = x.shapeAt(0);
            int64 k = x.shapeAt(1);
            int64 n = w.shapeAt(1);
            if (!Gemm.large(m, n)) {
                int64[] shp = [m, n];
                Tensor<E> out #= Ewise.deviceOf<E>(shp);
                Linear.run<E>(out.deviceView("linear"), x.deviceView("linear"), w.deviceView("linear"), b.deviceView("linear"), m, n, k, true, act);
                return #out;
            }
        }
        Tensor<E> mm #= Ops.run2<E>(Op.MATMUL, x, w);
        Tensor<E> y #= Ops.run2<E>(Op.ADD, mm, b);
        if (act == 1) { return Ops.run1<E>(Op.RELU, y, 0, (E) 0); }
        return #y;
    }

    /**
     * `a`^T . `b` for 2-D `a` (k x m) and `b` (k x n): on the device the transposed-A
     * split member reads `a` in place when the product splits K (Gemm.tiledTN), else `a`
     * is transposed and multiplied as before. A weight gradient X^T . G is this shape, and
     * the in-place read saves X's 16 to 64 MB copy (cajeta-ml-gpu 28.2.8).
     */
    public static #Tensor<E> matmulTN<E extends Floating>(Tensor<E> a, Tensor<E> b) {
        if (a.isOnGpu() && a.ndim() == 2 && b.ndim() == 2) {
            Ops.requireSame<E>("matmulTN", a, b);
            Ops.requireF32<E>("matmulTN");
            int64 k = a.shapeAt(0);
            int64 m = a.shapeAt(1);
            int64 n = b.shapeAt(1);
            int64[] shp = [m, n];
            Tensor<E> out #= Ewise.deviceOf<E>(shp);
            if (Gemm.tiledTN<E>(out.deviceView("matmulTN"), a.deviceView("matmulTN"), b.deviceView("matmulTN"), m, n, k)) {
                return #out;
            }
        }
        Tensor<E> at #= Ops.run1<E>(Op.TRANSPOSE, a, 0, (E) 0);
        Tensor<E> r #= Ops.run2<E>(Op.MATMUL, at, b);
        return #r;
    }

    /**
     * Rank-3 batched `alpha` op(a) . op(b), op transposing the last two axes of `a` when
     * `transA` and of `b` when `transB`. On the device the batched tile reads a transposed
     * operand in place and scales as it stores; elsewhere it is transposed, multiplied and
     * scaled (cajeta-ml-gpu 28.2.8).
     */
    public static #Tensor<E> matmulBatchedT<E extends Floating>(Tensor<E> a, Tensor<E> b, boolean transA, boolean transB,
                                                               float32 alpha) {
        Tensor<E> r #= Ops.matmulBatchedUnscaled<E>(a, b, transA, transB, alpha);
        if (alpha == 1.0f || r.isOnGpu()) { return #r; }
        int64[] one = [1L];
        Tensor<E> sc #= Tensor.full<E>(one, (E) alpha);
        return Tensor.mul<E>(r, sc);
    }

    /** matmulBatchedT's body; the device tile applies `alpha`, the host path leaves it to the caller. */
    static #Tensor<E> matmulBatchedUnscaled<E extends Floating>(Tensor<E> a, Tensor<E> b, boolean transA, boolean transB,
                                                               float32 alpha) {
        if (a.ndim() != 3 || b.ndim() != 3) {
            throw heap MlException("ml.grad: matmulBatched expects rank-3 inputs, got " + a.ndim() + " and " + b.ndim());
        }
        if (a.isOnGpu() && Device.kernelAvailable("gemmTiled64Batched_float32")) {
            Ops.requireSame<E>("matmulBatched", a, b);
            Ops.requireF32<E>("matmulBatched");
            int64 batch = a.shapeAt(0);
            int64 m = a.shapeAt(1);
            int64 k = a.shapeAt(2);
            if (transA) { m = a.shapeAt(2); k = a.shapeAt(1); }
            int64 n = b.shapeAt(2);
            int64 kb = b.shapeAt(1);
            if (transB) { n = b.shapeAt(1); kb = b.shapeAt(2); }
            if (b.shapeAt(0) != batch || kb != k) {
                throw heap MlException("ml.grad: matmulBatched shape mismatch");
            }
            int64[] shp = [batch, m, n];
            Tensor<E> out #= Ewise.deviceOf<E>(shp);
            Gemm.tiledBatchedT<E>(out.deviceView("matmulBatched"), a.deviceView("matmulBatched"), b.deviceView("matmulBatched"),
                                  m, n, k, batch, transA, transB, alpha);
            return #out;
        }
        if (transA && transB) {
            Tensor<E> at #= Ops.transposeLast2<E>(a);
            Tensor<E> bt #= Ops.transposeLast2<E>(b);
            Tensor<E> r #= Ops.run2<E>(Op.MATMULB, at, bt);
            return #r;
        }
        if (transA) {
            Tensor<E> at #= Ops.transposeLast2<E>(a);
            Tensor<E> r #= Ops.run2<E>(Op.MATMULB, at, b);
            return #r;
        }
        if (transB) {
            Tensor<E> bt #= Ops.transposeLast2<E>(b);
            Tensor<E> r #= Ops.run2<E>(Op.MATMULB, a, bt);
            return #r;
        }
        return Ops.run2<E>(Op.MATMULB, a, b);
    }

    /** A copy of `t` on its own device. */
    public static #Tensor<E> copyOf<E extends Floating>(Tensor<E> t) {
        if (t.isOnGpu()) {
            Tensor<E> dv #= Ewise.deviceLike<E>(t);
            Copy.into<E>(dv.deviceView("copy"), t.deviceView("copy"), t.size());
            return #dv;
        }
        return t.copy();
    }

    /** running = (1 - m) * running + m * scale * batch, in place on the device. */
    static void blendInto<E extends Floating>(Tensor<E> running, Tensor<E> batch, float64 m, float64 scale) {
        String name = "batchNorm2d.runningStats";
        int64 n = running.size();
        Elementwise.map<E>(running.deviceView(name), running.deviceView(name), n, Elementwise.SCALE, (float32) (1.0 - m));
        Tensor<E> tmp #= Ewise.deviceLike<E>(batch);
        Elementwise.map<E>(tmp.deviceView(name), batch.deviceView(name), n, Elementwise.SCALE, (float32) (m * scale));
        Ewise.arithInto<E>(name, running, running, tmp, 0);
    }

    /** A tensor of `shape` filled with `v` on `like`'s device. */
    public static #Tensor<E> fullOn<E extends Floating>(int64[] shape, Tensor<E> like, E v) {
        if (like.isOnGpu()) {
            Tensor<E> dv #= Ewise.deviceOf<E>(shape);
            Fill.with<E>(dv.deviceView("full"), dv.size(), v);
            return #dv;
        }
        return Tensor.full<E>(shape, v);
    }

    /** `t * s` elementwise, on `t`'s device. */
    public static #Tensor<E> scale<E extends Floating>(Tensor<E> t, E s) {
        if (t.isOnGpu()) {
            Ops.requireF32<E>("scale");
            Tensor<E> out #= Ewise.deviceLike<E>(t);
            Elementwise.map<E>(out.deviceView("scale"), t.deviceView("scale"), t.size(), Elementwise.SCALE, (float32) s);
            return #out;
        }
        return Tensor.mulScalar<E>(t, s);
    }

    /** `g` broadcast (right-aligned, numpy rules) to `shape` and materialised, on its device. */
    public static #Tensor<E> broadcastCopy<E extends Floating>(Tensor<E> g, int64[] shape) {
        if (g.isOnGpu()) {
            Ops.requireF32<E>("broadcast");
            int32 nd = (int32) shape.count();
            if (nd > 4) { throw heap MlException("ml.grad: 'broadcast' on the device handles rank <= 4, got " + nd); }
            int32 gd = g.ndim();
            int64[] gs #= Ops.shapeOf<E>(g);
            int64[] gst #= Ops.contig(gs);
            int64[] is = heap int64[nd];
            int32 d = 0;
            while (d < nd) {
                int32 src = d - (nd - gd);
                is[d] = 0;
                if (src >= 0 && gs[src] != 1) { is[d] = gst[src]; }
                d = d + 1;
            }
            int64[] os #= Ops.contig(shape);
            Tensor<E> out #= Ewise.deviceOf<E>(shape);
            Copy.stridedInto<E>(out.deviceView("broadcast"), g.deviceView("broadcast"), shape, is, os, 0L, 0L);
            return #out;
        }
        Tensor<E> vw #= g.broadcastTo(shape);
        Tensor<E> out #= vw.copy();
        return #out;
    }

    /** `g` summed down to `like`'s shape (the broadcast VJP), on its device. */
    public static #Tensor<E> sumTo<E extends Floating>(Tensor<E> g, Tensor<E> like) {
        if (!g.isOnGpu()) { return Tensor.sumTo<E>(g, like); }
        Ops.requireSame<E>("sumTo", g, like);
        Ops.requireF32<E>("sumTo");
        int32 gd = g.ndim();
        int32 ld = like.ndim();
        // The first reduction reads `g` in place; only a sum that reduces nothing copies
        // (cajeta-ml-gpu 28.2.8).
        int32 first = -1;
        if (gd > ld) {
            first = 0;
        } else {
            int32 f = 0;
            while (f < ld && first < 0) {
                if (like.shapeAt(f) == 1 && g.shapeAt(f) != 1) { first = f; }
                f = f + 1;
            }
        }
        if (first < 0) { return Ops.copyOf<E>(g); }
        Tensor<E> cur #= Ops.reduceAxisGpu<E>("sumTo", g, first, Reduce.SUM);
        if (gd > ld) {
            int64[] sh0 #= Ops.shapeOf<E>(cur);
            int64[] dropped0 = heap int64[cur.ndim() - 1];
            int32 k0 = 1;
            while (k0 < cur.ndim()) { dropped0[k0 - 1] = sh0[k0]; k0 = k0 + 1; }
            cur #= Ops.reshape<E>(cur, dropped0);
        }
        // leading axes `like` does not have: reduce axis 0 and drop it
        while (cur.ndim() > ld) {
            Tensor<E> red #= Ops.reduceAxisGpu<E>("sumTo", cur, 0, Reduce.SUM);
            int64[] sh #= Ops.shapeOf<E>(red);
            int64[] dropped = heap int64[red.ndim() - 1];
            int32 k = 1;
            while (k < red.ndim()) { dropped[k - 1] = sh[k]; k = k + 1; }
            cur #= Ops.reshape<E>(red, dropped);
        }
        int32 d = 0;
        while (d < ld) {
            if (like.shapeAt(d) == 1 && cur.shapeAt(d) != 1) {
                cur #= Ops.reduceAxisGpu<E>("sumTo", cur, d, Reduce.SUM);
            }
            d = d + 1;
        }
        return #cur;
    }

    /** The activation VJP g * kind'(x), `y` the forward output; kinds as `Act`'s. */
    public static #Tensor<E> actBack<E extends Floating>(int32 op, Tensor<E> g, Tensor<E> x, Tensor<E> y) {
        if (g.isOnGpu()) {
            Ops.requireF32<E>("actBack");
            int32 kind = Act.RELU;
            if (op == Op.TANH) { kind = Act.TANH; }
            if (op == Op.SIGMOID) { kind = Act.SIGMOID; }
            if (op == Op.GELU) { kind = Act.GELU_ERF; }
            Tensor<E> out #= Ewise.deviceLike<E>(g);
            Act.backward<E>(out.deviceView("actBack"), g.deviceView("actBack"), x.deviceView("actBack"), y.deviceView("actBack"), g.size(), kind);
            return #out;
        }
        if (op == Op.RELU) {
            Tensor<E> m #= Tensor.reluMask<E>(x);
            return Tensor.mul<E>(g, m);
        }
        if (op == Op.TANH) {
            Tensor<E> o2 #= Tensor.mul<E>(y, y);
            Tensor<E> one #= Tensor.onesLike<E>(y);
            Tensor<E> dd #= Tensor.sub<E>(one, o2);
            return Tensor.mul<E>(g, dd);
        }
        if (op == Op.SIGMOID) {
            Tensor<E> one #= Tensor.onesLike<E>(y);
            Tensor<E> om #= Tensor.sub<E>(one, y);
            Tensor<E> dd #= Tensor.mul<E>(y, om);
            return Tensor.mul<E>(g, dd);
        }
        return Ops.geluBackCpu<E>(x, g);
    }

    /** GELU'(x) = Φ(x) + x·φ(x), Φ the standard-normal CDF (the CPU column). */
    static #Tensor<E> geluBackCpu<E extends Floating>(Tensor<E> x, Tensor<E> g) {
        Tensor<E> out #= x.copy();
        int64 n = Ops.countOf<E>(out);
        int64 i = 0;
        while (i < n) {
            float64 xv = (float64) x.flatGet(i);
            float64 cdf = 0.5 * (1.0 + Stats.erf(xv / 1.4142135623730951));
            float64 pdf = 0.3989422804014327 * Math.exp(-0.5 * xv * xv);
            float64 gr = (float64) g.flatGet(i) * (cdf + xv * pdf);
            out.flatSet(i, (E) gr);
            i = i + 1;
        }
        return #out;
    }

    /** The softmax VJP s ⊙ (g − ⟨g, s⟩) per row, or the log-softmax VJP g − exp(ls) ⊙ Σg when `logForm`. */
    public static #Tensor<E> softmaxBack<E extends Floating>(Tensor<E> y, Tensor<E> g, boolean logForm) {
        int64 cols = y.shapeAt(y.ndim() - 1);
        int64 rows = y.size() / cols;
        if (g.isOnGpu()) {
            Ops.requireF32<E>("softmaxBack");
            Tensor<E> out #= Ewise.deviceLike<E>(g);
            Act.softmaxBackward<E>(out.deviceView("softmaxBack"), y.deviceView("softmaxBack"), g.deviceView("softmaxBack"), rows, cols, logForm);
            return #out;
        }
        Tensor<E> out #= y.copy();
        int64 r = 0;
        while (r < rows) {
            float64 tot = 0.0;
            int64 j = 0;
            while (j < cols) {
                float64 gv = (float64) g.flatGet(r * cols + j);
                if (logForm) { tot = tot + gv; } else { tot = tot + gv * (float64) y.flatGet(r * cols + j); }
                j = j + 1;
            }
            j = 0;
            while (j < cols) {
                float64 yv = (float64) y.flatGet(r * cols + j);
                float64 gv = (float64) g.flatGet(r * cols + j);
                float64 res = yv * (gv - tot);
                if (logForm) { res = gv - Math.exp(yv) * tot; }
                out.flatSet(r * cols + j, (E) res);
                j = j + 1;
            }
            r = r + 1;
        }
        return #out;
    }

    /** The max-along-axis VJP: the cotangent lands on the first maximum of each slice. */
    public static #Tensor<E> maxAxisBack<E extends Floating>(Tensor<E> x, Tensor<E> mx, Tensor<E> g, int32 axis) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("maxAxisBack");
            int32 nd = x.ndim();
            int32 ax = axis;
            if (ax < 0) { ax = ax + nd; }
            int64 outer = 1;
            int64 inner = 1;
            int32 d = 0;
            while (d < nd) {
                if (d < ax) { outer = outer * x.shapeAt(d); }
                if (d > ax) { inner = inner * x.shapeAt(d); }
                d = d + 1;
            }
            Tensor<E> out #= Ewise.deviceLike<E>(x);
            Reduce.alongAxisMaxBack<E>(out.deviceView("maxAxisBack"), x.deviceView("maxAxisBack"), mx.deviceView("maxAxisBack"),
                g.deviceView("maxAxisBack"), outer, x.shapeAt(ax), inner);
            return #out;
        }
        return Ops.maxAxisBackCpu<E>(x, mx, g);
    }

    /** The CPU column's rank-2 max VJP. */
    static #Tensor<E> maxAxisBackCpu<E extends Floating>(Tensor<E> x, Tensor<E> mx, Tensor<E> g) {
        Tensor<E> out #= Tensor.zerosLike<E>(x);
        if (x.ndim() != 2) {
            throw heap MlException("GradTape.maxAxis backward: rank-2 only in v3");
        }
        int64 rows = x.shapeAt(0);
        int64 cols = x.shapeAt(1);
        int64 r = 0;
        if (mx.shapeAt(1) == 1) {
            while (r < rows) {
                E target = mx.get2(r, 0);
                int64 jj = 0;
                while (jj < cols) {
                    if (x.get2(r, jj) == target) { out.flatSet(r * cols + jj, g.get2(r, 0)); jj = cols; } else { jj = jj + 1; }
                }
                r = r + 1;
            }
        } else {
            int64 jj = 0;
            while (jj < cols) {
                E target = mx.get2(0, jj);
                r = 0;
                while (r < rows) {
                    if (x.get2(r, jj) == target) { out.flatSet(r * cols + jj, g.get2(0, jj)); r = rows; } else { r = r + 1; }
                }
                jj = jj + 1;
            }
        }
        return #out;
    }

    /** The slice VJP: `g` scattered into zeros of `x`'s shape at `start` along `axis`. */
    public static #Tensor<E> sliceBack<E extends Floating>(Tensor<E> x, Tensor<E> g, int32 axis, int64 start) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("sliceBack");
            if (x.ndim() > 4) { throw heap MlException("ml.grad: 'sliceBack' on the device handles rank <= 4, got " + x.ndim()); }
            Tensor<E> out #= Ops.zerosLike<E>(x);
            int64[] dims #= Ops.shapeOf<E>(g);
            int64[] is #= Ops.contig(dims);
            int64[] xs #= Ops.shapeOf<E>(x);
            int64[] os #= Ops.contig(xs);
            Copy.stridedInto<E>(out.deviceView("sliceBack"), g.deviceView("sliceBack"), dims, is, os, 0L, start * os[axis]);
            return #out;
        }
        Tensor<E> out #= Tensor.zerosLike<E>(x);
        if (x.ndim() != 2) {
            throw heap MlException("GradTape.slice backward: rank-2 only in v3");
        }
        int64 gr = g.shapeAt(0);
        int64 gc = g.shapeAt(1);
        int64 cols = x.shapeAt(1);
        int64 r = 0;
        while (r < gr) {
            int64 j = 0;
            while (j < gc) {
                int64 rr = r;
                int64 cc = j;
                if (axis == 0) { rr = r + start; } else { cc = j + start; }
                out.flatSet(rr * cols + cc, g.get2(r, j));
                j = j + 1;
            }
            r = r + 1;
        }
        return #out;
    }

    /** Both batch-norm parameter VJPs on the device; `wantScale` picks dgamma (sum g*xhat) over dbeta (sum g). */
    static #Tensor<E> channelParamGradsGpu<E extends Floating>(Tensor<E> g, Tensor<E> xhat, boolean wantScale) {
        int64[] cs = [g.shapeAt(1)];
        Tensor<E> dgamma #= Ewise.deviceOf<E>(cs);
        Tensor<E> dbeta #= Ewise.deviceOf<E>(cs);
        BatchNorm.channelParamGrads<E>(dgamma.deviceView("batchNorm2d.backward"), dbeta.deviceView("batchNorm2d.backward"),
            g.deviceView("batchNorm2d.backward"), xhat.deviceView("batchNorm2d.backward"), g.shapeAt(0), g.shapeAt(1), g.shapeAt(2) * g.shapeAt(3));
        if (wantScale) { return #dgamma; }
        return #dbeta;
    }

    /** Both layernorm parameter VJPs on the device from x and the saved row statistics; `wantScale` picks dgamma over dbeta. */
    static #Tensor<E> layerParamGradsGpu<E extends Floating>(Tensor<E> g, Tensor<E> x, Tensor<E> mean, Tensor<E> invstd, boolean wantScale) {
        int64 d = g.shapeAt(g.ndim() - 1);
        int64[] ds = [d];
        Tensor<E> dw #= Ewise.deviceOf<E>(ds);
        Tensor<E> db #= Ewise.deviceOf<E>(ds);
        Norm.layerParamGrads<E>(dw.deviceView("layerNorm.backward"), db.deviceView("layerNorm.backward"),
            g.deviceView("layerNorm.backward"), x.deviceView("layerNorm.backward"), mean.deviceView("layerNorm.backward"),
            invstd.deviceView("layerNorm.backward"), g.size() / d, d);
        if (wantScale) { return #dw; }
        return #db;
    }

    /** C-order strides of `shape`. */
    static #int64[] contig(int64[] shape) {
        int32 nd = (int32) shape.count();
        int64[] st = heap int64[nd];
        int64 acc = 1;
        int32 d = nd - 1;
        while (d >= 0) { st[d] = acc; acc = acc * shape[d]; d = d - 1; }
        return #st;
    }

    static #int64[] shapeOf<E extends Floating>(Tensor<E> a) {
        int32 nd = a.ndim();
        int64[] sh = heap int64[nd];
        int32 d = 0;
        while (d < nd) { sh[d] = a.shapeAt(d); d = d + 1; }
        return #sh;
    }

    /** Axis permutation on the device through the strided copy (rank <= 4). */
    static #Tensor<E> permuteGpu<E extends Floating>(String name, Tensor<E> a, int32[] perm) {
        int32 nd = a.ndim();
        if (nd > 4) { throw heap MlException("ml.grad: '" + name + "' on the device handles rank <= 4, got " + nd); }
        int64[] inShape #= Ops.shapeOf<E>(a);
        int64[] inStrides #= Ops.contig(inShape);
        int64[] dims = heap int64[nd];
        int64[] is = heap int64[nd];
        int32 k = 0;
        while (k < nd) { dims[k] = inShape[perm[k]]; is[k] = inStrides[perm[k]]; k = k + 1; }
        int64[] os #= Ops.contig(dims);
        Tensor<E> out #= Ewise.deviceOf<E>(dims);
        Copy.stridedInto<E>(out.deviceView(name), a.deviceView(name), dims, is, os, 0L, 0L);
        return #out;
    }

    /** The binary GPU column. The arithmetic rides Tensor's own device routing. */
    static #Tensor<E> run2Gpu<E extends Floating>(int32 op, Tensor<E> a, Tensor<E> b) {
        String name #= Ops.name(op);
        Ops.requireF32<E>(name);
        if (op == Op.ADD) { return Tensor.add<E>(a, b); }
        if (op == Op.SUB) { return Tensor.sub<E>(a, b); }
        if (op == Op.MUL) { return Tensor.mul<E>(a, b); }
        if (op == Op.DIV) { return Tensor.div<E>(a, b); }
        if (op == Op.MATMUL) {
            int64 m = a.shapeAt(0);
            int64 k = a.shapeAt(1);
            int64 n = b.shapeAt(1);
            int64[] shp = [m, n];
            Tensor<E> out #= Ewise.deviceOf<E>(shp);
            Gemm.tiled<E>(out.deviceView(name), a.deviceView(name), b.deviceView(name), m, n, k);
            return #out;
        }
        if (op == Op.MATMULB) {
            if (Device.kernelAvailable("gemmTiled64Batched_float32")) { return Ops.matmulBatchedT<E>(a, b, false, false, 1.0f); }
            if (a.ndim() != 3 || b.ndim() != 3) {
                throw heap MlException("ml.grad: matmulBatched expects rank-3 inputs, got " + a.ndim() + " and " + b.ndim());
            }
            int64 batch = a.shapeAt(0);
            int64 m = a.shapeAt(1);
            int64 k = a.shapeAt(2);
            int64 n = b.shapeAt(2);
            int64[] shp = [batch, m, n];
            Tensor<E> out #= Ewise.deviceOf<E>(shp);
            Gemm.tiledBatched<E>(out.deviceView(name), a.deviceView(name), b.deviceView(name), m, n, k, batch);
            return #out;
        }
        throw heap MlException("ml.grad: '" + name + "' has no GPU kernel");
    }

    /** Binary dispatch. */
    public static #Tensor<E> run2<E extends Floating>(int32 op, Tensor<E> a,
                                                      Tensor<E> b) {
        Ops.requireSame<E>(Ops.name(op), a, b);
        if (a.isOnGpu()) {
            if (!Ops.hasGpu(op)) { Ops.requireCpu<E>(Ops.name(op), a); }
            return Ops.run2Gpu<E>(op, a, b);
        }
        if (op == Op.ADD)    { return Tensor.add<E>(a, b); }
        if (op == Op.SUB)    { return Tensor.sub<E>(a, b); }
        if (op == Op.MUL)    { return Tensor.mul<E>(a, b); }
        if (op == Op.DIV)    { return Ops.divK<E>(a, b); }
        if (op == Op.MATMUL) { return Tensor.matmul<E>(a, b); }
        if (op == Op.MATMULB) { return StructKernels.matmulBatched3<E>(a, b); }
        throw heap MlException("ml.grad: unknown binary op " + op);
    }

    /**
     * Reshape as a view of `a`'s storage when `a` is a contiguous device tensor, else
     * {@link #reshape}. The view borrows: it must not outlive `a`, which a local does not
     * guarantee (sumTo rebinds a local to a reshape of a temporary), so only the tape's
     * reshape node uses it, where `a` is a tape value or a processed node's cotangent and
     * lives as long as the tape (cajeta-ml-gpu 28.2.8).
     */
    public static #Tensor<E> reshapeView<E extends Floating>(Tensor<E> a, int64[] newShape) {
        if (a.isOnGpu() && a.isContiguous()) {
            Ops.requireF32<E>("reshape");
            Tensor<E> vw #= a.reshape(newShape);
            return #vw;
        }
        Tensor<E> r #= Ops.reshape<E>(a, newShape);
        return #r;
    }

    /** Reshape, materialized (records nothing: the tape keeps the input shape). */
    public static #Tensor<E> reshape<E extends Floating>(Tensor<E> a, int64[] newShape) {
        if (a.isOnGpu()) {
            Ops.requireF32<E>("reshape");
            Tensor<E> dv #= Ewise.deviceOf<E>(newShape);
            Copy.into<E>(dv.deviceView("reshape"), a.deviceView("reshape"), a.size());
            return #dv;
        }
        Tensor<E> vw #= a.reshape(newShape);
        Tensor<E> out #= vw.copy();
        return #out;
    }

    /** Slice `[start, stop)` along `axis`, materialized. */
    public static #Tensor<E> slice<E extends Floating>(Tensor<E> a, int32 axis, int64 start, int64 stop) {
        if (a.isOnGpu()) {
            Ops.requireF32<E>("slice");
            if (a.ndim() > 4) { throw heap MlException("ml.grad: 'slice' on the device handles rank <= 4, got " + a.ndim()); }
            int64[] dims #= Ops.shapeOf<E>(a);
            int64[] is #= Ops.contig(dims);
            dims[axis] = stop - start;
            int64[] os #= Ops.contig(dims);
            Tensor<E> dv #= Ewise.deviceOf<E>(dims);
            Copy.stridedInto<E>(dv.deviceView("slice"), a.deviceView("slice"), dims, is, os, start * is[axis], 0L);
            return #dv;
        }
        Tensor<E> vw #= a.slice(axis, start, stop);
        Tensor<E> out #= vw.copy();
        return #out;
    }

    /** Concatenate two tensors along `axis`. */
    public static #Tensor<E> concat<E extends Floating>(Tensor<E> a, Tensor<E> b, int32 axis) {
        Ops.requireSame<E>("concat", a, b);
        if (a.isOnGpu()) {
            Ops.requireF32<E>("concat");
            int32 nd = a.ndim();
            if (nd > 4) { throw heap MlException("ml.grad: 'concat' on the device handles rank <= 4, got " + nd); }
            int32 ax = axis;
            if (ax < 0) { ax = ax + nd; }
            int64[] da #= Ops.shapeOf<E>(a);
            int64[] db #= Ops.shapeOf<E>(b);
            int64[] outShape #= Ops.shapeOf<E>(a);
            outShape[ax] = da[ax] + db[ax];
            int64[] os #= Ops.contig(outShape);
            int64[] isa #= Ops.contig(da);
            int64[] isb #= Ops.contig(db);
            Tensor<E> dv #= Ewise.deviceOf<E>(outShape);
            Copy.stridedInto<E>(dv.deviceView("concat"), a.deviceView("concat"), da, isa, os, 0L, 0L);
            Copy.stridedInto<E>(dv.deviceView("concat"), b.deviceView("concat"), db, isb, os, 0L, da[ax] * os[ax]);
            return #dv;
        }
        Tensor<E>[] parts = heap Tensor<E>[2];
        parts[0] = a;
        parts[1] = b;
        return Tensor.concatenate<E>(parts, axis);
    }

    /** Permute a tensor's axes (rank <= 4), materialized — the permuted
     *  result is a view over the source's storage, which a tape node must
     *  not alias. */
    public static #Tensor<E> permute<E extends Floating>(Tensor<E> a, int32[] perm) {
        if (a.isOnGpu()) { Ops.requireF32<E>("permute"); return Ops.permuteGpu<E>("permute", a, perm); }
        Tensor<E> vw #= a.transposeAxes(perm);
        Tensor<E> out #= vw.copy();
        return #out;
    }

    /** Swap the last two axes of a rank-3 tensor, materialized (the
     *  permuted result is a view over the source's storage, which a tape
     *  node must not alias). */
    public static #Tensor<E> transposeLast2<E extends Floating>(Tensor<E> a) {
        if (a.ndim() != 3) {
            throw heap MlException("ml.grad: transposeBatch expects rank 3, "
                + "got " + a.ndim());
        }
        int32[] perm = heap int32[3];
        perm[0] = 0;
        perm[1] = 2;
        perm[2] = 1;
        if (a.isOnGpu()) { Ops.requireF32<E>("transposeBatch"); return Ops.permuteGpu<E>("transposeBatch", a, perm); }
        Tensor<E> vw #= a.transposeAxes(perm);
        Tensor<E> out #= vw.copy();
        return #out;
    }

    // ── Structured-op dispatch (U3) ────────────────────────────────────
    //
    // The structured ops carry too much configuration for run1/run2's
    // (axis, scalar) payload, so each gets its own seam entry. Both
    // DIRECTIONS route through here — a GPU column has to replace the
    // backward kernels too, and a backward that reached StructKernels
    // directly would be a hole in the contract.

    public static #Tensor<E> conv2d<E extends Floating>(Tensor<E> x, Tensor<E> w,
                                                        Tensor<E> b, int32 stride,
                                                        int32 pad) {
        Ops.requireSame<E>("conv2d", x, w);
        Ops.requireSame<E>("conv2d", x, b);
        if (x.isOnGpu()) {
            Ops.requireF32<E>("conv2d");
            int64 n = x.shapeAt(0);
            int64 c = x.shapeAt(1);
            int64 h = x.shapeAt(2);
            int64 wd = x.shapeAt(3);
            int64 oc = w.shapeAt(0);
            int64 kh = w.shapeAt(2);
            int64 kw = w.shapeAt(3);
            if (w.shapeAt(1) != c) {
                throw heap MlException("ml.grad: conv2d channel mismatch — input has " + c + ", weight expects " + w.shapeAt(1));
            }
            int64 oh = StructKernels.outExtent(h, (int32) kh, stride, pad);
            int64 ow = StructKernels.outExtent(wd, (int32) kw, stride, pad);
            int64[] osh = [n, oc, oh, ow];
            Tensor<E> out #= Ewise.deviceOf<E>(osh);
            Conv.forward<E>(out.deviceView("conv2d"), x.deviceView("conv2d"), w.deviceView("conv2d"), b.deviceView("conv2d"),
                n, c, h, wd, oc, kh, kw, oh, ow, stride, pad);
            return #out;
        }
        return StructKernels.conv2d<E>(x, w, b, stride, pad);
    }

    public static #Tensor<E> conv2dBackIn<E extends Floating>(Tensor<E> g, Tensor<E> x,
                                                              Tensor<E> w, int32 stride,
                                                              int32 pad) {
        Ops.requireSame<E>("conv2d.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("conv2d.backward");
            Tensor<E> dx #= Ewise.deviceLike<E>(x);
            Conv.backwardInput<E>(dx.deviceView("conv2d.backward"), g.deviceView("conv2d.backward"), w.deviceView("conv2d.backward"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), w.shapeAt(0), w.shapeAt(2), w.shapeAt(3), g.shapeAt(2), g.shapeAt(3), stride, pad);
            return #dx;
        }
        return StructKernels.conv2dBackIn<E>(g, x, w, stride, pad);
    }

    public static #Tensor<E> conv2dBackWeight<E extends Floating>(Tensor<E> g,
                                                                  Tensor<E> x,
                                                                  Tensor<E> w,
                                                                  int32 stride,
                                                                  int32 pad) {
        Ops.requireSame<E>("conv2d.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("conv2d.backward");
            Tensor<E> dw #= Ewise.deviceLike<E>(w);
            Conv.backwardWeight<E>(dw.deviceView("conv2d.backward"), g.deviceView("conv2d.backward"), x.deviceView("conv2d.backward"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), w.shapeAt(0), w.shapeAt(2), w.shapeAt(3), g.shapeAt(2), g.shapeAt(3), stride, pad);
            return #dw;
        }
        return StructKernels.conv2dBackWeight<E>(g, x, w, stride, pad);
    }

    public static #Tensor<E> conv2dBackBias<E extends Floating>(Tensor<E> g) {
        if (g.isOnGpu()) {
            Ops.requireF32<E>("conv2d.backward");
            // sum over the plane, then over the batch: (n, oc, ohw) -> (n, oc, 1) -> (1, oc, 1) -> (oc)
            int64[] s3 = [g.shapeAt(0), g.shapeAt(1), g.shapeAt(2) * g.shapeAt(3)];
            Tensor<E> g3 #= Ops.reshape<E>(g, s3);
            Tensor<E> r1 #= Ops.reduceAxisGpu<E>("conv2d.backward", g3, 2, Reduce.SUM);
            Tensor<E> r2 #= Ops.reduceAxisGpu<E>("conv2d.backward", r1, 0, Reduce.SUM);
            int64[] s1 = [g.shapeAt(1)];
            return Ops.reshape<E>(r2, s1);
        }
        return StructKernels.conv2dBackBias<E>(g);
    }

    public static #Tensor<E> maxPool2d<E extends Floating>(Tensor<E> x, int32 k,
                                                           int32 stride, int32 pad,
                                                           Tensor<E> argmax) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("maxPool2d");
            Ops.requireSame<E>("maxPool2d", x, argmax);
            int64[] osh #= Ops.poolShape<E>(x, k, stride, pad);
            Tensor<E> out #= Ewise.deviceOf<E>(osh);
            Pool.max<E>(out.deviceView("maxPool2d"), argmax.deviceView("maxPool2d"), x.deviceView("maxPool2d"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), osh[2], osh[3], k, stride, pad);
            return #out;
        }
        return StructKernels.maxPool2d<E>(x, k, stride, pad, argmax);
    }

    public static #Tensor<E> maxPool2dBack<E extends Floating>(Tensor<E> g, Tensor<E> x,
                                                               Tensor<E> argmax, int32 k,
                                                               int32 stride, int32 pad) {
        Ops.requireSame<E>("maxPool2d.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("maxPool2d.backward");
            Tensor<E> dx #= Ewise.deviceLike<E>(x);
            Pool.maxBackward<E>(dx.deviceView("maxPool2d.backward"), g.deviceView("maxPool2d.backward"), argmax.deviceView("maxPool2d.backward"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), g.shapeAt(2), g.shapeAt(3), k, stride, pad);
            return #dx;
        }
        return StructKernels.maxPool2dBack<E>(g, x, argmax);
    }

    public static #Tensor<E> avgPool2d<E extends Floating>(Tensor<E> x, int32 k,
                                                           int32 stride, int32 pad) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("avgPool2d");
            int64[] osh #= Ops.poolShape<E>(x, k, stride, pad);
            Tensor<E> out #= Ewise.deviceOf<E>(osh);
            Pool.avg<E>(out.deviceView("avgPool2d"), x.deviceView("avgPool2d"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), osh[2], osh[3], k, stride, pad);
            return #out;
        }
        return StructKernels.avgPool2d<E>(x, k, stride, pad);
    }

    public static #Tensor<E> avgPool2dBack<E extends Floating>(Tensor<E> g, Tensor<E> x,
                                                               int32 k, int32 stride,
                                                               int32 pad) {
        Ops.requireSame<E>("avgPool2d.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("avgPool2d.backward");
            Tensor<E> dx #= Ewise.deviceLike<E>(x);
            Pool.avgBackward<E>(dx.deviceView("avgPool2d.backward"), g.deviceView("avgPool2d.backward"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), g.shapeAt(2), g.shapeAt(3), k, stride, pad);
            return #dx;
        }
        return StructKernels.avgPool2dBack<E>(g, x, k, stride, pad);
    }

    public static #Tensor<E> adaptiveAvgPool2d<E extends Floating>(Tensor<E> x,
                                                                   int32 outH,
                                                                   int32 outW) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("adaptiveAvgPool2d");
            int64[] osh = [x.shapeAt(0), x.shapeAt(1), (int64) outH, (int64) outW];
            Tensor<E> out #= Ewise.deviceOf<E>(osh);
            Pool.adaptive<E>(out.deviceView("adaptiveAvgPool2d"), x.deviceView("adaptiveAvgPool2d"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), osh[2], osh[3]);
            return #out;
        }
        return StructKernels.adaptiveAvgPool2d<E>(x, outH, outW);
    }

    public static #Tensor<E> adaptiveAvgPool2dBack<E extends Floating>(Tensor<E> g,
                                                                       Tensor<E> x) {
        Ops.requireSame<E>("adaptiveAvgPool2d.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("adaptiveAvgPool2d.backward");
            Tensor<E> dx #= Ewise.deviceLike<E>(x);
            Pool.adaptiveBackward<E>(dx.deviceView("adaptiveAvgPool2d.backward"), g.deviceView("adaptiveAvgPool2d.backward"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2), x.shapeAt(3), g.shapeAt(2), g.shapeAt(3));
            return #dx;
        }
        return StructKernels.adaptiveAvgPool2dBack<E>(g, x);
    }

    public static #Tensor<E> channelMean<E extends Floating>(Tensor<E> x) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d");
            Tensor<E> mean #= Ops.channelStatsGpu<E>(x, true);
            return #mean;
        }
        return StructKernels.channelMean<E>(x);
    }

    /** Both channel statistics on the device; `wantMean` picks which one is returned. */
    static #Tensor<E> channelStatsGpu<E extends Floating>(Tensor<E> x, boolean wantMean) {
        int64[] cs = [x.shapeAt(1)];
        Tensor<E> mean #= Ewise.deviceOf<E>(cs);
        Tensor<E> var #= Ewise.deviceOf<E>(cs);
        BatchNorm.channelStats<E>(mean.deviceView("batchNorm2d"), var.deviceView("batchNorm2d"), x.deviceView("batchNorm2d"),
            x.shapeAt(0), x.shapeAt(1), x.shapeAt(2) * x.shapeAt(3));
        if (wantMean) { return #mean; }
        return #var;
    }

    /** The pooled NCHW shape for a k/stride/pad window over `x`. */
    static #int64[] poolShape<E extends Floating>(Tensor<E> x, int32 k, int32 stride, int32 pad) {
        int64[] osh = [x.shapeAt(0), x.shapeAt(1),
                       StructKernels.outExtent(x.shapeAt(2), k, stride, pad),
                       StructKernels.outExtent(x.shapeAt(3), k, stride, pad)];
        return #osh;
    }

    public static #Tensor<E> channelVar<E extends Floating>(Tensor<E> x, Tensor<E> mean) {
        Ops.requireSame<E>("batchNorm2d", x, mean);
        if (x.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d");
            Tensor<E> var #= Ops.channelStatsGpu<E>(x, false);
            return #var;
        }
        return StructKernels.channelVar<E>(x, mean);
    }

    public static #Tensor<E> batchNorm2d<E extends Floating>(Tensor<E> x, Tensor<E> gamma,
                                                             Tensor<E> beta,
                                                             Tensor<E> mean, Tensor<E> var,
                                                             float64 eps, Tensor<E> xhat,
                                                             Tensor<E> invstd) {
        Ops.requireSame<E>("batchNorm2d", x, gamma);
        Ops.requireSame<E>("batchNorm2d", x, beta);
        Ops.requireSame<E>("batchNorm2d", x, mean);
        Ops.requireSame<E>("batchNorm2d", x, xhat);
        if (x.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d");
            Tensor<E> out #= Ewise.deviceLike<E>(x);
            BatchNorm.apply<E>(out.deviceView("batchNorm2d"), xhat.deviceView("batchNorm2d"), invstd.deviceView("batchNorm2d"),
                x.deviceView("batchNorm2d"), gamma.deviceView("batchNorm2d"), beta.deviceView("batchNorm2d"),
                mean.deviceView("batchNorm2d"), var.deviceView("batchNorm2d"),
                x.shapeAt(0), x.shapeAt(1), x.shapeAt(2) * x.shapeAt(3), (float32) eps);
            return #out;
        }
        return StructKernels.batchNorm2d<E>(x, gamma, beta, mean, var, eps, xhat, invstd);
    }

    public static #Tensor<E> batchNorm2dBackIn<E extends Floating>(Tensor<E> g,
                                                                   Tensor<E> xhat,
                                                                   Tensor<E> gamma,
                                                                   Tensor<E> invstd,
                                                                   boolean training) {
        Ops.requireSame<E>("batchNorm2d.backward", g, xhat);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d.backward");
            int64 n = g.shapeAt(0);
            int64 c = g.shapeAt(1);
            int64 hw = g.shapeAt(2) * g.shapeAt(3);
            int64[] cs = [c];
            Tensor<E> dgamma #= Ewise.deviceOf<E>(cs);
            Tensor<E> dbeta #= Ewise.deviceOf<E>(cs);
            BatchNorm.channelParamGrads<E>(dgamma.deviceView("batchNorm2d.backward"), dbeta.deviceView("batchNorm2d.backward"),
                g.deviceView("batchNorm2d.backward"), xhat.deviceView("batchNorm2d.backward"), n, c, hw);
            Tensor<E> dx #= Ewise.deviceLike<E>(g);
            BatchNorm.backwardInput<E>(dx.deviceView("batchNorm2d.backward"), g.deviceView("batchNorm2d.backward"), xhat.deviceView("batchNorm2d.backward"),
                gamma.deviceView("batchNorm2d.backward"), invstd.deviceView("batchNorm2d.backward"),
                dgamma.deviceView("batchNorm2d.backward"), dbeta.deviceView("batchNorm2d.backward"), n, c, hw, training);
            return #dx;
        }
        return StructKernels.batchNorm2dBackIn<E>(g, xhat, gamma, invstd, training);
    }

    public static #Tensor<E> normBackScale<E extends Floating>(Tensor<E> g, Tensor<E> xhat) {
        Ops.requireSame<E>("batchNorm2d.backward", g, xhat);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d.backward");
            Tensor<E> dgamma #= Ops.channelParamGradsGpu<E>(g, xhat, true);
            return #dgamma;
        }
        return StructKernels.normBackScale<E>(g, xhat);
    }

    public static #Tensor<E> normBackShift<E extends Floating>(Tensor<E> g) {
        if (g.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d.backward");
            Tensor<E> dbeta #= Ops.channelParamGradsGpu<E>(g, g, false);
            return #dbeta;
        }
        return StructKernels.normBackShift<E>(g);
    }

    /** In-place running-stat update for the module layer's BatchNorm2d.
     *  Not a tape op — running statistics are module state, updated
     *  alongside a training forward, never differentiated. */
    public static void updateRunningStats<E extends Floating>(Tensor<E> runningMean,
                                                              Tensor<E> runningVar,
                                                              Tensor<E> batchMean,
                                                              Tensor<E> batchVar,
                                                              int64 count,
                                                              float64 momentum) {
        Ops.requireSame<E>("batchNorm2d.runningStats", runningMean, batchMean);
        if (runningMean.isOnGpu()) {
            Ops.requireF32<E>("batchNorm2d.runningStats");
            float64 unbiased = 1.0;
            if (count > 1) { unbiased = (float64) count / (float64) (count - 1); }
            Ops.blendInto<E>(runningMean, batchMean, momentum, 1.0);
            Ops.blendInto<E>(runningVar, batchVar, momentum, unbiased);
            return;
        }
        StructKernels.updateRunningStats<E>(runningMean, runningVar, batchMean,
                                            batchVar, count, momentum);
        return;
    }

    /** Layer norm over the last axis; `mean` and `invstd` (one per row) receive the backward's saved statistics. */
    public static #Tensor<E> layerNorm<E extends Floating>(Tensor<E> x, Tensor<E> gamma,
                                                           Tensor<E> beta, float64 eps,
                                                           Tensor<E> mean,
                                                           Tensor<E> invstd) {
        Ops.requireSame<E>("layerNorm", x, gamma);
        Ops.requireSame<E>("layerNorm", x, beta);
        Ops.requireSame<E>("layerNorm", x, mean);
        if (x.isOnGpu()) {
            Ops.requireF32<E>("layerNorm");
            int64 d = x.shapeAt(x.ndim() - 1);
            int64 rows = x.size() / d;
            Tensor<E> out #= Ewise.deviceLike<E>(x);
            Norm.layerSaved<E>(out.deviceView("layerNorm"), mean.deviceView("layerNorm"), invstd.deviceView("layerNorm"),
                x.deviceView("layerNorm"), gamma.deviceView("layerNorm"), beta.deviceView("layerNorm"), rows, d, (float32) eps);
            return #out;
        }
        return StructKernels.layerNorm<E>(x, gamma, beta, eps, mean, invstd);
    }

    /** dL/dx of layerNorm from the forward's input and its saved row statistics. */
    public static #Tensor<E> layerNormBackIn<E extends Floating>(Tensor<E> g,
                                                                 Tensor<E> x,
                                                                 Tensor<E> gamma,
                                                                 Tensor<E> mean,
                                                                 Tensor<E> invstd) {
        Ops.requireSame<E>("layerNorm.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("layerNorm.backward");
            int64 d = g.shapeAt(g.ndim() - 1);
            Tensor<E> dx #= Ewise.deviceLike<E>(g);
            Norm.layerBack<E>(dx.deviceView("layerNorm.backward"), g.deviceView("layerNorm.backward"), x.deviceView("layerNorm.backward"),
                gamma.deviceView("layerNorm.backward"), mean.deviceView("layerNorm.backward"), invstd.deviceView("layerNorm.backward"),
                g.size() / d, d);
            return #dx;
        }
        return StructKernels.layerNormBackIn<E>(g, x, gamma, mean, invstd);
    }

    /** dL/dgamma of layerNorm from the forward's input and its saved row statistics. */
    public static #Tensor<E> layerNormBackScale<E extends Floating>(Tensor<E> g,
                                                                    Tensor<E> x,
                                                                    Tensor<E> mean,
                                                                    Tensor<E> invstd) {
        Ops.requireSame<E>("layerNorm.backward", g, x);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("layerNorm.backward");
            Tensor<E> dw #= Ops.layerParamGradsGpu<E>(g, x, mean, invstd, true);
            return #dw;
        }
        return StructKernels.layerNormBackScale<E>(g, x, mean, invstd);
    }

    public static #Tensor<E> layerNormBackShift<E extends Floating>(Tensor<E> g) {
        if (g.isOnGpu()) {
            Ops.requireF32<E>("layerNorm.backward");
            Tensor<E> db #= Ops.layerParamGradsGpu<E>(g, g, g, g, false);
            return #db;
        }
        return StructKernels.layerNormBackShift<E>(g);
    }

    public static #Tensor<E> embedding<E extends Floating>(Tensor<E> w, Tensor<E> idx) {
        Ops.requireSame<E>("embedding", w, idx);
        if (w.isOnGpu()) {
            Ops.requireF32<E>("embedding");
            int64 rows = idx.size();
            int64[] osh = [rows, w.shapeAt(1)];
            Tensor<E> out #= Ewise.deviceOf<E>(osh);
            Embed.rowsAt<E>(out.deviceView("embedding"), w.deviceView("embedding"), idx.deviceView("embedding"), rows, w.shapeAt(1), w.shapeAt(0));
            return #out;
        }
        return StructKernels.embedding<E>(w, idx);
    }

    public static #Tensor<E> embeddingBack<E extends Floating>(Tensor<E> g, Tensor<E> w,
                                                               Tensor<E> idx) {
        Ops.requireSame<E>("embedding.backward", g, w);
        if (g.isOnGpu()) {
            Ops.requireF32<E>("embedding.backward");
            Tensor<E> dw #= Ewise.deviceLike<E>(w);
            Embed.scatterRows<E>(dw.deviceView("embedding.backward"), g.deviceView("embedding.backward"), idx.deviceView("embedding.backward"),
                w.shapeAt(0), w.shapeAt(1), idx.size());
            return #dw;
        }
        return StructKernels.embeddingBack<E>(g, w, idx);
    }

    public static #Tensor<E> dropout<E extends Floating>(Tensor<E> x, float64 p,
                                                         boolean training, uint64 seed,
                                                         Tensor<E> mask) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("dropout");
            Ops.requireSame<E>("dropout", x, mask);
            int64 n = x.size();
            if (!training || p <= 0.0) {
                Fill.with<E>(mask.deviceView("dropout"), n, (E) 1);
                return Ops.copyOf<E>(x);
            }
            if (p >= 1.0) { throw heap MlException("ml.grad: dropout p must be < 1 (got " + p + ")"); }
            Tensor<E> out #= Ewise.deviceLike<E>(x);
            Dropout.apply<E>(out.deviceView("dropout"), mask.deviceView("dropout"), x.deviceView("dropout"), n, (float32) p, seed);
            return #out;
        }
        return StructKernels.dropout<E>(x, p, training, seed, mask);
    }

    /** Mean softmax cross-entropy of `logits` against class ids; `lse` (one per row) receives each row's log-sum-exp, the backward's saved state. */
    public static #Tensor<E> crossEntropy<E extends Floating>(Tensor<E> logits,
                                                              Tensor<E> targets,
                                                              Tensor<E> lse) {
        Ops.requireSame<E>("crossEntropy", logits, targets);
        Ops.requireSame<E>("crossEntropy", logits, lse);
        if (logits.isOnGpu()) {
            Ops.requireF32<E>("crossEntropy");
            int64 cls = logits.shapeAt(logits.ndim() - 1);
            int64 rows = logits.size() / cls;
            int64[] rs = [rows];
            int64[] sh = [1];
            Tensor<E> rowLoss #= Ewise.deviceOf<E>(rs);
            Tensor<E> out #= Ewise.deviceOf<E>(sh);
            Act.crossEntropyRows<E>(lse.deviceView("crossEntropy"), rowLoss.deviceView("crossEntropy"), logits.deviceView("crossEntropy"), targets.deviceView("crossEntropy"), rows, cls);
            Loss.meanOf<E>(out.deviceView("crossEntropy"), rowLoss.deviceView("crossEntropy"), rows);
            KernelStream s #= KernelStream.current();
            s.sync();
            return #out;
        }
        return StructKernels.crossEntropy<E>(logits, targets, lse);
    }

    /** dL/dlogits from the logits, their saved row log-sum-exp and the scalar cotangent. */
    public static #Tensor<E> crossEntropyBack<E extends Floating>(Tensor<E> g,
                                                                  Tensor<E> logits,
                                                                  Tensor<E> lse,
                                                                  Tensor<E> targets) {
        if (g.isOnGpu()) {
            Ops.requireF32<E>("crossEntropy.backward");
            int64 cls = logits.shapeAt(logits.ndim() - 1);
            int64 rows = logits.size() / cls;
            Tensor<E> dx #= Ewise.deviceLike<E>(logits);
            Loss.nllBackward<E>(dx.deviceView("crossEntropy.backward"), logits.deviceView("crossEntropy.backward"), lse.deviceView("crossEntropy.backward"),
                targets.deviceView("crossEntropy.backward"), g.deviceView("crossEntropy.backward"), rows, cls);
            return #dx;
        }
        return StructKernels.crossEntropyBack<E>(g, logits, lse, targets);
    }

    public static #Tensor<E> mseLoss<E extends Floating>(Tensor<E> pred, Tensor<E> target) {
        Ops.requireSame<E>("mseLoss", pred, target);
        if (pred.isOnGpu()) {
            Ops.requireF32<E>("mseLoss");
            int64 n = pred.size();
            if (target.size() != n) {
                throw heap MlException("ml.grad: mseLoss shape mismatch — prediction has " + n
                    + " elements, target has " + target.size() + " (a head emitting k outputs needs a k-wide target)");
            }
            int64[] ps #= Ops.shapeOf<E>(pred);
            Tensor<E> tv #= Ops.reshape<E>(target, ps);
            Tensor<E> diff #= Tensor.sub<E>(pred, tv);
            Tensor<E> sq #= Tensor.mul<E>(diff, diff);
            return Ops.reduceAllGpu<E>("mseLoss", sq, true);
        }
        return StructKernels.mseLoss<E>(pred, target);
    }

    public static #Tensor<E> mseLossBack<E extends Floating>(Tensor<E> g, Tensor<E> pred,
                                                             Tensor<E> target,
                                                             boolean wantPred) {
        Ops.requireSame<E>("mseLoss.backward", pred, target);
        if (pred.isOnGpu()) {
            Ops.requireF32<E>("mseLoss.backward");
            int64 n = pred.size();
            int64[] ps #= Ops.shapeOf<E>(pred);
            Tensor<E> tv #= Ops.reshape<E>(target, ps);
            Tensor<E> diff #= Tensor.sub<E>(pred, tv);
            Tensor<E> gb #= Ops.broadcastCopy<E>(g, ps);
            Tensor<E> prod #= Tensor.mul<E>(diff, gb);
            E f = (E) 2 / (E) n;
            if (!wantPred) { f = (E) 0 - f; }
            return Ops.scale<E>(prod, f);
        }
        return StructKernels.mseLossBack<E>(g, pred, target, wantPred);
    }

    public static #Tensor<E> cosineSim<E extends Floating>(Tensor<E> a, Tensor<E> b,
                                                           float64 eps, Tensor<E> cache) {
        Ops.requireSame<E>("cosineSim", a, b);
        if (a.isOnGpu()) {
            Ops.requireF32<E>("cosineSim");
            Ops.requireSame<E>("cosineSim", a, cache);
            int64 d = a.shapeAt(a.ndim() - 1);
            int64 rows = a.size() / d;
            int64[] rs = [rows];
            Tensor<E> out #= Ewise.deviceOf<E>(rs);
            Loss.cosineRows<E>(out.deviceView("cosineSim"), cache.deviceView("cosineSim"), a.deviceView("cosineSim"), b.deviceView("cosineSim"), rows, d, (float32) eps);
            return #out;
        }
        return StructKernels.cosineSim<E>(a, b, eps, cache);
    }

    public static #Tensor<E> cosineSimBack<E extends Floating>(Tensor<E> g, Tensor<E> a,
                                                               Tensor<E> b, Tensor<E> cache,
                                                               float64 eps, boolean wantA) {
        Ops.requireSame<E>("cosineSim.backward", a, b);
        if (a.isOnGpu()) {
            Ops.requireF32<E>("cosineSim.backward");
            int64 d = a.shapeAt(a.ndim() - 1);
            Tensor<E> src = a;
            Tensor<E> other = b;
            if (!wantA) { src = b; other = a; }
            Tensor<E> dsrc #= Ewise.deviceLike<E>(src);
            Loss.cosineBackward<E>(dsrc.deviceView("cosineSim.backward"), g.deviceView("cosineSim.backward"), src.deviceView("cosineSim.backward"),
                other.deviceView("cosineSim.backward"), cache.deviceView("cosineSim.backward"), a.size() / d, d, (float32) eps, wantA);
            return #dsrc;
        }
        return StructKernels.cosineSimBack<E>(g, a, b, cache, eps, wantA);
    }

    public static #String name(int32 op) {
        if (op == Op.ADD) { return "add"; }
        if (op == Op.SUB) { return "sub"; }
        if (op == Op.MUL) { return "mul"; }
        if (op == Op.DIV) { return "div"; }
        if (op == Op.MATMUL) { return "matmul"; }
        if (op == Op.RELU) { return "relu"; }
        if (op == Op.GELU) { return "gelu"; }
        if (op == Op.TANH) { return "tanh"; }
        if (op == Op.SIGMOID) { return "sigmoid"; }
        if (op == Op.SOFTMAX) { return "softmax"; }
        if (op == Op.LOGSOFTMAX) { return "logSoftmax"; }
        if (op == Op.EXP) { return "exp"; }
        if (op == Op.LOG) { return "log"; }
        if (op == Op.SQRT) { return "sqrt"; }
        if (op == Op.POWS) { return "powScalar"; }
        if (op == Op.SUM) { return "sum"; }
        if (op == Op.MEAN) { return "mean"; }
        if (op == Op.SUMAXIS) { return "sumAxis"; }
        if (op == Op.MEANAXIS) { return "meanAxis"; }
        if (op == Op.MAXAXIS) { return "maxAxis"; }
        if (op == Op.RESHAPE) { return "reshape"; }
        if (op == Op.TRANSPOSE) { return "transpose"; }
        if (op == Op.SLICE) { return "slice"; }
        if (op == Op.CONCAT) { return "concat"; }
        if (op == Op.NEG) { return "neg"; }
        if (op == Op.CONV2D) { return "conv2d"; }
        if (op == Op.MAXPOOL2D) { return "maxPool2d"; }
        if (op == Op.AVGPOOL2D) { return "avgPool2d"; }
        if (op == Op.ADAPTAVGPOOL2D) { return "adaptiveAvgPool2d"; }
        if (op == Op.BATCHNORM2D) { return "batchNorm2d"; }
        if (op == Op.LAYERNORM) { return "layerNorm"; }
        if (op == Op.EMBEDDING) { return "embedding"; }
        if (op == Op.DROPOUT) { return "dropout"; }
        if (op == Op.CROSSENTROPY) { return "crossEntropy"; }
        if (op == Op.MSELOSS) { return "mseLoss"; }
        if (op == Op.COSINESIM) { return "cosineSim"; }
        if (op == Op.MATMULB) { return "matmulBatched"; }
        if (op == Op.TRANSPOSEB) { return "transposeBatch"; }
        if (op == Op.PERMUTE) { return "permute"; }
        if (op == Op.ROWNORM) { return "rowNorm"; }
        if (op == Op.LINEAR) { return "linear"; }
        return "op" + op;
    }

    /** Scale each row to unit L2 norm over the last axis (torch's
     *  `F.normalize(x, p=2, dim=-1)`), with an epsilon floor so an
     *  all-zero row maps to zeros rather than NaN. */
    static #Tensor<E> rowNormK<E extends Floating>(Tensor<E> a) {
        Tensor<E> out #= a.copy();
        int64 cols = out.shapeAt(out.ndim() - 1);
        int64 rows = Ops.countOf<E>(out) / cols;
        int64 r = 0;
        while (r < rows) {
            float64 sq = 0.0;
            int64 j = 0;
            while (j < cols) {
                float64 v = (float64) out.flatGet(r * cols + j);
                sq = sq + v * v;
                j = j + 1;
            }
            float64 nrm = Math.sqrt(sq);
            if (nrm < 0.00000001) { nrm = 0.00000001; }
            j = 0;
            while (j < cols) {
                float64 sv = (float64) out.flatGet(r * cols + j) / nrm;
                out.flatSet(r * cols + j, (E) sv);
                j = j + 1;
            }
            r = r + 1;
        }
        return #out;
    }

    /** rowNorm VJP: dx = (g − y·⟨g, y⟩)/‖x‖, with `y` the normalized
     *  output — the projection of the cotangent onto the tangent space of
     *  the unit sphere, which is what keeps a normalized activation from
     *  receiving a gradient component that would only change its length. */
    static #Tensor<E> rowNormBack<E extends Floating>(Tensor<E> x, Tensor<E> y,
                                                      Tensor<E> g) {
        if (x.isOnGpu()) {
            Ops.requireF32<E>("rowNormBack");
            int64 cols = x.shapeAt(x.ndim() - 1);
            Tensor<E> dv #= Ewise.deviceLike<E>(x);
            Norm.l2rowsBack<E>(dv.deviceView("rowNormBack"), x.deviceView("rowNormBack"), y.deviceView("rowNormBack"), g.deviceView("rowNormBack"),
                x.size() / cols, cols, 0.00000001f);
            return #dv;
        }
        Tensor<E> out #= x.copy();
        int64 cols = x.shapeAt(x.ndim() - 1);
        int64 rows = Ops.countOf<E>(x) / cols;
        int64 r = 0;
        while (r < rows) {
            float64 sq = 0.0;
            float64 dot = 0.0;
            int64 j = 0;
            while (j < cols) {
                float64 xv = (float64) x.flatGet(r * cols + j);
                sq = sq + xv * xv;
                dot = dot + (float64) g.flatGet(r * cols + j)
                          * (float64) y.flatGet(r * cols + j);
                j = j + 1;
            }
            float64 nrm = Math.sqrt(sq);
            if (nrm < 0.00000001) { nrm = 0.00000001; }
            j = 0;
            while (j < cols) {
                float64 gv = (float64) g.flatGet(r * cols + j);
                float64 yv = (float64) y.flatGet(r * cols + j);
                float64 dv = (gv - yv * dot) / nrm;
                out.flatSet(r * cols + j, (E) dv);
                j = j + 1;
            }
            r = r + 1;
        }
        return #out;
    }

    // ── CPU kernels (package-private: the seam is the only entry) ──────

    /** Elementwise a/b with broadcasting (via mul + reciprocal). */
    static #Tensor<E> divK<E extends Floating>(Tensor<E> a, Tensor<E> b) {
        if (a.isOnGpu()) { return Tensor.div<E>(a, b); }
        Tensor<E> rb #= Ops.recipK<E>(b);
        return Tensor.mul<E>(a, rb);
    }

    static #Tensor<E> recipK<E extends Floating>(Tensor<E> b) {
        Tensor<E> out #= b.copy();
        E one = (E) 1;
        int64 n = Ops.countOf<E>(out);
        int64 i = 0;
        while (i < n) {
            out.flatSet(i, one / out.flatGet(i));
            i = i + 1;
        }
        return #out;
    }

    static int64 countOf<E extends Floating>(Tensor<E> t) {
        int64 n = 1;
        int32 d = 0;
        while (d < t.ndim()) {
            n = n * t.shapeAt(d);
            d = d + 1;
        }
        return n;
    }

    static #Tensor<E> tanhK<E extends Floating>(Tensor<E> a) {
        Tensor<E> out #= a.copy();
        int64 n = Ops.countOf<E>(out);
        int64 i = 0;
        while (i < n) {
            float64 x = (float64) out.flatGet(i);
            float64 e2 = Math.exp(2.0 * x);
            float64 th = (e2 - 1.0) / (e2 + 1.0);
            out.flatSet(i, (E) th);
            i = i + 1;
        }
        return #out;
    }

    static #Tensor<E> sigmoidK<E extends Floating>(Tensor<E> a) {
        Tensor<E> out #= a.copy();
        int64 n = Ops.countOf<E>(out);
        int64 i = 0;
        while (i < n) {
            out.flatSet(i, (E) Stats.expit((float64) out.flatGet(i)));
            i = i + 1;
        }
        return #out;
    }

    /** torch's default (exact, erf-based) GELU. */
    static #Tensor<E> geluK<E extends Floating>(Tensor<E> a) {
        Tensor<E> out #= a.copy();
        int64 n = Ops.countOf<E>(out);
        int64 i = 0;
        while (i < n) {
            float64 x = (float64) out.flatGet(i);
            float64 cdf = 0.5 * (1.0 + Stats.erf(x / 1.4142135623730951));
            float64 gl = x * cdf;
            out.flatSet(i, (E) gl);
            i = i + 1;
        }
        return #out;
    }

    static #Tensor<E> powScalarK<E extends Floating>(Tensor<E> a, E c) {
        if (a.isOnGpu()) {
            Tensor<E> dv #= Ewise.deviceLike<E>(a);
            Elementwise.map<E>(dv.deviceView("powScalar"), a.deviceView("powScalar"), a.size(), Elementwise.POW, (float32) c);
            return #dv;
        }
        Tensor<E> out #= a.copy();
        float64 cc = (float64) c;
        int64 n = Ops.countOf<E>(out);
        int64 i = 0;
        while (i < n) {
            out.flatSet(i, (E) Math.pow((float64) out.flatGet(i), cc));
            i = i + 1;
        }
        return #out;
    }

    /** Row softmax over the LAST axis (2-D or 1-D), max-shifted. */
    static #Tensor<E> softmaxK<E extends Floating>(Tensor<E> a) {
        Tensor<E> out #= a.copy();
        int64 cols = out.shapeAt(out.ndim() - 1);
        int64 rows = Ops.countOf<E>(out) / cols;
        int64 r = 0;
        while (r < rows) {
            E mx = out.flatGet(r * cols);
            int64 j = 1;
            while (j < cols) {
                E v = out.flatGet(r * cols + j);
                if (v > mx) { mx = v; }
                j = j + 1;
            }
            float64 sum = 0.0;
            j = 0;
            while (j < cols) {
                float64 e = Math.exp((float64) (out.flatGet(r * cols + j) - mx));
                out.flatSet(r * cols + j, (E) e);
                sum = sum + e;
                j = j + 1;
            }
            j = 0;
            while (j < cols) {
                float64 sv = (float64) out.flatGet(r * cols + j) / sum;
                out.flatSet(r * cols + j, (E) sv);
                j = j + 1;
            }
            r = r + 1;
        }
        return #out;
    }

    static #Tensor<E> logSoftmaxK<E extends Floating>(Tensor<E> a) {
        Tensor<E> sm #= Ops.softmaxK<E>(a);
        return Tensor.log<E>(sm);
    }

    /** Full reduction to a (1,) tensor (a differentiable scalar carrier). */
    static #Tensor<E> sumK<E extends Floating>(Tensor<E> a) {
        E s = Tensor.sum<E, E>(a);
        int64[] sh = [1];
        return Tensor.full<E>(sh, s);
    }

    static #Tensor<E> meanK<E extends Floating>(Tensor<E> a) {
        E m = Tensor.mean<E, E>(a);
        int64[] sh = [1];
        return Tensor.full<E>(sh, m);
    }
}
