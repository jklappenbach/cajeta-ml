package dev.cajeta.ml.grad;

/**
 * Op identifiers for the {@link GradTape} / {@link Ops} registry — one id
 * per differentiable operation (spec §3.2). Ids are dense so the dispatch
 * registry (spec §3.3, the day-one GPU seam) can be indexed arrays: a CPU
 * column (complete in v3) and a GPU column (filled by the xpu phase).
 */
public final class Op {
    public static int32 LEAF        = 0;
    public static int32 ADD         = 1;
    public static int32 SUB         = 2;
    public static int32 MUL         = 3;
    public static int32 DIV         = 4;
    public static int32 MATMUL      = 5;
    public static int32 RELU        = 6;
    public static int32 GELU        = 7;
    public static int32 TANH        = 8;
    public static int32 SIGMOID     = 9;
    public static int32 SOFTMAX     = 10;   // last axis
    public static int32 LOGSOFTMAX  = 11;   // last axis
    public static int32 EXP         = 12;
    public static int32 LOG         = 13;
    public static int32 SQRT        = 14;
    public static int32 POWS        = 15;   // elementwise x^c, scalar c
    public static int32 SUM         = 16;   // full reduction -> (1,)
    public static int32 MEAN        = 17;   // full reduction -> (1,)
    public static int32 SUMAXIS     = 18;   // keepdims
    public static int32 MEANAXIS    = 19;   // keepdims
    public static int32 MAXAXIS     = 20;   // keepdims
    public static int32 RESHAPE     = 21;
    public static int32 TRANSPOSE   = 22;   // 2-D
    public static int32 SLICE       = 23;   // one axis, [start, stop)
    public static int32 CONCAT      = 24;   // two inputs, one axis
    public static int32 NEG         = 25;

    // Structured ops (spec §3.2, U3). Each carries its non-differentiable
    // configuration in the tape's int payload block (stride/padding/kernel/
    // training flag) and its saved forward state in the tape's aux slots
    // (pool argmax, normalized activations, dropout mask, target indices).
    public static int32 CONV2D      = 26;   // x, w, b   | p0=stride p1=pad
    public static int32 MAXPOOL2D   = 27;   // x         | p0=k p1=stride p2=pad
    public static int32 AVGPOOL2D   = 28;   // x         | p0=k p1=stride p2=pad
    public static int32 ADAPTAVGPOOL2D = 29; // x        | p0=outH p1=outW
    public static int32 BATCHNORM2D = 30;   // x, gamma, beta | p0=training
    public static int32 LAYERNORM   = 31;   // x, gamma, beta | last axis
    public static int32 EMBEDDING   = 32;   // w         | aux0=indices
    public static int32 DROPOUT     = 33;   // x         | p0=training p1=seed
    public static int32 CROSSENTROPY = 34;  // logits    | aux1=targets
    public static int32 MSELOSS     = 35;   // pred, target
    public static int32 COSINESIM   = 36;   // a, b (row-wise, last axis)

    /** One past the largest id — the registry array length. */
    public static int32 COUNT       = 37;
}
