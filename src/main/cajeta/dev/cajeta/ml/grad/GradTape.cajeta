package dev.cajeta.ml.grad;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;
import cajeta.math.stats.Stats;
import dev.cajeta.ml.MlException;

/**
 * Define-by-run reverse-mode differentiation over `Tensor<E>` for
 * `E extends Floating` — f32 and f64 (spec §3.1) — the runtime tensor
 * tape the neural framework trains with (the stdlib's scalar tape and
 * compile-time `Grad` are untouched; this one handles dynamic module
 * trees, checkpoint-loaded nets, and per-layer SPELA tapes).
 *
 * Model: nodes append in execution order; `backward(out)` seeds the
 * output cotangent with ones and replays nodes in reverse, accumulating
 * each input's vector–Jacobian product. Broadcast-widened elementwise ops
 * restore input shapes with `Tensor.sumTo` (PyTorch's `sum_to`).
 *
 * Every FORWARD kernel runs through {@link Ops} — the device seam (spec
 * §3.3). First-order only: a second `backward` on the same tape throws
 * (build a fresh tape per step, which is also the training-loop idiom).
 *
 * ```cajeta
 * GradTape<float32> t = heap GradTape<float32>();
 * GradTensor x = t.leaf(xVal, false);
 * GradTensor w = t.leaf(wVal, true);
 * GradTensor y = t.mean(t.relu(t.matmul(x, w)));
 * t.backward(y);
 * Tensor<float32> dw = t.gradOf(w);
 * ```
 */
public final class GradTape<E extends Floating> {

    /** Int payload slots per node (structured-op configuration: stride,
     *  padding, kernel, training flag, output extents). An instance field
     *  rather than a static: a static on a TEMPLATED class does not resolve
     *  through the bare class name in this toolchain. */
    int32 payStride;

    ArrayList<Tensor<E>> values;         // node forward values (owned, or borrowed for leafBorrow)
    ArrayList<Tensor<E>> grads;          // cotangents (allocated in backward)
    boolean[] reached;                   // the node's cotangent holds a contribution (sized in backward)
    ArrayList<Tensor<E>> auxT;           // saved forward state (owned)
    int32[] ops;                         // Op.* per node
    int32[] ain;                         // first-input node idx (-1 = none)
    int32[] bin;                         // second-input node idx (-1 = none)
    int32[] cin;                         // third-input node idx (-1 = none)
    int32[] axes;                        // axis payload
    int32[] pay;                         // PAY int payloads per node
    int32[] aux0;                        // auxT index, or -1
    int32[] aux1;                        // auxT index, or -1
    float64[] cs;                        // scalar payload (dtype-neutral)
    boolean[] needsGrad;                 // reaches a requires-grad leaf
    boolean[] isLeafGrad;                // a leaf explicitly requiring grad
    int32 n;
    int32 cap;
    boolean ranBackward;
    int32 noGradDepth;

    public GradTape() {
        this.values = heap ArrayList<Tensor<E>>();
        this.grads = heap ArrayList<Tensor<E>>();
        this.auxT = heap ArrayList<Tensor<E>>();
        this.payStride = 4;
        this.cap = 64;
        this.ops = heap int32[this.cap];
        this.ain = heap int32[this.cap];
        this.bin = heap int32[this.cap];
        this.cin = heap int32[this.cap];
        this.axes = heap int32[this.cap];
        this.pay = heap int32[this.cap * this.payStride];
        this.aux0 = heap int32[this.cap];
        this.aux1 = heap int32[this.cap];
        this.cs = heap float64[this.cap];
        this.needsGrad = heap boolean[this.cap];
        this.isLeafGrad = heap boolean[this.cap];
        this.n = 0;
        this.ranBackward = false;
        this.noGradDepth = 0;
        return;
    }

    void grow() {
        if (this.n < this.cap) { return; }
        int32 nc = this.cap * 2;
        int32[] no = heap int32[nc];
        int32[] na = heap int32[nc];
        int32[] nb = heap int32[nc];
        int32[] ncn = heap int32[nc];
        int32[] nx = heap int32[nc];
        int32[] npay = heap int32[nc * this.payStride];
        int32[] na0 = heap int32[nc];
        int32[] na1 = heap int32[nc];
        float64[] ncs = heap float64[nc];
        boolean[] ng = heap boolean[nc];
        boolean[] nl = heap boolean[nc];
        int32 i = 0;
        while (i < this.n) {
            no[i] = this.ops[i];
            na[i] = this.ain[i];
            nb[i] = this.bin[i];
            ncn[i] = this.cin[i];
            nx[i] = this.axes[i];
            na0[i] = this.aux0[i];
            na1[i] = this.aux1[i];
            ncs[i] = this.cs[i];
            ng[i] = this.needsGrad[i];
            nl[i] = this.isLeafGrad[i];
            int32 k = 0;
            while (k < this.payStride) {
                npay[i * this.payStride + k] = this.pay[i * this.payStride + k];
                k = k + 1;
            }
            i = i + 1;
        }
        this.ops #= no;
        this.ain #= na;
        this.bin #= nb;
        this.cin #= ncn;
        this.axes #= nx;
        this.pay #= npay;
        this.aux0 #= na0;
        this.aux1 #= na1;
        this.cs #= ncs;
        this.needsGrad #= ng;
        this.isLeafGrad #= nl;
        this.cap = nc;
        return;
    }

    GradTensor push(int32 op, int32 a, int32 b, int32 axis, float64 c,
                    Tensor<E> value) {
        this.grow();
        int32 i = this.n;
        this.ops[i] = op;
        this.ain[i] = a;
        this.bin[i] = b;
        this.axes[i] = axis;
        this.cs[i] = c;
        boolean ng = false;
        if (this.noGradDepth == 0) {
            if (a >= 0 && this.needsGrad[a]) { ng = true; }
            if (b >= 0 && this.needsGrad[b]) { ng = true; }
        }
        this.needsGrad[i] = ng;
        this.isLeafGrad[i] = false;
        this.cin[i] = -1;
        this.aux0[i] = -1;
        this.aux1[i] = -1;
        int32 k = 0;
        while (k < this.payStride) {
            this.pay[i * this.payStride + k] = 0;
            k = k + 1;
        }
        this.values.add(#value);
        this.n = i + 1;
        return stack GradTensor(i);
    }

    /** Attach a THIRD differentiable input (conv bias, norm beta) to a node
     *  already pushed, propagating its grad-requirement. */
    void linkThird(int32 node, int32 c) {
        this.cin[node] = c;
        if (c >= 0 && this.needsGrad[c] && this.noGradDepth == 0) {
            this.needsGrad[node] = true;
        }
        return;
    }

    void setPay(int32 node, int32 slot, int32 v) {
        this.pay[node * this.payStride + slot] = v;
        return;
    }

    int32 getPay(int32 node, int32 slot) {
        return this.pay[node * this.payStride + slot];
    }

    /** Park a saved forward tensor on the tape and return its handle. */
    int32 addAux(#Tensor<E> t) {
        this.auxT.add(#t);
        return (int32) this.auxT.count() - 1;
    }

    /** Record `value` as a leaf. `requiresGrad` marks a trainable input. */
    public GradTensor leaf(Tensor<E> value, boolean requiresGrad) {
        Tensor<E> own #= Ops.copyOf<E>(value);
        GradTensor t = this.push(Op.LEAF, -1, -1, 0, 0.0, #own);
        this.needsGrad[t.idx] = requiresGrad && this.noGradDepth == 0;
        this.isLeafGrad[t.idx] = this.needsGrad[t.idx];
        return t;
    }

    /** Record the caller's `value` as a leaf without copying it; the caller keeps it alive and unchanged for the tape's life. */
    public GradTensor leafBorrow(Tensor<E> value, boolean requiresGrad) {
        GradTensor t = this.push(Op.LEAF, -1, -1, 0, 0.0, value);
        this.needsGrad[t.idx] = requiresGrad && this.noGradDepth == 0;
        this.isLeafGrad[t.idx] = this.needsGrad[t.idx];
        return t;
    }

    /** The node's forward value (borrow — the tape owns it). */
    public Tensor<E> valueOf(GradTensor t) {
        return this.values.get(t.idx);
    }

    /** The accumulated cotangent of a requires-grad node after backward. */
    public Tensor<E> gradOf(GradTensor t) {
        if (!this.ranBackward) {
            throw heap MlException("GradTape.gradOf: run backward first");
        }
        if (!this.needsGrad[t.idx]) {
            throw heap MlException("GradTape.gradOf: node " + t.idx
                + " does not require grad");
        }
        if (!this.reached[t.idx]) {
            Tensor<E> z #= Ops.zerosLike<E>(this.values.get(t.idx));
            this.grads.set(t.idx, #z);
            this.reached[t.idx] = true;
        }
        return this.grads.get(t.idx);
    }

    /** Suspend recording of grad requirements (torch's no_grad). */
    public void noGradBegin() {
        this.noGradDepth = this.noGradDepth + 1;
        return;
    }

    public void noGradEnd() {
        if (this.noGradDepth > 0) {
            this.noGradDepth = this.noGradDepth - 1;
        }
        return;
    }

    /** A grad-detached alias of `t` (same value, no history). `detach` and
     *  `view` are reserved words, hence the spelling. */
    public GradTensor detached(GradTensor t) {
        Tensor<E> v = this.values.get(t.idx);
        Tensor<E> own #= v.copy();
        return this.push(Op.LEAF, -1, -1, 0, 0.0, #own);
    }

    // ── Recorded ops (forward via the Ops seam) ─────────────────────────

    public GradTensor add(GradTensor a, GradTensor b) { return this.bin2(Op.ADD, a, b); }
    public GradTensor sub(GradTensor a, GradTensor b) { return this.bin2(Op.SUB, a, b); }
    public GradTensor mul(GradTensor a, GradTensor b) { return this.bin2(Op.MUL, a, b); }
    public GradTensor div(GradTensor a, GradTensor b) { return this.bin2(Op.DIV, a, b); }
    public GradTensor matmul(GradTensor a, GradTensor b) { return this.bin2(Op.MATMUL, a, b); }

    /** Rank-3 batched matmul: (B,M,K)·(B,K,N) → (B,M,N). Attention's shape
     *  once the head axis is folded into the batch. */
    public GradTensor matmulBatched(GradTensor a, GradTensor b) { return this.bin2(Op.MATMULB, a, b); }

    /** Swap the last two axes of a rank-3 node. */
    public GradTensor transposeBatch(GradTensor a) { return this.una(Op.TRANSPOSEB, a, 0, (E) 0); }

    /** Permute axes (rank ≤ 4 — the perm rides the int payload slots).
     *  `perm[k]` is the SOURCE axis that becomes axis `k`. */
    public GradTensor permute(GradTensor a, int32[] perm) {
        int32 rank = (int32) perm.count();
        if (rank > this.payStride) {
            throw heap MlException("GradTape.permute: rank " + rank
                + " exceeds the tape's payload width (" + this.payStride + ")");
        }
        Tensor<E> v #= Ops.permute<E>(this.values.get(a.idx), perm);
        GradTensor t = this.push(Op.PERMUTE, a.idx, -1, rank, 0.0, #v);
        int32 k = 0;
        while (k < rank) {
            this.setPay(t.idx, k, perm[k]);
            k = k + 1;
        }
        return t;
    }

    GradTensor bin2(int32 op, GradTensor a, GradTensor b) {
        Tensor<E> v #= Ops.run2<E>(op, this.values.get(a.idx), this.values.get(b.idx));
        return this.push(op, a.idx, b.idx, 0, 0.0, #v);
    }

    public GradTensor relu(GradTensor a) { return this.una(Op.RELU, a, 0, (E) 0); }
    public GradTensor gelu(GradTensor a) { return this.una(Op.GELU, a, 0, (E) 0); }
    public GradTensor tanh(GradTensor a) { return this.una(Op.TANH, a, 0, (E) 0); }
    public GradTensor sigmoid(GradTensor a) { return this.una(Op.SIGMOID, a, 0, (E) 0); }
    public GradTensor softmax(GradTensor a) { return this.una(Op.SOFTMAX, a, 0, (E) 0); }
    public GradTensor logSoftmax(GradTensor a) { return this.una(Op.LOGSOFTMAX, a, 0, (E) 0); }
    public GradTensor exp(GradTensor a) { return this.una(Op.EXP, a, 0, (E) 0); }
    public GradTensor log(GradTensor a) { return this.una(Op.LOG, a, 0, (E) 0); }
    public GradTensor sqrt(GradTensor a) { return this.una(Op.SQRT, a, 0, (E) 0); }
    public GradTensor neg(GradTensor a) { return this.una(Op.NEG, a, 0, (E) 0); }
    public GradTensor powScalar(GradTensor a, E c) { return this.una(Op.POWS, a, 0, c); }
    public GradTensor sum(GradTensor a) { return this.una(Op.SUM, a, 0, (E) 0); }
    public GradTensor mean(GradTensor a) { return this.una(Op.MEAN, a, 0, (E) 0); }
    public GradTensor sumAxis(GradTensor a, int32 axis) { return this.una(Op.SUMAXIS, a, axis, (E) 0); }
    public GradTensor meanAxis(GradTensor a, int32 axis) { return this.una(Op.MEANAXIS, a, axis, (E) 0); }
    public GradTensor maxAxis(GradTensor a, int32 axis) { return this.una(Op.MAXAXIS, a, axis, (E) 0); }
    public GradTensor transpose2d(GradTensor a) { return this.una(Op.TRANSPOSE, a, 0, (E) 0); }
    /** Scale each row to unit L2 norm over the last axis. */
    public GradTensor rowNorm(GradTensor a) { return this.una(Op.ROWNORM, a, 0, (E) 0); }

    GradTensor una(int32 op, GradTensor a, int32 axis, E c) {
        Tensor<E> v #= Ops.run1<E>(op, this.values.get(a.idx), axis, c);
        return this.push(op, a.idx, -1, axis, (float64) c, #v);
    }

    /** Reshape (records the input shape for the backward). */
    public GradTensor reshape(GradTensor a, int64[] newShape) {
        // A view: the input's value lives as long as the tape (Ops.reshapeView).
        Tensor<E> v #= Ops.reshapeView<E>(this.values.get(a.idx), newShape);
        return this.push(Op.RESHAPE, a.idx, -1, 0, 0.0, #v);
    }

    /** Slice one axis, [start, stop). */
    public GradTensor slice(GradTensor a, int32 axis, int64 start, int64 stop) {
        Tensor<E> v #= Ops.slice<E>(this.values.get(a.idx), axis, start, stop);
        GradTensor t = this.push(Op.SLICE, a.idx, -1, axis, 0.0, #v);
        // start rides the scalar payload (stop derives from the shapes).
        this.cs[t.idx] = (float64) start;
        return t;
    }

    /** y = act(x . w + b) in one node (act 0 none, 1 relu); the bias is the node's third input. */
    public GradTensor linear(GradTensor x, GradTensor w, GradTensor b, int32 act) {
        Tensor<E> v #= Ops.linear<E>(this.values.get(x.idx), this.values.get(w.idx), this.values.get(b.idx), act);
        GradTensor t = this.push(Op.LINEAR, x.idx, w.idx, act, 0.0, #v);
        this.linkThird(t.idx, b.idx);
        return t;
    }

    /** Concatenate two nodes along `axis`. */
    public GradTensor concat(GradTensor a, GradTensor b, int32 axis) {
        Tensor<E> v #= Ops.concat<E>(this.values.get(a.idx), this.values.get(b.idx), axis);
        return this.push(Op.CONCAT, a.idx, b.idx, axis, 0.0, #v);
    }

    // ── Structured ops (U3) ─────────────────────────────────────────────

    /** 2-D convolution over NCHW input with an (O,C,KH,KW) kernel. */
    public GradTensor conv2d(GradTensor x, GradTensor w, GradTensor b,
                             int32 stride, int32 pad) {
        Tensor<E> v #= Ops.conv2d<E>(this.values.get(x.idx), this.values.get(w.idx),
                                    this.values.get(b.idx), stride, pad);
        GradTensor t = this.push(Op.CONV2D, x.idx, w.idx, 0, 0.0, #v);
        this.linkThird(t.idx, b.idx);
        this.setPay(t.idx, 0, stride);
        this.setPay(t.idx, 1, pad);
        return t;
    }

    public GradTensor maxPool2d(GradTensor x, int32 k, int32 stride, int32 pad) {
        Tensor<E> xv = this.values.get(x.idx);
        int64 oh = StructKernels.outExtent(xv.shapeAt(2), k, stride, pad);
        int64 ow = StructKernels.outExtent(xv.shapeAt(3), k, stride, pad);
        int64[] osh #= StructKernels.shape4(xv.shapeAt(0), xv.shapeAt(1), oh, ow);
        Tensor<E> argmax #= Ops.zerosOn<E>(osh, xv);
        Tensor<E> v #= Ops.maxPool2d<E>(xv, k, stride, pad, argmax);
        GradTensor t = this.push(Op.MAXPOOL2D, x.idx, -1, 0, 0.0, #v);
        this.setPay(t.idx, 0, k);
        this.setPay(t.idx, 1, stride);
        this.setPay(t.idx, 2, pad);
        this.aux0[t.idx] = this.addAux(#argmax);
        return t;
    }

    public GradTensor avgPool2d(GradTensor x, int32 k, int32 stride, int32 pad) {
        Tensor<E> v #= Ops.avgPool2d<E>(this.values.get(x.idx), k, stride, pad);
        GradTensor t = this.push(Op.AVGPOOL2D, x.idx, -1, 0, 0.0, #v);
        this.setPay(t.idx, 0, k);
        this.setPay(t.idx, 1, stride);
        this.setPay(t.idx, 2, pad);
        return t;
    }

    public GradTensor adaptiveAvgPool2d(GradTensor x, int32 outH, int32 outW) {
        Tensor<E> v #= Ops.adaptiveAvgPool2d<E>(this.values.get(x.idx), outH, outW);
        GradTensor t = this.push(Op.ADAPTAVGPOOL2D, x.idx, -1, 0, 0.0, #v);
        this.setPay(t.idx, 0, outH);
        this.setPay(t.idx, 1, outW);
        return t;
    }

    /** Training-mode batch norm: normalizes with THIS batch's statistics,
     *  so every element's gradient depends on the whole channel. Running
     *  stats are module state — see {@link Ops#updateRunningStats}. */
    public GradTensor batchNorm2dTrain(GradTensor x, GradTensor gamma,
                                       GradTensor beta, float64 eps) {
        Tensor<E> xv = this.values.get(x.idx);
        Tensor<E> mean #= Ops.channelMean<E>(xv);
        Tensor<E> var #= Ops.channelVar<E>(xv, mean);
        return this.bnCommon(x, gamma, beta, mean, var, eps, true);
    }

    /** Eval-mode batch norm against fixed (running) statistics. */
    public GradTensor batchNorm2dEval(GradTensor x, GradTensor gamma,
                                      GradTensor beta, Tensor<E> mean,
                                      Tensor<E> var, float64 eps) {
        return this.bnCommon(x, gamma, beta, mean, var, eps, false);
    }

    GradTensor bnCommon(GradTensor x, GradTensor gamma, GradTensor beta,
                        Tensor<E> mean, Tensor<E> var, float64 eps,
                        boolean training) {
        Tensor<E> xv = this.values.get(x.idx);
        Tensor<E> xhat #= Ops.zerosLike<E>(xv);
        int64[] csh #= StructKernels.shape1(xv.shapeAt(1));
        Tensor<E> invstd #= Ops.zerosOn<E>(csh, xv);
        Tensor<E> v #= Ops.batchNorm2d<E>(xv, this.values.get(gamma.idx),
                                         this.values.get(beta.idx), mean, var,
                                         eps, xhat, invstd);
        GradTensor t = this.push(Op.BATCHNORM2D, x.idx, gamma.idx, 0, eps, #v);
        this.linkThird(t.idx, beta.idx);
        if (training) { this.setPay(t.idx, 0, 1); }
        this.aux0[t.idx] = this.addAux(#xhat);
        this.aux1[t.idx] = this.addAux(#invstd);
        return t;
    }

    /** Layer norm over the LAST axis, with per-position scale and shift. */
    public GradTensor layerNorm(GradTensor x, GradTensor gamma, GradTensor beta,
                                float64 eps) {
        Tensor<E> xv = this.values.get(x.idx);
        int64 rows = 1;
        int32 k = 0;
        while (k < xv.ndim() - 1) {
            rows = rows * xv.shapeAt(k);
            k = k + 1;
        }
        int64[] rsh #= StructKernels.shape1(rows);
        Tensor<E> mean #= Ops.zerosOn<E>(rsh, xv);
        Tensor<E> invstd #= Ops.zerosOn<E>(rsh, xv);
        Tensor<E> v #= Ops.layerNorm<E>(xv, this.values.get(gamma.idx),
                                       this.values.get(beta.idx), eps, mean, invstd);
        GradTensor t = this.push(Op.LAYERNORM, x.idx, gamma.idx, 0, eps, #v);
        this.linkThird(t.idx, beta.idx);
        this.aux0[t.idx] = this.addAux(#mean);
        this.aux1[t.idx] = this.addAux(#invstd);
        return t;
    }

    /** Row gather from an embedding table. `indices` holds class ids as
     *  values (exact in both float widths below 2²⁴) and is not
     *  differentiable — only the table receives gradient. */
    public GradTensor embedding(GradTensor table, Tensor<E> indices) {
        Tensor<E> v #= Ops.embedding<E>(this.values.get(table.idx), indices);
        GradTensor t = this.push(Op.EMBEDDING, table.idx, -1, 0, 0.0, #v);
        Tensor<E> own #= Ops.copyOf<E>(indices);
        this.aux0[t.idx] = this.addAux(#own);
        return t;
    }

    /** Inverted dropout; identity when `training` is false. */
    public GradTensor dropout(GradTensor x, float64 p, boolean training,
                              uint64 seed) {
        Tensor<E> xv = this.values.get(x.idx);
        Tensor<E> mask #= Ops.zerosLike<E>(xv);
        Tensor<E> v #= Ops.dropout<E>(xv, p, training, seed, mask);
        GradTensor t = this.push(Op.DROPOUT, x.idx, -1, 0, p, #v);
        if (training) { this.setPay(t.idx, 0, 1); }
        this.aux0[t.idx] = this.addAux(#mask);
        return t;
    }

    /** Softmax cross-entropy against class ids, mean reduction → (1,). */
    public GradTensor crossEntropy(GradTensor logits, Tensor<E> targets) {
        Tensor<E> lv = this.values.get(logits.idx);
        int64 cls = lv.shapeAt(lv.ndim() - 1);
        int64[] rsh #= StructKernels.shape1(lv.size() / cls);
        Tensor<E> lse #= Ops.zerosOn<E>(rsh, lv);
        Tensor<E> v #= Ops.crossEntropy<E>(lv, targets, lse);
        GradTensor t = this.push(Op.CROSSENTROPY, logits.idx, -1, 0, 0.0, #v);
        this.aux0[t.idx] = this.addAux(#lse);
        Tensor<E> own #= Ops.copyOf<E>(targets);
        this.aux1[t.idx] = this.addAux(#own);
        return t;
    }

    /** Mean squared error → (1,). Both inputs receive gradient. */
    public GradTensor mseLoss(GradTensor pred, GradTensor target) {
        Tensor<E> v #= Ops.mseLoss<E>(this.values.get(pred.idx),
                                     this.values.get(target.idx));
        return this.push(Op.MSELOSS, pred.idx, target.idx, 0, 0.0, #v);
    }

    /** Row-wise cosine similarity over the last axis → (rows,). SPELA's
     *  per-layer objective is built on this. */
    public GradTensor cosineSim(GradTensor a, GradTensor b) {
        Tensor<E> av = this.values.get(a.idx);
        int64 rows = 1;
        int32 k = 0;
        while (k < av.ndim() - 1) {
            rows = rows * av.shapeAt(k);
            k = k + 1;
        }
        int64[] csh #= StructKernels.shape1(rows * 3);
        Tensor<E> cache #= Ops.zerosOn<E>(csh, av);
        float64 eps = 0.00000001;
        Tensor<E> v #= Ops.cosineSim<E>(av, this.values.get(b.idx), eps, cache);
        GradTensor t = this.push(Op.COSINESIM, a.idx, b.idx, 0, eps, #v);
        this.aux0[t.idx] = this.addAux(#cache);
        return t;
    }

    // ── Backward ────────────────────────────────────────────────────────

    void accum(int32 node, #Tensor<E> contrib) {
        if (!this.reached[node]) {
            this.grads.set(node, #contrib);
            this.reached[node] = true;
            return;
        }
        Tensor<E> cur = this.grads.get(node);
        Tensor<E> next #= Tensor.add<E>(cur, contrib);
        this.grads.set(node, #next);
        return;
    }

    /** Shape-restoring accumulate (broadcast backward). */
    void accumTo(int32 node, Tensor<E> contrib) {
        Tensor<E> like = this.values.get(node);
        Tensor<E> fit #= Ops.sumTo<E>(contrib, like);
        this.accum(node, #fit);
        return;
    }

    public void backward(GradTensor out) {
        if (this.ranBackward) {
            throw heap MlException("GradTape.backward: this tape already ran "
                + "backward (first-order only) — build a fresh tape per step");
        }
        if (!this.needsGrad[out.idx]) {
            throw heap MlException("GradTape.backward: the output does not "
                + "reach any requires-grad leaf");
        }
        this.ranBackward = true;
        // A cotangent exists once a contribution reaches it: the first is taken as is, later
        // ones are added, and gradOf zero-fills one nothing reached. Filling every node up
        // front and adding each first contribution to zeros cost 30 fills and as many adds of
        // 16 MB a step in transformer-block-train on cuda (cajeta-ml-gpu 28.2.8). Until then a
        // node holds a one-element host placeholder.
        this.reached = heap boolean[this.n];
        int64[] one = [1L];
        int32 i = 0;
        while (i < this.n) {
            Tensor<E> z #= Tensor.full<E>(one, (E) 0);
            this.grads.add(#z);
            i = i + 1;
        }
        // Seed d(out)/d(out) = 1.
        Tensor<E> seedSrc = this.values.get(out.idx);
        Tensor<E> seed #= Ops.fullOn<E>(GradTape.shapeOf<E>(seedSrc), seedSrc, (E) 1);
        this.grads.set(out.idx, #seed);
        this.reached[out.idx] = true;

        int32 k = out.idx;
        while (k >= 0) {
            if (this.needsGrad[k] && this.reached[k] && this.ops[k] != Op.LEAF) {
                this.backOne(k);
            }
            k = k - 1;
        }
        return;
    }

    /** The linear node's VJP from the cotangent `gm` of its pre-activation sum. */
    void linearBack(int32 i, int32 a, int32 b, Tensor<E> va, Tensor<E> vb, Tensor<E> gm) {
        if (this.needsGrad[a]) {
            Tensor<E> bt #= Ops.run1<E>(Op.TRANSPOSE, vb, 0, (E) 0);
            this.accum(a, Ops.run2<E>(Op.MATMUL, gm, bt));
        }
        if (this.needsGrad[b]) {
            this.accum(b, Ops.matmulTN<E>(va, gm));
        }
        int32 c = this.cin[i];
        if (c >= 0 && this.needsGrad[c]) {
            this.accum(c, Ops.sumTo<E>(gm, this.values.get(c)));
        }
    }

    void backOne(int32 i) {
        int32 op = this.ops[i];
        int32 a = this.ain[i];
        int32 b = this.bin[i];
        Tensor<E> g = this.grads.get(i);
        Tensor<E> va = this.values.get(a);
        Tensor<E> vo = this.values.get(i);

        if (op == Op.ADD) {
            if (this.needsGrad[a]) { this.accumTo(a, g); }
            if (this.needsGrad[b]) { this.accumTo(b, g); }
            return;
        }
        if (op == Op.SUB) {
            if (this.needsGrad[a]) { this.accumTo(a, g); }
            if (this.needsGrad[b]) {
                Tensor<E> ng #= Ops.run1<E>(Op.NEG, g, 0, (E) 0);
                this.accumTo(b, ng);
            }
            return;
        }
        if (op == Op.MUL) {
            if (this.needsGrad[a]) {
                Tensor<E> ga #= Tensor.mul<E>(g, this.values.get(b));
                this.accumTo(a, ga);
            }
            if (this.needsGrad[b]) {
                Tensor<E> gb #= Tensor.mul<E>(g, va);
                this.accumTo(b, gb);
            }
            return;
        }
        if (op == Op.DIV) {
            Tensor<E> vb = this.values.get(b);
            if (this.needsGrad[a]) {
                Tensor<E> ga #= Ops.divK<E>(g, vb);
                this.accumTo(a, ga);
            }
            if (this.needsGrad[b]) {
                // d/db (a/b) = -a/b² → -out/b
                Tensor<E> t1 #= Ops.divK<E>(vo, vb);
                Tensor<E> t2 #= Tensor.mul<E>(g, t1);
                Tensor<E> gb #= Ops.run1<E>(Op.NEG, t2, 0, (E) 0);
                this.accumTo(b, gb);
            }
            return;
        }
        if (op == Op.MATMUL) {
            Tensor<E> vb = this.values.get(b);
            if (this.needsGrad[a]) {
                Tensor<E> bt #= Ops.run1<E>(Op.TRANSPOSE, vb, 0, (E) 0);
                this.accum(a, Ops.run2<E>(Op.MATMUL, g, bt));
            }
            if (this.needsGrad[b]) {
                this.accum(b, Ops.matmulTN<E>(va, g));
            }
            return;
        }
        if (op == Op.LINEAR) {
            Tensor<E> vb = this.values.get(b);
            if (this.axes[i] == 1) {
                Tensor<E> gm #= Ops.actBack<E>(Op.RELU, g, vo, vo);
                this.linearBack(i, a, b, va, vb, gm);
            } else {
                this.linearBack(i, a, b, va, vb, g);
            }
            return;
        }
        if (op == Op.MATMULB) {
            Tensor<E> vb = this.values.get(b);
            if (this.needsGrad[a]) {
                Tensor<E> bt #= Ops.transposeLast2<E>(vb);
                this.accum(a, Ops.run2<E>(Op.MATMULB, g, bt));
            }
            if (this.needsGrad[b]) {
                Tensor<E> at #= Ops.transposeLast2<E>(va);
                this.accum(b, Ops.run2<E>(Op.MATMULB, at, g));
            }
            return;
        }
        if (op == Op.TRANSPOSEB) {
            // the last-two-axis swap is its own inverse
            this.accum(a, Ops.transposeLast2<E>(g));
            return;
        }
        if (op == Op.ROWNORM) {
            this.accum(a, Ops.rowNormBack<E>(va, vo, g));
            return;
        }
        if (op == Op.PERMUTE) {
            // undo with the INVERSE permutation: axis perm[k] came from k
            int32 rank = this.axes[i];
            int32[] inv = heap int32[rank];
            int32 k = 0;
            while (k < rank) {
                inv[this.getPay(i, k)] = k;
                k = k + 1;
            }
            this.accum(a, Ops.permute<E>(g, inv));
            return;
        }
        if (op == Op.RELU || op == Op.TANH || op == Op.SIGMOID || op == Op.GELU) {
            this.accum(a, Ops.actBack<E>(op, g, va, vo));
            return;
        }
        if (op == Op.NEG) {
            this.accum(a, Ops.run1<E>(Op.NEG, g, 0, (E) 0));
            return;
        }
        if (op == Op.EXP) {
            Tensor<E> ga #= Tensor.mul<E>(g, vo);
            this.accum(a, #ga);
            return;
        }
        if (op == Op.LOG) {
            Tensor<E> ga #= Ops.divK<E>(g, va);
            this.accum(a, #ga);
            return;
        }
        if (op == Op.SQRT) {
            // 1/(2·out)
            Tensor<E> two #= Ops.scale<E>(vo, (E) 2);
            Tensor<E> ga #= Ops.divK<E>(g, two);
            this.accum(a, #ga);
            return;
        }
        if (op == Op.POWS) {
            // c·x^(c−1)
            E c = (E) this.cs[i];
            Tensor<E> pm1 #= Ops.powScalarK<E>(va, c - (E) 1);
            Tensor<E> d #= Ops.scale<E>(pm1, c);
            Tensor<E> ga #= Tensor.mul<E>(g, d);
            this.accum(a, #ga);
            return;
        }
        if (op == Op.SOFTMAX) {
            this.accum(a, Ops.softmaxBack<E>(vo, g, false));
            return;
        }
        if (op == Op.LOGSOFTMAX) {
            this.accum(a, Ops.softmaxBack<E>(vo, g, true));
            return;
        }
        if (op == Op.SUM) {
            // broadcast the (1,) cotangent to the input shape
            this.accum(a, Ops.broadcastCopy<E>(g, GradTape.shapeOf<E>(va)));
            return;
        }
        if (op == Op.MEAN) {
            Tensor<E> gb #= Ops.broadcastCopy<E>(g, GradTape.shapeOf<E>(va));
            this.accum(a, Ops.scale<E>(gb, (E) 1 / (E) Ops.countOf<E>(va)));
            return;
        }
        if (op == Op.SUMAXIS) {
            this.accum(a, Ops.broadcastCopy<E>(g, GradTape.shapeOf<E>(va)));
            return;
        }
        if (op == Op.MEANAXIS) {
            int32 axis = this.axes[i];
            int32 ax = axis;
            if (ax < 0) { ax = ax + va.ndim(); }
            E inv = (E) 1 / (E) va.shapeAt(ax);
            Tensor<E> gb #= Ops.broadcastCopy<E>(g, GradTape.shapeOf<E>(va));
            this.accum(a, Ops.scale<E>(gb, inv));
            return;
        }
        if (op == Op.MAXAXIS) {
            // route to the (first) argmax positions: mask = (x == max)
            this.accum(a, Ops.maxAxisBack<E>(va, vo, g, this.axes[i]));
            return;
        }
        if (op == Op.RESHAPE) {
            // A view of this node's cotangent, which nothing replaces once its node ran.
            this.accum(a, Ops.reshapeView<E>(g, GradTape.shapeOf<E>(va)));
            return;
        }
        if (op == Op.TRANSPOSE) {
            this.accum(a, Ops.run1<E>(Op.TRANSPOSE, g, 0, (E) 0));
            return;
        }
        if (op == Op.SLICE) {
            int32 axis = this.axes[i];
            int64 start = (int64) this.cs[i];
            this.accum(a, Ops.sliceBack<E>(va, g, axis, start));
            return;
        }
        if (op == Op.CONCAT) {
            int32 axis = this.axes[i];
            int64 na = va.shapeAt(axis);
            if (this.needsGrad[a]) {
                this.accum(a, Ops.slice<E>(g, axis, 0, na));
            }
            if (this.needsGrad[b]) {
                Tensor<E> vb = this.values.get(b);
                this.accum(b, Ops.slice<E>(g, axis, na, na + vb.shapeAt(axis)));
            }
            return;
        }
        if (op == Op.CONV2D) {
            int32 stride = this.getPay(i, 0);
            int32 pad = this.getPay(i, 1);
            Tensor<E> vb = this.values.get(b);
            if (this.needsGrad[a]) {
                this.accum(a, Ops.conv2dBackIn<E>(g, va, vb, stride, pad));
            }
            if (this.needsGrad[b]) {
                this.accum(b, Ops.conv2dBackWeight<E>(g, va, vb, stride, pad));
            }
            int32 c = this.cin[i];
            if (c >= 0 && this.needsGrad[c]) {
                this.accum(c, Ops.conv2dBackBias<E>(g));
            }
            return;
        }
        if (op == Op.MAXPOOL2D) {
            Tensor<E> argmax = this.auxT.get(this.aux0[i]);
            this.accum(a, Ops.maxPool2dBack<E>(g, va, argmax, this.getPay(i, 0),
                                               this.getPay(i, 1), this.getPay(i, 2)));
            return;
        }
        if (op == Op.AVGPOOL2D) {
            this.accum(a, Ops.avgPool2dBack<E>(g, va, this.getPay(i, 0),
                                               this.getPay(i, 1), this.getPay(i, 2)));
            return;
        }
        if (op == Op.ADAPTAVGPOOL2D) {
            this.accum(a, Ops.adaptiveAvgPool2dBack<E>(g, va));
            return;
        }
        if (op == Op.BATCHNORM2D) {
            Tensor<E> xhat = this.auxT.get(this.aux0[i]);
            Tensor<E> invstd = this.auxT.get(this.aux1[i]);
            boolean training = this.getPay(i, 0) == 1;
            if (this.needsGrad[a]) {
                this.accum(a, Ops.batchNorm2dBackIn<E>(g, xhat, this.values.get(b),
                                                       invstd, training));
            }
            if (this.needsGrad[b]) {
                this.accum(b, Ops.normBackScale<E>(g, xhat));
            }
            int32 c = this.cin[i];
            if (c >= 0 && this.needsGrad[c]) {
                this.accum(c, Ops.normBackShift<E>(g));
            }
            return;
        }
        if (op == Op.LAYERNORM) {
            Tensor<E> xv = this.values.get(a);
            Tensor<E> mean = this.auxT.get(this.aux0[i]);
            Tensor<E> invstd = this.auxT.get(this.aux1[i]);
            if (this.needsGrad[a]) {
                this.accum(a, Ops.layerNormBackIn<E>(g, xv, this.values.get(b),
                                                     mean, invstd));
            }
            if (this.needsGrad[b]) {
                this.accum(b, Ops.layerNormBackScale<E>(g, xv, mean, invstd));
            }
            int32 c = this.cin[i];
            if (c >= 0 && this.needsGrad[c]) {
                this.accum(c, Ops.layerNormBackShift<E>(g));
            }
            return;
        }
        if (op == Op.EMBEDDING) {
            Tensor<E> idx = this.auxT.get(this.aux0[i]);
            this.accum(a, Ops.embeddingBack<E>(g, va, idx));
            return;
        }
        if (op == Op.DROPOUT) {
            Tensor<E> mask = this.auxT.get(this.aux0[i]);
            Tensor<E> ga #= Tensor.mul<E>(g, mask);
            this.accum(a, #ga);
            return;
        }
        if (op == Op.CROSSENTROPY) {
            Tensor<E> lse = this.auxT.get(this.aux0[i]);
            Tensor<E> targets = this.auxT.get(this.aux1[i]);
            this.accum(a, Ops.crossEntropyBack<E>(g, this.values.get(a), lse, targets));
            return;
        }
        if (op == Op.MSELOSS) {
            Tensor<E> vb = this.values.get(b);
            if (this.needsGrad[a]) {
                this.accum(a, Ops.mseLossBack<E>(g, va, vb, true));
            }
            if (this.needsGrad[b]) {
                this.accum(b, Ops.mseLossBack<E>(g, va, vb, false));
            }
            return;
        }
        if (op == Op.COSINESIM) {
            Tensor<E> cache = this.auxT.get(this.aux0[i]);
            Tensor<E> vb = this.values.get(b);
            float64 eps = this.cs[i];
            if (this.needsGrad[a]) {
                this.accum(a, Ops.cosineSimBack<E>(g, va, vb, cache, eps, true));
            }
            if (this.needsGrad[b]) {
                this.accum(b, Ops.cosineSimBack<E>(g, va, vb, cache, eps, false));
            }
            return;
        }
        throw heap MlException("GradTape: no backward rule for op " + op);
    }

    static #int64[] shapeOf<E extends Floating>(Tensor<E> t) {
        int32 nd = t.ndim();
        int64[] sh = heap int64[nd];
        int32 d = 0;
        while (d < nd) {
            sh[d] = t.shapeAt(d);
            d = d + 1;
        }
        return #sh;
    }






    public int32 count() {
        return this.n;
    }
}
