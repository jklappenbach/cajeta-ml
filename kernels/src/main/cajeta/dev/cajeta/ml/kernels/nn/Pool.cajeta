package dev.cajeta.ml.kernels.nn;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;

/**
 * 2-D pooling over NCHW input (spec §6.6), one lane per output element. Max pooling skips the
 * padding and records each cell's flat input index as E (the backward's routing table); average
 * pooling divides by the full window (torch's count_include_pad); adaptive pooling takes torch's
 * windows floor(i*in/out) .. ceil((i+1)*in/out).
 */
public final class Pool {
    public Pool() { return; }

    @Kernel
    public static void max2d<E>(KernelBuffer<E> out, KernelBuffer<E> argmax, KernelBuffer<E> x,
                                uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oh, uint32 ow,
                                int32 k, int32 stride, int32 pad) {
        uint32 t = KernelThread.globalIdX();
        uint32 total = n * c * oh * ow;
        if (t < total) {
            uint32 xx = t % ow;
            uint32 q = t / ow;
            uint32 y = q % oh;
            uint32 plane = q / oh;
            boolean seen = false;
            float32 best = 0.0f;
            uint32 bestIdx = 0;
            int32 a = 0;
            while (a < k) {
                int32 ih = (int32) y * stride - pad + a;
                if (ih >= 0 && ih < (int32) h) {
                    int32 e = 0;
                    while (e < k) {
                        int32 iw = (int32) xx * stride - pad + e;
                        if (iw >= 0 && iw < (int32) wd) {
                            uint32 xi = (plane * h + (uint32) ih) * wd + (uint32) iw;
                            float32 v = (float32) x[xi];
                            if (!seen || v > best) { best = v; bestIdx = xi; seen = true; }
                        }
                        e = e + 1;
                    }
                }
                a = a + 1;
            }
            out[t] = (E) best;
            argmax[t] = (E) ((float32) bestIdx);
        }
    }

    @Kernel
    public static void avg2d<E>(KernelBuffer<E> out, KernelBuffer<E> x,
                                uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oh, uint32 ow,
                                int32 k, int32 stride, int32 pad) {
        uint32 t = KernelThread.globalIdX();
        uint32 total = n * c * oh * ow;
        if (t < total) {
            uint32 xx = t % ow;
            uint32 q = t / ow;
            uint32 y = q % oh;
            uint32 plane = q / oh;
            float32 acc = 0.0f;
            int32 a = 0;
            while (a < k) {
                int32 ih = (int32) y * stride - pad + a;
                if (ih >= 0 && ih < (int32) h) {
                    int32 e = 0;
                    while (e < k) {
                        int32 iw = (int32) xx * stride - pad + e;
                        if (iw >= 0 && iw < (int32) wd) {
                            acc = acc + (float32) x[(plane * h + (uint32) ih) * wd + (uint32) iw];
                        }
                        e = e + 1;
                    }
                }
                a = a + 1;
            }
            out[t] = (E) (acc / (float32) (k * k));
        }
    }

    @Kernel
    public static void adaptive2d<E>(KernelBuffer<E> out, KernelBuffer<E> x,
                                     uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oh, uint32 ow) {
        uint32 t = KernelThread.globalIdX();
        uint32 total = n * c * oh * ow;
        if (t < total) {
            uint32 xx = t % ow;
            uint32 q = t / ow;
            uint32 y = q % oh;
            uint32 plane = q / oh;
            uint32 h0 = (y * h) / oh;
            uint32 h1 = ((y + 1) * h + oh - 1) / oh;
            uint32 w0 = (xx * wd) / ow;
            uint32 w1 = ((xx + 1) * wd + ow - 1) / ow;
            float32 acc = 0.0f;
            uint32 ih = h0;
            while (ih < h1) {
                uint32 iw = w0;
                while (iw < w1) {
                    acc = acc + (float32) x[(plane * h + ih) * wd + iw];
                    iw = iw + 1;
                }
                ih = ih + 1;
            }
            out[t] = (E) (acc / (float32) ((h1 - h0) * (w1 - w0)));
        }
    }

    /** Max pooling with `argmax` receiving each output cell's flat input index; synced. */
    public static void max<E>(KernelBuffer<E> out, KernelBuffer<E> argmax, KernelBuffer<E> x,
                              int64 n, int64 c, int64 h, int64 wd, int64 oh, int64 ow, int32 k, int32 stride, int32 pad) {
        uint32 total = (uint32) (n * c * oh * ow);
        KernelStream s #= KernelStream.current();
        max2d.launch(s, grid: [(total + 255) / 256], block: [256])(out, argmax, x, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oh, (uint32) ow, k, stride, pad);
        s.sync();
    }

    /** Average pooling over the full k x k window; synced. */
    public static void avg<E>(KernelBuffer<E> out, KernelBuffer<E> x,
                              int64 n, int64 c, int64 h, int64 wd, int64 oh, int64 ow, int32 k, int32 stride, int32 pad) {
        uint32 total = (uint32) (n * c * oh * ow);
        KernelStream s #= KernelStream.current();
        avg2d.launch(s, grid: [(total + 255) / 256], block: [256])(out, x, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oh, (uint32) ow, k, stride, pad);
        s.sync();
    }

    /** Adaptive average pooling to (oh, ow); synced. */
    public static void adaptive<E>(KernelBuffer<E> out, KernelBuffer<E> x,
                                   int64 n, int64 c, int64 h, int64 wd, int64 oh, int64 ow) {
        uint32 total = (uint32) (n * c * oh * ow);
        KernelStream s #= KernelStream.current();
        adaptive2d.launch(s, grid: [(total + 255) / 256], block: [256])(out, x, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oh, (uint32) ow);
        s.sync();
    }

    /** Max-pool VJP: one lane per input element summing the cotangents of the windows whose argmax is it. */
    @Kernel
    public static void maxBack<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> argmax,
                                  uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oh, uint32 ow, int32 k, int32 stride, int32 pad) {
        uint32 t = KernelThread.globalIdX();
        if (t < n * c * h * wd) {
            uint32 iw = t % wd;
            uint32 q = t / wd;
            uint32 ih = q % h;
            uint32 plane = q / h;
            float32 acc = 0.0f;
            int32 a = 0;
            while (a < k) {
                int32 yn = (int32) ih + pad - a;
                if (yn >= 0 && yn - (yn / stride) * stride == 0 && yn / stride < (int32) oh) {
                    uint32 y = (uint32) (yn / stride);
                    int32 e = 0;
                    while (e < k) {
                        int32 xn = (int32) iw + pad - e;
                        if (xn >= 0 && xn - (xn / stride) * stride == 0 && xn / stride < (int32) ow) {
                            uint32 gi = (plane * oh + y) * ow + (uint32) (xn / stride);
                            if ((uint32) ((float32) argmax[gi]) == t) { acc = acc + (float32) g[gi]; }
                        }
                        e = e + 1;
                    }
                }
                a = a + 1;
            }
            dx[t] = (E) acc;
        }
    }

    /** Average-pool VJP: each covering window hands the input g / (k*k). */
    @Kernel
    public static void avgBack<E>(KernelBuffer<E> dx, KernelBuffer<E> g,
                                  uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oh, uint32 ow, int32 k, int32 stride, int32 pad) {
        uint32 t = KernelThread.globalIdX();
        if (t < n * c * h * wd) {
            uint32 iw = t % wd;
            uint32 q = t / wd;
            uint32 ih = q % h;
            uint32 plane = q / h;
            float32 acc = 0.0f;
            int32 a = 0;
            while (a < k) {
                int32 yn = (int32) ih + pad - a;
                if (yn >= 0 && yn - (yn / stride) * stride == 0 && yn / stride < (int32) oh) {
                    uint32 y = (uint32) (yn / stride);
                    int32 e = 0;
                    while (e < k) {
                        int32 xn = (int32) iw + pad - e;
                        if (xn >= 0 && xn - (xn / stride) * stride == 0 && xn / stride < (int32) ow) {
                            acc = acc + (float32) g[(plane * oh + y) * ow + (uint32) (xn / stride)];
                        }
                        e = e + 1;
                    }
                }
                a = a + 1;
            }
            dx[t] = (E) (acc / (float32) (k * k));
        }
    }

    /** Adaptive-average VJP: each output window containing the input hands it g / area. */
    @Kernel
    public static void adaptiveBack<E>(KernelBuffer<E> dx, KernelBuffer<E> g,
                                       uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oh, uint32 ow) {
        uint32 t = KernelThread.globalIdX();
        if (t < n * c * h * wd) {
            uint32 iw = t % wd;
            uint32 q = t / wd;
            uint32 ih = q % h;
            uint32 plane = q / h;
            float32 acc = 0.0f;
            uint32 y = 0;
            while (y < oh) {
                uint32 h0 = (y * h) / oh;
                uint32 h1 = ((y + 1) * h + oh - 1) / oh;
                if (ih >= h0 && ih < h1) {
                    uint32 xx = 0;
                    while (xx < ow) {
                        uint32 w0 = (xx * wd) / ow;
                        uint32 w1 = ((xx + 1) * wd + ow - 1) / ow;
                        if (iw >= w0 && iw < w1) {
                            acc = acc + (float32) g[(plane * oh + y) * ow + xx] / (float32) ((h1 - h0) * (w1 - w0));
                        }
                        xx = xx + 1;
                    }
                }
                y = y + 1;
            }
            dx[t] = (E) acc;
        }
    }

    /** The max-pool VJP into `dx` (n,c,h,wd) from `g` and the forward's `argmax`; synced. */
    public static void maxBackward<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> argmax,
                                      int64 n, int64 c, int64 h, int64 wd, int64 oh, int64 ow, int32 k, int32 stride, int32 pad) {
        uint32 total = (uint32) (n * c * h * wd);
        KernelStream s #= KernelStream.current();
        maxBack.launch(s, grid: [(total + 255) / 256], block: [256])(dx, g, argmax, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oh, (uint32) ow, k, stride, pad);
        s.sync();
    }

    /** The average-pool VJP; synced. */
    public static void avgBackward<E>(KernelBuffer<E> dx, KernelBuffer<E> g,
                                      int64 n, int64 c, int64 h, int64 wd, int64 oh, int64 ow, int32 k, int32 stride, int32 pad) {
        uint32 total = (uint32) (n * c * h * wd);
        KernelStream s #= KernelStream.current();
        avgBack.launch(s, grid: [(total + 255) / 256], block: [256])(dx, g, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oh, (uint32) ow, k, stride, pad);
        s.sync();
    }

    /** The adaptive-average VJP; synced. */
    public static void adaptiveBackward<E>(KernelBuffer<E> dx, KernelBuffer<E> g,
                                           int64 n, int64 c, int64 h, int64 wd, int64 oh, int64 ow) {
        uint32 total = (uint32) (n * c * h * wd);
        KernelStream s #= KernelStream.current();
        adaptiveBack.launch(s, grid: [(total + 255) / 256], block: [256])(dx, g, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oh, (uint32) ow);
        s.sync();
    }
}
