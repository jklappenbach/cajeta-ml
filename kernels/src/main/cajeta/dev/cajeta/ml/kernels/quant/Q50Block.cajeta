package dev.cajeta.ml.kernels.quant;

import cajeta.xpu.Vector;

/**
 * The Q5_0 block as pieces (kernel-drivers plan 8.3.1): 32 values in 22 bytes,
 * { f16 d; u8 qh[4]; u8 qs[16] }. Value `k` is a nibble of `qs[k % 16]` (low for k < 16) and bit
 * `k` of `qh`, 0..31, and a value is `d * (q - 16)`. Packed, quad `q` holds the bytes of values
 * `4q ..` and `16 + 4q ..`, and plane byte `k` holds bit `2q` for value `4q + k` and `2q + 1` for
 * `16 + 4q + k`. It meets the contract on {@link dev.cajeta.ml.kernels.gemm.Block32GemmRef}.
 */
public final class Q50Block {
    public Q50Block() { return; }

    @Device
    public static uint32 blockBytes() { return 22; }

    @Device
    public static uint32 quantOffset() { return 6; }

    @Device
    public static uint32 quads() { return 4; }

    @Device
    public static uint32 streams() { return 2; }

    @Device
    public static uint32 planeOffset() { return 2; }

    @Device
    public static uint32 planeBytes() { return 4; }

    /** The offset of `lowBytes`/`highBytes` of the file's own bytes read as signed. */
    @Device
    public static int32 fileOffset() { return 16; }

    @Device
    public static int32 offset() { return 16; }

    @Device
    public static float32 dOf(int32 h) { return Q4kBlock.halfBranchless(h & 65535); }

    @Device
    public static int32 packByte(int32 b) { return b & 255; }

    @Device
    public static int32 planeOf(int32 qh, int32 k) {
        int32 hb = 0;
        int32 q = 0;
        while (q < 4) {
            hb = hb | (((qh >> (4 * q + k)) & 1) << (2 * q)) | (((qh >> (16 + 4 * q + k)) & 1) << (2 * q + 1));
            q = q + 1;
        }
        return hb;
    }

    /** {@link #planeOf}'s four bytes from the raw `qh` word at once: each half's 4x4 bit matrix transposed, its bits spread two apart. */
    @Device
    public static int32 planeWordOf(int32 qh) {
        return Q50Block.spread(qh & 65535) | (Q50Block.spread((qh >> 16) & 65535) << 1);
    }

    /** Bit `4 q + k` of the 16-bit `x` moved to bit `8 k + 2 q`. */
    @Device
    static int32 spread(int32 x) {
        int32 t = (x ^ (x >> 3)) & 2570;
        int32 v = x ^ t ^ (t << 3);
        t = (v ^ (v >> 6)) & 204;
        v = v ^ t ^ (t << 6);
        int32 z = (v & 15) | ((v & 240) << 4) | ((v & 3840) << 8) | ((v & 61440) << 12);
        z = (z | (z << 2)) & 858993459;
        return (z | (z << 1)) & 1431655765;
    }

    @Device
    public static uint32 quantByte(uint32 k) { return 6 + (k & 15); }

    @Device
    public static uint32 planeByte(uint32 k) { return 2 + (k >> 3); }

    @Device
    public static int32 quant(int32 b, int32 plane, uint32 k) {
        return ((b >> (int32) (4 * (k >> 4))) & 15) | (((plane >> (int32) (k & 7)) & 1) << 4);
    }

    @Device
    public static int32 lowAt(int32 q) { return 4 * q; }

    @Device
    public static int32 highAt(int32 q) { return 16 + 4 * q; }

    @Device
    public static Vector<uint8,N> lowBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 k) {
        return (q & 15) | ((2 * k <= 4 ? plane.asSigned().asWords() << (4 - 2 * k) : plane.asSigned().asWords() >> (2 * k - 4)) & 269488144).asBytes().asUnsigned();
    }

    @Device
    public static Vector<uint8,N> highBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 k) {
        return ((q >> 4) & 15) | ((2 * k + 1 <= 4 ? plane.asSigned().asWords() << (3 - 2 * k) : plane.asSigned().asWords() >> (2 * k - 3)) & 269488144).asBytes().asUnsigned();
    }

    @Device
    public static float32 fold(float32 fs, float32 d, float32 xsj, int32 t, int32 gs) {
        return fs + d * (float32) (t - gs * 16);
    }

    @Device
    public static Vector<float32,8> fold8(Vector<float32,8> fs, Vector<float32,8> d, float32 xsj, Vector<int32,8> t, int32 gs) {
        return fs + d * (t - gs * 16).toF32();
    }

    @Device
    public static float32 close(float32 acc, float32 fs, float32 xs) { return acc + fs * xs; }

    @Device
    public static Vector<float32,8> close8(Vector<float32,8> acc, Vector<float32,8> fs, float32 xs) { return acc + fs * xs; }

    /** Values 0 to 15 as signed integers (less the offset), from the packed quant bytes `a` (0 to 15) and `b` (16 to 31): the float decode's view. */
    @Device
    public static Vector<int8,16> f32Low(Vector<int8,16> a, Vector<int8,16> b) { return (a & 15) - 16; }

    /** Values 16 to 31 as {@link #f32Low} gives 0 to 15. */
    @Device
    public static Vector<int8,16> f32High(Vector<int8,16> a, Vector<int8,16> b) { return ((a >> 4) & 15) - 16; }

    /** What a set plane bit adds to a value in the float decode; 0 when the format has no plane. */
    @Device
    public static int32 planeWeight() { return 16; }

    /** Value `k`'s plane bit in the raw `qh` word. */
    @Device
    public static int32 planeBit(int32 qh, int32 k) { return (qh >> k) & 1; }
}
