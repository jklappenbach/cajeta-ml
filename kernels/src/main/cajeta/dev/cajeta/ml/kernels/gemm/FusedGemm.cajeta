package dev.cajeta.ml.kernels.gemm;

import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/**
 * The f16 GEMM with a consumer's epilogue (spec §5.4): C[r][c] = Epi.apply(acc, r, c, aux0,
 * aux1, n), the consumer's `@Device` static over the accumulated value and two auxiliary
 * buffers (a bias, a residual, a scale table), fused into the store. The kernel body is the
 * 16x16 staged member of Gemm; the consumer instantiates the template, never copies it.
 */
public final class FusedGemm<Epi> {
    public FusedGemm() { return; }

    @Kernel
    public static void gemm(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                            KernelBuffer<float32> aux0, KernelBuffer<float32> aux1, uint32 m, uint32 n, uint32 k) {
        Shared<float16> sa = shared float16[256];
        Shared<float16> sb = shared float16[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<float16,16,16,0> ma;
        CooperativeMatrix<float16,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                float16 va = (float16) 0.0f;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                float16 vb = (float16) 0.0f;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[gm * n + gn] = Epi.apply(sc[o], gm, gn, aux0, aux1, n); }
            o = o + Workgroup.dimX();
        }
    }

    /** `c` (m x n) = Epi over `a` (m x k) . `b` (k x n) with `aux0` and `aux1` at the epilogue's disposal; synced. */
    public void run(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                    KernelBuffer<float32> aux0, KernelBuffer<float32> aux1, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm.launch(s, grid: [tiles], block: [64])(c, a, b, aux0, aux1, um, un, (uint32) k);
        s.sync();
    }
}
