package dev.cajeta.ml.kernels.quant;

import cajeta.lang.Cajeta;
import cajeta.xpu.Vector;

/**
 * The Q4_K block as pieces a GEMM or mat-vec driver calls (kernel-drivers spec §2): 256 values in
 * 144 bytes, { f16 d; f16 dmin; u8 scales[12]; u8 qs[128] }, eight sub-blocks of 32 values with a
 * 6-bit scale and min each. A value is `d * scale * q - dmin * min`. It meets the block piece
 * contract stated on {@link dev.cajeta.ml.kernels.gemm.BlockGemmRef}. Device and host call the same
 * methods.
 */
public final class Q4kBlock {
    public Q4kBlock() { return; }

    /** Bytes of one block. */
    @Device
    public static uint32 blockBytes() { return 144; }

    /** Offset of the quant bytes in a block. */
    @Device
    public static uint32 quantOffset() { return 16; }

    /** Bytes of quants in a block. */
    @Device
    public static uint32 quantBytes() { return 128; }

    /** Which 32-byte run of the quants the run `g` reads. */
    @Device
    public static int32 quantRun(int32 g) { return g; }

    /** Sub-blocks in a block, each with its own scale and min. */
    @Device
    public static uint32 subBlocks() { return 8; }

    /** Values in a sub-block. */
    @Device
    public static uint32 subValues() { return 32; }

    /** Offset in a block of the first 16 header bytes, which the header pieces take as `ha`. */
    @Device
    public static uint32 headOffset() { return 0; }

    /** Offset of the second 16 header bytes, taken as `hb`; equal to {@link #headOffset} when one load holds the header. */
    @Device
    public static uint32 head2Offset() { return 0; }

    /** When not 0, a value is `d * scale * (q - offset)`: there is no min table, and `minOf` answers `scaleOf`. */
    /** The largest stored quant times the largest scale magnitude; under 256 with `offset()` 0, a driver may fold the scale into the quant bytes. */
    @Device
    public static uint32 quantScaleMax() { return 945; }

    @Device
    public static uint32 offset() { return 0; }

    /** Which 32-byte run of the side plane the quant run `g` reads. */
    @Device
    public static int32 planeRun(int32 g) { return 0; }

    /** Offset in a block of the side-plane byte value `k` reads. */
    @Device
    public static uint32 planeByte(uint32 k) { return 0; }

    /** The 32-value stream, `32 s ..`, that the low nibbles of quant run `g` hold. */
    @Device
    public static int32 lowStream(int32 g) { return 2 * g; }

    /** The stream the high nibbles of quant run `g` hold. */
    @Device
    public static int32 highStream(int32 g) { return 2 * g + 1; }

    /** The block's scale step `d` from its header. */
    @Device
    public static float32 dOf(Vector<int32,4> ha, Vector<int32,4> hb) { return Q4kBlock.d(ha[0]); }

    /** The block's min step `dmin` from its header. */
    @Device
    public static float32 dminOf(Vector<int32,4> ha, Vector<int32,4> hb) { return Q4kBlock.dmin(ha[0]); }

    /** Sub-block `j`'s scale from the header. */
    @Device
    public static int32 scaleOf(Vector<int32,4> ha, Vector<int32,4> hb, uint32 j) { return Q4kBlock.scale(ha[1], ha[3], j); }

    /** Sub-block `j`'s min from the header. */
    @Device
    public static int32 minOf(Vector<int32,4> ha, Vector<int32,4> hb, uint32 j) { return Q4kBlock.min(ha[2], ha[3], j); }

    /** Offset in a block of the byte that holds value `k`, `k` in 0..255. */
    @Device
    public static uint32 quantByte(uint32 k) { return 16 + 32 * (k >> 6) + (k & 31); }

    /** Bytes of a side plane the quants need besides their own bytes; Q4_K has none. */
    @Device
    public static uint32 planeBytes() { return 0; }

    /** Offset in a block of the side plane. */
    @Device
    public static uint32 planeOffset() { return 0; }

    /** Value `k`'s quant, 0..15, out of the byte {@link #quantByte} names and the plane byte `k & 31` (unused here). */
    @Device
    public static int32 quant(int32 b, int32 plane, uint32 k) { return (b >> (int32) (4 * ((k >> 5) & 1))) & 15; }

    /** {@link #low} for four quant words of the pair `g` (sub-blocks `2 g` and `2 g + 1`); `plane` is the side plane's words at the same values. */
    @Device
    public static Vector<int32,4> lowWords(Vector<int32,4> quants, Vector<int32,4> plane, int32 g) { return quants & 252645135; }

    /** {@link #high} for four quant words of the pair `g`. */
    @Device
    public static Vector<int32,4> highWords(Vector<int32,4> quants, Vector<int32,4> plane, int32 g) { return (quants >> 4) & 252645135; }

    /** The low-nibble quants of 32 quant bytes of the pair `g`: for file bytes `32 g + i`, values `64 g + i`. */
    @Device
    public static Vector<uint8,N> lowBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 g) {
        return q & 15;
    }

    /** The high-nibble quants of 32 quant bytes of the pair `g`: for file bytes `32 g + i`, values `64 g + 32 + i`. */
    @Device
    public static Vector<uint8,N> highBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 g) {
        return (q >> 4) & 15;
    }

    /** {@link #add} for eight rows at once, one row a lane. */
    @Device
    public static Vector<float32,8> add8(Vector<float32,8> acc, Vector<float32,8> d, Vector<float32,8> dmin,
            float32 xs, Vector<int32,8> isum, Vector<int32,8> msum) {
        return acc + d * xs * isum.toF32() - dmin * xs * msum.toF32();
    }

    /** `acc` plus one block's part of a dot: `d * xs * isum - dmin * xs * msum`, with `isum` the sum of scale times sub-block dot and `msum` the sum of min times sub-block activation sum. */
    @Device
    public static float32 add(float32 acc, float32 d, float32 dmin, float32 xs, int32 isum, int32 msum) {
        return acc + d * xs * (float32) isum - dmin * xs * (float32) msum;
    }

    /** {@link #halfBits} without branches, for code where lanes diverge on it. */
    @Device
    public static float32 halfBranchless(int32 h) {
        int32 sgn = (h >> 15) << 31;
        int32 exp = (h >> 10) & 31;
        int32 man = h & 1023;
        int32 norm = sgn | ((exp + 112) << 23) | (man << 13);
        int32 inf = sgn | (255 << 23) | (man << 13);
        int32 sub = Cajeta.f32ToBits((float32) man * 5.9604644775390625e-8f) | sgn;
        int32 m0 = (exp - 1) >> 31;
        int32 m31 = (30 - exp) >> 31;
        int32 mn = (m0 | m31) ^ (0 - 1);
        return Cajeta.bitsToF32((norm & mn) | (inf & m31) | (sub & m0));
    }

    /** IEEE half bits (low 16 of `h`) as float32, exactly. */
    @Device
    public static float32 halfBits(int32 h) {
        int32 sign = (h >> 15) & 1;
        int32 exp = (h >> 10) & 31;
        int32 mant = h & 1023;
        int32 bits = 0;
        if (exp == 0) {
            if (mant == 0) { bits = sign << 31; }
            else {
                int32 e = 0;
                int32 mm = mant;
                while ((mm & 1024) == 0) { mm = mm << 1; e = e + 1; }
                bits = (sign << 31) | ((113 - e) << 23) | ((mm & 1023) << 13);
            }
        } else if (exp == 31) {
            bits = (sign << 31) | 2139095040 | (mant << 13);
        } else {
            bits = (sign << 31) | ((exp + 112) << 23) | (mant << 13);
        }
        return Cajeta.bitsToF32(bits);
    }

    /** `d` from header word 0. */
    @Device
    public static float32 d(int32 h0) { return Q4kBlock.halfBits(h0 & 65535); }

    /** `dmin` from header word 0. */
    @Device
    public static float32 dmin(int32 h0) { return Q4kBlock.halfBits((h0 >> 16) & 65535); }

    /** Sub-block `j`'s 6-bit scale, `j` in 0..7; branch-free, so lanes with different `j` do not diverge. */
    @Device
    public static int32 scale(int32 h1, int32 h3, uint32 j) {
        int32 s = (int32) (8 * (j & 3));
        int32 hi = 0 - (int32) ((j >> 2) & 1);
        return (((h3 >> s) & 15) | ((((h1 >> s) & 255) >> 2) & 48)) & hi | ((h1 >> s) & 63) & (hi ^ (0 - 1));
    }

    /** Sub-block `j`'s 6-bit min, `j` in 0..7. */
    @Device
    public static int32 min(int32 h2, int32 h3, uint32 j) {
        int32 s = (int32) (8 * (j & 3));
        int32 hi = 0 - (int32) ((j >> 2) & 1);
        return ((((h3 >> s) & 255) >> 4) | ((((h2 >> s) & 255) >> 2) & 48)) & hi | ((h2 >> s) & 63) & (hi ^ (0 - 1));
    }

    /** The four low-nibble values of a quant word: values `k .. k+3` of a 64-value run's first half. */
    @Device
    public static int32 low(int32 quants) { return quants & 252645135; }

    /** The four high-nibble values of a quant word: values `k+32 .. k+35` of the run. */
    @Device
    public static int32 high(int32 quants) { return (quants >> 4) & 252645135; }
}
