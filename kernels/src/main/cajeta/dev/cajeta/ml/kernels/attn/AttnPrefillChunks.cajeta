package dev.cajeta.ml.kernels.attn;

import cajeta.lang.Cajeta;
import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Unroll;
import cajeta.xpu.Vector;

/**
 * The cpu driver of prefill attention in 256-key chunks (kernel-drivers 9.3.7): one work item a (kv head, query row)
 * runs its kv head's `nH / nKv` query heads over the row's causal positions (`startPos + r + 1`,
 * cut to the last `window` when it is not 0) and writes each head's attention to `out`, laid out as
 * `q` (`rows * nH * HD` float32). Keys and values are float16 rows of `nKv * HD`, paged
 * ({@link PagedRows}). Rows are taken light and heavy in turn so each worker's share of the causal
 * triangle is even. A chunk's scores for two query heads and their max come first, then one
 * rescale, the exps by a polynomial, and the values, with the rows of `out` as the accumulators:
 * cajeta-llm's `attnPrefillCpuGqa256Kernel` at any head size (its decode at 256 too), bit for bit.
 */
@Instantiate({AttnPrefillChunks<128>, AttnPrefillChunks<256>})
@Requires(HD % 64 == 0)
public final class AttnPrefillChunks<uint32 HD> {
    public AttnPrefillChunks() { return; }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + chunked.registeredName(); }

    /** Query row `r` of a work item `j` of `rows`: light and heavy rows in turn. */
    @Device
    static uint32 rowOf(uint32 j, uint32 rows) { return j % 2 == 0 ? j / 2 : rows - 1 - j / 2; }

    /** Lanes 8 apart summed first, then pairwise: cajeta-llm's `Prim.sum16`. */
    @Device
    static float32 sum16(Vector<float32,16> s) {
        return (((s[0] + s[8]) + (s[4] + s[12])) + ((s[2] + s[10]) + (s[6] + s[14])))
            + (((s[1] + s[9]) + (s[5] + s[13])) + ((s[3] + s[11]) + (s[7] + s[15])));
    }

    /** 256 keys a chunk, two query heads a pass: a chunk's scores and their max first, one rescale, the exps by a polynomial, then the values, with the rows of `out` as the accumulators. */
    @Kernel(targets = {"cpu"})
    @Occupancy(maxThreads = 256)
    public static void chunked(KernelBuffer<float32> out, KernelBuffer<float32> q, KernelBuffer<float16> kPool,
            KernelBuffer<float16> vPool, KernelBuffer<int32> pgTab, uint32 pgBase, uint32 rows, uint32 nH,
            uint32 nKv, uint32 startPos, float32 scale, uint32 window) {
        Shared<float32> pa = shared float32[256];
        Shared<float32> pb = shared float32[256];
        Shared<int32> ja = shared int32[256];
        Shared<int32> jb = shared int32[256];
        Barrier.workgroup();
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows * nKv) {
            uint32 kvh = gi / rows;
            uint32 r = AttnPrefillChunks.rowOf(gi % rows, rows);
            int64 hd = (int64) HD;
            int64 kvDim = (int64) nKv * hd;
            int64 kb = (int64) kvh * hd;
            uint32 count = startPos + r + 1;
            uint32 t0 = 0;
            if (window > 0 && count > window) { t0 = count - window; }
            uint32 g = nH / nKv;
            uint32 h = 0;
            while (h < g) {
                boolean two = h + 1 < g;
                int64 qa = (int64) r * (int64) nH * hd + (int64) (kvh * g + h) * hd;
                int64 qb = two ? qa + hd : qa;
                Vector<float32,16> z = q.vload<16>(qa) * 0.0f;
                int64 d = 0L;
                while (d < hd) {
                    out.vstore(qa + d, z);
                    out.vstore(qb + d, z);
                    d = d + 16L;
                }
                float32 ma = -1.0e30f;
                float32 mb = -1.0e30f;
                float32 la = 0.0f;
                float32 lb = 0.0f;
                uint32 c0 = t0;
                while (c0 < count) {
                    uint32 cn = count - c0 < 256 ? count - c0 : 256;
                    float32 ca = -1.0e30f;
                    float32 cb = -1.0e30f;
                    uint32 t = 0;
                    while (t < cn) {
                        int64 ko = (int64) PagedRows.row(pgTab, pgBase, c0 + t) * kvDim + kb;
                        Vector<float32,16> a0 = z;
                        Vector<float32,16> a1 = z;
                        Vector<float32,16> a2 = z;
                        Vector<float32,16> a3 = z;
                        Vector<float32,16> b0 = z;
                        Vector<float32,16> b1 = z;
                        Vector<float32,16> b2 = z;
                        Vector<float32,16> b3 = z;
                        d = 0L;
                        while (d < hd) {
                            Vector<float32,16> k0 = kPool.vload<16>(ko + d).toF32();
                            Vector<float32,16> k1 = kPool.vload<16>(ko + d + 16L).toF32();
                            Vector<float32,16> k2 = kPool.vload<16>(ko + d + 32L).toF32();
                            Vector<float32,16> k3 = kPool.vload<16>(ko + d + 48L).toF32();
                            a0 = Math.fma(q.vload<16>(qa + d), k0, a0);
                            b0 = Math.fma(q.vload<16>(qb + d), k0, b0);
                            a1 = Math.fma(q.vload<16>(qa + d + 16L), k1, a1);
                            b1 = Math.fma(q.vload<16>(qb + d + 16L), k1, b1);
                            a2 = Math.fma(q.vload<16>(qa + d + 32L), k2, a2);
                            b2 = Math.fma(q.vload<16>(qb + d + 32L), k2, b2);
                            a3 = Math.fma(q.vload<16>(qa + d + 48L), k3, a3);
                            b3 = Math.fma(q.vload<16>(qb + d + 48L), k3, b3);
                            d = d + 64L;
                        }
                        float32 sa = AttnPrefillChunks.sum16((a0 + a1) + (a2 + a3)) * scale;
                        float32 sb = AttnPrefillChunks.sum16((b0 + b1) + (b2 + b3)) * scale;
                        pa[t] = sa;
                        pb[t] = sb;
                        if (sa > ca) { ca = sa; }
                        if (sb > cb) { cb = sb; }
                        t = t + 1;
                    }
                    if (ca > ma) {
                        float32 c = Math.exp(ma - ca);
                        d = 0L;
                        while (d < hd) {
                            out.vstore(qa + d, out.vload<16>(qa + d) * c);
                            d = d + 16L;
                        }
                        la = la * c;
                        ma = ca;
                    }
                    if (cb > mb) {
                        float32 c = Math.exp(mb - cb);
                        d = 0L;
                        while (two && d < hd) {
                            out.vstore(qb + d, out.vload<16>(qb + d) * c);
                            d = d + 16L;
                        }
                        lb = lb * c;
                        mb = cb;
                    }
                    uint32 u = cn;
                    while (u % 16 != 0) {
                        pa[u] = -1.0e30f;
                        pb[u] = -1.0e30f;
                        u = u + 1;
                    }
                    Vector<float32,16> lo = z - 87.0f;
                    t = 0;
                    while (t < cn) {
                        Vector<float32,16> xa = pa.vload<16>((int64) t) - ma;
                        Vector<float32,16> xb = pb.vload<16>((int64) t) - mb;
                        xa = xa.max(lo);
                        xb = xb.max(lo);
                        Vector<float32,16> ya = xa * 1.44269504f - 0.5f;
                        Vector<float32,16> yb = xb * 1.44269504f - 0.5f;
                        Vector<int32,16> na = ya.toI32();
                        Vector<int32,16> nb = yb.toI32();
                        Vector<float32,16> fa = na.toF32();
                        Vector<float32,16> fb = nb.toF32();
                        Vector<float32,16> ra = xa - fa * 0.693359375f + fa * 0.000212194440f;
                        Vector<float32,16> rb = xb - fb * 0.693359375f + fb * 0.000212194440f;
                        Vector<float32,16> ea = ra * 0.00019875691500f + 0.0013981999507f;
                        Vector<float32,16> eb = rb * 0.00019875691500f + 0.0013981999507f;
                        ea = ea * ra + 0.0083334519073f;
                        eb = eb * rb + 0.0083334519073f;
                        ea = ea * ra + 0.041665795894f;
                        eb = eb * rb + 0.041665795894f;
                        ea = ea * ra + 0.16666665459f;
                        eb = eb * rb + 0.16666665459f;
                        ea = ea * ra + 0.50000001201f;
                        eb = eb * rb + 0.50000001201f;
                        pa.vstore((int64) t, ea * ra * ra + ra + 1.0f);
                        pb.vstore((int64) t, eb * rb * rb + rb + 1.0f);
                        ja.vstore((int64) t, na);
                        jb.vstore((int64) t, nb);
                        t = t + 16;
                    }
                    t = 0;
                    while (t < cn) {
                        float32 wa = pa[t] * Cajeta.bitsToF32((ja[t] + 127) << 23);
                        float32 wb = pb[t] * Cajeta.bitsToF32((jb[t] + 127) << 23);
                        pa[t] = wa;
                        pb[t] = wb;
                        la = la + wa;
                        lb = lb + wb;
                        t = t + 1;
                    }
                    d = 0L;
                    while (d < hd) {
                        Vector<float32,16> x0 = out.vload<16>(qa + d);
                        Vector<float32,16> x1 = out.vload<16>(qa + d + 16L);
                        Vector<float32,16> x2 = out.vload<16>(qa + d + 32L);
                        Vector<float32,16> x3 = out.vload<16>(qa + d + 48L);
                        Vector<float32,16> y0 = out.vload<16>(qb + d);
                        Vector<float32,16> y1 = out.vload<16>(qb + d + 16L);
                        Vector<float32,16> y2 = out.vload<16>(qb + d + 32L);
                        Vector<float32,16> y3 = out.vload<16>(qb + d + 48L);
                        t = 0;
                        while (t < cn) {
                            int64 vo = (int64) PagedRows.row(pgTab, pgBase, c0 + t) * kvDim + kb + d;
                            Vector<float32,16> wa = z + pa[t];
                            Vector<float32,16> wb = z + pb[t];
                            Vector<float32,16> v0 = vPool.vload<16>(vo).toF32();
                            Vector<float32,16> v1 = vPool.vload<16>(vo + 16L).toF32();
                            Vector<float32,16> v2 = vPool.vload<16>(vo + 32L).toF32();
                            Vector<float32,16> v3 = vPool.vload<16>(vo + 48L).toF32();
                            x0 = Math.fma(v0, wa, x0);
                            y0 = Math.fma(v0, wb, y0);
                            x1 = Math.fma(v1, wa, x1);
                            y1 = Math.fma(v1, wb, y1);
                            x2 = Math.fma(v2, wa, x2);
                            y2 = Math.fma(v2, wb, y2);
                            x3 = Math.fma(v3, wa, x3);
                            y3 = Math.fma(v3, wb, y3);
                            t = t + 1;
                        }
                        if (two) {
                            out.vstore(qb + d, y0);
                            out.vstore(qb + d + 16L, y1);
                            out.vstore(qb + d + 32L, y2);
                            out.vstore(qb + d + 48L, y3);
                        }
                        out.vstore(qa + d, x0);
                        out.vstore(qa + d + 16L, x1);
                        out.vstore(qa + d + 32L, x2);
                        out.vstore(qa + d + 48L, x3);
                        d = d + 64L;
                    }
                    c0 = c0 + cn;
                }
                float32 ia = 1.0f / la;
                float32 ib = 1.0f / lb;
                d = 0L;
                while (d < hd) {
                    out.vstore(qa + d, out.vload<16>(qa + d) * ia);
                    d = d + 16L;
                }
                d = 0L;
                while (two && d < hd) {
                    out.vstore(qb + d, out.vload<16>(qb + d) * ib);
                    d = d + 16L;
                }
                h = h + 2;
            }
        }
    }

    /** `rows` query rows from position `startPos` (`window` 0 the whole causal range) into `out`, `block` work items a workgroup. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> out, KernelBuffer<float32> q, KernelBuffer<float16> kPool,
            KernelBuffer<float16> vPool, KernelBuffer<int32> pgTab, int32 pgBase, int32 rows, int32 nH, int32 nKv,
            int32 startPos, float32 scale, int32 window, int32 block) {
        uint32 n = (uint32) (rows * nKv);
        uint32 blk = (uint32) block;
        chunked.launch(s, grid: [(n + blk - 1) / blk], block: [blk])
            (out, q, kPool, vPool, pgTab, (uint32) pgBase, (uint32) rows, (uint32) nH, (uint32) nKv, (uint32) startPos,
             scale, (uint32) window);
    }
}
