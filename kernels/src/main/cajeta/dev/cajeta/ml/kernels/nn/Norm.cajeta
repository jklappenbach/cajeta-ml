package dev.cajeta.ml.kernels.nn;

import cajeta.lang.Math;
import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/** Row normalisations (spec §6.1): one workgroup of 256 lanes per row, the statistics a shared-memory tree, float32 arithmetic at any E. llm's rmsnormRow. */
public final class Norm {
    public Norm() { return; }

    @Kernel
    public static void rmsnorm<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, uint32 cols, float32 eps) {
        Shared<float32> part = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 base = Workgroup.x() * cols;
        float32 ss = 0.0f;
        uint32 i = lane;
        while (i < cols) {
            float32 v = (float32) x[base + i];
            ss = ss + v * v;
            i = i + 256;
        }
        part[lane] = ss;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 scale = 1.0f / Math.sqrt(part[0] / (float32) cols + eps);
        uint32 j = lane;
        while (j < cols) {
            out[base + j] = (E) ((float32) x[base + j] * scale * (float32) w[j]);
            j = j + 256;
        }
    }

    @Kernel
    public static void layernorm<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b, uint32 cols, float32 eps) {
        Shared<float32> part = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 base = Workgroup.x() * cols;
        float32 sum = 0.0f;
        uint32 i = lane;
        while (i < cols) { sum = sum + (float32) x[base + i]; i = i + 256; }
        part[lane] = sum;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 mean = part[0] / (float32) cols;
        Barrier.workgroup();
        float32 sq = 0.0f;
        i = lane;
        while (i < cols) {
            float32 d = (float32) x[base + i] - mean;
            sq = sq + d * d;
            i = i + 256;
        }
        part[lane] = sq;
        Barrier.workgroup();
        s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 inv = 1.0f / Math.sqrt(part[0] / (float32) cols + eps);
        uint32 j = lane;
        while (j < cols) {
            out[base + j] = (E) (((float32) x[base + j] - mean) * inv * (float32) w[j] + (float32) b[j]);
            j = j + 256;
        }
    }

    /** layernorm that also saves each element's xhat and each row's 1/std, the backward's state. */
    @Kernel
    public static void layernormSaved<E>(KernelBuffer<E> out, KernelBuffer<E> xhat, KernelBuffer<E> invstd, KernelBuffer<E> x,
                                         KernelBuffer<E> w, KernelBuffer<E> b, uint32 cols, float32 eps) {
        Shared<float32> part = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 row = Workgroup.x();
        uint32 base = row * cols;
        float32 acc = 0.0f;
        uint32 i = lane;
        while (i < cols) { acc = acc + (float32) x[base + i]; i = i + 256; }
        part[lane] = acc;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 mu = part[0] / (float32) cols;
        Barrier.workgroup();
        float32 dev = 0.0f;
        i = lane;
        while (i < cols) { float32 d = (float32) x[base + i] - mu; dev = dev + d * d; i = i + 256; }
        part[lane] = dev;
        Barrier.workgroup();
        s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 iv = 1.0f / Math.sqrt(part[0] / (float32) cols + eps);
        if (lane == 0) { invstd[row] = (E) iv; }
        uint32 j = lane;
        while (j < cols) {
            float32 xh = ((float32) x[base + j] - mu) * iv;
            xhat[base + j] = (E) xh;
            out[base + j] = (E) ((float32) w[j] * xh + (float32) b[j]);
            j = j + 256;
        }
    }

    /** Each row scaled to unit L2 norm, the norm floored at `eps` so a zero row stays zero. */
    @Kernel
    public static void l2norm<E>(KernelBuffer<E> out, KernelBuffer<E> x, uint32 cols, float32 eps) {
        Shared<float32> part = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 base = Workgroup.x() * cols;
        float32 ss = 0.0f;
        uint32 i = lane;
        while (i < cols) {
            float32 v = (float32) x[base + i];
            ss = ss + v * v;
            i = i + 256;
        }
        part[lane] = ss;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 nrm = Math.sqrt(part[0]);
        if (nrm < eps) { nrm = eps; }
        float32 scale = 1.0f / nrm;
        uint32 j = lane;
        while (j < cols) {
            out[base + j] = (E) ((float32) x[base + j] * scale);
            j = j + 256;
        }
    }

    /** The row-normalisation VJP: (g - y <g, y>) / max(|x|, eps), with y the normalised row. */
    @Kernel
    public static void l2normBack<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> y, KernelBuffer<E> g, uint32 cols, float32 eps) {
        Shared<float32> ps = shared float32[256];
        Shared<float32> pd = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 base = Workgroup.x() * cols;
        float32 sq = 0.0f;
        float32 dot = 0.0f;
        uint32 i = lane;
        while (i < cols) {
            float32 xv = (float32) x[base + i];
            sq = sq + xv * xv;
            dot = dot + (float32) g[base + i] * (float32) y[base + i];
            i = i + 256;
        }
        ps[lane] = sq;
        pd[lane] = dot;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { ps[lane] = ps[lane] + ps[lane + s]; pd[lane] = pd[lane] + pd[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 nrm = Math.sqrt(ps[0]);
        if (nrm < eps) { nrm = eps; }
        float32 d = pd[0];
        uint32 j = lane;
        while (j < cols) {
            out[base + j] = (E) (((float32) g[base + j] - (float32) y[base + j] * d) / nrm);
            j = j + 256;
        }
    }

    /** The layernorm input VJP per row: invstd/d * (d*dxh - sum dxh - xhat * sum dxh*xhat), dxh = g*w. */
    @Kernel
    public static void layernormBack<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> xhat, KernelBuffer<E> w, KernelBuffer<E> invstd, uint32 cols) {
        Shared<float32> pa = shared float32[256];
        Shared<float32> pb = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 row = Workgroup.x();
        uint32 base = row * cols;
        float32 sa = 0.0f;
        float32 sb = 0.0f;
        uint32 i = lane;
        while (i < cols) {
            float32 dxh = (float32) g[base + i] * (float32) w[i];
            sa = sa + dxh;
            sb = sb + dxh * (float32) xhat[base + i];
            i = i + 256;
        }
        pa[lane] = sa;
        pb[lane] = sb;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { pa[lane] = pa[lane] + pa[lane + s]; pb[lane] = pb[lane] + pb[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 sumDx = pa[0];
        float32 sumDxXh = pb[0];
        float32 iv = (float32) invstd[row];
        float32 d = (float32) cols;
        uint32 j = lane;
        while (j < cols) {
            float32 dxh = (float32) g[base + j] * (float32) w[j];
            dx[base + j] = (E) (iv / d * (d * dxh - sumDx - (float32) xhat[base + j] * sumDxXh));
            j = j + 256;
        }
    }

    /** dw[j] = sum over rows of g*xhat and db[j] = sum of g: one lane per column. */
    @Kernel
    public static void layernormParamGrads<E>(KernelBuffer<E> dw, KernelBuffer<E> db, KernelBuffer<E> g, KernelBuffer<E> xhat, uint32 rows, uint32 cols) {
        uint32 j = KernelThread.globalIdX();
        if (j < cols) {
            float32 sa = 0.0f;
            float32 sb = 0.0f;
            uint32 r = 0;
            while (r < rows) {
                float32 gv = (float32) g[r * cols + j];
                sa = sa + gv * (float32) xhat[r * cols + j];
                sb = sb + gv;
                r = r + 1;
            }
            dw[j] = (E) sa;
            db[j] = (E) sb;
        }
    }

    /** `out` = rmsnorm of each of `rows` rows of `x` (rows x cols) scaled by `w`; synced. */
    public static void rms<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, int64 rows, int64 cols, float32 eps) {
        KernelStream s #= KernelStream.current();
        rmsnorm.launch(s, grid: [(uint32) rows], block: [256])(out, x, w, (uint32) cols, eps);
        s.sync();
    }

    /** `out` = layernorm of each row of `x` with scale `w` and shift `b`; synced. */
    public static void layer<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b, int64 rows, int64 cols, float32 eps) {
        KernelStream s #= KernelStream.current();
        layernorm.launch(s, grid: [(uint32) rows], block: [256])(out, x, w, b, (uint32) cols, eps);
        s.sync();
    }

    /** layernorm of each row with the saved xhat and per-row invstd; synced. */
    public static void layerSaved<E>(KernelBuffer<E> out, KernelBuffer<E> xhat, KernelBuffer<E> invstd, KernelBuffer<E> x,
                                     KernelBuffer<E> w, KernelBuffer<E> b, int64 rows, int64 cols, float32 eps) {
        KernelStream s #= KernelStream.current();
        layernormSaved.launch(s, grid: [(uint32) rows], block: [256])(out, xhat, invstd, x, w, b, (uint32) cols, eps);
        s.sync();
    }

    /** The row-normalisation VJP over `rows` rows, `y` the normalised rows; synced. */
    public static void l2rowsBack<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> y, KernelBuffer<E> g, int64 rows, int64 cols, float32 eps) {
        KernelStream s #= KernelStream.current();
        l2normBack.launch(s, grid: [(uint32) rows], block: [256])(out, x, y, g, (uint32) cols, eps);
        s.sync();
    }

    /** The layernorm input VJP over `rows` rows; synced. */
    public static void layerBack<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> xhat, KernelBuffer<E> w, KernelBuffer<E> invstd, int64 rows, int64 cols) {
        KernelStream s #= KernelStream.current();
        layernormBack.launch(s, grid: [(uint32) rows], block: [256])(dx, g, xhat, w, invstd, (uint32) cols);
        s.sync();
    }

    /** The layernorm scale and shift VJPs summed over `rows`; synced. */
    public static void layerParamGrads<E>(KernelBuffer<E> dw, KernelBuffer<E> db, KernelBuffer<E> g, KernelBuffer<E> xhat, int64 rows, int64 cols) {
        uint32 uc = (uint32) cols;
        KernelStream s #= KernelStream.current();
        layernormParamGrads.launch(s, grid: [(uc + 255) / 256], block: [256])(dw, db, g, xhat, (uint32) rows, uc);
        s.sync();
    }

    /** `out` = each of `rows` rows of `x` scaled to unit L2 norm, the norm floored at `eps`; synced. */
    public static void l2rows<E>(KernelBuffer<E> out, KernelBuffer<E> x, int64 rows, int64 cols, float32 eps) {
        KernelStream s #= KernelStream.current();
        l2norm.launch(s, grid: [(uint32) rows], block: [256])(out, x, (uint32) cols, eps);
        s.sync();
    }
}
