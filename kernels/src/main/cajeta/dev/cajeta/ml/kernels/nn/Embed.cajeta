package dev.cajeta.ml.kernels.nn;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Workgroup;

/** The embedding row gather (spec §6.5): one workgroup per token id copies its row of the table into float32. llm's embedRow. */
public final class Embed {
    public Embed() { return; }

    @Kernel
    public static void embed<E>(KernelBuffer<float32> out, KernelBuffer<E> table, KernelBuffer<int32> ids, uint32 dim) {
        uint32 lane = KernelThread.x();
        uint32 w = Workgroup.x();
        uint32 row = (uint32) ids[w];
        uint32 e = lane;
        while (e < dim) {
            out[w * dim + e] = (float32) table[row * dim + e];
            e = e + 256;
        }
    }

    /** `out` (n x dim, float32) = the rows of `table` named by `ids`; synced. */
    public static void rows<E>(KernelBuffer<float32> out, KernelBuffer<E> table, KernelBuffer<int32> ids, int64 n, int64 dim) {
        KernelStream s #= KernelStream.current();
        embed.launch(s, grid: [(uint32) n], block: [256])(out, table, ids, (uint32) dim);
        s.sync();
    }

    /** out[i][j] = table[ids[i]][j] with ids carried as E values (exact below 2^24); an id outside the table reads as 0. */
    @Kernel
    public static void embedF<E>(KernelBuffer<E> out, KernelBuffer<E> table, KernelBuffer<E> ids, uint32 total, uint32 dim, uint32 vocab) {
        uint32 t = KernelThread.globalIdX();
        if (t < total) {
            uint32 row = t / dim;
            uint32 j = t - row * dim;
            float32 idf = (float32) ids[row];
            E v = (E) 0;
            if (idf >= 0.0f && idf < (float32) vocab) { v = table[(uint32) idf * dim + j]; }
            out[t] = v;
        }
    }

    /** out (n x dim) = the rows of `table` (vocab x dim) at the E-valued `ids`; synced. */
    public static void rowsAt<E>(KernelBuffer<E> out, KernelBuffer<E> table, KernelBuffer<E> ids, int64 n, int64 dim, int64 vocab) {
        uint32 total = (uint32) (n * dim);
        KernelStream s #= KernelStream.current();
        embedF.launch(s, grid: [(total + 255) / 256], block: [256])(out, table, ids, total, (uint32) dim, (uint32) vocab);
        s.sync();
    }

    /** dw[v][j] = sum of g[i][j] over the rows i whose id is v: one lane per table element scanning the ids, no atomics. */
    @Kernel
    public static void embedScatterAdd<E>(KernelBuffer<E> dw, KernelBuffer<E> g, KernelBuffer<E> ids, uint32 vocab, uint32 dim, uint32 n) {
        uint32 t = KernelThread.globalIdX();
        if (t < vocab * dim) {
            uint32 v = t / dim;
            uint32 j = t - v * dim;
            float32 acc = 0.0f;
            uint32 i = 0;
            while (i < n) {
                if ((float32) ids[i] == (float32) v) { acc = acc + (float32) g[i * dim + j]; }
                i = i + 1;
            }
            dw[t] = (E) acc;
        }
    }

    /** The embedding VJP: `g` (n x dim) scattered and summed into `dw` (vocab x dim) by the E-valued `ids`; synced. */
    public static void scatterRows<E>(KernelBuffer<E> dw, KernelBuffer<E> g, KernelBuffer<E> ids, int64 vocab, int64 dim, int64 n) {
        uint32 total = (uint32) (vocab * dim);
        KernelStream s #= KernelStream.current();
        embedScatterAdd.launch(s, grid: [(total + 255) / 256], block: [256])(dw, g, ids, (uint32) vocab, (uint32) dim, (uint32) n);
        s.sync();
    }
}
