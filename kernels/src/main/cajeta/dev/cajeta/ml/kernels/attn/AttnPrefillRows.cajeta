package dev.cajeta.ml.kernels.attn;

import cajeta.lang.Cajeta;
import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Unroll;
import cajeta.xpu.Vector;

/**
 * The cpu driver of prefill attention (kernel-drivers 9.3.7): one work item a (kv head, query row)
 * runs its kv head's `nH / nKv` query heads over the row's causal positions (`startPos + r + 1`,
 * cut to the last `window` when it is not 0) and writes each head's attention to `out`, laid out as
 * `q` (`rows * nH * HD` float32). Keys and values are float16 rows of `nKv * HD`, paged
 * ({@link PagedRows}). Rows are taken light and heavy in turn so each worker's share of the causal
 * triangle is even. {@link #prefill} folds one key at a time in cajeta-llm's
 * `attnPrefillCpuGqaKernel`'s form (eight 16-wide query and accumulator vectors, the score one sum
 * of products), and equals it bit for bit; {@link AttnPrefillChunks} is the chunked form.
 */
@Instantiate({AttnPrefillRows<128>})
@Requires(HD == 128)
public final class AttnPrefillRows<uint32 HD> {
    public AttnPrefillRows() { return; }

    /** The one-key member's registered kernel. */
    public #String kernel() { return "" + prefill.registeredName(); }

    /** Query row `r` of a work item `j` of `rows`: light and heavy rows in turn. */
    @Device
    static uint32 rowOf(uint32 j, uint32 rows) { return j % 2 == 0 ? j / 2 : rows - 1 - j / 2; }

    /** One key at a time: the online softmax's rescale on a new max and one exp a key. */
    @Kernel(targets = {"cpu"}) @FastMath
    @Occupancy(maxThreads = 256)
    public static void prefill(KernelBuffer<float32> out, KernelBuffer<float32> q, KernelBuffer<float16> kPool,
            KernelBuffer<float16> vPool, KernelBuffer<int32> pgTab, uint32 pgBase, uint32 rows, uint32 nH,
            uint32 nKv, uint32 startPos, float32 scale, uint32 window) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows * nKv) {
            uint32 kvh = gi / rows;
            uint32 r = AttnPrefillRows.rowOf(gi % rows, rows);
            int64 kvDim = (int64) (nKv * HD);
            int64 kb = (int64) (kvh * HD);
            uint32 count = startPos + r + 1;
            uint32 t0 = 0;
            if (window > 0 && count > window) { t0 = count - window; }
            uint32 g = nH / nKv;
            uint32 h = 0;
            while (h < g) {
                int64 qo = (int64) r * (int64) (nH * HD) + (int64) ((kvh * g + h) * HD);
                Vector<float32,16> q0 = q.vload<16>(qo) * scale;
                Vector<float32,16> q1 = q.vload<16>(qo + 16L) * scale;
                Vector<float32,16> q2 = q.vload<16>(qo + 32L) * scale;
                Vector<float32,16> q3 = q.vload<16>(qo + 48L) * scale;
                Vector<float32,16> q4 = q.vload<16>(qo + 64L) * scale;
                Vector<float32,16> q5 = q.vload<16>(qo + 80L) * scale;
                Vector<float32,16> q6 = q.vload<16>(qo + 96L) * scale;
                Vector<float32,16> q7 = q.vload<16>(qo + 112L) * scale;
                Vector<float32,16> a0 = q0 * 0.0f;
                Vector<float32,16> a1 = a0;
                Vector<float32,16> a2 = a0;
                Vector<float32,16> a3 = a0;
                Vector<float32,16> a4 = a0;
                Vector<float32,16> a5 = a0;
                Vector<float32,16> a6 = a0;
                Vector<float32,16> a7 = a0;
                float32 m = -1.0e30f;
                float32 l = 0.0f;
                uint32 t = t0;
                while (t < count) {
                    int64 ko = (int64) PagedRows.row(pgTab, pgBase, t) * kvDim + kb;
                    Vector<float32,16> d = q0 * kPool.vload<16>(ko).toF32()
                        + q1 * kPool.vload<16>(ko + 16L).toF32()
                        + q2 * kPool.vload<16>(ko + 32L).toF32()
                        + q3 * kPool.vload<16>(ko + 48L).toF32()
                        + q4 * kPool.vload<16>(ko + 64L).toF32()
                        + q5 * kPool.vload<16>(ko + 80L).toF32()
                        + q6 * kPool.vload<16>(ko + 96L).toF32()
                        + q7 * kPool.vload<16>(ko + 112L).toF32();
                    float32 sc = ((d[0] + d[1]) + (d[2] + d[3])) + ((d[4] + d[5]) + (d[6] + d[7]))
                        + (((d[8] + d[9]) + (d[10] + d[11])) + ((d[12] + d[13]) + (d[14] + d[15])));
                    if (sc > m) {
                        float32 c = Math.exp(m - sc);
                        a0 = a0 * c;
                        a1 = a1 * c;
                        a2 = a2 * c;
                        a3 = a3 * c;
                        a4 = a4 * c;
                        a5 = a5 * c;
                        a6 = a6 * c;
                        a7 = a7 * c;
                        l = l * c;
                        m = sc;
                    }
                    float32 p = Math.exp(sc - m);
                    l = l + p;
                    a0 = a0 + vPool.vload<16>(ko).toF32() * p;
                    a1 = a1 + vPool.vload<16>(ko + 16L).toF32() * p;
                    a2 = a2 + vPool.vload<16>(ko + 32L).toF32() * p;
                    a3 = a3 + vPool.vload<16>(ko + 48L).toF32() * p;
                    a4 = a4 + vPool.vload<16>(ko + 64L).toF32() * p;
                    a5 = a5 + vPool.vload<16>(ko + 80L).toF32() * p;
                    a6 = a6 + vPool.vload<16>(ko + 96L).toF32() * p;
                    a7 = a7 + vPool.vload<16>(ko + 112L).toF32() * p;
                    t = t + 1;
                }
                float32 inv = 1.0f / l;
                out.vstore(qo, a0 * inv);
                out.vstore(qo + 16L, a1 * inv);
                out.vstore(qo + 32L, a2 * inv);
                out.vstore(qo + 48L, a3 * inv);
                out.vstore(qo + 64L, a4 * inv);
                out.vstore(qo + 80L, a5 * inv);
                out.vstore(qo + 96L, a6 * inv);
                out.vstore(qo + 112L, a7 * inv);
                h = h + 1;
            }
        }
    }

    /** `rows` query rows from position `startPos` (`window` 0 the whole causal range) into `out`, `block` work items a workgroup. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> out, KernelBuffer<float32> q, KernelBuffer<float16> kPool,
            KernelBuffer<float16> vPool, KernelBuffer<int32> pgTab, int32 pgBase, int32 rows, int32 nH, int32 nKv,
            int32 startPos, float32 scale, int32 window, int32 block) {
        uint32 n = (uint32) (rows * nKv);
        uint32 blk = (uint32) block;
        prefill.launch(s, grid: [(n + blk - 1) / blk], block: [blk])
            (out, q, kPool, vPool, pgTab, (uint32) pgBase, (uint32) rows, (uint32) nH, (uint32) nKv, (uint32) startPos,
             scale, (uint32) window);
    }
}
