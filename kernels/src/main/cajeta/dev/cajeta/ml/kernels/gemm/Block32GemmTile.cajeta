package dev.cajeta.ml.kernels.gemm;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Unroll;
import cajeta.xpu.Vector;
import cajeta.xpu.WaveVector;
import dev.cajeta.ml.kernels.quant.Q50Block;
import dev.cajeta.ml.kernels.quant.Q80Block;

/**
 * The GPU prefill GEMM over the 32-value pieces (kernel-drivers plan 8.3.1.4): tensor-core tiles
 * on {@link Block32GemvWave}'s layout. A workgroup of `2 * TN` threads stages a half span (four
 * blocks) of activations and of weights unpacked to signed bytes, multiplies a block at a time
 * into int32 tiles and folds each with its column's `d` and the token's scale. cajeta-llm's
 * `Q8Tile` is this kernel with the Q8_0 copy written in.
 */
@Instantiate(value = {Block32GemmTile<Q80Block, 64, 64, 32, 32, 128>, Block32GemmTile<Q80Block, 128, 128, 32, 64, 128>,
    Block32GemmTile<Q50Block, 64, 64, 32, 32, 128>, Block32GemmTile<Q50Block, 128, 128, 32, 64, 128>})
@Requires(TM == TN && TM % WM == 0 && TN % WN == 0 && WM % 16 == 0 && WN % 16 == 0
    && (TM / WM) * (TN / WN) * 16 == TN && KS == 128)
@Unfused
public final class Block32GemmTile<P, uint32 TM, uint32 TN, uint32 WM, uint32 WN, uint32 KS> {
    public Block32GemmTile() { return; }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + tile.registeredName(); }

    public int32 tileM() { return (int32) TM; }
    public int32 tileN() { return (int32) TN; }
    public int32 threads() { return (int32) (2 * TN); }

    /** True when `rows` tokens by `outDim` weight rows of `cols` values tile exactly. */
    public boolean fits(int64 rows, int64 outDim, int64 cols) {
        return rows % (int64) TM == 0L && outDim % (int64) TN == 0L && cols % 256L == 0L
            && rows > 0L && outDim > 0L && cols > 0L;
    }

    /** Bytes the weight buffer holds past its last row: a block's staging reads 32 bytes. */
    public int64 tailBytes() { return 32L; }

    /** `y[token * outDim + row]` set (or added to) from `packed` ({@link Block32GemvWave#pack}'s layout plus {@link #tailBytes}) and `xp` (q8_K rows, a scale per block); with `splits > 1` each workgroup writes its partial tile to `part`. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols,
            KernelBuffer<float32> part, int64 splits, uint32 accum) {
        int64 tilesM = rows / (int64) TM;
        int64 tilesN = outDim / (int64) TN;
        tile.launch(s, grid: [(uint32) (tilesM * tilesN * splits)], block: [2 * TN])
            (y, packed, xp, (uint32) rows, (uint32) outDim, (uint32) tilesN, cols / 256L,
             part, (uint32) splits, accum);
    }

    /** Word `i` of the eight in `a` then `b`. */
    @Device
    static int32 wordOf(Vector<int32,4> a, Vector<int32,4> b, int64 i) {
        if (i < 4L) { return a[i]; }
        return b[i - 4L];
    }

    /** Four values less `off` a byte, as int8 bytes in a word. */
    @Device
    static int32 centered(Vector<uint8,4> v, int32 off) {
        Vector<int32,1> w = v.asSigned().asWords();
        if (off == 0) { return w[0]; }
        int32 top = 0 - 2139062144;
        return ((w[0] | top) - off * 16843009) ^ top;
    }

    /** Value words `j .. j + 3` (of eight) of a block whose raw words are `a`, `b`: the piece's unpack less `fileOffset()`. */
    @Device
    static Vector<int32,4> values(Vector<int32,4> a, Vector<int32,4> b, int64 j) {
        if (P.streams() == 1 && P.planeBytes() == 0 && P.fileOffset() == 0) {
            if (j == 0L) { return a; }
            return b;
        }
        int64 pw = (int64) P.planeBytes() / 4L;
        Vector<uint8,4> pl = heap Vector<int32,1>(a[0]).asBytes().asUnsigned();
        Vector<int32,4> out = a;
        for (int64 q = Unroll.from(0L); q < 8L; q = q + 1L) {
            if (q < (int64) P.quads()) {
                Vector<uint8,4> rq = heap Vector<int32,1>(Block32GemmTile.wordOf(a, b, pw + q)).asBytes().asUnsigned();
                int64 li = (int64) (P.lowAt((int32) q) / 4);
                if (li >= j && li < j + 4L) { out[li - j] = Block32GemmTile.centered(P.lowBytes<4>(rq, pl, (int32) q), P.fileOffset()); }
                if (P.streams() == 2) {
                    int64 hi = (int64) (P.highAt((int32) q) / 4);
                    if (hi >= j && hi < j + 4L) { out[hi - j] = Block32GemmTile.centered(P.highBytes<4>(rq, pl, (int32) q), P.fileOffset()); }
                }
            }
        }
        return out;
    }

    @Occupancy(maxThreads = 2 * TN)
    @Kernel(targets = {"gpu"}) @FastMath
    public static void tile(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, uint32 rows,
            uint32 outDim, uint32 tilesN, int64 blocksPerRow,
            KernelBuffer<float32> part, uint32 splits, uint32 accum) {
        Shared<int8> aT = shared int8[TM * 144];
        Shared<int8> bT = shared int8[TN * 144];
        Shared<float32> xsAll = shared float32[TM];
        Shared<float32> dAll = shared float32[TN * 4];

        uint32 tid = KernelThread.x();
        uint32 wid = tid / 32;
        uint32 wg = KernelThread.globalIdX() / (2 * TN);
        uint32 tile = wg / splits;
        uint32 split = wg % splits;
        int64 nbs = blocksPerRow / (int64) splits;
        int64 bOff = (int64) split * nbs;
        uint32 tileT = tile / tilesN;
        uint32 tileI = tile % tilesN;
        uint32 pslot = tile * splits + split;
        if (TM == 128) {
            uint32 tilesM = rows / TM;
            tileT = tile % tilesM;
            tileI = tile / tilesM;
            pslot = (tileT * tilesN + tileI) * splits + split;
        }
        uint32 t0 = tileT * TM;
        uint32 i0 = tileI * TN;
        uint32 wr = wid / (TN / WN);
        uint32 wc = wid % (TN / WN);
        uint32 tw = t0 + WM * wr;
        uint32 cw = i0 + WN * wc;
        uint32 sCol = tid >> 1;
        uint32 sH = tid & 1;
        if (t0 < rows && i0 < outDim) {
            int64 bs = (int64) (P.planeBytes() + 4 * P.quads());
            int64 prefix = blocksPerRow * 16L;
            int64 rowBytes = prefix + blocksPerRow * 8L * bs;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 sRow = (int64) (i0 + sCol) * rowBytes + bOff * 16L;
            int64 sRo = (int64) (i0 + sCol) * rowBytes + prefix + bOff * 8L * bs;
            int64 sXb = (int64) (t0 + sCol) * xRowBytes + bOff * 320L;
            uint32 aRow0 = tid >> 3;
            uint32 aPart = tid & 7;
            int64 aSrc0 = (int64) (t0 + aRow0) * xRowBytes + (int64) (16 * aPart) + bOff * 320L;
            int64 xrP = (int64) (TM / 4) * xRowBytes;
            uint32 aDst0 = aRow0 * 144 + 16 * aPart;
            uint32 aDstP = (TM / 4) * 144;

            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1>[WN / 16] mb;
            CooperativeMatrix<int32,16,16,2>[WM / 16][WN / 16] iacc;
            CooperativeMatrix<float32,16,16,2>[WM / 16][WN / 16] facc;
            if (accum != 0 && splits == 1) {
                for (uint32 i = 0; i < WM / 16; i = i + 1) {
                    for (uint32 n = 0; n < WN / 16; n = n + 1) {
                        facc[i][n].load(y, (uint32) ((int64) (tw + 16 * i) * (int64) outDim
                            + (int64) (cw + 16 * n)), 0, outDim);
                    }
                }
            } else {
                for (uint32 i = 0; i < WM / 16; i = i + 1) {
                    for (uint32 n = 0; n < WN / 16; n = n + 1) { facc[i][n].splat(0.0f); }
                }
            }

            Vector<int32,4> pa0 = xp.vload<16>(aSrc0).asWords();
            Vector<int32,4> pa1 = xp.vload<16>(aSrc0 + xrP).asWords();
            Vector<int32,4> pa2 = xp.vload<16>(aSrc0 + xrP + xrP).asWords();
            Vector<int32,4> pa3 = xp.vload<16>(aSrc0 + xrP + xrP + xrP).asWords();
            int64 bS0 = sRo + 2L * bs * (int64) sH;
            Vector<int32,4> pl0 = packed.vload<16>(bS0, align: 4).asWords();
            Vector<int32,4> pl1 = packed.vload<16>(bS0 + 16L, align: 4).asWords();
            Vector<int32,4> ph0 = packed.vload<16>(bS0 + bs, align: 4).asWords();
            Vector<int32,4> ph1 = packed.vload<16>(bS0 + bs + 16L, align: 4).asWords();
            Vector<int32,1> px = xp.vload<4>(sXb + 288L).asWords();

            uint32 nh = (uint32) nbs * 2;
            uint32 hh = 0;
            while (hh < nh) {
                uint32 H = hh & 1;
                Barrier.workgroup();
                int64 aDst = (int64) aDst0;
                aT.vstore(aDst, pa0.asBytes());
                aT.vstore(aDst + (int64) aDstP, pa1.asBytes());
                aT.vstore(aDst + (int64) (2 * aDstP), pa2.asBytes());
                aT.vstore(aDst + (int64) (3 * aDstP), pa3.asBytes());
                {
                    int64 dst = (int64) (sCol * 144 + 64 * sH);
                    bT.vstore(dst, Block32GemmTile.values(pl0, pl1, 0L).asBytes());
                    bT.vstore(dst + 16L, Block32GemmTile.values(pl0, pl1, 4L).asBytes());
                    bT.vstore(dst + 32L, Block32GemmTile.values(ph0, ph1, 0L).asBytes());
                    bT.vstore(dst + 48L, Block32GemmTile.values(ph0, ph1, 4L).asBytes());
                }
                if (sH == 0) {
                    int64 dS = sRow + (int64) (16 * (hh >> 1) + 8 * H);
                    Vector<int32,1> da = packed.vload<4>(dS).asWords();
                    Vector<int32,1> db = packed.vload<4>(dS + 4L).asWords();
                    int32 wa = da[0];
                    int32 wb = db[0];
                    dAll[sCol] = P.dOf(wa);
                    dAll[TN + sCol] = P.dOf(wa >> 16);
                    dAll[2 * TN + sCol] = P.dOf(wb);
                    dAll[3 * TN + sCol] = P.dOf(wb >> 16);
                } else if (H == 0) {
                    Vector<int32,1> xw = px;
                    xsAll[sCol] = Cajeta.bitsToF32(xw[0]);
                }
                if (hh + 1 < nh) {
                    int64 nb = (int64) ((hh + 1) >> 1);
                    uint32 nH = (hh + 1) & 1;
                    int64 aS = aSrc0 + nb * 320L + (int64) (128 * nH);
                    pa0 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa1 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa2 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa3 = xp.vload<16>(aS).asWords();
                    int64 bS = sRo + (nb * 8L + 4L * (int64) nH + 2L * (int64) sH) * bs;
                    pl0 = packed.vload<16>(bS, align: 4).asWords();
                    pl1 = packed.vload<16>(bS + 16L, align: 4).asWords();
                    ph0 = packed.vload<16>(bS + bs, align: 4).asWords();
                    ph1 = packed.vload<16>(bS + bs + 16L, align: 4).asWords();
                    if (sH == 1 && nH == 0) {
                        px = xp.vload<4>(sXb + nb * 320L + 288L).asWords();
                    }
                }
                Barrier.workgroup();

                uint32 aBuf = (WM * wr) * 144;
                uint32 bBuf = (WN * wc) * 144;
                uint32 dbase = WN * wc;
                uint32 xbase = WM * wr;
                uint32 jb = 0;
                while (jb < 4) {
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { iacc[i][n].splat(0); }
                    }
                    uint32 ks = 0;
                    while (ks < 2) {
                        uint32 kk = 32 * jb + 16 * ks;
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            mb[n].load(bT, bBuf + n * (16 * 144) + kk, 1, 144);
                        }
                        for (uint32 i = 0; i < WM / 16; i = i + 1) {
                            ma.load(aT, aBuf + i * (16 * 144) + kk, 0, 144);
                            for (uint32 n = 0; n < WN / 16; n = n + 1) { iacc[i][n].mma(ma, mb[n]); }
                        }
                        ks = ks + 1;
                    }
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            WaveVector<float32, 16> dcv = WaveVector.ofSlice(dAll, jb * TN + dbase + 16 * n, 1);
                            iacc[i][n].scaledAccumInto(facc[i][n], xsAll[xbase + 16 * i], dcv);
                        }
                    }
                    jb = jb + 1;
                }
                hh = hh + 1;
            }

            if (splits > 1) {
                uint32 pbase = pslot * (TM * TN);
                uint32 pw = (WM * wr) * TN + WN * wc;
                for (uint32 i = 0; i < WM / 16; i = i + 1) {
                    for (uint32 n = 0; n < WN / 16; n = n + 1) {
                        facc[i][n].store(part, pbase + pw + i * (16 * TN) + 16 * n, 0, TN);
                    }
                }
                return;
            }
            for (uint32 i = 0; i < WM / 16; i = i + 1) {
                for (uint32 n = 0; n < WN / 16; n = n + 1) {
                    facc[i][n].store(y, (uint32) ((int64) (tw + 16 * i) * (int64) outDim
                        + (int64) (cw + 16 * n)), 0, outDim);
                }
            }
        }
    }
}
