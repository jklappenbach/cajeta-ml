package dev.cajeta.ml.kernels.tune;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.DeviceFacts;
import cajeta.xpu.KernelFacts;
import cajeta.xpu.ShapeCandidate;
import cajeta.xpu.ShapeChoice;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeProbe;
import cajeta.xpu.ShapeResult;
import cajeta.xpu.XpuLaunchException;

/**
 * One kernel family's run-time state (spec §7.2, §7.3): its name in the shape
 * store, its listed members (one object per member: an instantiation of a class
 * template, or a hand kernel at a shape), and the recent choices by problem. A
 * member that does not fit, or has no device code here, is pruned with a reason;
 * the measured winner is remembered per problem under the device and the build;
 * with no store the choice is the first survivor, untimed, so it is deterministic.
 */
public final class TileFamily<S extends TileShape> {
    String name;
    ArrayList<S> list;
    // The recent choices, by problem: the store is asked once per problem.
    int32 memoN = 16;
    int64[] memoRows;
    int64[] memoOut;
    int64[] memoCols;
    int32[] memoIdx;
    int32 memoNext = 0;
    int32 memoLast = -1;
    /** Print one `tile-choice` line per settled choice. */
    public static boolean verbose = false;

    public TileFamily(String name) {
        this.name #= name.clone();
        this.list #= heap ArrayList<S>();
        this.forget();
    }

    public void add(#S sh) {
        this.list.add(#sh);
    }

    public ArrayList<S> shapes() { return this.list; }

    public String name() { return this.name; }

    /** Drop the remembered choices. */
    public void forget() {
        this.memoRows #= heap int64[this.memoN];
        this.memoOut #= heap int64[this.memoN];
        this.memoCols #= heap int64[this.memoN];
        this.memoIdx #= heap int32[this.memoN];
        int32 i = 0;
        while (i < this.memoN) {
            this.memoRows[i] = -1L;
            this.memoIdx[i] = -1;
            i = i + 1;
        }
        this.memoNext = 0;
        this.memoLast = -1;
    }

    /** The registered kernel of the member the last choice settled on, or "". */
    public #String lastKernel() {
        if (this.memoLast < 0) {
            String none #= "".clone();
            return #none;
        }
        return this.list.get(this.memoLast).kernel();
    }

    /** The index of the member registered as `kernel`, or -1. */
    public int32 indexOf(String kernel) {
        int32 n = (int32) this.list.count();
        int32 i = 0;
        while (i < n) {
            String k #= this.list.get(i).kernel();
            if (k.equals(kernel)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /** Whether some listed member covers the problem. */
    public boolean fits(int64 rows, int64 outDim, int64 cols) {
        int32 n = (int32) this.list.count();
        int32 i = 0;
        while (i < n) {
            if (this.list.get(i).fits(rows, outDim, cols)) { return true; }
            i = i + 1;
        }
        return false;
    }

    /** Whether some listed member with device code here covers the problem. */
    public boolean serves(int64 rows, int64 outDim, int64 cols) {
        int32 n = (int32) this.list.count();
        int32 i = 0;
        while (i < n) {
            S sh = this.list.get(i);
            if (sh.fits(rows, outDim, cols)) {
                String kn #= sh.kernel();
                if (Device.kernelAvailable(kn)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    /** The family's verdict on member `kernel` at this problem: "" when it is a
     *  candidate, else why not (not listed, does not fit, no device code, or the
     *  filter's pruned verdict). */
    public #String pruneReason(String kernel, int64 rows, int64 outDim, int64 cols) {
        int32 i = this.indexOf(kernel);
        if (i < 0) {
            return kernel + " is not a listed member of the " + this.name + " family";
        }
        S sh = this.list.get(i);
        if (!sh.fits(rows, outDim, cols)) {
            return kernel + " does not fit " + rows + "x" + outDim + "x" + cols;
        }
        if (!Device.kernelAvailable(kernel)) {
            return kernel + " has no device code";
        }
        ShapeFilter f #= heap ShapeFilter(this.name, DeviceFacts.current(), rows, outDim, cols);
        String kn #= sh.kernel();
        KernelFacts kf #= KernelFacts.measured(kn, 0);
        f.consider(#heap ShapeCandidate(#kn, sh.tileM(), sh.tileN(), sh.threads(), 256, 8), #kf);
        if (f.survivorCount() > 0) { return "" + ""; }
        return f.pruned(0).text();
    }

    /** The remembered member for this problem, or -1. */
    public int32 remembered(int64 rows, int64 outDim, int64 cols) {
        int32 m = 0;
        while (m < this.memoN) {
            if (this.memoIdx[m] >= 0 && this.memoRows[m] == rows
                    && this.memoOut[m] == outDim && this.memoCols[m] == cols) {
                this.memoLast = this.memoIdx[m];
                return this.memoLast;
            }
            m = m + 1;
        }
        return -1;
    }

    /** The feasibility filter over the members that fit and have device code here.
     *  No survivor is a refusal by name. */
    public #ShapeFilter filterFor(int64 rows, int64 outDim, int64 cols) {
        ShapeFilter f #= heap ShapeFilter(this.name, DeviceFacts.current(), rows, outDim, cols);
        int32 n = (int32) this.list.count();
        int32 i = 0;
        while (i < n) {
            S sh = this.list.get(i);
            String kn #= sh.kernel();
            if (sh.fits(rows, outDim, cols) && Device.kernelAvailable(kn)) {
                KernelFacts kf #= KernelFacts.measured(kn, 0);
                f.consider(#heap ShapeCandidate(#kn, sh.tileM(), sh.tileN(), sh.threads(), 256, 8), #kf);
            }
            i = i + 1;
        }
        if (f.survivorCount() == 0) {
            String why #= f.refusal();
            throw heap XpuLaunchException(#why);
        }
        return #f;
    }

    /** The member the family runs at this problem: the survivors of `f` are timed
     *  through `probe` at first use and the winner remembered under the device, the
     *  build and the problem in `shapeDir`; an override on the family wins; with
     *  no store under TuneMode.untimed the first survivor is taken, untimed. */
    public int32 chooseWith(String shapeDir, ShapeFilter f, ShapeProbe probe, int64 rows,
            int64 outDim, int64 cols) {
        if (TuneMode.skipTiming(shapeDir)) { return this.chooseDefault(shapeDir, f, rows, outDim, cols); }
        ShapeResult r #= ShapeChoice.choose(shapeDir, f, probe);
        return this.settle(r, rows, outDim, cols);
    }

    int32 chooseDefault(String shapeDir, ShapeFilter f, int64 rows, int64 outDim, int64 cols) {
        RefusingProbe none = heap RefusingProbe();
        ShapeResult r #= ShapeChoice.choose(shapeDir, f, none);
        if (r.survivor < 0 && f.survivorCount() > 0) {
            ShapeResult d #= heap ShapeResult();
            d.kernel #= "" + f.survivor(0).candidate.kernel;
            d.survivor = 0;
            return this.settle(d, rows, outDim, cols);
        }
        return this.settle(r, rows, outDim, cols);
    }

    /** The member the store, an override or a lone survivor names without a timing;
     *  -1 when only a timing can decide. */
    public int32 chooseUntimed(String shapeDir, ShapeFilter f, int64 rows, int64 outDim, int64 cols) {
        RefusingProbe none = heap RefusingProbe();
        ShapeResult r #= ShapeChoice.choose(shapeDir, f, none);
        if (r.survivor < 0 && r.timed) { return -1; }
        return this.settle(r, rows, outDim, cols);
    }

    public void markLast(int32 idx) { this.memoLast = idx; }

    int32 settle(ShapeResult r, int64 rows, int64 outDim, int64 cols) {
        if (r.survivor < 0) {
            String why #= r.refusal.clone();
            throw heap XpuLaunchException(#why);
        }
        if (TileFamily.verbose) {
            System.stdout.println("tile-choice " + this.name + " " + r.kernel + " " + rows + "x" + outDim
                + "x" + cols + " margin " + r.marginPerMille + " cached " + r.fromCache + " timed " + r.timed);
        }
        int32 idx = this.indexOf(r.kernel);
        if (idx < 0) {
            String why #= "the shape choice named " + r.kernel
                + ", which the " + this.name + " family does not list";
            throw heap XpuLaunchException(#why);
        }
        int32 slot = this.memoNext;
        this.memoNext = (this.memoNext + 1) % this.memoN;
        this.memoRows[slot] = rows;
        this.memoOut[slot] = outDim;
        this.memoCols[slot] = cols;
        this.memoIdx[slot] = idx;
        this.memoLast = idx;
        return idx;
    }
}

/** A probe that runs nothing, so a choice answers only from the store, an override or a lone survivor. */
final class RefusingProbe implements ShapeProbe {
    public RefusingProbe() { return; }
    public int64 timeNanos(int32 i) { return 0L; }
}
