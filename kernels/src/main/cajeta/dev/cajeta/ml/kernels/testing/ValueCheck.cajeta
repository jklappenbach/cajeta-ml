package dev.cajeta.ml.kernels.testing;

import cajeta.lang.String;
import cajeta.xpu.Device;

/**
 * Which kernels had their OUTPUT compared against a reference. A launch proves a
 * kernel did not crash, not that it answered right. A test brackets the device
 * computation it compares:
 *
 *     int64[] m #= ValueCheck.mark();
 *     ... launch, read back, assert against the reference ...
 *     ValueCheck.credit(m);
 *
 * `credit` credits every kernel that launched since `mark`, and is reached only
 * when every assertion before it held. {@link KernelCensus} reads {@link #checks}.
 */
public final class ValueCheck {
    static int64[] credits;

    public ValueCheck() { return; }

    /** Launch counts of every registered kernel, by registry index. */
    public static #int64[] mark() {
        int32 n = Device.registeredKernelCount();
        int64[] m #= heap int64[(int64) n];
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            m[(int64) i] = Device.kernelLaunchCount(name);
            i = i + 1;
        }
        return #m;
    }

    /** Credit every kernel that launched since `m`; returns how many (zero is legal). */
    public static int32 credit(int64[] m) {
        int32 n = Device.registeredKernelCount();
        ValueCheck.ensure(n);
        int32 got = 0;
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            int64 before = 0L;
            if ((int64) i < m.count()) { before = m[(int64) i]; }
            if (Device.kernelLaunchCount(name) > before) {
                ValueCheck.credits[(int64) i] = ValueCheck.credits[(int64) i] + 1L;
                got = got + 1;
            }
            i = i + 1;
        }
        return got;
    }

    /** Checks credited to `name` in this process. */
    public static int64 checks(String name) {
        int32 n = Device.registeredKernelCount();
        ValueCheck.ensure(n);
        int32 i = 0;
        while (i < n) {
            String r #= Device.registeredKernel(i);
            if (r.equals(name)) { return ValueCheck.credits[(int64) i]; }
            i = i + 1;
        }
        return 0L;
    }

    static void ensure(int32 n) {
        if (ValueCheck.credits != null && ValueCheck.credits.count() >= (int64) n) { return; }
        int64[] grown #= heap int64[(int64) n];
        if (ValueCheck.credits != null) {
            int64 k = 0L;
            while (k < ValueCheck.credits.count()) {
                grown[k] = ValueCheck.credits[k];
                k = k + 1L;
            }
        }
        ValueCheck.credits #= grown;
        return;
    }
}
