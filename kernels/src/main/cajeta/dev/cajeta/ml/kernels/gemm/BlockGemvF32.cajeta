package dev.cajeta.ml.kernels.gemm;

import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.xpu.Group;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;
import cajeta.xpu.Wave;
import dev.cajeta.ml.kernels.quant.Q6kBlock;

/**
 * The GPU float-activation decode of the 16-value K formats with an offset and no min (kernel-drivers
 * plan 9.1.7.2), on the file layout against an unquantized float token: four lanes a block, lane
 * `(g, a)` the four 16-value runs `128 g + 32 t + 16 a ..` of each, four rows a wave (a row narrower
 * than a wave shares it with the next rows). A run is four fma chains over its byte lanes, summed in
 * pairs, less `offset()` times the run's activations, and `d` times the sub-block's scale adds it.
 * That is cajeta-llm's Q6_K float wave order, so each output equals its kernel's bit for bit (spec 7.9).
 */
@Instantiate(value = {BlockGemvF32<Q6kBlock>}, max = 4)
public final class BlockGemvF32<P> {
    public BlockGemvF32() { return; }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + wave.registeredName(); }

    /** One run of 16 values: quant words `q` against the activations `x0 .. x3` (values `4 w + j` in word `w`, byte `j`), less `xs`. */
    @Device
    static float32 run16(Vector<int32,4> q, Vector<float32,4> x0, Vector<float32,4> x1, Vector<float32,4> x2,
            Vector<float32,4> x3, float32 xs) {
        float32 p0 = Math.fma((float32) (q[3] & 255), x3[0], Math.fma((float32) (q[2] & 255), x2[0],
            Math.fma((float32) (q[1] & 255), x1[0], (float32) (q[0] & 255) * x0[0])));
        float32 p1 = Math.fma((float32) ((q[3] >> 8) & 255), x3[1], Math.fma((float32) ((q[2] >> 8) & 255), x2[1],
            Math.fma((float32) ((q[1] >> 8) & 255), x1[1], (float32) ((q[0] >> 8) & 255) * x0[1])));
        float32 p2 = Math.fma((float32) ((q[3] >> 16) & 255), x3[2], Math.fma((float32) ((q[2] >> 16) & 255), x2[2],
            Math.fma((float32) ((q[1] >> 16) & 255), x1[2], (float32) ((q[0] >> 16) & 255) * x0[2])));
        float32 p3 = Math.fma((float32) ((q[3] >> 24) & 255), x3[3], Math.fma((float32) ((q[2] >> 24) & 255), x2[3],
            Math.fma((float32) ((q[1] >> 24) & 255), x1[3], (float32) ((q[0] >> 24) & 255) * x0[3])));
        return (p0 + p1) + (p2 + p3) - xs;
    }

    /** `x0 .. x3`'s sum times `offset()`, the run's offset term. */
    @Device
    static float32 runSum(Vector<float32,4> x0, Vector<float32,4> x1, Vector<float32,4> x2, Vector<float32,4> x3) {
        Vector<float32,4> sv = x0 + x1 + x2 + x3;
        return (float32) P.offset() * (sv[0] + sv[1] + sv[2] + sv[3]);
    }

    /** `acc` plus lane `(g, a)`'s four runs of the block at `ob` against the activations `x` (run `t` at `xt_0 ..`), sums `xs0 ..`. */
    @Device
    static float32 step(float32 acc, KernelBuffer<int8> w, int64 ob, int32 g, int32 a,
            Vector<float32,4> x0_0, Vector<float32,4> x0_1, Vector<float32,4> x0_2, Vector<float32,4> x0_3,
            Vector<float32,4> x1_0, Vector<float32,4> x1_1, Vector<float32,4> x1_2, Vector<float32,4> x1_3,
            Vector<float32,4> x2_0, Vector<float32,4> x2_1, Vector<float32,4> x2_2, Vector<float32,4> x2_3,
            Vector<float32,4> x3_0, Vector<float32,4> x3_1, Vector<float32,4> x3_2, Vector<float32,4> x3_3,
            float32 xs0, float32 xs1, float32 xs2, float32 xs3) {
        uint32 k0 = (uint32) (128 * g + 16 * a);
        Vector<int32,4> wA = w.vload<16>(ob + (int64) P.quantByte(k0)).asWords();
        Vector<int32,4> wB = w.vload<16>(ob + (int64) P.quantByte(k0 + 32)).asWords();
        Vector<int32,4> wH = w.vload<16>(ob + (int64) P.planeByte(k0)).asWords();
        Vector<int32,4> ha = w.vload<16>(ob + (int64) P.headOffset()).asWords();
        Vector<int32,4> hb = w.vload<16>(ob + (int64) P.head2Offset()).asWords();
        float32 d = P.dOf(ha, hb);
        uint32 j0 = (uint32) (8 * g + a);
        int32 s0 = P.scaleOf(ha, hb, j0);
        int32 s1 = P.scaleOf(ha, hb, j0 + 2);
        int32 s2 = P.scaleOf(ha, hb, j0 + 4);
        int32 s3 = P.scaleOf(ha, hb, j0 + 6);
        float32 t0 = BlockGemvF32.run16(P.lowWords(wA, wH, 0), x0_0, x0_1, x0_2, x0_3, xs0);
        float32 t1 = BlockGemvF32.run16(P.lowWords(wB, wH, 1), x1_0, x1_1, x1_2, x1_3, xs1);
        float32 t2 = BlockGemvF32.run16(P.highWords(wA, wH, 0), x2_0, x2_1, x2_2, x2_3, xs2);
        float32 t3 = BlockGemvF32.run16(P.highWords(wB, wH, 1), x3_0, x3_1, x3_2, x3_3, xs3);
        acc = acc + d * (float32) s0 * t0;
        acc = acc + d * (float32) s1 * t1;
        acc = acc + d * (float32) s2 * t2;
        return acc + d * (float32) s3 * t3;
    }

    /** `y[yOff + r]` set (or added to, `accum` 1) to row `r`'s dot with the float token at `x[xOff ..)`, `bpr` blocks a row. */
    @Kernel(targets = {"gpu"})
    @Occupancy(maxThreads = 256)
    public static void wave(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff, uint32 accum) {
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 wi = KernelThread.globalIdX() / wv;
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        uint32 R = 4;
        if (lpr < wv) { rpw = wv / lpr; sub = lane / lpr; rl = lane - sub * lpr; R = 1; }
        uint32 row0 = wi * R * rpw + sub;
        int64 bb = (int64) P.blockBytes();
        int64 rowBytes = blocksPerRow * bb;
        uint32 bpr = (uint32) blocksPerRow;
        float32 acc0 = 0.0f;
        float32 acc1 = 0.0f;
        float32 acc2 = 0.0f;
        float32 acc3 = 0.0f;
        if (sub < rpw && row0 < rows) {
            uint32 last = rows - 1;
            uint32 r1 = row0 + 1; if (r1 > last) { r1 = last; }
            uint32 r2 = row0 + 2; if (r2 > last) { r2 = last; }
            uint32 r3 = row0 + 3; if (r3 > last) { r3 = last; }
            float32 w1 = 0.0f; if (R > 1 && row0 + 1 < rows) { w1 = 1.0f; }
            float32 w2 = 0.0f; if (R > 1 && row0 + 2 < rows) { w2 = 1.0f; }
            float32 w3 = 0.0f; if (R > 1 && row0 + 3 < rows) { w3 = 1.0f; }
            int64 rb0 = (int64) row0 * rowBytes;
            int64 rb1 = (int64) r1 * rowBytes;
            int64 rb2 = (int64) r2 * rowBytes;
            int64 rb3 = (int64) r3 * rowBytes;
            int32 m = (int32) (rl % 4);
            int32 g = m / 2;
            int32 a = m - g * 2;
            uint32 b = rl / 4;
            while (b < bpr) {
                int64 xa = xOff + (int64) (b * 256) + (int64) (16 * (8 * g + a));
                Vector<float32,4> x0_0 = x.vload<4>(xa + 0L);
                Vector<float32,4> x0_1 = x.vload<4>(xa + 4L);
                Vector<float32,4> x0_2 = x.vload<4>(xa + 8L);
                Vector<float32,4> x0_3 = x.vload<4>(xa + 12L);
                Vector<float32,4> x1_0 = x.vload<4>(xa + 32L);
                Vector<float32,4> x1_1 = x.vload<4>(xa + 36L);
                Vector<float32,4> x1_2 = x.vload<4>(xa + 40L);
                Vector<float32,4> x1_3 = x.vload<4>(xa + 44L);
                Vector<float32,4> x2_0 = x.vload<4>(xa + 64L);
                Vector<float32,4> x2_1 = x.vload<4>(xa + 68L);
                Vector<float32,4> x2_2 = x.vload<4>(xa + 72L);
                Vector<float32,4> x2_3 = x.vload<4>(xa + 76L);
                Vector<float32,4> x3_0 = x.vload<4>(xa + 96L);
                Vector<float32,4> x3_1 = x.vload<4>(xa + 100L);
                Vector<float32,4> x3_2 = x.vload<4>(xa + 104L);
                Vector<float32,4> x3_3 = x.vload<4>(xa + 108L);
                float32 xs0 = BlockGemvF32.runSum(x0_0, x0_1, x0_2, x0_3);
                float32 xs1 = BlockGemvF32.runSum(x1_0, x1_1, x1_2, x1_3);
                float32 xs2 = BlockGemvF32.runSum(x2_0, x2_1, x2_2, x2_3);
                float32 xs3 = BlockGemvF32.runSum(x3_0, x3_1, x3_2, x3_3);
                int64 bo = (int64) b * bb;
                acc0 = BlockGemvF32.step(acc0, w, rb0 + bo, g, a, x0_0, x0_1, x0_2, x0_3, x1_0, x1_1, x1_2, x1_3,
                    x2_0, x2_1, x2_2, x2_3, x3_0, x3_1, x3_2, x3_3, xs0, xs1, xs2, xs3);
                acc1 = BlockGemvF32.step(acc1, w, rb1 + bo, g, a, x0_0, x0_1, x0_2, x0_3, x1_0, x1_1, x1_2, x1_3,
                    x2_0, x2_1, x2_2, x2_3, x3_0, x3_1, x3_2, x3_3, xs0, xs1, xs2, xs3);
                acc2 = BlockGemvF32.step(acc2, w, rb2 + bo, g, a, x0_0, x0_1, x0_2, x0_3, x1_0, x1_1, x1_2, x1_3,
                    x2_0, x2_1, x2_2, x2_3, x3_0, x3_1, x3_2, x3_3, xs0, xs1, xs2, xs3);
                acc3 = BlockGemvF32.step(acc3, w, rb3 + bo, g, a, x0_0, x0_1, x0_2, x0_3, x1_0, x1_1, x1_2, x1_3,
                    x2_0, x2_1, x2_2, x2_3, x3_0, x3_1, x3_2, x3_3, xs0, xs1, xs2, xs3);
                b = b + wv / 4;
            }
            acc1 = acc1 * w1;
            acc2 = acc2 * w2;
            acc3 = acc3 * w3;
        }
        if (R > 1) {
            float32 t0 = Wave.reduceSumF32(acc0);
            float32 t1 = Wave.reduceSumF32(acc1);
            float32 t2 = Wave.reduceSumF32(acc2);
            float32 t3 = Wave.reduceSumF32(acc3);
            if (lane == 0) {
                int64 o = yOff + (int64) row0;
                BlockGemvF32.put(y, o, t0, accum, row0 < rows);
                BlockGemvF32.put(y, o + 1L, t1, accum, row0 + 1 < rows);
                BlockGemvF32.put(y, o + 2L, t2, accum, row0 + 2 < rows);
                BlockGemvF32.put(y, o + 3L, t3, accum, row0 + 3 < rows);
            }
        } else {
            uint32 r = 0;
            while (r < rpw) {
                float32 part = 0.0f;
                if (sub == r) { part = acc0; }
                float32 tot = Wave.reduceSumF32(part);
                if (lane == 0) { BlockGemvF32.put(y, yOff + (int64) (wi * rpw + r), tot, accum, wi * rpw + r < rows); }
                r = r + 1;
            }
        }
    }

    /** `y[o]` set to `v` (or added to, `accum` 1) when `live`. */
    @Device
    static void put(KernelBuffer<float32> y, int64 o, float32 v, uint32 accum, boolean live) {
        if (live) {
            if (accum != 0) { y[o] = y[o] + v; } else { y[o] = v; }
        }
    }

    /** `y[yOff + r]` set (or added to) for `rows` file-layout rows of `cols / 256` blocks against the float token `x[xOff ..)`, `wavesPerBlock` waves a workgroup. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff, boolean accum, int64 wavesPerBlock, int64 waveWidth) {
        int64 bpr = cols / 256L;
        int64 lpr = 4L * bpr;
        int64 rpw = 4L;
        if (lpr < waveWidth) { rpw = waveWidth / lpr; }
        int64 waves = (rows + rpw - 1L) / rpw;
        int64 groups = (waves + wavesPerBlock - 1L) / wavesPerBlock;
        wave.launch(s, grid: [(uint32) groups], block: [(uint32) (wavesPerBlock * waveWidth)])
            (y, w, x, (uint32) rows, bpr, xOff, yOff, accum ? 1 : 0);
    }
}
