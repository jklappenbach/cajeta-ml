package dev.cajeta.ml.kernels.gemm;

import cajeta.lang.Cajeta;
import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.TileOps;
import cajeta.xpu.Vector;
import cajeta.xpu.WaveVector;
import dev.cajeta.ml.kernels.quant.Q4kBlock;

/**
 * The GPU driver of the block-quantized GEMM (kernel-drivers spec §3.1): {@link BlockGemmRef}'s
 * operation as tensor-core tiles on the weight's file layout. A workgroup of `2 * TN` threads
 * computes a TM-token x TN-row output tile from `[WM / 16][WN / 16]` 16x16 fragments a wave,
 * staging a half block (KS = 128 values) of weights and activations into shared memory behind a
 * barrier, with the next half prefetched in registers and the scale step an epilogue per block.
 *
 * The piece `P` gives the block's size and offsets, the header decode, and the split of quant
 * words into values (`lowWords`, `highWords`); it has eight sub-blocks of 32 values with the
 * quants a nibble each. cajeta-llm's `QkTile` is this kernel with the Q4_K decode written in.
 */
@Instantiate({BlockGemmTile<Q4kBlock, 64, 64, 32, 32, 128>, BlockGemmTile<Q4kBlock, 128, 128, 32, 64, 128>})
@Requires(TM == TN && TM % WM == 0 && TN % WN == 0 && WM % 16 == 0 && WN % 16 == 0
    && (TM / WM) * (TN / WN) * 16 == TN && KS == 128 && (WN / 16) % 2 == 0)
@Unfused
public final class BlockGemmTile<P, uint32 TM, uint32 TN, uint32 WM, uint32 WN, uint32 KS> {

    public BlockGemmTile() { return; }

    /** Tokens and rows of one output tile. */
    public int32 tileM() { return (int32) TM; }
    public int32 tileN() { return (int32) TN; }

    /** True when `rows` tokens by `outDim` weight rows of `cols` values tile exactly. */
    public boolean fits(int64 rows, int64 outDim, int64 cols) {
        return rows % (int64) TM == 0L && outDim % (int64) TN == 0L && cols % 256L == 0L
            && rows > 0L && outDim > 0L && cols > 0L;
    }

    /** `y[token * outDim + row]` set (or added to) from `packed` (file layout) and `xp` (q8_K rows); with `splits > 1` each workgroup writes its partial tile to `part` for a fixup to sum. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 outDim, int64 cols,
            KernelBuffer<float32> part, int64 splits, uint32 accum) {
        int64 tilesM = rows / (int64) TM;
        int64 tilesN = outDim / (int64) TN;
        int64 tiles = tilesM * tilesN;
        int64 nb = cols / 256L;
        blockTile.launch(s, grid: [(uint32) (tiles * splits)], block: [2 * TN])
            (y, packed, xp, (uint32) rows, (uint32) outDim, (uint32) tilesN, nb,
             part, (uint32) splits, accum);
    }

    @Occupancy(maxThreads = 2 * TN)
    @Kernel(targets = {"gpu"}) @FastMath
    public static void blockTile(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp, uint32 rows,
            uint32 outDim, uint32 tilesN, int64 blocksPerRow,
            KernelBuffer<float32> part, uint32 splits, uint32 accum) {
        Shared<int8> aT = shared int8[TM * 144];
        Shared<int8> bT = shared int8[TN * 144];
        Shared<float32> xsAll = shared float32[TM];
        Shared<float32> dAll = shared float32[TN];
        Shared<float32> rgAll = shared float32[TM * 8];
        Shared<int32> scAll = shared int32[TN * 8];
        Shared<float32> cgAll = shared float32[TN * 8];

        uint32 tid = KernelThread.x();
        uint32 wid = tid / 32;
        uint32 wg = KernelThread.globalIdX() / (2 * TN);
        uint32 tile = wg / splits;
        uint32 split = wg % splits;
        int64 nbs = blocksPerRow / (int64) splits;
        int64 bOff = (int64) split * nbs;
        uint32 tilesM = rows / TM;
        uint32 tileT = tile % tilesM;
        uint32 tileI = tile / tilesM;
        uint32 pslot = (tileT * tilesN + tileI) * splits + split;
        uint32 t0 = tileT * TM;
        uint32 i0 = tileI * TN;
        uint32 wr = wid / (TN / WN);
        uint32 wc = wid % (TN / WN);
        uint32 tw = t0 + WM * wr;
        uint32 cw = i0 + WN * wc;
        uint32 sCol = tid >> 1;
        uint32 sH = tid & 1;
        if (t0 < rows && i0 < outDim) {
            int64 rowBytes = blocksPerRow * (int64) P.blockBytes();
            int64 xRowBytes = blocksPerRow * 320L;
            int64 sRo = (int64) (i0 + sCol) * rowBytes + bOff * (int64) P.blockBytes();
            int64 sXb = (int64) (t0 + sCol) * xRowBytes + bOff * 320L;
            uint32 aRow0 = tid >> 3;
            uint32 aPart = tid & 7;
            int64 aSrc0 = (int64) (t0 + aRow0) * xRowBytes + (int64) (16 * aPart)
                + bOff * 320L;
            int64 xrP = (int64) (TM / 4) * xRowBytes;
            uint32 aDst0 = aRow0 * 144 + 16 * aPart;
            uint32 aDstP = (TM / 4) * 144;
            CooperativeMatrix<int8,16,16,0> ma;
            CooperativeMatrix<int8,16,16,1>[WN / 16] mb;
            CooperativeMatrix<int32,16,16,2>[WN / 16] mc;
            CooperativeMatrix<int32,16,16,2>[WM / 16][WN / 16] iacc;
            CooperativeMatrix<float32,16,16,2>[WM / 16][WN / 16] facc;
            if (accum != 0 && splits == 1) {
                for (uint32 i = 0; i < WM / 16; i = i + 1) {
                    for (uint32 n = 0; n < WN / 16; n = n + 1) {
                        facc[i][n].load(y, (uint32) ((int64) (tw + 16 * i) * (int64) outDim
                            + (int64) (cw + 16 * n)), 0, outDim);
                    }
                }
            } else {
                for (uint32 i = 0; i < WM / 16; i = i + 1) {
                    for (uint32 n = 0; n < WN / 16; n = n + 1) { facc[i][n].splat(0.0f); }
                }
            }

            Vector<int32,4> pa0 = xp.vload<16>(aSrc0).asWords();
            Vector<int32,4> pa1 = xp.vload<16>(aSrc0 + xrP).asWords();
            Vector<int32,4> pa2 = xp.vload<16>(aSrc0 + xrP + xrP).asWords();
            Vector<int32,4> pa3 = xp.vload<16>(aSrc0 + xrP + xrP + xrP).asWords();
            Vector<int32,4> pb0 = packed.vload<16>(sRo + (int64) (P.quantOffset() + 32 * sH)).asWords();
            Vector<int32,4> pb1 = packed.vload<16>(sRo + (int64) (P.quantOffset() + 16 + 32 * sH)).asWords();
            Vector<int32,4> pq0 = pb0;
            Vector<int32,4> pq1 = pb0;
            Vector<int32,1> px = xp.vload<4>(sXb + 288L).asWords();
            if (sH == 0) {
                pq0 = packed.vload<16>(sRo + (int64) P.headOffset()).asWords();
            } else {
                pq0 = xp.vload<16>(sXb + 256L).asWords();
                pq1 = xp.vload<16>(sXb + 272L).asWords();
            }

            uint32 nh = (uint32) nbs * 2;
            uint32 hh = 0;
            while (hh < nh) {
                uint32 H = hh & 1;
                Barrier.workgroup();
                int64 aDst = (int64) aDst0;
                aT.vstore(aDst, pa0.asBytes());
                aT.vstore(aDst + (int64) aDstP, pa1.asBytes());
                aT.vstore(aDst + (int64) (2 * aDstP), pa2.asBytes());
                aT.vstore(aDst + (int64) (3 * aDstP), pa3.asBytes());
                {
                    int64 dst = (int64) (sCol * 144 + 64 * sH);
                    Vector<int32,4> w0 = pb0;
                    Vector<int32,4> w1 = pb1;
                    bT.vstore(dst, P.lowWords(w0).asBytes());
                    bT.vstore(dst + 16L, P.lowWords(w1).asBytes());
                    bT.vstore(dst + 32L, P.highWords(w0).asBytes());
                    bT.vstore(dst + 48L, P.highWords(w1).asBytes());
                }
                if (H == 0) {
                    if (sH == 0) {
                        Vector<int32,4> hw = pq0;
                        int32 h0 = hw[0];
                        int32 h1 = hw[1];
                        int32 h2 = hw[2];
                        int32 h3 = hw[3];
                        float32 dv = P.d(h0);
                        float32 dmv = P.dmin(h0);
                        uint32 cb = sCol * 8;
                        dAll[sCol] = dv;
                        scAll[cb] = P.scale(h1, h3, 0);
                        scAll[cb + 1] = P.scale(h1, h3, 1);
                        scAll[cb + 2] = P.scale(h1, h3, 2);
                        scAll[cb + 3] = P.scale(h1, h3, 3);
                        scAll[cb + 4] = P.scale(h1, h3, 4);
                        scAll[cb + 5] = P.scale(h1, h3, 5);
                        scAll[cb + 6] = P.scale(h1, h3, 6);
                        scAll[cb + 7] = P.scale(h1, h3, 7);
                        cgAll[cb] = 0.0f - dmv * (float32) P.min(h2, h3, 0);
                        cgAll[cb + 1] = 0.0f - dmv * (float32) P.min(h2, h3, 1);
                        cgAll[cb + 2] = 0.0f - dmv * (float32) P.min(h2, h3, 2);
                        cgAll[cb + 3] = 0.0f - dmv * (float32) P.min(h2, h3, 3);
                        cgAll[cb + 4] = 0.0f - dmv * (float32) P.min(h2, h3, 4);
                        cgAll[cb + 5] = 0.0f - dmv * (float32) P.min(h2, h3, 5);
                        cgAll[cb + 6] = 0.0f - dmv * (float32) P.min(h2, h3, 6);
                        cgAll[cb + 7] = 0.0f - dmv * (float32) P.min(h2, h3, 7);
                    } else {
                        Vector<int32,4> q0 = pq0;
                        Vector<int32,4> q1 = pq1;
                        Vector<int32,1> xw = px;
                        float32 xv = Cajeta.bitsToF32(xw[0]);
                        xsAll[sCol] = xv;
                        uint32 rb = (sCol >> 4) * 128 + (sCol & 15);
                        rgAll[rb] = xv * (float32) q0[0];
                        rgAll[rb + 16] = xv * (float32) q0[1];
                        rgAll[rb + 32] = xv * (float32) q0[2];
                        rgAll[rb + 48] = xv * (float32) q0[3];
                        rgAll[rb + 64] = xv * (float32) q1[0];
                        rgAll[rb + 80] = xv * (float32) q1[1];
                        rgAll[rb + 96] = xv * (float32) q1[2];
                        rgAll[rb + 112] = xv * (float32) q1[3];
                    }
                }
                if (hh + 1 < nh) {
                    int64 nb = (int64) ((hh + 1) >> 1);
                    uint32 nH = (hh + 1) & 1;
                    int64 aS = aSrc0 + nb * 320L + (int64) (128 * nH);
                    pa0 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa1 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa2 = xp.vload<16>(aS).asWords();
                    aS = aS + xrP;
                    pa3 = xp.vload<16>(aS).asWords();
                    int64 bS = sRo + nb * (int64) P.blockBytes() + (int64) (P.quantOffset() + 64 * nH + 32 * sH);
                    pb0 = packed.vload<16>(bS).asWords();
                    pb1 = packed.vload<16>(bS + 16L).asWords();
                    if (nH == 0) {
                        if (sH == 0) {
                            pq0 = packed.vload<16>(sRo + nb * (int64) P.blockBytes() + (int64) P.headOffset()).asWords();
                        } else {
                            int64 xb = sXb + nb * 320L;
                            pq0 = xp.vload<16>(xb + 256L).asWords();
                            pq1 = xp.vload<16>(xb + 272L).asWords();
                            px = xp.vload<4>(xb + 288L).asWords();
                        }
                    }
                }
                Barrier.workgroup();

                if (H == 0) {
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { iacc[i][n].splat(0); }
                    }
                }
                uint32 cBase = (WN * wc) * 8;
                uint32 aBuf = (WM * wr) * 144;
                uint32 bBuf = (WN * wc) * 144;
                uint32 jj = 0;
                while (jj < 4) {
                    uint32 j = 4 * H + jj;
                    uint32 kk = 32 * jj;
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].splat(0); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            mb[n].load(bT, bBuf + n * (16 * 144) + kk, 1, 144);
                        }
                        ma.load(aT, aBuf + i * (16 * 144) + kk, 0, 144);
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].mma(ma, mb[n]); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            mb[n].load(bT, bBuf + n * (16 * 144) + kk + 16, 1, 144);
                        }
                        ma.load(aT, aBuf + i * (16 * 144) + kk + 16, 0, 144);
                        for (uint32 n = 0; n < WN / 16; n = n + 1) { mc[n].mma(ma, mb[n]); }
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            TileOps.scaledAccumI32(mc[n], iacc[i][n], scAll, cBase + n * 128 + j, 8);
                        }
                    }
                    uint32 rbase = ((WM / 16) * 8 * wr + j) * 16;
                    for (uint32 n = 0; n + 3 < WN / 16; n = n + 4) {
                        WaveVector<float32, 16> cgA = WaveVector.ofSlice(cgAll, cBase + n * 128 + j, 8);
                        WaveVector<float32, 16> cgB = WaveVector.ofSlice(cgAll, cBase + n * 128 + 128 + j, 8);
                        WaveVector<float32, 16> cgC = WaveVector.ofSlice(cgAll, cBase + n * 128 + 256 + j, 8);
                        WaveVector<float32, 16> cgD = WaveVector.ofSlice(cgAll, cBase + n * 128 + 384 + j, 8);
                        for (uint32 i = 0; i < WM / 16; i = i + 1) {
                            facc[i][n].rank1Accum(rgAll[rbase + 128 * i], cgA);
                            facc[i][n + 1].rank1Accum(rgAll[rbase + 128 * i], cgB);
                            facc[i][n + 2].rank1Accum(rgAll[rbase + 128 * i], cgC);
                            facc[i][n + 3].rank1Accum(rgAll[rbase + 128 * i], cgD);
                        }
                    }
                    for (uint32 n = ((WN / 16) / 4) * 4; n + 1 < WN / 16; n = n + 2) {
                        WaveVector<float32, 16> cgA = WaveVector.ofSlice(cgAll, cBase + n * 128 + j, 8);
                        WaveVector<float32, 16> cgB = WaveVector.ofSlice(cgAll, cBase + n * 128 + 128 + j, 8);
                        for (uint32 i = 0; i < WM / 16; i = i + 1) {
                            facc[i][n].rank1Accum(rgAll[rbase + 128 * i], cgA);
                            facc[i][n + 1].rank1Accum(rgAll[rbase + 128 * i], cgB);
                        }
                    }
                    jj = jj + 1;
                }
                if (H == 1) {
                    uint32 dbase = WN * wc;
                    uint32 xbase = WM * wr;
                    for (uint32 i = 0; i < WM / 16; i = i + 1) {
                        for (uint32 n = 0; n < WN / 16; n = n + 1) {
                            WaveVector<float32, 16> dcv = WaveVector.ofSlice(dAll, dbase + 16 * n, 1);
                            iacc[i][n].scaledAccumInto(facc[i][n], xsAll[xbase + 16 * i], dcv);
                        }
                    }
                }
                hh = hh + 1;
            }

            if (splits > 1) {
                uint32 pbase = pslot * (TM * TN);
                uint32 pw = (WM * wr) * TN + WN * wc;
                for (uint32 i = 0; i < WM / 16; i = i + 1) {
                    for (uint32 n = 0; n < WN / 16; n = n + 1) {
                        facc[i][n].store(part, pbase + pw + i * (16 * TN) + 16 * n, 0, TN);
                    }
                }
                return;
            }
            for (uint32 i = 0; i < WM / 16; i = i + 1) {
                for (uint32 n = 0; n < WN / 16; n = n + 1) {
                    facc[i][n].store(y, (uint32) ((int64) (tw + 16 * i) * (int64) outDim
                        + (int64) (cw + 16 * n)), 0, outDim);
                }
            }
        }
    }
}
