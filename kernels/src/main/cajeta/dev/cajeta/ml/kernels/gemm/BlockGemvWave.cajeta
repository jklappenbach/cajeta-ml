package dev.cajeta.ml.kernels.gemm;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.Group;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;
import cajeta.xpu.Wave;
import dev.cajeta.ml.kernels.quant.Q2kBlock;
import dev.cajeta.ml.kernels.quant.Q3kBlock;
import dev.cajeta.ml.kernels.quant.Q4kBlock;
import dev.cajeta.ml.kernels.quant.Q5kBlock;
import dev.cajeta.ml.kernels.quant.Q6kBlock;
import dev.cajeta.ml.kernels.quant.Q8kAct;

/**
 * The GPU driver of the block-quantized decode mat-vec (kernel-drivers spec §6.1):
 * {@link BlockGemmRef}'s operation for one token on the weight's file layout. A wave owns `R`
 * rows; four lanes take a block, lane `g` its quant run `g` (the two value streams `lowStream(g)`
 * and `highStream(g)`), and the wave sums its lanes at the end. With `PF` the next block's loads
 * are issued before this block's arithmetic. A row shorter than a wave shares the wave with the
 * next rows, one row each. The piece `P` gives the block layout, the header decode, the unpack and
 * the float step; the members are the tuner's to choose (spec 3.4).
 */
@Instantiate(value = {BlockGemvWave<Q4kBlock, 1, 0>, BlockGemvWave<Q4kBlock, 2, 0>,
    BlockGemvWave<Q4kBlock, 4, 0>, BlockGemvWave<Q5kBlock, 1, 0>, BlockGemvWave<Q5kBlock, 2, 0>,
    BlockGemvWave<Q5kBlock, 4, 0>, BlockGemvWave<Q6kBlock, 1, 0>, BlockGemvWave<Q6kBlock, 2, 0>,
    BlockGemvWave<Q6kBlock, 4, 0>, BlockGemvWave<Q3kBlock, 1, 0>, BlockGemvWave<Q3kBlock, 2, 0>,
    BlockGemvWave<Q3kBlock, 4, 0>, BlockGemvWave<Q2kBlock, 1, 0>, BlockGemvWave<Q2kBlock, 2, 0>,
    BlockGemvWave<Q2kBlock, 4, 0>, BlockGemvWave<Q4kBlock, 1, 1>, BlockGemvWave<Q4kBlock, 2, 1>,
    BlockGemvWave<Q4kBlock, 4, 1>}, max = 32)
@Requires((R == 1 || R == 2 || R == 4) && PF < 2)
public final class BlockGemvWave<P, uint32 R, uint32 PF> {
    public BlockGemvWave() { return; }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + wave.registeredName(); }

    /** Rows a wave owns. */
    public int32 rowsPerWave() { return (int32) R; }

    /** The sum of eight int32 lanes. */
    @Device
    static int32 sum8(Vector<int32,8> v) { return v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7]; }

    /** The sum of lanes 0 to 3, the first 16 bytes' dots. */
    @Device
    static int32 sumLo(Vector<int32,8> v) { return v[0] + v[1] + v[2] + v[3]; }

    /** The sum of lanes 4 to 7, the second 16 bytes' dots. */
    @Device
    static int32 sumHi(Vector<int32,8> v) { return v[4] + v[5] + v[6] + v[7]; }

    /** `acc` plus one block's part for lane run `g`: header `ha`/`hb`, run bytes `raw`, plane `plane`, the run's activation streams `a0`/`a1` with their byte sums `o0`/`o1` as dot lanes (16-value formats; 32-value ones read the block's stored sums at `xp[xb ..)`). */
    @Device
    static float32 part(float32 acc, Vector<int32,4> ha, Vector<int32,4> hb, Vector<uint8,32> raw, Vector<uint8,32> plane,
            int32 g, Vector<int8,32> a0, Vector<int8,32> a1, Vector<int32,8> o0, Vector<int32,8> o1, float32 xs,
            KernelBuffer<int8> xp, int64 xb) {
        Vector<int32,8> zv = o0 ^ o0;
        Vector<uint8,32> lo = P.lowBytes<32>(raw, plane, g);
        Vector<uint8,32> hi = P.highBytes<32>(raw, plane, g);
        Vector<int32,8> dl = zv;
        Vector<int32,8> dh = zv;
        if (P.offset() == 0) {
            dl = lo.dotAccum(a0, zv);
            dh = hi.dotAccum(a1, zv);
        } else {
            dl = BlockGemvWave.centered(lo, (int32) P.offset()).dotAccum(a0, zv);
            dh = BlockGemvWave.centered(hi, (int32) P.offset()).dotAccum(a1, zv);
        }
        uint32 ls = (uint32) P.lowStream(g);
        uint32 hs = (uint32) P.highStream(g);
        int32 isum = 0;
        int32 msum = 0;
        if (P.subValues() == 32) {
            isum = BlockGemvWave.sum8(dl) * P.scaleOf(ha, hb, ls) + BlockGemvWave.sum8(dh) * P.scaleOf(ha, hb, hs);
            msum = Q8kAct.subSum(xp, xb, ls) * P.minOf(ha, hb, ls) + Q8kAct.subSum(xp, xb, hs) * P.minOf(ha, hb, hs);
        } else {
            isum = BlockGemvWave.sumLo(dl) * P.scaleOf(ha, hb, 2 * ls) + BlockGemvWave.sumHi(dl) * P.scaleOf(ha, hb, 2 * ls + 1)
                + BlockGemvWave.sumLo(dh) * P.scaleOf(ha, hb, 2 * hs) + BlockGemvWave.sumHi(dh) * P.scaleOf(ha, hb, 2 * hs + 1);
            if (P.offset() == 0) {
                msum = BlockGemvWave.sumLo(o0) * P.minOf(ha, hb, 2 * ls) + BlockGemvWave.sumHi(o0) * P.minOf(ha, hb, 2 * ls + 1)
                    + BlockGemvWave.sumLo(o1) * P.minOf(ha, hb, 2 * hs) + BlockGemvWave.sumHi(o1) * P.minOf(ha, hb, 2 * hs + 1);
            }
        }
        return P.add(acc, P.dOf(ha, hb), P.dminOf(ha, hb), xs, isum, msum);
    }

    /** Unsigned quant bytes less `off` each, as signed bytes: a format with an offset dots them directly and needs no activation sums. */
    @Device
    static Vector<int8,32> centered(Vector<uint8,32> q, int32 off) {
        int32 top = 0 - 2139062144;
        return (((q.asSigned().asWords() | top) - off * 16843009) ^ top).asBytes();
    }

    /** Header words at `ro + off`. */
    @Device
    static Vector<int32,4> head(KernelBuffer<int8> w, int64 ro, uint32 off) { return w.vload<16>(ro + (int64) off).asWords(); }

    /** Lane run `g`'s 32 quant bytes of the block at `ro`. */
    @Device
    static Vector<uint8,32> run(KernelBuffer<int8> w, int64 ro, int32 g) {
        return w.vload<32>(ro + (int64) P.quantOffset() + (int64) (32 * P.quantRun(g))).asUnsigned();
    }

    /** Lane run `g`'s 32 plane bytes of the block at `ro`; `raw` when the format has no plane. */
    @Device
    static Vector<uint8,32> planeOf(KernelBuffer<int8> w, int64 ro, int32 g, Vector<uint8,32> raw) {
        if (P.planeBytes() == 0) { return raw; }
        return w.vload<32>(ro + (int64) P.planeOffset() + (int64) (32 * P.planeRun(g))).asUnsigned();
    }

    /** The token's scale for block `b`. */
    @Device
    static float32 scaleAt(KernelBuffer<int8> xp, int64 b) {
        Vector<int32,1> v = xp.vload<4>(b * 320L + 288L).asWords();
        return Cajeta.bitsToF32(v[0]);
    }

    @Kernel(targets = {"gpu"})
    @Occupancy(maxThreads = 256)
    public static void wave(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff, uint32 accum) {
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 wid = KernelThread.globalIdX() / wv;
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        uint32 rr = R;
        if (lpr < wv) { rpw = wv / lpr; sub = lane / lpr; rl = lane - sub * lpr; rr = 1; }
        uint32 row0 = wid * rr * rpw + sub;
        int64 rowBytes = blocksPerRow * (int64) P.blockBytes();
        int64 bb = (int64) P.blockBytes();
        uint32 bpr = (uint32) blocksPerRow;
        float32 acc0 = 0.0f;
        float32 acc1 = 0.0f;
        float32 acc2 = 0.0f;
        float32 acc3 = 0.0f;
        if (sub < rpw && row0 < rows) {
            uint32 last = rows - 1;
            uint32 r1 = row0 + 1; if (r1 > last) { r1 = last; }
            uint32 r2 = row0 + 2; if (r2 > last) { r2 = last; }
            uint32 r3 = row0 + 3; if (r3 > last) { r3 = last; }
            int64 rb0 = (int64) row0 * rowBytes;
            int64 rb1 = (int64) r1 * rowBytes;
            int64 rb2 = (int64) r2 * rowBytes;
            int64 rb3 = (int64) r3 * rowBytes;
            int32 g = (int32) (rl % 4);
            uint32 b = rl / 4;
            uint32 stepB = wv / 4;
            int64 al = 32L * (int64) P.lowStream(g);
            int64 ah = 32L * (int64) P.highStream(g);
            Vector<int8,32> na0 = xp.vload<32>((int64) b * 320L + al);
            Vector<int8,32> na1 = xp.vload<32>((int64) b * 320L + ah);
            Vector<int32,4> nha0 = BlockGemvWave.head(w, rb0 + (int64) b * bb, P.headOffset());
            Vector<int32,4> nhb0 = nha0;
            if (P.head2Offset() != P.headOffset()) { nhb0 = BlockGemvWave.head(w, rb0 + (int64) b * bb, P.head2Offset()); }
            Vector<uint8,32> nq0 = BlockGemvWave.run(w, rb0 + (int64) b * bb, g);
            Vector<uint8,32> np0 = BlockGemvWave.planeOf(w, rb0 + (int64) b * bb, g, nq0);
            Vector<int32,4> nha1 = nha0;
            Vector<int32,4> nhb1 = nhb0;
            Vector<uint8,32> nq1 = nq0;
            Vector<uint8,32> np1 = np0;
            Vector<int32,4> nha2 = nha0;
            Vector<int32,4> nhb2 = nhb0;
            Vector<uint8,32> nq2 = nq0;
            Vector<uint8,32> np2 = np0;
            Vector<int32,4> nha3 = nha0;
            Vector<int32,4> nhb3 = nhb0;
            Vector<uint8,32> nq3 = nq0;
            Vector<uint8,32> np3 = np0;
            if (PF != 0 && R > 1) {
                nha1 = BlockGemvWave.head(w, rb1 + (int64) b * bb, P.headOffset());
                nhb1 = nha1;
                if (P.head2Offset() != P.headOffset()) { nhb1 = BlockGemvWave.head(w, rb1 + (int64) b * bb, P.head2Offset()); }
                nq1 = BlockGemvWave.run(w, rb1 + (int64) b * bb, g);
                np1 = BlockGemvWave.planeOf(w, rb1 + (int64) b * bb, g, nq1);
            }
            if (PF != 0 && R > 2) {
                nha2 = BlockGemvWave.head(w, rb2 + (int64) b * bb, P.headOffset());
                nhb2 = nha2;
                if (P.head2Offset() != P.headOffset()) { nhb2 = BlockGemvWave.head(w, rb2 + (int64) b * bb, P.head2Offset()); }
                nq2 = BlockGemvWave.run(w, rb2 + (int64) b * bb, g);
                np2 = BlockGemvWave.planeOf(w, rb2 + (int64) b * bb, g, nq2);
                nha3 = BlockGemvWave.head(w, rb3 + (int64) b * bb, P.headOffset());
                nhb3 = nha3;
                if (P.head2Offset() != P.headOffset()) { nhb3 = BlockGemvWave.head(w, rb3 + (int64) b * bb, P.head2Offset()); }
                nq3 = BlockGemvWave.run(w, rb3 + (int64) b * bb, g);
                np3 = BlockGemvWave.planeOf(w, rb3 + (int64) b * bb, g, nq3);
            }
            float32 nxs = BlockGemvWave.scaleAt(xp, (int64) b);
            while (b < bpr) {
                Vector<int8,32> a0 = na0;
                Vector<int8,32> a1 = na1;
                float32 xs = nxs;
                Vector<int32,4> ha0 = nha0;
                Vector<int32,4> hb0 = nhb0;
                Vector<uint8,32> q0 = nq0;
                Vector<uint8,32> p0 = np0;
                Vector<int32,4> ha1 = nha1;
                Vector<int32,4> hb1 = nhb1;
                Vector<uint8,32> q1 = nq1;
                Vector<uint8,32> p1 = np1;
                Vector<int32,4> ha2 = nha2;
                Vector<int32,4> hb2 = nhb2;
                Vector<uint8,32> q2 = nq2;
                Vector<uint8,32> p2 = np2;
                Vector<int32,4> ha3 = nha3;
                Vector<int32,4> hb3 = nhb3;
                Vector<uint8,32> q3 = nq3;
                Vector<uint8,32> p3 = np3;
                uint32 bn = b + stepB;
                if (PF == 0) {
                    int64 ob0 = rb0 + (int64) b * bb;
                    a0 = xp.vload<32>((int64) b * 320L + al);
                    a1 = xp.vload<32>((int64) b * 320L + ah);
                    xs = BlockGemvWave.scaleAt(xp, (int64) b);
                    ha0 = BlockGemvWave.head(w, ob0, P.headOffset());
                    hb0 = ha0;
                    if (P.head2Offset() != P.headOffset()) { hb0 = BlockGemvWave.head(w, ob0, P.head2Offset()); }
                    q0 = BlockGemvWave.run(w, ob0, g);
                    p0 = BlockGemvWave.planeOf(w, ob0, g, q0);
                }
                if (PF == 0 && R > 1) {
                    int64 o1 = rb1 + (int64) b * bb;
                    ha1 = BlockGemvWave.head(w, o1, P.headOffset());
                    hb1 = ha1;
                    if (P.head2Offset() != P.headOffset()) { hb1 = BlockGemvWave.head(w, o1, P.head2Offset()); }
                    q1 = BlockGemvWave.run(w, o1, g);
                    p1 = BlockGemvWave.planeOf(w, o1, g, q1);
                }
                if (PF == 0 && R > 2) {
                    int64 o2 = rb2 + (int64) b * bb;
                    ha2 = BlockGemvWave.head(w, o2, P.headOffset());
                    hb2 = ha2;
                    if (P.head2Offset() != P.headOffset()) { hb2 = BlockGemvWave.head(w, o2, P.head2Offset()); }
                    q2 = BlockGemvWave.run(w, o2, g);
                    p2 = BlockGemvWave.planeOf(w, o2, g, q2);
                    int64 o3 = rb3 + (int64) b * bb;
                    ha3 = BlockGemvWave.head(w, o3, P.headOffset());
                    hb3 = ha3;
                    if (P.head2Offset() != P.headOffset()) { hb3 = BlockGemvWave.head(w, o3, P.head2Offset()); }
                    q3 = BlockGemvWave.run(w, o3, g);
                    p3 = BlockGemvWave.planeOf(w, o3, g, q3);
                }
                uint32 bl = bn;
                if (PF != 0) {
                    int32 inr = (((int32) bn - (int32) bpr) >> 31) & 1;
                    bl = b + (uint32) (inr * (int32) stepB);
                }
                if (PF != 0) {
                    na0 = xp.vload<32>((int64) bl * 320L + al);
                    na1 = xp.vload<32>((int64) bl * 320L + ah);
                    nxs = BlockGemvWave.scaleAt(xp, (int64) bl);
                    nha0 = BlockGemvWave.head(w, rb0 + (int64) bl * bb, P.headOffset());
                    nhb0 = nha0;
                    if (P.head2Offset() != P.headOffset()) { nhb0 = BlockGemvWave.head(w, rb0 + (int64) bl * bb, P.head2Offset()); }
                    nq0 = BlockGemvWave.run(w, rb0 + (int64) bl * bb, g);
                    np0 = BlockGemvWave.planeOf(w, rb0 + (int64) bl * bb, g, nq0);
                    if (R > 1) {
                        nha1 = BlockGemvWave.head(w, rb1 + (int64) bl * bb, P.headOffset());
                        nhb1 = nha1;
                        if (P.head2Offset() != P.headOffset()) { nhb1 = BlockGemvWave.head(w, rb1 + (int64) bl * bb, P.head2Offset()); }
                        nq1 = BlockGemvWave.run(w, rb1 + (int64) bl * bb, g);
                        np1 = BlockGemvWave.planeOf(w, rb1 + (int64) bl * bb, g, nq1);
                    }
                    if (R > 2) {
                        nha2 = BlockGemvWave.head(w, rb2 + (int64) bl * bb, P.headOffset());
                        nhb2 = nha2;
                        if (P.head2Offset() != P.headOffset()) { nhb2 = BlockGemvWave.head(w, rb2 + (int64) bl * bb, P.head2Offset()); }
                        nq2 = BlockGemvWave.run(w, rb2 + (int64) bl * bb, g);
                        np2 = BlockGemvWave.planeOf(w, rb2 + (int64) bl * bb, g, nq2);
                        nha3 = BlockGemvWave.head(w, rb3 + (int64) bl * bb, P.headOffset());
                        nhb3 = nha3;
                        if (P.head2Offset() != P.headOffset()) { nhb3 = BlockGemvWave.head(w, rb3 + (int64) bl * bb, P.head2Offset()); }
                        nq3 = BlockGemvWave.run(w, rb3 + (int64) bl * bb, g);
                        np3 = BlockGemvWave.planeOf(w, rb3 + (int64) bl * bb, g, nq3);
                    }
                }
                Vector<uint8,32> ones = (q0 ^ q0) | 1;
                Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
                Vector<int32,8> o0 = zv;
                Vector<int32,8> o1 = zv;
                if (P.offset() == 0 && P.subValues() == 16) {
                    o0 = ones.dotAccum(a0, zv);
                    o1 = ones.dotAccum(a1, zv);
                }
                acc0 = BlockGemvWave.part(acc0, ha0, hb0, q0, p0, g, a0, a1, o0, o1, xs, xp, (int64) b * 320L);
                if (R > 1) { acc1 = BlockGemvWave.part(acc1, ha1, hb1, q1, p1, g, a0, a1, o0, o1, xs, xp, (int64) b * 320L); }
                if (R > 2) {
                    acc2 = BlockGemvWave.part(acc2, ha2, hb2, q2, p2, g, a0, a1, o0, o1, xs, xp, (int64) b * 320L);
                    acc3 = BlockGemvWave.part(acc3, ha3, hb3, q3, p3, g, a0, a1, o0, o1, xs, xp, (int64) b * 320L);
                }
                b = bn;
            }
            float32 w1 = 0.0f; if (rr > 1 && row0 + 1 < rows) { w1 = 1.0f; }
            float32 w2 = 0.0f; if (rr > 2 && row0 + 2 < rows) { w2 = 1.0f; }
            float32 w3 = 0.0f; if (rr > 2 && row0 + 3 < rows) { w3 = 1.0f; }
            acc1 = acc1 * w1;
            acc2 = acc2 * w2;
            acc3 = acc3 * w3;
        }
        if (rr > 1) {
            float32 t0 = Wave.reduceSumF32(acc0);
            float32 t1 = Wave.reduceSumF32(acc1);
            float32 t2 = t1;
            float32 t3 = t1;
            if (R > 2) {
                t2 = Wave.reduceSumF32(acc2);
                t3 = Wave.reduceSumF32(acc3);
            }
            if (lane == 0) {
                int64 o = yOff + (int64) row0;
                if (row0 < rows) { if (accum != 0) { y[o] = y[o] + t0; } else { y[o] = t0; } }
                if (row0 + 1 < rows) { if (accum != 0) { y[o + 1L] = y[o + 1L] + t1; } else { y[o + 1L] = t1; } }
                if (R > 2) {
                    if (row0 + 2 < rows) { if (accum != 0) { y[o + 2L] = y[o + 2L] + t2; } else { y[o + 2L] = t2; } }
                    if (row0 + 3 < rows) { if (accum != 0) { y[o + 3L] = y[o + 3L] + t3; } else { y[o + 3L] = t3; } }
                }
            }
        } else {
            uint32 r = 0;
            while (r < rpw) {
                float32 sh = 0.0f;
                if (sub == r) { sh = acc0; }
                float32 tot = Wave.reduceSumF32(sh);
                uint32 rowR = wid * rpw + r;
                if (lane == 0 && rowR < rows) {
                    if (accum != 0) { y[yOff + (int64) rowR] = y[yOff + (int64) rowR] + tot; } else { y[yOff + (int64) rowR] = tot; }
                }
                r = r + 1;
            }
        }
    }

    /** `y[yOff + r]` set (or added to) for `rows` file-layout rows of `cols / 256` blocks against one q8_K token `xp`, `wavesPerBlock` waves a workgroup. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff, boolean accum, int64 wavesPerBlock, int64 waveWidth) {
        int64 bpr = cols / 256L;
        int64 lpr = 4L * bpr;
        int64 rpw = (int64) R;
        if (lpr < waveWidth) { rpw = waveWidth / lpr; }
        int64 waves = (rows + rpw - 1L) / rpw;
        int64 groups = (waves + wavesPerBlock - 1L) / wavesPerBlock;
        wave.launch(s, grid: [(uint32) groups], block: [(uint32) (wavesPerBlock * waveWidth)])
            (y, w, xp, (uint32) rows, bpr, yOff, accum ? 1 : 0);
    }
}
