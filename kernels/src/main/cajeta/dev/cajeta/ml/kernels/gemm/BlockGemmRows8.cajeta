package dev.cajeta.ml.kernels.gemm;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Unroll;
import cajeta.xpu.Vector;
import dev.cajeta.ml.kernels.quant.Q8kAct;

/**
 * The cpu driver of the block-quantized GEMM (kernel-drivers spec §3.2): {@link BlockGemmRef}'s
 * operation on the driver's own weight packing. {@link #pack} interleaves eight rows a group at
 * load, so lane r of a 256-bit vector is row `8 g + r`; a work-item owns one group and a chunk of
 * tokens, four tokens a pass, and keeps every sum in registers. The loops over a block's four
 * sub-block pairs and a pair's eight quads are written out by `Unroll`: the kernel is bound by
 * vector loads and shifts, and a piece that sees its pair index as a constant costs what the
 * hand-written kernel does.
 *
 * A packed block of a group: d of the eight rows as float32 at 0, dmin after it and a min table
 * after the scales unless the piece's min is its scale; sub-block `j`'s scales (and mins) a byte a
 * row at `8 j + r`; then quant run `g`'s quad `q` of every row at `32 (8 g + q) + 4 r`, and the
 * side plane's runs after them the same way. The piece `P` gives the header decode, the split of
 * a run's bytes into its two value streams (`lowBytes`, `highBytes`), where those streams lie, and
 * the float step (`add8`). A block has eight or sixteen sub-blocks; with sixteen the driver keeps
 * the activation's 16-value sums ({@link Q8kSubSums}).
 */
public final class BlockGemmRows8<P> {
    KernelBuffer<int32> sums;
    int64 sumsCap;

    public BlockGemmRows8() {
        this.sums #= heap KernelBuffer<int32>((uint64) 16L);
        this.sumsCap = 16L;
    }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + rows8.registeredName(); }

    /** Bytes of {@link #pack}'s layout for `rows` rows of `bpr` blocks. */
    public int64 packedBytes(int64 rows, int64 bpr) { return ((rows + 7L) / 8L) * bpr * this.groupBytes(); }

    /** Bytes of one block of a row group: header, eight rows' quants, eight rows' side plane. */
    public int64 groupBytes() { return this.quantsAt() + 1024L + 8L * (int64) P.planeBytes(); }

    /** Offset of the scales in a packed block. */
    int64 scalesAt() { return P.offset() == 0 ? 64L : 32L; }

    /** Offset of the quants in a packed block. */
    int64 quantsAt() {
        return this.scalesAt() + 8L * (int64) P.subBlocks() * (P.offset() == 0 ? 2L : 1L);
    }

    static int32 u8(int8[] raw, int64 at) { return (int32) raw[at] & 255; }

    static int32 word(int8[] raw, int64 at) {
        return BlockGemmRows8.u8(raw, at) | (BlockGemmRows8.u8(raw, at + 1L) << 8)
            | (BlockGemmRows8.u8(raw, at + 2L) << 16) | (BlockGemmRows8.u8(raw, at + 3L) << 24);
    }

    static void putI32(int8[] out, int64 o, int32 v) {
        out[o] = (int8) (v & 255);
        out[o + 1L] = (int8) ((v >> 8) & 255);
        out[o + 2L] = (int8) ((v >> 16) & 255);
        out[o + 3L] = (int8) ((v >> 24) & 255);
    }

    /** `rows` rows of `bpr` file-layout blocks at `packed[srcOff ..)` into the 8-row interleave at `out[outOff ..)`; rows past `rows` in the last group are zero. */
    public void pack(int8[] packed, int64 srcOff, int64 rows, int64 bpr, int8[] out, int64 outOff) {
        int64 n = this.packedBytes(rows, bpr);
        if (rows % 8L != 0L) {
            int64 z = 0L;
            while (z < n) { out[outOff + z] = (int8) 0; z = z + 1L; }
        }
        int64 bb = (int64) P.blockBytes();
        int64 ho = (int64) P.headOffset();
        int64 h2o = (int64) P.head2Offset();
        int64 qo = (int64) P.quantOffset();
        int64 po = (int64) P.planeOffset();
        int64 pn = (int64) P.planeBytes();
        int64 gb = this.groupBytes();
        int64 so = this.scalesAt();
        int64 qa = this.quantsAt();
        boolean own = P.offset() == 0;
        int64 r = 0L;
        while (r < rows) {
            int64 lane = r % 8L;
            int64 b = 0L;
            while (b < bpr) {
                int64 ro = srcOff + (r * bpr + b) * bb;
                int64 wo = outOff + ((r / 8L) * bpr + b) * gb;
                Vector<int32,4> ha = heap Vector<int32,4>(BlockGemmRows8.word(packed, ro + ho), BlockGemmRows8.word(packed, ro + ho + 4L),
                    BlockGemmRows8.word(packed, ro + ho + 8L), BlockGemmRows8.word(packed, ro + ho + 12L));
                Vector<int32,4> hb = heap Vector<int32,4>(BlockGemmRows8.word(packed, ro + h2o), BlockGemmRows8.word(packed, ro + h2o + 4L),
                    BlockGemmRows8.word(packed, ro + h2o + 8L), BlockGemmRows8.word(packed, ro + h2o + 12L));
                BlockGemmRows8.putI32(out, wo + lane * 4L, Cajeta.f32ToBits(P.dOf(ha, hb)));
                if (own) { BlockGemmRows8.putI32(out, wo + 32L + lane * 4L, Cajeta.f32ToBits(P.dminOf(ha, hb))); }
                uint32 j = 0;
                while (j < P.subBlocks()) {
                    out[wo + so + 8L * (int64) j + lane] = (int8) P.scaleOf(ha, hb, j);
                    if (own) { out[wo + so + 8L * (int64) (P.subBlocks() + j) + lane] = (int8) P.minOf(ha, hb, j); }
                    j = j + 1;
                }
                int64 k = 0L;
                while (k < 128L) {
                    out[wo + qa + 32L * (k / 4L) + 4L * lane + (k % 4L)] = packed[ro + qo + k];
                    k = k + 1L;
                }
                k = 0L;
                while (k < pn) {
                    out[wo + qa + 1024L + 32L * (k / 4L) + 4L * lane + (k % 4L)] = packed[ro + po + k];
                    k = k + 1L;
                }
                b = b + 1L;
            }
            r = r + 1L;
        }
    }

    /** The four activation bytes at `at`, repeated for every row lane. */
    @Device
    static Vector<int8,32> quad(KernelBuffer<int8> xp, int64 at) {
        Vector<int32,1> a = xp.vload<4>(at).asWords();
        int32 s = a[0];
        return heap Vector<int32,8>(s, s, s, s, s, s, s, s).asBytes();
    }

    /** `v`'s lanes to `y[yi ..)`, only the rows below `rows`, set or added. */
    @Device
    static void store(KernelBuffer<float32> y, int64 yi, Vector<float32,8> v, uint32 rows, int64 r0, uint32 accum) {
        if (r0 + 8L <= (int64) rows) {
            if (accum != 0) { y.vstore(yi, y.vload<8>(yi) + v); } else { y.vstore(yi, v); }
            return;
        }
        int64 n = (int64) rows - r0;
        int64 l = 0L;
        while (l < n) {
            if (accum != 0) { y[yi + l] = y[yi + l] + v[l]; } else { y[yi + l] = v[l]; }
            l = l + 1L;
        }
    }

    /** Eight rows' int8 at `at`, a row a lane. */
    @Device
    static Vector<int32,8> lanes(KernelBuffer<int8> w, int64 at) { return w.vload<32>(at).widenLo().widenLo(); }

    /** Eight float32 at `at`. */
    @Device
    static Vector<float32,8> floats(KernelBuffer<int8> w, int64 at) {
        Vector<int32,8> v = w.vload<32>(at).asWords();
        return heap Vector<float32,8>(Cajeta.bitsToF32(v[0]), Cajeta.bitsToF32(v[1]), Cajeta.bitsToF32(v[2]), Cajeta.bitsToF32(v[3]), Cajeta.bitsToF32(v[4]), Cajeta.bitsToF32(v[5]), Cajeta.bitsToF32(v[6]), Cajeta.bitsToF32(v[7]));
    }

    @Kernel(targets = {"cpu"})
    @Occupancy(maxThreads = 256)
    public static void rows8(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp, KernelBuffer<int32> sums,
            uint32 rows, uint32 groups, uint32 gPad, int64 blocksPerRow, int64 nc, int64 chunk,
            int64 xpStride, int64 yStride, uint32 accum) {
        uint32 gi = KernelThread.globalIdX();
        uint32 gr = gi % gPad;
        int64 cBeg = (int64) (gi / gPad) * chunk;
        if (gr < groups && cBeg < nc) {
            int64 r0 = (int64) gr * 8L;
            int64 cEnd = cBeg + chunk < nc ? cBeg + chunk : nc;
            int64 sb = (int64) P.subBlocks();
            int64 own = P.offset() == 0 ? 1L : 0L;
            int64 so = 32L + 32L * own;
            int64 mo = so + 8L * sb * own;
            int64 qo = mo + 8L * sb;
            int64 po = qo + 1024L;
            int64 gb = po + 8L * (int64) P.planeBytes();
            int64 wg = (int64) gr * blocksPerRow * gb;
            Vector<int32,8> z8 = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            Vector<float32,8> zf = z8.toF32();
            int64 c = cBeg;
            while (c < cEnd) {
                int64 c1 = c + 1L < cEnd ? c + 1L : cEnd - 1L;
                int64 c2 = c + 2L < cEnd ? c + 2L : cEnd - 1L;
                int64 c3 = c + 3L < cEnd ? c + 3L : cEnd - 1L;
                int64 x0 = c * xpStride;
                int64 x1 = c1 * xpStride;
                int64 x2 = c2 * xpStride;
                int64 x3 = c3 * xpStride;
                Vector<float32,8> acc0 = zf;
                Vector<float32,8> acc1 = zf;
                Vector<float32,8> acc2 = zf;
                Vector<float32,8> acc3 = zf;
                int64 b = 0L;
                while (b < blocksPerRow) {
                    int64 wo = wg + b * gb;
                    int64 xo = b * 320L;
                    if (c == cBeg && b + 2L < blocksPerRow) {
                        int64 pl = 0L;
                        while (pl < gb / 64L) { w.prefetch(wo + 2L * gb + pl * 64L); pl = pl + 1L; }
                    }
                    Vector<int32,8> si0 = z8;
                    Vector<int32,8> si1 = z8;
                    Vector<int32,8> si2 = z8;
                    Vector<int32,8> si3 = z8;
                    for (int64 g = Unroll.from(0L); g < 4L; g = g + 1L) {
                        int64 ls = (int64) P.lowStream((int32) g);
                        int64 hs = (int64) P.highStream((int32) g);
                        Vector<int32,8> tl0 = z8;
                        Vector<int32,8> th0 = z8;
                        Vector<int32,8> tl1 = z8;
                        Vector<int32,8> th1 = z8;
                        Vector<int32,8> tl2 = z8;
                        Vector<int32,8> th2 = z8;
                        Vector<int32,8> tl3 = z8;
                        Vector<int32,8> th3 = z8;
                        for (int64 h = Unroll.from(0L); h < 2L; h = h + 1L) {
                            for (int64 q4 = Unroll.from(0L); q4 < 4L; q4 = q4 + 1L) {
                                int64 q = 4L * h + q4;
                                Vector<uint8,32> rq = w.vload<32>(wo + qo + 32L * (8L * g + q)).asUnsigned();
                                Vector<uint8,32> plane = rq;
                                if (P.planeBytes() != 0) { plane = w.vload<32>(wo + po + 32L * (8L * (int64) P.planeRun((int32) g) + q)).asUnsigned(); }
                                Vector<uint8,32> lq = P.lowBytes(rq, plane, (int32) g);
                                Vector<uint8,32> hq = P.highBytes(rq, plane, (int32) g);
                                int64 al = xo + 32L * ls + 4L * q;
                                int64 ah = xo + 32L * hs + 4L * q;
                                tl0 = lq.dotAccum(BlockGemmRows8.quad(xp, x0 + al), tl0);
                                th0 = hq.dotAccum(BlockGemmRows8.quad(xp, x0 + ah), th0);
                                tl1 = lq.dotAccum(BlockGemmRows8.quad(xp, x1 + al), tl1);
                                th1 = hq.dotAccum(BlockGemmRows8.quad(xp, x1 + ah), th1);
                                tl2 = lq.dotAccum(BlockGemmRows8.quad(xp, x2 + al), tl2);
                                th2 = hq.dotAccum(BlockGemmRows8.quad(xp, x2 + ah), th2);
                                tl3 = lq.dotAccum(BlockGemmRows8.quad(xp, x3 + al), tl3);
                                th3 = hq.dotAccum(BlockGemmRows8.quad(xp, x3 + ah), th3);
                            }
                            if (sb == 16L || h == 1L) {
                                int64 half = sb == 16L ? h : 0L;
                                Vector<int32,8> scl = BlockGemmRows8.lanes(w, wo + so + 8L * (ls * (sb / 8L) + half));
                                Vector<int32,8> sch = BlockGemmRows8.lanes(w, wo + so + 8L * (hs * (sb / 8L) + half));
                                si0 = si0 + tl0 * scl + th0 * sch;
                                si1 = si1 + tl1 * scl + th1 * sch;
                                si2 = si2 + tl2 * scl + th2 * sch;
                                si3 = si3 + tl3 * scl + th3 * sch;
                                tl0 = z8;
                                th0 = z8;
                                tl1 = z8;
                                th1 = z8;
                                tl2 = z8;
                                th2 = z8;
                                tl3 = z8;
                                th3 = z8;
                            }
                        }
                    }
                    Vector<int32,8> ga0 = z8;
                    Vector<int32,8> ga1 = z8;
                    Vector<int32,8> ga2 = z8;
                    Vector<int32,8> ga3 = z8;
                    Vector<int32,8> gb0 = z8;
                    Vector<int32,8> gb1 = z8;
                    Vector<int32,8> gb2 = z8;
                    Vector<int32,8> gb3 = z8;
                    if (sb == 16L) {
                        ga0 = sums.vload<8>((c * blocksPerRow + b) * 16L);
                        gb0 = sums.vload<8>((c * blocksPerRow + b) * 16L + 8L);
                        ga1 = sums.vload<8>((c1 * blocksPerRow + b) * 16L);
                        gb1 = sums.vload<8>((c1 * blocksPerRow + b) * 16L + 8L);
                        ga2 = sums.vload<8>((c2 * blocksPerRow + b) * 16L);
                        gb2 = sums.vload<8>((c2 * blocksPerRow + b) * 16L + 8L);
                        ga3 = sums.vload<8>((c3 * blocksPerRow + b) * 16L);
                        gb3 = sums.vload<8>((c3 * blocksPerRow + b) * 16L + 8L);
                    } else {
                        ga0 = xp.vload<32>(x0 + xo + 256L).asWords();
                        ga1 = xp.vload<32>(x1 + xo + 256L).asWords();
                        ga2 = xp.vload<32>(x2 + xo + 256L).asWords();
                        ga3 = xp.vload<32>(x3 + xo + 256L).asWords();
                    }
                    Vector<int32,8> dm0 = z8;
                    Vector<int32,8> dm1 = z8;
                    Vector<int32,8> dm2 = z8;
                    Vector<int32,8> dm3 = z8;
                    for (int64 j = Unroll.from(0L); j < 16L; j = j + 1L) {
                        if (j < sb) {
                            Vector<int32,8> m = BlockGemmRows8.lanes(w, wo + mo + 8L * j);
                            int64 l = j % 8L;
                            if (j < 8L) {
                                dm0 = dm0 + m * ga0[l];
                                dm1 = dm1 + m * ga1[l];
                                dm2 = dm2 + m * ga2[l];
                                dm3 = dm3 + m * ga3[l];
                            } else {
                                dm0 = dm0 + m * gb0[l];
                                dm1 = dm1 + m * gb1[l];
                                dm2 = dm2 + m * gb2[l];
                                dm3 = dm3 + m * gb3[l];
                            }
                        }
                    }
                    Vector<float32,8> dv = BlockGemmRows8.floats(w, wo);
                    Vector<float32,8> mv = dv;
                    if (own != 0L) { mv = BlockGemmRows8.floats(w, wo + 32L); }
                    acc0 = P.add8(acc0, dv, mv, Q8kAct.scale(xp, x0 + xo), si0, dm0);
                    acc1 = P.add8(acc1, dv, mv, Q8kAct.scale(xp, x1 + xo), si1, dm1);
                    acc2 = P.add8(acc2, dv, mv, Q8kAct.scale(xp, x2 + xo), si2, dm2);
                    acc3 = P.add8(acc3, dv, mv, Q8kAct.scale(xp, x3 + xo), si3, dm3);
                    b = b + 1L;
                }
                BlockGemmRows8.store(y, c * yStride + r0, acc0, rows, r0, accum);
                if (c + 1L < cEnd) { BlockGemmRows8.store(y, (c + 1L) * yStride + r0, acc1, rows, r0, accum); }
                if (c + 2L < cEnd) { BlockGemmRows8.store(y, (c + 2L) * yStride + r0, acc2, rows, r0, accum); }
                if (c + 3L < cEnd) { BlockGemmRows8.store(y, (c + 3L) * yStride + r0, acc3, rows, r0, accum); }
                c = c + 4L;
            }
        }
    }

    /** `y[t * yStride + r]` set (or added to) for `rows` rows of `blocksPerRow` blocks in {@link #pack}'s layout and `nc` q8_K token rows `xpStride` bytes apart; `block` groups a block and `chunk` tokens a work-item. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp,
            int64 rows, int64 blocksPerRow, int64 nc, int64 xpStride, int64 yStride, boolean accum,
            int64 block, int64 chunk) {
        int64 groups = (rows + 7L) / 8L;
        int64 gBlocks = (groups + block - 1L) / block;
        int64 chunks = (nc + chunk - 1L) / chunk;
        if (P.subBlocks() == 16) {
            int64 need = nc * blocksPerRow * 16L;
            if (need > this.sumsCap) {
                s.sync();
                this.sums #= heap KernelBuffer<int32>((uint64) need);
                this.sumsCap = need;
            }
            Q8kSubSums.run(s, this.sums, xp, nc, blocksPerRow, xpStride);
        }
        rows8.launch(s, grid: [(uint32) (gBlocks * chunks)], block: [(uint32) block])
            (y, w, xp, this.sums, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), blocksPerRow, nc, chunk,
             xpStride, yStride, accum ? 1 : 0);
    }

    /** {@link #runOn} on the current stream. */
    public void run(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp,
            int64 rows, int64 blocksPerRow, int64 nc, int64 xpStride, int64 yStride, boolean accum,
            int64 block, int64 chunk) {
        KernelStream s #= KernelStream.current();
        this.runOn(s, y, w, xp, rows, blocksPerRow, nc, xpStride, yStride, accum, block, chunk);
    }
}
