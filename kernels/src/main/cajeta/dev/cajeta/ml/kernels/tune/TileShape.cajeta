package dev.cajeta.ml.kernels.tune;

import cajeta.lang.String;

/** What every tile family member answers: its registered kernel, tile, threads and fit. */
public interface TileShape {
    #String kernel();
    int32 tileM();
    int32 tileN();
    int32 threads();
    boolean fits(int64 rows, int64 outDim, int64 cols);
}
