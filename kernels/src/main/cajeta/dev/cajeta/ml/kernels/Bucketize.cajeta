package dev.cajeta.ml.kernels;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;

/** Bucketize against sorted edges (spec §4.7): a value lands in its upper-bound bucket, the count of edges at most the value. xgboost's binCells. */
public final class Bucketize {
    public Bucketize() { return; }

    @Kernel
    public static void bucketize<E>(KernelBuffer<int32> out, KernelBuffer<E> vals, KernelBuffer<E> edges, uint32 m, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            E v = vals[i];
            uint32 lo = 0;
            uint32 hi = m;
            while (lo < hi) {
                uint32 mid = lo + (hi - lo) / 2;
                if (edges[mid] <= v) { lo = mid + 1; } else { hi = mid; }
            }
            out[i] = (int32) lo;
        }
    }

    /** `out[i]` = the number of the `m` ascending `edges` at most `vals[i]`; queued on the current stream. */
    public static void upperBound<E>(KernelBuffer<int32> out, KernelBuffer<E> vals, KernelBuffer<E> edges, int64 m, int64 n) {
        uint32 un = (uint32) n;
        KernelStream s #= KernelStream.current();
        bucketize.launch(s, grid: [(un + 255) / 256], block: [256])(out, vals, edges, (uint32) m, un);
    }
}
