package dev.cajeta.ml.kernels.quant;

import cajeta.xpu.Vector;

/**
 * The Q6_K block as pieces (kernel-drivers spec §2.4): 256 values in 210 bytes,
 * { u8 ql[128]; u8 qh[64]; i8 scales[16]; f16 d }, sixteen sub-blocks of 16 values with a signed
 * 8-bit scale each. A quant is a nibble of `ql` and two bits of `qh`, 0..63, and a value is
 * `d * scale * (q - 32)`: there is no min, and the offset is the sub-block's scale times 32, so
 * `minOf` answers the scale and the float step folds the two sums. It meets the block piece
 * contract stated on {@link dev.cajeta.ml.kernels.gemm.BlockGemmRef}.
 */
public final class Q6kBlock {
    public Q6kBlock() { return; }

    @Device
    public static uint32 blockBytes() { return 210; }

    @Device
    public static uint32 quantOffset() { return 0; }

    /** Bytes of quants in a block. */
    @Device
    public static uint32 quantBytes() { return 128; }

    /** Which 32-byte run of the quants the run `g` reads. */
    @Device
    public static int32 quantRun(int32 g) { return g; }

    @Device
    public static uint32 subBlocks() { return 16; }

    @Device
    public static uint32 subValues() { return 16; }

    /** The sixteen scales. */
    @Device
    public static uint32 headOffset() { return 192; }

    /** The block's last 16 bytes, `d` in the top half of word 3. */
    @Device
    public static uint32 head2Offset() { return 194; }

    /** The largest stored quant times the largest scale magnitude; under 256 with `offset()` 0, a driver may fold the scale into the quant bytes. */
    @Device
    public static uint32 quantScaleMax() { return 8001; }

    @Device
    /** cajeta-llm's 8-row cpu interleave for this format, as `BlockGemmRows8` packs and reads it: 0 runs in file order, 1 Q6_K's quant and plane quads interleaved a 96-byte step, 2 the scale-and-min bytes kept whole. */
    @Device
    public static uint32 rowsLayout() { return 1; }

    @Device
    public static uint32 offset() { return 32; }

    /** `qh`, two runs of 32 bytes, one a half block. */
    @Device
    public static uint32 planeBytes() { return 64; }

    @Device
    public static uint32 planeOffset() { return 128; }

    @Device
    public static int32 planeRun(int32 g) { return g >> 1; }

    @Device
    public static int32 lowStream(int32 g) { return 4 * (g >> 1) + (g & 1); }

    @Device
    public static int32 highStream(int32 g) { return 4 * (g >> 1) + (g & 1) + 2; }

    @Device
    public static float32 dOf(Vector<int32,4> ha, Vector<int32,4> hb) { return Q4kBlock.halfBits((hb[3] >> 16) & 65535); }

    @Device
    public static float32 dminOf(Vector<int32,4> ha, Vector<int32,4> hb) { return 0.0f; }

    /** Sub-block `j`'s signed scale, `j` in 0..15. */
    @Device
    public static int32 scaleOf(Vector<int32,4> ha, Vector<int32,4> hb, uint32 j) {
        int32 w = ha[0];
        if (j >= 12) { w = ha[3]; } else if (j >= 8) { w = ha[2]; } else if (j >= 4) { w = ha[1]; }
        return ((w >> (int32) (8 * (j & 3))) << 24) >> 24;
    }

    @Device
    public static int32 minOf(Vector<int32,4> ha, Vector<int32,4> hb, uint32 j) { return Q6kBlock.scaleOf(ha, hb, j); }

    /** Offset in a block of the `ql` byte that holds value `k`'s nibble. */
    @Device
    public static uint32 quantByte(uint32 k) { return 64 * (k >> 7) + 32 * ((k >> 5) & 1) + (k & 31); }

    /** Offset in a block of the `qh` byte that holds value `k`'s two high bits. */
    @Device
    public static uint32 planeByte(uint32 k) { return 128 + 32 * (k >> 7) + (k & 31); }

    /** Value `k`'s quant, 0..63, from its `ql` and `qh` bytes. */
    @Device
    public static int32 quant(int32 b, int32 plane, uint32 k) {
        int32 u = (int32) ((k >> 5) & 3);
        return ((b >> (4 * (u >> 1))) & 15) | (((plane >> (2 * u)) & 3) << 4);
    }

    /** The low-nibble quants of four `ql` words of run `g`, with their high bits from the run's `qh` words. */
    @Device
    public static Vector<int32,4> lowWords(Vector<int32,4> quants, Vector<int32,4> plane, int32 g) {
        return (quants & 252645135) | (((plane >> (2 * (g & 1))) & 50529027) << 4);
    }

    /** The high-nibble quants of four `ql` words of run `g`. */
    @Device
    public static Vector<int32,4> highWords(Vector<int32,4> quants, Vector<int32,4> plane, int32 g) {
        return ((quants >> 4) & 252645135) | (((plane >> (2 * (g & 1) + 4)) & 50529027) << 4);
    }

    /** {@link #lowWords} on 32 bytes, with their high bits from the run's `qh` bytes. */
    @Device
    public static Vector<uint8,N> lowBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 g) {
        return (q & 15) | (((plane.asSigned().asWords() >> (2 * (g & 1))) & 50529027) << 4).asBytes().asUnsigned();
    }

    /** {@link #highWords} on 32 bytes. */
    @Device
    public static Vector<uint8,N> highBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 g) {
        return ((q >> 4) & 15) | (((plane.asSigned().asWords() >> (2 * (g & 1) + 4)) & 50529027) << 4).asBytes().asUnsigned();
    }

    @Device
    public static float32 add(float32 acc, float32 d, float32 dmin, float32 xs, int32 isum, int32 msum) {
        return acc + d * xs * (float32) (isum - msum * 32);
    }

    @Device
    public static Vector<float32,8> add8(Vector<float32,8> acc, Vector<float32,8> d, Vector<float32,8> dmin,
            float32 xs, Vector<int32,8> isum, Vector<int32,8> msum) {
        return acc + d * xs * (isum - msum * 32).toF32();
    }
}
