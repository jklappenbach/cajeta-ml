package dev.cajeta.ml.kernels.quant;

import cajeta.xpu.Vector;

/**
 * The Q4_0 block as pieces (kernel-drivers plan 8.3.1.7): 32 values in 18 bytes, { f16 d; u8 qs[16] }.
 * Value `k` is the low nibble of `qs[k]` for k < 16 and the high nibble of `qs[k - 16]` after, and
 * a value is `d * (q - 8)`. It meets the contract on {@link dev.cajeta.ml.kernels.gemm.Block32GemmRef}.
 */
public final class Q40Block {
    public Q40Block() { return; }

    @Device
    public static uint32 blockBytes() { return 18; }

    @Device
    public static uint32 quantOffset() { return 2; }

    @Device
    public static uint32 quads() { return 4; }

    @Device
    public static uint32 streams() { return 2; }

    @Device
    public static uint32 planeOffset() { return 0; }

    @Device
    public static uint32 planeBytes() { return 0; }

    @Device
    public static int32 fileOffset() { return 8; }

    @Device
    public static int32 offset() { return 8; }

    @Device
    public static float32 dOf(int32 h) { return Q4kBlock.halfBranchless(h & 65535); }

    @Device
    public static int32 packByte(int32 b) { return b & 255; }

    @Device
    public static int32 planeOf(int32 qh, int32 k) { return 0; }

    @Device
    public static uint32 quantByte(uint32 k) { return 2 + (k & 15); }

    @Device
    public static uint32 planeByte(uint32 k) { return 0; }

    @Device
    public static int32 quant(int32 b, int32 plane, uint32 k) { return (b >> (int32) (4 * (k >> 4))) & 15; }

    @Device
    public static int32 lowAt(int32 q) { return 4 * q; }

    @Device
    public static int32 highAt(int32 q) { return 16 + 4 * q; }

    @Device
    public static Vector<uint8,N> lowBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 k) { return q & 15; }

    @Device
    public static Vector<uint8,N> highBytes<uint32 N>(Vector<uint8,N> q, Vector<uint8,N> plane, int32 k) { return (q >> 4) & 15; }

    @Device
    public static float32 fold(float32 fs, float32 d, float32 xsj, int32 t, int32 gs) {
        return fs + d * (float32) (t - gs * 8);
    }

    @Device
    public static Vector<float32,8> fold8(Vector<float32,8> fs, Vector<float32,8> d, float32 xsj, Vector<int32,8> t, int32 gs) {
        return fs + d * (t - gs * 8).toF32();
    }

    @Device
    public static float32 close(float32 acc, float32 fs, float32 xs) { return acc + fs * xs; }

    @Device
    public static Vector<float32,8> close8(Vector<float32,8> acc, Vector<float32,8> fs, float32 xs) { return acc + fs * xs; }

    /** Values 0 to 15 as signed integers (less the offset), from the packed quant bytes `a` (0 to 15) and `b` (16 to 31): the float decode's view. */
    @Device
    public static Vector<int8,16> f32Low(Vector<int8,16> a, Vector<int8,16> b) { return (a & 15) - 8; }

    /** Values 16 to 31 as {@link #f32Low} gives 0 to 15. */
    @Device
    public static Vector<int8,16> f32High(Vector<int8,16> a, Vector<int8,16> b) { return ((a >> 4) & 15) - 8; }

    /** What a set plane bit adds to a value in the float decode; 0 when the format has no plane. */
    @Device
    public static int32 planeWeight() { return 0; }

    /** Value `k`'s plane bit in the packed plane word `pw`. */
    @Device
    public static int32 planeBit(int32 pw, int32 k) { return 0; }
}
