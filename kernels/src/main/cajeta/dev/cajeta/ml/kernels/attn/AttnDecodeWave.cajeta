package dev.cajeta.ml.kernels.attn;

import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Unroll;
import cajeta.xpu.Vector;
import cajeta.xpu.Wave;
import cajeta.xpu.Workgroup;

/**
 * The GPU driver of decode attention (kernel-drivers 9.3): a 32-lane wave per (group of `HEADS`
 * query heads, split) runs the online softmax over its positions, one exp a key, and writes a
 * partial per head (the unscaled accumulator, then m and l) at `(head * splits + split) * (HD + 2)`
 * for a reduce to combine, the cpu driver's layout. A lane holds `DPL` of the head's `HD = 32 DPL`
 * dims; a score is the lane's products summed in order and then across the wave. `KPT` positions
 * a trip, their loads issued before their folds. The first position seeds the recurrence, so no
 * sentinel exp runs. `N` is `HEADS * DPL` and `KD` is `KPT * DPL`, the per-lane vector widths.
 */
@Instantiate({AttnDecodeWave<4, 4, 16, 1, 4>, AttnDecodeWave<4, 4, 16, 4, 16>, AttnDecodeWave<2, 8, 16, 1, 8>,
    AttnDecodeWave<2, 8, 16, 4, 32>})
@Requires(N == HEADS * DPL && KD == KPT * DPL && (KPT == 1 || KPT == 4))
public final class AttnDecodeWave<uint32 HEADS, uint32 DPL, uint32 N, uint32 KPT, uint32 KD> {
    public AttnDecodeWave() { return; }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + decode.registeredName(); }

    /** Query heads a wave. */
    public int32 headsPerWave() { return (int32) HEADS; }

    @Kernel @FastMath @Wave(width = 32)
    public static void decode(KernelBuffer<float32> part, KernelBuffer<float32> q, KernelBuffer<float16> kPool,
            KernelBuffer<float16> vPool, KernelBuffer<int32> pgTab, uint32 pgBase, uint32 nKv, uint32 group, uint32 count,
            uint32 from, uint32 splits, float32 scale) {
        uint32 lane = KernelThread.x();
        uint32 wv = Workgroup.x();
        uint32 hd = 32 * DPL;
        uint32 nH = nKv * group;
        if (wv < (nH / HEADS) * splits) {
            uint32 hg = wv / splits;
            uint32 sp = wv % splits;
            uint32 h0 = hg * HEADS;
            uint32 kvh = h0 / group;
            uint32 chunk = (count + splits - 1) / splits;
            uint32 t0 = sp * chunk;
            uint32 t1 = t0 + chunk;
            if (t1 > count) { t1 = count; }
            uint32 kvDim = nKv * hd;
            uint32 kBase = kvh * hd + lane * DPL;
            Vector<float32,N> qv = q.vload<N>(0L) * 0.0f;
            for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                Vector<float32,DPL> qh = q.vload<DPL>((int64) ((h0 + (uint32) h) * hd + lane * DPL));
                for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) { qv[h * (int64) DPL + i] = qh[i]; }
            }
            Vector<float32,N> acc = qv * 0.0f;
            Vector<float32,HEADS> mv = q.vload<HEADS>(0L) * 0.0f - 3.0e38f;
            Vector<float32,HEADS> lv = mv * 0.0f;
            if (t0 < t1) {
                uint32 r0 = PagedRows.row(pgTab, pgBase, from + t0) * kvDim + kBase;
                Vector<float32,DPL> k0 = kPool.vload<DPL>((int64) r0).toF32();
                Vector<float32,DPL> v0 = vPool.vload<DPL>((int64) r0).toF32();
                for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                    float32 s = qv[h * (int64) DPL] * k0[0];
                    for (int64 i = Unroll.from(1L); i < (int64) DPL; i = i + 1L) { s = s + qv[h * (int64) DPL + i] * k0[i]; }
                    mv[h] = Wave.reduceSumF32(s) * scale;
                    lv[h] = 1.0f;
                    for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) { acc[h * (int64) DPL + i] = v0[i]; }
                }
                uint32 t = t0 + 1;
                while (t + KPT <= t1) {
                    Vector<float32,KD> kt = q.vload<KD>(0L) * 0.0f;
                    Vector<float32,KD> vt = kt;
                    for (int64 j = Unroll.from(0L); j < (int64) KPT; j = j + 1L) {
                        uint32 rj = PagedRows.row(pgTab, pgBase, from + t + (uint32) j) * kvDim + kBase;
                        Vector<float32,DPL> kj = kPool.vload<DPL>((int64) rj).toF32();
                        Vector<float32,DPL> vj = vPool.vload<DPL>((int64) rj).toF32();
                        for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) {
                            kt[j * (int64) DPL + i] = kj[i];
                            vt[j * (int64) DPL + i] = vj[i];
                        }
                    }
                    for (int64 j = Unroll.from(0L); j < (int64) KPT; j = j + 1L) {
                        Vector<float32,HEADS> u = lv * 0.0f;
                        for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                            float32 s = qv[h * (int64) DPL] * kt[j * (int64) DPL];
                            for (int64 i = Unroll.from(1L); i < (int64) DPL; i = i + 1L) {
                                s = s + qv[h * (int64) DPL + i] * kt[j * (int64) DPL + i];
                            }
                            u[h] = Wave.reduceSumF32(s) * scale;
                        }
                        for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                            float32 uh = u[h];
                            float32 mh = mv[h];
                            if (uh > mh) {
                                float32 c = Math.exp(mh - uh);
                                for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) {
                                    acc[h * (int64) DPL + i] = acc[h * (int64) DPL + i] * c + vt[j * (int64) DPL + i];
                                }
                                lv[h] = lv[h] * c + 1.0f;
                                mv[h] = uh;
                            } else {
                                float32 w = Math.exp(uh - mh);
                                for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) {
                                    acc[h * (int64) DPL + i] = acc[h * (int64) DPL + i] + w * vt[j * (int64) DPL + i];
                                }
                                lv[h] = lv[h] + w;
                            }
                        }
                    }
                    t = t + KPT;
                }
                while (t < t1) {
                    uint32 rt = PagedRows.row(pgTab, pgBase, from + t) * kvDim + kBase;
                    Vector<float32,DPL> kj = kPool.vload<DPL>((int64) rt).toF32();
                    Vector<float32,DPL> vj = vPool.vload<DPL>((int64) rt).toF32();
                    Vector<float32,HEADS> u = lv * 0.0f;
                    for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                        float32 s = qv[h * (int64) DPL] * kj[0];
                        for (int64 i = Unroll.from(1L); i < (int64) DPL; i = i + 1L) { s = s + qv[h * (int64) DPL + i] * kj[i]; }
                        u[h] = Wave.reduceSumF32(s) * scale;
                    }
                    for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                        float32 uh = u[h];
                        float32 mh = mv[h];
                        if (uh > mh) {
                            float32 c = Math.exp(mh - uh);
                            for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) {
                                acc[h * (int64) DPL + i] = acc[h * (int64) DPL + i] * c + vj[i];
                            }
                            lv[h] = lv[h] * c + 1.0f;
                            mv[h] = uh;
                        } else {
                            float32 w = Math.exp(uh - mh);
                            for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) {
                                acc[h * (int64) DPL + i] = acc[h * (int64) DPL + i] + w * vj[i];
                            }
                            lv[h] = lv[h] + w;
                        }
                    }
                    t = t + 1;
                }
            }
            for (int64 h = Unroll.from(0L); h < (int64) HEADS; h = h + 1L) {
                uint32 pb = ((h0 + (uint32) h) * splits + sp) * (hd + 2);
                for (int64 i = Unroll.from(0L); i < (int64) DPL; i = i + 1L) {
                    part[(int64) (pb + lane * DPL) + i] = acc[h * (int64) DPL + i];
                }
                if (lane == 0) {
                    part[(int64) (pb + hd)] = mv[h];
                    part[(int64) (pb + hd + 1)] = lv[h];
                }
            }
        }
    }

    /** Partials for `nKv * group` query heads over `count` positions from `from`, `splits` splits a head group, into `part`. Queued on `s`. */
    public void runOn(KernelStream s, KernelBuffer<float32> part, KernelBuffer<float32> q, KernelBuffer<float16> kPool,
            KernelBuffer<float16> vPool, KernelBuffer<int32> pgTab, int32 pgBase, int32 nKv, int32 group, int32 count,
            int32 from, int32 splits, float32 scale) {
        int32 waves = (nKv * group / (int32) HEADS) * splits;
        decode.launch(s, grid: [(uint32) waves], block: [32])
            (part, q, kPool, vPool, pgTab, (uint32) pgBase, (uint32) nKv, (uint32) group, (uint32) count, (uint32) from,
             (uint32) splits, scale);
    }
}
