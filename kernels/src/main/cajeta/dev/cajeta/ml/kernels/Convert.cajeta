package dev.cajeta.ml.kernels;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;

/** Elementwise dtype conversion (spec §4.1): `out[i] = (T) in[i]`, the language cast, so it rounds as the host does. */
public final class Convert {
    public Convert() { return; }

    @Kernel
    public static void convert<F, T>(KernelBuffer<T> out, KernelBuffer<F> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out[i] = (T) in[i]; }
    }

    /** `out[0..n)` = `(T) in[0..n)`: one launch, queued on the current stream. */
    public static void into<F, T>(KernelBuffer<T> out, KernelBuffer<F> in, int64 n) {
        uint32 un = (uint32) n;
        KernelStream s #= KernelStream.current();
        convert.launch(s, grid: [(un + 63) / 64], block: [64])(out, in, un);
    }
}
