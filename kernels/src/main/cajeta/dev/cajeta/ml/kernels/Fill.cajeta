package dev.cajeta.ml.kernels;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;

/** Fill a buffer with one value, at any dtype (spec §4.1); the package's smoke kernel. */
public final class Fill {
    public Fill() { return; }

    @Kernel
    public static void fill<E>(KernelBuffer<E> out, uint32 n, E v) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out[i] = v; }
    }

    /** `out[0..n)` = `v` on the device: one launch, synced. */
    public static void with<E>(KernelBuffer<E> out, int64 n, E v) {
        uint32 un = (uint32) n;
        KernelStream s #= KernelStream.current();
        fill.launch(s, grid: [(un + 63) / 64], block: [64])(out, un, v);
        s.sync();
    }

    /** {@link #with} at float32. */
    public static void f32(KernelBuffer<float32> out, int64 n, float32 v) {
        Fill.with<float32>(out, n, v);
    }

    /** `out[0..n)` = `v`, launched on `s` with no sync: for a caller that pipelines on its own stream. */
    public static void on<E>(KernelStream s, KernelBuffer<E> out, int64 n, E v) {
        uint32 un = (uint32) n;
        fill.launch(s, grid: [(un + 255) / 256], block: [256])(out, un, v);
    }

    /** `out[base + i] = v` for i in [0, n): a range of a larger buffer, without a slice. */
    @Kernel
    public static void fillRange<E>(KernelBuffer<E> out, uint32 base, uint32 n, E v) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out[base + i] = v; }
    }

    /** `out[base .. base + n)` = `v`, launched on `s` with no sync. */
    public static void rangeOn<E>(KernelStream s, KernelBuffer<E> out, int64 base, int64 n, E v) {
        uint32 un = (uint32) n;
        fillRange.launch(s, grid: [(un + 255) / 256], block: [256])(out, (uint32) base, un, v);
    }
}
