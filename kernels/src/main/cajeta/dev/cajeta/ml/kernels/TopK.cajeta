package dev.cajeta.ml.kernels;

import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/**
 * Per-row top-k (spec §4.4), k up to 64, by k threshold-chained arg-max passes: pass j
 * takes the best element strictly below the previous pick, or equal to it at a higher
 * index, which reproduces the serial rule (descending value, ascending index among
 * equals) without rewriting the row. llm's moeTopK.
 */
public final class TopK {
    public TopK() { return; }

    /** Block r: k passes, each a strided per-lane best over the eligible elements and a shared-memory tree. */
    @Kernel
    public static void topk<E>(KernelBuffer<int32> idx, KernelBuffer<E> in, uint32 cols, uint32 k) {
        Shared<E> bv = shared E[256];
        Shared<int32> bi = shared int32[256];
        uint32 t = KernelThread.x();
        uint32 r = Workgroup.x();
        E vLast = (E) 0;
        int32 iLast = -1;
        uint32 j = 0;
        while (j < k) {
            E best = (E) 0;
            int32 bestI = -1;
            uint32 c = t;
            while (c < cols) {
                E x = in[r * cols + c];
                boolean ok = iLast < 0 || x < vLast || (x == vLast && (int32) c > iLast);
                if (ok && (bestI < 0 || x > best)) { best = x; bestI = (int32) c; }
                c = c + 256;
            }
            bv[t] = best;
            bi[t] = bestI;
            Barrier.workgroup();
            uint32 rs = 128;
            while (rs > 0) {
                if (t < rs) {
                    E ov = bv[t + rs];
                    int32 oi = bi[t + rs];
                    E mv = bv[t];
                    int32 mi = bi[t];
                    boolean take = false;
                    if (oi >= 0) {
                        if (mi < 0) { take = true; }
                        else if (ov > mv) { take = true; }
                        else if (ov == mv && oi < mi) { take = true; }
                    }
                    if (take) { bv[t] = ov; bi[t] = oi; }
                }
                Barrier.workgroup();
                rs = rs / 2;
            }
            vLast = bv[0];
            iLast = bi[0];
            if (t == 0) { idx[r * k + j] = iLast; }
            Barrier.workgroup();
            j = j + 1;
        }
    }

    /** `idx[r*k .. r*k+k)` = the top-k indices of row r, best first; `k` from 1 to 64; synced. */
    public static void rows<E>(KernelBuffer<int32> idx, KernelBuffer<E> in, int64 rows, int64 cols, int64 k) {
        KernelStream s #= KernelStream.current();
        topk.launch(s, grid: [(uint32) rows], block: [256])(idx, in, (uint32) cols, (uint32) k);
        s.sync();
    }
}
