package dev.cajeta.ml.kernels.nn;

import cajeta.xpu.Barrier;
import cajeta.xpu.GroupOp;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/** 2-D convolution over NCHW input with an (O,C,KH,KW) kernel and a bias (spec §6.6), float32 accumulation:
 *  a tiled kernel (a workgroup owns 256 output positions and 16 output channels, the weights of a channel
 *  chunk in LDS, 16 accumulators a lane) and the one-lane-per-output kernel it falls back to. */
public final class Conv {
    public Conv() { return; }

    /** The LDS words the tiled kernel stages weights in: 16 output channels x a chunk of input channels x the window. */
    public static int64 TILE_WORDS = 4096L;

    /** The tiled form: a workgroup owns 256 lanes x two output columns (a half-row apart, so neighbouring lanes
     *  stay coalesced) x 16 output channels; the weights of a channel chunk sit in LDS and each lane keeps 32
     *  accumulators, so one LDS read of a weight feeds two multiply-adds and one input load feeds sixteen. */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void conv2dTiled<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b,
                                      uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oc, uint32 kh, uint32 kw,
                                      uint32 oh, uint32 ow, int32 stride, int32 pad, uint32 chunk) {
        Shared<float32> sw = shared float32[4096];
        uint32 tid = KernelThread.x();
        uint32 owHalf = (ow + 1) / 2;
        uint32 p = Workgroup.x() * 256 + tid;
        uint32 ocBase = Workgroup.y() * 16;
        uint32 positions = n * oh * owHalf;
        boolean active = p < positions;
        uint32 xx0 = 0;
        uint32 y = 0;
        uint32 bn = 0;
        if (active) {
            xx0 = p % owHalf;
            uint32 q = p / owHalf;
            y = q % oh;
            bn = q / oh;
        }
        uint32 xx1 = xx0 + owHalf;
        boolean col1 = active && xx1 < ow;
        float32 a0 = 0.0f; float32 a1 = 0.0f; float32 a2 = 0.0f; float32 a3 = 0.0f; float32 a4 = 0.0f; float32 a5 = 0.0f; float32 a6 = 0.0f; float32 a7 = 0.0f; float32 a8 = 0.0f; float32 a9 = 0.0f; float32 a10 = 0.0f; float32 a11 = 0.0f; float32 a12 = 0.0f; float32 a13 = 0.0f; float32 a14 = 0.0f; float32 a15 = 0.0f;
        float32 c0 = 0.0f; float32 c1 = 0.0f; float32 c2 = 0.0f; float32 c3 = 0.0f; float32 c4 = 0.0f; float32 c5 = 0.0f; float32 c6 = 0.0f; float32 c7 = 0.0f; float32 c8 = 0.0f; float32 c9 = 0.0f; float32 c10 = 0.0f; float32 c11 = 0.0f; float32 c12 = 0.0f; float32 c13 = 0.0f; float32 c14 = 0.0f; float32 c15 = 0.0f;
        uint32 kk = kh * kw;
        uint32 ci0 = 0;
        while (ci0 < c) {
            uint32 cn = c - ci0;
            if (cn > chunk) { cn = chunk; }
            uint32 words = cn * kk * 16;
            uint32 i = tid;
            while (i < words) {
                uint32 oo = i % 16;
                uint32 r = i / 16;
                uint32 ae = r % kk;
                uint32 cl = r / kk;
                uint32 o = ocBase + oo;
                float32 v = 0.0f;
                if (o < oc) { v = (float32) w[(o * c + ci0 + cl) * kk + ae]; }
                sw[i] = v;
                i = i + 256;
            }
            Barrier.workgroup();
            if (active) {
                uint32 cl = 0;
                while (cl < cn) {
                    uint32 rowBase = ((bn * c + ci0 + cl) * h) * wd;
                    uint32 a = 0;
                    while (a < kh) {
                        int32 ih = (int32) y * stride - pad + (int32) a;
                        if (ih >= 0 && ih < (int32) h) {
                            uint32 row = rowBase + (uint32) ih * wd;
                            uint32 e = 0;
                            while (e < kw) {
                                int32 iw0 = (int32) xx0 * stride - pad + (int32) e;
                                int32 iw1 = (int32) xx1 * stride - pad + (int32) e;
                                float32 xv0 = 0.0f;
                                float32 xv1 = 0.0f;
                                if (iw0 >= 0 && iw0 < (int32) wd) { xv0 = (float32) x[row + (uint32) iw0]; }
                                if (col1 && iw1 >= 0 && iw1 < (int32) wd) { xv1 = (float32) x[row + (uint32) iw1]; }
                                uint32 base = (cl * kk + a * kw + e) * 16;
                                float32 wv = 0.0f;
                                wv = sw[base + 0]; a0 = a0 + xv0 * wv; c0 = c0 + xv1 * wv;
                                wv = sw[base + 1]; a1 = a1 + xv0 * wv; c1 = c1 + xv1 * wv;
                                wv = sw[base + 2]; a2 = a2 + xv0 * wv; c2 = c2 + xv1 * wv;
                                wv = sw[base + 3]; a3 = a3 + xv0 * wv; c3 = c3 + xv1 * wv;
                                wv = sw[base + 4]; a4 = a4 + xv0 * wv; c4 = c4 + xv1 * wv;
                                wv = sw[base + 5]; a5 = a5 + xv0 * wv; c5 = c5 + xv1 * wv;
                                wv = sw[base + 6]; a6 = a6 + xv0 * wv; c6 = c6 + xv1 * wv;
                                wv = sw[base + 7]; a7 = a7 + xv0 * wv; c7 = c7 + xv1 * wv;
                                wv = sw[base + 8]; a8 = a8 + xv0 * wv; c8 = c8 + xv1 * wv;
                                wv = sw[base + 9]; a9 = a9 + xv0 * wv; c9 = c9 + xv1 * wv;
                                wv = sw[base + 10]; a10 = a10 + xv0 * wv; c10 = c10 + xv1 * wv;
                                wv = sw[base + 11]; a11 = a11 + xv0 * wv; c11 = c11 + xv1 * wv;
                                wv = sw[base + 12]; a12 = a12 + xv0 * wv; c12 = c12 + xv1 * wv;
                                wv = sw[base + 13]; a13 = a13 + xv0 * wv; c13 = c13 + xv1 * wv;
                                wv = sw[base + 14]; a14 = a14 + xv0 * wv; c14 = c14 + xv1 * wv;
                                wv = sw[base + 15]; a15 = a15 + xv0 * wv; c15 = c15 + xv1 * wv;
                                e = e + 1;
                            }
                        }
                        a = a + 1;
                    }
                    cl = cl + 1;
                }
            }
            Barrier.workgroup();
            ci0 = ci0 + cn;
        }
        if (active) {
            uint32 plane = oh * ow;
            uint32 o0 = (bn * oc + ocBase) * plane + y * ow + xx0;
            if (ocBase + 0 < oc) { out[o0 + 0 * plane] = (E) (a0 + (float32) b[ocBase + 0]); }
            if (ocBase + 1 < oc) { out[o0 + 1 * plane] = (E) (a1 + (float32) b[ocBase + 1]); }
            if (ocBase + 2 < oc) { out[o0 + 2 * plane] = (E) (a2 + (float32) b[ocBase + 2]); }
            if (ocBase + 3 < oc) { out[o0 + 3 * plane] = (E) (a3 + (float32) b[ocBase + 3]); }
            if (ocBase + 4 < oc) { out[o0 + 4 * plane] = (E) (a4 + (float32) b[ocBase + 4]); }
            if (ocBase + 5 < oc) { out[o0 + 5 * plane] = (E) (a5 + (float32) b[ocBase + 5]); }
            if (ocBase + 6 < oc) { out[o0 + 6 * plane] = (E) (a6 + (float32) b[ocBase + 6]); }
            if (ocBase + 7 < oc) { out[o0 + 7 * plane] = (E) (a7 + (float32) b[ocBase + 7]); }
            if (ocBase + 8 < oc) { out[o0 + 8 * plane] = (E) (a8 + (float32) b[ocBase + 8]); }
            if (ocBase + 9 < oc) { out[o0 + 9 * plane] = (E) (a9 + (float32) b[ocBase + 9]); }
            if (ocBase + 10 < oc) { out[o0 + 10 * plane] = (E) (a10 + (float32) b[ocBase + 10]); }
            if (ocBase + 11 < oc) { out[o0 + 11 * plane] = (E) (a11 + (float32) b[ocBase + 11]); }
            if (ocBase + 12 < oc) { out[o0 + 12 * plane] = (E) (a12 + (float32) b[ocBase + 12]); }
            if (ocBase + 13 < oc) { out[o0 + 13 * plane] = (E) (a13 + (float32) b[ocBase + 13]); }
            if (ocBase + 14 < oc) { out[o0 + 14 * plane] = (E) (a14 + (float32) b[ocBase + 14]); }
            if (ocBase + 15 < oc) { out[o0 + 15 * plane] = (E) (a15 + (float32) b[ocBase + 15]); }
            if (col1) {
                uint32 o1 = o0 + owHalf;
                if (ocBase + 0 < oc) { out[o1 + 0 * plane] = (E) (c0 + (float32) b[ocBase + 0]); }
                if (ocBase + 1 < oc) { out[o1 + 1 * plane] = (E) (c1 + (float32) b[ocBase + 1]); }
                if (ocBase + 2 < oc) { out[o1 + 2 * plane] = (E) (c2 + (float32) b[ocBase + 2]); }
                if (ocBase + 3 < oc) { out[o1 + 3 * plane] = (E) (c3 + (float32) b[ocBase + 3]); }
                if (ocBase + 4 < oc) { out[o1 + 4 * plane] = (E) (c4 + (float32) b[ocBase + 4]); }
                if (ocBase + 5 < oc) { out[o1 + 5 * plane] = (E) (c5 + (float32) b[ocBase + 5]); }
                if (ocBase + 6 < oc) { out[o1 + 6 * plane] = (E) (c6 + (float32) b[ocBase + 6]); }
                if (ocBase + 7 < oc) { out[o1 + 7 * plane] = (E) (c7 + (float32) b[ocBase + 7]); }
                if (ocBase + 8 < oc) { out[o1 + 8 * plane] = (E) (c8 + (float32) b[ocBase + 8]); }
                if (ocBase + 9 < oc) { out[o1 + 9 * plane] = (E) (c9 + (float32) b[ocBase + 9]); }
                if (ocBase + 10 < oc) { out[o1 + 10 * plane] = (E) (c10 + (float32) b[ocBase + 10]); }
                if (ocBase + 11 < oc) { out[o1 + 11 * plane] = (E) (c11 + (float32) b[ocBase + 11]); }
                if (ocBase + 12 < oc) { out[o1 + 12 * plane] = (E) (c12 + (float32) b[ocBase + 12]); }
                if (ocBase + 13 < oc) { out[o1 + 13 * plane] = (E) (c13 + (float32) b[ocBase + 13]); }
                if (ocBase + 14 < oc) { out[o1 + 14 * plane] = (E) (c14 + (float32) b[ocBase + 14]); }
                if (ocBase + 15 < oc) { out[o1 + 15 * plane] = (E) (c15 + (float32) b[ocBase + 15]); }
            }
        }
    }

    @Kernel
    public static void conv2d<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b,
                                 uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oc, uint32 kh, uint32 kw,
                                 uint32 oh, uint32 ow, int32 stride, int32 pad) {
        uint32 t = KernelThread.globalIdX();
        uint32 total = n * oc * oh * ow;
        if (t < total) {
            uint32 xx = t % ow;
            uint32 q = t / ow;
            uint32 y = q % oh;
            q = q / oh;
            uint32 o = q % oc;
            uint32 bn = q / oc;
            float32 acc = (float32) b[o];
            uint32 ci = 0;
            while (ci < c) {
                uint32 a = 0;
                while (a < kh) {
                    int32 ih = (int32) y * stride - pad + (int32) a;
                    if (ih >= 0 && ih < (int32) h) {
                        uint32 e = 0;
                        while (e < kw) {
                            int32 iw = (int32) xx * stride - pad + (int32) e;
                            if (iw >= 0 && iw < (int32) wd) {
                                uint32 xi = ((bn * c + ci) * h + (uint32) ih) * wd + (uint32) iw;
                                uint32 wi = ((o * c + ci) * kh + a) * kw + e;
                                acc = acc + (float32) x[xi] * (float32) w[wi];
                            }
                            e = e + 1;
                        }
                    }
                    a = a + 1;
                }
                ci = ci + 1;
            }
            out[t] = (E) acc;
        }
    }

    /** `out` (n,oc,oh,ow) = conv2d of `x` (n,c,h,wd) with `w` (oc,c,kh,kw) plus `b` (oc); queued on the current stream. The tiled
     *  kernel unless one channel's window outgrows the LDS chunk, then the direct one. */
    public static void forward<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b,
                                  int64 n, int64 c, int64 h, int64 wd, int64 oc, int64 kh, int64 kw,
                                  int64 oh, int64 ow, int32 stride, int32 pad) {
        int64 perChannel = 16L * kh * kw;
        if (perChannel > Conv.TILE_WORDS) {
            Conv.forwardDirect<E>(out, x, w, b, n, c, h, wd, oc, kh, kw, oh, ow, stride, pad);
            return;
        }
        KernelStream s #= KernelStream.current();
        Conv.launchTiled<E>(s, out, x, w, b, n, c, h, wd, oc, kh, kw, oh, ow, stride, pad);
    }

    /** The one-lane-per-output form of `forward`; queued on the current stream. */
    public static void forwardDirect<E>(KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b,
                                        int64 n, int64 c, int64 h, int64 wd, int64 oc, int64 kh, int64 kw,
                                        int64 oh, int64 ow, int32 stride, int32 pad) {
        KernelStream s #= KernelStream.current();
        Conv.launchDirect<E>(s, out, x, w, b, n, c, h, wd, oc, kh, kw, oh, ow, stride, pad);
    }

    /** Queues the tiled kernel on `s` without syncing; the caller must know 16 * kh * kw <= TILE_WORDS. */
    public static void launchTiled<E>(KernelStream s, KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b,
                                      int64 n, int64 c, int64 h, int64 wd, int64 oc, int64 kh, int64 kw,
                                      int64 oh, int64 ow, int32 stride, int32 pad) {
        int64 chunk = Conv.TILE_WORDS / (16L * kh * kw);
        if (chunk > c) { chunk = c; }
        uint32 positions = (uint32) (n * oh * ((ow + 1L) / 2L));
        uint32 ocTiles = (uint32) ((oc + 15L) / 16L);
        conv2dTiled.launch(s, grid: [(positions + 255) / 256, ocTiles], block: [256])(out, x, w, b, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oc, (uint32) kh, (uint32) kw, (uint32) oh, (uint32) ow, stride, pad, (uint32) chunk);
    }

    /** Queues the one-lane-per-output kernel on `s` without syncing. */
    public static void launchDirect<E>(KernelStream s, KernelBuffer<E> out, KernelBuffer<E> x, KernelBuffer<E> w, KernelBuffer<E> b,
                                       int64 n, int64 c, int64 h, int64 wd, int64 oc, int64 kh, int64 kw,
                                       int64 oh, int64 ow, int32 stride, int32 pad) {
        uint32 total = (uint32) (n * oc * oh * ow);
        conv2d.launch(s, grid: [(total + 255) / 256], block: [256])(out, x, w, b, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oc, (uint32) kh, (uint32) kw, (uint32) oh, (uint32) ow, stride, pad);
    }

    /** dx[bn][ci][ih][iw] = sum over the outputs whose window covers it of g * w, one lane per input element. */
    @Kernel
    public static void convBackIn<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> w,
                                 uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oc, uint32 kh, uint32 kw,
                                 uint32 oh, uint32 ow, int32 stride, int32 pad) {
        uint32 t = KernelThread.globalIdX();
        if (t < n * c * h * wd) {
            uint32 iw = t % wd;
            uint32 q = t / wd;
            uint32 ih = q % h;
            q = q / h;
            uint32 ci = q % c;
            uint32 bn = q / c;
            float32 acc = 0.0f;
            uint32 a = 0;
            while (a < kh) {
                int32 yn = (int32) ih + pad - (int32) a;
                if (yn >= 0 && yn - (yn / stride) * stride == 0 && yn / stride < (int32) oh) {
                    uint32 y = (uint32) (yn / stride);
                    uint32 e = 0;
                    while (e < kw) {
                        int32 xn = (int32) iw + pad - (int32) e;
                        if (xn >= 0 && xn - (xn / stride) * stride == 0 && xn / stride < (int32) ow) {
                            uint32 xx = (uint32) (xn / stride);
                            uint32 o = 0;
                            while (o < oc) {
                                acc = acc + (float32) g[((bn * oc + o) * oh + y) * ow + xx] * (float32) w[((o * c + ci) * kh + a) * kw + e];
                                o = o + 1;
                            }
                        }
                        e = e + 1;
                    }
                }
                a = a + 1;
            }
            dx[t] = (E) acc;
        }
    }

    /** dx = the conv2d input VJP of `g` (n,oc,oh,ow) with `w` (oc,c,kh,kw); queued on the current stream. */
    public static void backwardInput<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> w,
                                        int64 n, int64 c, int64 h, int64 wd, int64 oc, int64 kh, int64 kw,
                                        int64 oh, int64 ow, int32 stride, int32 pad) {
        uint32 total = (uint32) (n * c * h * wd);
        KernelStream s #= KernelStream.current();
        convBackIn.launch(s, grid: [(total + 255) / 256], block: [256])(dx, g, w, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oc, (uint32) kh, (uint32) kw, (uint32) oh, (uint32) ow, stride, pad);
    }

    /** part[w * splits + p] = the weight VJP of weight w over the batch slice p of `splits`: one lane per (weight, slice). */
    @Kernel
    public static void convBackWeightSplit<E>(KernelBuffer<float32> part, KernelBuffer<E> g, KernelBuffer<E> x,
                                          uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oc, uint32 kh, uint32 kw,
                                          uint32 oh, uint32 ow, int32 stride, int32 pad, uint32 splits) {
        uint32 lane = KernelThread.globalIdX();
        if (lane < oc * c * kh * kw * splits) {
            uint32 sp = lane % splits;
            uint32 t = lane / splits;
            uint32 e = t % kw;
            uint32 q = t / kw;
            uint32 a = q % kh;
            q = q / kh;
            uint32 ci = q % c;
            uint32 o = q / c;
            float32 acc = 0.0f;
            uint32 bn = sp;
            while (bn < n) {
                uint32 y = 0;
                while (y < oh) {
                    int32 ih = (int32) y * stride - pad + (int32) a;
                    if (ih >= 0 && ih < (int32) h) {
                        uint32 xx = 0;
                        while (xx < ow) {
                            int32 iw = (int32) xx * stride - pad + (int32) e;
                            if (iw >= 0 && iw < (int32) wd) {
                                acc = acc + (float32) g[((bn * oc + o) * oh + y) * ow + xx] * (float32) x[((bn * c + ci) * h + (uint32) ih) * wd + (uint32) iw];
                            }
                            xx = xx + 1;
                        }
                    }
                    y = y + 1;
                }
                bn = bn + splits;
            }
            part[lane] = acc;
        }
    }

    /** dw for a 3x3 kernel: a workgroup per four output channels and one input channel, lanes striding the n*oh*ow
     *  positions so loads coalesce and each input tap serves four outputs; the 36 sums reduced in a fixed order. */
    @Kernel @Wave(width = 32)
    public static void convBackWeight3x3<E>(KernelBuffer<E> dw, KernelBuffer<E> g, KernelBuffer<E> x,
                                            uint32 n, uint32 c, uint32 h, uint32 wd, uint32 oc,
                                            uint32 oh, uint32 ow, int32 stride, int32 pad) {
        uint32 wg = Workgroup.x();
        uint32 ob = (wg / c) * 4;
        uint32 ci = wg % c;
        uint32 plane = oh * ow;
        uint32 gs = oh * ow;
        boolean v1 = ob + 1 < oc;
        boolean v2 = ob + 2 < oc;
        boolean v3 = ob + 3 < oc;
        float32 a00 = 0.0f; float32 a01 = 0.0f; float32 a02 = 0.0f; float32 a03 = 0.0f; float32 a04 = 0.0f; float32 a05 = 0.0f; float32 a06 = 0.0f; float32 a07 = 0.0f; float32 a08 = 0.0f;
        float32 a10 = 0.0f; float32 a11 = 0.0f; float32 a12 = 0.0f; float32 a13 = 0.0f; float32 a14 = 0.0f; float32 a15 = 0.0f; float32 a16 = 0.0f; float32 a17 = 0.0f; float32 a18 = 0.0f;
        float32 a20 = 0.0f; float32 a21 = 0.0f; float32 a22 = 0.0f; float32 a23 = 0.0f; float32 a24 = 0.0f; float32 a25 = 0.0f; float32 a26 = 0.0f; float32 a27 = 0.0f; float32 a28 = 0.0f;
        float32 a30 = 0.0f; float32 a31 = 0.0f; float32 a32 = 0.0f; float32 a33 = 0.0f; float32 a34 = 0.0f; float32 a35 = 0.0f; float32 a36 = 0.0f; float32 a37 = 0.0f; float32 a38 = 0.0f;
        uint32 lane = KernelThread.x();
        uint32 total = n * plane;
        uint32 p = lane;
        while (p < total) {
            uint32 bn = p / plane;
            uint32 r = p % plane;
            uint32 y = r / ow;
            uint32 xx = r % ow;
            uint32 gb = (bn * oc + ob) * gs + y * ow + xx;
            float32 g0 = (float32) g[gb];
            float32 g1 = 0.0f; float32 g2 = 0.0f; float32 g3 = 0.0f;
            if (v1) { g1 = (float32) g[gb + gs]; }
            if (v2) { g2 = (float32) g[gb + 2 * gs]; }
            if (v3) { g3 = (float32) g[gb + 3 * gs]; }
            int32 ih0 = (int32) y * stride - pad;
            int32 iw0 = (int32) xx * stride - pad;
            uint32 xb = (bn * c + ci) * h;
            boolean c0 = iw0 >= 0 && iw0 < (int32) wd;
            boolean c1 = iw0 + 1 >= 0 && iw0 + 1 < (int32) wd;
            boolean c2 = iw0 + 2 >= 0 && iw0 + 2 < (int32) wd;
            if (ih0 + 0 >= 0 && ih0 + 0 < (int32) h) {
                uint32 rb = (xb + (uint32) (ih0 + 0)) * wd;
                if (c0) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 0)];
                    a00 = a00 + g0 * xv; a10 = a10 + g1 * xv; a20 = a20 + g2 * xv; a30 = a30 + g3 * xv;
                }
                if (c1) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 1)];
                    a01 = a01 + g0 * xv; a11 = a11 + g1 * xv; a21 = a21 + g2 * xv; a31 = a31 + g3 * xv;
                }
                if (c2) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 2)];
                    a02 = a02 + g0 * xv; a12 = a12 + g1 * xv; a22 = a22 + g2 * xv; a32 = a32 + g3 * xv;
                }
            }
            if (ih0 + 1 >= 0 && ih0 + 1 < (int32) h) {
                uint32 rb = (xb + (uint32) (ih0 + 1)) * wd;
                if (c0) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 0)];
                    a03 = a03 + g0 * xv; a13 = a13 + g1 * xv; a23 = a23 + g2 * xv; a33 = a33 + g3 * xv;
                }
                if (c1) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 1)];
                    a04 = a04 + g0 * xv; a14 = a14 + g1 * xv; a24 = a24 + g2 * xv; a34 = a34 + g3 * xv;
                }
                if (c2) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 2)];
                    a05 = a05 + g0 * xv; a15 = a15 + g1 * xv; a25 = a25 + g2 * xv; a35 = a35 + g3 * xv;
                }
            }
            if (ih0 + 2 >= 0 && ih0 + 2 < (int32) h) {
                uint32 rb = (xb + (uint32) (ih0 + 2)) * wd;
                if (c0) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 0)];
                    a06 = a06 + g0 * xv; a16 = a16 + g1 * xv; a26 = a26 + g2 * xv; a36 = a36 + g3 * xv;
                }
                if (c1) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 1)];
                    a07 = a07 + g0 * xv; a17 = a17 + g1 * xv; a27 = a27 + g2 * xv; a37 = a37 + g3 * xv;
                }
                if (c2) {
                    float32 xv = (float32) x[rb + (uint32) (iw0 + 2)];
                    a08 = a08 + g0 * xv; a18 = a18 + g1 * xv; a28 = a28 + g2 * xv; a38 = a38 + g3 * xv;
                }
            }
            p = p + 256;
        }
        float32 s00 = Workgroup.reduce(GroupOp.Add, a00);
        float32 s01 = Workgroup.reduce(GroupOp.Add, a01);
        float32 s02 = Workgroup.reduce(GroupOp.Add, a02);
        float32 s03 = Workgroup.reduce(GroupOp.Add, a03);
        float32 s04 = Workgroup.reduce(GroupOp.Add, a04);
        float32 s05 = Workgroup.reduce(GroupOp.Add, a05);
        float32 s06 = Workgroup.reduce(GroupOp.Add, a06);
        float32 s07 = Workgroup.reduce(GroupOp.Add, a07);
        float32 s08 = Workgroup.reduce(GroupOp.Add, a08);
        float32 s10 = Workgroup.reduce(GroupOp.Add, a10);
        float32 s11 = Workgroup.reduce(GroupOp.Add, a11);
        float32 s12 = Workgroup.reduce(GroupOp.Add, a12);
        float32 s13 = Workgroup.reduce(GroupOp.Add, a13);
        float32 s14 = Workgroup.reduce(GroupOp.Add, a14);
        float32 s15 = Workgroup.reduce(GroupOp.Add, a15);
        float32 s16 = Workgroup.reduce(GroupOp.Add, a16);
        float32 s17 = Workgroup.reduce(GroupOp.Add, a17);
        float32 s18 = Workgroup.reduce(GroupOp.Add, a18);
        float32 s20 = Workgroup.reduce(GroupOp.Add, a20);
        float32 s21 = Workgroup.reduce(GroupOp.Add, a21);
        float32 s22 = Workgroup.reduce(GroupOp.Add, a22);
        float32 s23 = Workgroup.reduce(GroupOp.Add, a23);
        float32 s24 = Workgroup.reduce(GroupOp.Add, a24);
        float32 s25 = Workgroup.reduce(GroupOp.Add, a25);
        float32 s26 = Workgroup.reduce(GroupOp.Add, a26);
        float32 s27 = Workgroup.reduce(GroupOp.Add, a27);
        float32 s28 = Workgroup.reduce(GroupOp.Add, a28);
        float32 s30 = Workgroup.reduce(GroupOp.Add, a30);
        float32 s31 = Workgroup.reduce(GroupOp.Add, a31);
        float32 s32 = Workgroup.reduce(GroupOp.Add, a32);
        float32 s33 = Workgroup.reduce(GroupOp.Add, a33);
        float32 s34 = Workgroup.reduce(GroupOp.Add, a34);
        float32 s35 = Workgroup.reduce(GroupOp.Add, a35);
        float32 s36 = Workgroup.reduce(GroupOp.Add, a36);
        float32 s37 = Workgroup.reduce(GroupOp.Add, a37);
        float32 s38 = Workgroup.reduce(GroupOp.Add, a38);
        if (lane == 0) {
            {
                uint32 wb0 = ((ob + 0) * c + ci) * 9;
                dw[wb0 + 0] = (E) s00; dw[wb0 + 1] = (E) s01; dw[wb0 + 2] = (E) s02; dw[wb0 + 3] = (E) s03; dw[wb0 + 4] = (E) s04; dw[wb0 + 5] = (E) s05; dw[wb0 + 6] = (E) s06; dw[wb0 + 7] = (E) s07; dw[wb0 + 8] = (E) s08;
            }
            if (v1) {
                uint32 wb1 = ((ob + 1) * c + ci) * 9;
                dw[wb1 + 0] = (E) s10; dw[wb1 + 1] = (E) s11; dw[wb1 + 2] = (E) s12; dw[wb1 + 3] = (E) s13; dw[wb1 + 4] = (E) s14; dw[wb1 + 5] = (E) s15; dw[wb1 + 6] = (E) s16; dw[wb1 + 7] = (E) s17; dw[wb1 + 8] = (E) s18;
            }
            if (v2) {
                uint32 wb2 = ((ob + 2) * c + ci) * 9;
                dw[wb2 + 0] = (E) s20; dw[wb2 + 1] = (E) s21; dw[wb2 + 2] = (E) s22; dw[wb2 + 3] = (E) s23; dw[wb2 + 4] = (E) s24; dw[wb2 + 5] = (E) s25; dw[wb2 + 6] = (E) s26; dw[wb2 + 7] = (E) s27; dw[wb2 + 8] = (E) s28;
            }
            if (v3) {
                uint32 wb3 = ((ob + 3) * c + ci) * 9;
                dw[wb3 + 0] = (E) s30; dw[wb3 + 1] = (E) s31; dw[wb3 + 2] = (E) s32; dw[wb3 + 3] = (E) s33; dw[wb3 + 4] = (E) s34; dw[wb3 + 5] = (E) s35; dw[wb3 + 6] = (E) s36; dw[wb3 + 7] = (E) s37; dw[wb3 + 8] = (E) s38;
            }
        }
    }

    /** dw[w] = the sum of its `splits` partials, in slice order. */
    @Kernel
    public static void convBackWeightSum<E>(KernelBuffer<E> dw, KernelBuffer<float32> part, uint32 weights, uint32 splits) {
        uint32 t = KernelThread.globalIdX();
        if (t < weights) {
            float32 acc = 0.0f;
            uint32 p = 0;
            while (p < splits) {
                acc = acc + part[t * splits + p];
                p = p + 1;
            }
            dw[t] = (E) acc;
        }
    }

    /** dw = the conv2d weight VJP of `g` against `x`: a 3x3 kernel by {@link #convBackWeight3x3}, queued; any other by
     *  batch slices across lanes, synced, since it drops device temporaries (cajeta-ml-gpu 28.2.6). */
    public static void backwardWeight<E>(KernelBuffer<E> dw, KernelBuffer<E> g, KernelBuffer<E> x,
                                         int64 n, int64 c, int64 h, int64 wd, int64 oc, int64 kh, int64 kw,
                                         int64 oh, int64 ow, int32 stride, int32 pad) {
        if (kh == 3L && kw == 3L) {
            KernelStream s3 #= KernelStream.current();
            convBackWeight3x3.launch(s3, grid: [(uint32) (((oc + 3L) / 4L) * c)], block: [256])(dw, g, x, (uint32) n, (uint32) c,
                (uint32) h, (uint32) wd, (uint32) oc, (uint32) oh, (uint32) ow, stride, pad);
            return;
        }
        uint32 total = (uint32) (oc * c * kh * kw);
        uint32 splits = (uint32) n;
        if (splits > 32) { splits = 32; }
        while (total * splits < 16384 && splits < (uint32) n) { splits = splits * 2; }
        if (splits > (uint32) n) { splits = (uint32) n; }
        KernelStream s #= KernelStream.current();
        KernelBuffer<float32> part = heap KernelBuffer<float32>((uint64) (total * splits));
        convBackWeightSplit.launch(s, grid: [(total * splits + 255) / 256], block: [256])(part, g, x, (uint32) n, (uint32) c, (uint32) h,
            (uint32) wd, (uint32) oc, (uint32) kh, (uint32) kw, (uint32) oh, (uint32) ow, stride, pad, splits);
        convBackWeightSum.launch(s, grid: [(total + 255) / 256], block: [256])(dw, part, total, splits);
        s.sync();
    }
}
