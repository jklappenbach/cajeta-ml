package dev.cajeta.ml.kernels.mem;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/** An arena take past the block's capacity (spec §7.6). */
public class ArenaException extends RecoverableException {
    public ArenaException(#String message) {
        this.message #= message;
        this.cause = 0;
    }
}
