package dev.cajeta.ml.kernels;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;

/** Matrix transpose at any dtype (spec §4.10): `out[c * rows + r] = in[r * cols + c]`, one element per thread. */
public final class Transpose {
    public Transpose() { return; }

    @Kernel
    public static void transpose<E>(KernelBuffer<E> out, KernelBuffer<E> in, uint32 rows, uint32 cols) {
        uint32 i = KernelThread.globalIdX();
        if (i < rows * cols) {
            uint32 r = i / cols;
            uint32 c = i - r * cols;
            out[c * rows + r] = in[i];
        }
    }

    /** `out` (cols x rows) = the transpose of `in` (rows x cols), both row-major: one launch, synced. */
    public static void into<E>(KernelBuffer<E> out, KernelBuffer<E> in, int64 rows, int64 cols) {
        uint32 un = (uint32) (rows * cols);
        KernelStream s #= KernelStream.current();
        transpose.launch(s, grid: [(un + 63) / 64], block: [64])(out, in, (uint32) rows, (uint32) cols);
        s.sync();
    }
}
