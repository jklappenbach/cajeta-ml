package dev.cajeta.ml.kernels.nn;

import cajeta.lang.Math;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Wave;
import cajeta.xpu.Workgroup;
import dev.cajeta.ml.kernels.Gemm;
import dev.cajeta.ml.kernels.Reduce;

/**
 * SPELA's few-class loss head (spela-kernels 4): a layer's output `h` (rows x d) against its
 * class vectors `v` (c x d), the summed loss and the output's gradient in four launches where
 * the composed head took about ten (three with no mask).
 *
 * Mode 0 is cosface: logits u (h . v_c) / max(|h|, eps), less `margin` (scale x margin) at the
 * target, cross-entropy averaged over the rows. Mode 1 is cosine: minus the mean of
 * h . v_y / max(|h| |v_y|, eps). A row mask weights each row's loss and gradient, and its sum is
 * the divisor. headRows takes a wave a row and writes each row's loss, its logit gradient G
 * (rows x c), q = <dn, n> and 1 / max(|h|, eps); headGrad forms the output's gradient
 * inv (u G . v - h inv q), the row-norm backward with no reduction left in it.
 *
 * Past FEW classes (spela-kernels 5, an NCM head of thousands of codes) the head runs in column
 * blocks of the class vectors, so it holds one rows x block of logits and never the rows x
 * classes matrix. The class product of a block is a GEMM against the vectors packed once,
 * block by block, as d x block. headStats folds each block into a running maximum and sum per
 * row; a second pass recomputes each block's logits, forms its gradient in place (headBlockGrad)
 * and accumulates G . v into the rows x d product through the GEMM's accumulating epilogue.
 * headFinish applies the row-norm backward. Cosine reads only the target's vector, so it is one
 * kernel (headCosine) at any class count.
 */
public final class SpelaHead {
    public SpelaHead() { return; }

    /** headRows: eight rows a workgroup, a wave a row; the loops and the branches around the wave ops are uniform (an out-of-range row clamps its loads and skips its stores). */
    @Kernel
    public static void headRows<E>(KernelBuffer<float32> g, KernelBuffer<float32> q, KernelBuffer<float32> inv,
                                   KernelBuffer<float32> rowLoss, KernelBuffer<E> h, KernelBuffer<E> v, KernelBuffer<E> labels,
                                   KernelBuffer<E> mask, KernelBuffer<float32> count, uint32 rows, uint32 d, uint32 c,
                                   uint32 mode, float32 uscale, float32 margin, uint32 useMask, float32 invRows, float32 eps) {
        uint32 lane = KernelThread.x();
        uint32 width = Wave.width();
        uint32 wl = Wave.laneId();
        uint32 waves = 256 / width;
        uint32 first = Workgroup.x() * 8;
        uint32 last = first + 8;
        if (last > rows) { last = rows; }
        uint32 reps = (8 + waves - 1) / waves;
        uint32 rep = 0;
        while (rep < reps) {
            uint32 row = first + lane / width + rep * waves;
            boolean live = row < last;
            if (!live) { row = rows - 1; }
            uint32 hb = row * d;
            float32 ss = 0.0f;
            uint32 j = wl;
            while (j < d) {
                float32 x = (float32) h[hb + j];
                ss = ss + x * x;
                j = j + width;
            }
            float32 nrm = Math.sqrt(Wave.reduceSumF32(ss));
            float32 den = nrm;
            if (den < eps) { den = eps; }
            float32 iv = 1.0f / den;
            uint32 y = (uint32) ((float32) labels[row]);
            float32 w = invRows;
            if (useMask != 0) {
                // no row left (an online batch whose every row was rejected): weight 0, not 0 / 0
                w = 0.0f;
                if (count[0] > 0.0f) { w = (float32) mask[row] / count[0]; }
            }
            float32 loss = 0.0f;
            float32 qq = 0.0f;
            if (mode == 0) {
                float32 mx = -3.4028235e38f;
                float32 se = 0.0f;
                float32 ly = 0.0f;
                uint32 cc = 0;
                while (cc < c) {
                    float32 pd = 0.0f;
                    j = wl;
                    while (j < d) {
                        pd = pd + (float32) h[hb + j] * (float32) v[cc * d + j];
                        j = j + width;
                    }
                    float32 lg = uscale * Wave.reduceSumF32(pd) * iv;
                    if (cc == y) {
                        lg = lg - margin;
                        ly = lg;
                    }
                    if (lg > mx) {
                        se = se * Math.exp(mx - lg) + 1.0f;
                        mx = lg;
                    } else {
                        se = se + Math.exp(lg - mx);
                    }
                    cc = cc + 1;
                }
                float32 lse = mx + Math.log(se);
                loss = (lse - ly) * w;
                cc = 0;
                while (cc < c) {
                    float32 pd = 0.0f;
                    j = wl;
                    while (j < d) {
                        pd = pd + (float32) h[hb + j] * (float32) v[cc * d + j];
                        j = j + width;
                    }
                    float32 dot = Wave.reduceSumF32(pd);
                    float32 lg = uscale * dot * iv;
                    float32 onehot = 0.0f;
                    if (cc == y) {
                        lg = lg - margin;
                        onehot = 1.0f;
                    }
                    float32 gv = (Math.exp(lg - lse) - onehot) * w;
                    qq = qq + gv * uscale * dot * iv;
                    if (live && wl == 0) { g[row * c + cc] = gv; }
                    cc = cc + 1;
                }
            } else {
                float32 pd = 0.0f;
                float32 pv = 0.0f;
                j = wl;
                while (j < d) {
                    float32 vv = (float32) v[y * d + j];
                    pd = pd + (float32) h[hb + j] * vv;
                    pv = pv + vv * vv;
                    j = j + width;
                }
                float32 dot = Wave.reduceSumF32(pd);
                float32 vn = Math.sqrt(Wave.reduceSumF32(pv));
                float32 cden = nrm * vn;
                if (cden < eps) { cden = eps; }
                float32 cs = dot / cden;
                loss = 0.0f - cs * w;
                float32 gy = (0.0f - w) / vn;
                qq = gy * dot * iv;
                uint32 cc = 0;
                while (cc < c) {
                    float32 gv = 0.0f;
                    if (cc == y) { gv = gy; }
                    if (live && wl == 0) { g[row * c + cc] = gv; }
                    cc = cc + 1;
                }
            }
            if (live && wl == 0) {
                q[row] = qq;
                inv[row] = iv;
                rowLoss[row] = loss;
            }
            rep = rep + 1;
        }
    }

    /**
     * dh[r, j] = inv[r] (u sum_c G[r, c] v[c, j] - h[r, j] inv[r] q[r]), one work-item an element;
     * work-item 0 also sums the rows' losses into loss[0], in row order so the sum repeats bit
     * for bit (headRows ran before it on the stream).
     */
    @Kernel
    public static void headGrad<E>(KernelBuffer<E> dh, KernelBuffer<E> h, KernelBuffer<E> v, KernelBuffer<float32> g,
                                   KernelBuffer<float32> q, KernelBuffer<float32> inv, KernelBuffer<float32> loss,
                                   KernelBuffer<float32> rowLoss, uint32 rows, uint32 d, uint32 c, float32 uscale) {
        uint32 i = KernelThread.globalIdX();
        if (i == 0) {
            float32 t = 0.0f;
            uint32 r0 = 0;
            while (r0 < rows) {
                t = t + rowLoss[r0];
                r0 = r0 + 1;
            }
            loss[0] = t;
        }
        if (i < rows * d) {
            uint32 r = i / d;
            uint32 j = i - r * d;
            float32 acc = 0.0f;
            uint32 cc = 0;
            while (cc < c) {
                acc = acc + g[r * c + cc] * (float32) v[cc * d + j];
                cc = cc + 1;
            }
            float32 iv = inv[r];
            dh[i] = (E) (iv * (uscale * acc - (float32) h[i] * iv * q[r]));
        }
    }

    /** The class vectors `v` (c x d) packed for the many-class route: block b's columns c0 .. c0 + bw as d x bw at c0 d. */
    @Kernel
    public static void headPack<E>(KernelBuffer<E> packed, KernelBuffer<E> v, uint32 c, uint32 d, uint32 blk) {
        uint32 i = KernelThread.globalIdX();
        if (i < c * d) {
            uint32 cls = i / d;
            uint32 j = i - cls * d;
            uint32 c0 = (cls / blk) * blk;
            uint32 bw = c - c0;
            if (bw > blk) { bw = blk; }
            packed[c0 * d + j * bw + (cls - c0)] = v[i];
        }
    }

    /** Per row: 1 / max(|h|, eps), and the running statistics reset (maximum, sum, target logit, q). */
    @Kernel
    public static void headNorm<E>(KernelBuffer<float32> inv, KernelBuffer<float32> mx, KernelBuffer<float32> se,
                                   KernelBuffer<float32> q, KernelBuffer<E> h, uint32 rows, uint32 d, float32 eps) {
        uint32 lane = KernelThread.x();
        uint32 width = Wave.width();
        uint32 wl = Wave.laneId();
        uint32 waves = 256 / width;
        uint32 first = Workgroup.x() * 8;
        uint32 last = first + 8;
        if (last > rows) { last = rows; }
        uint32 reps = (8 + waves - 1) / waves;
        uint32 rep = 0;
        while (rep < reps) {
            uint32 row = first + lane / width + rep * waves;
            boolean live = row < last;
            if (!live) { row = rows - 1; }
            uint32 hb = row * d;
            float32 ss = 0.0f;
            uint32 j = wl;
            while (j < d) {
                float32 x = (float32) h[hb + j];
                ss = ss + x * x;
                j = j + width;
            }
            float32 den = Math.sqrt(Wave.reduceSumF32(ss));
            if (den < eps) { den = eps; }
            if (live && wl == 0) {
                inv[row] = 1.0f / den;
                mx[row] = -3.4028235e38f;
                se[row] = 0.0f;
                q[row] = 0.0f;
            }
            rep = rep + 1;
        }
    }

    /**
     * One column block's logits `lg` (rows x bw, the block's raw products h . v) folded into
     * each row's running maximum and sum, the target's logit kept when it falls in the block.
     */
    @Kernel
    public static void headStats<E>(KernelBuffer<float32> mx, KernelBuffer<float32> se, KernelBuffer<float32> ly,
                                    KernelBuffer<E> lg, KernelBuffer<float32> inv, KernelBuffer<E> labels, uint32 rows,
                                    uint32 bw, uint32 c0, float32 uscale, float32 margin) {
        uint32 lane = KernelThread.x();
        uint32 width = Wave.width();
        uint32 wl = Wave.laneId();
        uint32 waves = 256 / width;
        uint32 first = Workgroup.x() * 8;
        uint32 last = first + 8;
        if (last > rows) { last = rows; }
        uint32 reps = (8 + waves - 1) / waves;
        uint32 rep = 0;
        while (rep < reps) {
            uint32 row = first + lane / width + rep * waves;
            boolean live = row < last;
            if (!live) { row = rows - 1; }
            float32 iv = inv[row];
            uint32 y = (uint32) ((float32) labels[row]);
            float32 lm = -3.4028235e38f;
            float32 ls = 0.0f;
            uint32 j = wl;
            while (j < bw) {
                float32 x = uscale * (float32) lg[row * bw + j] * iv;
                if (c0 + j == y) {
                    x = x - margin;
                    if (live) { ly[row] = x; }
                }
                if (x > lm) {
                    ls = ls * Math.exp(lm - x) + 1.0f;
                    lm = x;
                } else {
                    ls = ls + Math.exp(x - lm);
                }
                j = j + width;
            }
            float32 m = Wave.reduceMaxF32(lm);
            float32 sb = Wave.reduceSumF32(ls * Math.exp(lm - m));
            float32 om = mx[row];
            float32 nm = om;
            if (m > nm) { nm = m; }
            float32 ns = se[row] * Math.exp(om - nm) + sb * Math.exp(m - nm);
            if (live && wl == 0) {
                mx[row] = nm;
                se[row] = ns;
            }
            rep = rep + 1;
        }
    }

    /**
     * One column block's gradient, in place over its logits: G = (softmax - onehot) w, and each
     * row's q += <G, u h . v inv>; on the first block each row's loss (lse - target) w as well.
     */
    @Kernel
    public static void headBlockGrad<E>(KernelBuffer<E> lg, KernelBuffer<float32> q, KernelBuffer<float32> rowLoss,
                                        KernelBuffer<float32> mx, KernelBuffer<float32> se, KernelBuffer<float32> ly,
                                        KernelBuffer<float32> inv, KernelBuffer<E> labels, KernelBuffer<E> mask,
                                        KernelBuffer<float32> count, uint32 rows, uint32 bw, uint32 c0, float32 uscale,
                                        float32 margin, uint32 useMask, float32 invRows, uint32 firstBlock) {
        uint32 lane = KernelThread.x();
        uint32 width = Wave.width();
        uint32 wl = Wave.laneId();
        uint32 waves = 256 / width;
        uint32 first = Workgroup.x() * 8;
        uint32 last = first + 8;
        if (last > rows) { last = rows; }
        uint32 reps = (8 + waves - 1) / waves;
        uint32 rep = 0;
        while (rep < reps) {
            uint32 row = first + lane / width + rep * waves;
            boolean live = row < last;
            if (!live) { row = rows - 1; }
            float32 iv = inv[row];
            uint32 y = (uint32) ((float32) labels[row]);
            float32 w = invRows;
            if (useMask != 0) {
                // no row left (an online batch whose every row was rejected): weight 0, not 0 / 0
                w = 0.0f;
                if (count[0] > 0.0f) { w = (float32) mask[row] / count[0]; }
            }
            float32 lse = mx[row] + Math.log(se[row]);
            float32 qq = 0.0f;
            uint32 j = wl;
            while (j < bw) {
                float32 raw = uscale * (float32) lg[row * bw + j] * iv;
                float32 x = raw;
                float32 onehot = 0.0f;
                if (c0 + j == y) {
                    x = x - margin;
                    onehot = 1.0f;
                }
                float32 gv = (Math.exp(x - lse) - onehot) * w;
                qq = qq + gv * raw;
                if (live) { lg[row * bw + j] = (E) gv; }
                j = j + width;
            }
            float32 qs = Wave.reduceSumF32(qq);
            if (live && wl == 0) {
                q[row] = q[row] + qs;
                if (firstBlock != 0) { rowLoss[row] = (lse - ly[row]) * w; }
            }
            rep = rep + 1;
        }
    }

    /** dh = inv (u acc - h inv q), acc the rows x d product G . v accumulated over the blocks. */
    @Kernel
    public static void headFinish<E>(KernelBuffer<E> dh, KernelBuffer<E> h, KernelBuffer<E> acc, KernelBuffer<float32> q,
                                     KernelBuffer<float32> inv, uint32 rows, uint32 d, float32 uscale) {
        uint32 i = KernelThread.globalIdX();
        if (i < rows * d) {
            uint32 r = i / d;
            float32 iv = inv[r];
            dh[i] = (E) (iv * (uscale * (float32) acc[i] - (float32) h[i] * iv * q[r]));
        }
    }

    /** The cosine head at any class count, a wave a row: each row's loss and its output's gradient, which reads only the target's vector. */
    @Kernel
    public static void headCosine<E>(KernelBuffer<E> dh, KernelBuffer<float32> rowLoss, KernelBuffer<E> h, KernelBuffer<E> v,
                                     KernelBuffer<E> labels, KernelBuffer<E> mask, KernelBuffer<float32> count, uint32 rows,
                                     uint32 d, uint32 useMask, float32 invRows, float32 eps) {
        uint32 lane = KernelThread.x();
        uint32 width = Wave.width();
        uint32 wl = Wave.laneId();
        uint32 waves = 256 / width;
        uint32 first = Workgroup.x() * 8;
        uint32 last = first + 8;
        if (last > rows) { last = rows; }
        uint32 reps = (8 + waves - 1) / waves;
        uint32 rep = 0;
        while (rep < reps) {
            uint32 row = first + lane / width + rep * waves;
            boolean live = row < last;
            if (!live) { row = rows - 1; }
            uint32 hb = row * d;
            uint32 y = (uint32) ((float32) labels[row]);
            float32 ss = 0.0f;
            float32 pd = 0.0f;
            float32 pv = 0.0f;
            uint32 j = wl;
            while (j < d) {
                float32 x = (float32) h[hb + j];
                float32 vv = (float32) v[y * d + j];
                ss = ss + x * x;
                pd = pd + x * vv;
                pv = pv + vv * vv;
                j = j + width;
            }
            float32 nrm = Math.sqrt(Wave.reduceSumF32(ss));
            float32 dot = Wave.reduceSumF32(pd);
            float32 vn = Math.sqrt(Wave.reduceSumF32(pv));
            float32 den = nrm;
            if (den < eps) { den = eps; }
            float32 iv = 1.0f / den;
            float32 w = invRows;
            if (useMask != 0) {
                // no row left (an online batch whose every row was rejected): weight 0, not 0 / 0
                w = 0.0f;
                if (count[0] > 0.0f) { w = (float32) mask[row] / count[0]; }
            }
            float32 cden = nrm * vn;
            if (cden < eps) { cden = eps; }
            float32 gy = (0.0f - w) / vn;
            float32 qq = gy * dot * iv;
            if (live) {
                j = wl;
                while (j < d) {
                    dh[hb + j] = (E) (iv * (gy * (float32) v[y * d + j] - (float32) h[hb + j] * iv * qq));
                    j = j + width;
                }
                if (wl == 0) { rowLoss[row] = 0.0f - dot / cden * w; }
            }
            rep = rep + 1;
        }
    }

    /**
     * The online confidence gate (spela-kernels 8), a wave a row: `h` (rows x d) is the last
     * layer's output for the batch and `v` its class vectors. A row whose `given` label is 0 or
     * more keeps it and is accepted; any other takes its nearest class (the first of equal top
     * cosines) and is accepted when that cosine, h . v / max(|h|, eps), is at least `threshold`.
     * `labels` and `mask` (1 accepted, 0 not) are written for the step.
     */
    @Kernel
    public static void headGate<E>(KernelBuffer<E> labels, KernelBuffer<E> mask, KernelBuffer<E> h, KernelBuffer<E> v,
                                   KernelBuffer<E> given, uint32 rows, uint32 d, uint32 c, float32 threshold, float32 eps) {
        uint32 lane = KernelThread.x();
        uint32 width = Wave.width();
        uint32 wl = Wave.laneId();
        uint32 waves = 256 / width;
        uint32 first = Workgroup.x() * 8;
        uint32 last = first + 8;
        if (last > rows) { last = rows; }
        uint32 reps = (8 + waves - 1) / waves;
        uint32 rep = 0;
        while (rep < reps) {
            uint32 row = first + lane / width + rep * waves;
            boolean live = row < last;
            if (!live) { row = rows - 1; }
            uint32 hb = row * d;
            float32 ss = 0.0f;
            uint32 j = wl;
            while (j < d) {
                float32 x = (float32) h[hb + j];
                ss = ss + x * x;
                j = j + width;
            }
            float32 den = Math.sqrt(Wave.reduceSumF32(ss));
            if (den < eps) { den = eps; }
            float32 best = -3.4028235e38f;
            uint32 arg = 0;
            uint32 cc = 0;
            while (cc < c) {
                float32 pd = 0.0f;
                j = wl;
                while (j < d) {
                    pd = pd + (float32) h[hb + j] * (float32) v[cc * d + j];
                    j = j + width;
                }
                float32 cs = Wave.reduceSumF32(pd) / den;
                if (cs > best) {
                    best = cs;
                    arg = cc;
                }
                cc = cc + 1;
            }
            float32 g = (float32) given[row];
            float32 lab = (float32) arg;
            float32 keep = 0.0f;
            if (best >= threshold) { keep = 1.0f; }
            if (g >= 0.0f) {
                lab = g;
                keep = 1.0f;
            }
            if (live && wl == 0) {
                labels[row] = (E) lab;
                mask[row] = (E) keep;
            }
            rep = rep + 1;
        }
    }

    /** headGate over `rows` rows, and the accepted count into `accepted[0]`; queued on the current stream. */
    public static void gate<E>(KernelBuffer<E> labels, KernelBuffer<E> mask, KernelBuffer<float32> accepted, KernelBuffer<E> h,
                               KernelBuffer<E> v, KernelBuffer<E> given, int64 rows, int64 d, int64 c, float32 threshold, float32 eps) {
        uint32 ur = (uint32) rows;
        KernelStream s #= KernelStream.current();
        headGate.launch(s, grid: [(ur + 7) / 8], block: [256])(labels, mask, h, v, given, ur, (uint32) d, (uint32) c, threshold, eps);
        Reduce.segments<E>(accepted, mask, rows, 1L, Reduce.SUM);
    }

    /** At or below this many classes the head is one fused pair of launches; past it, column blocks. */
    public static final int64 FEW = 64L;

    /** Does a head of `c` classes take the many-class route? */
    public static boolean manyClasses(int64 c) { return c > SpelaHead.FEW; }

    /** Floats the many-class route's packed class vectors take (0 where the head never reads them). */
    public static int64 packFloats(int64 c, int64 d) {
        if (!SpelaHead.manyClasses(c)) { return 0L; }
        return c * d;
    }

    static int64 blockSet;

    /** The column block, in classes (default 1024); set it before packing, since the packing follows it. */
    public static void setBlockClasses(int64 n) { SpelaHead.blockSet = n; }

    static int64 blockClasses() {
        if (SpelaHead.blockSet <= 0L) { return 1024L; }
        return SpelaHead.blockSet;
    }

    /** The logit scratch's high-water mark, in floats: rows x one block at most. */
    public static int64 logitFloats() { return (int64) SpelaHead.lgCap; }

    /** Pack `v` (c x d) into `packed` (packFloats(c, d)) for the many-class route; nothing to do at FEW or fewer. Queued on the current stream. */
    public static void pack<E>(KernelBuffer<E> packed, KernelBuffer<E> v, int64 c, int64 d) {
        if (!SpelaHead.manyClasses(c)) { return; }
        uint32 total = (uint32) (c * d);
        KernelStream s #= KernelStream.current();
        headPack.launch(s, grid: [(total + 255) / 256], block: [256])(packed, v, (uint32) c, (uint32) d,
            (uint32) SpelaHead.blockClasses());
    }

    // Scratch kept across calls, grown only past its high-water mark; the stream is synced only
    // on the call that grows it, since a queued launch may still read the old buffers.
    static KernelBuffer<float32> gBuf;
    static KernelBuffer<float32> qBuf;
    static KernelBuffer<float32> invBuf;
    static KernelBuffer<float32> lossBuf;
    static KernelBuffer<float32> countBuf;
    static uint64 gCap;
    static uint64 rowCap;
    static KernelBuffer<float32> mxBuf;
    static KernelBuffer<float32> seBuf;
    static KernelBuffer<float32> lyBuf;
    static KernelBuffer<float32> lgBuf;
    static KernelBuffer<float32> accBuf;
    static uint64 lgCap;
    static uint64 accCap;
    static uint64 manyRowCap;

    /**
     * The head over `rows` rows: `loss[0]` receives the summed (row-weighted) loss and `dh` the
     * gradient of that loss with respect to `h`. `mode` 0 cosface, 1 cosine; `uscale` is the
     * cosface scale (1 for cosine); `margin` is scale x margin; `mask` (rows) is null for every
     * row at weight 1 / rows. `packed` is `v` through pack, read on the many-class route only.
     * Queued on the current stream.
     */
    public static void loss<E>(KernelBuffer<float32> loss, KernelBuffer<E> dh, KernelBuffer<E> h, KernelBuffer<E> v,
                               KernelBuffer<E> packed, KernelBuffer<E> labels, KernelBuffer<E> mask, int64 rows, int64 d,
                               int64 c, int32 mode, float32 uscale, float32 margin, float32 eps) {
        if (SpelaHead.manyClasses(c)) {
            SpelaHead.lossMany(loss, dh, h, v, packed, labels, mask, rows, d, c, mode, uscale, margin, eps);
            return;
        }
        uint64 needG = (uint64) (rows * c);
        uint64 needR = (uint64) rows;
        KernelStream s #= KernelStream.current();
        if (SpelaHead.gBuf == null || needG > SpelaHead.gCap || needR > SpelaHead.rowCap) {
            s.sync();
            if (SpelaHead.gBuf == null || needG > SpelaHead.gCap) {
                SpelaHead.gBuf = heap KernelBuffer<float32>(needG);
                SpelaHead.gCap = needG;
            }
            if (SpelaHead.qBuf == null || needR > SpelaHead.rowCap) {
                SpelaHead.qBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.invBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.lossBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.rowCap = needR;
            }
            if (SpelaHead.countBuf == null) { SpelaHead.countBuf = heap KernelBuffer<float32>(1); }
        }
        KernelBuffer<float32> gb = SpelaHead.gBuf;
        KernelBuffer<float32> qb = SpelaHead.qBuf;
        KernelBuffer<float32> ib = SpelaHead.invBuf;
        KernelBuffer<float32> lb = SpelaHead.lossBuf;
        KernelBuffer<float32> cb = SpelaHead.countBuf;
        uint32 ur = (uint32) rows;
        uint32 ud = (uint32) d;
        uint32 uc = (uint32) c;
        float32 invRows = 1.0f / (float32) rows;
        if (mask != null) {
            Reduce.segments<E>(cb, mask, rows, 1L, Reduce.SUM);
            headRows.launch(s, grid: [(ur + 7) / 8], block: [256])(gb, qb, ib, lb, h, v, labels, mask, cb, ur, ud, uc,
                (uint32) mode, uscale, margin, (uint32) 1, invRows, eps);
        } else {
            headRows.launch(s, grid: [(ur + 7) / 8], block: [256])(gb, qb, ib, lb, h, v, labels, h, cb, ur, ud, uc,
                (uint32) mode, uscale, margin, (uint32) 0, invRows, eps);
        }
        uint32 total = ur * ud;
        headGrad.launch(s, grid: [(total + 255) / 256], block: [256])(dh, h, v, gb, qb, ib, loss, lb, ur, ud, uc, uscale);
    }

    // A block's launches take its logit view as a parameter, so the view's scope is the caller's.
    static void statsOf(KernelBuffer<float32> mx, KernelBuffer<float32> se, KernelBuffer<float32> ly, KernelBuffer<float32> lg,
                        KernelBuffer<float32> inv, KernelBuffer<float32> labels, uint32 rows, uint32 bw, uint32 c0, float32 uscale,
                        float32 margin) {
        KernelStream s #= KernelStream.current();
        headStats.launch(s, grid: [(rows + 7) / 8], block: [256])(mx, se, ly, lg, inv, labels, rows, bw, c0, uscale, margin);
    }

    static void blockGradOf(KernelBuffer<float32> lg, KernelBuffer<float32> q, KernelBuffer<float32> rowLoss,
                            KernelBuffer<float32> mx, KernelBuffer<float32> se, KernelBuffer<float32> ly, KernelBuffer<float32> inv,
                            KernelBuffer<float32> labels, KernelBuffer<float32> mask, KernelBuffer<float32> count, uint32 rows,
                            uint32 bw, uint32 c0, float32 uscale, float32 margin, uint32 useMask, float32 invRows,
                            uint32 firstBlock) {
        KernelStream s #= KernelStream.current();
        headBlockGrad.launch(s, grid: [(rows + 7) / 8], block: [256])(lg, q, rowLoss, mx, se, ly, inv, labels, mask, count, rows, bw,
            c0, uscale, margin, useMask, invRows, firstBlock);
    }

    /** The many-class route (float32, the declared element today; bf16 is a later route). */
    static void lossMany(KernelBuffer<float32> loss, KernelBuffer<float32> dh, KernelBuffer<float32> h, KernelBuffer<float32> v,
                         KernelBuffer<float32> packed, KernelBuffer<float32> labels, KernelBuffer<float32> mask, int64 rows,
                         int64 d, int64 c, int32 mode, float32 uscale, float32 margin, float32 eps) {
        int64 blk = SpelaHead.blockClasses();
        uint64 needR = (uint64) rows;
        uint64 needL = (uint64) (rows * blk);
        if ((uint64) c < (uint64) blk) { needL = (uint64) (rows * c); }
        uint64 needA = (uint64) (rows * d);
        KernelStream s #= KernelStream.current();
        if (SpelaHead.mxBuf == null || needR > SpelaHead.manyRowCap || needL > SpelaHead.lgCap || needA > SpelaHead.accCap) {
            s.sync();
            if (SpelaHead.mxBuf == null || needR > SpelaHead.manyRowCap) {
                SpelaHead.mxBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.seBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.lyBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.manyRowCap = needR;
            }
            if (SpelaHead.lgBuf == null || needL > SpelaHead.lgCap) {
                SpelaHead.lgBuf = heap KernelBuffer<float32>(needL);
                SpelaHead.lgCap = needL;
            }
            if (SpelaHead.accBuf == null || needA > SpelaHead.accCap) {
                SpelaHead.accBuf = heap KernelBuffer<float32>(needA);
                SpelaHead.accCap = needA;
            }
        }
        if (SpelaHead.qBuf == null || needR > SpelaHead.rowCap || SpelaHead.countBuf == null) {
            s.sync();
            if (SpelaHead.qBuf == null || needR > SpelaHead.rowCap) {
                SpelaHead.qBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.invBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.lossBuf = heap KernelBuffer<float32>(needR);
                SpelaHead.rowCap = needR;
            }
            if (SpelaHead.countBuf == null) { SpelaHead.countBuf = heap KernelBuffer<float32>(1); }
        }
        KernelBuffer<float32> qb = SpelaHead.qBuf;
        KernelBuffer<float32> ib = SpelaHead.invBuf;
        KernelBuffer<float32> lb = SpelaHead.lossBuf;
        KernelBuffer<float32> cb = SpelaHead.countBuf;
        KernelBuffer<float32> mb = SpelaHead.mxBuf;
        KernelBuffer<float32> sb = SpelaHead.seBuf;
        KernelBuffer<float32> yb = SpelaHead.lyBuf;
        KernelBuffer<float32> ab = SpelaHead.accBuf;
        uint32 ur = (uint32) rows;
        uint32 ud = (uint32) d;
        uint32 groups = (ur + 7) / 8;
        float32 invRows = 1.0f / (float32) rows;
        uint32 useMask = 0;
        if (mask != null) {
            Reduce.segments<float32>(cb, mask, rows, 1L, Reduce.SUM);
            useMask = 1;
        }
        if (mode == 1) {
            if (mask != null) {
                headCosine.launch(s, grid: [groups], block: [256])(dh, lb, h, v, labels, mask, cb, ur, ud, useMask, invRows, eps);
            } else {
                headCosine.launch(s, grid: [groups], block: [256])(dh, lb, h, v, labels, h, cb, ur, ud, useMask, invRows, eps);
            }
            Reduce.segments<float32>(loss, lb, rows, 1L, Reduce.SUM);
            return;
        }
        headNorm.launch(s, grid: [groups], block: [256])(ib, mb, sb, qb, h, ur, ud, eps);
        int64 c0 = 0L;
        while (c0 < c) {
            int64 bw = c - c0;
            if (bw > blk) { bw = blk; }
            KernelBuffer<float32> lg #= SpelaHead.lgBuf.slice((uint64) 0, (uint64) (rows * bw));
            KernelBuffer<float32> pb #= packed.slice((uint64) (c0 * d), (uint64) (bw * d));
            Gemm.tiled128<float32>(lg, h, pb, rows, bw, d);
            SpelaHead.statsOf(mb, sb, yb, lg, ib, labels, ur, (uint32) bw, (uint32) c0, uscale, margin);
            c0 = c0 + bw;
        }
        c0 = 0L;
        while (c0 < c) {
            int64 bw = c - c0;
            if (bw > blk) { bw = blk; }
            KernelBuffer<float32> lg #= SpelaHead.lgBuf.slice((uint64) 0, (uint64) (rows * bw));
            KernelBuffer<float32> pb #= packed.slice((uint64) (c0 * d), (uint64) (bw * d));
            KernelBuffer<float32> vb #= v.slice((uint64) (c0 * d), (uint64) (bw * d));
            Gemm.tiled128<float32>(lg, h, pb, rows, bw, d);
            uint32 firstBlock = 0;
            if (c0 == 0L) { firstBlock = 1; }
            if (mask != null) {
                SpelaHead.blockGradOf(lg, qb, lb, mb, sb, yb, ib, labels, mask, cb, ur, (uint32) bw, (uint32) c0, uscale, margin,
                    useMask, invRows, firstBlock);
            } else {
                SpelaHead.blockGradOf(lg, qb, lb, mb, sb, yb, ib, labels, h, cb, ur, (uint32) bw, (uint32) c0, uscale, margin,
                    useMask, invRows, firstBlock);
            }
            if (c0 == 0L) { Gemm.tiled128Rolled<float32>(ab, lg, vb, rows, d, bw); }
            else { Gemm.tiled128Acc<float32>(ab, lg, vb, rows, d, bw); }
            c0 = c0 + bw;
        }
        uint32 total = ur * ud;
        headFinish.launch(s, grid: [(total + 255) / 256], block: [256])(dh, h, ab, qb, ib, ur, ud, uscale);
        Reduce.segments<float32>(loss, lb, rows, 1L, Reduce.SUM);
    }
}
