                    a10.mma(ma, mb0);
                    a11.mma(ma, mb1);
                    a12.mma(ma, mb2);
                    a13.mma(ma, mb3);
                    qb0 = b.vload<8>((kn + kr) * n + n0 + bn0);
                    mb0.load(sb, 5120 + (wn * 64 + 0) * 40 + 1 * 16, 1, 40);
                    mb1.load(sb, 5120 + (wn * 64 + 16) * 40 + 1 * 16, 1, 40);
                    mb2.load(sb, 5120 + (wn * 64 + 32) * 40 + 1 * 16, 1, 40);
                    mb3.load(sb, 5120 + (wn * 64 + 48) * 40 + 1 * 16, 1, 40);
                    ma.load(sa, 10240 + (wm * 32 + 0) * 40 + 1 * 16, 0, 40);
                    a00.mma(ma, mb0);
                    a01.mma(ma, mb1);
                    a02.mma(ma, mb2);
                    a03.mma(ma, mb3);
                    ma.load(sa, 10240 + (wm * 32 + 16) * 40 + 1 * 16, 0, 40);
                    a10.mma(ma, mb0);
                    a11.mma(ma, mb1);
                    a12.mma(ma, mb2);
                    a13.mma(ma, mb3);
                    sa.vstore(0 + ar0 * 40 + ac0, ra0);
                    sa.vstore(0 + ar1 * 40 + ac0, ra1);
                    sb[0 + (bn0 + 0) * 40 + kr] = rb0[0];
                    sb[0 + (bn0 + 1) * 40 + kr] = rb0[1];
                    sb[0 + (bn0 + 2) * 40 + kr] = rb0[2];
                    sb[0 + (bn0 + 3) * 40 + kr] = rb0[3];
                    sb[0 + (bn0 + 4) * 40 + kr] = rb0[4];
                    sb[0 + (bn0 + 5) * 40 + kr] = rb0[5];
                    sb[0 + (bn0 + 6) * 40 + kr] = rb0[6];
