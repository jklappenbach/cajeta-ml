                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < k) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 132 + ar] = va;
                uint32 bk = idx / 128;
                uint32 bc = idx - bk * 128;
                float32 vb = 0.0f;
                if (k0 + bk < k && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 132 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                Vector<float32,4> lv0 = sa.vload<4>(kk * 132 + ty * 4);
                Vector<float32,4> lv1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                Vector<float32,4> lw0 = sb.vload<4>(kk * 132 + tx * 4);
                Vector<float32,4> lw1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                c00 = Math.fma(lv0.x, lw0.x, c00);
                c01 = Math.fma(lv0.x, lw0.y, c01);
                c02 = Math.fma(lv0.x, lw0.z, c02);
                c03 = Math.fma(lv0.x, lw0.w, c03);
                c04 = Math.fma(lv0.x, lw1.x, c04);
                c05 = Math.fma(lv0.x, lw1.y, c05);
                c06 = Math.fma(lv0.x, lw1.z, c06);
                c07 = Math.fma(lv0.x, lw1.w, c07);
                c10 = Math.fma(lv0.y, lw0.x, c10);
                c11 = Math.fma(lv0.y, lw0.y, c11);
                c12 = Math.fma(lv0.y, lw0.z, c12);
                c13 = Math.fma(lv0.y, lw0.w, c13);
                c14 = Math.fma(lv0.y, lw1.x, c14);
                c15 = Math.fma(lv0.y, lw1.y, c15);
                c16 = Math.fma(lv0.y, lw1.z, c16);
                c17 = Math.fma(lv0.y, lw1.w, c17);
                c20 = Math.fma(lv0.z, lw0.x, c20);
                c21 = Math.fma(lv0.z, lw0.y, c21);
                c22 = Math.fma(lv0.z, lw0.z, c22);
                c23 = Math.fma(lv0.z, lw0.w, c23);
                c24 = Math.fma(lv0.z, lw1.x, c24);
                c25 = Math.fma(lv0.z, lw1.y, c25);
                c26 = Math.fma(lv0.z, lw1.z, c26);
                c27 = Math.fma(lv0.z, lw1.w, c27);
                c30 = Math.fma(lv0.w, lw0.x, c30);
                c31 = Math.fma(lv0.w, lw0.y, c31);
                c32 = Math.fma(lv0.w, lw0.z, c32);
                c33 = Math.fma(lv0.w, lw0.w, c33);
                c34 = Math.fma(lv0.w, lw1.x, c34);
                c35 = Math.fma(lv0.w, lw1.y, c35);
                c36 = Math.fma(lv0.w, lw1.z, c36);
                c37 = Math.fma(lv0.w, lw1.w, c37);
                c40 = Math.fma(lv1.x, lw0.x, c40);
                c41 = Math.fma(lv1.x, lw0.y, c41);
                c42 = Math.fma(lv1.x, lw0.z, c42);
                c43 = Math.fma(lv1.x, lw0.w, c43);
                c44 = Math.fma(lv1.x, lw1.x, c44);
                c45 = Math.fma(lv1.x, lw1.y, c45);
                c46 = Math.fma(lv1.x, lw1.z, c46);
                c47 = Math.fma(lv1.x, lw1.w, c47);
                c50 = Math.fma(lv1.y, lw0.x, c50);
                c51 = Math.fma(lv1.y, lw0.y, c51);
                c52 = Math.fma(lv1.y, lw0.z, c52);
                c53 = Math.fma(lv1.y, lw0.w, c53);
                c54 = Math.fma(lv1.y, lw1.x, c54);
                c55 = Math.fma(lv1.y, lw1.y, c55);
                c56 = Math.fma(lv1.y, lw1.z, c56);
                c57 = Math.fma(lv1.y, lw1.w, c57);
                c60 = Math.fma(lv1.z, lw0.x, c60);
                c61 = Math.fma(lv1.z, lw0.y, c61);
                c62 = Math.fma(lv1.z, lw0.z, c62);
                c63 = Math.fma(lv1.z, lw0.w, c63);
                c64 = Math.fma(lv1.z, lw1.x, c64);
                c65 = Math.fma(lv1.z, lw1.y, c65);
                c66 = Math.fma(lv1.z, lw1.z, c66);
                c67 = Math.fma(lv1.z, lw1.w, c67);
                c70 = Math.fma(lv1.w, lw0.x, c70);
                c71 = Math.fma(lv1.w, lw0.y, c71);
                c72 = Math.fma(lv1.w, lw0.z, c72);
                c73 = Math.fma(lv1.w, lw0.w, c73);
                c74 = Math.fma(lv1.w, lw1.x, c74);
                c75 = Math.fma(lv1.w, lw1.y, c75);
                c76 = Math.fma(lv1.w, lw1.z, c76);
                c77 = Math.fma(lv1.w, lw1.w, c77);
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty * 4 + 0;
        uint32 r1 = m0 + ty * 4 + 1;
        uint32 r2 = m0 + ty * 4 + 2;
        uint32 r3 = m0 + ty * 4 + 3;
        uint32 r4 = m0 + 64 + ty * 4 + 0;
        uint32 r5 = m0 + 64 + ty * 4 + 1;
        uint32 r6 = m0 + 64 + ty * 4 + 2;
        uint32 r7 = m0 + 64 + ty * 4 + 3;
        uint32 q0 = n0 + tx * 4 + 0;
        uint32 q1 = n0 + tx * 4 + 1;
        uint32 q2 = n0 + tx * 4 + 2;
        uint32 q3 = n0 + tx * 4 + 3;
        uint32 q4 = n0 + 64 + tx * 4 + 0;
        uint32 q5 = n0 + 64 + tx * 4 + 1;
        uint32 q6 = n0 + 64 + tx * 4 + 2;
        uint32 q7 = n0 + 64 + tx * 4 + 3;
        if (r0 < m && q0 < n) { c[r0 * n + q0] = (E) c00; }
        if (r0 < m && q1 < n) { c[r0 * n + q1] = (E) c01; }
        if (r0 < m && q2 < n) { c[r0 * n + q2] = (E) c02; }
        if (r0 < m && q3 < n) { c[r0 * n + q3] = (E) c03; }
        if (r0 < m && q4 < n) { c[r0 * n + q4] = (E) c04; }
        if (r0 < m && q5 < n) { c[r0 * n + q5] = (E) c05; }
        if (r0 < m && q6 < n) { c[r0 * n + q6] = (E) c06; }
        if (r0 < m && q7 < n) { c[r0 * n + q7] = (E) c07; }
        if (r1 < m && q0 < n) { c[r1 * n + q0] = (E) c10; }
        if (r1 < m && q1 < n) { c[r1 * n + q1] = (E) c11; }
        if (r1 < m && q2 < n) { c[r1 * n + q2] = (E) c12; }
        if (r1 < m && q3 < n) { c[r1 * n + q3] = (E) c13; }
        if (r1 < m && q4 < n) { c[r1 * n + q4] = (E) c14; }
        if (r1 < m && q5 < n) { c[r1 * n + q5] = (E) c15; }
        if (r1 < m && q6 < n) { c[r1 * n + q6] = (E) c16; }
        if (r1 < m && q7 < n) { c[r1 * n + q7] = (E) c17; }
        if (r2 < m && q0 < n) { c[r2 * n + q0] = (E) c20; }
        if (r2 < m && q1 < n) { c[r2 * n + q1] = (E) c21; }
        if (r2 < m && q2 < n) { c[r2 * n + q2] = (E) c22; }
        if (r2 < m && q3 < n) { c[r2 * n + q3] = (E) c23; }
        if (r2 < m && q4 < n) { c[r2 * n + q4] = (E) c24; }
        if (r2 < m && q5 < n) { c[r2 * n + q5] = (E) c25; }
        if (r2 < m && q6 < n) { c[r2 * n + q6] = (E) c26; }
        if (r2 < m && q7 < n) { c[r2 * n + q7] = (E) c27; }
        if (r3 < m && q0 < n) { c[r3 * n + q0] = (E) c30; }
        if (r3 < m && q1 < n) { c[r3 * n + q1] = (E) c31; }
        if (r3 < m && q2 < n) { c[r3 * n + q2] = (E) c32; }
        if (r3 < m && q3 < n) { c[r3 * n + q3] = (E) c33; }
        if (r3 < m && q4 < n) { c[r3 * n + q4] = (E) c34; }
        if (r3 < m && q5 < n) { c[r3 * n + q5] = (E) c35; }
        if (r3 < m && q6 < n) { c[r3 * n + q6] = (E) c36; }
        if (r3 < m && q7 < n) { c[r3 * n + q7] = (E) c37; }
        if (r4 < m && q0 < n) { c[r4 * n + q0] = (E) c40; }
        if (r4 < m && q1 < n) { c[r4 * n + q1] = (E) c41; }
        if (r4 < m && q2 < n) { c[r4 * n + q2] = (E) c42; }
        if (r4 < m && q3 < n) { c[r4 * n + q3] = (E) c43; }
        if (r4 < m && q4 < n) { c[r4 * n + q4] = (E) c44; }
        if (r4 < m && q5 < n) { c[r4 * n + q5] = (E) c45; }
        if (r4 < m && q6 < n) { c[r4 * n + q6] = (E) c46; }
        if (r4 < m && q7 < n) { c[r4 * n + q7] = (E) c47; }
        if (r5 < m && q0 < n) { c[r5 * n + q0] = (E) c50; }
        if (r5 < m && q1 < n) { c[r5 * n + q1] = (E) c51; }
        if (r5 < m && q2 < n) { c[r5 * n + q2] = (E) c52; }
        if (r5 < m && q3 < n) { c[r5 * n + q3] = (E) c53; }
        if (r5 < m && q4 < n) { c[r5 * n + q4] = (E) c54; }
        if (r5 < m && q5 < n) { c[r5 * n + q5] = (E) c55; }
        if (r5 < m && q6 < n) { c[r5 * n + q6] = (E) c56; }
        if (r5 < m && q7 < n) { c[r5 * n + q7] = (E) c57; }
        if (r6 < m && q0 < n) { c[r6 * n + q0] = (E) c60; }
        if (r6 < m && q1 < n) { c[r6 * n + q1] = (E) c61; }
        if (r6 < m && q2 < n) { c[r6 * n + q2] = (E) c62; }
        if (r6 < m && q3 < n) { c[r6 * n + q3] = (E) c63; }
        if (r6 < m && q4 < n) { c[r6 * n + q4] = (E) c64; }
        if (r6 < m && q5 < n) { c[r6 * n + q5] = (E) c65; }
        if (r6 < m && q6 < n) { c[r6 * n + q6] = (E) c66; }
        if (r6 < m && q7 < n) { c[r6 * n + q7] = (E) c67; }
        if (r7 < m && q0 < n) { c[r7 * n + q0] = (E) c70; }
        if (r7 < m && q1 < n) { c[r7 * n + q1] = (E) c71; }
        if (r7 < m && q2 < n) { c[r7 * n + q2] = (E) c72; }
        if (r7 < m && q3 < n) { c[r7 * n + q3] = (E) c73; }
        if (r7 < m && q4 < n) { c[r7 * n + q4] = (E) c74; }
        if (r7 < m && q5 < n) { c[r7 * n + q5] = (E) c75; }
        if (r7 < m && q6 < n) { c[r7 * n + q6] = (E) c76; }
        if (r7 < m && q7 < n) { c[r7 * n + q7] = (E) c77; }
    }

    /**
     * gemmTiled128Unrolled over one slice of K: workgroup x / tiles is the slice, and its
     * 128 x 128 partial lands in plane `slice` of `parts` (m x n each) for gemmSplitJoin.
     * Generated from the unrolled body with only the K bounds, the first prefetch's base
     * and the stores changed, so its inner loop is the tuned one. `kChunk` is a multiple
     * of 16, which keeps every slice's wide loads aligned.
     */
    @Kernel(targets = {"cpu", "nvptx", "amdgpu"})
    @Occupancy(maxThreads = 256, minResident = 2)
    public static void gemmTiled128UnrolledSplit<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k,
                                                    uint32 kChunk) {
        Shared<float32> sa = shared float32[2112];
        Shared<float32> sb = shared float32[2112];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 127) / 128;
        uint32 tilesAll = ((m + 127) / 128) * ntiles;
        uint32 sp = Workgroup.x() / tilesAll;
        uint32 wid = Workgroup.x() - sp * tilesAll;
        uint32 kBeg = sp * kChunk;
        uint32 kEnd = kBeg + kChunk;
        if (kEnd > k) { kEnd = k; }
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c04 = 0.0f;
        float32 c05 = 0.0f;
        float32 c06 = 0.0f;
        float32 c07 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c14 = 0.0f;
        float32 c15 = 0.0f;
        float32 c16 = 0.0f;
        float32 c17 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c24 = 0.0f;
        float32 c25 = 0.0f;
        float32 c26 = 0.0f;
        float32 c27 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        float32 c34 = 0.0f;
        float32 c35 = 0.0f;
        float32 c36 = 0.0f;
        float32 c37 = 0.0f;
        float32 c40 = 0.0f;
        float32 c41 = 0.0f;
        float32 c42 = 0.0f;
        float32 c43 = 0.0f;
        float32 c44 = 0.0f;
        float32 c45 = 0.0f;
        float32 c46 = 0.0f;
        float32 c47 = 0.0f;
        float32 c50 = 0.0f;
        float32 c51 = 0.0f;
        float32 c52 = 0.0f;
        float32 c53 = 0.0f;
        float32 c54 = 0.0f;
        float32 c55 = 0.0f;
        float32 c56 = 0.0f;
        float32 c57 = 0.0f;
        float32 c60 = 0.0f;
        float32 c61 = 0.0f;
        float32 c62 = 0.0f;
        float32 c63 = 0.0f;
        float32 c64 = 0.0f;
        float32 c65 = 0.0f;
        float32 c66 = 0.0f;
        float32 c67 = 0.0f;
        float32 c70 = 0.0f;
        float32 c71 = 0.0f;
        float32 c72 = 0.0f;
        float32 c73 = 0.0f;
        float32 c74 = 0.0f;
        float32 c75 = 0.0f;
        float32 c76 = 0.0f;
        float32 c77 = 0.0f;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 4) == 0 && (n % 4) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = kBeg + ((kEnd - kBeg) / 16) * 16; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 4;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 32;
        uint32 bc0 = (t - br0 * 32) * 4;
        uint32 br1 = br0 + 8;
        uint32 k0 = kBeg;
        if (kFull > kBeg) {
            Vector<E,4> pa0 = a.vload<4>((m0 + ar0) * k + kBeg + ac0, align: 16);
            Vector<E,4> pa1 = a.vload<4>((m0 + ar1) * k + kBeg + ac0, align: 16);
            Vector<E,4> pb0 = b.vload<4>((kBeg + br0) * n + n0 + bc0, align: 16);
            Vector<E,4> pb1 = b.vload<4>((kBeg + br1) * n + n0 + bc0, align: 16);
            sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
            sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
            sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
            sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
            sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
            sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
            sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
            sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
            sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
            sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
            sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
            sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
            sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
            sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
            sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
            sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
            Barrier.workgroup();
            Vector<float32,4> av0;
            Vector<float32,4> av1;
            Vector<float32,4> bv0;
            Vector<float32,4> bv1;
            while (k0 < kFull) {
                uint32 next = k0 + 16;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<4>((m0 + ar0) * k + next + ac0, align: 16);
                    pa1 = a.vload<4>((m0 + ar1) * k + next + ac0, align: 16);
                    pb0 = b.vload<4>((next + br0) * n + n0 + bc0, align: 16);
                    pb1 = b.vload<4>((next + br1) * n + n0 + bc0, align: 16);
                }
                av0 = sa.vload<4>(0 + ty * 4);
                av1 = sa.vload<4>(64 + ty * 4);
                bv0 = sb.vload<4>(0 + tx * 4);
                bv1 = sb.vload<4>(64 + tx * 4);
                c00 = Math.fma(av0.x, bv0.x, c00);
                c01 = Math.fma(av0.x, bv0.y, c01);
                c02 = Math.fma(av0.x, bv0.z, c02);
                c03 = Math.fma(av0.x, bv0.w, c03);
                c04 = Math.fma(av0.x, bv1.x, c04);
                c05 = Math.fma(av0.x, bv1.y, c05);
                c06 = Math.fma(av0.x, bv1.z, c06);
                c07 = Math.fma(av0.x, bv1.w, c07);
                c10 = Math.fma(av0.y, bv0.x, c10);
                c11 = Math.fma(av0.y, bv0.y, c11);
                c12 = Math.fma(av0.y, bv0.z, c12);
                c13 = Math.fma(av0.y, bv0.w, c13);
                c14 = Math.fma(av0.y, bv1.x, c14);
                c15 = Math.fma(av0.y, bv1.y, c15);
                c16 = Math.fma(av0.y, bv1.z, c16);
                c17 = Math.fma(av0.y, bv1.w, c17);
                c20 = Math.fma(av0.z, bv0.x, c20);
                c21 = Math.fma(av0.z, bv0.y, c21);
                c22 = Math.fma(av0.z, bv0.z, c22);
                c23 = Math.fma(av0.z, bv0.w, c23);
                c24 = Math.fma(av0.z, bv1.x, c24);
                c25 = Math.fma(av0.z, bv1.y, c25);
                c26 = Math.fma(av0.z, bv1.z, c26);
                c27 = Math.fma(av0.z, bv1.w, c27);
                c30 = Math.fma(av0.w, bv0.x, c30);
                c31 = Math.fma(av0.w, bv0.y, c31);
                c32 = Math.fma(av0.w, bv0.z, c32);
                c33 = Math.fma(av0.w, bv0.w, c33);
                c34 = Math.fma(av0.w, bv1.x, c34);
                c35 = Math.fma(av0.w, bv1.y, c35);
                c36 = Math.fma(av0.w, bv1.z, c36);
                c37 = Math.fma(av0.w, bv1.w, c37);
                c40 = Math.fma(av1.x, bv0.x, c40);
                c41 = Math.fma(av1.x, bv0.y, c41);
                c42 = Math.fma(av1.x, bv0.z, c42);
                c43 = Math.fma(av1.x, bv0.w, c43);
                c44 = Math.fma(av1.x, bv1.x, c44);
                c45 = Math.fma(av1.x, bv1.y, c45);
                c46 = Math.fma(av1.x, bv1.z, c46);
                c47 = Math.fma(av1.x, bv1.w, c47);
                c50 = Math.fma(av1.y, bv0.x, c50);
                c51 = Math.fma(av1.y, bv0.y, c51);
                c52 = Math.fma(av1.y, bv0.z, c52);
                c53 = Math.fma(av1.y, bv0.w, c53);
                c54 = Math.fma(av1.y, bv1.x, c54);
                c55 = Math.fma(av1.y, bv1.y, c55);
                c56 = Math.fma(av1.y, bv1.z, c56);
                c57 = Math.fma(av1.y, bv1.w, c57);
                c60 = Math.fma(av1.z, bv0.x, c60);
                c61 = Math.fma(av1.z, bv0.y, c61);
                c62 = Math.fma(av1.z, bv0.z, c62);
