package dev.cajeta.ml.kernels;

import cajeta.xpu.Barrier;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Wave;
import cajeta.xpu.Workgroup;
import cajeta.lang.String;
import cajeta.time.Clock;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeProbe;
import dev.cajeta.ml.kernels.tune.TileFamily;
import dev.cajeta.ml.kernels.tune.TileShape;

/**
 * GEMM at f16, bf16 and f32 into float32, int8 into int32, and the plain f32 tile at E (spec §5.1): C[m][n] = A[m][k] . B[k][n], all row-major,
 * through the device's matrix cores (the portable software tile where it has none). The
 * 16x16 member stages each K-slab of A and B through zero-filled shared tiles, so a shape
 * that is no multiple of the tile runs; the torch-recipe tile (amdgpu) and llm's X3 shape
 * join the family when they are measured. A native matrix core accumulates in its own order
 * and precision: within 1e-5 relative plus K x 1e-7 absolute of a sequential float32 sum
 * (bit-exact on the portable tile).
 */
public final class Gemm {
    public Gemm() { return; }

    /** Workgroup (mi, nj): one 16x16 tile of C, the K loop staged through shared memory. */
    @Kernel
    public static void gemm16<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                E va = (E) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /**
     * The 128x128 member: workgroup (mi, nj) owns a 128x128 tile of C, eight waves of 32
     * each a 32x64 sub-tile (2x4 fragments). K goes in slabs of 32 staged through shared
     * tiles padded to a row stride of 40 (A) and 136 (B), so fragment rows start on distinct
     * banks; out-of-range elements stage as zero. An interior tile stores its fragments
     * straight to C; an edge tile, or an n the matrix core cannot store at, goes through
     * each wave's 16x16 scratch and writes only what is in range.
     */
    @Kernel @Wave(width = 32)
    @Occupancy(maxThreads = 256)
    public static void gemm128<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[5120];
        Shared<E> sb = shared E[4352];
        Shared<float32> sc = shared float32[2048];
        uint32 t = KernelThread.x();
        uint32 wave = t / 32;
        uint32 lane = t - wave * 32;
        uint32 wm = wave % 4;
        uint32 wn = wave / 4;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        CooperativeMatrix<float32,16,16,2>[2][4] acc;
        for (uint32 i = 0; i < 2; i = i + 1) {
            for (uint32 j = 0; j < 4; j = j + 1) { acc[i][j].splat(0.0f); }
        }
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1>[4] mb;
        // A tile wholly inside A and B, at strides an 8-wide load can take, runs its whole
        // 32-slabs on vector loads, the next slab loaded into registers while the current
        // one multiplies; a ragged K tail and every edge tile stage through zero fill.
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 8) == 0 && (n % 8) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 32) * 32; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 8;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 16;
        uint32 bc0 = (t - br0 * 16) * 8;
        uint32 br1 = br0 + 16;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<E,8> pa0 = a.vload<8>((m0 + ar0) * k + ac0);
            Vector<E,8> pa1 = a.vload<8>((m0 + ar1) * k + ac0);
            Vector<E,8> pb0 = b.vload<8>(br0 * n + n0 + bc0);
            Vector<E,8> pb1 = b.vload<8>(br1 * n + n0 + bc0);
            sa.vstore(ar0 * 40 + ac0, pa0);
            sa.vstore(ar1 * 40 + ac0, pa1);
            sb.vstore(br0 * 136 + bc0, pb0);
            sb.vstore(br1 * 136 + bc0, pb1);
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 32;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<8>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<8>((m0 + ar1) * k + next + ac0);
                    pb0 = b.vload<8>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<8>((next + br1) * n + n0 + bc0);
                }
                for (uint32 ks = 0; ks < 2; ks = ks + 1) {
                    for (uint32 j = 0; j < 4; j = j + 1) { mb[j].load(sb, ks * 16 * 136 + wn * 64 + j * 16, 0, 136); }
                    for (uint32 i = 0; i < 2; i = i + 1) {
                        ma.load(sa, (wm * 32 + i * 16) * 40 + ks * 16, 0, 40);
                        for (uint32 j = 0; j < 4; j = j + 1) { acc[i][j].mma(ma, mb[j]); }
                    }
                }
                Barrier.workgroup();
                if (more) {
                    sa.vstore(ar0 * 40 + ac0, pa0);
                    sa.vstore(ar1 * 40 + ac0, pa1);
                    sb.vstore(br0 * 136 + bc0, pb0);
                    sb.vstore(br1 * 136 + bc0, pb1);
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 4096) {
                uint32 r = idx / 32;
                uint32 cc = idx - r * 32;
                uint32 gm = m0 + r;
                uint32 gk = k0 + cc;
                E va = (E) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[r * 40 + cc] = va;
                uint32 rb = idx / 128;
                uint32 cb = idx - rb * 128;
                uint32 gk2 = k0 + rb;
                uint32 gn = n0 + cb;
                E vb = (E) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[rb * 136 + cb] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            for (uint32 ks = 0; ks < 2; ks = ks + 1) {
                for (uint32 j = 0; j < 4; j = j + 1) { mb[j].load(sb, ks * 16 * 136 + wn * 64 + j * 16, 0, 136); }
                for (uint32 i = 0; i < 2; i = i + 1) {
                    ma.load(sa, (wm * 32 + i * 16) * 40 + ks * 16, 0, 40);
                    for (uint32 j = 0; j < 4; j = j + 1) { acc[i][j].mma(ma, mb[j]); }
                }
            }
            Barrier.workgroup();
            k0 = k0 + 32;
        }
        boolean interior = m0 + 128 <= m && n0 + 128 <= n && (n % 8) == 0;
        if (interior) {
            for (uint32 i = 0; i < 2; i = i + 1) {
                for (uint32 j = 0; j < 4; j = j + 1) {
                    acc[i][j].store(c, (m0 + wm * 32 + i * 16) * n + n0 + wn * 64 + j * 16, 0, n);
                }
            }
        } else {
            for (uint32 i = 0; i < 2; i = i + 1) {
                for (uint32 j = 0; j < 4; j = j + 1) {
                    acc[i][j].store(sc, wave * 256, 0, 16);
                    Barrier.workgroup();
                    uint32 r0 = m0 + wm * 32 + i * 16;
                    uint32 c0 = n0 + wn * 64 + j * 16;
                    uint32 e = lane;
                    while (e < 256) {
                        uint32 er = e / 16;
                        uint32 ec = e - er * 16;
                        if (r0 + er < m && c0 + ec < n) { c[(r0 + er) * n + c0 + ec] = sc[wave * 256 + e]; }
                        e = e + 32;
                    }
                    Barrier.workgroup();
                }
            }
        }
    }

    /** `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at E through the 128x128 member; synced. */
    public static void run128<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemm128.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
        s.sync();
    }

    /** The int8 form: workgroup (mi, nj) owns one 16x16 tile of C, accumulated exactly in int32 through the integer matrix core. */
    @Kernel
    public static void gemm16I8(KernelBuffer<int32> c, KernelBuffer<int8> a, KernelBuffer<int8> b, uint32 m, uint32 n, uint32 k) {
        Shared<int8> sa = shared int8[256];
        Shared<int8> sb = shared int8[256];
        Shared<int32> sc = shared int32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        CooperativeMatrix<int32,16,16,2> mc;
        mc.splat(0);
        CooperativeMatrix<int8,16,16,0> ma;
        CooperativeMatrix<int8,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                int8 va = (int8) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                int8 vb = (int8) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** `c` (m x n, int32) = `a` (m x k) . `b` (k x n) over int8, exact; synced. */
    public static void runI8(KernelBuffer<int32> c, KernelBuffer<int8> a, KernelBuffer<int8> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm16I8.launch(s, grid: [tiles], block: [64])(c, a, b, um, un, uk);
        s.sync();
    }

    // Three kernels of one body: a class template over S instantiated inside the library
    // links twice in a consumer (cajeta-ml-gpu 21.2.2), while generic-method instantiations dedupe.

    /** Split-K, S = 2: workgroup (split, tile) multiplies its K range into slice `split` of `parts`. */
    @Kernel
    public static void split2<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 split = wid / tiles;
        uint32 tl = wid - split * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 kc = (((k + 2 - 1) / 2 + 15) / 16) * 16;
        uint32 kStart = split * kc;
        uint32 kEnd = kStart + kc;
        if (kEnd > k) { kEnd = k; }
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 kk = kStart;
        while (kk < kEnd) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk + cc;
                E va = (E) 0;
                if (gm < m && gk < kEnd) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < kEnd && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 16;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { parts[split * m * n + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** Split-K, S = 4: workgroup (split, tile) multiplies its K range into slice `split` of `parts`. */
    @Kernel
    public static void split4<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 split = wid / tiles;
        uint32 tl = wid - split * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 kc = (((k + 4 - 1) / 4 + 15) / 16) * 16;
        uint32 kStart = split * kc;
        uint32 kEnd = kStart + kc;
        if (kEnd > k) { kEnd = k; }
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 kk = kStart;
        while (kk < kEnd) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk + cc;
                E va = (E) 0;
                if (gm < m && gk < kEnd) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < kEnd && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 16;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { parts[split * m * n + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** Split-K, S = 8: workgroup (split, tile) multiplies its K range into slice `split` of `parts`. */
    @Kernel
    public static void split8<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 split = wid / tiles;
        uint32 tl = wid - split * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 kc = (((k + 8 - 1) / 8 + 15) / 16) * 16;
        uint32 kStart = split * kc;
        uint32 kEnd = kStart + kc;
        if (kEnd > k) { kEnd = k; }
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 kk = kStart;
        while (kk < kEnd) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk + cc;
                E va = (E) 0;
                if (gm < m && gk < kEnd) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < kEnd && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 16;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { parts[split * m * n + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** Lane i sums the S slices of `parts` at i in split order into c[i]. */
    @Kernel
    public static void splitFixup(KernelBuffer<float32> c, KernelBuffer<float32> parts, uint32 mn, uint32 splits) {
        uint32 i = KernelThread.globalIdX();
        if (i < mn) {
            float32 acc = 0.0f;
            uint32 s = 0;
            while (s < splits) { acc = acc + parts[s * mn + i]; s = s + 1; }
            c[i] = acc;
        }
    }

    /** The f16 GEMM split S ways over K (S in 1, 2, 4, 8), fixed up in split order; synced. */
    public static void splitKF16(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                                 int64 m, int64 n, int64 k, int64 splits) {
        if (splits <= 1L) { Gemm.run<float16>(c, a, b, m, n, k); return; }
        KernelBuffer<float32> parts = heap KernelBuffer<float32>((uint64) (splits * m * n));
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        if (splits == 2L) { split2.launch(s, grid: [tiles * 2], block: [64])(parts, a, b, um, un, uk); }
        else if (splits == 4L) { split4.launch(s, grid: [tiles * 4], block: [64])(parts, a, b, um, un, uk); }
        else { split8.launch(s, grid: [tiles * 8], block: [64])(parts, a, b, um, un, uk); }
        uint32 mn = (uint32) (m * n);
        splitFixup.launch(s, grid: [(mn + 255) / 256], block: [256])(c, parts, mn, (uint32) splits);
        s.sync();
    }

    static TileFamily<SplitShape> splitFam;
    static boolean splitTimed = false;

    static TileFamily<SplitShape> splitFamily() {
        if (Gemm.splitFam == null) {
            Gemm.splitFam = heap TileFamily<SplitShape>("gemm-splitk");
            Gemm.splitFam.add(#heap SplitShape(1));
            Gemm.splitFam.add(#heap SplitShape(2));
            Gemm.splitFam.add(#heap SplitShape(4));
            Gemm.splitFam.add(#heap SplitShape(8));
        }
        return Gemm.splitFam;
    }

    /** Whether the last {@link #runTunedF16} timed its members. */
    public static boolean lastChoiceTimed() { return Gemm.splitTimed; }

    /** The f16 GEMM by the split count the family chooses for this shape (timed at first use, remembered under `tuneDir`); returns the split count. */
    public static int32 runTunedF16(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                                    int64 m, int64 n, int64 k, String tuneDir) {
        TileFamily<SplitShape> f = Gemm.splitFamily();
        ShapeFilter flt #= f.filterFor(m, n, k);
        SplitProbe probe = heap SplitProbe(a, b, flt, f, m, n, k);
        int32 idx = f.chooseWith(tuneDir, flt, probe, m, n, k);
        Gemm.splitTimed = probe.timed > 0;
        int64 splits = SplitShape.splitsOf(idx);
        Gemm.splitKF16(c, a, b, m, n, k, splits);
        return (int32) splits;
    }

    /** Batch b of `batch` independent products in one launch: workgroup (b, tile). */
    @Kernel
    public static void gemm16Batched<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 bi = wid / tiles;
        uint32 tl = wid - bi * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 aBase = bi * m * k;
        uint32 bBase = bi * k * n;
        uint32 cBase = bi * m * n;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                E va = (E) 0;
                if (gm < m && gk < k) { va = a[aBase + gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < k && gn < n) { vb = b[bBase + gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[cBase + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** `batch` independent m x k by k x n products, operands and results stacked, in one launch; synced. */
    public static void batched<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k, int64 batch) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm16Batched.launch(s, grid: [tiles * (uint32) batch], block: [64])(c, a, b, um, un, (uint32) k);
        s.sync();
    }

    /** Workgroup (mi, nj): one 16x16 tile of C at E, each lane one element, the K loop staged
     *  through float32 shared tiles and summed in k order, so it matches a sequential float32 sum. */
    @Kernel
    public static void gemmTiled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[256];
        Shared<float32> sb = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 r = t / 16;
        uint32 cc = t - r * 16;
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 gm = mi * 16 + r;
        uint32 gn = nj * 16 + cc;
        float32 acc = 0.0f;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 gk = kk * 16 + cc;
            float32 va = 0.0f;
            if (gm < m && gk < k) { va = (float32) a[gm * k + gk]; }
            sa[t] = va;
            uint32 gk2 = kk * 16 + r;
            float32 vb = 0.0f;
            if (gk2 < k && gn < n) { vb = (float32) b[gk2 * n + gn]; }
            sb[t] = vb;
            Barrier.workgroup();
            uint32 p = 0;
            while (p < 16) {
                acc = acc + sa[r * 16 + p] * sb[p * 16 + cc];
                p = p + 1;
            }
            Barrier.workgroup();
            kk = kk + 1;
        }
        if (gm < m && gn < n) { c[gm * n + gn] = (E) acc; }
    }

    /**
     * The register-blocked plain tile: workgroup (mi, nj) owns a 64x64 tile of C at E, each
     * of 256 lanes a 4x4 block strided by 16 so a wave reads consecutive shared words. K goes
     * in slabs of 16 through float32 shared tiles (A stored k-major), and every output is
     * summed in k order, so it matches a sequential float32 sum as gemmTiled does.
     */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmTiled64<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[1088];
        Shared<float32> sb = shared float32[1088];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 63) / 64;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 64;
        uint32 n0 = nj * 64;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        uint32 k0 = 0;
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 1024) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < k) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 68 + ar] = va;
                uint32 bk = idx / 64;
                uint32 bc = idx - bk * 64;
                float32 vb = 0.0f;
                if (k0 + bk < k && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 68 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                float32 a0 = sa[kk * 68 + ty];
                float32 a1 = sa[kk * 68 + ty + 16];
                float32 a2 = sa[kk * 68 + ty + 32];
                float32 a3 = sa[kk * 68 + ty + 48];
                float32 b0 = sb[kk * 68 + tx];
                float32 b1 = sb[kk * 68 + tx + 16];
                float32 b2 = sb[kk * 68 + tx + 32];
                float32 b3 = sb[kk * 68 + tx + 48];
                c00 = c00 + a0 * b0;
                c01 = c01 + a0 * b1;
                c02 = c02 + a0 * b2;
                c03 = c03 + a0 * b3;
                c10 = c10 + a1 * b0;
                c11 = c11 + a1 * b1;
                c12 = c12 + a1 * b2;
                c13 = c13 + a1 * b3;
                c20 = c20 + a2 * b0;
                c21 = c21 + a2 * b1;
                c22 = c22 + a2 * b2;
                c23 = c23 + a2 * b3;
                c30 = c30 + a3 * b0;
                c31 = c31 + a3 * b1;
                c32 = c32 + a3 * b2;
                c33 = c33 + a3 * b3;
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty;
        uint32 r1 = r0 + 16;
        uint32 r2 = r0 + 32;
        uint32 r3 = r0 + 48;
        uint32 q0 = n0 + tx;
        uint32 q1 = q0 + 16;
        uint32 q2 = q0 + 32;
        uint32 q3 = q0 + 48;
        if (r0 < m && q0 < n) { c[r0 * n + q0] = (E) c00; }
        if (r0 < m && q1 < n) { c[r0 * n + q1] = (E) c01; }
        if (r0 < m && q2 < n) { c[r0 * n + q2] = (E) c02; }
        if (r0 < m && q3 < n) { c[r0 * n + q3] = (E) c03; }
        if (r1 < m && q0 < n) { c[r1 * n + q0] = (E) c10; }
        if (r1 < m && q1 < n) { c[r1 * n + q1] = (E) c11; }
        if (r1 < m && q2 < n) { c[r1 * n + q2] = (E) c12; }
        if (r1 < m && q3 < n) { c[r1 * n + q3] = (E) c13; }
        if (r2 < m && q0 < n) { c[r2 * n + q0] = (E) c20; }
        if (r2 < m && q1 < n) { c[r2 * n + q1] = (E) c21; }
        if (r2 < m && q2 < n) { c[r2 * n + q2] = (E) c22; }
        if (r2 < m && q3 < n) { c[r2 * n + q3] = (E) c23; }
        if (r3 < m && q0 < n) { c[r3 * n + q0] = (E) c30; }
        if (r3 < m && q1 < n) { c[r3 * n + q1] = (E) c31; }
        if (r3 < m && q2 < n) { c[r3 * n + q2] = (E) c32; }
        if (r3 < m && q3 < n) { c[r3 * n + q3] = (E) c33; }
    }

    /** `c` (m x n) = `a` (m x k) . `b` (k x n), all at E, through the register-blocked plain tile; synced. */
    public static void tiled64<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 63) / 64) * ((un + 63) / 64);
        KernelStream s #= KernelStream.current();
        gemmTiled64.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
        s.sync();
    }

    /** The plain tile over a leading batch axis: workgroup (batch, mi, nj). */
    @Kernel
    public static void gemmTiledBatched<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[256];
        Shared<float32> sb = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 r = t / 16;
        uint32 cc = t - r * 16;
        uint32 mtiles = (m + 15) / 16;
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = mtiles * ntiles;
        uint32 wid = Workgroup.x();
        uint32 bt = wid / tiles;
        uint32 rem = wid - bt * tiles;
        uint32 mi = rem / ntiles;
        uint32 nj = rem - mi * ntiles;
        uint32 abase = bt * m * k;
        uint32 bbase = bt * k * n;
        uint32 gm = mi * 16 + r;
        uint32 gn = nj * 16 + cc;
        float32 acc = 0.0f;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 gk = kk * 16 + cc;
            float32 va = 0.0f;
            if (gm < m && gk < k) { va = (float32) a[abase + gm * k + gk]; }
            sa[t] = va;
            uint32 gk2 = kk * 16 + r;
            float32 vb = 0.0f;
            if (gk2 < k && gn < n) { vb = (float32) b[bbase + gk2 * n + gn]; }
            sb[t] = vb;
            Barrier.workgroup();
            uint32 p = 0;
            while (p < 16) {
                acc = acc + sa[r * 16 + p] * sb[p * 16 + cc];
                p = p + 1;
            }
            Barrier.workgroup();
            kk = kk + 1;
        }
        if (gm < m && gn < n) { c[bt * m * n + gm * n + gn] = (E) acc; }
    }

    /** `c` (batch x m x n) = `a` (batch x m x k) . `b` (batch x k x n) at E through the plain tile; synced. */
    public static void tiledBatched<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k, int64 batch) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemmTiledBatched.launch(s, grid: [tiles * (uint32) batch], block: [256])(c, a, b, um, un, (uint32) k);
        s.sync();
    }

    /** `c` (m x n) = `a` (m x k) . `b` (k x n), all at E, through the plain tile; synced. */
    public static void tiled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemmTiled.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
        s.sync();
    }

    /** `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at E; synced. */
    public static void run<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm16.launch(s, grid: [tiles], block: [64])(c, a, b, um, un, uk);
        s.sync();
    }
}

/** A split count as a tile family member: 1 is the plain f16 kernel, 2, 4 and 8 the split kernels. */
final class SplitShape implements TileShape {
    int32 v;
    public SplitShape(int32 v) { this.v = v; }
    static int64 splitsOf(int32 idx) { if (idx == 1) { return 2L; } if (idx == 2) { return 4L; } if (idx == 3) { return 8L; } return 1L; }
    public #String kernel() {
        if (this.v == 2) { return "split2_float16"; }
        if (this.v == 4) { return "split4_float16"; }
        if (this.v == 8) { return "split8_float16"; }
        return "gemm16_float16";
    }
    public int32 tileM() { return 16; }
    public int32 tileN() { return 16; }
    public int32 threads() { return 64; }
    /** A split needs at least one 16-wide K step per part. */
    public boolean fits(int64 rows, int64 outDim, int64 cols) { return cols >= 16L * (int64) this.v; }
}

/** Times one surviving split count at the probe's shape into a scratch C. */
final class SplitProbe implements ShapeProbe {
    KernelBuffer<float16> a;
    KernelBuffer<float16> b;
    ShapeFilter filter;
    TileFamily<SplitShape> fam;
    KernelBuffer<float32> scratch;
    int64 m;
    int64 n;
    int64 k;
    public int32 timed = 0;

    public SplitProbe(^KernelBuffer<float16> a, ^KernelBuffer<float16> b, ^ShapeFilter filter, ^TileFamily<SplitShape> fam,
                      int64 m, int64 n, int64 k) {
        this.a = a;
        this.b = b;
        this.filter = filter;
        this.fam = fam;
        this.m = m;
        this.n = n;
        this.k = k;
        this.scratch = heap KernelBuffer<float32>((uint64) (m * n));
    }

    public int64 timeNanos(int32 i) {
        this.timed = this.timed + 1;
        int32 idx = this.fam.indexOf(this.filter.survivor(i).candidate.kernel);
        int64 t0 = Clock.nanoTime();
        Gemm.splitKF16(this.scratch, this.a, this.b, this.m, this.n, this.k, SplitShape.splitsOf(idx));
        return Clock.nanoTime() - t0;
    }
}
