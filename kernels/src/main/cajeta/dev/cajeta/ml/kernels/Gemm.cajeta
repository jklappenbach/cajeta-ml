                c02 = Math.fma(lv0.x, lw0.z, c02);
                c03 = Math.fma(lv0.x, lw0.w, c03);
                c04 = Math.fma(lv0.x, lw1.x, c04);
                c05 = Math.fma(lv0.x, lw1.y, c05);
                c06 = Math.fma(lv0.x, lw1.z, c06);
                c07 = Math.fma(lv0.x, lw1.w, c07);
                c10 = Math.fma(lv0.y, lw0.x, c10);
                c11 = Math.fma(lv0.y, lw0.y, c11);
                c12 = Math.fma(lv0.y, lw0.z, c12);
                c13 = Math.fma(lv0.y, lw0.w, c13);
                c14 = Math.fma(lv0.y, lw1.x, c14);
                c15 = Math.fma(lv0.y, lw1.y, c15);
                c16 = Math.fma(lv0.y, lw1.z, c16);
                c17 = Math.fma(lv0.y, lw1.w, c17);
                c20 = Math.fma(lv0.z, lw0.x, c20);
                c21 = Math.fma(lv0.z, lw0.y, c21);
                c22 = Math.fma(lv0.z, lw0.z, c22);
                c23 = Math.fma(lv0.z, lw0.w, c23);
                c24 = Math.fma(lv0.z, lw1.x, c24);
                c25 = Math.fma(lv0.z, lw1.y, c25);
                c26 = Math.fma(lv0.z, lw1.z, c26);
                c27 = Math.fma(lv0.z, lw1.w, c27);
                c30 = Math.fma(lv0.w, lw0.x, c30);
                c31 = Math.fma(lv0.w, lw0.y, c31);
                c32 = Math.fma(lv0.w, lw0.z, c32);
                c33 = Math.fma(lv0.w, lw0.w, c33);
                c34 = Math.fma(lv0.w, lw1.x, c34);
                c35 = Math.fma(lv0.w, lw1.y, c35);
                c36 = Math.fma(lv0.w, lw1.z, c36);
                c37 = Math.fma(lv0.w, lw1.w, c37);
                c40 = Math.fma(lv1.x, lw0.x, c40);
                c41 = Math.fma(lv1.x, lw0.y, c41);
                c42 = Math.fma(lv1.x, lw0.z, c42);
                c43 = Math.fma(lv1.x, lw0.w, c43);
                c44 = Math.fma(lv1.x, lw1.x, c44);
                c45 = Math.fma(lv1.x, lw1.y, c45);
                c46 = Math.fma(lv1.x, lw1.z, c46);
                c47 = Math.fma(lv1.x, lw1.w, c47);
                c50 = Math.fma(lv1.y, lw0.x, c50);
                c51 = Math.fma(lv1.y, lw0.y, c51);
                c52 = Math.fma(lv1.y, lw0.z, c52);
                c53 = Math.fma(lv1.y, lw0.w, c53);
                c54 = Math.fma(lv1.y, lw1.x, c54);
                c55 = Math.fma(lv1.y, lw1.y, c55);
                c56 = Math.fma(lv1.y, lw1.z, c56);
                c57 = Math.fma(lv1.y, lw1.w, c57);
                c60 = Math.fma(lv1.z, lw0.x, c60);
                c61 = Math.fma(lv1.z, lw0.y, c61);
                c62 = Math.fma(lv1.z, lw0.z, c62);
                c63 = Math.fma(lv1.z, lw0.w, c63);
                c64 = Math.fma(lv1.z, lw1.x, c64);
                c65 = Math.fma(lv1.z, lw1.y, c65);
                c66 = Math.fma(lv1.z, lw1.z, c66);
                c67 = Math.fma(lv1.z, lw1.w, c67);
                c70 = Math.fma(lv1.w, lw0.x, c70);
                c71 = Math.fma(lv1.w, lw0.y, c71);
                c72 = Math.fma(lv1.w, lw0.z, c72);
                c73 = Math.fma(lv1.w, lw0.w, c73);
                c74 = Math.fma(lv1.w, lw1.x, c74);
                c75 = Math.fma(lv1.w, lw1.y, c75);
                c76 = Math.fma(lv1.w, lw1.z, c76);
                c77 = Math.fma(lv1.w, lw1.w, c77);
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty * 4 + 0;
        uint32 r1 = m0 + ty * 4 + 1;
        uint32 r2 = m0 + ty * 4 + 2;
        uint32 r3 = m0 + ty * 4 + 3;
        uint32 r4 = m0 + 64 + ty * 4 + 0;
        uint32 r5 = m0 + 64 + ty * 4 + 1;
        uint32 r6 = m0 + 64 + ty * 4 + 2;
        uint32 r7 = m0 + 64 + ty * 4 + 3;
        uint32 q0 = n0 + tx * 4 + 0;
        uint32 q1 = n0 + tx * 4 + 1;
        uint32 q2 = n0 + tx * 4 + 2;
        uint32 q3 = n0 + tx * 4 + 3;
        uint32 q4 = n0 + 64 + tx * 4 + 0;
        uint32 q5 = n0 + 64 + tx * 4 + 1;
        uint32 q6 = n0 + 64 + tx * 4 + 2;
        uint32 q7 = n0 + 64 + tx * 4 + 3;
        if (r0 < m && q0 < n) { c[r0 * n + q0] = c00; }
        if (r0 < m && q1 < n) { c[r0 * n + q1] = c01; }
        if (r0 < m && q2 < n) { c[r0 * n + q2] = c02; }
        if (r0 < m && q3 < n) { c[r0 * n + q3] = c03; }
        if (r0 < m && q4 < n) { c[r0 * n + q4] = c04; }
        if (r0 < m && q5 < n) { c[r0 * n + q5] = c05; }
        if (r0 < m && q6 < n) { c[r0 * n + q6] = c06; }
        if (r0 < m && q7 < n) { c[r0 * n + q7] = c07; }
        if (r1 < m && q0 < n) { c[r1 * n + q0] = c10; }
        if (r1 < m && q1 < n) { c[r1 * n + q1] = c11; }
        if (r1 < m && q2 < n) { c[r1 * n + q2] = c12; }
        if (r1 < m && q3 < n) { c[r1 * n + q3] = c13; }
        if (r1 < m && q4 < n) { c[r1 * n + q4] = c14; }
        if (r1 < m && q5 < n) { c[r1 * n + q5] = c15; }
        if (r1 < m && q6 < n) { c[r1 * n + q6] = c16; }
        if (r1 < m && q7 < n) { c[r1 * n + q7] = c17; }
        if (r2 < m && q0 < n) { c[r2 * n + q0] = c20; }
        if (r2 < m && q1 < n) { c[r2 * n + q1] = c21; }
        if (r2 < m && q2 < n) { c[r2 * n + q2] = c22; }
        if (r2 < m && q3 < n) { c[r2 * n + q3] = c23; }
        if (r2 < m && q4 < n) { c[r2 * n + q4] = c24; }
        if (r2 < m && q5 < n) { c[r2 * n + q5] = c25; }
        if (r2 < m && q6 < n) { c[r2 * n + q6] = c26; }
        if (r2 < m && q7 < n) { c[r2 * n + q7] = c27; }
        if (r3 < m && q0 < n) { c[r3 * n + q0] = c30; }
        if (r3 < m && q1 < n) { c[r3 * n + q1] = c31; }
        if (r3 < m && q2 < n) { c[r3 * n + q2] = c32; }
        if (r3 < m && q3 < n) { c[r3 * n + q3] = c33; }
        if (r3 < m && q4 < n) { c[r3 * n + q4] = c34; }
        if (r3 < m && q5 < n) { c[r3 * n + q5] = c35; }
        if (r3 < m && q6 < n) { c[r3 * n + q6] = c36; }
        if (r3 < m && q7 < n) { c[r3 * n + q7] = c37; }
        if (r4 < m && q0 < n) { c[r4 * n + q0] = c40; }
        if (r4 < m && q1 < n) { c[r4 * n + q1] = c41; }
        if (r4 < m && q2 < n) { c[r4 * n + q2] = c42; }
        if (r4 < m && q3 < n) { c[r4 * n + q3] = c43; }
        if (r4 < m && q4 < n) { c[r4 * n + q4] = c44; }
        if (r4 < m && q5 < n) { c[r4 * n + q5] = c45; }
        if (r4 < m && q6 < n) { c[r4 * n + q6] = c46; }
        if (r4 < m && q7 < n) { c[r4 * n + q7] = c47; }
        if (r5 < m && q0 < n) { c[r5 * n + q0] = c50; }
        if (r5 < m && q1 < n) { c[r5 * n + q1] = c51; }
        if (r5 < m && q2 < n) { c[r5 * n + q2] = c52; }
        if (r5 < m && q3 < n) { c[r5 * n + q3] = c53; }
        if (r5 < m && q4 < n) { c[r5 * n + q4] = c54; }
        if (r5 < m && q5 < n) { c[r5 * n + q5] = c55; }
        if (r5 < m && q6 < n) { c[r5 * n + q6] = c56; }
        if (r5 < m && q7 < n) { c[r5 * n + q7] = c57; }
        if (r6 < m && q0 < n) { c[r6 * n + q0] = c60; }
        if (r6 < m && q1 < n) { c[r6 * n + q1] = c61; }
        if (r6 < m && q2 < n) { c[r6 * n + q2] = c62; }
        if (r6 < m && q3 < n) { c[r6 * n + q3] = c63; }
        if (r6 < m && q4 < n) { c[r6 * n + q4] = c64; }
        if (r6 < m && q5 < n) { c[r6 * n + q5] = c65; }
        if (r6 < m && q6 < n) { c[r6 * n + q6] = c66; }
        if (r6 < m && q7 < n) { c[r6 * n + q7] = c67; }
        if (r7 < m && q0 < n) { c[r7 * n + q0] = c70; }
        if (r7 < m && q1 < n) { c[r7 * n + q1] = c71; }
        if (r7 < m && q2 < n) { c[r7 * n + q2] = c72; }
        if (r7 < m && q3 < n) { c[r7 * n + q3] = c73; }
        if (r7 < m && q4 < n) { c[r7 * n + q4] = c74; }
        if (r7 < m && q5 < n) { c[r7 * n + q5] = c75; }
        if (r7 < m && q6 < n) { c[r7 * n + q6] = c76; }
        if (r7 < m && q7 < n) { c[r7 * n + q7] = c77; }
    }

    /** `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at E through the wide register tile; queued on the current stream. */
    public static void wide<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        if (Gemm.unrolledPays("gemmWideUnrolled_bfloat16")) { Gemm.wideUnrolled<E>(c, a, b, m, n, k); return; }
        Gemm.wideRolled<E>(c, a, b, m, n, k);
    }

    /** wide on the rolled body, which every backend builds. */
    public static void wideRolled<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemmWide.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /** wide on the unrolled body; its launch throws `not a target` where it is not built. */
    public static void wideUnrolled<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemmWideUnrolled.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /** The kernel {@link #wide} runs on this backend at bfloat16. */
    public static #String wideMember() {
        if (Gemm.unrolledPays("gemmWideUnrolled_bfloat16")) { return "gemmWideUnrolled_bfloat16".clone(); }
        return "gemmWide_bfloat16".clone();
    }

    /**
     * `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at bfloat16; queued on the current stream. The 128x128 matrix-core
     * member where this backend has it built (cpu, nvptx, amdgpu), the wide register tile where it
     * does not (vulkan).
     */
    public static void runBf16(KernelBuffer<float32> c, KernelBuffer<bfloat16> a, KernelBuffer<bfloat16> b, int64 m, int64 n, int64 k) {
        if (!Device.kernelAvailable("gemm128Bf16")) { Gemm.wide<bfloat16>(c, a, b, m, n, k); return; }
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemm128Bf16.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /**
     * The 256x128 member: sixteen waves of 32 each a 32x64 sub-tile. K goes in slabs of 32
     * through two shared buffers padded to a row stride of 40, B staged transposed so both
     * operands' fragments are row loads; the next slab's staging stores overlap this slab's
     * matrix ops, one shared-memory barrier per slab, and three register sets fetch three
     * slabs ahead. Each workgroup starts its K walk one slab further along than the last,
     * spreading the workgroups in flight over the L2 channels. Edge tiles and a ragged K
     * tail stage through zero fill; an edge tile stores through a 2 KB scratch in rounds.
     * 62 KB of shared memory: one workgroup per multiprocessor on sm_89, two on gfx1151.
     */
    @Kernel @Wave(width = 32)
    @Occupancy(maxThreads = 512)
    public static void gemm256<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[20480];
        Shared<E> sb = shared E[10240];
        Shared<float32> sc = shared float32[512];
        uint32 t = KernelThread.x();
        uint32 wave = t / 32;
        uint32 lane = t - wave * 32;
        uint32 wm = wave % 8;
        uint32 wn = wave / 8;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 256;
        uint32 n0 = nj * 128;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb0;
        CooperativeMatrix<E,16,16,1> mb1;
        CooperativeMatrix<E,16,16,1> mb2;
        CooperativeMatrix<E,16,16,1> mb3;
        boolean wide = m0 + 256 <= m && n0 + 128 <= n && (k % 8) == 0 && (n % 8) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 32) * 32; }
        uint32 ac0 = (t % 4) * 8;
        uint32 ar0 = t / 4;
        uint32 ar1 = t / 4 + 128;
        uint32 kr = t % 32;
        uint32 bn0 = (t / 32) * 8;
        uint32 k0 = 0;
        uint32 ks0 = 0;
        if (kFull > 0) { ks0 = (wid * 32) % kFull; }
        if (kFull > 0) {
            uint32 ks1 = ks0 + 32;
            if (ks1 >= kFull) { ks1 = 0; }
            uint32 ks2 = ks1 + 32;
            if (ks2 >= kFull) { ks2 = 0; }
            Vector<E,8> pa0 = a.vload<8>((m0 + ar0) * k + ks0 + ac0);
            Vector<E,8> pa1 = a.vload<8>((m0 + ar1) * k + ks0 + ac0);
            Vector<E,8> pb0 = b.vload<8>((ks0 + kr) * n + n0 + bn0);
            Vector<E,8> qa0 = a.vload<8>((m0 + ar0) * k + ks1 + ac0);
            Vector<E,8> qa1 = a.vload<8>((m0 + ar1) * k + ks1 + ac0);
            Vector<E,8> qb0 = b.vload<8>((ks1 + kr) * n + n0 + bn0);
            Vector<E,8> ra0 = a.vload<8>((m0 + ar0) * k + ks2 + ac0);
            Vector<E,8> ra1 = a.vload<8>((m0 + ar1) * k + ks2 + ac0);
            Vector<E,8> rb0 = b.vload<8>((ks2 + kr) * n + n0 + bn0);
            sa.vstore(0 + ar0 * 40 + ac0, pa0);
            sa.vstore(0 + ar1 * 40 + ac0, pa1);
            sb[0 + (bn0 + 0) * 40 + kr] = pb0[0];
            sb[0 + (bn0 + 1) * 40 + kr] = pb0[1];
            sb[0 + (bn0 + 2) * 40 + kr] = pb0[2];
            sb[0 + (bn0 + 3) * 40 + kr] = pb0[3];
            sb[0 + (bn0 + 4) * 40 + kr] = pb0[4];
            sb[0 + (bn0 + 5) * 40 + kr] = pb0[5];
            sb[0 + (bn0 + 6) * 40 + kr] = pb0[6];
            sb[0 + (bn0 + 7) * 40 + kr] = pb0[7];
            Barrier.shared();
            while (k0 < kFull) {
                uint32 kn = ks2 + 32;
                if (kn >= kFull) { kn = 0; }
                if (k0 + 96 >= kFull) { kn = ks0; }
                pa0 = a.vload<8>((m0 + ar0) * k + kn + ac0); pa1 = a.vload<8>((m0 + ar1) * k + kn + ac0);
                mb0.load(sb, 0 + (wn * 64 + 0) * 40 + 0 * 16, 1, 40);
                mb1.load(sb, 0 + (wn * 64 + 16) * 40 + 0 * 16, 1, 40);
                mb2.load(sb, 0 + (wn * 64 + 32) * 40 + 0 * 16, 1, 40);
                mb3.load(sb, 0 + (wn * 64 + 48) * 40 + 0 * 16, 1, 40);
                ma.load(sa, 0 + (wm * 32 + 0) * 40 + 0 * 16, 0, 40);
                a00.mma(ma, mb0);
                a01.mma(ma, mb1);
                a02.mma(ma, mb2);
                a03.mma(ma, mb3);
                ma.load(sa, 0 + (wm * 32 + 16) * 40 + 0 * 16, 0, 40);
                a10.mma(ma, mb0);
                a11.mma(ma, mb1);
                a12.mma(ma, mb2);
                a13.mma(ma, mb3);
                pb0 = b.vload<8>((kn + kr) * n + n0 + bn0);
                mb0.load(sb, 0 + (wn * 64 + 0) * 40 + 1 * 16, 1, 40);
                mb1.load(sb, 0 + (wn * 64 + 16) * 40 + 1 * 16, 1, 40);
                mb2.load(sb, 0 + (wn * 64 + 32) * 40 + 1 * 16, 1, 40);
                mb3.load(sb, 0 + (wn * 64 + 48) * 40 + 1 * 16, 1, 40);
                ma.load(sa, 0 + (wm * 32 + 0) * 40 + 1 * 16, 0, 40);
                a00.mma(ma, mb0);
                a01.mma(ma, mb1);
                a02.mma(ma, mb2);
                a03.mma(ma, mb3);
                ma.load(sa, 0 + (wm * 32 + 16) * 40 + 1 * 16, 0, 40);
                a10.mma(ma, mb0);
                a11.mma(ma, mb1);
                a12.mma(ma, mb2);
                a13.mma(ma, mb3);
                sa.vstore(10240 + ar0 * 40 + ac0, qa0);
                sa.vstore(10240 + ar1 * 40 + ac0, qa1);
                sb[5120 + (bn0 + 0) * 40 + kr] = qb0[0];
                sb[5120 + (bn0 + 1) * 40 + kr] = qb0[1];
                sb[5120 + (bn0 + 2) * 40 + kr] = qb0[2];
                sb[5120 + (bn0 + 3) * 40 + kr] = qb0[3];
                sb[5120 + (bn0 + 4) * 40 + kr] = qb0[4];
                sb[5120 + (bn0 + 5) * 40 + kr] = qb0[5];
                sb[5120 + (bn0 + 6) * 40 + kr] = qb0[6];
                sb[5120 + (bn0 + 7) * 40 + kr] = qb0[7];
                Barrier.shared();
                ks0 = ks1;
                ks1 = ks2;
                ks2 = kn;
                k0 = k0 + 32;
                if (k0 < kFull) {
                    uint32 kn = ks2 + 32;
                    if (kn >= kFull) { kn = 0; }
                    if (k0 + 96 >= kFull) { kn = ks0; }
                    qa0 = a.vload<8>((m0 + ar0) * k + kn + ac0); qa1 = a.vload<8>((m0 + ar1) * k + kn + ac0);
                    mb0.load(sb, 5120 + (wn * 64 + 0) * 40 + 0 * 16, 1, 40);
                    mb1.load(sb, 5120 + (wn * 64 + 16) * 40 + 0 * 16, 1, 40);
                    mb2.load(sb, 5120 + (wn * 64 + 32) * 40 + 0 * 16, 1, 40);
                    mb3.load(sb, 5120 + (wn * 64 + 48) * 40 + 0 * 16, 1, 40);
                    ma.load(sa, 10240 + (wm * 32 + 0) * 40 + 0 * 16, 0, 40);
                    a00.mma(ma, mb0);
                    a01.mma(ma, mb1);
                    a02.mma(ma, mb2);
                    a03.mma(ma, mb3);
                    ma.load(sa, 10240 + (wm * 32 + 16) * 40 + 0 * 16, 0, 40);
                    a10.mma(ma, mb0);
                    a11.mma(ma, mb1);
                    a12.mma(ma, mb2);
                    a13.mma(ma, mb3);
                    qb0 = b.vload<8>((kn + kr) * n + n0 + bn0);
                    mb0.load(sb, 5120 + (wn * 64 + 0) * 40 + 1 * 16, 1, 40);
                    mb1.load(sb, 5120 + (wn * 64 + 16) * 40 + 1 * 16, 1, 40);
                    mb2.load(sb, 5120 + (wn * 64 + 32) * 40 + 1 * 16, 1, 40);
                    mb3.load(sb, 5120 + (wn * 64 + 48) * 40 + 1 * 16, 1, 40);
                    ma.load(sa, 10240 + (wm * 32 + 0) * 40 + 1 * 16, 0, 40);
                    a00.mma(ma, mb0);
                    a01.mma(ma, mb1);
                    a02.mma(ma, mb2);
                    a03.mma(ma, mb3);
                    ma.load(sa, 10240 + (wm * 32 + 16) * 40 + 1 * 16, 0, 40);
