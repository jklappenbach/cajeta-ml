package dev.cajeta.ml.kernels;

import cajeta.xpu.Barrier;
import cajeta.xpu.Device;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelFacts;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Wave;
import cajeta.xpu.Workgroup;
import cajeta.lang.String;
import cajeta.time.Clock;
import cajeta.xpu.ShapeFilter;
import cajeta.xpu.ShapeProbe;
import dev.cajeta.ml.kernels.tune.TileFamily;
import dev.cajeta.ml.kernels.tune.TileShape;

/**
 * GEMM at f16, bf16 and f32 into float32, int8 into int32, and the plain f32 tile at E (spec §5.1): C[m][n] = A[m][k] . B[k][n], all row-major,
 * through the device's matrix cores (the portable software tile where it has none). The
 * 16x16 member stages each K-slab of A and B through zero-filled shared tiles, so a shape
 * that is no multiple of the tile runs; the torch-recipe tile (amdgpu) and llm's X3 shape
 * join the family when they are measured. A native matrix core accumulates in its own order
 * and precision: within 1e-5 relative plus K x 1e-7 absolute of a sequential float32 sum
 * (bit-exact on the portable tile).
 */
public final class Gemm {
    public Gemm() { return; }

    /** Workgroup (mi, nj): one 16x16 tile of C, the K loop staged through shared memory. */
    @Kernel
    public static void gemm16<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                E va = (E) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /**
     * The 128x128 member: workgroup (mi, nj) owns a 128x128 tile of C, eight waves of 32
     * each a 32x64 sub-tile (2x4 fragments). K goes in slabs of 64 staged through shared
     * tiles padded to a row stride of 72 (A) and 136 (B), so fragment rows start on distinct
     * banks. A tile wholly inside A and B, with k and n multiples of 8, runs its whole slabs
     * on 8-wide loads, the next slab loaded into registers while the current one multiplies;
     * a ragged K tail and every edge tile stage through zero fill. B's four fragments load
     * once per K step and serve both A rows. An interior tile stores its fragments straight
     * to C; an edge tile, or an n the matrix core cannot store at, goes through each wave's
     * 16x16 scratch and writes only what is in range. The fragments are named rather than
     * arrays so the tier scan sees them: on a backend with no native bf16 (RADV) the whole
     * kernel then demotes to the software tile, as gemm16 does, instead of refusing.
     */
    @Kernel @Wave(width = 32)
    @Occupancy(maxThreads = 256)
    public static void gemm128<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[9216];
        Shared<E> sb = shared E[8704];
        Shared<float32> sc = shared float32[2048];
        uint32 t = KernelThread.x();
        uint32 wave = t / 32;
        uint32 lane = t - wave * 32;
        uint32 wm = wave % 4;
        uint32 wn = wave / 4;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb0;
        CooperativeMatrix<E,16,16,1> mb1;
        CooperativeMatrix<E,16,16,1> mb2;
        CooperativeMatrix<E,16,16,1> mb3;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 8) == 0 && (n % 8) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 64) * 64; }
        uint32 ar0 = t / 8 + 0;
        uint32 ar1 = t / 8 + 32;
        uint32 ar2 = t / 8 + 64;
        uint32 ar3 = t / 8 + 96;
        uint32 ac0 = (t % 8) * 8;
        uint32 br0 = t / 16 + 0;
        uint32 br1 = t / 16 + 16;
        uint32 br2 = t / 16 + 32;
        uint32 br3 = t / 16 + 48;
        uint32 bc0 = (t % 16) * 8;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<E,8> pa0 = a.vload<8>((m0 + ar0) * k + ac0);
            Vector<E,8> pa1 = a.vload<8>((m0 + ar1) * k + ac0);
            Vector<E,8> pa2 = a.vload<8>((m0 + ar2) * k + ac0);
            Vector<E,8> pa3 = a.vload<8>((m0 + ar3) * k + ac0);
            Vector<E,8> pb0 = b.vload<8>(br0 * n + n0 + bc0);
            Vector<E,8> pb1 = b.vload<8>(br1 * n + n0 + bc0);
            Vector<E,8> pb2 = b.vload<8>(br2 * n + n0 + bc0);
            Vector<E,8> pb3 = b.vload<8>(br3 * n + n0 + bc0);
            sa.vstore(ar0 * 72 + ac0, pa0);
            sa.vstore(ar1 * 72 + ac0, pa1);
            sa.vstore(ar2 * 72 + ac0, pa2);
            sa.vstore(ar3 * 72 + ac0, pa3);
            sb.vstore(br0 * 136 + bc0, pb0);
            sb.vstore(br1 * 136 + bc0, pb1);
            sb.vstore(br2 * 136 + bc0, pb2);
            sb.vstore(br3 * 136 + bc0, pb3);
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 64;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<8>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<8>((m0 + ar1) * k + next + ac0);
                    pa2 = a.vload<8>((m0 + ar2) * k + next + ac0);
                    pa3 = a.vload<8>((m0 + ar3) * k + next + ac0);
                    pb0 = b.vload<8>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<8>((next + br1) * n + n0 + bc0);
                    pb2 = b.vload<8>((next + br2) * n + n0 + bc0);
                    pb3 = b.vload<8>((next + br3) * n + n0 + bc0);
                }
                for (uint32 ks = 0; ks < 4; ks = ks + 1) {
                    mb0.load(sb, ks * 16 * 136 + wn * 64 + 0, 0, 136);
                    mb1.load(sb, ks * 16 * 136 + wn * 64 + 16, 0, 136);
                    mb2.load(sb, ks * 16 * 136 + wn * 64 + 32, 0, 136);
                    mb3.load(sb, ks * 16 * 136 + wn * 64 + 48, 0, 136);
                    ma.load(sa, (wm * 32 + 0) * 72 + ks * 16, 0, 72);
                    a00.mma(ma, mb0);
                    a01.mma(ma, mb1);
                    a02.mma(ma, mb2);
                    a03.mma(ma, mb3);
                    ma.load(sa, (wm * 32 + 16) * 72 + ks * 16, 0, 72);
                    a10.mma(ma, mb0);
                    a11.mma(ma, mb1);
                    a12.mma(ma, mb2);
                    a13.mma(ma, mb3);
                }

                Barrier.workgroup();
                if (more) {
                    sa.vstore(ar0 * 72 + ac0, pa0);
                    sa.vstore(ar1 * 72 + ac0, pa1);
                    sa.vstore(ar2 * 72 + ac0, pa2);
                    sa.vstore(ar3 * 72 + ac0, pa3);
                    sb.vstore(br0 * 136 + bc0, pb0);
                    sb.vstore(br1 * 136 + bc0, pb1);
                    sb.vstore(br2 * 136 + bc0, pb2);
                    sb.vstore(br3 * 136 + bc0, pb3);
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 8192) {
                uint32 r = idx / 64;
                uint32 cc = idx - r * 64;
                uint32 gm = m0 + r;
                uint32 gk = k0 + cc;
                E va = (E) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[r * 72 + cc] = va;
                uint32 rb = idx / 128;
                uint32 cb = idx - rb * 128;
                uint32 gk2 = k0 + rb;
                uint32 gn = n0 + cb;
                E vb = (E) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[rb * 136 + cb] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            for (uint32 ks = 0; ks < 4; ks = ks + 1) {
                mb0.load(sb, ks * 16 * 136 + wn * 64 + 0, 0, 136);
                mb1.load(sb, ks * 16 * 136 + wn * 64 + 16, 0, 136);
                mb2.load(sb, ks * 16 * 136 + wn * 64 + 32, 0, 136);
                mb3.load(sb, ks * 16 * 136 + wn * 64 + 48, 0, 136);
                ma.load(sa, (wm * 32 + 0) * 72 + ks * 16, 0, 72);
                a00.mma(ma, mb0);
                a01.mma(ma, mb1);
                a02.mma(ma, mb2);
                a03.mma(ma, mb3);
                ma.load(sa, (wm * 32 + 16) * 72 + ks * 16, 0, 72);
                a10.mma(ma, mb0);
                a11.mma(ma, mb1);
                a12.mma(ma, mb2);
                a13.mma(ma, mb3);
            }

            Barrier.workgroup();
            k0 = k0 + 64;
        }
        boolean interior = m0 + 128 <= m && n0 + 128 <= n && (n % 8) == 0;
        if (interior) {
            a00.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 0, 0, n);
            a01.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 16, 0, n);
            a02.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 32, 0, n);
            a03.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 48, 0, n);
            a10.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 0, 0, n);
            a11.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 16, 0, n);
            a12.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 32, 0, n);
            a13.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 48, 0, n);
        } else {
            a00.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r00 = m0 + wm * 32 + 0;
            uint32 c00 = n0 + wn * 64 + 0;
            uint32 e00 = lane;
            while (e00 < 256) {
                uint32 er = e00 / 16;
                uint32 ec = e00 - er * 16;
                if (r00 + er < m && c00 + ec < n) { c[(r00 + er) * n + c00 + ec] = sc[wave * 256 + e00]; }
                e00 = e00 + 32;
            }
            Barrier.workgroup();
            a01.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r01 = m0 + wm * 32 + 0;
            uint32 c01 = n0 + wn * 64 + 16;
            uint32 e01 = lane;
            while (e01 < 256) {
                uint32 er = e01 / 16;
                uint32 ec = e01 - er * 16;
                if (r01 + er < m && c01 + ec < n) { c[(r01 + er) * n + c01 + ec] = sc[wave * 256 + e01]; }
                e01 = e01 + 32;
            }
            Barrier.workgroup();
            a02.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r02 = m0 + wm * 32 + 0;
            uint32 c02 = n0 + wn * 64 + 32;
            uint32 e02 = lane;
            while (e02 < 256) {
                uint32 er = e02 / 16;
                uint32 ec = e02 - er * 16;
                if (r02 + er < m && c02 + ec < n) { c[(r02 + er) * n + c02 + ec] = sc[wave * 256 + e02]; }
                e02 = e02 + 32;
            }
            Barrier.workgroup();
            a03.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r03 = m0 + wm * 32 + 0;
            uint32 c03 = n0 + wn * 64 + 48;
            uint32 e03 = lane;
            while (e03 < 256) {
                uint32 er = e03 / 16;
                uint32 ec = e03 - er * 16;
                if (r03 + er < m && c03 + ec < n) { c[(r03 + er) * n + c03 + ec] = sc[wave * 256 + e03]; }
                e03 = e03 + 32;
            }
            Barrier.workgroup();
            a10.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r10 = m0 + wm * 32 + 16;
            uint32 c10 = n0 + wn * 64 + 0;
            uint32 e10 = lane;
            while (e10 < 256) {
                uint32 er = e10 / 16;
                uint32 ec = e10 - er * 16;
                if (r10 + er < m && c10 + ec < n) { c[(r10 + er) * n + c10 + ec] = sc[wave * 256 + e10]; }
                e10 = e10 + 32;
            }
            Barrier.workgroup();
            a11.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r11 = m0 + wm * 32 + 16;
            uint32 c11 = n0 + wn * 64 + 16;
            uint32 e11 = lane;
            while (e11 < 256) {
                uint32 er = e11 / 16;
                uint32 ec = e11 - er * 16;
                if (r11 + er < m && c11 + ec < n) { c[(r11 + er) * n + c11 + ec] = sc[wave * 256 + e11]; }
                e11 = e11 + 32;
            }
            Barrier.workgroup();
            a12.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r12 = m0 + wm * 32 + 16;
            uint32 c12 = n0 + wn * 64 + 32;
            uint32 e12 = lane;
            while (e12 < 256) {
                uint32 er = e12 / 16;
                uint32 ec = e12 - er * 16;
                if (r12 + er < m && c12 + ec < n) { c[(r12 + er) * n + c12 + ec] = sc[wave * 256 + e12]; }
                e12 = e12 + 32;
            }
            Barrier.workgroup();
            a13.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r13 = m0 + wm * 32 + 16;
            uint32 c13 = n0 + wn * 64 + 48;
            uint32 e13 = lane;
            while (e13 < 256) {
                uint32 er = e13 / 16;
                uint32 ec = e13 - er * 16;
                if (r13 + er < m && c13 + ec < n) { c[(r13 + er) * n + c13 + ec] = sc[wave * 256 + e13]; }
                e13 = e13 + 32;
            }
            Barrier.workgroup();
        }
    }

    /** `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at E through the 128x128 member; queued on the current stream. For float16; bfloat16 goes through runBf16. */
    public static void run128<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemm128.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /**
     * gemm128 at bfloat16, as its own kernel so it can leave vulkan out: SPIR-V has no native
     * bf16 cooperative matrix here, and the whole tile on the software path is a 15-minute
     * compile at -O3 and a slow kernel. Gemm.runBf16 takes gemmWide there instead.
     */
    @Kernel(targets = {"cpu", "nvptx", "amdgpu"}) @Wave(width = 32)
    @Occupancy(maxThreads = 256)
    public static void gemm128Bf16(KernelBuffer<float32> c, KernelBuffer<bfloat16> a, KernelBuffer<bfloat16> b, uint32 m, uint32 n, uint32 k) {
        Shared<bfloat16> sa = shared bfloat16[9216];
        Shared<bfloat16> sb = shared bfloat16[8704];
        Shared<float32> sc = shared float32[2048];
        uint32 t = KernelThread.x();
        uint32 wave = t / 32;
        uint32 lane = t - wave * 32;
        uint32 wm = wave % 4;
        uint32 wn = wave / 4;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<bfloat16,16,16,0> ma;
        CooperativeMatrix<bfloat16,16,16,1> mb0;
        CooperativeMatrix<bfloat16,16,16,1> mb1;
        CooperativeMatrix<bfloat16,16,16,1> mb2;
        CooperativeMatrix<bfloat16,16,16,1> mb3;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 8) == 0 && (n % 8) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 64) * 64; }
        uint32 ar0 = t / 8 + 0;
        uint32 ar1 = t / 8 + 32;
        uint32 ar2 = t / 8 + 64;
        uint32 ar3 = t / 8 + 96;
        uint32 ac0 = (t % 8) * 8;
        uint32 br0 = t / 16 + 0;
        uint32 br1 = t / 16 + 16;
        uint32 br2 = t / 16 + 32;
        uint32 br3 = t / 16 + 48;
        uint32 bc0 = (t % 16) * 8;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<bfloat16,8> pa0 = a.vload<8>((m0 + ar0) * k + ac0);
            Vector<bfloat16,8> pa1 = a.vload<8>((m0 + ar1) * k + ac0);
            Vector<bfloat16,8> pa2 = a.vload<8>((m0 + ar2) * k + ac0);
            Vector<bfloat16,8> pa3 = a.vload<8>((m0 + ar3) * k + ac0);
            Vector<bfloat16,8> pb0 = b.vload<8>(br0 * n + n0 + bc0);
            Vector<bfloat16,8> pb1 = b.vload<8>(br1 * n + n0 + bc0);
            Vector<bfloat16,8> pb2 = b.vload<8>(br2 * n + n0 + bc0);
            Vector<bfloat16,8> pb3 = b.vload<8>(br3 * n + n0 + bc0);
            sa.vstore(ar0 * 72 + ac0, pa0);
            sa.vstore(ar1 * 72 + ac0, pa1);
            sa.vstore(ar2 * 72 + ac0, pa2);
            sa.vstore(ar3 * 72 + ac0, pa3);
            sb.vstore(br0 * 136 + bc0, pb0);
            sb.vstore(br1 * 136 + bc0, pb1);
            sb.vstore(br2 * 136 + bc0, pb2);
            sb.vstore(br3 * 136 + bc0, pb3);
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 64;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<8>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<8>((m0 + ar1) * k + next + ac0);
                    pa2 = a.vload<8>((m0 + ar2) * k + next + ac0);
                    pa3 = a.vload<8>((m0 + ar3) * k + next + ac0);
                    pb0 = b.vload<8>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<8>((next + br1) * n + n0 + bc0);
                    pb2 = b.vload<8>((next + br2) * n + n0 + bc0);
                    pb3 = b.vload<8>((next + br3) * n + n0 + bc0);
                }
                for (uint32 ks = 0; ks < 4; ks = ks + 1) {
                    mb0.load(sb, ks * 16 * 136 + wn * 64 + 0, 0, 136);
                    mb1.load(sb, ks * 16 * 136 + wn * 64 + 16, 0, 136);
                    mb2.load(sb, ks * 16 * 136 + wn * 64 + 32, 0, 136);
                    mb3.load(sb, ks * 16 * 136 + wn * 64 + 48, 0, 136);
                    ma.load(sa, (wm * 32 + 0) * 72 + ks * 16, 0, 72);
                    a00.mma(ma, mb0);
                    a01.mma(ma, mb1);
                    a02.mma(ma, mb2);
                    a03.mma(ma, mb3);
                    ma.load(sa, (wm * 32 + 16) * 72 + ks * 16, 0, 72);
                    a10.mma(ma, mb0);
                    a11.mma(ma, mb1);
                    a12.mma(ma, mb2);
                    a13.mma(ma, mb3);
                }

                Barrier.workgroup();
                if (more) {
                    sa.vstore(ar0 * 72 + ac0, pa0);
                    sa.vstore(ar1 * 72 + ac0, pa1);
                    sa.vstore(ar2 * 72 + ac0, pa2);
                    sa.vstore(ar3 * 72 + ac0, pa3);
                    sb.vstore(br0 * 136 + bc0, pb0);
                    sb.vstore(br1 * 136 + bc0, pb1);
                    sb.vstore(br2 * 136 + bc0, pb2);
                    sb.vstore(br3 * 136 + bc0, pb3);
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 8192) {
                uint32 r = idx / 64;
                uint32 cc = idx - r * 64;
                uint32 gm = m0 + r;
                uint32 gk = k0 + cc;
                bfloat16 va = (bfloat16) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[r * 72 + cc] = va;
                uint32 rb = idx / 128;
                uint32 cb = idx - rb * 128;
                uint32 gk2 = k0 + rb;
                uint32 gn = n0 + cb;
                bfloat16 vb = (bfloat16) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[rb * 136 + cb] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            for (uint32 ks = 0; ks < 4; ks = ks + 1) {
                mb0.load(sb, ks * 16 * 136 + wn * 64 + 0, 0, 136);
                mb1.load(sb, ks * 16 * 136 + wn * 64 + 16, 0, 136);
                mb2.load(sb, ks * 16 * 136 + wn * 64 + 32, 0, 136);
                mb3.load(sb, ks * 16 * 136 + wn * 64 + 48, 0, 136);
                ma.load(sa, (wm * 32 + 0) * 72 + ks * 16, 0, 72);
                a00.mma(ma, mb0);
                a01.mma(ma, mb1);
                a02.mma(ma, mb2);
                a03.mma(ma, mb3);
                ma.load(sa, (wm * 32 + 16) * 72 + ks * 16, 0, 72);
                a10.mma(ma, mb0);
                a11.mma(ma, mb1);
                a12.mma(ma, mb2);
                a13.mma(ma, mb3);
            }

            Barrier.workgroup();
            k0 = k0 + 64;
        }
        boolean interior = m0 + 128 <= m && n0 + 128 <= n && (n % 8) == 0;
        if (interior) {
            a00.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 0, 0, n);
            a01.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 16, 0, n);
            a02.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 32, 0, n);
            a03.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 48, 0, n);
            a10.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 0, 0, n);
            a11.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 16, 0, n);
            a12.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 32, 0, n);
            a13.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 48, 0, n);
        } else {
            a00.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r00 = m0 + wm * 32 + 0;
            uint32 c00 = n0 + wn * 64 + 0;
            uint32 e00 = lane;
            while (e00 < 256) {
                uint32 er = e00 / 16;
                uint32 ec = e00 - er * 16;
                if (r00 + er < m && c00 + ec < n) { c[(r00 + er) * n + c00 + ec] = sc[wave * 256 + e00]; }
                e00 = e00 + 32;
            }
            Barrier.workgroup();
            a01.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r01 = m0 + wm * 32 + 0;
            uint32 c01 = n0 + wn * 64 + 16;
            uint32 e01 = lane;
            while (e01 < 256) {
                uint32 er = e01 / 16;
                uint32 ec = e01 - er * 16;
                if (r01 + er < m && c01 + ec < n) { c[(r01 + er) * n + c01 + ec] = sc[wave * 256 + e01]; }
                e01 = e01 + 32;
            }
            Barrier.workgroup();
            a02.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r02 = m0 + wm * 32 + 0;
            uint32 c02 = n0 + wn * 64 + 32;
            uint32 e02 = lane;
            while (e02 < 256) {
                uint32 er = e02 / 16;
                uint32 ec = e02 - er * 16;
                if (r02 + er < m && c02 + ec < n) { c[(r02 + er) * n + c02 + ec] = sc[wave * 256 + e02]; }
                e02 = e02 + 32;
            }
            Barrier.workgroup();
            a03.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r03 = m0 + wm * 32 + 0;
            uint32 c03 = n0 + wn * 64 + 48;
            uint32 e03 = lane;
            while (e03 < 256) {
                uint32 er = e03 / 16;
                uint32 ec = e03 - er * 16;
                if (r03 + er < m && c03 + ec < n) { c[(r03 + er) * n + c03 + ec] = sc[wave * 256 + e03]; }
                e03 = e03 + 32;
            }
            Barrier.workgroup();
            a10.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r10 = m0 + wm * 32 + 16;
            uint32 c10 = n0 + wn * 64 + 0;
            uint32 e10 = lane;
            while (e10 < 256) {
                uint32 er = e10 / 16;
                uint32 ec = e10 - er * 16;
                if (r10 + er < m && c10 + ec < n) { c[(r10 + er) * n + c10 + ec] = sc[wave * 256 + e10]; }
                e10 = e10 + 32;
            }
            Barrier.workgroup();
            a11.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r11 = m0 + wm * 32 + 16;
            uint32 c11 = n0 + wn * 64 + 16;
            uint32 e11 = lane;
            while (e11 < 256) {
                uint32 er = e11 / 16;
                uint32 ec = e11 - er * 16;
                if (r11 + er < m && c11 + ec < n) { c[(r11 + er) * n + c11 + ec] = sc[wave * 256 + e11]; }
                e11 = e11 + 32;
            }
            Barrier.workgroup();
            a12.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r12 = m0 + wm * 32 + 16;
            uint32 c12 = n0 + wn * 64 + 32;
            uint32 e12 = lane;
            while (e12 < 256) {
                uint32 er = e12 / 16;
                uint32 ec = e12 - er * 16;
                if (r12 + er < m && c12 + ec < n) { c[(r12 + er) * n + c12 + ec] = sc[wave * 256 + e12]; }
                e12 = e12 + 32;
            }
            Barrier.workgroup();
            a13.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r13 = m0 + wm * 32 + 16;
            uint32 c13 = n0 + wn * 64 + 48;
            uint32 e13 = lane;
            while (e13 < 256) {
                uint32 er = e13 / 16;
                uint32 ec = e13 - er * 16;
                if (r13 + er < m && c13 + ec < n) { c[(r13 + er) * n + c13 + ec] = sc[wave * 256 + e13]; }
                e13 = e13 + 32;
            }
            Barrier.workgroup();
        }
    }

    /** gemmTiled128 with a float32 result: E operands widened to float32 as they stage (exact
     *  for bf16 and f16), accumulated with fused multiply-adds. The bf16 GEMM on a backend with
     *  no native bf16 tile. */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmWide<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[2112];
        Shared<float32> sb = shared float32[2112];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c04 = 0.0f;
        float32 c05 = 0.0f;
        float32 c06 = 0.0f;
        float32 c07 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c14 = 0.0f;
        float32 c15 = 0.0f;
        float32 c16 = 0.0f;
        float32 c17 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c24 = 0.0f;
        float32 c25 = 0.0f;
        float32 c26 = 0.0f;
        float32 c27 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        float32 c34 = 0.0f;
        float32 c35 = 0.0f;
        float32 c36 = 0.0f;
        float32 c37 = 0.0f;
        float32 c40 = 0.0f;
        float32 c41 = 0.0f;
        float32 c42 = 0.0f;
        float32 c43 = 0.0f;
        float32 c44 = 0.0f;
        float32 c45 = 0.0f;
        float32 c46 = 0.0f;
        float32 c47 = 0.0f;
        float32 c50 = 0.0f;
        float32 c51 = 0.0f;
        float32 c52 = 0.0f;
        float32 c53 = 0.0f;
        float32 c54 = 0.0f;
        float32 c55 = 0.0f;
        float32 c56 = 0.0f;
        float32 c57 = 0.0f;
        float32 c60 = 0.0f;
        float32 c61 = 0.0f;
        float32 c62 = 0.0f;
        float32 c63 = 0.0f;
        float32 c64 = 0.0f;
        float32 c65 = 0.0f;
        float32 c66 = 0.0f;
        float32 c67 = 0.0f;
        float32 c70 = 0.0f;
        float32 c71 = 0.0f;
        float32 c72 = 0.0f;
        float32 c73 = 0.0f;
        float32 c74 = 0.0f;
        float32 c75 = 0.0f;
        float32 c76 = 0.0f;
        float32 c77 = 0.0f;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 4) == 0 && (n % 4) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 16) * 16; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 4;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 32;
        uint32 bc0 = (t - br0 * 32) * 4;
        uint32 br1 = br0 + 8;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<E,4> pa0 = a.vload<4>((m0 + ar0) * k + ac0);
            Vector<E,4> pa1 = a.vload<4>((m0 + ar1) * k + ac0);
            Vector<E,4> pb0 = b.vload<4>(br0 * n + n0 + bc0);
            Vector<E,4> pb1 = b.vload<4>(br1 * n + n0 + bc0);
            sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
            sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
            sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
            sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
            sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
            sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
            sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
            sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
            sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
            sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
            sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
            sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
            sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
            sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
            sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
            sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 16;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<4>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<4>((m0 + ar1) * k + next + ac0);
                    pb0 = b.vload<4>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<4>((next + br1) * n + n0 + bc0);
                }
                uint32 kk = 0;
                while (kk < 16) {
                    Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                    Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                    Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                    Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                    float32 a0 = av0.x;
                    float32 a1 = av0.y;
                    float32 a2 = av0.z;
                    float32 a3 = av0.w;
                    float32 a4 = av1.x;
                    float32 a5 = av1.y;
                    float32 a6 = av1.z;
                    float32 a7 = av1.w;
                    float32 b0 = bv0.x;
                    float32 b1 = bv0.y;
                    float32 b2 = bv0.z;
                    float32 b3 = bv0.w;
                    float32 b4 = bv1.x;
                    float32 b5 = bv1.y;
                    float32 b6 = bv1.z;
                    float32 b7 = bv1.w;
                    c00 = Math.fma(a0, b0, c00);
                    c01 = Math.fma(a0, b1, c01);
                    c02 = Math.fma(a0, b2, c02);
                    c03 = Math.fma(a0, b3, c03);
                    c04 = Math.fma(a0, b4, c04);
                    c05 = Math.fma(a0, b5, c05);
                    c06 = Math.fma(a0, b6, c06);
                    c07 = Math.fma(a0, b7, c07);
                    c10 = Math.fma(a1, b0, c10);
                    c11 = Math.fma(a1, b1, c11);
                    c12 = Math.fma(a1, b2, c12);
                    c13 = Math.fma(a1, b3, c13);
                    c14 = Math.fma(a1, b4, c14);
                    c15 = Math.fma(a1, b5, c15);
                    c16 = Math.fma(a1, b6, c16);
                    c17 = Math.fma(a1, b7, c17);
                    c20 = Math.fma(a2, b0, c20);
                    c21 = Math.fma(a2, b1, c21);
                    c22 = Math.fma(a2, b2, c22);
                    c23 = Math.fma(a2, b3, c23);
                    c24 = Math.fma(a2, b4, c24);
                    c25 = Math.fma(a2, b5, c25);
                    c26 = Math.fma(a2, b6, c26);
                    c27 = Math.fma(a2, b7, c27);
                    c30 = Math.fma(a3, b0, c30);
                    c31 = Math.fma(a3, b1, c31);
                    c32 = Math.fma(a3, b2, c32);
                    c33 = Math.fma(a3, b3, c33);
                    c34 = Math.fma(a3, b4, c34);
                    c35 = Math.fma(a3, b5, c35);
                    c36 = Math.fma(a3, b6, c36);
                    c37 = Math.fma(a3, b7, c37);
                    c40 = Math.fma(a4, b0, c40);
                    c41 = Math.fma(a4, b1, c41);
                    c42 = Math.fma(a4, b2, c42);
                    c43 = Math.fma(a4, b3, c43);
                    c44 = Math.fma(a4, b4, c44);
                    c45 = Math.fma(a4, b5, c45);
                    c46 = Math.fma(a4, b6, c46);
                    c47 = Math.fma(a4, b7, c47);
                    c50 = Math.fma(a5, b0, c50);
                    c51 = Math.fma(a5, b1, c51);
                    c52 = Math.fma(a5, b2, c52);
                    c53 = Math.fma(a5, b3, c53);
                    c54 = Math.fma(a5, b4, c54);
                    c55 = Math.fma(a5, b5, c55);
                    c56 = Math.fma(a5, b6, c56);
                    c57 = Math.fma(a5, b7, c57);
                    c60 = Math.fma(a6, b0, c60);
                    c61 = Math.fma(a6, b1, c61);
                    c62 = Math.fma(a6, b2, c62);
                    c63 = Math.fma(a6, b3, c63);
                    c64 = Math.fma(a6, b4, c64);
                    c65 = Math.fma(a6, b5, c65);
                    c66 = Math.fma(a6, b6, c66);
                    c67 = Math.fma(a6, b7, c67);
                    c70 = Math.fma(a7, b0, c70);
                    c71 = Math.fma(a7, b1, c71);
                    c72 = Math.fma(a7, b2, c72);
                    c73 = Math.fma(a7, b3, c73);
                    c74 = Math.fma(a7, b4, c74);
                    c75 = Math.fma(a7, b5, c75);
                    c76 = Math.fma(a7, b6, c76);
                    c77 = Math.fma(a7, b7, c77);
                    kk = kk + 1;
                }
                Barrier.workgroup();
                if (more) {
                    sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
                    sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
                    sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
                    sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
                    sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
                    sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
                    sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
                    sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
                    sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
                    sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
                    sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
                    sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
                    sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
                    sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
                    sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
                    sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 2048) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < k) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 132 + ar] = va;
                uint32 bk = idx / 128;
                uint32 bc = idx - bk * 128;
                float32 vb = 0.0f;
                if (k0 + bk < k && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 132 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                float32 a0 = av0.x;
                float32 a1 = av0.y;
                float32 a2 = av0.z;
                float32 a3 = av0.w;
                float32 a4 = av1.x;
                float32 a5 = av1.y;
                float32 a6 = av1.z;
                float32 a7 = av1.w;
                float32 b0 = bv0.x;
                float32 b1 = bv0.y;
                float32 b2 = bv0.z;
                float32 b3 = bv0.w;
                float32 b4 = bv1.x;
                float32 b5 = bv1.y;
                float32 b6 = bv1.z;
                float32 b7 = bv1.w;
                c00 = Math.fma(a0, b0, c00);
                c01 = Math.fma(a0, b1, c01);
                c02 = Math.fma(a0, b2, c02);
                c03 = Math.fma(a0, b3, c03);
                c04 = Math.fma(a0, b4, c04);
                c05 = Math.fma(a0, b5, c05);
                c06 = Math.fma(a0, b6, c06);
                c07 = Math.fma(a0, b7, c07);
                c10 = Math.fma(a1, b0, c10);
                c11 = Math.fma(a1, b1, c11);
                c12 = Math.fma(a1, b2, c12);
                c13 = Math.fma(a1, b3, c13);
                c14 = Math.fma(a1, b4, c14);
                c15 = Math.fma(a1, b5, c15);
                c16 = Math.fma(a1, b6, c16);
                c17 = Math.fma(a1, b7, c17);
                c20 = Math.fma(a2, b0, c20);
                c21 = Math.fma(a2, b1, c21);
                c22 = Math.fma(a2, b2, c22);
                c23 = Math.fma(a2, b3, c23);
                c24 = Math.fma(a2, b4, c24);
                c25 = Math.fma(a2, b5, c25);
                c26 = Math.fma(a2, b6, c26);
                c27 = Math.fma(a2, b7, c27);
                c30 = Math.fma(a3, b0, c30);
                c31 = Math.fma(a3, b1, c31);
                c32 = Math.fma(a3, b2, c32);
                c33 = Math.fma(a3, b3, c33);
                c34 = Math.fma(a3, b4, c34);
                c35 = Math.fma(a3, b5, c35);
                c36 = Math.fma(a3, b6, c36);
                c37 = Math.fma(a3, b7, c37);
                c40 = Math.fma(a4, b0, c40);
                c41 = Math.fma(a4, b1, c41);
                c42 = Math.fma(a4, b2, c42);
                c43 = Math.fma(a4, b3, c43);
                c44 = Math.fma(a4, b4, c44);
                c45 = Math.fma(a4, b5, c45);
                c46 = Math.fma(a4, b6, c46);
                c47 = Math.fma(a4, b7, c47);
                c50 = Math.fma(a5, b0, c50);
                c51 = Math.fma(a5, b1, c51);
                c52 = Math.fma(a5, b2, c52);
                c53 = Math.fma(a5, b3, c53);
                c54 = Math.fma(a5, b4, c54);
                c55 = Math.fma(a5, b5, c55);
                c56 = Math.fma(a5, b6, c56);
