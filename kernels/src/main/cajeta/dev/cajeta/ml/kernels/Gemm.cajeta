    /** gemm256 at bfloat16, as its own kernel so it can leave vulkan out (no native bf16 cooperative matrix there). */
    @Kernel(targets = {"cpu", "nvptx", "amdgpu"}) @Wave(width = 32)
    @Occupancy(maxThreads = 512)
    public static void gemm256Bf16(KernelBuffer<float32> c, KernelBuffer<bfloat16> a, KernelBuffer<bfloat16> b, uint32 m, uint32 n, uint32 k) {
        Shared<bfloat16> sa = shared bfloat16[20480];
        Shared<bfloat16> sb = shared bfloat16[10240];
        Shared<float32> sc = shared float32[512];
        uint32 t = KernelThread.x();
        uint32 wave = t / 32;
        uint32 lane = t - wave * 32;
        uint32 wm = wave % 8;
        uint32 wn = wave / 8;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 256;
        uint32 n0 = nj * 128;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<bfloat16,16,16,0> ma;
        CooperativeMatrix<bfloat16,16,16,1> mb0;
        CooperativeMatrix<bfloat16,16,16,1> mb1;
        CooperativeMatrix<bfloat16,16,16,1> mb2;
        CooperativeMatrix<bfloat16,16,16,1> mb3;
        boolean wide = m0 + 256 <= m && n0 + 128 <= n && (k % 8) == 0 && (n % 8) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 32) * 32; }
        uint32 ac0 = (t % 4) * 8;
        uint32 ar0 = t / 4;
        uint32 ar1 = t / 4 + 128;
        uint32 kr = t % 32;
        uint32 bn0 = (t / 32) * 8;
        uint32 k0 = 0;
        uint32 ks0 = 0;
        if (kFull > 0) { ks0 = (wid * 32) % kFull; }
        if (kFull > 0) {
            uint32 ks1 = ks0 + 32;
            if (ks1 >= kFull) { ks1 = 0; }
            uint32 ks2 = ks1 + 32;
            if (ks2 >= kFull) { ks2 = 0; }
            Vector<bfloat16,8> pa0 = a.vload<8>((m0 + ar0) * k + ks0 + ac0);
            Vector<bfloat16,8> pa1 = a.vload<8>((m0 + ar1) * k + ks0 + ac0);
            Vector<bfloat16,8> pb0 = b.vload<8>((ks0 + kr) * n + n0 + bn0);
            Vector<bfloat16,8> qa0 = a.vload<8>((m0 + ar0) * k + ks1 + ac0);
            Vector<bfloat16,8> qa1 = a.vload<8>((m0 + ar1) * k + ks1 + ac0);
            Vector<bfloat16,8> qb0 = b.vload<8>((ks1 + kr) * n + n0 + bn0);
            Vector<bfloat16,8> ra0 = a.vload<8>((m0 + ar0) * k + ks2 + ac0);
            Vector<bfloat16,8> ra1 = a.vload<8>((m0 + ar1) * k + ks2 + ac0);
            Vector<bfloat16,8> rb0 = b.vload<8>((ks2 + kr) * n + n0 + bn0);
            sa.vstore(0 + ar0 * 40 + ac0, pa0);
            sa.vstore(0 + ar1 * 40 + ac0, pa1);
            sb[0 + (bn0 + 0) * 40 + kr] = pb0[0];
            sb[0 + (bn0 + 1) * 40 + kr] = pb0[1];
            sb[0 + (bn0 + 2) * 40 + kr] = pb0[2];
            sb[0 + (bn0 + 3) * 40 + kr] = pb0[3];
            sb[0 + (bn0 + 4) * 40 + kr] = pb0[4];
            sb[0 + (bn0 + 5) * 40 + kr] = pb0[5];
            sb[0 + (bn0 + 6) * 40 + kr] = pb0[6];
            sb[0 + (bn0 + 7) * 40 + kr] = pb0[7];
