    /** `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at E through the 256x128 member; queued on the current stream. For float16; bfloat16 goes through run256Bf16. */
    public static void run256<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 255) / 256) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemm256.launch(s, grid: [tiles], block: [512])(c, a, b, um, un, (uint32) k);
    }

    /** The bfloat16 form of run256. */
    public static void run256Bf16(KernelBuffer<float32> c, KernelBuffer<bfloat16> a, KernelBuffer<bfloat16> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 255) / 256) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemm256Bf16.launch(s, grid: [tiles], block: [512])(c, a, b, um, un, (uint32) k);
    }

    /** The int8 form: workgroup (mi, nj) owns one 16x16 tile of C, accumulated exactly in int32 through the integer matrix core. */
    @Kernel
    public static void gemm16I8(KernelBuffer<int32> c, KernelBuffer<int8> a, KernelBuffer<int8> b, uint32 m, uint32 n, uint32 k) {
        Shared<int8> sa = shared int8[256];
        Shared<int8> sb = shared int8[256];
        Shared<int32> sc = shared int32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        CooperativeMatrix<int32,16,16,2> mc;
        mc.splat(0);
        CooperativeMatrix<int8,16,16,0> ma;
        CooperativeMatrix<int8,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                int8 va = (int8) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                int8 vb = (int8) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** `c` (m x n, int32) = `a` (m x k) . `b` (k x n) over int8, exact; queued on the current stream. */
    public static void runI8(KernelBuffer<int32> c, KernelBuffer<int8> a, KernelBuffer<int8> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm16I8.launch(s, grid: [tiles], block: [64])(c, a, b, um, un, uk);
    }

    // Three kernels of one body: a class template over S instantiated inside the library
    // links twice in a consumer (cajeta-ml-gpu 21.2.2), while generic-method instantiations dedupe.

    /** Split-K, S = 2: workgroup (split, tile) multiplies its K range into slice `split` of `parts`. */
    @Kernel
    public static void split2<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 split = wid / tiles;
        uint32 tl = wid - split * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 kc = (((k + 2 - 1) / 2 + 15) / 16) * 16;
        uint32 kStart = split * kc;
        uint32 kEnd = kStart + kc;
        if (kEnd > k) { kEnd = k; }
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 kk = kStart;
        while (kk < kEnd) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk + cc;
                E va = (E) 0;
                if (gm < m && gk < kEnd) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < kEnd && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 16;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { parts[split * m * n + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** Split-K, S = 4: workgroup (split, tile) multiplies its K range into slice `split` of `parts`. */
    @Kernel
    public static void split4<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 split = wid / tiles;
        uint32 tl = wid - split * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 kc = (((k + 4 - 1) / 4 + 15) / 16) * 16;
        uint32 kStart = split * kc;
        uint32 kEnd = kStart + kc;
        if (kEnd > k) { kEnd = k; }
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 kk = kStart;
        while (kk < kEnd) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk + cc;
                E va = (E) 0;
                if (gm < m && gk < kEnd) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < kEnd && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 16;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { parts[split * m * n + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** Split-K, S = 8: workgroup (split, tile) multiplies its K range into slice `split` of `parts`. */
    @Kernel
    public static void split8<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 split = wid / tiles;
        uint32 tl = wid - split * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 kc = (((k + 8 - 1) / 8 + 15) / 16) * 16;
        uint32 kStart = split * kc;
        uint32 kEnd = kStart + kc;
        if (kEnd > k) { kEnd = k; }
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 kk = kStart;
        while (kk < kEnd) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk + cc;
                E va = (E) 0;
                if (gm < m && gk < kEnd) { va = a[gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < kEnd && gn < n) { vb = b[gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 16;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { parts[split * m * n + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** Lane i sums the S slices of `parts` at i in split order into c[i]. */
    @Kernel
    public static void splitFixup(KernelBuffer<float32> c, KernelBuffer<float32> parts, uint32 mn, uint32 splits) {
        uint32 i = KernelThread.globalIdX();
        if (i < mn) {
            float32 acc = 0.0f;
            uint32 s = 0;
            while (s < splits) { acc = acc + parts[s * mn + i]; s = s + 1; }
            c[i] = acc;
        }
    }

    /** The f16 GEMM split S ways over K (S in 1, 2, 4, 8), fixed up in split order; synced, since it drops device temporaries. */
    public static void splitKF16(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                                 int64 m, int64 n, int64 k, int64 splits) {
        if (splits <= 1L) { Gemm.run<float16>(c, a, b, m, n, k); return; }
        KernelBuffer<float32> parts = heap KernelBuffer<float32>((uint64) (splits * m * n));
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        if (splits == 2L) { split2.launch(s, grid: [tiles * 2], block: [64])(parts, a, b, um, un, uk); }
        else if (splits == 4L) { split4.launch(s, grid: [tiles * 4], block: [64])(parts, a, b, um, un, uk); }
        else { split8.launch(s, grid: [tiles * 8], block: [64])(parts, a, b, um, un, uk); }
        uint32 mn = (uint32) (m * n);
        splitFixup.launch(s, grid: [(mn + 255) / 256], block: [256])(c, parts, mn, (uint32) splits);
        s.sync();
    }

    static TileFamily<SplitShape> splitFam;
    static boolean splitTimed = false;

    static TileFamily<SplitShape> splitFamily() {
        if (Gemm.splitFam == null) {
            Gemm.splitFam = heap TileFamily<SplitShape>("gemm-splitk");
            Gemm.splitFam.add(#heap SplitShape(1));
            Gemm.splitFam.add(#heap SplitShape(2));
            Gemm.splitFam.add(#heap SplitShape(4));
            Gemm.splitFam.add(#heap SplitShape(8));
        }
        return Gemm.splitFam;
    }

    /** Whether the last {@link #runTunedF16} timed its members. */
    public static boolean lastChoiceTimed() { return Gemm.splitTimed; }

    /** The f16 GEMM by the split count the family chooses for this shape (timed at first use, remembered under `tuneDir`); returns the split count. */
    public static int32 runTunedF16(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                                    int64 m, int64 n, int64 k, String tuneDir) {
        TileFamily<SplitShape> f = Gemm.splitFamily();
        ShapeFilter flt #= f.filterFor(m, n, k);
        SplitProbe probe = heap SplitProbe(a, b, flt, f, m, n, k);
        int32 idx = f.chooseWith(tuneDir, flt, probe, m, n, k);
        Gemm.splitTimed = probe.timed > 0;
        int64 splits = SplitShape.splitsOf(idx);
        Gemm.splitKF16(c, a, b, m, n, k, splits);
        return (int32) splits;
    }

    static TileFamily<LargeShape> largeF16Fam;
    static TileFamily<LargeShape> largeBf16Fam;
    static boolean largeTimed = false;

    /** The large-GEMM family at f16 (`bf16` false) or bf16: the 128x128 member first, then the 256x128. */
    static TileFamily<LargeShape> largeFamily(boolean bf16) {
        if (bf16) {
            if (Gemm.largeBf16Fam == null) {
                Gemm.largeBf16Fam = heap TileFamily<LargeShape>("gemm-large-bf16");
                Gemm.largeBf16Fam.add(#heap LargeShape("gemm128Bf16", 128, 256));
                Gemm.largeBf16Fam.add(#heap LargeShape("gemm256Bf16", 256, 512));
            }
            return Gemm.largeBf16Fam;
        }
        if (Gemm.largeF16Fam == null) {
            Gemm.largeF16Fam = heap TileFamily<LargeShape>("gemm-large-f16");
            Gemm.largeF16Fam.add(#heap LargeShape("gemm128_float16", 128, 256));
            Gemm.largeF16Fam.add(#heap LargeShape("gemm256_float16", 256, 512));
        }
        return Gemm.largeF16Fam;
    }

    /** How many large-GEMM members at f16 (`bf16` false) or bf16 survive the feasibility filter here at m x n x k (0 where none has device code); one survivor runs untimed. */
    public static int32 largeSurvivors(boolean bf16, int64 m, int64 n, int64 k) {
        TileFamily<LargeShape> f = Gemm.largeFamily(bf16);
        if (!f.serves(m, n, k)) { return 0; }
        ShapeFilter flt #= f.filterFor(m, n, k);
        return flt.survivorCount();
    }

    /** Whether the last {@link #runTuned} or {@link #runTunedBf16} timed its members. */
    public static boolean lastLargeTimed() { return Gemm.largeTimed; }

    /** The f16 GEMM by the member the large family chooses for this device and shape (timed at first use, remembered under `tuneDir`; the 128x128 member when untimed); returns the member's kernel. */
    public static #String runTuned(KernelBuffer<float32> c, KernelBuffer<float16> a, KernelBuffer<float16> b,
                                   int64 m, int64 n, int64 k, String tuneDir) {
        TileFamily<LargeShape> f = Gemm.largeFamily(false);
        ShapeFilter flt #= f.filterFor(m, n, k);
        LargeProbeF16 probe = heap LargeProbeF16(a, b, flt, f, m, n, k);
        int32 idx = f.chooseWith(tuneDir, flt, probe, m, n, k);
        Gemm.largeTimed = probe.timed > 0;
        if (idx == 1) { Gemm.run256<float16>(c, a, b, m, n, k); } else { Gemm.run128<float16>(c, a, b, m, n, k); }
        return f.lastKernel();
    }

    /** The bf16 form of runTuned; where neither member has device code (vulkan) it runs the wide tile and returns its kernel. */
    public static #String runTunedBf16(KernelBuffer<float32> c, KernelBuffer<bfloat16> a, KernelBuffer<bfloat16> b,
                                       int64 m, int64 n, int64 k, String tuneDir) {
        TileFamily<LargeShape> f = Gemm.largeFamily(true);
        if (!f.serves(m, n, k)) {
            Gemm.largeTimed = false;
            Gemm.wide<bfloat16>(c, a, b, m, n, k);
            String w #= Gemm.wideMember();
            return #w;
        }
        ShapeFilter flt #= f.filterFor(m, n, k);
        LargeProbeBf16 probe = heap LargeProbeBf16(a, b, flt, f, m, n, k);
        int32 idx = f.chooseWith(tuneDir, flt, probe, m, n, k);
        Gemm.largeTimed = probe.timed > 0;
        if (idx == 1) { Gemm.run256Bf16(c, a, b, m, n, k); } else { Gemm.runBf16(c, a, b, m, n, k); }
        return f.lastKernel();
    }

    /** Batch b of `batch` independent products in one launch: workgroup (b, tile). */
    @Kernel
    public static void gemm16Batched<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<E> sa = shared E[256];
        Shared<E> sb = shared E[256];
        Shared<float32> sc = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = ((m + 15) / 16) * ntiles;
        uint32 wid = Workgroup.x();
        uint32 bi = wid / tiles;
        uint32 tl = wid - bi * tiles;
        uint32 mi = tl / ntiles;
        uint32 nj = tl - mi * ntiles;
        uint32 aBase = bi * m * k;
        uint32 bBase = bi * k * n;
        uint32 cBase = bi * m * n;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<E,16,16,0> ma;
        CooperativeMatrix<E,16,16,1> mb;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 idx = t;
            while (idx < 256) {
                uint32 r = idx / 16;
                uint32 cc = idx - r * 16;
                uint32 gm = mi * 16 + r;
                uint32 gk = kk * 16 + cc;
                E va = (E) 0;
                if (gm < m && gk < k) { va = a[aBase + gm * k + gk]; }
                sa[idx] = va;
                uint32 gk2 = kk * 16 + r;
                uint32 gn = nj * 16 + cc;
                E vb = (E) 0;
                if (gk2 < k && gn < n) { vb = b[bBase + gk2 * n + gn]; }
                sb[idx] = vb;
                idx = idx + Workgroup.dimX();
            }
            Barrier.workgroup();
            ma.load(sa, 0, 0, 16);
            mb.load(sb, 0, 0, 16);
            mc.mma(ma, mb);
            Barrier.workgroup();
            kk = kk + 1;
        }
        mc.store(sc, 0, 0, 16);
        Barrier.workgroup();
        uint32 o = t;
        while (o < 256) {
            uint32 orow = o / 16;
            uint32 ocol = o - orow * 16;
            uint32 gm = mi * 16 + orow;
            uint32 gn = nj * 16 + ocol;
            if (gm < m && gn < n) { c[cBase + gm * n + gn] = sc[o]; }
            o = o + Workgroup.dimX();
        }
    }

    /** `batch` independent m x k by k x n products, operands and results stacked, in one launch; queued on the current stream. */
    public static void batched<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k, int64 batch) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm16Batched.launch(s, grid: [tiles * (uint32) batch], block: [64])(c, a, b, um, un, (uint32) k);
    }

    /** Workgroup (mi, nj): one 16x16 tile of C at E, each lane one element, the K loop staged
     *  through float32 shared tiles and summed in k order, so it matches a sequential float32 sum. */
    @Kernel
    public static void gemmTiled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[256];
        Shared<float32> sb = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 r = t / 16;
        uint32 cc = t - r * 16;
        uint32 ntiles = (n + 15) / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 gm = mi * 16 + r;
        uint32 gn = nj * 16 + cc;
        float32 acc = 0.0f;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 gk = kk * 16 + cc;
            float32 va = 0.0f;
            if (gm < m && gk < k) { va = (float32) a[gm * k + gk]; }
            sa[t] = va;
            uint32 gk2 = kk * 16 + r;
            float32 vb = 0.0f;
            if (gk2 < k && gn < n) { vb = (float32) b[gk2 * n + gn]; }
            sb[t] = vb;
            Barrier.workgroup();
            uint32 p = 0;
            while (p < 16) {
                acc = acc + sa[r * 16 + p] * sb[p * 16 + cc];
                p = p + 1;
            }
            Barrier.workgroup();
            kk = kk + 1;
        }
        if (gm < m && gn < n) { c[gm * n + gn] = (E) acc; }
    }

    /**
     * The register-blocked plain tile: workgroup (mi, nj) owns a 64x64 tile of C at E, each
     * of 256 lanes a 4x4 block strided by 16 so a wave reads consecutive shared words. K goes
     * in slabs of 16 through float32 shared tiles (A stored k-major), and every output is
     * summed in k order, so it matches a sequential float32 sum as gemmTiled does.
     */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmTiled64<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[1088];
        Shared<float32> sb = shared float32[1088];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 63) / 64;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 64;
        uint32 n0 = nj * 64;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        uint32 k0 = 0;
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 1024) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < k) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 68 + ar] = va;
                uint32 bk = idx / 64;
                uint32 bc = idx - bk * 64;
                float32 vb = 0.0f;
                if (k0 + bk < k && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 68 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                float32 a0 = sa[kk * 68 + ty];
                float32 a1 = sa[kk * 68 + ty + 16];
                float32 a2 = sa[kk * 68 + ty + 32];
                float32 a3 = sa[kk * 68 + ty + 48];
                float32 b0 = sb[kk * 68 + tx];
                float32 b1 = sb[kk * 68 + tx + 16];
                float32 b2 = sb[kk * 68 + tx + 32];
                float32 b3 = sb[kk * 68 + tx + 48];
                c00 = c00 + a0 * b0;
                c01 = c01 + a0 * b1;
                c02 = c02 + a0 * b2;
                c03 = c03 + a0 * b3;
                c10 = c10 + a1 * b0;
                c11 = c11 + a1 * b1;
                c12 = c12 + a1 * b2;
                c13 = c13 + a1 * b3;
                c20 = c20 + a2 * b0;
                c21 = c21 + a2 * b1;
                c22 = c22 + a2 * b2;
                c23 = c23 + a2 * b3;
                c30 = c30 + a3 * b0;
                c31 = c31 + a3 * b1;
                c32 = c32 + a3 * b2;
                c33 = c33 + a3 * b3;
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty;
        uint32 r1 = r0 + 16;
        uint32 r2 = r0 + 32;
        uint32 r3 = r0 + 48;
        uint32 q0 = n0 + tx;
        uint32 q1 = q0 + 16;
        uint32 q2 = q0 + 32;
        uint32 q3 = q0 + 48;
        if (r0 < m && q0 < n) { c[r0 * n + q0] = (E) c00; }
        if (r0 < m && q1 < n) { c[r0 * n + q1] = (E) c01; }
        if (r0 < m && q2 < n) { c[r0 * n + q2] = (E) c02; }
        if (r0 < m && q3 < n) { c[r0 * n + q3] = (E) c03; }
        if (r1 < m && q0 < n) { c[r1 * n + q0] = (E) c10; }
        if (r1 < m && q1 < n) { c[r1 * n + q1] = (E) c11; }
        if (r1 < m && q2 < n) { c[r1 * n + q2] = (E) c12; }
        if (r1 < m && q3 < n) { c[r1 * n + q3] = (E) c13; }
        if (r2 < m && q0 < n) { c[r2 * n + q0] = (E) c20; }
        if (r2 < m && q1 < n) { c[r2 * n + q1] = (E) c21; }
        if (r2 < m && q2 < n) { c[r2 * n + q2] = (E) c22; }
        if (r2 < m && q3 < n) { c[r2 * n + q3] = (E) c23; }
        if (r3 < m && q0 < n) { c[r3 * n + q0] = (E) c30; }
        if (r3 < m && q1 < n) { c[r3 * n + q1] = (E) c31; }
        if (r3 < m && q2 < n) { c[r3 * n + q2] = (E) c32; }
        if (r3 < m && q3 < n) { c[r3 * n + q3] = (E) c33; }
    }

    /** `c` (m x n) = `a` (m x k) . `b` (k x n), all at E, through the register-blocked plain tile; queued on the current stream. */
    public static void tiled64<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 63) / 64) * ((un + 63) / 64);
        KernelStream s #= KernelStream.current();
        gemmTiled64.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /**
     * The wide register-blocked plain tile: workgroup (mi, nj) owns a 128x128 tile of C at E,
     * each of 256 lanes an 8x8 block (rows ty*4 and 64 + ty*4, columns tx*4 and 64 + tx*4,
     * four each), so a K step reads its operands as four 4-wide shared loads and does 64
     * multiply-adds. K goes in slabs of 16 through float32 shared tiles, A k-major, both at
     * stride 132. A tile wholly inside A and B, with k and n multiples of 4, stages on 4-wide
     * loads with the next slab in registers while the current one multiplies; edges and a
     * ragged K tail zero-fill. Every output is accumulated in k order with a fused
     * multiply-add, one rounding per step where gemmTiled rounds the product and the sum
     * apart; that halves the arithmetic on nvptx, which does not fuse `c + a * b` on its
     * own, and stays within the GEMM tolerance of a float64 reference.
     */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmTiled128<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[2112];
        Shared<float32> sb = shared float32[2112];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c04 = 0.0f;
        float32 c05 = 0.0f;
        float32 c06 = 0.0f;
        float32 c07 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c14 = 0.0f;
        float32 c15 = 0.0f;
        float32 c16 = 0.0f;
        float32 c17 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c24 = 0.0f;
        float32 c25 = 0.0f;
        float32 c26 = 0.0f;
        float32 c27 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        float32 c34 = 0.0f;
        float32 c35 = 0.0f;
        float32 c36 = 0.0f;
        float32 c37 = 0.0f;
        float32 c40 = 0.0f;
        float32 c41 = 0.0f;
        float32 c42 = 0.0f;
        float32 c43 = 0.0f;
        float32 c44 = 0.0f;
        float32 c45 = 0.0f;
        float32 c46 = 0.0f;
        float32 c47 = 0.0f;
        float32 c50 = 0.0f;
        float32 c51 = 0.0f;
        float32 c52 = 0.0f;
        float32 c53 = 0.0f;
        float32 c54 = 0.0f;
        float32 c55 = 0.0f;
        float32 c56 = 0.0f;
        float32 c57 = 0.0f;
        float32 c60 = 0.0f;
        float32 c61 = 0.0f;
        float32 c62 = 0.0f;
        float32 c63 = 0.0f;
        float32 c64 = 0.0f;
        float32 c65 = 0.0f;
        float32 c66 = 0.0f;
        float32 c67 = 0.0f;
        float32 c70 = 0.0f;
        float32 c71 = 0.0f;
        float32 c72 = 0.0f;
        float32 c73 = 0.0f;
        float32 c74 = 0.0f;
        float32 c75 = 0.0f;
        float32 c76 = 0.0f;
        float32 c77 = 0.0f;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 4) == 0 && (n % 4) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 16) * 16; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 4;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 32;
        uint32 bc0 = (t - br0 * 32) * 4;
        uint32 br1 = br0 + 8;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<E,4> pa0 = a.vload<4>((m0 + ar0) * k + ac0);
            Vector<E,4> pa1 = a.vload<4>((m0 + ar1) * k + ac0);
            Vector<E,4> pb0 = b.vload<4>(br0 * n + n0 + bc0);
            Vector<E,4> pb1 = b.vload<4>(br1 * n + n0 + bc0);
            sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
            sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
            sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
            sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
            sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
            sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
            sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
            sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
            sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
            sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
            sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
            sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
            sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
            sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
            sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
            sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 16;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<4>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<4>((m0 + ar1) * k + next + ac0);
                    pb0 = b.vload<4>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<4>((next + br1) * n + n0 + bc0);
                }
                uint32 kk = 0;
                while (kk < 16) {
                    Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                    Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                    Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                    Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                    float32 a0 = av0.x;
                    float32 a1 = av0.y;
                    float32 a2 = av0.z;
                    float32 a3 = av0.w;
                    float32 a4 = av1.x;
                    float32 a5 = av1.y;
                    float32 a6 = av1.z;
                    float32 a7 = av1.w;
                    float32 b0 = bv0.x;
                    float32 b1 = bv0.y;
                    float32 b2 = bv0.z;
                    float32 b3 = bv0.w;
                    float32 b4 = bv1.x;
                    float32 b5 = bv1.y;
                    float32 b6 = bv1.z;
                    float32 b7 = bv1.w;
                    c00 = Math.fma(a0, b0, c00);
                    c01 = Math.fma(a0, b1, c01);
                    c02 = Math.fma(a0, b2, c02);
                    c03 = Math.fma(a0, b3, c03);
                    c04 = Math.fma(a0, b4, c04);
                    c05 = Math.fma(a0, b5, c05);
                    c06 = Math.fma(a0, b6, c06);
                    c07 = Math.fma(a0, b7, c07);
                    c10 = Math.fma(a1, b0, c10);
                    c11 = Math.fma(a1, b1, c11);
                    c12 = Math.fma(a1, b2, c12);
                    c13 = Math.fma(a1, b3, c13);
                    c14 = Math.fma(a1, b4, c14);
                    c15 = Math.fma(a1, b5, c15);
                    c16 = Math.fma(a1, b6, c16);
                    c17 = Math.fma(a1, b7, c17);
                    c20 = Math.fma(a2, b0, c20);
                    c21 = Math.fma(a2, b1, c21);
                    c22 = Math.fma(a2, b2, c22);
                    c23 = Math.fma(a2, b3, c23);
                    c24 = Math.fma(a2, b4, c24);
                    c25 = Math.fma(a2, b5, c25);
                    c26 = Math.fma(a2, b6, c26);
                    c27 = Math.fma(a2, b7, c27);
                    c30 = Math.fma(a3, b0, c30);
                    c31 = Math.fma(a3, b1, c31);
                    c32 = Math.fma(a3, b2, c32);
                    c33 = Math.fma(a3, b3, c33);
                    c34 = Math.fma(a3, b4, c34);
                    c35 = Math.fma(a3, b5, c35);
                    c36 = Math.fma(a3, b6, c36);
                    c37 = Math.fma(a3, b7, c37);
                    c40 = Math.fma(a4, b0, c40);
                    c41 = Math.fma(a4, b1, c41);
                    c42 = Math.fma(a4, b2, c42);
                    c43 = Math.fma(a4, b3, c43);
                    c44 = Math.fma(a4, b4, c44);
                    c45 = Math.fma(a4, b5, c45);
                    c46 = Math.fma(a4, b6, c46);
                    c47 = Math.fma(a4, b7, c47);
                    c50 = Math.fma(a5, b0, c50);
                    c51 = Math.fma(a5, b1, c51);
                    c52 = Math.fma(a5, b2, c52);
                    c53 = Math.fma(a5, b3, c53);
                    c54 = Math.fma(a5, b4, c54);
                    c55 = Math.fma(a5, b5, c55);
                    c56 = Math.fma(a5, b6, c56);
                    c57 = Math.fma(a5, b7, c57);
                    c60 = Math.fma(a6, b0, c60);
                    c61 = Math.fma(a6, b1, c61);
                    c62 = Math.fma(a6, b2, c62);
                    c63 = Math.fma(a6, b3, c63);
                    c64 = Math.fma(a6, b4, c64);
                    c65 = Math.fma(a6, b5, c65);
                    c66 = Math.fma(a6, b6, c66);
                    c67 = Math.fma(a6, b7, c67);
                    c70 = Math.fma(a7, b0, c70);
                    c71 = Math.fma(a7, b1, c71);
                    c72 = Math.fma(a7, b2, c72);
                    c73 = Math.fma(a7, b3, c73);
                    c74 = Math.fma(a7, b4, c74);
                    c75 = Math.fma(a7, b5, c75);
                    c76 = Math.fma(a7, b6, c76);
                    c77 = Math.fma(a7, b7, c77);
                    kk = kk + 1;
                }
                Barrier.workgroup();
                if (more) {
                    sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
                    sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
                    sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
                    sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
                    sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
                    sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
                    sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
                    sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
                    sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
                    sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
                    sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
                    sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
                    sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
                    sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
                    sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
                    sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 2048) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < k) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 132 + ar] = va;
                uint32 bk = idx / 128;
                uint32 bc = idx - bk * 128;
                float32 vb = 0.0f;
                if (k0 + bk < k && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 132 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                float32 a0 = av0.x;
                float32 a1 = av0.y;
                float32 a2 = av0.z;
                float32 a3 = av0.w;
                float32 a4 = av1.x;
                float32 a5 = av1.y;
                float32 a6 = av1.z;
                float32 a7 = av1.w;
                float32 b0 = bv0.x;
                float32 b1 = bv0.y;
                float32 b2 = bv0.z;
                float32 b3 = bv0.w;
                float32 b4 = bv1.x;
                float32 b5 = bv1.y;
                float32 b6 = bv1.z;
                float32 b7 = bv1.w;
                c00 = Math.fma(a0, b0, c00);
                c01 = Math.fma(a0, b1, c01);
                c02 = Math.fma(a0, b2, c02);
                c03 = Math.fma(a0, b3, c03);
                c04 = Math.fma(a0, b4, c04);
                c05 = Math.fma(a0, b5, c05);
                c06 = Math.fma(a0, b6, c06);
                c07 = Math.fma(a0, b7, c07);
                c10 = Math.fma(a1, b0, c10);
                c11 = Math.fma(a1, b1, c11);
                c12 = Math.fma(a1, b2, c12);
                c13 = Math.fma(a1, b3, c13);
                c14 = Math.fma(a1, b4, c14);
                c15 = Math.fma(a1, b5, c15);
                c16 = Math.fma(a1, b6, c16);
                c17 = Math.fma(a1, b7, c17);
                c20 = Math.fma(a2, b0, c20);
                c21 = Math.fma(a2, b1, c21);
                c22 = Math.fma(a2, b2, c22);
                c23 = Math.fma(a2, b3, c23);
                c24 = Math.fma(a2, b4, c24);
                c25 = Math.fma(a2, b5, c25);
                c26 = Math.fma(a2, b6, c26);
                c27 = Math.fma(a2, b7, c27);
                c30 = Math.fma(a3, b0, c30);
                c31 = Math.fma(a3, b1, c31);
                c32 = Math.fma(a3, b2, c32);
                c33 = Math.fma(a3, b3, c33);
                c34 = Math.fma(a3, b4, c34);
                c35 = Math.fma(a3, b5, c35);
                c36 = Math.fma(a3, b6, c36);
                c37 = Math.fma(a3, b7, c37);
                c40 = Math.fma(a4, b0, c40);
                c41 = Math.fma(a4, b1, c41);
                c42 = Math.fma(a4, b2, c42);
                c43 = Math.fma(a4, b3, c43);
                c44 = Math.fma(a4, b4, c44);
                c45 = Math.fma(a4, b5, c45);
                c46 = Math.fma(a4, b6, c46);
                c47 = Math.fma(a4, b7, c47);
                c50 = Math.fma(a5, b0, c50);
                c51 = Math.fma(a5, b1, c51);
                c52 = Math.fma(a5, b2, c52);
                c53 = Math.fma(a5, b3, c53);
                c54 = Math.fma(a5, b4, c54);
                c55 = Math.fma(a5, b5, c55);
                c56 = Math.fma(a5, b6, c56);
                c57 = Math.fma(a5, b7, c57);
                c60 = Math.fma(a6, b0, c60);
                c61 = Math.fma(a6, b1, c61);
                c62 = Math.fma(a6, b2, c62);
                c63 = Math.fma(a6, b3, c63);
                c64 = Math.fma(a6, b4, c64);
                c65 = Math.fma(a6, b5, c65);
                c66 = Math.fma(a6, b6, c66);
                c67 = Math.fma(a6, b7, c67);
                c70 = Math.fma(a7, b0, c70);
                c71 = Math.fma(a7, b1, c71);
                c72 = Math.fma(a7, b2, c72);
                c73 = Math.fma(a7, b3, c73);
                c74 = Math.fma(a7, b4, c74);
                c75 = Math.fma(a7, b5, c75);
                c76 = Math.fma(a7, b6, c76);
                c77 = Math.fma(a7, b7, c77);
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty * 4 + 0;
        uint32 r1 = m0 + ty * 4 + 1;
        uint32 r2 = m0 + ty * 4 + 2;
        uint32 r3 = m0 + ty * 4 + 3;
        uint32 r4 = m0 + 64 + ty * 4 + 0;
        uint32 r5 = m0 + 64 + ty * 4 + 1;
        uint32 r6 = m0 + 64 + ty * 4 + 2;
        uint32 r7 = m0 + 64 + ty * 4 + 3;
        uint32 q0 = n0 + tx * 4 + 0;
        uint32 q1 = n0 + tx * 4 + 1;
        uint32 q2 = n0 + tx * 4 + 2;
        uint32 q3 = n0 + tx * 4 + 3;
        uint32 q4 = n0 + 64 + tx * 4 + 0;
        uint32 q5 = n0 + 64 + tx * 4 + 1;
        uint32 q6 = n0 + 64 + tx * 4 + 2;
        uint32 q7 = n0 + 64 + tx * 4 + 3;
        if (r0 < m && q0 < n) { c[r0 * n + q0] = (E) c00; }
        if (r0 < m && q1 < n) { c[r0 * n + q1] = (E) c01; }
        if (r0 < m && q2 < n) { c[r0 * n + q2] = (E) c02; }
        if (r0 < m && q3 < n) { c[r0 * n + q3] = (E) c03; }
        if (r0 < m && q4 < n) { c[r0 * n + q4] = (E) c04; }
        if (r0 < m && q5 < n) { c[r0 * n + q5] = (E) c05; }
        if (r0 < m && q6 < n) { c[r0 * n + q6] = (E) c06; }
        if (r0 < m && q7 < n) { c[r0 * n + q7] = (E) c07; }
        if (r1 < m && q0 < n) { c[r1 * n + q0] = (E) c10; }
        if (r1 < m && q1 < n) { c[r1 * n + q1] = (E) c11; }
        if (r1 < m && q2 < n) { c[r1 * n + q2] = (E) c12; }
        if (r1 < m && q3 < n) { c[r1 * n + q3] = (E) c13; }
        if (r1 < m && q4 < n) { c[r1 * n + q4] = (E) c14; }
        if (r1 < m && q5 < n) { c[r1 * n + q5] = (E) c15; }
        if (r1 < m && q6 < n) { c[r1 * n + q6] = (E) c16; }
        if (r1 < m && q7 < n) { c[r1 * n + q7] = (E) c17; }
        if (r2 < m && q0 < n) { c[r2 * n + q0] = (E) c20; }
        if (r2 < m && q1 < n) { c[r2 * n + q1] = (E) c21; }
        if (r2 < m && q2 < n) { c[r2 * n + q2] = (E) c22; }
        if (r2 < m && q3 < n) { c[r2 * n + q3] = (E) c23; }
        if (r2 < m && q4 < n) { c[r2 * n + q4] = (E) c24; }
        if (r2 < m && q5 < n) { c[r2 * n + q5] = (E) c25; }
        if (r2 < m && q6 < n) { c[r2 * n + q6] = (E) c26; }
        if (r2 < m && q7 < n) { c[r2 * n + q7] = (E) c27; }
        if (r3 < m && q0 < n) { c[r3 * n + q0] = (E) c30; }
        if (r3 < m && q1 < n) { c[r3 * n + q1] = (E) c31; }
        if (r3 < m && q2 < n) { c[r3 * n + q2] = (E) c32; }
        if (r3 < m && q3 < n) { c[r3 * n + q3] = (E) c33; }
        if (r3 < m && q4 < n) { c[r3 * n + q4] = (E) c34; }
        if (r3 < m && q5 < n) { c[r3 * n + q5] = (E) c35; }
        if (r3 < m && q6 < n) { c[r3 * n + q6] = (E) c36; }
        if (r3 < m && q7 < n) { c[r3 * n + q7] = (E) c37; }
        if (r4 < m && q0 < n) { c[r4 * n + q0] = (E) c40; }
        if (r4 < m && q1 < n) { c[r4 * n + q1] = (E) c41; }
        if (r4 < m && q2 < n) { c[r4 * n + q2] = (E) c42; }
        if (r4 < m && q3 < n) { c[r4 * n + q3] = (E) c43; }
        if (r4 < m && q4 < n) { c[r4 * n + q4] = (E) c44; }
        if (r4 < m && q5 < n) { c[r4 * n + q5] = (E) c45; }
        if (r4 < m && q6 < n) { c[r4 * n + q6] = (E) c46; }
        if (r4 < m && q7 < n) { c[r4 * n + q7] = (E) c47; }
        if (r5 < m && q0 < n) { c[r5 * n + q0] = (E) c50; }
        if (r5 < m && q1 < n) { c[r5 * n + q1] = (E) c51; }
        if (r5 < m && q2 < n) { c[r5 * n + q2] = (E) c52; }
        if (r5 < m && q3 < n) { c[r5 * n + q3] = (E) c53; }
        if (r5 < m && q4 < n) { c[r5 * n + q4] = (E) c54; }
        if (r5 < m && q5 < n) { c[r5 * n + q5] = (E) c55; }
        if (r5 < m && q6 < n) { c[r5 * n + q6] = (E) c56; }
        if (r5 < m && q7 < n) { c[r5 * n + q7] = (E) c57; }
        if (r6 < m && q0 < n) { c[r6 * n + q0] = (E) c60; }
        if (r6 < m && q1 < n) { c[r6 * n + q1] = (E) c61; }
        if (r6 < m && q2 < n) { c[r6 * n + q2] = (E) c62; }
        if (r6 < m && q3 < n) { c[r6 * n + q3] = (E) c63; }
        if (r6 < m && q4 < n) { c[r6 * n + q4] = (E) c64; }
        if (r6 < m && q5 < n) { c[r6 * n + q5] = (E) c65; }
        if (r6 < m && q6 < n) { c[r6 * n + q6] = (E) c66; }
        if (r6 < m && q7 < n) { c[r6 * n + q7] = (E) c67; }
        if (r7 < m && q0 < n) { c[r7 * n + q0] = (E) c70; }
        if (r7 < m && q1 < n) { c[r7 * n + q1] = (E) c71; }
        if (r7 < m && q2 < n) { c[r7 * n + q2] = (E) c72; }
        if (r7 < m && q3 < n) { c[r7 * n + q3] = (E) c73; }
        if (r7 < m && q4 < n) { c[r7 * n + q4] = (E) c74; }
        if (r7 < m && q5 < n) { c[r7 * n + q5] = (E) c75; }
        if (r7 < m && q6 < n) { c[r7 * n + q6] = (E) c76; }
        if (r7 < m && q7 < n) { c[r7 * n + q7] = (E) c77; }
    }

    /**
     * gemmTiled128 over one slice of K, for a backend where the unrolled split spills
     * (gfx1151): workgroup x / tiles is the slice, and its 128 x 128 partial lands in plane
     * `slice` of `parts` for gemmSplitJoin. The rolled body with only the K bounds, the first
     * prefetch's base and the stores changed. `kChunk` is a multiple of 16.
     */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmTiled128Split<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k,
                                            uint32 kChunk) {
        Shared<float32> sa = shared float32[2112];
        Shared<float32> sb = shared float32[2112];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 127) / 128;
        uint32 tilesAll = ((m + 127) / 128) * ntiles;
        uint32 sp = Workgroup.x() / tilesAll;
        uint32 wid = Workgroup.x() - sp * tilesAll;
        uint32 kBeg = sp * kChunk;
        uint32 kEnd = kBeg + kChunk;
        if (kEnd > k) { kEnd = k; }
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c04 = 0.0f;
        float32 c05 = 0.0f;
        float32 c06 = 0.0f;
        float32 c07 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c14 = 0.0f;
        float32 c15 = 0.0f;
        float32 c16 = 0.0f;
        float32 c17 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c24 = 0.0f;
        float32 c25 = 0.0f;
        float32 c26 = 0.0f;
        float32 c27 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        float32 c34 = 0.0f;
        float32 c35 = 0.0f;
        float32 c36 = 0.0f;
        float32 c37 = 0.0f;
        float32 c40 = 0.0f;
        float32 c41 = 0.0f;
        float32 c42 = 0.0f;
        float32 c43 = 0.0f;
        float32 c44 = 0.0f;
        float32 c45 = 0.0f;
        float32 c46 = 0.0f;
        float32 c47 = 0.0f;
        float32 c50 = 0.0f;
        float32 c51 = 0.0f;
        float32 c52 = 0.0f;
        float32 c53 = 0.0f;
        float32 c54 = 0.0f;
        float32 c55 = 0.0f;
        float32 c56 = 0.0f;
        float32 c57 = 0.0f;
        float32 c60 = 0.0f;
        float32 c61 = 0.0f;
        float32 c62 = 0.0f;
        float32 c63 = 0.0f;
        float32 c64 = 0.0f;
        float32 c65 = 0.0f;
        float32 c66 = 0.0f;
        float32 c67 = 0.0f;
        float32 c70 = 0.0f;
        float32 c71 = 0.0f;
        float32 c72 = 0.0f;
        float32 c73 = 0.0f;
        float32 c74 = 0.0f;
        float32 c75 = 0.0f;
        float32 c76 = 0.0f;
        float32 c77 = 0.0f;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 4) == 0 && (n % 4) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = kBeg + ((kEnd - kBeg) / 16) * 16; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 4;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 32;
        uint32 bc0 = (t - br0 * 32) * 4;
        uint32 br1 = br0 + 8;
        uint32 k0 = kBeg;
        if (kFull > kBeg) {
            Vector<E,4> pa0 = a.vload<4>((m0 + ar0) * k + kBeg + ac0);
            Vector<E,4> pa1 = a.vload<4>((m0 + ar1) * k + kBeg + ac0);
            Vector<E,4> pb0 = b.vload<4>((kBeg + br0) * n + n0 + bc0);
            Vector<E,4> pb1 = b.vload<4>((kBeg + br1) * n + n0 + bc0);
            sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
            sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
            sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
            sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
            sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
            sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
            sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
            sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
            sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
            sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
            sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
            sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
            sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
            sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
            sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
            sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 16;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<4>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<4>((m0 + ar1) * k + next + ac0);
                    pb0 = b.vload<4>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<4>((next + br1) * n + n0 + bc0);
                }
                uint32 kk = 0;
                while (kk < 16) {
                    Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                    Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                    Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                    Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                    float32 a0 = av0.x;
                    float32 a1 = av0.y;
                    float32 a2 = av0.z;
                    float32 a3 = av0.w;
                    float32 a4 = av1.x;
                    float32 a5 = av1.y;
                    float32 a6 = av1.z;
                    float32 a7 = av1.w;
                    float32 b0 = bv0.x;
                    float32 b1 = bv0.y;
                    float32 b2 = bv0.z;
                    float32 b3 = bv0.w;
                    float32 b4 = bv1.x;
                    float32 b5 = bv1.y;
                    float32 b6 = bv1.z;
                    float32 b7 = bv1.w;
                    c00 = Math.fma(a0, b0, c00);
                    c01 = Math.fma(a0, b1, c01);
                    c02 = Math.fma(a0, b2, c02);
                    c03 = Math.fma(a0, b3, c03);
                    c04 = Math.fma(a0, b4, c04);
                    c05 = Math.fma(a0, b5, c05);
                    c06 = Math.fma(a0, b6, c06);
                    c07 = Math.fma(a0, b7, c07);
                    c10 = Math.fma(a1, b0, c10);
                    c11 = Math.fma(a1, b1, c11);
                    c12 = Math.fma(a1, b2, c12);
                    c13 = Math.fma(a1, b3, c13);
                    c14 = Math.fma(a1, b4, c14);
                    c15 = Math.fma(a1, b5, c15);
                    c16 = Math.fma(a1, b6, c16);
                    c17 = Math.fma(a1, b7, c17);
                    c20 = Math.fma(a2, b0, c20);
                    c21 = Math.fma(a2, b1, c21);
                    c22 = Math.fma(a2, b2, c22);
                    c23 = Math.fma(a2, b3, c23);
                    c24 = Math.fma(a2, b4, c24);
                    c25 = Math.fma(a2, b5, c25);
                    c26 = Math.fma(a2, b6, c26);
                    c27 = Math.fma(a2, b7, c27);
                    c30 = Math.fma(a3, b0, c30);
                    c31 = Math.fma(a3, b1, c31);
                    c32 = Math.fma(a3, b2, c32);
                    c33 = Math.fma(a3, b3, c33);
                    c34 = Math.fma(a3, b4, c34);
                    c35 = Math.fma(a3, b5, c35);
                    c36 = Math.fma(a3, b6, c36);
                    c37 = Math.fma(a3, b7, c37);
                    c40 = Math.fma(a4, b0, c40);
                    c41 = Math.fma(a4, b1, c41);
                    c42 = Math.fma(a4, b2, c42);
                    c43 = Math.fma(a4, b3, c43);
                    c44 = Math.fma(a4, b4, c44);
                    c45 = Math.fma(a4, b5, c45);
                    c46 = Math.fma(a4, b6, c46);
                    c47 = Math.fma(a4, b7, c47);
                    c50 = Math.fma(a5, b0, c50);
                    c51 = Math.fma(a5, b1, c51);
                    c52 = Math.fma(a5, b2, c52);
                    c53 = Math.fma(a5, b3, c53);
                    c54 = Math.fma(a5, b4, c54);
                    c55 = Math.fma(a5, b5, c55);
                    c56 = Math.fma(a5, b6, c56);
                    c57 = Math.fma(a5, b7, c57);
                    c60 = Math.fma(a6, b0, c60);
                    c61 = Math.fma(a6, b1, c61);
                    c62 = Math.fma(a6, b2, c62);
                    c63 = Math.fma(a6, b3, c63);
                    c64 = Math.fma(a6, b4, c64);
                    c65 = Math.fma(a6, b5, c65);
                    c66 = Math.fma(a6, b6, c66);
                    c67 = Math.fma(a6, b7, c67);
                    c70 = Math.fma(a7, b0, c70);
                    c71 = Math.fma(a7, b1, c71);
                    c72 = Math.fma(a7, b2, c72);
                    c73 = Math.fma(a7, b3, c73);
                    c74 = Math.fma(a7, b4, c74);
                    c75 = Math.fma(a7, b5, c75);
                    c76 = Math.fma(a7, b6, c76);
                    c77 = Math.fma(a7, b7, c77);
                    kk = kk + 1;
                }
                Barrier.workgroup();
                if (more) {
                    sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
                    sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
                    sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
                    sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
                    sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
                    sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
                    sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
                    sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
                    sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
                    sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
                    sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
                    sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
                    sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
                    sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
                    sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
                    sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < kEnd) {
            uint32 idx = t;
            while (idx < 2048) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < kEnd) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 132 + ar] = va;
                uint32 bk = idx / 128;
                uint32 bc = idx - bk * 128;
                float32 vb = 0.0f;
                if (k0 + bk < kEnd && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 132 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                float32 a0 = av0.x;
                float32 a1 = av0.y;
                float32 a2 = av0.z;
                float32 a3 = av0.w;
                float32 a4 = av1.x;
                float32 a5 = av1.y;
                float32 a6 = av1.z;
                float32 a7 = av1.w;
                float32 b0 = bv0.x;
                float32 b1 = bv0.y;
                float32 b2 = bv0.z;
                float32 b3 = bv0.w;
                float32 b4 = bv1.x;
                float32 b5 = bv1.y;
                float32 b6 = bv1.z;
                float32 b7 = bv1.w;
                c00 = Math.fma(a0, b0, c00);
                c01 = Math.fma(a0, b1, c01);
                c02 = Math.fma(a0, b2, c02);
                c03 = Math.fma(a0, b3, c03);
                c04 = Math.fma(a0, b4, c04);
                c05 = Math.fma(a0, b5, c05);
                c06 = Math.fma(a0, b6, c06);
                c07 = Math.fma(a0, b7, c07);
                c10 = Math.fma(a1, b0, c10);
                c11 = Math.fma(a1, b1, c11);
                c12 = Math.fma(a1, b2, c12);
                c13 = Math.fma(a1, b3, c13);
                c14 = Math.fma(a1, b4, c14);
                c15 = Math.fma(a1, b5, c15);
                c16 = Math.fma(a1, b6, c16);
                c17 = Math.fma(a1, b7, c17);
                c20 = Math.fma(a2, b0, c20);
                c21 = Math.fma(a2, b1, c21);
                c22 = Math.fma(a2, b2, c22);
                c23 = Math.fma(a2, b3, c23);
                c24 = Math.fma(a2, b4, c24);
                c25 = Math.fma(a2, b5, c25);
                c26 = Math.fma(a2, b6, c26);
                c27 = Math.fma(a2, b7, c27);
                c30 = Math.fma(a3, b0, c30);
                c31 = Math.fma(a3, b1, c31);
                c32 = Math.fma(a3, b2, c32);
                c33 = Math.fma(a3, b3, c33);
                c34 = Math.fma(a3, b4, c34);
                c35 = Math.fma(a3, b5, c35);
                c36 = Math.fma(a3, b6, c36);
                c37 = Math.fma(a3, b7, c37);
                c40 = Math.fma(a4, b0, c40);
                c41 = Math.fma(a4, b1, c41);
                c42 = Math.fma(a4, b2, c42);
                c43 = Math.fma(a4, b3, c43);
                c44 = Math.fma(a4, b4, c44);
                c45 = Math.fma(a4, b5, c45);
                c46 = Math.fma(a4, b6, c46);
                c47 = Math.fma(a4, b7, c47);
                c50 = Math.fma(a5, b0, c50);
                c51 = Math.fma(a5, b1, c51);
                c52 = Math.fma(a5, b2, c52);
                c53 = Math.fma(a5, b3, c53);
                c54 = Math.fma(a5, b4, c54);
                c55 = Math.fma(a5, b5, c55);
                c56 = Math.fma(a5, b6, c56);
                c57 = Math.fma(a5, b7, c57);
                c60 = Math.fma(a6, b0, c60);
                c61 = Math.fma(a6, b1, c61);
                c62 = Math.fma(a6, b2, c62);
                c63 = Math.fma(a6, b3, c63);
                c64 = Math.fma(a6, b4, c64);
                c65 = Math.fma(a6, b5, c65);
                c66 = Math.fma(a6, b6, c66);
                c67 = Math.fma(a6, b7, c67);
                c70 = Math.fma(a7, b0, c70);
                c71 = Math.fma(a7, b1, c71);
                c72 = Math.fma(a7, b2, c72);
                c73 = Math.fma(a7, b3, c73);
                c74 = Math.fma(a7, b4, c74);
                c75 = Math.fma(a7, b5, c75);
                c76 = Math.fma(a7, b6, c76);
                c77 = Math.fma(a7, b7, c77);
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty * 4 + 0;
        uint32 r1 = m0 + ty * 4 + 1;
        uint32 r2 = m0 + ty * 4 + 2;
        uint32 r3 = m0 + ty * 4 + 3;
        uint32 r4 = m0 + 64 + ty * 4 + 0;
        uint32 r5 = m0 + 64 + ty * 4 + 1;
        uint32 r6 = m0 + 64 + ty * 4 + 2;
        uint32 r7 = m0 + 64 + ty * 4 + 3;
        uint32 q0 = n0 + tx * 4 + 0;
        uint32 q1 = n0 + tx * 4 + 1;
        uint32 q2 = n0 + tx * 4 + 2;
        uint32 q3 = n0 + tx * 4 + 3;
        uint32 q4 = n0 + 64 + tx * 4 + 0;
        uint32 q5 = n0 + 64 + tx * 4 + 1;
        uint32 q6 = n0 + 64 + tx * 4 + 2;
        uint32 q7 = n0 + 64 + tx * 4 + 3;
        if (r0 < m && q0 < n) { parts[sp * m * n + r0 * n + q0] = c00; }
        if (r0 < m && q1 < n) { parts[sp * m * n + r0 * n + q1] = c01; }
        if (r0 < m && q2 < n) { parts[sp * m * n + r0 * n + q2] = c02; }
        if (r0 < m && q3 < n) { parts[sp * m * n + r0 * n + q3] = c03; }
        if (r0 < m && q4 < n) { parts[sp * m * n + r0 * n + q4] = c04; }
        if (r0 < m && q5 < n) { parts[sp * m * n + r0 * n + q5] = c05; }
        if (r0 < m && q6 < n) { parts[sp * m * n + r0 * n + q6] = c06; }
        if (r0 < m && q7 < n) { parts[sp * m * n + r0 * n + q7] = c07; }
        if (r1 < m && q0 < n) { parts[sp * m * n + r1 * n + q0] = c10; }
        if (r1 < m && q1 < n) { parts[sp * m * n + r1 * n + q1] = c11; }
        if (r1 < m && q2 < n) { parts[sp * m * n + r1 * n + q2] = c12; }
        if (r1 < m && q3 < n) { parts[sp * m * n + r1 * n + q3] = c13; }
        if (r1 < m && q4 < n) { parts[sp * m * n + r1 * n + q4] = c14; }
        if (r1 < m && q5 < n) { parts[sp * m * n + r1 * n + q5] = c15; }
        if (r1 < m && q6 < n) { parts[sp * m * n + r1 * n + q6] = c16; }
        if (r1 < m && q7 < n) { parts[sp * m * n + r1 * n + q7] = c17; }
        if (r2 < m && q0 < n) { parts[sp * m * n + r2 * n + q0] = c20; }
        if (r2 < m && q1 < n) { parts[sp * m * n + r2 * n + q1] = c21; }
        if (r2 < m && q2 < n) { parts[sp * m * n + r2 * n + q2] = c22; }
        if (r2 < m && q3 < n) { parts[sp * m * n + r2 * n + q3] = c23; }
        if (r2 < m && q4 < n) { parts[sp * m * n + r2 * n + q4] = c24; }
        if (r2 < m && q5 < n) { parts[sp * m * n + r2 * n + q5] = c25; }
        if (r2 < m && q6 < n) { parts[sp * m * n + r2 * n + q6] = c26; }
        if (r2 < m && q7 < n) { parts[sp * m * n + r2 * n + q7] = c27; }
        if (r3 < m && q0 < n) { parts[sp * m * n + r3 * n + q0] = c30; }
        if (r3 < m && q1 < n) { parts[sp * m * n + r3 * n + q1] = c31; }
        if (r3 < m && q2 < n) { parts[sp * m * n + r3 * n + q2] = c32; }
        if (r3 < m && q3 < n) { parts[sp * m * n + r3 * n + q3] = c33; }
        if (r3 < m && q4 < n) { parts[sp * m * n + r3 * n + q4] = c34; }
        if (r3 < m && q5 < n) { parts[sp * m * n + r3 * n + q5] = c35; }
        if (r3 < m && q6 < n) { parts[sp * m * n + r3 * n + q6] = c36; }
        if (r3 < m && q7 < n) { parts[sp * m * n + r3 * n + q7] = c37; }
        if (r4 < m && q0 < n) { parts[sp * m * n + r4 * n + q0] = c40; }
        if (r4 < m && q1 < n) { parts[sp * m * n + r4 * n + q1] = c41; }
        if (r4 < m && q2 < n) { parts[sp * m * n + r4 * n + q2] = c42; }
        if (r4 < m && q3 < n) { parts[sp * m * n + r4 * n + q3] = c43; }
        if (r4 < m && q4 < n) { parts[sp * m * n + r4 * n + q4] = c44; }
        if (r4 < m && q5 < n) { parts[sp * m * n + r4 * n + q5] = c45; }
        if (r4 < m && q6 < n) { parts[sp * m * n + r4 * n + q6] = c46; }
        if (r4 < m && q7 < n) { parts[sp * m * n + r4 * n + q7] = c47; }
        if (r5 < m && q0 < n) { parts[sp * m * n + r5 * n + q0] = c50; }
        if (r5 < m && q1 < n) { parts[sp * m * n + r5 * n + q1] = c51; }
        if (r5 < m && q2 < n) { parts[sp * m * n + r5 * n + q2] = c52; }
        if (r5 < m && q3 < n) { parts[sp * m * n + r5 * n + q3] = c53; }
        if (r5 < m && q4 < n) { parts[sp * m * n + r5 * n + q4] = c54; }
        if (r5 < m && q5 < n) { parts[sp * m * n + r5 * n + q5] = c55; }
        if (r5 < m && q6 < n) { parts[sp * m * n + r5 * n + q6] = c56; }
        if (r5 < m && q7 < n) { parts[sp * m * n + r5 * n + q7] = c57; }
        if (r6 < m && q0 < n) { parts[sp * m * n + r6 * n + q0] = c60; }
        if (r6 < m && q1 < n) { parts[sp * m * n + r6 * n + q1] = c61; }
        if (r6 < m && q2 < n) { parts[sp * m * n + r6 * n + q2] = c62; }
        if (r6 < m && q3 < n) { parts[sp * m * n + r6 * n + q3] = c63; }
        if (r6 < m && q4 < n) { parts[sp * m * n + r6 * n + q4] = c64; }
        if (r6 < m && q5 < n) { parts[sp * m * n + r6 * n + q5] = c65; }
        if (r6 < m && q6 < n) { parts[sp * m * n + r6 * n + q6] = c66; }
        if (r6 < m && q7 < n) { parts[sp * m * n + r6 * n + q7] = c67; }
        if (r7 < m && q0 < n) { parts[sp * m * n + r7 * n + q0] = c70; }
        if (r7 < m && q1 < n) { parts[sp * m * n + r7 * n + q1] = c71; }
        if (r7 < m && q2 < n) { parts[sp * m * n + r7 * n + q2] = c72; }
        if (r7 < m && q3 < n) { parts[sp * m * n + r7 * n + q3] = c73; }
        if (r7 < m && q4 < n) { parts[sp * m * n + r7 * n + q4] = c74; }
        if (r7 < m && q5 < n) { parts[sp * m * n + r7 * n + q5] = c75; }
        if (r7 < m && q6 < n) { parts[sp * m * n + r7 * n + q6] = c76; }
        if (r7 < m && q7 < n) { parts[sp * m * n + r7 * n + q7] = c77; }
    }

    /** gemmTiled128Split with A stored transposed (k x m): a^T . b over one slice of K, A's tile loaded as B's is. */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmTiled128SplitTN<E>(KernelBuffer<float32> parts, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k,
                                            uint32 kChunk) {
        Shared<float32> sa = shared float32[2112];
        Shared<float32> sb = shared float32[2112];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 127) / 128;
        uint32 tilesAll = ((m + 127) / 128) * ntiles;
        uint32 sp = Workgroup.x() / tilesAll;
        uint32 wid = Workgroup.x() - sp * tilesAll;
        uint32 kBeg = sp * kChunk;
        uint32 kEnd = kBeg + kChunk;
        if (kEnd > k) { kEnd = k; }
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c04 = 0.0f;
        float32 c05 = 0.0f;
        float32 c06 = 0.0f;
        float32 c07 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c14 = 0.0f;
        float32 c15 = 0.0f;
        float32 c16 = 0.0f;
        float32 c17 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c24 = 0.0f;
        float32 c25 = 0.0f;
        float32 c26 = 0.0f;
        float32 c27 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        float32 c34 = 0.0f;
        float32 c35 = 0.0f;
        float32 c36 = 0.0f;
        float32 c37 = 0.0f;
        float32 c40 = 0.0f;
        float32 c41 = 0.0f;
        float32 c42 = 0.0f;
        float32 c43 = 0.0f;
        float32 c44 = 0.0f;
        float32 c45 = 0.0f;
        float32 c46 = 0.0f;
        float32 c47 = 0.0f;
        float32 c50 = 0.0f;
        float32 c51 = 0.0f;
        float32 c52 = 0.0f;
        float32 c53 = 0.0f;
        float32 c54 = 0.0f;
        float32 c55 = 0.0f;
        float32 c56 = 0.0f;
        float32 c57 = 0.0f;
        float32 c60 = 0.0f;
        float32 c61 = 0.0f;
        float32 c62 = 0.0f;
        float32 c63 = 0.0f;
        float32 c64 = 0.0f;
        float32 c65 = 0.0f;
        float32 c66 = 0.0f;
        float32 c67 = 0.0f;
        float32 c70 = 0.0f;
        float32 c71 = 0.0f;
        float32 c72 = 0.0f;
        float32 c73 = 0.0f;
        float32 c74 = 0.0f;
        float32 c75 = 0.0f;
        float32 c76 = 0.0f;
        float32 c77 = 0.0f;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (m % 4) == 0 && (n % 4) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = kBeg + ((kEnd - kBeg) / 16) * 16; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 4;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 32;
        uint32 bc0 = (t - br0 * 32) * 4;
        uint32 br1 = br0 + 8;
        uint32 k0 = kBeg;
        if (kFull > kBeg) {
            Vector<E,4> pa0 = a.vload<4>((kBeg + br0) * m + m0 + bc0);
            Vector<E,4> pa1 = a.vload<4>((kBeg + br1) * m + m0 + bc0);
            Vector<E,4> pb0 = b.vload<4>((kBeg + br0) * n + n0 + bc0);
            Vector<E,4> pb1 = b.vload<4>((kBeg + br1) * n + n0 + bc0);
            sa[br0 * 132 + bc0 + 0] = (float32) pa0.x;
            sa[br0 * 132 + bc0 + 1] = (float32) pa0.y;
            sa[br0 * 132 + bc0 + 2] = (float32) pa0.z;
            sa[br0 * 132 + bc0 + 3] = (float32) pa0.w;
            sa[br1 * 132 + bc0 + 0] = (float32) pa1.x;
            sa[br1 * 132 + bc0 + 1] = (float32) pa1.y;
            sa[br1 * 132 + bc0 + 2] = (float32) pa1.z;
            sa[br1 * 132 + bc0 + 3] = (float32) pa1.w;
            sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
            sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
            sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
            sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
            sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
            sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
            sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
            sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 16;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<4>((next + br0) * m + m0 + bc0);
                    pa1 = a.vload<4>((next + br1) * m + m0 + bc0);
                    pb0 = b.vload<4>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<4>((next + br1) * n + n0 + bc0);
                }
                uint32 kk = 0;
                while (kk < 16) {
                    Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                    Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                    Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                    Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                    float32 a0 = av0.x;
                    float32 a1 = av0.y;
                    float32 a2 = av0.z;
                    float32 a3 = av0.w;
                    float32 a4 = av1.x;
                    float32 a5 = av1.y;
                    float32 a6 = av1.z;
                    float32 a7 = av1.w;
                    float32 b0 = bv0.x;
                    float32 b1 = bv0.y;
                    float32 b2 = bv0.z;
                    float32 b3 = bv0.w;
                    float32 b4 = bv1.x;
                    float32 b5 = bv1.y;
                    float32 b6 = bv1.z;
                    float32 b7 = bv1.w;
                    c00 = Math.fma(a0, b0, c00);
                    c01 = Math.fma(a0, b1, c01);
                    c02 = Math.fma(a0, b2, c02);
                    c03 = Math.fma(a0, b3, c03);
                    c04 = Math.fma(a0, b4, c04);
                    c05 = Math.fma(a0, b5, c05);
                    c06 = Math.fma(a0, b6, c06);
                    c07 = Math.fma(a0, b7, c07);
                    c10 = Math.fma(a1, b0, c10);
                    c11 = Math.fma(a1, b1, c11);
                    c12 = Math.fma(a1, b2, c12);
                    c13 = Math.fma(a1, b3, c13);
                    c14 = Math.fma(a1, b4, c14);
                    c15 = Math.fma(a1, b5, c15);
                    c16 = Math.fma(a1, b6, c16);
                    c17 = Math.fma(a1, b7, c17);
                    c20 = Math.fma(a2, b0, c20);
                    c21 = Math.fma(a2, b1, c21);
                    c22 = Math.fma(a2, b2, c22);
                    c23 = Math.fma(a2, b3, c23);
                    c24 = Math.fma(a2, b4, c24);
                    c25 = Math.fma(a2, b5, c25);
                    c26 = Math.fma(a2, b6, c26);
                    c27 = Math.fma(a2, b7, c27);
                    c30 = Math.fma(a3, b0, c30);
                    c31 = Math.fma(a3, b1, c31);
                    c32 = Math.fma(a3, b2, c32);
                    c33 = Math.fma(a3, b3, c33);
                    c34 = Math.fma(a3, b4, c34);
                    c35 = Math.fma(a3, b5, c35);
                    c36 = Math.fma(a3, b6, c36);
                    c37 = Math.fma(a3, b7, c37);
                    c40 = Math.fma(a4, b0, c40);
                    c41 = Math.fma(a4, b1, c41);
                    c42 = Math.fma(a4, b2, c42);
                    c43 = Math.fma(a4, b3, c43);
                    c44 = Math.fma(a4, b4, c44);
                    c45 = Math.fma(a4, b5, c45);
                    c46 = Math.fma(a4, b6, c46);
                    c47 = Math.fma(a4, b7, c47);
                    c50 = Math.fma(a5, b0, c50);
                    c51 = Math.fma(a5, b1, c51);
                    c52 = Math.fma(a5, b2, c52);
                    c53 = Math.fma(a5, b3, c53);
                    c54 = Math.fma(a5, b4, c54);
                    c55 = Math.fma(a5, b5, c55);
                    c56 = Math.fma(a5, b6, c56);
                    c57 = Math.fma(a5, b7, c57);
                    c60 = Math.fma(a6, b0, c60);
                    c61 = Math.fma(a6, b1, c61);
                    c62 = Math.fma(a6, b2, c62);
                    c63 = Math.fma(a6, b3, c63);
                    c64 = Math.fma(a6, b4, c64);
                    c65 = Math.fma(a6, b5, c65);
                    c66 = Math.fma(a6, b6, c66);
                    c67 = Math.fma(a6, b7, c67);
                    c70 = Math.fma(a7, b0, c70);
                    c71 = Math.fma(a7, b1, c71);
                    c72 = Math.fma(a7, b2, c72);
                    c73 = Math.fma(a7, b3, c73);
                    c74 = Math.fma(a7, b4, c74);
                    c75 = Math.fma(a7, b5, c75);
                    c76 = Math.fma(a7, b6, c76);
                    c77 = Math.fma(a7, b7, c77);
                    kk = kk + 1;
                }
                Barrier.workgroup();
                if (more) {
                    sa[br0 * 132 + bc0 + 0] = (float32) pa0.x;
                    sa[br0 * 132 + bc0 + 1] = (float32) pa0.y;
                    sa[br0 * 132 + bc0 + 2] = (float32) pa0.z;
                    sa[br0 * 132 + bc0 + 3] = (float32) pa0.w;
                    sa[br1 * 132 + bc0 + 0] = (float32) pa1.x;
                    sa[br1 * 132 + bc0 + 1] = (float32) pa1.y;
                    sa[br1 * 132 + bc0 + 2] = (float32) pa1.z;
                    sa[br1 * 132 + bc0 + 3] = (float32) pa1.w;
                    sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
                    sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
                    sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
                    sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
                    sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
                    sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
                    sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
                    sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < kEnd) {
            uint32 idx = t;
            while (idx < 2048) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < kEnd) { va = (float32) a[(k0 + ak) * m + m0 + ar]; }
                sa[ak * 132 + ar] = va;
                uint32 bk = idx / 128;
                uint32 bc = idx - bk * 128;
                float32 vb = 0.0f;
                if (k0 + bk < kEnd && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 132 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                float32 a0 = av0.x;
                float32 a1 = av0.y;
                float32 a2 = av0.z;
                float32 a3 = av0.w;
                float32 a4 = av1.x;
                float32 a5 = av1.y;
                float32 a6 = av1.z;
                float32 a7 = av1.w;
                float32 b0 = bv0.x;
                float32 b1 = bv0.y;
                float32 b2 = bv0.z;
                float32 b3 = bv0.w;
                float32 b4 = bv1.x;
                float32 b5 = bv1.y;
                float32 b6 = bv1.z;
                float32 b7 = bv1.w;
                c00 = Math.fma(a0, b0, c00);
                c01 = Math.fma(a0, b1, c01);
                c02 = Math.fma(a0, b2, c02);
                c03 = Math.fma(a0, b3, c03);
                c04 = Math.fma(a0, b4, c04);
                c05 = Math.fma(a0, b5, c05);
                c06 = Math.fma(a0, b6, c06);
                c07 = Math.fma(a0, b7, c07);
                c10 = Math.fma(a1, b0, c10);
                c11 = Math.fma(a1, b1, c11);
                c12 = Math.fma(a1, b2, c12);
                c13 = Math.fma(a1, b3, c13);
                c14 = Math.fma(a1, b4, c14);
                c15 = Math.fma(a1, b5, c15);
                c16 = Math.fma(a1, b6, c16);
                c17 = Math.fma(a1, b7, c17);
                c20 = Math.fma(a2, b0, c20);
                c21 = Math.fma(a2, b1, c21);
                c22 = Math.fma(a2, b2, c22);
                c23 = Math.fma(a2, b3, c23);
                c24 = Math.fma(a2, b4, c24);
                c25 = Math.fma(a2, b5, c25);
                c26 = Math.fma(a2, b6, c26);
                c27 = Math.fma(a2, b7, c27);
                c30 = Math.fma(a3, b0, c30);
                c31 = Math.fma(a3, b1, c31);
                c32 = Math.fma(a3, b2, c32);
                c33 = Math.fma(a3, b3, c33);
                c34 = Math.fma(a3, b4, c34);
                c35 = Math.fma(a3, b5, c35);
                c36 = Math.fma(a3, b6, c36);
                c37 = Math.fma(a3, b7, c37);
                c40 = Math.fma(a4, b0, c40);
                c41 = Math.fma(a4, b1, c41);
                c42 = Math.fma(a4, b2, c42);
                c43 = Math.fma(a4, b3, c43);
                c44 = Math.fma(a4, b4, c44);
                c45 = Math.fma(a4, b5, c45);
                c46 = Math.fma(a4, b6, c46);
                c47 = Math.fma(a4, b7, c47);
                c50 = Math.fma(a5, b0, c50);
                c51 = Math.fma(a5, b1, c51);
                c52 = Math.fma(a5, b2, c52);
                c53 = Math.fma(a5, b3, c53);
                c54 = Math.fma(a5, b4, c54);
                c55 = Math.fma(a5, b5, c55);
                c56 = Math.fma(a5, b6, c56);
                c57 = Math.fma(a5, b7, c57);
                c60 = Math.fma(a6, b0, c60);
                c61 = Math.fma(a6, b1, c61);
