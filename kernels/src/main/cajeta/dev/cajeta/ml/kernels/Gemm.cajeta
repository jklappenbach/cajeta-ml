            while (k0 < kFull) {
                uint32 kn = ks2 + 32;
                if (kn >= kFull) { kn = 0; }
                if (k0 + 96 >= kFull) { kn = ks0; }
                pa0 = a.vload<8>((m0 + ar0) * k + kn + ac0); pa1 = a.vload<8>((m0 + ar1) * k + kn + ac0);
                mb0.load(sb, 0 + (wn * 64 + 0) * 40 + 0 * 16, 1, 40);
