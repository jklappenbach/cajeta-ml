    /** c[t] = the `splits` planes of `parts` at t, summed in plane order. */
    @Kernel
    public static void gemmSplitJoin<E>(KernelBuffer<E> c, KernelBuffer<float32> parts, uint32 mn, uint32 splits) {
        uint32 t = KernelThread.globalIdX();
        if (t < mn) {
            float32 acc = 0.0f;
            uint32 p = 0;
            while (p < splits) {
                acc = acc + parts[p * mn + t];
                p = p + 1;
            }
            c[t] = (E) acc;
        }
    }

    /** `c` (m x n) = `a` (m x k) . `b` (k x n), all at E, through the wide register-blocked tile; queued on the current stream. */
    public static void tiled128<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        if (Gemm.unrolledPays("gemmTiled128Unrolled_float32")) { Gemm.tiled128Unrolled<E>(c, a, b, m, n, k); return; }
        Gemm.tiled128Rolled<E>(c, a, b, m, n, k);
    }

    /** tiled128 on the rolled body, which every backend builds. */
    public static void tiled128Rolled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemmTiled128.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /** tiled128 on the unrolled body; its launch throws `not a target` where it is not built. */
    public static void tiled128Unrolled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        KernelStream s #= KernelStream.current();
        gemmTiled128Unrolled.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /**
     * K slices for an m x n x k product: 1 when its 128 x 128 tiles fill the device (128
     * or more) or K is short (under 1024), else enough slices for about 128 workgroups,
     * each at least 256 deep, at most 16. A weight gradient, a small output over the
     * batch's rows, is the shape this serves.
     */
    public static uint32 splitsFor(int64 m, int64 n, int64 k) {
        int64 tiles = ((m + 127L) / 128L) * ((n + 127L) / 128L);
        if (tiles >= 128L || k < 1024L) { return (uint32) 1; }
        int64 want = (128L + tiles - 1L) / tiles;
        if (want > k / 256L) { want = k / 256L; }
        if (want > 16L) { want = 16L; }
        if (want < 2L) { return (uint32) 1; }
        return (uint32) want;
    }

    /** Whether a split-K member runs here: the unrolled one where it builds without spilling, else the rolled one. */
    public static boolean splitKRuns() {
        return Gemm.unrolledPays("gemmTiled128UnrolledSplit_float32") || Device.kernelAvailable("gemmTiled128Split_float32");
    }

    /** The split-K partial planes, grown only past their high-water mark (see tiled128Split). */
    static KernelBuffer<float32> splitParts;
    static uint64 splitPartsCap;

    /**
     * `c` = `a` . `b` with K cut into `splits` slices of a multiple of 16, each slice's
     * partial from the unrolled wide tile, the planes summed in order (gemmSplitJoin), so
     * the result repeats bit for bit; queued on the current stream. The planes are kept
     * across calls and the stream synced only on the call that grows them, since a queued
     * launch may still read the old ones.
     */
    public static void tiled128Split<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k, uint32 splits) {
        Gemm.splitInto<E>(c, a, b, m, n, k, splits, false, 0);
    }

    /** tiled128Split (or with `transA`, tiled128SplitTN) on the unrolled members wherever they are built; queued on the current stream. */
    public static void tiled128SplitUnrolled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k,
                                                uint32 splits, boolean transA) {
        Gemm.splitInto<E>(c, a, b, m, n, k, splits, transA, 2);
    }

    /** tiled128Split (or with `transA`, tiled128SplitTN) on the rolled members whatever the backend; queued on the current stream. */
    public static void tiled128SplitRolled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k,
                                              uint32 splits, boolean transA) {
        Gemm.splitInto<E>(c, a, b, m, n, k, splits, transA, 1);
    }

    /**
     * `c` (m x n) = `at`^T . `b` with `at` stored k x m, through the transposed-A split
     * member, when the product splits K (splitsFor) where the split member runs; false
     * otherwise, and the caller transposes and multiplies. A weight gradient X^T . G is
     * this shape, and reading X in place saves its 16 to 64 MB copy.
     */
    public static boolean tiledTN<E>(KernelBuffer<E> c, KernelBuffer<E> at, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 splits = Gemm.splitsFor(m, n, k);
        if (splits <= (uint32) 1 || !Gemm.splitTNRuns()) { return false; }
        Gemm.splitInto<E>(c, at, b, m, n, k, splits, true, 0);
        return true;
    }

    /** `c` = `at`^T . `b` straight through the transposed-A split member with `splits` slices; queued on the current stream. */
    public static void tiled128SplitTN<E>(KernelBuffer<E> c, KernelBuffer<E> at, KernelBuffer<E> b, int64 m, int64 n, int64 k, uint32 splits) {
        Gemm.splitInto<E>(c, at, b, m, n, k, splits, true, 0);
    }

    /** The split-K member Gemm.tiled takes here: the unrolled one where it builds without spilling, else the rolled one. */
    public static #String splitMember() {
        if (Gemm.unrolledPays("gemmTiled128UnrolledSplit_float32")) { return "gemmTiled128UnrolledSplit_float32".clone(); }
        return "gemmTiled128Split_float32".clone();
    }

    /** The transposed-A split member Gemm.tiledTN takes here (as splitMember). */
    public static #String splitTNMember() {
        if (Gemm.unrolledPays("gemmTiled128UnrolledSplitTN_float32")) { return "gemmTiled128UnrolledSplitTN_float32".clone(); }
        return "gemmTiled128SplitTN_float32".clone();
    }

    /** Whether a transposed-A split member runs here (as splitKRuns). */
    public static boolean splitTNRuns() {
        return Gemm.unrolledPays("gemmTiled128UnrolledSplitTN_float32") || Device.kernelAvailable("gemmTiled128SplitTN_float32");
    }

    /** tiled128Split's body, with A stored k x m when `transA`; `member` 0 takes the routed member, 1 the rolled, 2 the unrolled. */
    static void splitInto<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k, uint32 splits,
                             boolean transA, int32 member) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 chunk = ((uk + splits - 1) / splits + 15) / 16 * 16;
        uint32 used = (uk + chunk - 1) / chunk;
        uint32 tiles = ((um + 127) / 128) * ((un + 127) / 128);
        uint64 need = (uint64) um * (uint64) un * (uint64) used;
        KernelStream s #= KernelStream.current();
        if (Gemm.splitParts == null || need > Gemm.splitPartsCap) {
            s.sync();
            Gemm.splitParts = heap KernelBuffer<float32>(need);
            Gemm.splitPartsCap = need;
        }
        KernelBuffer<float32> parts = Gemm.splitParts;
        if (transA && (member == 2 || (member == 0 && Gemm.unrolledPays("gemmTiled128UnrolledSplitTN_float32")))) {
            gemmTiled128UnrolledSplitTN.launch(s, grid: [tiles * used], block: [256])(parts, a, b, um, un, uk, chunk);
        } else if (transA) {
            gemmTiled128SplitTN.launch(s, grid: [tiles * used], block: [256])(parts, a, b, um, un, uk, chunk);
        } else if (member == 2 || (member == 0 && Gemm.unrolledPays("gemmTiled128UnrolledSplit_float32"))) {
            gemmTiled128UnrolledSplit.launch(s, grid: [tiles * used], block: [256])(parts, a, b, um, un, uk, chunk);
        } else {
            gemmTiled128Split.launch(s, grid: [tiles * used], block: [256])(parts, a, b, um, un, uk, chunk);
        }
        uint32 mn = um * un;
        gemmSplitJoin.launch(s, grid: [(mn + 255) / 256], block: [256])(c, parts, mn, used);
    }

    /** The kernel {@link #tiled128} runs on this backend. */
    public static #String tiled128Member() {
        if (Gemm.unrolledPays("gemmTiled128Unrolled_float32")) { return "gemmTiled128Unrolled_float32".clone(); }
        return "gemmTiled128_float32".clone();
    }

    /**
     * Rule R1 for the unrolled wide tiles: the body runs where the backend built it and its
     * build spills nothing. The float32 (tiled128) and bfloat16 (wide) members answer for
     * every element type; where that member was not instantiated the rolled body runs.
     */
    static boolean unrolledPays(String kernel) {
        if (!Device.kernelAvailable(kernel)) { return false; }
        KernelFacts kf #= KernelFacts.measured(kernel, 0);
        return kf.spillBytes == 0;
    }

    /** The plain tile over a leading batch axis: workgroup (batch, mi, nj). */
    @Kernel
    public static void gemmTiledBatched<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, uint32 m, uint32 n, uint32 k) {
        Shared<float32> sa = shared float32[256];
        Shared<float32> sb = shared float32[256];
        uint32 t = KernelThread.x();
        uint32 r = t / 16;
        uint32 cc = t - r * 16;
        uint32 mtiles = (m + 15) / 16;
        uint32 ntiles = (n + 15) / 16;
        uint32 tiles = mtiles * ntiles;
        uint32 wid = Workgroup.x();
        uint32 bt = wid / tiles;
        uint32 rem = wid - bt * tiles;
        uint32 mi = rem / ntiles;
        uint32 nj = rem - mi * ntiles;
        uint32 abase = bt * m * k;
        uint32 bbase = bt * k * n;
        uint32 gm = mi * 16 + r;
        uint32 gn = nj * 16 + cc;
        float32 acc = 0.0f;
        uint32 ktiles = (k + 15) / 16;
        uint32 kk = 0;
        while (kk < ktiles) {
            uint32 gk = kk * 16 + cc;
            float32 va = 0.0f;
            if (gm < m && gk < k) { va = (float32) a[abase + gm * k + gk]; }
            sa[t] = va;
            uint32 gk2 = kk * 16 + r;
            float32 vb = 0.0f;
            if (gk2 < k && gn < n) { vb = (float32) b[bbase + gk2 * n + gn]; }
            sb[t] = vb;
            Barrier.workgroup();
            uint32 p = 0;
            while (p < 16) {
                acc = acc + sa[r * 16 + p] * sb[p * 16 + cc];
                p = p + 1;
            }
            Barrier.workgroup();
            kk = kk + 1;
        }
        if (gm < m && gn < n) { c[bt * m * n + gm * n + gn] = (E) acc; }
    }

    /** `c` (batch x m x n) = `a` (batch x m x k) . `b` (batch x k x n) at E through the plain tile; queued on the current stream. */
    public static void tiledBatched<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k, int64 batch) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemmTiledBatched.launch(s, grid: [tiles * (uint32) batch], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /**
     * The number of 128x128 tiles of an m x n result at or above which the large members
     * win. Measured on the RTX 4090 (sm_89, 128 SMs) on 2026-11-09: at 16 tiles (512^2) the
     * 16x16 members tie or win, at 64 (1024^2) the large ones run 1.5x (f16) and 2.7x (f32)
     * faster, and a single row or n = 64 never fills enough tiles to pay.
     */
    public static final int64 LARGE_TILES = 32L;

    /** Whether an m x n result has enough 128x128 tiles for the large members. */
    public static boolean large(int64 m, int64 n) {
        return ((m + 127L) / 128L) * ((n + 127L) / 128L) >= Gemm.LARGE_TILES;
    }

    /**
     * `c` (m x n) = `a` (m x k) . `b` (k x n), all at E; queued on the current stream. A shape with LARGE_TILES or
     * more 128x128 tiles runs on the wide register tile (one fused rounding per step), any
     * other on the plain tile (a sequential float32 sum).
     */
    public static void tiled<E>(KernelBuffer<E> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 splits = Gemm.splitsFor(m, n, k);
        if (splits > (uint32) 1 && Gemm.splitKRuns()) { Gemm.tiled128Split<E>(c, a, b, m, n, k, splits); return; }
        if (Gemm.large(m, n)) { Gemm.tiled128<E>(c, a, b, m, n, k); return; }
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemmTiled.launch(s, grid: [tiles], block: [256])(c, a, b, um, un, (uint32) k);
    }

    /** `c` (m x n, float32) = `a` (m x k) . `b` (k x n) at E through the 16x16 member; queued on the current stream. For f16 and bf16 at Gemm.large shapes, run128 is the faster member (run is instantiated at float32 too, where a 128x128 software tile would not pay). */
    public static void run<E>(KernelBuffer<float32> c, KernelBuffer<E> a, KernelBuffer<E> b, int64 m, int64 n, int64 k) {
        uint32 um = (uint32) m;
        uint32 un = (uint32) n;
        uint32 uk = (uint32) k;
        uint32 tiles = ((um + 15) / 16) * ((un + 15) / 16);
        KernelStream s #= KernelStream.current();
        gemm16.launch(s, grid: [tiles], block: [64])(c, a, b, um, un, uk);
    }
}

/** A split count as a tile family member: 1 is the plain f16 kernel, 2, 4 and 8 the split kernels. */
final class SplitShape implements TileShape {
    int32 v;
    public SplitShape(int32 v) { this.v = v; }
    static int64 splitsOf(int32 idx) { if (idx == 1) { return 2L; } if (idx == 2) { return 4L; } if (idx == 3) { return 8L; } return 1L; }
    public #String kernel() {
        if (this.v == 2) { return "split2_float16"; }
        if (this.v == 4) { return "split4_float16"; }
        if (this.v == 8) { return "split8_float16"; }
        return "gemm16_float16";
    }
    public int32 tileM() { return 16; }
    public int32 tileN() { return 16; }
    public int32 threads() { return 64; }
    /** A split needs at least one 16-wide K step per part. */
    public boolean fits(int64 rows, int64 outDim, int64 cols) { return cols >= 16L * (int64) this.v; }
}

/** Times one surviving split count at the probe's shape into a scratch C. */
final class SplitProbe implements ShapeProbe {
    KernelBuffer<float16> a;
    KernelBuffer<float16> b;
    ShapeFilter filter;
    TileFamily<SplitShape> fam;
    KernelBuffer<float32> scratch;
    int64 m;
    int64 n;
    int64 k;
    public int32 timed = 0;

    public SplitProbe(^KernelBuffer<float16> a, ^KernelBuffer<float16> b, ^ShapeFilter filter, ^TileFamily<SplitShape> fam,
                      int64 m, int64 n, int64 k) {
        this.a = a;
        this.b = b;
        this.filter = filter;
        this.fam = fam;
        this.m = m;
        this.n = n;
        this.k = k;
        this.scratch = heap KernelBuffer<float32>((uint64) (m * n));
    }

    public int64 timeNanos(int32 i) {
        this.timed = this.timed + 1;
        int32 idx = this.fam.indexOf(this.filter.survivor(i).candidate.kernel);
        int64 t0 = Clock.nanoTime();
        Gemm.splitKF16(this.scratch, this.a, this.b, this.m, this.n, this.k, SplitShape.splitsOf(idx));
        return Clock.nanoTime() - t0;
    }
}

/** A large-GEMM family member: its registered kernel, its tile rows (128 or 256, 128 columns) and threads; every member covers every shape. */
final class LargeShape implements TileShape {
    String kn;
    int32 rows;
    int32 nthreads;
    public LargeShape(String kn, int32 rows, int32 nthreads) {
        this.kn #= kn.clone();
        this.rows = rows;
        this.nthreads = nthreads;
    }
    public #String kernel() { return this.kn.clone(); }
    public int32 tileM() { return this.rows; }
    public int32 tileN() { return 128; }
    public int32 threads() { return this.nthreads; }
    public boolean fits(int64 rows, int64 outDim, int64 cols) { return true; }
}

/** Times one surviving large-GEMM member at the probe's f16 shape into a scratch C. */
final class LargeProbeF16 implements ShapeProbe {
    KernelBuffer<float16> a;
    KernelBuffer<float16> b;
    ShapeFilter filter;
    TileFamily<LargeShape> fam;
    KernelBuffer<float32> scratch;
    int64 m;
    int64 n;
    int64 k;
    public int32 timed = 0;

    public LargeProbeF16(^KernelBuffer<float16> a, ^KernelBuffer<float16> b, ^ShapeFilter filter, ^TileFamily<LargeShape> fam,
                         int64 m, int64 n, int64 k) {
        this.a = a;
        this.b = b;
        this.filter = filter;
        this.fam = fam;
        this.m = m;
        this.n = n;
        this.k = k;
        this.scratch = heap KernelBuffer<float32>((uint64) (m * n));
    }

    public int64 timeNanos(int32 i) {
        this.timed = this.timed + 1;
        int32 idx = this.fam.indexOf(this.filter.survivor(i).candidate.kernel);
        int64 t0 = Clock.nanoTime();
        if (idx == 1) { Gemm.run256<float16>(this.scratch, this.a, this.b, this.m, this.n, this.k); }
        else { Gemm.run128<float16>(this.scratch, this.a, this.b, this.m, this.n, this.k); }
        KernelStream.current().sync();
        return Clock.nanoTime() - t0;
    }
}

/** The bf16 form of LargeProbeF16. */
final class LargeProbeBf16 implements ShapeProbe {
    KernelBuffer<bfloat16> a;
    KernelBuffer<bfloat16> b;
    ShapeFilter filter;
    TileFamily<LargeShape> fam;
    KernelBuffer<float32> scratch;
    int64 m;
    int64 n;
    int64 k;
    public int32 timed = 0;

    public LargeProbeBf16(^KernelBuffer<bfloat16> a, ^KernelBuffer<bfloat16> b, ^ShapeFilter filter, ^TileFamily<LargeShape> fam,
                          int64 m, int64 n, int64 k) {
        this.a = a;
        this.b = b;
        this.filter = filter;
        this.fam = fam;
        this.m = m;
        this.n = n;
        this.k = k;
        this.scratch = heap KernelBuffer<float32>((uint64) (m * n));
    }

    public int64 timeNanos(int32 i) {
        this.timed = this.timed + 1;
        int32 idx = this.fam.indexOf(this.filter.survivor(i).candidate.kernel);
        int64 t0 = Clock.nanoTime();
        if (idx == 1) { Gemm.run256Bf16(this.scratch, this.a, this.b, this.m, this.n, this.k); }
        else { Gemm.runBf16(this.scratch, this.a, this.b, this.m, this.n, this.k); }
        KernelStream.current().sync();
        return Clock.nanoTime() - t0;
    }
}
