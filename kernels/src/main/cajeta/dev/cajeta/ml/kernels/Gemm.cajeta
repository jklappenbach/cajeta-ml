            if (wave / 2 == 6) { a12.store(sc, (wave % 2) * 256, 0, 16); }
            Barrier.shared();
            if (wave / 2 == 6) {
                uint32 rr = m0 + wm * 32 + 16;
                uint32 cc = n0 + wn * 64 + 32;
                uint32 e = lane;
                while (e < 256) {
                    uint32 er = e / 16;
                    uint32 ec = e - er * 16;
                    if (rr + er < m && cc + ec < n) { c[(rr + er) * n + cc + ec] = sc[(wave % 2) * 256 + e]; }
                    e = e + 32;
