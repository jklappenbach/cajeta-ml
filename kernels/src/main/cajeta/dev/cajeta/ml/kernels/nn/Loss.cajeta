package dev.cajeta.ml.kernels.nn;

import cajeta.lang.Math;
import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/** Row losses (spec §6.6): the negative log-likelihood of a class id against a probability row, and the row-wise cosine similarity with its saved norms. */
public final class Loss {
    public Loss() { return; }

    /** rowLoss[r] = -log(probs[r][targets[r]]); an id outside [0, cls) gives NaN. */
    @Kernel
    public static void nll<E>(KernelBuffer<E> rowLoss, KernelBuffer<E> probs, KernelBuffer<E> targets, uint32 rows, uint32 cls) {
        uint32 r = KernelThread.globalIdX();
        if (r < rows) {
            float32 tf = (float32) targets[r];
            float32 v = 0.0f / 0.0f;
            if (tf >= 0.0f && tf < (float32) cls) {
                uint32 t = (uint32) tf;
                v = 0.0f - Math.log((float32) probs[r * cls + t]);
            }
            rowLoss[r] = (E) v;
        }
    }

    /** One workgroup per row: out[r] = a.b / max(|a||b|, eps), cache[3r..] = |a|, |b|, cos. */
    @Kernel
    public static void cosine<E>(KernelBuffer<E> out, KernelBuffer<E> cache, KernelBuffer<E> a, KernelBuffer<E> b, uint32 d, float32 eps) {
        Shared<float32> pd = shared float32[256];
        Shared<float32> pa = shared float32[256];
        Shared<float32> pb = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 r = Workgroup.x();
        uint32 base = r * d;
        float32 dot = 0.0f;
        float32 na = 0.0f;
        float32 nb = 0.0f;
        uint32 i = lane;
        while (i < d) {
            float32 av = (float32) a[base + i];
            float32 bv = (float32) b[base + i];
            dot = dot + av * bv;
            na = na + av * av;
            nb = nb + bv * bv;
            i = i + 256;
        }
        pd[lane] = dot;
        pa[lane] = na;
        pb[lane] = nb;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) {
                pd[lane] = pd[lane] + pd[lane + s];
                pa[lane] = pa[lane] + pa[lane + s];
                pb[lane] = pb[lane] + pb[lane + s];
            }
            Barrier.workgroup();
            s = s / 2;
        }
        if (lane == 0) {
            float32 la = Math.sqrt(pa[0]);
            float32 lb = Math.sqrt(pb[0]);
            float32 den = la * lb;
            if (den < eps) { den = eps; }
            float32 cos = pd[0] / den;
            cache[r * 3] = (E) la;
            cache[r * 3 + 1] = (E) lb;
            cache[r * 3 + 2] = (E) cos;
            out[r] = (E) cos;
        }
    }

    /** rowLoss[r] = -log(probs[r][targets[r]]) over `rows` rows of `cls` classes; synced. */
    public static void nllRows<E>(KernelBuffer<E> rowLoss, KernelBuffer<E> probs, KernelBuffer<E> targets, int64 rows, int64 cls) {
        uint32 ur = (uint32) rows;
        KernelStream s #= KernelStream.current();
        nll.launch(s, grid: [(ur + 255) / 256], block: [256])(rowLoss, probs, targets, ur, (uint32) cls);
        s.sync();
    }

    /** Row-wise cosine similarity of `a` and `b` (rows x d) with the saved norms; synced. */
    public static void cosineRows<E>(KernelBuffer<E> out, KernelBuffer<E> cache, KernelBuffer<E> a, KernelBuffer<E> b, int64 rows, int64 d, float32 eps) {
        KernelStream s #= KernelStream.current();
        cosine.launch(s, grid: [(uint32) rows], block: [256])(out, cache, a, b, (uint32) d, eps);
        s.sync();
    }
}
