package dev.cajeta.ml.kernels.nn;

import cajeta.lang.Math;
import cajeta.xpu.Barrier;
import cajeta.xpu.GroupOp;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/** Row losses (spec §6.6): the negative log-likelihood of a class id against a probability row, and the row-wise cosine similarity with its saved norms. */
public final class Loss {
    public Loss() { return; }

    /** rowLoss[r] = -log(probs[r][targets[r]]); an id outside [0, cls) gives NaN. */
    @Kernel
    public static void nll<E>(KernelBuffer<E> rowLoss, KernelBuffer<E> probs, KernelBuffer<E> targets, uint32 rows, uint32 cls) {
        uint32 r = KernelThread.globalIdX();
        if (r < rows) {
            float32 tf = (float32) targets[r];
            float32 v = 0.0f / 0.0f;
            if (tf >= 0.0f && tf < (float32) cls) {
                uint32 t = (uint32) tf;
                v = 0.0f - Math.log((float32) probs[r * cls + t]);
            }
            rowLoss[r] = (E) v;
        }
    }

    /** out[0] = mean of v[0..rows): one workgroup, a strided sum per lane and one collective. */
    @Kernel
    public static void meanRows<E>(KernelBuffer<E> out, KernelBuffer<E> v, uint32 rows) {
        uint32 lane = KernelThread.x();
        float32 acc = 0.0f;
        uint32 i = lane;
        while (i < rows) { acc = acc + (float32) v[i]; i = i + 256; }
        float32 tot = Workgroup.reduce(GroupOp.Add, acc);
        if (lane == 0) { out[0] = (E) (tot / (float32) rows); }
    }

    /** One workgroup per row: out[r] = a.b / max(|a||b|, eps), cache[3r..] = |a|, |b|, cos. */
    @Kernel
    public static void cosine<E>(KernelBuffer<E> out, KernelBuffer<E> cache, KernelBuffer<E> a, KernelBuffer<E> b, uint32 d, float32 eps) {
        Shared<float32> pd = shared float32[256];
        Shared<float32> pa = shared float32[256];
        Shared<float32> pb = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 r = Workgroup.x();
        uint32 base = r * d;
        float32 dot = 0.0f;
        float32 na = 0.0f;
        float32 nb = 0.0f;
        uint32 i = lane;
        while (i < d) {
            float32 av = (float32) a[base + i];
            float32 bv = (float32) b[base + i];
            dot = dot + av * bv;
            na = na + av * av;
            nb = nb + bv * bv;
            i = i + 256;
        }
        pd[lane] = dot;
        pa[lane] = na;
        pb[lane] = nb;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) {
                pd[lane] = pd[lane] + pd[lane + s];
                pa[lane] = pa[lane] + pa[lane + s];
                pb[lane] = pb[lane] + pb[lane + s];
            }
            Barrier.workgroup();
            s = s / 2;
        }
        if (lane == 0) {
            float32 la = Math.sqrt(pa[0]);
            float32 lb = Math.sqrt(pb[0]);
            float32 den = la * lb;
            if (den < eps) { den = eps; }
            float32 cos = pd[0] / den;
            cache[r * 3] = (E) la;
            cache[r * 3 + 1] = (E) lb;
            cache[r * 3 + 2] = (E) cos;
            out[r] = (E) cos;
        }
    }

    /** rowLoss[r] = -log(probs[r][targets[r]]) over `rows` rows of `cls` classes; queued on the current stream. */
    public static void nllRows<E>(KernelBuffer<E> rowLoss, KernelBuffer<E> probs, KernelBuffer<E> targets, int64 rows, int64 cls) {
        uint32 ur = (uint32) rows;
        KernelStream s #= KernelStream.current();
        nll.launch(s, grid: [(ur + 255) / 256], block: [256])(rowLoss, probs, targets, ur, (uint32) cls);
    }

    /** Row-wise cosine similarity of `a` and `b` (rows x d) with the saved norms; queued on the current stream. */
    public static void cosineRows<E>(KernelBuffer<E> out, KernelBuffer<E> cache, KernelBuffer<E> a, KernelBuffer<E> b, int64 rows, int64 d, float32 eps) {
        KernelStream s #= KernelStream.current();
        cosine.launch(s, grid: [(uint32) rows], block: [256])(out, cache, a, b, (uint32) d, eps);
    }

    /** dlogits = (softmax(x) - onehot(target)) * g[0] / rows with softmax(x) = exp(x - lse[row]), one lane per element. */
    @Kernel
    public static void nllBack<E>(KernelBuffer<E> dx, KernelBuffer<E> x, KernelBuffer<E> lse, KernelBuffer<E> targets, KernelBuffer<E> g, uint32 rows, uint32 cls) {
        uint32 t = KernelThread.globalIdX();
        if (t < rows * cls) {
            uint32 r = t / cls;
            uint32 j = t - r * cls;
            float32 v = Math.exp((float32) x[t] - (float32) lse[r]);
            if ((float32) j == (float32) targets[r]) { v = v - 1.0f; }
            dx[t] = (E) (v * (float32) g[0] / (float32) rows);
        }
    }

    /** d cos / d src = other / max(|a||b|, eps) - cos * src / max(|src|^2, eps), scaled by the row's g. */
    @Kernel
    public static void cosineBack<E>(KernelBuffer<E> dsrc, KernelBuffer<E> g, KernelBuffer<E> src, KernelBuffer<E> other, KernelBuffer<E> cache,
                                     uint32 rows, uint32 d, float32 eps, int32 wantA) {
        uint32 t = KernelThread.globalIdX();
        if (t < rows * d) {
            uint32 r = t / d;
            float32 na = (float32) cache[r * 3];
            float32 nb = (float32) cache[r * 3 + 1];
            float32 cos = (float32) cache[r * 3 + 2];
            float32 ns = na;
            if (wantA == 0) { ns = nb; }
            float32 den = na * nb;
            if (den < eps) { den = eps; }
            float32 ns2 = ns * ns;
            if (ns2 < eps) { ns2 = eps; }
            dsrc[t] = (E) ((float32) g[r] * ((float32) other[t] / den - cos * (float32) src[t] / ns2));
        }
    }

    /** The cross-entropy VJP over `rows` rows of `cls` classes from the logits, their saved lse and the scalar cotangent `g`; queued on the current stream. */
    public static void nllBackward<E>(KernelBuffer<E> dx, KernelBuffer<E> x, KernelBuffer<E> lse, KernelBuffer<E> targets, KernelBuffer<E> g, int64 rows, int64 cls) {
        uint32 total = (uint32) (rows * cls);
        KernelStream s #= KernelStream.current();
        nllBack.launch(s, grid: [(total + 255) / 256], block: [256])(dx, x, lse, targets, g, (uint32) rows, (uint32) cls);
    }

    /** out[0] = the mean of `rows` row values in one workgroup; queued on the current stream. */
    public static void meanOf<E>(KernelBuffer<E> out, KernelBuffer<E> rowLoss, int64 rows) {
        KernelStream s #= KernelStream.current();
        meanRows.launch(s, grid: [1], block: [256])(out, rowLoss, (uint32) rows);
    }

    /** The cosine VJP for `src` against `other` from the per-row cotangent `g` and the forward's cache; queued on the current stream. */
    public static void cosineBackward<E>(KernelBuffer<E> dsrc, KernelBuffer<E> g, KernelBuffer<E> src, KernelBuffer<E> other, KernelBuffer<E> cache,
                                         int64 rows, int64 d, float32 eps, boolean wantA) {
        int32 wa = 0;
        if (wantA) { wa = 1; }
        uint32 total = (uint32) (rows * d);
        KernelStream s #= KernelStream.current();
        cosineBack.launch(s, grid: [(total + 255) / 256], block: [256])(dsrc, g, src, other, cache, (uint32) rows, (uint32) d, eps, wa);
    }
}
