package dev.cajeta.ml.kernels.gemm;

import cajeta.lang.String;
import cajeta.xpu.Group;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;
import dev.cajeta.ml.kernels.quant.Q6kBlock;

/**
 * The GPU f16 batched decode of the 16-value K formats with an offset and no min (kernel-drivers
 * plan 9.1.7.3): up to eight slot-major f16 token rows ({@link F16Cols}) against one file-layout
 * row a wave. Lane `(g, a)` of a block's four takes the runs `128 g + 32 t + 16 a ..`, each as f16
 * `q - offset()` against two slot vectors, scaled by `d` times its sub-block's scale; with `H` 1 a
 * lane group takes half a block (two runs) a pass. That is cajeta-llm's `q6kF16WaveMatVecColsKernel`
 * (`H` 0) and `q6kF16HalfWaveMatVecColsKernel` (`H` 1), so each column equals its kernel's bit for
 * bit (spec 7.9).
 */
@Instantiate(value = {BlockGemvF16Cols<Q6kBlock, 0>, BlockGemvF16Cols<Q6kBlock, 1>}, max = 4)
@Requires(H < 2)
public final class BlockGemvF16Cols<P, uint32 H> {
    public BlockGemvF16Cols() { return; }

    /** This instantiation's registered kernel. */
    public #String kernel() { return "" + colsWave.registeredName(); }

    /** Quant words `q` as f16 `q - offset()`: bytes 0 to 7 into `lo`'s lanes, 8 to 15 into the result. */
    @Device
    static Vector<float16,8> lowHalf(Vector<int32,4> q) {
        Vector<float32,8> k = heap Vector<float32,8>((float32) P.offset(), (float32) P.offset(), (float32) P.offset(),
            (float32) P.offset(), (float32) P.offset(), (float32) P.offset(), (float32) P.offset(), (float32) P.offset());
        return (q.asBytes().asUnsigned().widenLo().toF32() - k).toF16();
    }

    /** {@link #lowHalf} on bytes 8 to 15. */
    @Device
    static Vector<float16,8> highHalf(Vector<int32,4> q) {
        Vector<float32,8> k = heap Vector<float32,8>((float32) P.offset(), (float32) P.offset(), (float32) P.offset(),
            (float32) P.offset(), (float32) P.offset(), (float32) P.offset(), (float32) P.offset(), (float32) P.offset());
        return (q.asBytes().asUnsigned().widenHi().toF32() - k).toF16();
    }

    /** Column `c` of up to eight to `y[yOff + c * yStride + r]`, set or added (`accum` 1); the token rows `xStride` halves apart from `xOff`, `blocksPerRow` 256-value blocks a row. */
    @Kernel(targets = {"gpu"})
    @Occupancy(maxThreads = 256)
    public static void colsWave(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<float16> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff, uint32 accum, uint32 ncols, uint32 yStride, uint32 xStride) {
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 row = KernelThread.globalIdX() / wv;
        int64 bb = (int64) P.blockBytes();
        uint32 bpr = (uint32) blocksPerRow;
        int64 xs = (int64) xStride;
        uint32 nr = H == 1 ? 2 : 4;
        uint32 passes = H == 1 ? 2 * bpr : bpr;
        float32 c0 = 0.0f;
        float32 c1 = 0.0f;
        float32 c2 = 0.0f;
        float32 c3 = 0.0f;
        float32 c4 = 0.0f;
        float32 c5 = 0.0f;
        float32 c6 = 0.0f;
        float32 c7 = 0.0f;
        if (row < rows) {
            int64 rb = (int64) row * blocksPerRow * bb;
            int32 m = (int32) (lane % 4);
            int32 g = m / 2;
            int32 a = m - g * 2;
            uint32 u = lane / 4;
            while (u < passes) {
                uint32 b = u;
                uint32 h = 0;
                if (H == 1) { b = u / 2; h = u - b * 2; }
                int64 js = F16Cols.slotStride(b, bpr);
                int64 xa = F16Cols.slotBase(xOff, b, bpr, m) + (int64) (4 * h) * js;
                int64 ob = rb + (int64) b * bb;
                uint32 k0 = (uint32) (128 * g + 16 * a);
                Vector<int32,4> wA = w.vload<16>(ob + (int64) P.quantByte(k0)).asWords();
                Vector<int32,4> wB = w.vload<16>(ob + (int64) P.quantByte(k0 + 32)).asWords();
                Vector<int32,4> wH = w.vload<16>(ob + (int64) P.planeByte(k0)).asWords();
                Vector<int32,4> ha = w.vload<16>(ob + (int64) P.headOffset()).asWords();
                Vector<int32,4> hb = w.vload<16>(ob + (int64) P.head2Offset()).asWords();
                float32 d = P.dOf(ha, hb);
                uint32 j0 = (uint32) (8 * g + a) + 4 * h;
                Vector<int32,4> q0 = P.lowWords(wA, wH, 0);
                Vector<int32,4> q1 = P.lowWords(wB, wH, 1);
                Vector<int32,4> q2 = P.highWords(wA, wH, 0);
                Vector<int32,4> q3 = P.highWords(wB, wH, 1);
                if (h != 0) {
                    q0 = q2;
                    q1 = q3;
                }
                float32 e0 = d * (float32) P.scaleOf(ha, hb, j0);
                float32 e1 = d * (float32) P.scaleOf(ha, hb, j0 + 2);
                float32 e2 = d * (float32) P.scaleOf(ha, hb, j0 + 4);
                float32 e3 = d * (float32) P.scaleOf(ha, hb, j0 + 6);
                Vector<float16,8> wl0 = BlockGemvF16Cols.lowHalf(q0);
                Vector<float16,8> wh0 = BlockGemvF16Cols.highHalf(q0);
                Vector<float16,8> wl1 = BlockGemvF16Cols.lowHalf(q1);
                Vector<float16,8> wh1 = BlockGemvF16Cols.highHalf(q1);
                Vector<float16,8> wl2 = BlockGemvF16Cols.lowHalf(q2);
                Vector<float16,8> wh2 = BlockGemvF16Cols.highHalf(q2);
                Vector<float16,8> wl3 = BlockGemvF16Cols.lowHalf(q3);
                Vector<float16,8> wh3 = BlockGemvF16Cols.highHalf(q3);
                c0 = F16Cols.col(c0, x, xa, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3);
                if (ncols > 1) { c1 = F16Cols.col(c1, x, xa + xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                if (ncols > 2) { c2 = F16Cols.col(c2, x, xa + 2L * xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                if (ncols > 3) { c3 = F16Cols.col(c3, x, xa + 3L * xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                if (ncols > 4) { c4 = F16Cols.col(c4, x, xa + 4L * xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                if (ncols > 5) { c5 = F16Cols.col(c5, x, xa + 5L * xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                if (ncols > 6) { c6 = F16Cols.col(c6, x, xa + 6L * xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                if (ncols > 7) { c7 = F16Cols.col(c7, x, xa + 7L * xs, js, nr, wl0, wh0, wl1, wh1, wl2, wh2, wl3, wh3, e0, e1, e2, e3); }
                u = u + wv / 4;
            }
        }
        WaveCols.store(y, row, rows, yOff, yStride, accum, ncols, lane, c0, c1, c2, c3, c4, c5, c6, c7);
    }

    /** `ncols` (1 to 8) slot-major f16 token rows `xStride` halves apart from `xOff` against `rows` file-layout rows of `cols / 256` blocks, column `c` into `y[yOff + c * yStride ..)`, set or added. Queued on `s`. */
    public void runColsOn(KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<float16> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff, int64 ncols, int64 yStride, int64 xStride, boolean accum,
            int64 wavesPerBlock, int64 waveWidth) {
        int64 groups = (rows + wavesPerBlock - 1L) / wavesPerBlock;
        colsWave.launch(s, grid: [(uint32) groups], block: [(uint32) (wavesPerBlock * waveWidth)])
            (y, w, x, (uint32) rows, cols / 256L, xOff, yOff, accum ? 1 : 0, (uint32) ncols, (uint32) yStride, (uint32) xStride);
    }
}
