package dev.cajeta.ml.kernels.nn;

import cajeta.lang.Math;
import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;

/** Batch normalisation over NCHW (spec §6.6): per-channel statistics as one workgroup per channel, then the normalise with the saved xhat and 1/std. */
public final class BatchNorm {
    public BatchNorm() { return; }

    /** mean[ci] and the biased var[ci] over (n, hw), two shared-memory trees. */
    @Kernel
    public static void stats<E>(KernelBuffer<E> mean, KernelBuffer<E> var, KernelBuffer<E> x, uint32 n, uint32 c, uint32 hw) {
        Shared<float32> part = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 ci = Workgroup.x();
        uint32 count = n * hw;
        float32 acc = 0.0f;
        uint32 i = lane;
        while (i < count) {
            uint32 bn = i / hw;
            uint32 p = i - bn * hw;
            acc = acc + (float32) x[(bn * c + ci) * hw + p];
            i = i + 256;
        }
        part[lane] = acc;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        float32 mu = part[0] / (float32) count;
        Barrier.workgroup();
        float32 dev = 0.0f;
        i = lane;
        while (i < count) {
            uint32 bn = i / hw;
            uint32 p = i - bn * hw;
            float32 d = (float32) x[(bn * c + ci) * hw + p] - mu;
            dev = dev + d * d;
            i = i + 256;
        }
        part[lane] = dev;
        Barrier.workgroup();
        s = 128;
        while (s > 0) {
            if (lane < s) { part[lane] = part[lane] + part[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        if (lane == 0) {
            mean[ci] = (E) mu;
            var[ci] = (E) (part[0] / (float32) count);
        }
    }

    /** out = gamma * xhat + beta with xhat = (x - mean) / sqrt(var + eps); xhat and invstd saved. */
    @Kernel
    public static void normalize<E>(KernelBuffer<E> out, KernelBuffer<E> xhat, KernelBuffer<E> invstd, KernelBuffer<E> x,
                                    KernelBuffer<E> gamma, KernelBuffer<E> beta, KernelBuffer<E> mean, KernelBuffer<E> var,
                                    uint32 n, uint32 c, uint32 hw, float32 eps) {
        uint32 t = KernelThread.globalIdX();
        if (t < n * c * hw) {
            uint32 plane = t / hw;
            uint32 ci = plane % c;
            float32 iv = 1.0f / Math.sqrt((float32) var[ci] + eps);
            float32 xh = ((float32) x[t] - (float32) mean[ci]) * iv;
            xhat[t] = (E) xh;
            out[t] = (E) ((float32) gamma[ci] * xh + (float32) beta[ci]);
            if (t < c * hw && t - plane * hw == 0) { invstd[ci] = (E) iv; }
        }
    }

    /** Per-channel mean and biased variance of `x` (n, c, hw); synced. */
    public static void channelStats<E>(KernelBuffer<E> mean, KernelBuffer<E> var, KernelBuffer<E> x, int64 n, int64 c, int64 hw) {
        KernelStream s #= KernelStream.current();
        stats.launch(s, grid: [(uint32) c], block: [256])(mean, var, x, (uint32) n, (uint32) c, (uint32) hw);
        s.sync();
    }

    /** The normalise with the given statistics, saving xhat and invstd; synced. */
    public static void apply<E>(KernelBuffer<E> out, KernelBuffer<E> xhat, KernelBuffer<E> invstd, KernelBuffer<E> x,
                                KernelBuffer<E> gamma, KernelBuffer<E> beta, KernelBuffer<E> mean, KernelBuffer<E> var,
                                int64 n, int64 c, int64 hw, float32 eps) {
        uint32 total = (uint32) (n * c * hw);
        KernelStream s #= KernelStream.current();
        normalize.launch(s, grid: [(total + 255) / 256], block: [256])(out, xhat, invstd, x, gamma, beta, mean, var,
            (uint32) n, (uint32) c, (uint32) hw, eps);
        s.sync();
    }

    /** dgamma[ci] = sum g*xhat and dbeta[ci] = sum g over (n, hw): one workgroup per channel. */
    @Kernel
    public static void bnParamGrads<E>(KernelBuffer<E> dgamma, KernelBuffer<E> dbeta, KernelBuffer<E> g, KernelBuffer<E> xhat, uint32 n, uint32 c, uint32 hw) {
        Shared<float32> pa = shared float32[256];
        Shared<float32> pb = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 ci = Workgroup.x();
        uint32 count = n * hw;
        float32 sa = 0.0f;
        float32 sb = 0.0f;
        uint32 i = lane;
        while (i < count) {
            uint32 bn = i / hw;
            uint32 idx = (bn * c + ci) * hw + (i - bn * hw);
            float32 gv = (float32) g[idx];
            sa = sa + gv * (float32) xhat[idx];
            sb = sb + gv;
            i = i + 256;
        }
        pa[lane] = sa;
        pb[lane] = sb;
        Barrier.workgroup();
        uint32 s = 128;
        while (s > 0) {
            if (lane < s) { pa[lane] = pa[lane] + pa[lane + s]; pb[lane] = pb[lane] + pb[lane + s]; }
            Barrier.workgroup();
            s = s / 2;
        }
        if (lane == 0) { dgamma[ci] = (E) pa[0]; dbeta[ci] = (E) pb[0]; }
    }

    /** dx from g with the channel sums: training uses the full batch rule, eval g * gamma * invstd. */
    @Kernel
    public static void bnBackIn<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> xhat, KernelBuffer<E> gamma, KernelBuffer<E> invstd,
                                 KernelBuffer<E> dgamma, KernelBuffer<E> dbeta, uint32 n, uint32 c, uint32 hw, int32 training) {
        uint32 t = KernelThread.globalIdX();
        if (t < n * c * hw) {
            uint32 ci = (t / hw) % c;
            float32 gv = (float32) gamma[ci];
            float32 iv = (float32) invstd[ci];
            float32 dxh = (float32) g[t] * gv;
            if (training == 0) {
                dx[t] = (E) (dxh * iv);
            } else {
                float32 m = (float32) (n * hw);
                float32 sumDx = gv * (float32) dbeta[ci];
                float32 sumDxXh = gv * (float32) dgamma[ci];
                dx[t] = (E) (iv / m * (m * dxh - sumDx - (float32) xhat[t] * sumDxXh));
            }
        }
    }

    /** Per-channel dgamma = sum g*xhat and dbeta = sum g; synced. */
    public static void channelParamGrads<E>(KernelBuffer<E> dgamma, KernelBuffer<E> dbeta, KernelBuffer<E> g, KernelBuffer<E> xhat, int64 n, int64 c, int64 hw) {
        KernelStream s #= KernelStream.current();
        bnParamGrads.launch(s, grid: [(uint32) c], block: [256])(dgamma, dbeta, g, xhat, (uint32) n, (uint32) c, (uint32) hw);
        s.sync();
    }

    /** The input VJP from g, the saved xhat and invstd and the channel sums; synced. */
    public static void backwardInput<E>(KernelBuffer<E> dx, KernelBuffer<E> g, KernelBuffer<E> xhat, KernelBuffer<E> gamma, KernelBuffer<E> invstd,
                                        KernelBuffer<E> dgamma, KernelBuffer<E> dbeta, int64 n, int64 c, int64 hw, boolean training) {
        int32 tr = 0;
        if (training) { tr = 1; }
        uint32 total = (uint32) (n * c * hw);
        KernelStream s #= KernelStream.current();
        bnBackIn.launch(s, grid: [(total + 255) / 256], block: [256])(dx, g, xhat, gamma, invstd, dgamma, dbeta, (uint32) n, (uint32) c, (uint32) hw, tr);
        s.sync();
    }
}
