package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.Math;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.nn.SpelaHead;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/**
 * spela-kernels 4.1.1, 4.1.2, 5.1: SPELA's loss head, the loss and the gradient of a layer's
 * output, against a float64 host reference: cosface (scale 30, margin 0 and 0.35) and cosine,
 * with and without a row mask, 37 rows of width 70. The few-class route runs at 5 classes; the
 * many-class route at 300 in blocks of 128, so three blocks with a ragged last one.
 */
public class SpelaHeadTest {
    public SpelaHeadTest() { return; }

    static boolean usable(String kernel) {
        if (!Device.kernelAvailable(kernel)) { DeviceSkip.noKernel(kernel, "spela-kernels 4"); return false; }
        if (!Device.kernelUsable(kernel)) {
            DeviceSkip.tracked(kernel + " on " + Device.activeBackend() + ": " + Device.kernelUnusableReason(kernel), "spela-kernels 4");
            return false;
        }
        return true;
    }

    static float32 pattern(int64 i, float32 step) {
        return (float32) ((((i * 7919L) % 251L) - 125L)) * step;
    }

    static void close(String what, float64 got, float64 want) {
        float64 d = got - want;
        if (d < 0.0) { d = 0.0 - d; }
        float64 w = want;
        if (w < 0.0) { w = 0.0 - w; }
        if (d > 2.0e-5 * (w + 1.0)) {
            System.stdout.println("  " + what + ": got " + got + " want " + want);
            Assert.isTrue(false);
        }
    }

    /** One case on the device and on the host; `mode` 0 cosface, 1 cosine. */
    static void headCase(int32 mode, float32 margin, boolean masked) { SpelaHeadTest.headCaseAt(5L, mode, margin, masked); }

    /** One case at `c` classes, through whichever route the head binds for that count. */
    static void headCaseAt(int64 c, int32 mode, float32 margin, boolean masked) {
        int64 rows = 37L; int64 d = 70L;
        float32 scale = 30.0f;
        float32[] h = heap float32[rows * d];
        float32[] v = heap float32[c * d];
        float32[] lab = heap float32[rows];
        float32[] msk = heap float32[rows];
        int64 i = 0L;
        while (i < rows * d) { h[(int32) i] = SpelaHeadTest.pattern(i + 3L, 0.01f); i = i + 1L; }
        i = 0L;
        while (i < c * d) { v[(int32) i] = SpelaHeadTest.pattern(i + 17L, 0.01f); i = i + 1L; }
        // unit class vectors, as the trainer's are
        int64 k = 0L;
        while (k < c) {
            float64 ss = 0.0;
            int64 j = 0L;
            while (j < d) { ss = ss + (float64) v[(int32) (k * d + j)] * (float64) v[(int32) (k * d + j)]; j = j + 1L; }
            float64 inv = 1.0 / Math.sqrt(ss);
            j = 0L;
            while (j < d) { v[(int32) (k * d + j)] = (float32) ((float64) v[(int32) (k * d + j)] * inv); j = j + 1L; }
            k = k + 1L;
        }
        i = 0L;
        while (i < rows) {
            lab[(int32) i] = (float32) ((i * 3L) % c);
            msk[(int32) i] = 1.0f;
            if (masked && (i % 4L) == 1L) { msk[(int32) i] = 0.0f; }
            i = i + 1L;
        }
        KernelBuffer<float32> dh = heap KernelBuffer<float32>((uint64) (rows * d));
        KernelBuffer<float32> hb = heap KernelBuffer<float32>((uint64) (rows * d));
        KernelBuffer<float32> vb = heap KernelBuffer<float32>((uint64) (c * d));
        KernelBuffer<float32> lb = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> mb = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> loss = heap KernelBuffer<float32>(1);
        int64 pf = SpelaHead.packFloats(c, d);
        if (pf == 0L) { pf = 1L; }
        KernelBuffer<float32> pk = heap KernelBuffer<float32>((uint64) pf);
        hb.upload(h);
        vb.upload(v);
        lb.upload(lab);
        mb.upload(msk);
        float32 uscale = scale;
        if (mode == 1) { uscale = 1.0f; }
        int64[] mk #= ValueCheck.mark();
        // the packing is checked through the many-class outputs that read it
        SpelaHead.pack<float32>(pk, vb, c, d);
        if (masked) { SpelaHead.loss<float32>(loss, dh, hb, vb, pk, lb, mb, rows, d, c, mode, uscale, scale * margin, 0.00000001f); }
        else { SpelaHead.loss<float32>(loss, dh, hb, vb, pk, lb, null, rows, d, c, mode, uscale, scale * margin, 0.00000001f); }
        float32[] got = heap float32[rows * d];
        dh.download(got);
        float32[] gl = heap float32[1];
        loss.download(gl);
        // the host reference in float64
        float64 count = 0.0;
        i = 0L;
        while (i < rows) { count = count + (float64) msk[(int32) i]; i = i + 1L; }
        float64 total = 0.0;
        int64 r = 0L;
        while (r < rows) {
            float64 w = (float64) msk[(int32) r] / count;
            float64 ss = 0.0;
            int64 j = 0L;
            while (j < d) { ss = ss + (float64) h[(int32) (r * d + j)] * (float64) h[(int32) (r * d + j)]; j = j + 1L; }
            float64 nrm = Math.sqrt(ss);
            int64 y = (int64) lab[(int32) r];
            float64[] dots = heap float64[c];
            k = 0L;
            while (k < c) {
                float64 dt = 0.0;
                j = 0L;
                while (j < d) { dt = dt + (float64) h[(int32) (r * d + j)] * (float64) v[(int32) (k * d + j)]; j = j + 1L; }
                dots[(int32) k] = dt;
                k = k + 1L;
            }
            float64[] gc = heap float64[c];
            float64 q = 0.0;
            if (mode == 0) {
                float64[] lg = heap float64[c];
                float64 mx = -1.0e300;
                k = 0L;
                while (k < c) {
                    lg[(int32) k] = (float64) uscale * dots[(int32) k] / nrm;
                    if (k == y) { lg[(int32) k] = lg[(int32) k] - (float64) (scale * margin); }
                    if (lg[(int32) k] > mx) { mx = lg[(int32) k]; }
                    k = k + 1L;
                }
                float64 se = 0.0;
                k = 0L;
                while (k < c) { se = se + Math.exp(lg[(int32) k] - mx); k = k + 1L; }
                float64 lse = mx + Math.log(se);
                total = total + w * (lse - lg[(int32) y]);
                k = 0L;
                while (k < c) {
                    float64 p = Math.exp(lg[(int32) k] - lse);
                    float64 onehot = 0.0;
                    if (k == y) { onehot = 1.0; }
                    gc[(int32) k] = (p - onehot) * w;
                    q = q + gc[(int32) k] * (float64) uscale * dots[(int32) k] / nrm;
                    k = k + 1L;
                }
            } else {
                float64 cosv = dots[(int32) y] / nrm;
                total = total - w * cosv;
                gc[(int32) y] = 0.0 - w;
                q = 0.0 - w * cosv;
            }
            j = 0L;
            while (j < d) {
                float64 acc = 0.0;
                k = 0L;
                while (k < c) { acc = acc + gc[(int32) k] * (float64) v[(int32) (k * d + j)]; k = k + 1L; }
                float64 want = (acc * (float64) uscale - (float64) h[(int32) (r * d + j)] / nrm * q) / nrm;
                SpelaHeadTest.close("dh mode " + mode + " margin " + margin + " masked " + masked + " [" + r + "," + j + "]",
                    (float64) got[(int32) (r * d + j)], want);
                j = j + 1L;
            }
            r = r + 1L;
        }
        SpelaHeadTest.close("loss mode " + mode + " margin " + margin + " masked " + masked, (float64) gl[0], total);
        ValueCheck.credit(mk);
    }

    @Test
    public void theFewClassHeadMatchesTheHost() {
        if (!SpelaHeadTest.usable("headRows_float32") || !SpelaHeadTest.usable("headGrad_float32")) { return; }
        SpelaHeadTest.headCase(0, 0.0f, false);
        SpelaHeadTest.headCase(0, 0.35f, false);
        SpelaHeadTest.headCase(1, 0.0f, false);
        SpelaHeadTest.headCase(0, 0.35f, true);
        SpelaHeadTest.headCase(1, 0.0f, true);
    }

    @Test
    public void theClassCountPicksTheRoute() {
        Assert.isTrue(!SpelaHead.manyClasses(5L));
        Assert.isTrue(!SpelaHead.manyClasses(64L));
        Assert.isTrue(SpelaHead.manyClasses(65L));
        Assert.isTrue(SpelaHead.manyClasses(40960L));
        Assert.isTrue(SpelaHead.packFloats(5L, 70L) == 0L);
        Assert.isTrue(SpelaHead.packFloats(300L, 70L) == 21000L);
    }

    @Test
    public void theManyClassHeadMatchesTheHost() {
        if (!SpelaHeadTest.usable("headNorm_float32") || !SpelaHeadTest.usable("headStats_float32")
            || !SpelaHeadTest.usable("headBlockGrad_float32") || !SpelaHeadTest.usable("headFinish_float32")
            || !SpelaHeadTest.usable("headCosine_float32") || !SpelaHeadTest.usable("headPack_float32")) { return; }
        SpelaHead.setBlockClasses(128L);
        SpelaHeadTest.headCaseAt(300L, 0, 0.0f, false);
        SpelaHeadTest.headCaseAt(300L, 0, 0.35f, false);
        SpelaHeadTest.headCaseAt(300L, 1, 0.0f, false);
        SpelaHeadTest.headCaseAt(300L, 0, 0.35f, true);
        SpelaHeadTest.headCaseAt(300L, 1, 0.0f, true);
        // one column block of logits, never the rows x classes matrix
        Assert.isTrue(SpelaHead.logitFloats() <= 37L * 128L);
        SpelaHead.setBlockClasses(1024L);
    }

    /**
     * spela-kernels 8.2.1: the device's confidence gate. Each row's top cosine to the class
     * vectors and its argmax, as the trainer's host gate computes them in float64; a row with
     * a given label (>= 0) keeps it and is accepted, any other takes the argmax and is accepted
     * when its top cosine clears the threshold; the accepted count lands in its slot.
     */
    @Test
    public void theGateMatchesTheHostCosineAndThreshold() {
        if (!SpelaHeadTest.usable("headGate_float32")) { return; }
        int64 rows = 37L; int64 d = 70L; int64 c = 5L;
        float32[] h = heap float32[rows * d];
        float32[] v = heap float32[c * d];
        float32[] given = heap float32[rows];
        int64 i = 0L;
        while (i < rows * d) { h[(int32) i] = SpelaHeadTest.pattern(i + 3L, 0.01f); i = i + 1L; }
        i = 0L;
        while (i < c * d) { v[(int32) i] = SpelaHeadTest.pattern(i + 17L, 0.01f); i = i + 1L; }
        i = 0L;
        while (i < rows) {
            given[(int32) i] = -1.0f;
            if (i % 5L == 2L) { given[(int32) i] = (float32) (i % c); }
            i = i + 1L;
        }
        // the host's top cosines, to put the threshold between two of them
        float64[] best = heap float64[rows];
        int64[] arg = heap int64[rows];
        int64 r = 0L;
        while (r < rows) {
            float64 ss = 0.0;
            int64 j = 0L;
            while (j < d) { ss = ss + (float64) h[(int32) (r * d + j)] * (float64) h[(int32) (r * d + j)]; j = j + 1L; }
            float64 hn = Math.sqrt(ss);
            if (hn < 0.00000001) { hn = 0.00000001; }
            best[(int32) r] = -2.0;
            int64 k = 0L;
            while (k < c) {
                float64 dt = 0.0;
                j = 0L;
                while (j < d) { dt = dt + (float64) h[(int32) (r * d + j)] * (float64) v[(int32) (k * d + j)]; j = j + 1L; }
                if (dt / hn > best[(int32) r]) { best[(int32) r] = dt / hn; arg[(int32) r] = k; }
                k = k + 1L;
            }
            r = r + 1L;
        }
        float64 thr = (best[0] + best[1]) * 0.5;
        KernelBuffer<float32> hb = heap KernelBuffer<float32>((uint64) (rows * d));
        KernelBuffer<float32> vb = heap KernelBuffer<float32>((uint64) (c * d));
        KernelBuffer<float32> gb = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> lb = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> mb = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> acc = heap KernelBuffer<float32>(1);
        hb.upload(h);
        vb.upload(v);
        gb.upload(given);
        int64[] mk #= ValueCheck.mark();
        SpelaHead.gate<float32>(lb, mb, acc, hb, vb, gb, rows, d, c, (float32) thr, 0.00000001f);
        float32[] gl = heap float32[rows];
        float32[] gm = heap float32[rows];
        float32[] ga = heap float32[1];
        lb.download(gl);
        mb.download(gm);
        acc.download(ga);
        float64 accepted = 0.0;
        r = 0L;
        while (r < rows) {
            float32 wantLabel = (float32) arg[(int32) r];
            float32 wantMask = 0.0f;
            if (best[(int32) r] >= thr) { wantMask = 1.0f; }
            if (given[(int32) r] >= 0.0f) {
                wantLabel = given[(int32) r];
                wantMask = 1.0f;
            }
            if (gl[(int32) r] != wantLabel || gm[(int32) r] != wantMask) {
                System.stdout.println("  gate row " + r + ": label " + gl[(int32) r] + " want " + wantLabel + ", mask " + gm[(int32) r]
                    + " want " + wantMask + " (top cosine " + best[(int32) r] + ", threshold " + thr + ")");
                Assert.isTrue(false);
            }
            accepted = accepted + (float64) wantMask;
            r = r + 1L;
        }
        Assert.isTrue((float64) ga[0] == accepted);
        Assert.isTrue(accepted > 0.0 && accepted < (float64) rows);
        ValueCheck.credit(mk);
    }

    /** spela-kernels 8: a head whose every row is masked out has loss 0 and gradient 0, not 0 / 0. */
    @Test
    public void anAllMaskedHeadIsZeroNotNaN() {
        if (!SpelaHeadTest.usable("headRows_float32") || !SpelaHeadTest.usable("headCosine_float32")) { return; }
        int64 rows = 9L; int64 d = 16L;
        int64[] counts = [5L, 300L];
        int32 ci = 0;
        while (ci < 2) {
            int64 c = counts[ci];
            int32 mode = 0;
            while (mode < 2) {
                float32[] h = heap float32[rows * d];
                float32[] v = heap float32[c * d];
                float32[] lab = heap float32[rows];
                float32[] msk = heap float32[rows];
                int64 i = 0L;
                while (i < rows * d) { h[(int32) i] = SpelaHeadTest.pattern(i, 0.01f); i = i + 1L; }
                i = 0L;
                while (i < c * d) { v[(int32) i] = SpelaHeadTest.pattern(i + 9L, 0.01f); i = i + 1L; }
                i = 0L;
                while (i < rows) { lab[(int32) i] = (float32) (i % c); i = i + 1L; }
                KernelBuffer<float32> hb = heap KernelBuffer<float32>((uint64) (rows * d));
                KernelBuffer<float32> vb = heap KernelBuffer<float32>((uint64) (c * d));
                KernelBuffer<float32> lb = heap KernelBuffer<float32>((uint64) rows);
                KernelBuffer<float32> mb = heap KernelBuffer<float32>((uint64) rows);
                KernelBuffer<float32> dh = heap KernelBuffer<float32>((uint64) (rows * d));
                KernelBuffer<float32> loss = heap KernelBuffer<float32>(1);
                int64 pf = SpelaHead.packFloats(c, d);
                if (pf == 0L) { pf = 1L; }
                KernelBuffer<float32> pk = heap KernelBuffer<float32>((uint64) pf);
                hb.upload(h);
                vb.upload(v);
                lb.upload(lab);
                mb.upload(msk);
                SpelaHead.pack<float32>(pk, vb, c, d);
                float32 us = 30.0f;
                if (mode == 1) { us = 1.0f; }
                SpelaHead.loss<float32>(loss, dh, hb, vb, pk, lb, mb, rows, d, c, mode, us, 0.0f, 0.00000001f);
                float32[] gl = heap float32[1];
                float32[] gd = heap float32[rows * d];
                loss.download(gl);
                dh.download(gd);
                Assert.isTrue(gl[0] == 0.0f);
                i = 0L;
                while (i < rows * d) {
                    if (gd[(int32) i] != 0.0f) {
                        System.stdout.println("  all-masked dh [" + i + "] = " + gd[(int32) i] + " at " + c + " classes, mode " + mode);
                        Assert.isTrue(false);
                    }
                    i = i + 1L;
                }
                mode = mode + 1;
            }
            ci = ci + 1;
        }
    }
}
