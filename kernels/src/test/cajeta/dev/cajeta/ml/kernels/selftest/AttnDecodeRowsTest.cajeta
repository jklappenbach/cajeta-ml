package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.Math;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.attn.AttnDecodeRows;
import dev.cajeta.ml.kernels.attn.AttnDecodeWave;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** kernel-drivers 9.3: the cpu decode-attention driver's partials, combined, against softmax attention in float64. */
public class AttnDecodeRowsTest {
    public AttnDecodeRowsTest() { return; }

    static float32 rnd(int64 i) {
        int64 x = (i * 2654435761L + 12345L) % 2147483648L;
        return (float32) ((x >> 8) % 2001L - 1000L) * 0.001f;
    }

    /** The partials in `got`, combined per head, against softmax attention over the same data in float64. */
    static void verify(float32[] got, float32[] qh, float16[] kh, float16[] vh, int32[] tab, int32 nKv, int32 group,
            int32 count, int32 splits, int64 hd, float32 scale) {
        int64 kvDim = (int64) nKv * hd;
        int64 nH = (int64) (nKv * group);
        int64 h = 0L;
        while (h < nH) {
            int64 kvh = h / (int64) group;
            float64 big = -1.0e300;
            int64 t = 0L;
            while (t < (int64) count) {
                int64 ro = ((int64) tab[t / 64L] * 64L + t % 64L) * kvDim + kvh * hd;
                float64 sc = 0.0;
                int64 d = 0L;
                while (d < hd) { sc = sc + (float64) qh[h * hd + d] * (float64) (float32) kh[ro + d]; d = d + 1L; }
                sc = sc * (float64) scale;
                if (sc > big) { big = sc; }
                t = t + 1L;
            }
            float64[] want #= heap float64[hd];
            float64 den = 0.0;
            t = 0L;
            while (t < (int64) count) {
                int64 ro = ((int64) tab[t / 64L] * 64L + t % 64L) * kvDim + kvh * hd;
                float64 sc = 0.0;
                int64 d = 0L;
                while (d < hd) { sc = sc + (float64) qh[h * hd + d] * (float64) (float32) kh[ro + d]; d = d + 1L; }
                float64 w = Math.exp(sc * (float64) scale - big);
                den = den + w;
                d = 0L;
                while (d < hd) { want[d] = want[d] + w * (float64) (float32) vh[ro + d]; d = d + 1L; }
                t = t + 1L;
            }
            float64 gm = -1.0e300;
            int64 sp = 0L;
            while (sp < (int64) splits) {
                int64 pb = (h * (int64) splits + sp) * (hd + 2L);
                if (got[pb + hd + 1L] > 0.0f && (float64) got[pb + hd] > gm) { gm = (float64) got[pb + hd]; }
                sp = sp + 1L;
            }
            int64 d = 0L;
            while (d < hd) {
                float64 num = 0.0;
                float64 l = 0.0;
                sp = 0L;
                while (sp < (int64) splits) {
                    int64 pb = (h * (int64) splits + sp) * (hd + 2L);
                    if (got[pb + hd + 1L] > 0.0f) {
                        float64 c = Math.exp((float64) got[pb + hd] - gm);
                        num = num + c * (float64) got[pb + d];
                        l = l + c * (float64) got[pb + hd + 1L];
                    }
                    sp = sp + 1L;
                }
                float64 diff = num / l - want[d] / den;
                if (diff < 0.0) { diff = 0.0 - diff; }
                Assert.isTrue(diff <= 0.0001);
                d = d + 1L;
            }
            h = h + 1L;
        }
    }

    /** Driver `kind`'s partials (0 the cpu rows, 1 to 4 the wave members `<4,4,16,4,16>`, `<2,8,16,1,8>`, `<4,4,16,1,4>`, `<2,8,16,4,32>`) for 2 kv heads of `group` query heads in 4 splits: one row of 150 positions, or with `batch` a batch of 150 and 97. */
    static void runAndVerify(int32 group, int64 hd, int32 kind, boolean batch) {
        int32 nKv = 2;
        int32 splits = 4;
        int64 rows = 192L;
        int64 kvDim = (int64) nKv * hd;
        int64 nH = (int64) (nKv * group);
        int32 n = batch ? 2 : 1;
        float16[] kh #= heap float16[rows * kvDim];
        float16[] vh #= heap float16[rows * kvDim];
        int64 i = 0L;
        while (i < rows * kvDim) { kh[i] = (float16) AttnDecodeRowsTest.rnd(i); vh[i] = (float16) AttnDecodeRowsTest.rnd(i + 999L); i = i + 1L; }
        float32[] qh #= heap float32[(int64) n * nH * hd];
        i = 0L;
        while (i < (int64) n * nH * hd) { qh[i] = AttnDecodeRowsTest.rnd(i + 31L) * 3.0f; i = i + 1L; }
        int32[] tab #= heap int32[3L];
        tab[0] = 2;
        tab[1] = 0;
        tab[2] = 1;
        int32[] counts #= heap int32[2L];
        counts[0] = 150;
        counts[1] = 97;
        int32[] rt #= heap int32[8L];
        int32 r = 0;
        while (r < n) {
            rt[(int64) (4 * r)] = 0;
            rt[(int64) (4 * r + 1)] = counts[(int64) r] - 1;
            rt[(int64) (4 * r + 2)] = counts[(int64) r];
            rt[(int64) (4 * r + 3)] = splits;
            r = r + 1;
        }
        KernelBuffer<float16> k = heap KernelBuffer<float16>((uint64) (rows * kvDim));
        KernelBuffer<float16> v = heap KernelBuffer<float16>((uint64) (rows * kvDim));
        KernelBuffer<float32> q = heap KernelBuffer<float32>((uint64) ((int64) n * nH * hd));
        KernelBuffer<int32> pt = heap KernelBuffer<int32>((uint64) 3L);
        KernelBuffer<int32> rowTab = heap KernelBuffer<int32>((uint64) 8L);
        k.upload(kh);
        v.upload(vh);
        q.upload(qh);
        pt.upload(tab);
        rowTab.upload(rt);
        int64 pn = nH * (int64) splits * (hd + 2L);
        KernelBuffer<float32> part = heap KernelBuffer<float32>((uint64) ((int64) n * pn));
        float32 scale = 0.0883883f;
        int32 qs = (int32) (nH * hd);
        int32 ps = (int32) pn;
        KernelStream s #= KernelStream.current();
        if (kind == 0) {
            AttnDecodeRows<128> drv = heap AttnDecodeRows<128>();
            if (batch) { drv.runBatchOn(s, part, q, k, v, pt, nKv, group, rowTab, n, splits, qs, ps, scale); }
            else { drv.runOn(s, part, q, k, v, pt, 0, nKv, group, counts[0], 0, splits, scale); }
        } else if (kind == 1) {
            AttnDecodeWave<4, 4, 16, 4, 16> drv = heap AttnDecodeWave<4, 4, 16, 4, 16>();
            if (batch) { drv.runBatchOn(s, part, q, k, v, pt, nKv, group, rowTab, n, splits, qs, ps, scale); }
            else { drv.runOn(s, part, q, k, v, pt, 0, nKv, group, counts[0], 0, splits, scale); }
        } else if (kind == 2) {
            AttnDecodeWave<2, 8, 16, 1, 8> drv = heap AttnDecodeWave<2, 8, 16, 1, 8>();
            if (batch) { drv.runBatchOn(s, part, q, k, v, pt, nKv, group, rowTab, n, splits, qs, ps, scale); }
            else { drv.runOn(s, part, q, k, v, pt, 0, nKv, group, counts[0], 0, splits, scale); }
        } else if (kind == 3) {
            AttnDecodeWave<4, 4, 16, 1, 4> drv = heap AttnDecodeWave<4, 4, 16, 1, 4>();
            if (batch) { drv.runBatchOn(s, part, q, k, v, pt, nKv, group, rowTab, n, splits, qs, ps, scale); }
            else { drv.runOn(s, part, q, k, v, pt, 0, nKv, group, counts[0], 0, splits, scale); }
        } else {
            AttnDecodeWave<2, 8, 16, 4, 32> drv = heap AttnDecodeWave<2, 8, 16, 4, 32>();
            if (batch) { drv.runBatchOn(s, part, q, k, v, pt, nKv, group, rowTab, n, splits, qs, ps, scale); }
            else { drv.runOn(s, part, q, k, v, pt, 0, nKv, group, counts[0], 0, splits, scale); }
        }
        s.sync();
        float32[] got #= heap float32[(int64) n * pn];
        part.download(got);
        r = 0;
        while (r < n) {
            float32[] gr #= heap float32[pn];
            float32[] qr #= heap float32[nH * hd];
            i = 0L;
            while (i < pn) { gr[i] = got[(int64) r * pn + i]; i = i + 1L; }
            i = 0L;
            while (i < nH * hd) { qr[i] = qh[(int64) r * nH * hd + i]; i = i + 1L; }
            AttnDecodeRowsTest.verify(gr, qr, kh, vh, tab, nKv, group, counts[(int64) r], splits, hd, scale);
            r = r + 1;
        }
    }

    @Test
    public void thePartialsCombineToSoftmaxAttention() {
        String name = "AttnDecodeRows_128_decode";
        if (!Device.kernelAvailable(name)) {
            DeviceSkip.cannot("the row decode-attention driver is the cpu's (kernel-drivers 9.3)");
            return;
        }
        int64[] m #= ValueCheck.mark();
        AttnDecodeRowsTest.runAndVerify(3, 128L, 0, false);
        AttnDecodeRowsTest.runAndVerify(3, 128L, 0, true);
        ValueCheck.credit(m);
    }

    @Test
    public void theWaveDriversPartialsCombineToSoftmaxAttention() {
        String a = "AttnDecodeWave_4_4_16_4_16_decode";
        String b = "AttnDecodeWave_2_8_16_1_8_decode";
        if (!Device.kernelUsable(a) || !Device.kernelUsable(b)) {
            DeviceSkip.noKernel(a, "the wave decode-attention driver is the GPU's (kernel-drivers 9.3.3)");
            return;
        }
        int64[] m #= ValueCheck.mark();
        AttnDecodeRowsTest.runAndVerify(8, 128L, 1, false);
        AttnDecodeRowsTest.runAndVerify(4, 128L, 1, false);
        AttnDecodeRowsTest.runAndVerify(2, 256L, 2, false);
        AttnDecodeRowsTest.runAndVerify(4, 128L, 3, false);
        AttnDecodeRowsTest.runAndVerify(2, 256L, 4, false);
        AttnDecodeRowsTest.runAndVerify(8, 128L, 1, true);
        AttnDecodeRowsTest.runAndVerify(2, 256L, 2, true);
        AttnDecodeRowsTest.runAndVerify(4, 128L, 3, true);
        AttnDecodeRowsTest.runAndVerify(2, 256L, 4, true);
        ValueCheck.credit(m);
    }
}
