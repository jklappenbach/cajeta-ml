package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.String;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.Fill;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.KernelCensus;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/**
 * cajeta-ml-gpu 8.1.2: the census gate fires and does not fire. A gate needs a
 * test that asserts it fires and one that asserts it does not; the fire arm here
 * is a tracked entry for a kernel that ran (STALE), the clean arm the same census
 * with empty lists after the kernel was value-checked.
 */
public class CensusGateTest {
    public CensusGateTest() { return; }

    @Test
    public void aStaleTrackedEntryFailsTheGateAndACleanCensusPasses() {
        if (!Device.kernelAvailable("fillF32")) {
            DeviceSkip.noKernel("fillF32", "cajeta-ml-gpu 8.2.1");
            return;
        }
        KernelBuffer<float32> buf = heap KernelBuffer<float32>(64L);
        int64[] m #= ValueCheck.mark();
        Fill.f32(buf, 64L, 1.0f);
        float32[] got = heap float32[64L];
        buf.download(got);
        Assert.isTrue(got[0] == 1.0f && got[63] == 1.0f);
        ValueCheck.credit(m);
        String stale #= "|" + Device.activeBackend() + ":fillF32=some plan item|";
        Assert.equals(1, KernelCensus.gate(stale, "||", "||", "||"));
        // The clean arm: every other registered kernel that has not run yet in this
        // process is tracked, so only fillF32's check decides the verdict.
        String others #= "|";
        int32 n = Device.registeredKernelCount();
        int32 i = 0;
        while (i < n) {
            String name #= Device.registeredKernel(i);
            if (!name.equals("fillF32") && Device.kernelLaunchCount(name) == 0L) {
                others #= others + Device.activeBackend() + ":" + name + "=not yet run in this test|";
            }
            i = i + 1;
        }
        Assert.equals(0, KernelCensus.gate(others, "||", "||", "||"));
    }
}
