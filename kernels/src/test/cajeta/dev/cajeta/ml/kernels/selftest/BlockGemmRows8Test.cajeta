package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.Cajeta;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.gemm.BlockGemmRef;
import dev.cajeta.ml.kernels.gemm.BlockGemmRows8;
import dev.cajeta.ml.kernels.quant.Q2kBlock;
import dev.cajeta.ml.kernels.quant.Q3kBlock;
import dev.cajeta.ml.kernels.quant.Q4kBlock;
import dev.cajeta.ml.kernels.quant.Q5kBlock;
import dev.cajeta.ml.kernels.quant.Q6kBlock;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** kernel-drivers 3.1: the cpu row driver over the Q4_K pieces against the GEMM written from the pieces alone. */
public class BlockGemmRows8Test {
    public BlockGemmRows8Test() { return; }

    @Test
    public void thePackPutsEveryFieldWhereTheDriverReadsIt() {
        int64 rows = 11L;
        int64 bpr = 2L;
        int8[] file #= BlockGemmRefTest.weight(rows * bpr);
        BlockGemmRows8<Q4kBlock> drv = heap BlockGemmRows8<Q4kBlock>();
        Assert.isTrue(drv.packedBytes(rows, bpr) == 2L * bpr * 1216L);
        int8[] out #= heap int8[drv.packedBytes(rows, bpr)];
        drv.pack(file, 0L, rows, bpr, out, 0L);
        int64 r = 0L;
        while (r < 16L) {
            int64 b = 0L;
            while (b < bpr) {
                int64 wo = ((r / 8L) * bpr + b) * 1216L;
                int64 lane = r % 8L;
                int64 ro = (r * bpr + b) * 144L;
                if (r < rows) {
                    int32 h0 = BlockGemmRefTest.word(file, ro);
                    int32 h1 = BlockGemmRefTest.word(file, ro + 4L);
                    int32 h2 = BlockGemmRefTest.word(file, ro + 8L);
                    int32 h3 = BlockGemmRefTest.word(file, ro + 12L);
                    Assert.isTrue(BlockGemmRefTest.word(out, wo + 4L * lane) == Cajeta.f32ToBits(Q4kBlock.d(h0)));
                    Assert.isTrue(BlockGemmRefTest.word(out, wo + 32L + 4L * lane) == Cajeta.f32ToBits(Q4kBlock.dmin(h0)));
                    uint32 j = 0;
                    while (j < 8) {
                        Assert.isTrue((int32) out[wo + 64L + 8L * (int64) j + lane] == Q4kBlock.scale(h1, h3, j));
                        Assert.isTrue((int32) out[wo + 128L + 8L * (int64) j + lane] == Q4kBlock.min(h2, h3, j));
                        j = j + 1;
                    }
                    int64 k = 0L;
                    while (k < 128L) {
                        Assert.isTrue(out[wo + 192L + 32L * (k / 4L) + 4L * lane + (k % 4L)] == file[ro + 16L + k]);
                        k = k + 1L;
                    }
                } else {
                    int64 k = 0L;
                    while (k < 128L) {
                        Assert.isTrue(out[wo + 192L + 32L * (k / 4L) + 4L * lane + (k % 4L)] == (int8) 0);
                        k = k + 1L;
                    }
                }
                b = b + 1L;
            }
            r = r + 1L;
        }
    }

    @Test
    public void theRowDriverEqualsTheGemmFromPiecesBitForBit() {
        String name = "BlockGemmRows8_dev_cajeta_ml_kernels_quant_Q4kBlock_rows8";
        String ref = "BlockGemmRef_dev_cajeta_ml_kernels_quant_Q4kBlock_ref";
        if (!Device.kernelAvailable(name) || !Device.kernelAvailable(ref)) {
            DeviceSkip.cannot("the 8-row driver is the cpu's (kernel-drivers 3.2)");
            return;
        }
        int64 rows = 21L;
        int64 tokens = 39L;
        int64 bpr = 3L;
        int8[] file #= BlockGemmRefTest.weight(rows * bpr);
        int8[] hx #= BlockGemmRefTest.acts(tokens * bpr);
        BlockGemmRows8<Q4kBlock> drv = heap BlockGemmRows8<Q4kBlock>();
        int8[] packed #= heap int8[drv.packedBytes(rows, bpr)];
        drv.pack(file, 0L, rows, bpr, packed, 0L);
        KernelBuffer<int8> wf = heap KernelBuffer<int8>((uint64) (rows * bpr * 144L));
        KernelBuffer<int8> wp = heap KernelBuffer<int8>((uint64) drv.packedBytes(rows, bpr));
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (tokens * bpr * 320L));
        KernelBuffer<float32> ya = heap KernelBuffer<float32>((uint64) (tokens * rows));
        KernelBuffer<float32> yb = heap KernelBuffer<float32>((uint64) (tokens * rows));
        wf.upload(file);
        wp.upload(packed);
        xp.upload(hx);
        float32[] seedY #= heap float32[tokens * rows];
        int64 i = 0L;
        while (i < tokens * rows) { seedY[i] = 0.25f * (float32) (i % 7L); i = i + 1L; }
        float32[] ga #= heap float32[tokens * rows];
        float32[] gb #= heap float32[tokens * rows];
        BlockGemmRef<Q4kBlock> g = heap BlockGemmRef<Q4kBlock>();
        int64[] m #= ValueCheck.mark();
        int32 pass = 0;
        while (pass < 2) {
            ya.upload(seedY);
            yb.upload(seedY);
            g.run(ya, wf, xp, rows, tokens, bpr, rows, pass == 1);
            drv.run(yb, wp, xp, rows, bpr, tokens, bpr * 320L, rows, pass == 1, 2L, 32L);
            KernelStream st #= KernelStream.current();
            st.sync();
            ya.download(ga);
            yb.download(gb);
            i = 0L;
            while (i < tokens * rows) {
                Assert.isTrue(Cajeta.f32ToBits(ga[i]) == Cajeta.f32ToBits(gb[i]));
                i = i + 1L;
            }
            pass = pass + 1;
        }
        ValueCheck.credit(m);
    }

    @Test
    public void oneTokenRunsTheDecodeKernelAndEqualsTheGemmFromPiecesBitForBit() {
        String name = "BlockGemmRows8_dev_cajeta_ml_kernels_quant_Q4kBlock_vec8";
        String ref = "BlockGemmRef_dev_cajeta_ml_kernels_quant_Q4kBlock_ref";
        if (!Device.kernelAvailable(name) || !Device.kernelAvailable(ref)) {
            DeviceSkip.cannot("the 8-row driver is the cpu's (kernel-drivers 9.1)");
            return;
        }
        int64 rows = 21L;
        int64 bpr = 5L;
        int8[] file #= BlockGemmRefTest.weight(rows * bpr);
        int8[] hx #= BlockGemmRefTest.acts(bpr);
        BlockGemmRows8<Q4kBlock> drv = heap BlockGemmRows8<Q4kBlock>();
        int8[] packed #= heap int8[drv.packedBytes(rows, bpr)];
        drv.pack(file, 0L, rows, bpr, packed, 0L);
        BlockGemmRef<Q4kBlock> g = heap BlockGemmRef<Q4kBlock>();
        KernelBuffer<int8> wf = heap KernelBuffer<int8>((uint64) (rows * bpr * 144L));
        KernelBuffer<int8> wp = heap KernelBuffer<int8>((uint64) drv.packedBytes(rows, bpr));
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        KernelBuffer<float32> ya = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yb = heap KernelBuffer<float32>((uint64) rows);
        wf.upload(file);
        wp.upload(packed);
        xp.upload(hx);
        int64[] m #= ValueCheck.mark();
        g.run(ya, wf, xp, rows, 1L, bpr, rows, false);
        drv.run(yb, wp, xp, rows, bpr, 1L, bpr * 320L, rows, false, 2L, 32L);
        KernelStream st #= KernelStream.current();
        st.sync();
        float32[] ga #= heap float32[rows];
        float32[] gb #= heap float32[rows];
        ya.download(ga);
        yb.download(gb);
        int64 i = 0L;
        while (i < rows) { Assert.isTrue(Cajeta.f32ToBits(ga[i]) == Cajeta.f32ToBits(gb[i])); i = i + 1L; }
        ValueCheck.credit(m);
    }

    @Test
    public void oneTokenOfASixteenValueFormatEqualsTheGemmFromPiecesBitForBit() {
        String name = "BlockGemmRows8_dev_cajeta_ml_kernels_quant_Q6kBlock_vec8";
        String ref = "BlockGemmRef_dev_cajeta_ml_kernels_quant_Q6kBlock_ref";
        if (!Device.kernelAvailable(name) || !Device.kernelAvailable(ref)) {
            DeviceSkip.cannot("the 8-row driver is the cpu's (kernel-drivers 9.1)");
            return;
        }
        int64 rows = 21L;
        int64 bpr = 5L;
        int8[] file #= Q6kBlockTest.weight(rows * bpr);
        int8[] hx #= BlockGemmRefTest.acts(bpr);
        BlockGemmRows8<Q6kBlock> drv = heap BlockGemmRows8<Q6kBlock>();
        int8[] packed #= heap int8[drv.packedBytes(rows, bpr)];
        drv.pack(file, 0L, rows, bpr, packed, 0L);
        BlockGemmRef<Q6kBlock> g = heap BlockGemmRef<Q6kBlock>();
        KernelBuffer<int8> wf = heap KernelBuffer<int8>((uint64) (rows * bpr * 210L));
        KernelBuffer<int8> wp = heap KernelBuffer<int8>((uint64) drv.packedBytes(rows, bpr));
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        KernelBuffer<float32> ya = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yb = heap KernelBuffer<float32>((uint64) rows);
        wf.upload(file);
        wp.upload(packed);
        xp.upload(hx);
        int64[] m #= ValueCheck.mark();
        g.run(ya, wf, xp, rows, 1L, bpr, rows, false);
        drv.run(yb, wp, xp, rows, bpr, 1L, bpr * 320L, rows, false, 2L, 32L);
        KernelStream st #= KernelStream.current();
        st.sync();
        float32[] ga #= heap float32[rows];
        float32[] gb #= heap float32[rows];
        ya.download(ga);
        yb.download(gb);
        int64 i = 0L;
        while (i < rows) { Assert.isTrue(Cajeta.f32ToBits(ga[i]) == Cajeta.f32ToBits(gb[i])); i = i + 1L; }
        ValueCheck.credit(m);
    }

    static void expectRef(BlockGemmRef<Q4kBlock> g, KernelBuffer<float32> got, int8[] file, KernelBuffer<int8> xp,
            int64 rows, int64 bpr) {
        KernelBuffer<int8> wf = heap KernelBuffer<int8>((uint64) (rows * bpr * 144L));
        KernelBuffer<float32> ya = heap KernelBuffer<float32>((uint64) rows);
        wf.upload(file);
        g.run(ya, wf, xp, rows, 1L, bpr, rows, false);
        KernelStream st #= KernelStream.current();
        st.sync();
        float32[] ga #= heap float32[rows];
        float32[] gb #= heap float32[rows];
        ya.download(ga);
        got.download(gb);
        int64 i = 0L;
        while (i < rows) { Assert.isTrue(Cajeta.f32ToBits(ga[i]) == Cajeta.f32ToBits(gb[i])); i = i + 1L; }
    }

    static #int8[] slice(int8[] all, int64 fromBlock, int64 blocks) {
        int8[] out #= heap int8[blocks * 144L];
        int64 i = 0L;
        while (i < blocks * 144L) { out[i] = all[fromBlock * 144L + i]; i = i + 1L; }
        return #out;
    }

    static #KernelBuffer<int8> packedOf(BlockGemmRows8<Q4kBlock> drv, int8[] file, int64 rows, int64 bpr) {
        int8[] p #= heap int8[drv.packedBytes(rows, bpr)];
        drv.pack(file, 0L, rows, bpr, p, 0L);
        KernelBuffer<int8> w #= heap KernelBuffer<int8>((uint64) drv.packedBytes(rows, bpr));
        w.upload(p);
        return #w;
    }

    @Test
    public void threeWeightsAgainstOneTokenEachEqualTheGemmFromPiecesBitForBit() {
        String name = "BlockGemmRows8_dev_cajeta_ml_kernels_quant_Q4kBlock_vec3";
        String ref = "BlockGemmRef_dev_cajeta_ml_kernels_quant_Q4kBlock_ref";
        if (!Device.kernelAvailable(name) || !Device.kernelAvailable(ref)) {
            DeviceSkip.cannot("the 8-row driver is the cpu's (kernel-drivers 9.1.3)");
            return;
        }
        int64 bpr = 3L;
        int8[] all #= BlockGemmRefTest.weight(42L * bpr);
        int8[] fa #= BlockGemmRows8Test.slice(all, 0L, 21L * bpr);
        int8[] fb #= BlockGemmRows8Test.slice(all, 21L * bpr, 13L * bpr);
        int8[] fc #= BlockGemmRows8Test.slice(all, 34L * bpr, 8L * bpr);
        int8[] hx #= BlockGemmRefTest.acts(bpr);
        BlockGemmRows8<Q4kBlock> drv = heap BlockGemmRows8<Q4kBlock>();
        KernelBuffer<int8> wa #= BlockGemmRows8Test.packedOf(drv, fa, 21L, bpr);
        KernelBuffer<int8> wb #= BlockGemmRows8Test.packedOf(drv, fb, 13L, bpr);
        KernelBuffer<int8> wc #= BlockGemmRows8Test.packedOf(drv, fc, 8L, bpr);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> ya = heap KernelBuffer<float32>((uint64) 21L);
        KernelBuffer<float32> yb = heap KernelBuffer<float32>((uint64) 13L);
        KernelBuffer<float32> yc = heap KernelBuffer<float32>((uint64) 8L);
        int64[] m #= ValueCheck.mark();
        KernelStream st #= KernelStream.current();
        drv.run3(st, ya, yb, yc, wa, wb, wc, xp, 21L, 13L, 8L, bpr, 2L);
        st.sync();
        BlockGemmRef<Q4kBlock> g = heap BlockGemmRef<Q4kBlock>();
        BlockGemmRows8Test.expectRef(g, ya, fa, xp, 21L, bpr);
        BlockGemmRows8Test.expectRef(g, yb, fb, xp, 13L, bpr);
        BlockGemmRows8Test.expectRef(g, yc, fc, xp, 8L, bpr);
        KernelBuffer<float32> yd = heap KernelBuffer<float32>((uint64) 21L);
        KernelBuffer<float32> ye = heap KernelBuffer<float32>((uint64) 13L);
        drv.run3(st, yd, ye, ye, wa, wb, null, xp, 21L, 13L, 0L, bpr, 2L);
        st.sync();
        BlockGemmRows8Test.expectRef(g, yd, fa, xp, 21L, bpr);
        BlockGemmRows8Test.expectRef(g, ye, fb, xp, 13L, bpr);
        ValueCheck.credit(m);
    }

    @Test
    public void threeWeightsOfEveryOtherFormatEachEqualTheGemmFromPiecesBitForBit() {
        if (!Device.kernelAvailable("BlockGemmRows8_dev_cajeta_ml_kernels_quant_Q2kBlock_vec3")) {
            DeviceSkip.cannot("the 8-row driver is the cpu's (kernel-drivers 9.1.9)");
            return;
        }
        int64[] m #= ValueCheck.mark();
        int8[] f2 #= Q2kBlockTest.weight(42L * 3L);
        int8[] f3 #= Q3kBlockTest.weight(42L * 3L);
        int8[] f5 #= Q5kBlockTest.weight(42L * 3L);
        int8[] f6 #= Q6kBlockTest.weight(42L * 3L);
        heap Rows8Check<Q2kBlock>().three(f2, 3L);
        heap Rows8Check<Q3kBlock>().three(f3, 3L);
        heap Rows8Check<Q5kBlock>().three(f5, 3L);
        heap Rows8Check<Q6kBlock>().three(f6, 3L);
        ValueCheck.credit(m);
    }
}
