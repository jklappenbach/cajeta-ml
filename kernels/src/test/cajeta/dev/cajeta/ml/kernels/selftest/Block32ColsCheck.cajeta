package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.Cajeta;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.gemm.Block32GemvWave;

/** {@link ColsTest}'s check over one 32-value piece `P`: `ncols` token rows against 23 rows of 75 blocks, each column bitwise the one-row member, set then added. */
public final class Block32ColsCheck<P> {
    public Block32ColsCheck() { return; }

    public void check(int64 ncols) {
        int64 rows = 23L;
        int64 nb = 75L;
        int64 spans = 10L;
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        Block32Check<P> gen = heap Block32Check<P>();
        int8[] file #= gen.weight(rows * nb);
        int8[] hx #= gen.acts(ncols * spans);
        Block32GemvWave<P, 1> m = heap Block32GemvWave<P, 1>();
        int8[] pk #= heap int8[rows * m.rowBytes(nb)];
        m.pack(file, 0L, rows, nb, pk, 0L);
        KernelBuffer<int8> w = heap KernelBuffer<int8>((uint64) (rows * m.rowBytes(nb)));
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (ncols * spans * 320L));
        KernelBuffer<float32> y = heap KernelBuffer<float32>((uint64) (ncols * rows));
        KernelBuffer<float32> y1 = heap KernelBuffer<float32>((uint64) rows);
        w.upload(pk);
        xp.upload(hx);
        float32[] seed #= heap float32[ncols * rows];
        int64 i = 0L;
        while (i < ncols * rows) { seed[i] = 0.25f * (float32) (i % 5L); i = i + 1L; }
        float32[] got #= heap float32[ncols * rows];
        float32[] one #= heap float32[rows];
        KernelStream st #= KernelStream.current();
        int32 pass = 0;
        while (pass < 2) {
            y.upload(seed);
            m.runColsOn(st, y, w, xp, rows, nb, 0L, ncols, rows, spans * 320L, pass == 1, 2L, wv);
            st.sync();
            y.download(got);
            int64 c = 0L;
            while (c < ncols) {
                KernelBuffer<int8> xc #= xp.slice((uint64) (c * spans * 320L), (uint64) (spans * 320L));
                m.runOn(st, y1, w, xc, rows, nb, 0L, false, 1L, wv);
                st.sync();
                y1.download(one);
                int64 r = 0L;
                while (r < rows) {
                    float32 want = one[r];
                    if (pass == 1) { want = seed[c * rows + r] + one[r]; }
                    Assert.isTrue(Cajeta.f32ToBits(got[c * rows + r]) == Cajeta.f32ToBits(want));
                    r = r + 1L;
                }
                c = c + 1L;
            }
            pass = pass + 1;
        }
    }
}
