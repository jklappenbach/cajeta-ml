package dev.cajeta.ml.kernels.selftest;

import cajeta.xpu.KernelCap;

/**
 * Kernels that lower on a backend but were measured wrong there, held by name until
 * the item that owns the defect ships (cajeta.xpu.KernelCap, spec §7.1). Every hold
 * has a row in Census.TRACKED so the census reads the skip as accounted for.
 */
public final class Holds {
    public Holds() { return; }

    public static void apply() {
        // cajeta's SPIR-V path truncates a float32 or integer narrowed to bfloat16 where
        // the host rounds to nearest even (cajeta-ml-gpu 11.2.2); lifts with the pin.
        KernelCap.hold("vulkan", "iota_bfloat16", "cajeta-ml-gpu 11.2.2");
        KernelCap.hold("vulkan", "convert_float32_bfloat16", "cajeta-ml-gpu 11.2.2");
        // cajeta's SPIR-V lowering tiers an f32 x f32 cooperative multiply as native, which RADV
        // has no configuration for: the driver segfaults compiling it (cajeta-ml-gpu 20.2.2).
        KernelCap.hold("vulkan", "gemm16_float32", "cajeta-ml-gpu 20.2.2");
    }
}
