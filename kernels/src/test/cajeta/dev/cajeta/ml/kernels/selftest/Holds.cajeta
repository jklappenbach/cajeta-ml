package dev.cajeta.ml.kernels.selftest;

import cajeta.xpu.KernelCap;

/**
 * Kernels that lower on a backend but were measured wrong there, held by name until
 * the item that owns the defect ships (cajeta.xpu.KernelCap, spec §7.1). Every hold
 * has a row in Census.TRACKED so the census reads the skip as accounted for.
 */
public final class Holds {
    public Holds() { return; }

    public static void apply() {
        // No holds at the v0.53.1 pin: the SPIR-V bfloat16 narrowing (cajeta-ml-gpu 11.2.2)
        // and the f32 cooperative operand tier (20.2.2) shipped in cajeta v0.53.1.
        return;
    }
}
