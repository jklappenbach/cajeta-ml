package dev.cajeta.ml.kernels.selftest;

import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.ShapeChoice;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.Gemm;
import dev.cajeta.ml.kernels.testing.ValueCheck;
import dev.cajeta.ml.kernels.tune.TuneMode;

/**
 * cajeta-ml-gpu 23.2.2: the 256x128 GEMM member (double-buffered shared memory, three
 * slabs of prefetch, a rotated K walk) against a float64 host GEMM, and the large-GEMM
 * family that chooses between it and the 128x128 member per device and problem: timed at
 * first use and remembered, the first member when untimed, and a lone survivor of the
 * feasibility filter (the 256x128 member spills at 512 threads on sm_89) untimed.
 * 23.2.12: each unrolled wide tile and its rolled twin, a choice of the same kind.
 */
public class GemmFamilyTest {
    public GemmFamilyTest() { return; }

    static float32 pattern(int64 i) {
        return (float32) ((((i * 7919L) % 251L) - 125L) % 5L) * 0.5f;
    }

    static #float32[] fill(int64 count, int64 seed) {
        float32[] f = heap float32[count];
        int64 i = 0L;
        while (i < count) { f[(int32) i] = GemmFamilyTest.pattern(i + seed); i = i + 1L; }
        return #f;
    }

    /** How many outputs of `got` miss the float64 product of `fa` and `fb` by more than the matrix-core tolerance. */
    static int32 misses(String what, float32[] fa, float32[] fb, float32[] got, int64 m, int64 n, int64 k) {
        int64 r = 0L;
        int32 bad = 0;
        while (r < m) {
            int64 col = 0L;
            while (col < n) {
                float64 acc = 0.0;
                int64 d = 0L;
                while (d < k) { acc = acc + (float64) fa[(int32) (r * k + d)] * (float64) fb[(int32) (d * n + col)]; d = d + 1L; }
                float64 df = (float64) got[(int32) (r * n + col)] - acc;
                if (df < 0.0) { df = 0.0 - df; }
                float64 w = acc;
                if (w < 0.0) { w = 0.0 - w; }
                if (df > 1.0e-5 * (w + 1.0) + (float64) k * 1.0e-7) {
                    if (bad < 3) {
                        System.stdout.println(what + " " + m + "x" + n + "x" + k + ": [" + r + "," + col + "] got " + (float64) got[(int32) (r * n + col)] + " want " + acc);
                    }
                    bad = bad + 1;
                }
                col = col + 1L;
            }
            r = r + 1L;
        }
        return bad;
    }

    /** Run the f16 GEMM through `how` (0 the 256x128 member, 1 the family with `store`) and check it; returns the family's member, or "". */
    static #String f16Case(int32 how, int64 m, int64 n, int64 k, String store) {
        float32[] fa #= GemmFamilyTest.fill(m * k, 0L);
        float32[] fb #= GemmFamilyTest.fill(k * n, 17L);
        float16[] ha = heap float16[m * k];
        float16[] hb = heap float16[k * n];
        int64 i = 0L;
        while (i < m * k) { ha[(int32) i] = (float16) fa[(int32) i]; i = i + 1L; }
        i = 0L;
        while (i < k * n) { hb[(int32) i] = (float16) fb[(int32) i]; i = i + 1L; }
        KernelBuffer<float16> a = heap KernelBuffer<float16>((uint64) (m * k));
        KernelBuffer<float16> b = heap KernelBuffer<float16>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        a.upload(ha);
        b.upload(hb);
        float32[] got = heap float32[m * n];
        i = 0L;
        while (i < m * n) { got[(int32) i] = 12345.0f; i = i + 1L; }
        c.upload(got);
        int64[] mk #= ValueCheck.mark();
        String member #= "".clone();
        if (how == 0) { Gemm.run256<float16>(c, a, b, m, n, k); }
        else { member #= Gemm.runTuned(c, a, b, m, n, k, store); }
        c.download(got);
        Assert.equals(0L, (int64) GemmFamilyTest.misses("f16 how " + how, fa, fb, got, m, n, k));
        ValueCheck.credit(mk);
        return #member;
    }

    /** The bf16 form of f16Case. */
    static #String bf16Case(int32 how, int64 m, int64 n, int64 k, String store) {
        float32[] fa #= GemmFamilyTest.fill(m * k, 0L);
        float32[] fb #= GemmFamilyTest.fill(k * n, 17L);
        bfloat16[] ha = heap bfloat16[m * k];
        bfloat16[] hb = heap bfloat16[k * n];
        int64 i = 0L;
        while (i < m * k) { ha[(int32) i] = (bfloat16) fa[(int32) i]; i = i + 1L; }
        i = 0L;
        while (i < k * n) { hb[(int32) i] = (bfloat16) fb[(int32) i]; i = i + 1L; }
        KernelBuffer<bfloat16> a = heap KernelBuffer<bfloat16>((uint64) (m * k));
        KernelBuffer<bfloat16> b = heap KernelBuffer<bfloat16>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        a.upload(ha);
        b.upload(hb);
        float32[] got = heap float32[m * n];
        i = 0L;
        while (i < m * n) { got[(int32) i] = 12345.0f; i = i + 1L; }
        c.upload(got);
        int64[] mk #= ValueCheck.mark();
        String member #= "".clone();
        if (how == 0) { Gemm.run256Bf16(c, a, b, m, n, k); }
        else { member #= Gemm.runTunedBf16(c, a, b, m, n, k, store); }
        c.download(got);
        Assert.equals(0L, (int64) GemmFamilyTest.misses("bf16 how " + how, fa, fb, got, m, n, k));
        ValueCheck.credit(mk);
        return #member;
    }

    static #String freshStore() {
        String store #= "build/tune-gemm-" + Clock.nanoTime();
        Path dir #= Path.of(store);
        dir.mkdirs();
        return #store;
    }

    @Test
    public void wideMemberMatchesTheHostAtF16() {
        if (!GemmTileTest.usable("gemm256_float16")) { return; }
        String none #= "".clone();
        GemmFamilyTest.f16Case(0, 512L, 256L, 256L, none);
        GemmFamilyTest.f16Case(0, 256L, 128L, 32L, none);
        GemmFamilyTest.f16Case(0, 256L, 128L, 64L, none);
        GemmFamilyTest.f16Case(0, 256L, 256L, 136L, none);
        GemmFamilyTest.f16Case(0, 300L, 200L, 130L, none);
        GemmFamilyTest.f16Case(0, 33L, 17L, 9L, none);
        GemmFamilyTest.f16Case(0, 1L, 130L, 77L, none);
    }

    @Test
    public void wideMemberMatchesTheHostAtBf16() {
        if (!GemmTileTest.usable("gemm256Bf16")) { return; }
        String none #= "".clone();
        GemmFamilyTest.bf16Case(0, 512L, 256L, 256L, none);
        GemmFamilyTest.bf16Case(0, 256L, 128L, 32L, none);
        GemmFamilyTest.bf16Case(0, 300L, 200L, 130L, none);
        GemmFamilyTest.bf16Case(0, 33L, 17L, 9L, none);
    }

    @Test
    public void familyTimesItsMembersOnceAndRemembersTheWinner() {
        if (!GemmTileTest.usable("gemm256_float16") || !GemmTileTest.usable("gemm128_float16")) { return; }
        String store #= GemmFamilyTest.freshStore();
        TuneMode.setUntimed(false);
        int32 survivors = Gemm.largeSurvivors(false, 512L, 512L, 256L);
        Assert.isTrue(survivors >= 1);
        String first #= GemmFamilyTest.f16Case(1, 512L, 512L, 256L, store);
        Assert.isTrue(first.equals("gemm128_float16") || first.equals("gemm256_float16"));
        if (survivors > 1) { Assert.isTrue(Gemm.lastLargeTimed()); } else { Assert.isFalse(Gemm.lastLargeTimed()); }
        String again #= GemmFamilyTest.f16Case(1, 512L, 512L, 256L, store);
        Assert.isFalse(Gemm.lastLargeTimed());
        Assert.equals(first, again);
    }

    @Test
    public void bf16FamilyServesEveryBackend() {
        String store #= GemmFamilyTest.freshStore();
        TuneMode.setUntimed(false);
        String member #= GemmFamilyTest.bf16Case(1, 300L, 260L, 72L, store);
        Assert.isTrue(member.equals("gemm128Bf16") || member.equals("gemm256Bf16") || member.equals("gemmWide_bfloat16"));
    }

    @Test
    public void untimedTakesTheFirstMember() {
        if (!GemmTileTest.usable("gemm128_float16")) { return; }
        TuneMode.setUntimed(true);
        String none #= "".clone();
        String member #= GemmFamilyTest.f16Case(1, 256L, 256L, 64L, none);
        TuneMode.setUntimed(false);
        Assert.equals("gemm128_float16", member);
        Assert.isFalse(Gemm.lastLargeTimed());
    }
    /** Gemm.tiled at float32 against the float64 host product. */
    static void pairCase(int64 m, int64 n, int64 k) {
        float32[] fa #= GemmFamilyTest.fill(m * k, 0L);
        float32[] fb #= GemmFamilyTest.fill(k * n, 17L);
        KernelBuffer<float32> a = heap KernelBuffer<float32>((uint64) (m * k));
        KernelBuffer<float32> b = heap KernelBuffer<float32>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        a.upload(fa);
        b.upload(fb);
        int64[] mk #= ValueCheck.mark();
        Gemm.tiled<float32>(c, a, b, m, n, k);
        float32[] got = heap float32[m * n];
        c.download(got);
        Assert.equals(0L, (int64) GemmFamilyTest.misses("pair", fa, fb, got, m, n, k));
        ValueCheck.credit(mk);
    }

    /** With `family` overridden to `rolled`, Gemm.tiled at m x n x k launches `rolled` and stays right. */
    static void rolledUnder(String family, String rolled, int64 m, int64 n, int64 k) {
        ShapeChoice.setShapeOverride(family, rolled);
        int64 r0 = Device.kernelLaunchCount(rolled);
        GemmFamilyTest.pairCase(m, n, k);
        ShapeChoice.clearShapeOverride(family);
        Assert.isTrue(Device.kernelLaunchCount(rolled) > r0);
        String ran #= Gemm.lastPairKernel();
        Assert.equals(rolled, ran);
    }

    /**
     * 23.2.12: an unrolled wide tile against its rolled twin is a choice per device and
     * problem. With no store the unrolled member runs where its build spills nothing, as it
     * did; under a store an override names the rolled twin for each of the five pairs, and
     * where both members survive the first call times them and every later one, in this
     * process or the next, reads the answer back untimed.
     */
    @Test
    public void anUnrolledTileAndItsRolledTwinAreATimedChoiceUnderAStore() {
        if (!GemmTileTest.usable("gemmTiled128_float32")) { return; }
        TuneMode.setUntimed(false);
        Gemm.tuneUnrolledIn("");
        GemmFamilyTest.pairCase(1024L, 768L, 40L);
        String rule #= Gemm.tiled128Member();
        String ran #= Gemm.lastPairKernel();
        Assert.equals(rule, ran);
        Assert.isFalse(Gemm.lastPairTimed());

        String store #= GemmFamilyTest.freshStore();
        Gemm.tuneUnrolledIn(store);
        GemmFamilyTest.rolledUnder("gemm-tiled128", "gemmTiled128_float32", 1024L, 768L, 40L);
        if (Gemm.splitKRuns()) {
            GemmFamilyTest.rolledUnder("gemm-tiled128-split", "gemmTiled128Split_float32", 256L, 128L, 4096L);
        }
        if (Gemm.splitTNRuns()) {
            ShapeChoice.setShapeOverride("gemm-tiled128-split-tn", "gemmTiled128SplitTN_float32");
            int64 t0 = Device.kernelLaunchCount("gemmTiled128SplitTN_float32");
            GemmTest.tnCase(256L, 128L, 4096L, Gemm.splitsFor(256L, 128L, 4096L), true);
            ShapeChoice.clearShapeOverride("gemm-tiled128-split-tn");
            Assert.isTrue(Device.kernelLaunchCount("gemmTiled128SplitTN_float32") > t0);
        }
        // The NT member's twin is the transpose and the routed tile, so tiled128NT declines.
        KernelBuffer<float32> na = heap KernelBuffer<float32>((uint64) (1024L * 40L));
        KernelBuffer<float32> nb = heap KernelBuffer<float32>((uint64) (768L * 40L));
        KernelBuffer<float32> nc = heap KernelBuffer<float32>((uint64) (1024L * 768L));
        ShapeChoice.setShapeOverride("gemm-tiled128-nt", "gemmTiled128_float32");
        boolean nt = Gemm.tiled128NT<float32>(nc, na, nb, 1024L, 768L, 40L);
        ShapeChoice.clearShapeOverride("gemm-tiled128-nt");
        Assert.isFalse(nt);
        KernelBuffer<bfloat16> wa = heap KernelBuffer<bfloat16>((uint64) (300L * 72L));
        KernelBuffer<bfloat16> wb = heap KernelBuffer<bfloat16>((uint64) (72L * 260L));
        KernelBuffer<float32> wc = heap KernelBuffer<float32>((uint64) (300L * 260L));
        ShapeChoice.setShapeOverride("gemm-wide", "gemmWide_bfloat16");
        int64 w0 = Device.kernelLaunchCount("gemmWide_bfloat16");
        Gemm.wide<bfloat16>(wc, wa, wb, 300L, 260L, 72L);
        wc.download(heap float32[300L * 260L]);
        ShapeChoice.clearShapeOverride("gemm-wide");
        Assert.isTrue(Device.kernelLaunchCount("gemmWide_bfloat16") > w0);

        if (rule.equals("gemmTiled128Unrolled_float32")) {
            String fresh #= GemmFamilyTest.freshStore();
            Gemm.tuneUnrolledIn(fresh);
            GemmFamilyTest.pairCase(1024L, 768L, 40L);
            Assert.isTrue(Gemm.lastPairTimed());
            String first #= Gemm.lastPairKernel();
            GemmFamilyTest.pairCase(1024L, 768L, 40L);
            Assert.isFalse(Gemm.lastPairTimed());
            // Naming the store again drops what this process remembers, so the answer comes from the store.
            Gemm.tuneUnrolledIn(fresh);
            GemmFamilyTest.pairCase(1024L, 768L, 40L);
            Assert.isFalse(Gemm.lastPairTimed());
            String again #= Gemm.lastPairKernel();
            Assert.equals(first, again);
        }
        Gemm.tuneUnrolledIn("");
    }
}
