package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.Math;
import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.Optim;
import dev.cajeta.ml.kernels.Reduce;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** cajeta-ml-gpu 30.1.1 (spec §6.6): the SGD and Adam steps against the host rules over three steps. */
public class OptimTest {
    public OptimTest() { return; }

    static boolean usable(String kernel) {
        if (!Device.kernelAvailable(kernel)) { DeviceSkip.noKernel(kernel, "cajeta-ml-gpu 30.1.1"); return false; }
        if (!Device.kernelUsable(kernel)) {
            DeviceSkip.tracked(kernel + " on " + Device.activeBackend() + ": " + Device.kernelUnusableReason(kernel), "cajeta-ml-gpu 30.1.1");
            return false;
        }
        return true;
    }

    static void close(String what, float64 got, float64 want) {
        float64 d = got - want;
        if (d < 0.0) { d = 0.0 - d; }
        float64 w = want;
        if (w < 0.0) { w = 0.0 - w; }
        if (d > 1.0e-5 * (w + 1.0)) {
            System.stdout.println("  " + what + ": got " + got + " want " + want);
            Assert.isTrue(false);
        }
    }

    @Test
    public void sgdAndAdamStepsMatchTheHost() {
        if (!OptimTest.usable("sgdSlots_float32") || !OptimTest.usable("adamSlots_float32")) { return; }
        int64 n = 1000L;
        float32[] hp = heap float32[n];
        float32[] hg = heap float32[n];
        float64[] p1 = heap float64[n];
        float64[] p2 = heap float64[n];
        float64[] vel = heap float64[n];
        float64[] m = heap float64[n];
        float64[] v = heap float64[n];
        int64 i = 0L;
        while (i < n) {
            hp[(int32) i] = (float32) (((i * 7919L) % 251L) - 125L) * 0.012f;
            p1[(int32) i] = (float64) hp[(int32) i];
            p2[(int32) i] = (float64) hp[(int32) i];
            vel[(int32) i] = 0.0; m[(int32) i] = 0.0; v[(int32) i] = 0.0;
            i = i + 1L;
        }
        KernelBuffer<float32> pa = heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> pb = heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> g = heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> va = heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> ma = heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<float32> vb = heap KernelBuffer<float32>((uint64) n);
        pa.upload(hp);
        pb.upload(hp);
        float32[] zero = heap float32[n];
        i = 0L;
        while (i < n) { zero[(int32) i] = 0.0f; i = i + 1L; }
        va.upload(zero);
        ma.upload(zero);
        vb.upload(zero);
        int64[] mk #= ValueCheck.mark();
        float64 b1p = 1.0;
        float64 b2p = 1.0;
        int32 step = 0;
        while (step < 3) {
            i = 0L;
            while (i < n) { hg[(int32) i] = (float32) ((((i + (int64) step * 17L) * 7919L) % 251L) - 125L) * 0.004f; i = i + 1L; }
            g.upload(hg);
            b1p = b1p * 0.9;
            b2p = b2p * 0.999;
            float32 c1 = (float32) (1.0 - b1p);
            float32 c2 = (float32) (1.0 - b2p);
            Optim.sgdStep<float32>(pa, va, g, n, 0.05f, 0.9f);
            Optim.adamStep<float32>(pb, ma, vb, g, n, 0.01f, c1, c2, 0.01f);
            i = 0L;
            while (i < n) {
                float64 gv = (float64) hg[(int32) i];
                vel[(int32) i] = 0.9 * vel[(int32) i] + gv;
                p1[(int32) i] = p1[(int32) i] - 0.05 * vel[(int32) i];
                m[(int32) i] = 0.9 * m[(int32) i] + 0.1 * gv;
                v[(int32) i] = 0.999 * v[(int32) i] + 0.001 * gv * gv;
                float64 mhat = m[(int32) i] / (float64) c1;
                float64 vhat = v[(int32) i] / (float64) c2;
                p2[(int32) i] = p2[(int32) i] - 0.01 * (mhat / (Math.sqrt(vhat) + 1.0e-8) + 0.01 * p2[(int32) i]);
                i = i + 1L;
            }
            step = step + 1;
        }
        float32[] ga = heap float32[n];
        float32[] gb = heap float32[n];
        pa.download(ga);
        pb.download(gb);
        i = 0L;
        while (i < n) {
            OptimTest.close("sgd", (float64) ga[(int32) i], p1[(int32) i]);
            OptimTest.close("adamw", (float64) gb[(int32) i], p2[(int32) i]);
            i = i + 1L;
        }
        // plain SGD leaves the velocity untouched
        Optim.sgdStep<float32>(pa, va, g, n, 0.05f, 0.0f);
        float32[] gv2 = heap float32[n];
        va.download(gv2);
        i = 0L;
        while (i < n) { OptimTest.close("sgd velocity kept", (float64) gv2[(int32) i], vel[(int32) i]); i = i + 1L; }
        ValueCheck.credit(mk);
    }

    /** Run the device clip over three tensors at `maxNorm` and check each against the host rule. */
    static void clipCase(float32 maxNorm) {
        int64[] ns = [7L, 300L, 64L];
        int64[] at = [0L, 7L, 307L];
        float32[] hs = heap float32[371L];
        KernelBuffer<float32>[] gs = heap KernelBuffer<float32>[3];
        float64 sq = 0.0;
        int32 t = 0;
        while (t < 3) {
            float32[] h = heap float32[ns[t]];
            int64 i = 0L;
            while (i < ns[t]) {
                float32 v = (float32) ((((i + (int64) t * 31L) * 7919L) % 251L) - 125L) * 0.004f;
                h[(int32) i] = v;
                hs[(int32) (at[t] + i)] = v;
                sq = sq + (float64) v * (float64) v;
                i = i + 1L;
            }
            KernelBuffer<float32> g = heap KernelBuffer<float32>((uint64) ns[t]);
            g.upload(h);
            gs[t] #= g;
            t = t + 1;
        }
        int64[] mk #= ValueCheck.mark();
        KernelBuffer<float32> parts = heap KernelBuffer<float32>(3);
        KernelBuffer<float32> scale = heap KernelBuffer<float32>(1);
        t = 0;
        while (t < 3) {
            KernelBuffer<float32> slot #= parts.slice((uint64) t, 1);
            Reduce.segments<float32>(slot, gs[t], ns[t], 1L, Reduce.SUMSQ);
            t = t + 1;
        }
        Optim.formClipScale(scale, parts, 3L, maxNorm);
        t = 0;
        while (t < 3) {
            Optim.scaleByDevice<float32>(gs[t], scale, ns[t]);
            t = t + 1;
        }
        float64 total = Math.sqrt(sq);
        float64 want = 1.0;
        if (total > (float64) maxNorm) { want = (float64) maxNorm / total; }
        t = 0;
        while (t < 3) {
            float32[] got = heap float32[ns[t]];
            gs[t].download(got);
            int64 i = 0L;
            while (i < ns[t]) {
                OptimTest.close("clipped element", (float64) got[(int32) i], (float64) hs[(int32) (at[t] + i)] * want);
                i = i + 1L;
            }
            t = t + 1;
        }
        ValueCheck.credit(mk);
    }

    /**
     * spela-kernels 2.1.2: the global-norm clip on the device, with no readback: each tensor's
     * sum of squares into its own slot, the scale min(1, maxNorm / norm) formed on the device, and
     * every tensor scaled by it, as the host clip does. A norm under the limit leaves the values.
     */
    @Test
    public void theGlobalNormClipRunsOnTheDevice() {
        if (!OptimTest.usable("clipScale") || !OptimTest.usable("scaleBy_float32")) { return; }
        OptimTest.clipCase(0.05f);
        OptimTest.clipCase(1000.0f);
    }

    static #KernelBuffer<float32> filled(float32[] h) {
        KernelBuffer<float32> b = heap KernelBuffer<float32>((uint64) h.count());
        b.upload(h);
        return #b;
    }

    static #float32[] pattern(int64 n, int64 seed, float32 step) {
        float32[] h = heap float32[n];
        int64 i = 0L;
        while (i < n) { h[(int32) i] = (float32) ((((i + seed) * 7919L) % 251L) - 125L) * step; i = i + 1L; }
        return #h;
    }

    static void sameBits(String what, KernelBuffer<float32> a, KernelBuffer<float32> b, int64 n) {
        float32[] ha = heap float32[n];
        float32[] hb = heap float32[n];
        a.download(ha);
        b.download(hb);
        int64 i = 0L;
        while (i < n) {
            if (Cajeta.f32ToBits(ha[(int32) i]) != Cajeta.f32ToBits(hb[(int32) i])) {
                System.stdout.println("  " + what + " [" + i + "] slots " + (float64) ha[(int32) i] + " per tensor " + (float64) hb[(int32) i]);
                Assert.isTrue(false);
            }
            i = i + 1L;
        }
    }

    /** One case: a weight of 7 x 300 and a bias of 300, two steps, the slot launch against the per-tensor one, with or without a device scale. */
    static void slotsCase(boolean adam, boolean scaled) {
        int64[] ns = [2100L, 300L];
        float32[] p0 #= OptimTest.pattern(2100L, 3L, 0.01f);
        float32[] p1 #= OptimTest.pattern(300L, 5L, 0.01f);
        float32[] g0 #= OptimTest.pattern(2100L, 11L, 0.002f);
        float32[] g1 #= OptimTest.pattern(300L, 13L, 0.002f);
        float32[] zero0 = heap float32[2100L];
        float32[] zero1 = heap float32[300L];
        KernelBuffer<float32> ap0 #= OptimTest.filled(p0);
        KernelBuffer<float32> ap1 #= OptimTest.filled(p1);
        KernelBuffer<float32> bp0 #= OptimTest.filled(p0);
        KernelBuffer<float32> bp1 #= OptimTest.filled(p1);
        KernelBuffer<float32> am0 #= OptimTest.filled(zero0);
        KernelBuffer<float32> am1 #= OptimTest.filled(zero1);
        KernelBuffer<float32> av0 #= OptimTest.filled(zero0);
        KernelBuffer<float32> av1 #= OptimTest.filled(zero1);
        KernelBuffer<float32> bm0 #= OptimTest.filled(zero0);
        KernelBuffer<float32> bm1 #= OptimTest.filled(zero1);
        KernelBuffer<float32> bv0 #= OptimTest.filled(zero0);
        KernelBuffer<float32> bv1 #= OptimTest.filled(zero1);
        KernelBuffer<float32> ag0 #= OptimTest.filled(g0);
        KernelBuffer<float32> ag1 #= OptimTest.filled(g1);
        KernelBuffer<float32> bg0 #= OptimTest.filled(g0);
        KernelBuffer<float32> bg1 #= OptimTest.filled(g1);
        float32[] sc = [0.37f];
        KernelBuffer<float32> scale #= OptimTest.filled(sc);
        KernelBuffer<float32>[] ps = heap KernelBuffer<float32>[2];
        KernelBuffer<float32>[] ms = heap KernelBuffer<float32>[2];
        KernelBuffer<float32>[] vs = heap KernelBuffer<float32>[2];
        KernelBuffer<float32>[] gs = heap KernelBuffer<float32>[2];
        ps[0] = ap0; ps[1] = ap1;
        ms[0] = am0; ms[1] = am1;
        vs[0] = av0; vs[1] = av1;
        gs[0] = ag0; gs[1] = ag1;
        int64[] mk #= ValueCheck.mark();
        int32 step = 1;
        float32 b1 = 1.0f;
        float32 b2 = 1.0f;
        while (step <= 2) {
            b1 = b1 * 0.9f;
            b2 = b2 * 0.999f;
            float32[] c1 = [1.0f - b1, 1.0f - b1];
            float32[] c2 = [1.0f - b2, 1.0f - b2];
            if (scaled) {
                Optim.scaleByDevice<float32>(bg0, scale, 2100L);
                Optim.scaleByDevice<float32>(bg1, scale, 300L);
            }
            if (adam) {
                if (scaled) { Optim.adamStepSlots<float32>(ps, ms, vs, gs, ns, 2, c1, c2, 0.001f, 0.0001f, scale); }
                else { Optim.adamStepSlots<float32>(ps, ms, vs, gs, ns, 2, c1, c2, 0.001f, 0.0001f, null); }
                Optim.adamStep<float32>(bp0, bm0, bv0, bg0, 2100L, 0.001f, 1.0f - b1, 1.0f - b2, 0.0001f);
                Optim.adamStep<float32>(bp1, bm1, bv1, bg1, 300L, 0.001f, 1.0f - b1, 1.0f - b2, 0.0001f);
            } else {
                if (scaled) { Optim.sgdStepSlots<float32>(ps, ms, gs, ns, 2, 0.01f, 0.9f, scale); }
                else { Optim.sgdStepSlots<float32>(ps, ms, gs, ns, 2, 0.01f, 0.9f, null); }
                Optim.sgdStep<float32>(bp0, bm0, bg0, 2100L, 0.01f, 0.9f);
                Optim.sgdStep<float32>(bp1, bm1, bg1, 300L, 0.01f, 0.9f);
            }
            if (scaled) {
                // The slot launch scales as it reads; the per-tensor gradients were scaled in place,
                // so put them back for the next step.
                bg0.upload(g0);
                bg1.upload(g1);
            }
            step = step + 1;
        }
        String what = "sgd";
        if (adam) { what = "adam"; }
        if (scaled) { what = what + " scaled"; }
        OptimTest.sameBits(what + " weight", ap0, bp0, 2100L);
        OptimTest.sameBits(what + " bias", ap1, bp1, 300L);
        OptimTest.sameBits(what + " weight moment", am0, bm0, 2100L);
        if (adam) { OptimTest.sameBits(what + " weight second moment", av0, bv0, 2100L); }
        ValueCheck.credit(mk);
    }

    /**
     * spela-kernels 3.1.1, 3.1.2: one optimizer launch over up to four tensors (a Linear's weight
     * and bias here) matches a launch per tensor bit for bit, for AdamW and SGD with momentum, and
     * with the clip's device scale applied as the gradients are read it matches scaling first.
     */
    @Test
    public void aLayerUpdatesInOneOptimizerLaunch() {
        if (!OptimTest.usable("adamSlots_float32") || !OptimTest.usable("sgdSlots_float32")) { return; }
        OptimTest.slotsCase(true, false);
        OptimTest.slotsCase(true, true);
        OptimTest.slotsCase(false, false);
        OptimTest.slotsCase(false, true);
    }
}
