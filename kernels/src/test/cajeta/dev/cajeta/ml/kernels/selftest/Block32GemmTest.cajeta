package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.Cajeta;
import cajeta.lang.Math;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.gemm.Block32GemmRows8;
import dev.cajeta.ml.kernels.gemm.PackQ8K;
import dev.cajeta.ml.kernels.quant.Q40Block;
import dev.cajeta.ml.kernels.quant.Q50Block;
import dev.cajeta.ml.kernels.quant.Q80Block;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/** kernel-drivers 8.3.1: the 32-value block family (Q8_0, Q5_0) on the reference and the cpu row driver. */
public class Block32GemmTest {
    public Block32GemmTest() { return; }

    static boolean has(String name, String why) {
        if (!Device.kernelAvailable(name)) { DeviceSkip.cannot(why); return false; }
        return true;
    }

    @Test
    public void aPackedSpanIsTheFilesSize() {
        Block32GemmRows8<Q80Block> q8 = heap Block32GemmRows8<Q80Block>();
        Block32GemmRows8<Q50Block> q5 = heap Block32GemmRows8<Q50Block>();
        Assert.isTrue(q8.groupBytes() == 8L * 8L * 34L);
        Assert.isTrue(q5.groupBytes() == 8L * 8L * 22L);
        Assert.isTrue(q8.packedBytes(9L, 9L) == 2L * 2L * 2176L);
    }

    @Test
    public void thePiecesDecodeEveryValueAsTheFormatsDefineIt() {
        Block32Check<Q80Block> c8 = heap Block32Check<Q80Block>();
        Block32Check<Q50Block> c5 = heap Block32Check<Q50Block>();
        int8[] f8 #= c8.weight(3L);
        int8[] f5 #= c5.weight(3L);
        int64 b = 0L;
        while (b < 3L) {
            uint32 k = 0;
            while (k < 32) {
                int64 r8 = b * 34L;
                int64 r5 = b * 22L;
                int32 q8 = Q80Block.quant((int32) f8[r8 + (int64) Q80Block.quantByte(k)] & 255, 0, k) - Q80Block.offset();
                int32 q5 = Q50Block.quant((int32) f5[r5 + (int64) Q50Block.quantByte(k)] & 255,
                    (int32) f5[r5 + (int64) Q50Block.planeByte(k)] & 255, k) - Q50Block.offset();
                float64 d8 = (float64) Q80Block.dOf(((int32) f8[r8] & 255) | (((int32) f8[r8 + 1L] & 255) << 8));
                float64 d5 = (float64) Q50Block.dOf(((int32) f5[r5] & 255) | (((int32) f5[r5 + 1L] & 255) << 8));
                Assert.isTrue(d8 * (float64) q8 == c8.element(f8, r8, (int64) k));
                Assert.isTrue(d5 * (float64) q5 == c5.element(f5, r5, (int64) k));
                k = k + 1;
            }
            b = b + 1L;
        }
    }

    @Test
    public void theReferenceComputesTheFormatsProduct() {
        if (!Block32GemmTest.has("Block32GemmRef_dev_cajeta_ml_kernels_quant_Q80Block_ref", "the 32-value reference GEMM")) { return; }
        int64[] m #= ValueCheck.mark();
        heap Block32Check<Q80Block>().refMatchesDefinition(5L, 3L, 11L, 0L);
        heap Block32Check<Q80Block>().refMatchesDefinition(5L, 3L, 11L, 4L);
        heap Block32Check<Q50Block>().refMatchesDefinition(5L, 3L, 11L, 0L);
        heap Block32Check<Q40Block>().refMatchesDefinition(5L, 3L, 11L, 0L);
        ValueCheck.credit(m);
    }

    @Test
    public void theRowDriverEqualsTheReferenceBitForBit() {
        if (!Block32GemmTest.has("Block32GemmRows8_dev_cajeta_ml_kernels_quant_Q80Block_rows8", "the 8-row driver is the cpu's (kernel-drivers 8.3.1)")) { return; }
        int64[] m #= ValueCheck.mark();
        heap Block32Check<Q80Block>().driverEqualsRef(21L, 39L, 19L, 0L);
        heap Block32Check<Q80Block>().driverEqualsRef(21L, 39L, 19L, 4L);
        heap Block32Check<Q50Block>().driverEqualsRef(21L, 39L, 19L, 0L);
        heap Block32Check<Q40Block>().driverEqualsRef(21L, 39L, 19L, 0L);
        ValueCheck.credit(m);
    }

    @Test
    public void oneTokenRunsTheDecodeKernelAndEqualsTheReferenceBitForBit() {
        if (!Block32GemmTest.has("Block32GemmRows8_dev_cajeta_ml_kernels_quant_Q80Block_vec8", "the 8-row driver is the cpu's (kernel-drivers 8.3.1)")) { return; }
        int64[] m #= ValueCheck.mark();
        heap Block32Check<Q80Block>().driverEqualsRef(21L, 1L, 37L, 4L);
        heap Block32Check<Q50Block>().driverEqualsRef(21L, 1L, 37L, 0L);
        heap Block32Check<Q40Block>().driverEqualsRef(21L, 1L, 37L, 0L);
        ValueCheck.credit(m);
    }

    @Test
    public void threeWeightsAgainstOneTokenEachEqualTheReferenceBitForBit() {
        if (!Block32GemmTest.has("Block32GemmRows8_dev_cajeta_ml_kernels_quant_Q80Block_vec3", "the 8-row driver is the cpu's (kernel-drivers 8.3.1)")) { return; }
        int64[] m #= ValueCheck.mark();
        heap Block32Check<Q80Block>().threeEqualRef(13L, 4L);
        heap Block32Check<Q50Block>().threeEqualRef(13L, 0L);
        heap Block32Check<Q40Block>().threeEqualRef(13L, 0L);
        ValueCheck.credit(m);
    }

    /** Row `r`'s values `n` long, zero past `n`, packed at a scale per 32 values as the definition says. */
    static void hostPack32(float32[] x, int64 r, int64 n, int8[] out) {
        int64 nbRow = (n + 255L) / 256L;
        int64 e = 0L;
        while (e < nbRow * 256L) {
            int64 ob = (r * nbRow + e / 256L) * 320L;
            int64 j = (e % 256L) / 32L;
            float32 amax = 0.0f;
            int64 i = 0L;
            while (i < 32L) {
                float32 av = e + i < n ? x[r * n + e + i] : 0.0f;
                if (av < 0.0f) { av = 0.0f - av; }
                if (av > amax) { amax = av; }
                i = i + 1L;
            }
            float32 inv = amax > 0.0f ? 127.0f / amax : 0.0f;
            int32 sm = 0;
            i = 0L;
            while (i < 32L) {
                float32 fv = e + i < n ? x[r * n + e + i] * inv : 0.0f;
                int32 q = (int32) Math.round(fv);
                out[ob + 32L * j + i] = (int8) q;
                sm = sm + q;
                i = i + 1L;
            }
            BlockGemmRefTest.putI32(out, ob + 256L + 4L * j, sm);
            BlockGemmRefTest.putI32(out, ob + 288L + 4L * j, Cajeta.f32ToBits(amax / 127.0f));
            e = e + 32L;
        }
    }

    @Test
    public void thePer32PackEqualsTheDefinitionByteForByte() {
        if (!Block32GemmTest.has("pack32", "the per-32 pack is the cpu route's (kernel-drivers 8.3.1.2)")) { return; }
        int64 rows = 3L;
        int64 n = 600L;
        int64 bytes = rows * 3L * 320L;
        float32[] x #= heap float32[rows * n];
        int64 i = 0L;
        while (i < rows * n) {
            x[i] = (float32) ((((i * 7919L) % 251L) - 125L)) * 0.037f;
            if (i >= 64L && i < 96L) { x[i] = 0.0f; }
            i = i + 1L;
        }
        KernelBuffer<float32> dx = heap KernelBuffer<float32>((uint64) (rows * n));
        KernelBuffer<int8> dp = heap KernelBuffer<int8>((uint64) bytes);
        dx.upload(x);
        int64[] m #= ValueCheck.mark();
        KernelStream st #= KernelStream.current();
        PackQ8K.rows32(st, dp, dx, rows, n);
        st.sync();
        int8[] got #= heap int8[bytes];
        int8[] want #= heap int8[bytes];
        dp.download(got);
        int64 r = 0L;
        while (r < rows) { Block32GemmTest.hostPack32(x, r, n, want); r = r + 1L; }
        i = 0L;
        while (i < bytes) { Assert.isTrue(got[i] == want[i]); i = i + 1L; }
        ValueCheck.credit(m);
    }

    @Test
    public void everyGpuDecodeMemberComputesTheFormatsProduct() {
        String k = "Block32GemvWave_dev_cajeta_ml_kernels_quant_Q80Block_4_wave";
        if (!Device.kernelUsable(k)) { DeviceSkip.noKernel(k, "the wave decode driver is the GPU's (kernel-drivers 8.3.1.3)"); return; }
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        int64[] m #= ValueCheck.mark();
        heap Block32Check<Q80Block>().waveMatchesDefinition(23L, 75L, wv);
        heap Block32Check<Q50Block>().waveMatchesDefinition(23L, 75L, wv);
        heap Block32Check<Q80Block>().waveMatchesDefinition(9L, 13L, wv);
        heap Block32Check<Q50Block>().waveMatchesDefinition(9L, 13L, wv);
        heap Block32Check<Q40Block>().waveMatchesDefinition(23L, 75L, wv);
        heap Block32Check<Q40Block>().waveMatchesDefinition(9L, 13L, wv);
        ValueCheck.credit(m);
    }

    @Test
    public void bothGpuTilesComputeTheFormatsProduct() {
        String k = "Block32GemmTile_dev_cajeta_ml_kernels_quant_Q80Block_64_64_32_32_128_tile";
        if (!Device.kernelUsable(k)) { DeviceSkip.noKernel(k, "the tensor-core tile is the GPU's (kernel-drivers 8.3.1.4)"); return; }
        int64[] m #= ValueCheck.mark();
        heap Block32Check<Q80Block>().tileMatchesDefinition(128L, 128L, 512L);
        heap Block32Check<Q50Block>().tileMatchesDefinition(128L, 128L, 512L);
        heap Block32Check<Q40Block>().tileMatchesDefinition(128L, 128L, 512L);
        ValueCheck.credit(m);
    }
}
