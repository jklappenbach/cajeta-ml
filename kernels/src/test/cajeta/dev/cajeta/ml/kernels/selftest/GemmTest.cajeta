package dev.cajeta.ml.kernels.selftest;

import cajeta.lang.System;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.unit.Assert;
import dev.cajeta.ml.kernels.Gemm;
import dev.cajeta.ml.kernels.testing.DeviceSkip;
import dev.cajeta.ml.kernels.testing.ValueCheck;

/**
 * cajeta-ml-gpu 19.1.1 (spec §5.1): f16 and bf16 GEMM at square and LLM shapes against a
 * host f32 GEMM within the documented tolerance, 1e-5 relative plus K x 1e-7 absolute (the
 * matrix cores accumulate in their own order and precision; the portable tile is bit-exact). Inputs step by a half
 * in [-2, 2]; shapes that are not multiples of the tile included.
 */
public class GemmTest {
    public GemmTest() { return; }

    static float32 pattern(int64 i) {
        return (float32) ((((i * 7919L) % 251L) - 125L) % 5L) * 0.5f;
    }

    static boolean usable(String kernel) {
        if (!Device.kernelAvailable(kernel)) { DeviceSkip.noKernel(kernel, "cajeta-ml-gpu 19.2.1"); return false; }
        if (!Device.kernelUsable(kernel)) {
            DeviceSkip.tracked(kernel + " on " + Device.activeBackend() + ": " + Device.kernelUnusableReason(kernel), "cajeta-ml-gpu 19.2.1");
            return false;
        }
        return true;
    }

    /** C = A[m][k] . B[k][n] on the device at E against the host in float64, element for element. */
    static void gemmCase<E>(String kernel, int64 m, int64 n, int64 k) {
        E[] ha = heap E[m * k];
        E[] hb = heap E[k * n];
        float32[] fa = heap float32[m * k];
        float32[] fb = heap float32[k * n];
        int64 i = 0L;
        while (i < m * k) { fa[(int32) i] = GemmTest.pattern(i); ha[(int32) i] = (E) fa[(int32) i]; i = i + 1L; }
        i = 0L;
        while (i < k * n) { fb[(int32) i] = GemmTest.pattern(i + 17L); hb[(int32) i] = (E) fb[(int32) i]; i = i + 1L; }
        KernelBuffer<E> a = heap KernelBuffer<E>((uint64) (m * k));
        KernelBuffer<E> b = heap KernelBuffer<E>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        a.upload(ha);
        b.upload(hb);
        int64[] mk #= ValueCheck.mark();
        Gemm.run<E>(c, a, b, m, n, k);
        float32[] got = heap float32[m * n];
        c.download(got);
        int64 r = 0L;
        int32 bad = 0;
        float64 worst = 0.0;
        while (r < m) {
            int64 col = 0L;
            while (col < n) {
                float64 acc = 0.0;
                int64 d = 0L;
                while (d < k) { acc = acc + (float64) fa[(int32) (r * k + d)] * (float64) fb[(int32) (d * n + col)]; d = d + 1L; }
                float64 d = (float64) got[(int32) (r * n + col)] - acc;
                if (d < 0.0) { d = 0.0 - d; }
                float64 w = acc;
                if (w < 0.0) { w = 0.0 - w; }
                if (d > worst) { worst = d; }
                if (d > 1.0e-5 * (w + 1.0) + (float64) k * 1.0e-7) {
                    if (bad < 3) {
                        System.stdout.println(kernel + " " + m + "x" + n + "x" + k + ": [" + r + "," + col + "] got " + (float64) got[(int32) (r * n + col)] + " want " + acc);
                    }
                    bad = bad + 1;
                }
                col = col + 1L;
            }
            r = r + 1L;
        }
        if (worst > 0.0) { System.stdout.println("  " + kernel + " " + m + "x" + n + "x" + k + ": largest difference " + worst); }
        Assert.equals(0L, (int64) bad);
        ValueCheck.credit(mk);
    }

    /** C = A . B through the plain tile at E, against the host in float64. */
    static void tiledCase<E>(String kernel, int64 m, int64 n, int64 k) {
        GemmTest.tiledCaseVia<E>(kernel, m, n, k, (uint32) 0);
    }

    /** tiledCase through Gemm.tiled, or with `splits` > 0 straight through the unrolled split member. */
    static void tiledCaseVia<E>(String kernel, int64 m, int64 n, int64 k, uint32 splits) {
        GemmTest.tiledCaseVia<E>(kernel, m, n, k, splits, false);
    }

    /** tiledCaseVia, on the rolled split member when `rolled`. */
    static void tiledCaseVia<E>(String kernel, int64 m, int64 n, int64 k, uint32 splits, boolean rolled) {
        E[] ha = heap E[m * k];
        E[] hb = heap E[k * n];
        float32[] fa = heap float32[m * k];
        float32[] fb = heap float32[k * n];
        int64 i = 0L;
        while (i < m * k) { fa[(int32) i] = GemmTest.pattern(i); ha[(int32) i] = (E) fa[(int32) i]; i = i + 1L; }
        i = 0L;
        while (i < k * n) { fb[(int32) i] = GemmTest.pattern(i + 17L); hb[(int32) i] = (E) fb[(int32) i]; i = i + 1L; }
        KernelBuffer<E> a = heap KernelBuffer<E>((uint64) (m * k));
        KernelBuffer<E> b = heap KernelBuffer<E>((uint64) (k * n));
        KernelBuffer<E> c = heap KernelBuffer<E>((uint64) (m * n));
        a.upload(ha);
        b.upload(hb);
        int64[] mk #= ValueCheck.mark();
        if (rolled) { Gemm.tiled128SplitRolled<E>(c, a, b, m, n, k, splits, false); }
        else if (splits > (uint32) 0) { Gemm.tiled128SplitUnrolled<E>(c, a, b, m, n, k, splits, false); }
        else { Gemm.tiled<E>(c, a, b, m, n, k); }
        E[] got = heap E[m * n];
        c.download(got);
        int64 r = 0L;
        int32 bad = 0;
        while (r < m) {
            int64 col = 0L;
            while (col < n) {
                float64 acc = 0.0;
                int64 d = 0L;
                while (d < k) { acc = acc + (float64) fa[(int32) (r * k + d)] * (float64) fb[(int32) (d * n + col)]; d = d + 1L; }
                float64 df = (float64) got[(int32) (r * n + col)] - acc;
                if (df < 0.0) { df = 0.0 - df; }
                float64 w = acc;
                if (w < 0.0) { w = 0.0 - w; }
                if (df > 1.0e-5 * (w + 1.0) + (float64) k * 1.0e-7) {
                    if (bad < 3) { System.stdout.println(kernel + " " + m + "x" + n + "x" + k + ": [" + r + "," + col + "] got " + (float64) got[(int32) (r * n + col)] + " want " + acc); }
                    bad = bad + 1;
                }
                col = col + 1L;
            }
            r = r + 1L;
        }
        Assert.equals(0L, (int64) bad);
        ValueCheck.credit(mk);
    }

    @Test
    public void f32TiledGemmMatchesTheHost() {
        if (!GemmTest.usable("gemmTiled_float32")) { return; }
        GemmTest.tiledCase<float32>("gemmTiled_float32", 16L, 16L, 16L);
        GemmTest.tiledCase<float32>("gemmTiled_float32", 3L, 5L, 7L);
        GemmTest.tiledCase<float32>("gemmTiled_float32", 100L, 100L, 100L);
        GemmTest.tiledCase<float32>("gemmTiled_float32", 257L, 33L, 129L);
        GemmTest.tiledCase<float32>("gemmTiled_float32", 7L, 1000L, 2049L);
    }

    /** The route check: `big` launched since `bigBefore`, and `small` did not since `smallBefore`. */
    static void routes(String big, String small, int64 bigBefore, int64 smallBefore) {
        Assert.isTrue(Device.kernelLaunchCount(big) > bigBefore);
        Assert.equals(smallBefore, Device.kernelLaunchCount(small));
    }

    /** 19.2.2: Gemm.tiled at 32 or more 128x128 tiles routes to the wide register tile, below it stays on the plain tile; results right either way. */
    @Test
    public void largeShapesRouteToTheWideRegisterTileAndStayRight() {
        if (GemmTest.usable("gemmTiled128_float32")) {
            String big #= Gemm.tiled128Member();
            int64 b0 = Device.kernelLaunchCount(big);
            int64 s0 = Device.kernelLaunchCount("gemmTiled_float32");
            GemmTest.tiledCase<float32>(big, 1024L, 768L, 40L);
            GemmTest.tiledCase<float32>(big, 1000L, 1000L, 37L);
            GemmTest.routes(big, "gemmTiled_float32", b0, s0);
            int64 b1 = Device.kernelLaunchCount(big);
            GemmTest.tiledCase<float32>("gemmTiled_float32", 300L, 500L, 100L);
            GemmTest.routes("gemmTiled_float32", big, s0, b1);
        }
    }

    /**
     * A small output over a long K (a weight gradient: 512 x 512 over 8192 rows) splits K
     * across the wide tile: on the plain tile it took 659 us on a 4090, sixteen 128x128
     * tiles being too few workgroups for the device (transformer-block-train, cajeta-ml-gpu
     * 28.2.8). The slices are joined in order, so the result repeats bit for bit; shapes
     * with enough tiles, or a short K, keep their routes.
     */
    @Test
    public void aSmallOutputOverALongKSplitsKAndStaysRight() {
        if (!GemmTest.usable("gemmTiled128UnrolledSplit_float32")) { return; }
        // Straight through the member wherever it is built, the route only where it runs.
        GemmTest.tiledCaseVia<float32>("gemmTiled128UnrolledSplit_float32", 200L, 130L, 2050L, (uint32) 8);
        if (!Gemm.splitKRuns()) { return; }
        Assert.isTrue(Gemm.splitsFor(256L, 128L, 4096L) > 1);
        Assert.isTrue(Gemm.splitsFor(512L, 512L, 8192L) > 1);
        Assert.isTrue(Gemm.splitsFor(4096L, 4096L, 4096L) == 1);
        Assert.isTrue(Gemm.splitsFor(300L, 500L, 100L) == 1);
        String member #= Gemm.splitMember();
        int64 s0 = Device.kernelLaunchCount(member);
        GemmTest.tiledCase<float32>(member, 256L, 128L, 4096L);
        GemmTest.tiledCase<float32>(member, 200L, 130L, 2050L);
        Assert.isTrue(Device.kernelLaunchCount(member) >= s0 + 2L);
        int64 s1 = Device.kernelLaunchCount(member);
        GemmTest.tiledCase<float32>("gemmTiled_float32", 300L, 500L, 100L);
        Assert.equals(s1, Device.kernelLaunchCount(member));
        // Bit for bit, call to call.
        int64 m = 256L; int64 n = 128L; int64 k = 4096L;
        float32[] ha = heap float32[m * k];
        float32[] hb = heap float32[k * n];
        int64 i = 0L;
        while (i < m * k) { ha[(int32) i] = GemmTest.pattern(i); i = i + 1L; }
        i = 0L;
        while (i < k * n) { hb[(int32) i] = GemmTest.pattern(i + 17L); i = i + 1L; }
        KernelBuffer<float32> a = heap KernelBuffer<float32>((uint64) (m * k));
        KernelBuffer<float32> b = heap KernelBuffer<float32>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        a.upload(ha);
        b.upload(hb);
        Gemm.tiled<float32>(c, a, b, m, n, k);
        float32[] one = heap float32[m * n];
        c.download(one);
        Gemm.tiled<float32>(c, a, b, m, n, k);
        float32[] two = heap float32[m * n];
        c.download(two);
        i = 0L;
        while (i < m * n) { Assert.isTrue(Cajeta.f32ToBits(one[(int32) i]) == Cajeta.f32ToBits(two[(int32) i])); i = i + 1L; }
    }

    /** C = at^T . B with `at` stored k x m, through the transposed-A split member (`route` via Gemm.tiledTN), against the host in float64. */
    static void tnCase(int64 m, int64 n, int64 k, uint32 splits, boolean route) {
        GemmTest.tnCase(m, n, k, splits, route, false);
    }

    /** tnCase, on the rolled transposed-A member when `rolled`. */
    static void tnCase(int64 m, int64 n, int64 k, uint32 splits, boolean route, boolean rolled) {
        float32[] fat = heap float32[k * m];
        float32[] fb = heap float32[k * n];
        int64 i = 0L;
        while (i < k * m) { fat[(int32) i] = GemmTest.pattern(i); i = i + 1L; }
        i = 0L;
        while (i < k * n) { fb[(int32) i] = GemmTest.pattern(i + 17L); i = i + 1L; }
        KernelBuffer<float32> at = heap KernelBuffer<float32>((uint64) (k * m));
        KernelBuffer<float32> b = heap KernelBuffer<float32>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        at.upload(fat);
        b.upload(fb);
        int64[] mk #= ValueCheck.mark();
        if (rolled) { Gemm.tiled128SplitRolled<float32>(c, at, b, m, n, k, splits, true); }
        else if (route) { Assert.isTrue(Gemm.tiledTN<float32>(c, at, b, m, n, k)); }
        else { Gemm.tiled128SplitUnrolled<float32>(c, at, b, m, n, k, splits, true); }
        float32[] got = heap float32[m * n];
        c.download(got);
        int32 bad = 0;
        int64 r = 0L;
        while (r < m) {
            int64 col = 0L;
            while (col < n) {
                float64 acc = 0.0;
                int64 d = 0L;
                while (d < k) { acc = acc + (float64) fat[(int32) (d * m + r)] * (float64) fb[(int32) (d * n + col)]; d = d + 1L; }
                float64 df = (float64) got[(int32) (r * n + col)] - acc;
                if (df < 0.0) { df = 0.0 - df; }
                float64 w = acc;
                if (w < 0.0) { w = 0.0 - w; }
                if (df > 1.0e-5 * (w + 1.0) + (float64) k * 1.0e-7) {
                    if (bad < 3) { System.stdout.println("TN " + m + "x" + n + "x" + k + ": [" + r + "," + col + "] got " + (float64) got[(int32) (r * n + col)] + " want " + acc); }
                    bad = bad + 1;
                }
                col = col + 1L;
            }
            r = r + 1L;
        }
        Assert.equals(0L, (int64) bad);
        ValueCheck.credit(mk);
    }

    /**
     * A weight gradient X^T . G reads X in place: the transposed-A split member against the
     * host, at a whole-tile shape and a ragged one, and Gemm.tiledTN taking the shape where
     * the member runs and declining a product that does not split (cajeta-ml-gpu 28.2.8).
     */
    @Test
    public void aTransposedASplitMatchesTheHost() {
        if (!GemmTest.usable("gemmTiled128UnrolledSplitTN_float32")) { return; }
        GemmTest.tnCase(200L, 130L, 2050L, (uint32) 8, false);
        GemmTest.tnCase(256L, 128L, 1024L, (uint32) 4, false);
        if (!Gemm.splitTNRuns()) { return; }
        GemmTest.tnCase(256L, 128L, 4096L, (uint32) 0, true);
        KernelBuffer<float32> x = heap KernelBuffer<float32>((uint64) 64);
        Assert.isFalse(Gemm.tiledTN<float32>(x, x, x, 8L, 8L, 8L));
    }

    /** cajeta-ml-gpu 28.2.8: the rolled split-K members (gfx1151's, where the unrolled ones spill), plain and transposed-A,
     *  at a ragged shape and a whole-tile one, against the host, and bit for bit call to call. */
    @Test
    public void theRolledSplitMembersMatchTheHost() {
        if (!GemmTest.usable("gemmTiled128Split_float32") || !GemmTest.usable("gemmTiled128SplitTN_float32")) { return; }
        GemmTest.tiledCaseVia<float32>("gemmTiled128Split_float32", 200L, 130L, 2050L, (uint32) 8, true);
        GemmTest.tiledCaseVia<float32>("gemmTiled128Split_float32", 256L, 128L, 4096L, (uint32) 4, true);
        GemmTest.tnCase(200L, 130L, 2050L, (uint32) 8, false, true);
        GemmTest.tnCase(256L, 128L, 1024L, (uint32) 4, false, true);
        int64 m = 256L; int64 n = 128L; int64 k = 2048L;
        float32[] ha = heap float32[m * k];
        float32[] hb = heap float32[k * n];
        int64 i = 0L;
        while (i < m * k) { ha[(int32) i] = GemmTest.pattern(i); i = i + 1L; }
        i = 0L;
        while (i < k * n) { hb[(int32) i] = GemmTest.pattern(i + 17L); i = i + 1L; }
        KernelBuffer<float32> a = heap KernelBuffer<float32>((uint64) (m * k));
        KernelBuffer<float32> b = heap KernelBuffer<float32>((uint64) (k * n));
        KernelBuffer<float32> c = heap KernelBuffer<float32>((uint64) (m * n));
        a.upload(ha);
        b.upload(hb);
        Gemm.tiled128SplitRolled<float32>(c, a, b, m, n, k, (uint32) 4, false);
        float32[] one = heap float32[m * n];
        c.download(one);
        Gemm.tiled128SplitRolled<float32>(c, a, b, m, n, k, (uint32) 4, false);
        float32[] two = heap float32[m * n];
        c.download(two);
        i = 0L;
        while (i < m * n) { Assert.isTrue(Cajeta.f32ToBits(one[(int32) i]) == Cajeta.f32ToBits(two[(int32) i])); i = i + 1L; }
    }

    @Test
    public void f16GemmMatchesTheHostAtSquareAndLlmShapes() {
        if (!GemmTest.usable("gemm16_float16")) { return; }
        GemmTest.gemmCase<float16>("gemm16_float16", 16L, 16L, 16L);
        GemmTest.gemmCase<float16>("gemm16_float16", 64L, 64L, 64L);
        GemmTest.gemmCase<float16>("gemm16_float16", 100L, 100L, 100L);
        GemmTest.gemmCase<float16>("gemm16_float16", 257L, 33L, 129L);
        GemmTest.gemmCase<float16>("gemm16_float16", 1L, 4096L, 2048L);
        GemmTest.gemmCase<float16>("gemm16_float16", 7L, 1000L, 2049L);
        GemmTest.gemmCase<float16>("gemm16_float16", 4L, 256L, 14336L);
        GemmTest.gemmCase<float16>("gemm16_float16", 4096L, 64L, 2048L);
    }

    @Test
    public void bf16GemmMatchesTheHost() {
        if (!GemmTest.usable("gemm16_bfloat16")) { return; }
        GemmTest.gemmCase<bfloat16>("gemm16_bfloat16", 100L, 100L, 100L);
        GemmTest.gemmCase<bfloat16>("gemm16_bfloat16", 7L, 1000L, 2049L);
    }
}
